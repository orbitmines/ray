Entity := class {
  key: Encoding.Key?
}

Nameable := class {
  static PREFIX: String?
  name: *?

  named (name): static => this ~~ .name |= name
}

FullName := class (first: Char.Word[], " ", last: Char.Word[])
Email := Location{scheme == "mailto"}
Phone := Location{scheme == "tel"}

@me ^string => &caller as Character
@private ^string => @me
@local ^string => @me
@localhost ^string => @me
@public ^string => *
@me = {who} ^punctuation => &@.may(`@me =`, who) ? &caller = (who is Character ? who.acting : who) : ERROR@Access `running as another character needs their grant`
@me/{path: Written} ^string => path.split("/" | ".").reduce(acc = @me => acc.`.`)
@{who: (Char.Word | "-")[] | UUID} {{block}} ^keyword => with (@me = Character.local(who) ?? ERROR `a block runs as a character only when that character is here`) Program(code: external ** block)
@{who: (Char.Word | "-")[] | UUID}~{literal label ^label}{ }{{block}} ^keyword => (Character.local(who) ?? ERROR `a block runs as a character only when that character is here`)~label
  -- (entry => with (@me = entry.of) Program(code: external ** block) ~~ Program(code: entry.following).entered(entry.of, None))

Character := class: Hierarchy + Entity + Nameable {
  static PREFIX = "@"
  static local (who) => who == "me" ? @me : None

  permissions: Accessor.Permission?

  profile_picture: *?
  profile: *?

  avatars => name{is Location && .segments.some(.starts_with("@"))}
  quests => Program#{who: this}{running}
  as (=== boolean) => this == @me
  acting => this
  chainable == (other) => ERROR@Security `comparing characters needs @ether/security (or @ether/network)`

  choose (s, n: Number = 1) => Choice(type: s, count: n)

  read => Access(this)
  write => on(`=`)
  execute => on(`()`)
  on (method) => Access(this, method)
}
