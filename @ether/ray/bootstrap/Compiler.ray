}
// (what is written out, a byte at a time (the back end's `outbyte`, after `outb`, `outn` of them): a value, a number in
// decimals, a size before what it counts (as many bytes as it takes, seven bits each), data apart, written last, and a
// part set aside, written later)
Output := {
  static cw_write (b) => outbyte(untag(b))
  static cw_write_value (v: Text) => (v is Text) ? Output.bytes_written(v.from, v.to - v.from) : outbyte(untag(v))
  static cw_written_at => int(outn)
  static cw_counted => {
    counter = counter + 1
    int(counter - 1)
  }
  static cw_write_number (x) => Output.number_written((untag(x) < 0) ? 0 : untag(x))
  static number_written (n) => {
    d := 1
    while (n / d) >= 10 {
      d = d * 10
    }
    while d > 0 {
      outbyte(48 + ((n / d) % 10))
      d = d / 10
    }
    0
  }
  static bytes_written (from, n) => {
    j := 0
    while j < n {
      outbyte(byte(from + j))
      j = j + 1
    }
    0
  }
  static leb_written (n) => {
    v := n
    while v >= 128 {
      outbyte((v & 127) | 128)
      v = v >> 7
    }
    outbyte(v)
  }
  static leb_length (n) => {
    k := 1
    v := n >> 7
    while v != 0 {
      k = k + 1
      v = v >> 7
    }
    k
  }
  static cw_sized_from (x) => Output.sized(untag(x), outn - untag(x), Output.leb_length(outn - untag(x)))
  static sized (m, n, k) => {
    j := outn - 1
    while j >= m {
      byte_put(outb + (j + k), byte(outb + j))
      j = j - 1
    }
    v := n
    i := 0
    while i < k {
      byte_put(outb + (m + i), ((i + 1) < k) ? ((v & 127) | 128) : (v & 127))
      v = v >> 7
      i = i + 1
    }
    outn = outn + k
    int(outn)
  }
  static cw_datum (t: Text) => {
    datab = (datab == 0) ? lasting_alloc(4194304) : datab
    from := datan
    j := t.from
    while j < t.to {
      byte_put(datab + datan, byte(j))
      datan = datan + 1
      j = j + 1
    }
    int(from)
  }
  static cw_data_out => {
    Output.leb_written(datan)
    Output.bytes_written(datab, datan)
  }
  static cw_aside_from (x) => {
    asideb = (asideb == 0) ? lasting_alloc(4194304) : asideb
    j := untag(x)
    while j < outn {
      byte_put(asideb + asiden, byte(outb + j))
      asiden = asiden + 1
      j = j + 1
    }
    outn = untag(x)
    0
  }
  static cw_aside_out => {
    Output.bytes_written(asideb, asiden)
    asiden = 0
    0
  }
  static cw_taken => (takent == 0) ? Output.taken_from(alloc(outn + 8)) : takent
  static taken_from (c) => {
    copy(c, outb, outn)
    takent = text(c, c + outn)
    kept()
    outn = 0
    takent
  }
}
// Splices (`level spliced …`): a capture, `open close` (what opens, a space, what closes), in a text: what is between an
// open and a close (or a doubled open and a doubled close) is a name, taken from a list of entries (each a key and a
// value, `take_named`: the value, trimmed, itself a capture of a name taken further on, that), and written in its place.
Splices := {
  static Taken := (entry, past)
  static opening_end_at (from, to) => {
    oe := from
    while (oe < to) && (byte(oe) != 32) {
