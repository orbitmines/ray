@linux
@windows
@macos
@browser
@ether/time
@ether/random

// Ether: the language as the operating system. What the host's externals answer elsewhere is written here in Ray; what
// differs per operating system otherwise lives in the package it is about (`if OS.Ether { … }`: storage and streams in
// @ether/filesystem and Device.ray, the clock in @ether/time and zones in @ether/timezone, sockets in network, font folders
// in $/Font). It depends on every other operating system, so a project depending on it can tell them all apart.
OS.Ether := OS(platform: "ether")
OS.Ether &+= {
  // the language as the operating system says only what it is
  [property: String] => { "platform": "ether", "architecture": "ray" }[property]
  // a character's Unicode scalar, a bit at a time, most significant first: on ether a character already is its scalar
  bits (character: Char, take) => (character as Binary).integer.for(take)
}

assert OS.Ether["platform"] == "ether"  // ETH4 the language as the operating system does not name its platform ether
assert OS.Ether.architecture == "ray"  // ETH10 the language as the operating system is not built on ray

// An operating system is one of those loaded; as a boolean, whether it is the one the device runs.
assert [OS.Ether, OS.Linux, OS.Macos, OS.Windows, OS.Browser].every(. is OS)  // OSE1 an operating system is not one of OS
assert OS#{as boolean}.count == 1  // OSE3 other than one operating system runs this device
assert (@me/device as OS) === OS.host  // OSE4 the device does not run the operating system the host reports
assert {
  with (@me/device as OS) = OS.Windows {
    assert OS.Windows  // OSE6 the operating system the device runs is not true as a boolean
    assert !(OS.Linux)  // OSE7 an operating system the device does not run is true as a boolean
  }
}
// What the machine says about itself.
assert (@me/device as OS).platform  // IO1 the machine does not say what it is
assert (@me/device as OS).architecture  // IO2 the machine does not say what it is built on
assert (@me/device as OS)["architecture"] == (@me/device as OS).architecture  // IO4 asking by name is not asking the other way
assert (@me/device as OS).env.PATH == (@me/device as OS)["PATH"]  // ENV1 the environment is not read through the OS

assert {
  with (@me/device as OS) = OS.Ether {
    @me/instance = "a"
    @me/instance = "b"
    assert @me/device/storage["instance/sent"] == "b" && @me/device/storage["instance/sent"].previous == "a"  // ETH9 what is sent to an instance on ether is not kept in order
    assert [Random.bit, Time.now, ("a" as Location).held()].every(.erred)  // ETH8 what the language as the operating system has not written yet does not err
  }
}
