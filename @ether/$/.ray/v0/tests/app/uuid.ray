mark ^keyword := external global

uu := UUID.v4()
unless (uu.spelled.count == (three * ten) + two) { INFO@mark `UU1 v4 has other than 32 digits` }
unless (uu.version == four) { INFO@mark `UU2 v4 version is not 4` }
unless (uu.variant == UUID.Variant.rfc_4122) { INFO@mark `UU3 v4 variant is not RFC 4122` }
uu_text := uu.as_string
unless (uu_text.count == (three * ten) + six) { INFO@mark `UU4 v4 text is not 36 characters` }
unless (uu_text.at(eight) == Character.of(ascii_dash)) { INFO@mark `UU5 no dash after eight digits` }
unless (uu_text.at(ten + four) == Character.of(ascii_zero + four)) { INFO@mark `UU6 the version digit is not 4` }

// A UUID is itself.
unless (uu == uu) { INFO@mark `UU7 a uuid is not itself` }

// The text form puts its dashes where RFC 4122 asks.
unless (uu_text.at(ten + three) == Character.of(ascii_dash)) { INFO@mark `UU10 no dash after thirteen characters` }
unless (uu_text.at((ten * two) - two) == Character.of(ascii_dash)) { INFO@mark `UU11 no dash after eighteen characters` }
unless (uu_text.at((two * ten) + three) == Character.of(ascii_dash)) { INFO@mark `UU12 no dash after twenty-three characters` }

// spec: two draws are two uuids, which `feature.ray` claims of the bits they
// are drawn from rather than of the uuids. A second draw here costs more than
// ten minutes: the digits now actually vary, so every nibble is accumulated
// rather than left at zero, and a number is a walk.

// What is written down is read back as the same uuid. A text is read here
// rather than a drawn uuid written out and read again, because drawing costs
// a nibble's worth of walking for each of thirty-two digits.
spelled_out := String.of(`00000000-0000-4000-8000-000000000000`)
read_back := UUID.read(spelled_out)
unless (read_back.spelled.count == ((three * ten) + two)) { INFO@mark `UU15 what is read back has other than 32 digits` }
unless (read_back.version == four) { INFO@mark `UU16 what is read back is not of the version it was written with` }
unless (read_back.variant == UUID.Variant.rfc_4122) { INFO@mark `UU17 what is read back is not of the variant it was written with` }
unless (read_back.as_string == spelled_out) { INFO@mark `UU13 a uuid written down does not read back as itself` }

// What a digit written in sixteen is worth, either case.
unless (String.of(`7`).first.hexadecimal_digit == seven) { INFO@mark `UU18 7 is not seven in sixteen` }
unless (String.of(`a`).first.hexadecimal_digit == ten) { INFO@mark `UU19 a is not ten in sixteen` }
unless (String.of(`F`).first.hexadecimal_digit == (ten + five)) { INFO@mark `UU20 F is not fifteen in sixteen` }

// The other versions the draft names. spec: what makes each of them what it
// is — a timestamp, an md5, an sha1 — waits on the clock and on the hashes,
// so what is claimed here is that they are written down.
unless (exists UUID.v1) { INFO@mark `UU21 the version built from a time is not there` }
unless (exists UUID.v3) { INFO@mark `UU22 the version built from a namespace and a name is not there` }
unless (exists UUID.v5) { INFO@mark `UU23 the other version built that way is not there` }
// spec: building a `v3` or a `v5` is not claimed here — the `namespace: UUID`
// field is typed, and asking whether a thirty-two digit uuid is one costs
// more than the rest of the file.
