Compiler.default = {
  {label}\ => external js.flow.label
  goto {label} => external js.flow.jump
  goto {label} if {condition} => external js.flow.jump
  {a: Number}.succ => external js.number.succ
  {a: Number} + {b: Number} => external js.number.+
  {a: Number} - {b: Number} => external js.number.-
  {a: Number} * {b: Number} => external js.number.*
  {a: Number} / {b: Number} => external js.number./
  {a: Number} % {b: Number} => external js.number.%
  {a: Number} < {b: Number} => external js.number.<
  {a: Number} == {b: Number} => external js.number.==
  {a: Character} == {b: Character} => external js.character.==
  {a: Character}.width => external js.character.width
  {a: Character}.octets => external js.character.octets
  {a: Character}.codepoint => external js.character.codepoint
  {a: Character}.is_ascii => external js.character.is_ascii
  {a: Character}.lower_case => external js.character.lower_case
  {a: Character}.upper_case => external js.character.upper_case
  {a: Character}.letter => external js.character.letter
  {a: Character}.digit => external js.character.digit
  {a: Character}.blank => external js.character.blank
  {a: Character}.is_underscore => external js.character.is_underscore
  {a: Character}.word => external js.character.word
  {a: Character}.digit_value => external js.character.digit_value
  {written: String} => external js.string.written
  {a: String} == {b: String} => external js.string.==
  {a: String}.count => external js.string.count
  {a: String}.length => external js.string.length
  {a: String}.empty => external js.string.empty
  {a: String}.nonempty => external js.string.nonempty
  {a: String}.is_numeric => external js.string.is_numeric
  {a: String}.starts_with {b: String} => external js.string.starts_with
  {a: String}.ends_with {b: String} => external js.string.ends_with
  {a: String}.contains {b: String} => external js.string.contains
  {a: String}.index_of {b: String} => external js.string.index_of
  {a: String}.slice {b} => external js.string.slice
  {a: Number}.pred => external js.number.pred
  {a: Number}.holds => external js.number.pred
  {a: Number}.is_zero => external js.number.is_zero
  {a: Number}.nonzero => external js.number.nonzero
}
