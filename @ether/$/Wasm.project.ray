    | ne (code: 0x47, ray: "!=") | lt_s (code: 0x48, ray: "<") | lt_u (code: 0x49) | gt_s (code: 0x4A, ray: ">") | gt_u (code: 0x4B)
    | le_s (code: 0x4C, ray: "<=") | le_u (code: 0x4D) | ge_s (code: 0x4E, ray: ">=") | ge_u (code: 0x4F) | clz (code: 0x67) | ctz (code: 0x68)
    | popcnt (code: 0x69) | add (code: 0x6A, ray: "+") | sub (code: 0x6B, ray: "-") | mul (code: 0x6C, ray: "*") | div_s (code: 0x6D, ray: "/")
    | div_u (code: 0x6E) | rem_s (code: 0x6F, ray: "%") | rem_u (code: 0x70) | and (code: 0x71, ray: "~&&") | or (code: 0x72, ray: "~||")
    | xor (code: 0x73, ray: "~^^") | shl (code: 0x74, ray: "<<") | shr_s (code: 0x75, ray: ">>") | shr_u (code: 0x76, ray: ">>>") | rotl (code: 0x77)
    | rotr (code: 0x78) | wrap_i64 (code: 0xA7) | trunc_f32_s (code: 0xA8) | trunc_f32_u (code: 0xA9) | trunc_f64_s (code: 0xAA)
    | trunc_f64_u (code: 0xAB) | reinterpret_f32 (code: 0xBC) | extend8_s (code: 0xC0) | extend16_s (code: 0xC1) | trunc_sat_f32_s (code: (0xFC, 0))
    | trunc_sat_f32_u (code: (0xFC, 1)) | trunc_sat_f64_s (code: (0xFC, 2)) | trunc_sat_f64_u (code: (0xFC, 3))
    | atomic_load (code: (0xFE, 16), takes: MemArg) | atomic_load8_u (code: (0xFE, 18), takes: MemArg{align = 0})
    | atomic_load16_u (code: (0xFE, 19), takes: MemArg{align = 1}) | atomic_store (code: (0xFE, 23), takes: MemArg)
    | atomic_store8 (code: (0xFE, 25), takes: MemArg{align = 0}) | atomic_store16 (code: (0xFE, 26), takes: MemArg{align = 1})
    | atomic_rmw_add (code: (0xFE, 30), takes: MemArg) | atomic_rmw8_add_u (code: (0xFE, 32), takes: MemArg{align = 0})
    | atomic_rmw16_add_u (code: (0xFE, 33), takes: MemArg{align = 1}) | atomic_rmw_sub (code: (0xFE, 37), takes: MemArg)
    | atomic_rmw8_sub_u (code: (0xFE, 39), takes: MemArg{align = 0}) | atomic_rmw16_sub_u (code: (0xFE, 40), takes: MemArg{align = 1})
    | atomic_rmw_and (code: (0xFE, 44), takes: MemArg) | atomic_rmw8_and_u (code: (0xFE, 46), takes: MemArg{align = 0})
    | atomic_rmw16_and_u (code: (0xFE, 47), takes: MemArg{align = 1}) | atomic_rmw_or (code: (0xFE, 51), takes: MemArg)
    | atomic_rmw8_or_u (code: (0xFE, 53), takes: MemArg{align = 0}) | atomic_rmw16_or_u (code: (0xFE, 54), takes: MemArg{align = 1})
    | atomic_rmw_xor (code: (0xFE, 58), takes: MemArg) | atomic_rmw8_xor_u (code: (0xFE, 60), takes: MemArg{align = 0})
    | atomic_rmw16_xor_u (code: (0xFE, 61), takes: MemArg{align = 1}) | atomic_rmw_xchg (code: (0xFE, 65), takes: MemArg)
