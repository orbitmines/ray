
Component := class {
  {literal label ^label}\ ^punctuation => return this
}

never := Node{false}
assert !(never.admits(5))  // NV1 something is of the type that never returns

// Only the branch that is taken runs
assert {
  counted := false
  taken_once := if true { true } else {
    counted = true
    false
  }
  assert taken_once  // CF1 a taken branch did not answer
  assert !counted  // CF2 the branch nobody took ran anyway
}

assert {
  arms := 0
  picked := if false {
    arms += 1
    1
  } elsif true {
    arms += 1
    2
  } elsif true {
    arms += 1
    3
  } else {
    arms += 1
    4
  }
  assert picked == 2  // CF3 the first holding arm is not what answered
  assert arms == 1  // CF4 more than one arm of a chain ran
}

assert {
  left := 3
  rounds := 0
  while left {
    rounds += 1
    left -= 1
  }
  assert rounds == 3  // CF10 a loop ran other than three times
  assert left == 0  // CF11 a loop left its count behind
}

// `;`
assert (1 ; 2) == 2  // CF14 the semicolon does not answer what is written after it

assert (1 ; 2 ; 3) == 3  // CF15 the last of three is not what the whole answers

assert {
  semi_counted := 0
  (semi_counted = 1) ; (semi_counted += 1)
  assert semi_counted == 2  // CF16 two bracketed statements on one line did not both run
}

// (what the bootstrap leaves to this file: it needs what is here)
assert {
  Panel := class: Component {
    shown := 0
   opened\
    shown = 1
   closed\
    shown = 2
  }
  assert Panel().shown == 0  // CMP2 constructing a component runs past its first label
  assert Panel~opened().shown == 1  // CMP3 entering a component at a label runs past the next label
  assert Panel~closed().shown == 2  // CMP4 entering a component at its last label does not run what follows it
}

// Rules that circularly prevent each other from existing: each one's only definition sits inside a region another one
// reads away (a comment), so none of them can be the first. Each is an error. (What says an error is expected in a test is
// not written yet: until it is, these fail with the error they expect.)
// PV1 two rules, each defined in the other's comment, did not err as preventing each other
assert {
  /*
  {`/$`}{comment}{`$/`} =>
  */

  /$
  {`/*`}{comment}{`*/`} =>
  $/
}
// PV2 three rules in a cycle, each defined in the comment of the one before, did not err as preventing each other
assert {
  /*
  {`/$`}{comment}{`$/`} =>
  */

  /$
  {`/#`}{comment}{`#/`} =>
  $/

  /#
  {`/*`}{comment}{`*/`} =>
  #/
}
// PV3 four rules in a cycle did not err: an even cycle has readings (every other rule existing), but which one depends on
// the order it is read in, so it errs like any other
assert {
  /*
  {`/$`}{comment}{`$/`} =>
  */

  /$
  {`/#`}{comment}{`#/`} =>
  $/

  /#
  {`/%`}{comment}{`%/`} =>
  #/

  /%
  {`/*`}{comment}{`*/`} =>
  %/
}
