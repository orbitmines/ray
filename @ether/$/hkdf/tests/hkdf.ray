// HKDF-SHA256 against RFC 5869 (https://www.rfc-editor.org/rfc/rfc5869#appendix-A).

mark ^keyword := global

// Test case 1: 22 bytes of 0x0b, salt 00..0c, info f0..f9, 42 bytes (https://www.rfc-editor.org/rfc/rfc5869#appendix-A.1)
kdf := HKDF(SHA256)
unless kdf.extracted(0..<13, [0x0b] * 22) as Hexadecimal₆₄ == "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5" { INFO@mark `NZ1 the PRK of RFC 5869's test case 1 is not 07770936…` }
unless kdf.derived(0..<13, [0x0b] * 22, 0xf0..<0xfa, 42) as Hexadecimal₈₄ == "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865" { INFO@mark `NZ2 the OKM of RFC 5869's test case 1 is not 3cb25f25…` }
// Test case 3: no salt and no info (https://www.rfc-editor.org/rfc/rfc5869#appendix-A.3)
unless kdf.derived([], [0x0b] * 22, [], 42) as Hexadecimal₈₄ == "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8" { INFO@mark `HKDF1 the OKM of RFC 5869's test case 3 is not 8da4e775…` }
unless $.hkdf === HKDF { INFO@mark `HKDF2 $.hkdf is not HKDF` }
