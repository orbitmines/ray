mark ^keyword := external global

summer := "2024-07-01T12:00:00Z" as ISO_8601 as Time
winter := "2024-01-15T12:00:00Z" as ISO_8601 as Time
unless TimeZone("UTC").at(summer).offset == 0 seconds { INFO@mark `TZ14 UTC is off zero on this host` }
unless TimeZone.Zoneinfo(directory: @tzif/zoneinfo).version == "2026c" { INFO@mark `TZ8 the downloaded data is not tzdata 2026c` }

// Where the zones are read, per operating system.
with @me/device/os = OS.Linux {
  unless TimeZone.source is TimeZone.Zoneinfo { INFO@mark `TZ1 linux does not read the host's zoneinfo` }
  if TimeZone.source.directory == @tzif/zoneinfo { INFO@mark `TZ3 linux downloads the data instead of reading the host's` }
  if TimeZone.source.directory ~= ⊢"tzif" { INFO@mark `TZ18 a host refers to @tzif for its zone data` }
  unless TimeZone.source.at("UTC", winter).offset == 0 seconds { INFO@mark `TZ15 UTC is off zero on linux` }
}
with @me/device/os = OS.Macos {
  unless TimeZone.source is TimeZone.Zoneinfo { INFO@mark `TZ2 macos does not read the host's zoneinfo` }
}
with @me/device/os = OS.Windows {
  unless TimeZone.source is TimeZone.ICU { INFO@mark `TZ4 windows does not ask the OS's ICU` }
}
with @me/device/os = OS.Browser {
  unless TimeZone.source is TimeZone.Intl { INFO@mark `TZ5 the browser does not ask Intl` }
}
with @me/device/os = OS.Ether {
  unless TimeZone.source is TimeZone.Zoneinfo { INFO@mark `ETH7 the language as the operating system does not read TZif` }
  unless TimeZone.source.directory == @tzif/zoneinfo { INFO@mark `TZ17 the language as the operating system does not take its zone data from @tzif/zoneinfo` }
  amsterdam := TimeZone("Europe/Amsterdam")
  unless amsterdam.at(summer).offset == 2 hours { INFO@mark `TZ9 Amsterdam in summer is not at +02:00 on ether` }
  unless amsterdam.at(summer).abbreviation == "CEST" && amsterdam.at(summer).daylight { INFO@mark `TZ10 Amsterdam in summer is not on CEST` }
  unless amsterdam.at(winter).offset == 1 hour { INFO@mark `TZ11 Amsterdam in winter is not at +01:00 on ether` }
  unless amsterdam.at(winter).abbreviation == "CET" && !amsterdam.at(winter).daylight { INFO@mark `TZ12 Amsterdam in winter is not on CET` }
  unless TimeZone("UTC").at(summer).offset == 0 seconds { INFO@mark `TZ13 UTC is off zero on ether` }
}
Counting := class: TimeZone.Zoneinfo {
  asked: String[] = []
  data (zone: String) => (asked.push zone) -- $.tzif.read((directory / zone).bytes)
}
counting := Counting(directory: @tzif/zoneinfo)
counting.at("Europe/Amsterdam", summer)
unless counting.asked == ["Europe/Amsterdam"] { INFO@mark `TZ16 reading one zone read others than the one asked for` }

// RFC 9557: the zone named in brackets
paris := "2026-10-06T12:00:00+02:00[Europe/Paris]" as ISO_8601
unless paris.zone.name == "Europe/Paris" { INFO@mark `WD10 the zone named in brackets is not read` }
