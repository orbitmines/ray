mark ^keyword := external global

a := Ray()
b := Ray(previous: a)

unless (a.is_initial) { INFO@mark `a lone ray is not initial` }

unless (a.nonempty) { INFO@mark `a lone ray counts as empty` }

if (b.is_initial) { INFO@mark `a linked ray reports initial` }

unless (b.initial == a) { INFO@mark `the initial walk failed` }

unless (a.count == one) { INFO@mark `a lone ray does not count one` }

unless (a.terminal == a) { INFO@mark `a lone ray is not its own terminal` }

unless ((b.min(b)) == b) { INFO@mark `Ordered.min did not reach Ray` }

c := Ray(previous: b)
// A ray's previous and next are its own: linking one way does not link back.
a.next = b
b.next = c
unless ((a.at(two)) == c) { INFO@mark `R8 at(2) did not reach the third ray` }

seen ^keyword := zero
a for { seen = seen.succ }
unless (seen == three) { INFO@mark `R9 for did not visit three rays` }

unless (a every { it.nonempty }) { INFO@mark `R10 every failed` }

unless (a some { it.is_terminal }) { INFO@mark `R11 some failed` }

unless (a.initial_boundary.is_initial) { INFO@mark `R12 initial boundary is not initial` }

unless (a.terminal_boundary.edge.is_terminal) { INFO@mark `R13 the edge of a terminal boundary is not terminal` }

unless (a.acyclic) { INFO@mark `R14 a chain is not acyclic` }

// Boundaries and edges: which end a boundary is, and which ends an edge has.
start := Boundary.Initial()
finish := Boundary.Terminal()
unless (start.is_initial) { INFO@mark `R15 an initial boundary is not initial` }
if (start.is_terminal) { INFO@mark `R16 an initial boundary is terminal` }
unless (finish.is_terminal) { INFO@mark `R17 a terminal boundary is not terminal` }
if (finish.is_initial) { INFO@mark `R18 a terminal boundary is initial` }
span := Edge(from: start, to: finish)
unless (exists span.from) { INFO@mark `R19 an edge forgot where it starts` }
unless (exists span.to) { INFO@mark `R20 an edge forgot where it ends` }
if (span.is_initial) { INFO@mark `R21 an edge that starts somewhere is initial` }
if (span.is_terminal) { INFO@mark `R22 an edge that ends somewhere is terminal` }

// What a structure allows.
unless (Structure().is_valid) { INFO@mark `R23 a structure is not valid` }
if (Structure().hyper_edges) { INFO@mark `R24 a plain structure has hyper edges` }
unless (Hypergraph().hyper_edges) { INFO@mark `R25 a hypergraph has no hyper edges` }

// A chain: what it holds, in the order it was given, and how it is walked.
kept ^keyword := chain None
unless (kept.count.is_zero) { INFO@mark `R26 a fresh chain counts other than zero` }
unless (kept.empty) { INFO@mark `R27 a fresh chain is not empty` }
if (exists kept.head) { INFO@mark `R28 a fresh chain has a head` }
kept &= one
unless (kept.count == one) { INFO@mark `R29 one thing kept does not count one` }
unless (kept.nonempty) { INFO@mark `R30 a chain holding something is empty` }
unless (kept.head.value == one) { INFO@mark `R31 the head does not hold what was given` }
unless (kept.tail.value == one) { INFO@mark `R32 the tail does not hold the only thing` }
kept &= two
kept &= three
unless (kept.count == three) { INFO@mark `R33 three things kept do not count three` }
unless (kept.head.value == one) { INFO@mark `R34 the head is not the first thing given` }
unless (kept.tail.value == three) { INFO@mark `R35 the tail is not the last thing given` }
unless (kept.first.value == one) { INFO@mark `R36 the first is not the first thing given` }
unless (kept.last.value == three) { INFO@mark `R37 the last is not the last thing given` }
unless (kept.at(one).value == two) { INFO@mark `R38 the one after the first is not the second thing given` }

walked ^keyword := zero
total ^keyword := zero
kept for {
  walked = walked.succ
  total = total + it.value
}
unless (walked == three) { INFO@mark `R39 walking a chain of three does not visit three` }
unless (total == (three + three)) { INFO@mark `R40 walking a chain of one, two and three does not add to six` }

// A chain of nothing holds nothing, and what holds nothing is dropped.
mixed ^keyword := chain None
mixed &= one
mixed &= None
mixed &= two
unless (mixed.count == three) { INFO@mark `R41 a chain does not keep what holds nothing` }
