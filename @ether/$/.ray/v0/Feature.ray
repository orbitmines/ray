Location &+= {
  normalised => segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  sandboxed => "instance/" + normalised
  system: FileSystem => Compiler.reduced(this, FileOptimizations)
  content => system.read(this) as String
  bytes => (system.read(this) ?? []) as Byte[]
  listing => system.listing(this)
  exists => system.exists(this)
  write (content): static => this ~~ system.write(., content)
  remove: static => this ~~ system.removed(.)
  origin => Location(scheme, host, port, path: "")
  .content = {value} ^punctuation => write(value)
}

FileSystem := class: Language {
  read (location: Location) => Quest(name: "a reader for the location", goal: location)
  write (location: Location, content) => Quest(name: "a writer for the location", goal: location)
  listing (location: Location) => []
  exists (location: Location) => read(location) != None
  removed (location: Location) => write(location, None)

  static Posix := class: FileSystem {
    read (location: Location) => external io location.sandboxed None
    write (location: Location, content) => external io location.sandboxed content
    listing (location: Location) => IO.host(location as String).lines{.nonempty}.map(location / .)
    removed (location: Location) => external os `remove` location.sandboxed
  }
  static Browser := class: FileSystem {
    key (location: Location) => "ray:" + location.normalised
    read (location: Location) => Process(command: "localStorage.getItem(" + $.json.write(key(location)) + ")").stdout
    write (location: Location, content) => Process(command: content === None
      ? "localStorage.removeItem(" + $.json.write(key(location)) + ")"
      : "localStorage.setItem(" + $.json.write(key(location)) + ", " + $.json.write(content as String) + ")").stdout
    listing (location: Location) => $.json.read(Process(command: "JSON.stringify(Object.keys(localStorage).filter(key => key.startsWith(" + $.json.write(key(location) + "/") + ")))").stdout)
      .map(.after(key(location) + "/").before("/")).unique.map(location / .)
  }
  static Remote := class: FileSystem {
    remotely (location: Location) => Network.Remote(character: @me, location: location.scheme ? location.origin : @remote)
    inner (location: Location) => (location.scheme ? location.path : location.segments[1..].join("/")) as Location
    read (location: Location) => location.scheme ~= ⊢"http"
      ? Process(command: "curl", arguments: ["-fsSL", location as String]) -- (.succeeded ? .stdout : None)
      : remotely(location).run({ inner(location).content })
    write (location: Location, content) => location.scheme ~= ⊢"http"
      ? Process(command: "curl", arguments: content === None ? ["-fsS", "-X", "DELETE", location as String] : ["-fsS", "-X", "PUT", "--data-binary", "@-", location as String], input: content as String).succeeded
      : remotely(location).run({ inner(location).write(content) })
    listing (location: Location) => location.scheme ~= ⊢"http"
      ? (Process(command: "curl", arguments: ["-fsS", "-X", "PROPFIND", "-H", "Depth: 1", location as String]).stdout ~= (*, "<D:href>", href: (!"<")[], "</D:href>")[]).href[1..].map(. as Location)
      : remotely(location).run({ inner(location).listing })
  }
  static Device := class: FileSystem {
    on (location: Disk) => Instance#{.device === location.device}.first -- (. && . !== Instance.local ? Remote() : Posix())
    read (location: Location) => on(location).read(location.local)
    write (location: Location, content) => on(location).write(location.local, content)
    listing (location: Location) => on(location).listing(location.local)
  }
}

Disk := class: Location = device: Device {
  local => Instance#{.device === device}.first -- (. && . !== Instance.local ? (.address as String + path) as Location : (path as Location))
  / (segment: String) => Disk(device, path: (path as String) + "/" + segment)
  .{literal name ^property} ^punctuation => .declaring(name) ? external get this name : this / name
}

FileOptimizations := {
  {location: Disk} => FileSystem.Device()
  {location: Location{scheme && scheme != "file"}} => FileSystem.Remote()
  {location: Location{segments.first == "remote"}} => FileSystem.Remote()
  {location: Location{OS().name == browser}} => FileSystem.Browser()
  {location: Location} => FileSystem.Posix()
}

IO := class {
  read (location) => (location as Location).content
  write (location, content) => (location as Location).write(content)
  output (text: String) => external io `/dev/stdout` text
  host (location) => Run.current.ask(`size`, location) -- (. == true ? (external io location None) as String : .)
  field (name: String) => (name + (".ray" | "/" | ""))#.map(read(.)).first(.nonempty) ?? ""
  listing (location) => (location as Location).listing
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => (external random) ? 1 : 0
  bits (count: Number) => count.times.map(bit)
  number (width: Number) => Binary(integer: bits(width).map(Binary.digit))
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }

  static Seeded := class = state: Number {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    number (width: Number) => Binary(integer: width.times.map(bit).map(Binary.digit))
  }
}

choose {type} ^keyword => @me.choose(type)
Choice := class = type: *?, value: *?

Proof := class = proposition: *, argument: * {
  static Proposition := class = holds: boolean = true, fact: *?, verified = false {
    negated => Proposition(holds: !holds, fact)
    quest => Quest(name: "verify the assumption", goal: fact)
    verify (actual) => verified = actual == fact
    rolled_back => !verified
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : Quest(name: "prove", goal: proposition)
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
  static failed (error) => Quest(name: "fix", goal: error)
}

! `+` `-`
! `*` `/`

Transaction := class = forwards: *?, backwards: *? = forwards⁻¹, history: History = History(), applied = false {
  branch: History = history.fork

  record (who, change): static => this ~~ branch.commit(who, change)
  commit: static => this ~~ history.merge(branch) ~~ (.applied = true)
  abort: static => this ~~ branch.drop
  reversed => Transaction(forwards: backwards, backwards: forwards, history, applied)
}

Network := class {
  static fetch (from: Location, path: String, version: Version?) => (IO.read(from / path + (version as String)) if version) ?? IO.read(from / path)
}

OS := class {
  [property: String] => (external os property) as String
  platform => this["platform"]
  architecture => this["architecture"]
  name: linux | macos | windows | browser | ether | unknown => platform ? { "linux": linux, "darwin": macos, "win32": windows, "browser": browser, "ether": ether }[platform] ?? unknown : ether

  static Ether := class: OS {
    [property: String] => { "platform": "ether", "architecture": "ray" }[property]
  }

  static launch (location: Location) => external os `open` (location as String)
  static run (command: String, arguments: String[] = []) => Process(command, arguments)
}

Device := class {
  static Capability := enum storage | network | notifications | fullscreen | clipboard | share | vibration | wake_lock | camera | microphone | geolocation | print | speech

  os: OS = OS()
  keyboard: Keyboard = Keyboard()
  capabilities: Capability?
  handheld = false
  clipboard: String | Location = ""
  pads: (buttons: boolean[], axes: Number[])?
  orientation: Geometry.Vector?
  motion: Geometry.Vector?
  geolocation: (latitude: Number, longitude: Number, accuracy: Geometry.Length)?
  preferences: (reduced_motion: boolean, dark: boolean, contrast: more | less | normal, focused: boolean) = (false, false, normal, true)
  notification: (title: String, body: String)?
  fullscreen = false
  printing = false
  opened: Location?
  memory: Store = Store(at: @"memory")
  disk => Disk(device: this, path: "")

  choose (s) => s#.count is ∞ && !s#.some(.weight) ? ERROR@Type `no uniform choice exists over infinitely many possibilities; give them weights` : s#.random
}

Keyboard := class: Location {
  static Modifier := enum shift | control | alt | meta

  static Key := class: Nameable = code: Number?, modifiers: Modifier? {
    pressed = false

    presses => pressed.history{.value == true}.count
    toggled => presses.odd
    pulsed (max: Number = 0, delay: Quantity.Temporal = 500 ms) => pressed && (max == 0 || presses <= max)
      && (presses == 1 || Time.now - pressed.history{.value == true}.last.when >= delay)

    press (modifiers: Modifier? = None): static => this ~~ (.modifiers = modifiers) ~~ (.pressed = true)
    release: static => this ~~ .pressed = false
    cycle (iterable) => iterable[presses % iterable.count]
  }

  keys => children{is Key}
  [name] => keys{.name == name}.first ?? add(Key(name))
  coded (code: Number) => keys{.code == code}.first ?? add(Key(name: code as Char as String, code))
  pressed (name, modifier: Modifier? = None) => this[name] -- (key => key.pressed && (!modifier || modifier#.some(key.modifiers ∋ .)))
  .{literal name ^property} ^punctuation => .declaring(name) ? external get this name : this[name]
}

Chat := class {
  message: String?

  messages => message.history
  say (who, text: String): static => this ~~ message.history.commit(who, text)
  count => messages.count
}
