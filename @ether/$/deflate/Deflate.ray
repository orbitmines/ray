// DEFLATE Compressed Data Format Specification version 1.3 (https://www.rfc-editor.org/rfc/rfc1951)
Deflate := class: Language {
  static extensions := ".deflate"

  // Huffman codes given by their lengths alone: shorter codes first, equal lengths in symbol order, each the next binary number (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.2)
  static Huffman := class lengths: Decimal[] {
    table := None
    codes =>
      (.table := coded) unless .table
      .table
    coded =>
      made := []
      code := 0
      width := 1
      while width <= 15 {
        at := lengths.head
        index := 0
        while at {
          if at.value == width {
            made.append((symbol: index, bits: code.binary(width)))
            code = code + 1
          }
          index = index + 1
          at = at.next
        }
        code = code * 2
        width = width + 1
      }
      made
    // A symbol is read as the one code whose bits come next, most significant bit first, and written as its code (https://www.rfc-editor.org/rfc/rfc1951#section-3.1.1)
    Symbol => Coded(codes)
    // (whether the lengths fill the code: a code shorter than all, or one of codes past what the bits hold, is not one)
    fills =>
      code := 0
      width := 1
      while width <= 15 {
        at := lengths.head
        while at {
          (code = code + 1) if at.value == width
          at = at.next
        }
        code = code * 2
        width = width + 1
      }
      code == 65536
    bits (symbol) => codes.find((code) => code.symbol == symbol).bits

    // Lengths fitted to frequencies: the two least frequent join until one is left, each join one bit deeper (Huffman 1952, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.2)
    static fitted (frequencies) =>
      lengths := [0] * frequencies.count
      nodes := []
      index := 0
      at := frequencies.head
      while at {
        (nodes.append(Deflate.Weighted(at.value, [index]))) if at.value > 0
        index = index + 1
        at = at.next
      }
      while nodes.count > 1 {
        sorted := nodes.sort_by((node) => node.weight)
        joined := [sorted.first.symbols, sorted.rest.first.symbols].flatten
        joined.for((symbol) => Deflate.deepened(lengths, symbol))
        nodes = sorted.rest.rest
        nodes.append(Deflate.Weighted(sorted.first.weight + sorted.rest.first.weight, joined))
      }
      (Deflate.deepened(lengths, nodes.first.symbols.first)) if (nodes.count == 1) && (nodes.first.symbols.count == 1)
      Deflate.Huffman(lengths)
  }
  // (a node of `fitted`: how often its symbols are, and which they are; one symbol one bit deeper)
  static Weighted := class (weight, symbols)
  static deepened (lengths, symbol) =>
    at := lengths.head
    left := symbol
    while left > 0 {
      at = at.next
      left = left - 1
    }
    at.value = at.value + 1

  // Lengths 3..258 as codes 257..285 and distances 1..32768 as codes 0..29: each code's base and extra bits (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.5)
  static LengthBases := [(3, 0), (4, 0), (5, 0), (6, 0), (7, 0), (8, 0), (9, 0), (10, 0), (11, 1), (13, 1), (15, 1), (17, 1), (19, 2), (23, 2), (27, 2), (31, 2),
    (35, 3), (43, 3), (51, 3), (59, 3), (67, 4), (83, 4), (99, 4), (115, 4), (131, 5), (163, 5), (195, 5), (227, 5), (258, 0)]
  static DistanceBases := [(1, 0), (2, 0), (3, 0), (4, 0), (5, 1), (7, 1), (9, 2), (13, 2), (17, 3), (25, 3), (33, 4), (49, 4), (65, 5), (97, 5), (129, 6), (193, 6),
    (257, 7), (385, 7), (513, 8), (769, 8), (1025, 9), (1537, 9), (2049, 10), (3073, 10), (4097, 11), (6145, 11), (8193, 12), (12289, 12), (16385, 13), (24577, 13)]

  // A literal byte, or a copy of length bytes from distance bytes back (https://www.rfc-editor.org/rfc/rfc1951#section-2)
  static Literal := class byte: Byte
  static Copy := class (length: Decimal{(. >= 3) && (. <= 258)}, distance: Decimal{(. >= 1) && (. <= 32768)})

  // Data elements other than Huffman codes are fixed_stream starting with their least significant bit, so they read reversed (https://www.rfc-editor.org/rfc/rfc1951#section-3.1.1)
  static Data := class<literals: Huffman, distances: Huffman> (
    elements: (
      (literal: literals.Symbol{< 256})
      | (length_code: literals.Symbol{(. >= 257) && (. <= 285)}, length_extra: <-Binary{length == Deflate.LengthBases[length_code - 257].last},
         distance_code: distances.Symbol{< 30}, distance_extra: <-Binary{length == Deflate.DistanceBases[distance_code].last})
    )[],
    // End-of-block (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.5)
    literals.Symbol{== 256}
  ) {
    values => elements.map((element) => Deflate.value_of(element))
  }
  static value_of (element) => (element.literal !== None) ? Literal(element.literal)
    : Copy((LengthBases[element.length_code - 257].first) + element.length_extra, (DistanceBases[element.distance_code].first) + element.distance_extra)
  static coded (value) =>
    if value is Literal {
      return Element(literal: value.byte)
    }
    length := Deflate.base_of(LengthBases, value.length)
    distance := Deflate.base_of(DistanceBases, value.distance)
    Element(length_code: length + 257, length_extra: value.length - (LengthBases[length].first), distance_code: distance, distance_extra: value.distance - (DistanceBases[distance].first))
  // (an element of `Data` as `coded` writes it: a literal, or a length and a distance, each a code and its extra bits)
  static Element := class (literal, length_code, length_extra, distance_code, distance_extra)
  // (the last code whose base is not past a value)
  static base_of (bases, value) =>
    found := 0
    index := 0
    at := bases.head
    while at {
      (found = index) if at.value.first <= value
      index = index + 1
      at = at.next
    }
    found

  // Non-compressed block: to the byte boundary, LEN, its one's complement NLEN, then LEN bytes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.4)
  static Stored := class (padding: Binary{(length < 8) && (((at + length) % 8) == 0)}, size: <-Binary₁₆ = bytes.count, <-Binary₁₆{== 65535 - size}, bytes: (<-Byte)[]{length == size})

  // Fixed Huffman codes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.6)
  static fixed_literals := Huffman([[8] * 144, [9] * 112, [7] * 24, [8] * 8].flatten)
  static fixed_distances := Huffman([5] * 32)

  // Code lengths: 0–15 as they are, 16 repeats the previous 3–6 times, 17 a zero 3–10 times, 18 a zero 11–138 times (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.7)
  static CodeLengths := class<code: Huffman> (
    entries: (
      (length: code.Symbol{< 16})
      | (code.Symbol{== 16}, again: <-Binary₂)
      | (code.Symbol{== 17}, zeros: <-Binary₃)
      | (code.Symbol{== 18}, many: <-Binary₇)
    )[]
  ) {
    values =>
      (return None) unless code.fills
      made := []
      at := entries.head
      while at {
        entry := at.value
        if entry.length !== None {
          made.append(entry.length)
        } elsif entry.again !== None {
          (return None) if made.empty
          made.joined([made.last] * (entry.again + 3))
        } elsif entry.zeros !== None {
          made.joined([0] * (entry.zeros + 3))
        } else {
          made.joined([0] * (entry.many + 11))
        }
        at = at.next
      }
      made
  }

  // (an entry of `CodeLengths` as `dynamic` writes it: a run of zeros as 17 or 18, a run of a length as 16 after it)
  static Entry := class (length, again, zeros, many)
  static entries_of (lengths) =>
    made := []
    at := lengths.head
    while at {
      value := at.value
      run := 1
      ahead := at.next
      while ahead && (ahead.value == value) {
        run = run + 1
        ahead = ahead.next
      }
      at = ahead
      if (value == 0) && (run >= 3) {
        while run >= 11 {
          n := (run > 138) ? 138 : run
          made.append(Deflate.Entry(many: n - 11))
          run = run - n
        }
        if run >= 3 {
          made.append(Deflate.Entry(zeros: run - 3))
          run = 0
        }
      } else {
        made.append(Deflate.Entry(length: value))
        run = run - 1
        while run >= 3 {
          n := (run > 6) ? 6 : run
          made.append(Deflate.Entry(again: n - 3))
          run = run - n
        }
      }
      while run > 0 {
        made.append(Deflate.Entry(length: value))
        run = run - 1
      }
    }
    made
  static symbol_of (entry) => (entry.length !== None) ? entry.length : ((entry.again !== None) ? 16 : ((entry.zeros !== None) ? 17 : 18))

  // Dynamic Huffman codes: HLIT, HDIST, HCLEN, the code length code in its own order, then both codes' lengths as one sequence (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.7)
  static Order := [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
  static Dynamic := class (
    hlit: <-Binary₅ = literals.lengths.count - 257,
    hdist: <-Binary₅ = distances.lengths.count - 1,
    hclen: <-Binary₄ = 15,
    sizes: (<-Binary₃)[]{length == hclen + 4} = Deflate.Order.map((symbol) => length_code.lengths[symbol] ?? 0),
    lengths: Deflate.CodeLengths<length_code>{(hlit + 257 + hdist + 1) == values.count} = Deflate.CodeLengths(length_code, [literals.lengths, distances.lengths].flatten.map((length) => Deflate.Entry(length))),
    data: Deflate.Data<literals, distances>
  ) {
    length_code => Deflate.Huffman((0..18).map((symbol) => sizes[Deflate.Order.index_of(symbol)] ?? 0))
    literals => Deflate.Huffman(lengths.values.slice(0, hlit + 257))
    distances => Deflate.Huffman(lengths.values.slice(hlit + 257, lengths.values.count))
  }

  // Block header: BFINAL, then BTYPE: 0 stored, 1 fixed codes, 2 dynamic codes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.3)
  static Block := class (
    final: Binary₁ as boolean = false,
    kind: <-Binary₂{< 3} = 0,
    (stored: Deflate.Stored) if kind == 0,
    (data: Deflate.Data<Deflate.fixed_literals, Deflate.fixed_distances>) if kind == 1,
    (dynamic: Deflate.Dynamic) if kind == 2
  ) {
    values => stored ? stored.bytes.map((byte) => Deflate.Literal(byte)) : (data ?? dynamic.data).values
  }

  // Blocks up to the final one, padded to a byte; each byte's bits are taken least significant first (https://www.rfc-editor.org/rfc/rfc1951#section-3.1.1, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.3)
  static Stream := class (blocks: Deflate.Block[]{!.empty && .last.final}, padding: Binary{(length < 8) && (((at + length) % 8) == 0)}) {
    // A copy may reach back into earlier blocks, and may overlap what it writes (https://www.rfc-editor.org/rfc/rfc1951#section-2, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.3)
    bytes =>
      out := []
      at := blocks.head
      while at {
        value := at.value.values.head
        while value {
          (return None) unless Deflate.Stream.copied(out, value.value)
          value = value.next
        }
        at = at.next
      }
      out
    // (a copy reaching before the first byte is no copy: None)
    static copied (out, value) =>
      if value is Deflate.Literal {
        return out.append(value.byte)
      }
      (return None) if value.distance > out.count
      from := out.tail
      back := value.distance - 1
      while back > 0 {
        from = from.previous
        back = back - 1
      }
      left := value.length
      while left > 0 {
        out.append(from.value)
        from = from.next
        left = left - 1
      }
      out

    static from (bytes) => bytes.listing ? Deflate.Stream.bits_read(bytes.map((byte) => byte.binary(8).reversed).join("")) : None
    written => .binary.pieces(8).map((eight) => eight.reversed.unsigned)
  }

  // A stored block holds at most 65535 bytes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.4)
  static blocked (bytes) =>
    made := []
    from := 0
    loop {
      to := ((from + 65535) < bytes.count) ? (from + 65535) : bytes.count
      made.append(Block(final: to == bytes.count, kind: 0, stored: Stored(bytes: bytes.slice(from, to))))
      (break) if to == bytes.count
      from = to
    }
    made

  // LZ77: at each position the longest earlier match of at least 3 bytes, at most 258 long and 32768 back (https://www.rfc-editor.org/rfc/rfc1951#section-4)
  static parsed (bytes) =>
    text := bytes.latin1
    made := []
    at := 0
    while at < text.count {
      length := 0
      distance := 0
      loop {
        (break) if (length >= 258) || ((at + length + 1) > text.count)
        found := text.last_index_of(text.substring(at, at + length + 1), at - 1)
        (break) if (found < 0) || (found >= at) || ((at - found) > 32768)
        length = length + 1
        distance = at - found
      }
      if length >= 3 {
        made.append(Copy(length, distance))
        at = at + length
      } else {
        made.append(Literal(text.code_at(at)))
        at = at + 1
      }
    }
    made
  static fixed (values) => Data(literals: fixed_literals, distances: fixed_distances, elements: values.map((value) => Deflate.coded(value)))
  // (codes fitted to the values' own frequencies, the end of the block once; a distance code even when no copy needs one)
  static dynamic (values) =>
    codes := values.map((value) => Deflate.coded(value))
    literals := Huffman.fitted([codes.map((code) => code.literal ?? code.length_code), [256]].flatten.tally(286))
    distance_counts := codes.map((code) => code.distance_code ?? 30).tally(30)
    distances := Huffman.fitted((distance_counts.maximum > 0) ? distance_counts : [1])
    entries := entries_of([literals.lengths, distances.lengths].flatten)
    length_code := Huffman.fitted(entries.map((entry) => Deflate.symbol_of(entry)).tally(19))
    Dynamic(literals: literals, distances: distances, length_code: length_code, lengths: CodeLengths(length_code, entries), data: Data(literals: literals, distances: distances, elements: codes))
  // (fitted codes are at most 15 bits, 7 for the code lengths: https://www.rfc-editor.org/rfc/rfc1951#section-3.2.7)
  static fits (dynamic) => (dynamic.literals.lengths.maximum <= 15) && (dynamic.distances.lengths.maximum <= 15) && (dynamic.length_code.lengths.maximum <= 7)

  // (the bytes a stream inflates to; the bytes of a stream holding these: stored, with the fixed codes, or with codes fitted to
  // them, whichever is shortest)
  static inflated (bytes) => Stream.from(bytes).bytes
  static deflated (bytes) =>
    stored_stream := Stream(blocks: blocked(bytes))
    (return stored_stream.written) if bytes.empty
    values := parsed(bytes)
    fixed_stream := Stream(blocks: [Block(final: true, kind: 1, data: fixed(values))])
    shortest := (fixed_stream.binary.count < stored_stream.binary.count) ? fixed_stream : stored_stream
    fitted := dynamic(values)
    (return shortest.written) unless fits(fitted)
    dynamic_stream := Stream(blocks: [Block(final: true, kind: 2, dynamic: fitted)])
    (dynamic_stream.binary.count < shortest.binary.count) ? dynamic_stream.written : shortest.written
}
