@ether/os
@ether/random
@ether/version-control
@ether/time
@keyboard
@pointer
@controller
@camera
@microphone
@clipboard
@geolocation
@motion
@notification
@vibration
@speech
@printer
@display

// A device: the machine that runs the language, superposed with the devices it has (each its own project in `$/`: a
// keyboard, a pointer, controllers, a camera, …). What a device can do is a path under it, granted like anything else (`@me.execute { (@me/device as Camera) }`); a
// capability nobody granted is asked for (`&@.ask`).
Device := class {
  handheld: boolean = false
  opened: Location?
  share: Location?
  memory: Store = Store(at: @"memory")
  storage: Location = @"storage"
  assert @me/device/storage is Location  // IO11 the device has no storage location
  quests => Program#{who: this}{.running}
  // its files: this device's are the file space (`@/`), another's are at its instance (held by @ether/network)
  disk => Instance#{.device === this}.first -- (. && . !== @local ? (. as String + "/") as Location : @/)

  // What `@me/device` answers: the machine and each device it has, superposed; a place typed by one selects it
  // (`here: Geolocation = @me/device`)
  // (the operating system it runs among them: the one the host reports, else the language as the operating system)
  static made => Device() | OS.host | Keyboard.connected | Pointer.connected | Controllers.made | Camera.connected | Microphone.connected
    | Clipboard() | Geolocation() | Motion() | Speech() | Printer.connected | Display.connected
  assert {
    made := Device.made
    keys: Keyboard = made
    here: Geolocation = made
    assert keys is Keyboard & here is Geolocation  // DEV1 a place typed by a device does not select it from what a device has
    assert !(keys is Geolocation)  // DEV2 a device selected as one kind is another
  }

  static chooser: Program?
  choose (s, n: Number = 1) => Device.chooser ? Device.chooser(s, n) : s#.count is ∞ && !s#.some(.weight) ? ERROR@Type `no uniform choice exists over infinitely many possibilities; give them weights` : n == 1 ? s#.random : s#.subsets(n).random
  assert (Device().choose(Decimal)) is Diagnostic  // HS15 the computer chose uniformly among infinitely many possibilities
  assert Device().choose(("A" | "B" | "C"), 2).count == 2 && Device().choose(("A" | "B" | "C"), 2).first != Device().choose(("A" | "B" | "C"), 2).last  // CQ2 choosing two of three gave one of them twice
  // The chooser is a setting; a player's answer is a weighted alternative.
  assert {
    with Device.chooser = ((s, n) => "picked") {
      assert Device().choose(1 | 2) == "picked"  // CHS1 a chooser set with with is not asked
    }
  }
}


// `choose n` chooses n distinct by identity: the same value at two locations is two.
assert @"chosen".(
  Device().choose((., ., "5"), 2).count == 2  // CQ1 choosing two did not give two
  & (0..<20).map(i => Device().choose((., ., "5"), 2)).some(.every(=== .))  // CQ3 one value written twice is never chosen twice
)
