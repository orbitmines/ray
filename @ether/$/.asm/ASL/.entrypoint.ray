// Arm's own description of A64, read as it is written.
//
// Arm publishes the architecture as XML (the "A64 ISA Data release"), one file
// per instruction: a register diagram of the word — boxes of bits, each fixed
// or belonging to a named field — the encodings that refine that diagram, and
// the ASL pseudocode that says what the instruction does. The XML is read
// here by the grammar of the XML itself: an element opens an object, each of
// its attributes is a rule on that object, and closing it hands the object to
// the reader. What comes out is the shape `ISA.ray` holds.
//
// spec: only the parts of an instruction file that say how it is spelled and
// what it does are read (`<regdiagram>`, `<encoding>`, `<ps>`); the rest —
// descriptions, explanations, alias tables — is left out of the slice rather
// than read and thrown away. `tests/a64.ray` says how the slice is taken.
// spec: the cells `(0)` and `(1)` (should be zero, should be one), `N`, `Z`,
// and boxes with a `constraint` (`!= 000`) are not in the slice yet. A
// should-be cell decodes either way and must still be written back as read,
// so it wants to be a field of its own, not a fixed bit.
// The pseudocode is read as the ASL it is (see "ASL, read as the language it
// is" below): the slice gives it back as plain text, Arm's links taken off
// and `&lt;` and the rest the characters again, and each section is kept as
// the statements it is written as.

// A box of a diagram: a run of cells, most significant first, named when it
// is a field. Each cell is fixed or free, and, if fixed, to one or zero: two
// rows of booleans side by side.
Regbox ^keyword := class {
  name: Node
  fixed: Node
  values: Node
  { }hibit="{literal given}" ^punctuation => this
  { }width="{literal given}" ^punctuation => this
  { }name="{literal given}" ^punctuation => (
    this.name = given
    this
  )
  { }usename="{literal given}" ^punctuation => this
  { }settings="{literal given}" ^punctuation => this
  { }psbits="{literal given}" ^punctuation => this
  > ^punctuation => this
}

// A register diagram: the whole word, box after box from bit 31 down, and
// what its bits say once it is closed — which are fixed and to what, and
// where each field is.
Regdiagram ^keyword := class {
  fixed: Node
  values: Node
  boxes: Node
  ends: Node
  widths: Node
  operation: Node
  mask: Node
  match: Node
  fields: Node
  { }form="{literal given}" ^punctuation => this
  { }psname="{literal given}" ^punctuation => (
    this.operation = arm.operation_named(given)
    this
  )
  { }tworows="{literal given}" ^punctuation => this
  > ^punctuation => this

  // The cells are held most significant first, as they are drawn; a word is
  // least significant first, so they are walked from the last one back. A
  // field is where its box is: after the cell its box ends on come the bits
  // below it, then the box, then everything drawn before it.
  closed => (
    this.mask = A64.reversed(.fixed)
    this.match = A64.reversed(.values)
    named := .boxes.head
    ending := .ends.head
    wide := .widths.head
    while (exists named) {
      within := chain None
      walker := ending.value.next
      while (exists walker) {
        within &= false
        walker = walker.next
      }
      walker = ending.value
      across := wide.value.head
      while (exists across) {
        within &= true
        walker = walker.previous
        across = across.next
      }
      while (exists walker) {
        within &= false
        walker = walker.previous
      }
      this.fields &= Field(name: named.value, mask: Bits(bits: within))
      named = named.next
      ending = ending.next
      wide = wide.next
    }
    this
  )
  field (wanted) => (
    found := None
    walker := .fields.head
    while ((exists walker).and((exists found).not)) {
      if (exists (external alike (walker.value.name) (wanted))) { found = walker.value }
      walker = walker.next
    }
    found
  )
}

// One encoding of a diagram. Its boxes say again, of a field of the diagram,
// which of its bits this encoding fixes (`<c>1</c>`) and which it leaves as
// the diagram has them (`<c/>`).
Regencoding ^keyword := class {
  title: Node
  mnemonic: Node
  mask: Node
  match: Node
  { }name="{literal given}" ^punctuation => (
    this.title = given
    this
  )
  { }oneofinclass="{literal given}" ^punctuation => this
  { }oneof="{literal given}" ^punctuation => this
  { }label="{literal given}" ^punctuation => this
  { }bitdiffs="{literal given}" ^punctuation => this
  > ^punctuation => this

  // An encoding only fixes what its diagram leaves free, so what it fixes is
  // added to the diagram's bits and nothing is taken away.
  refined (field, box) => (
    this.mask = .mask.or(arm.none.deposit(field.mask, A64.reversed(box.fixed)))
    this.match = .match.or(arm.none.deposit(field.mask, A64.reversed(box.values)))
    this
  )
}

// Pseudocode, by the name of the diagram it belongs to and its section:
// `Decode` beside the diagram, `Execute` (and `Postdecode`) once for the file,
// in the pseudocode of the file's first diagram. What each section holds is
// its statements, read by the grammar of ASL below.
Operation ^keyword := class {
  name: Node
  sections: Node
  // The operation of the file this one was read in whose pseudocode is
  // `Execute` and `Postdecode`.
  executing: Node
  section (wanted) => (
    found := None
    walker := .sections.head
    while ((exists walker).and((exists found).not)) {
      if (exists (external alike (walker.value.name) (wanted))) { found = walker.value.text }
      walker = walker.next
    }
    found
  )
  decode => .section(`Decode`)
  postdecode => .executing.section(`Postdecode`)
  execute => .executing.section(`Execute`)
}
Section ^keyword := class {
  name: Node
  text: Node
}
Ps ^keyword := class {
  { }name="{literal given}" ^punctuation => (
    arm.operation = arm.operation_named(given)
    this
  )
  { }mylink="{literal given}" ^punctuation => this
  { }enclabels="" ^punctuation => this
  { }sections="{literal given}" ^punctuation => this
  { }secttype="{literal given}" ^punctuation => this
  > ^punctuation => this
}
// A section's text begins on the line after its tag: what follows is ASL, and
// each statement of it is kept, in order, in the section.
Pstext ^keyword := class {
  section: Node
  { }mayhavelinks="{literal given}" ^punctuation => this
  { }section="{literal given}" ^punctuation => (
    this.section = given
    this
  )
  { }rep_section="{literal given}" ^punctuation => this
  > ^punctuation => .begun
  begun => (
    statements := chain None
    arm.operation.sections &= Section(name: .section, text: statements)
    if (exists (external alike (.section) (`Execute`))) { arm.executed_by(arm.operation) }
    asl.begin(statements)
    None
  )
  // A section of the shared pseudocode: a function, whose signature says what
  // its parameters are called.
  >{literal aslcomments}func{ }{literal aslname}{`{`}{literal aslwidth}{`}`}({literal aslfirst}{ }:{ }{aslone},{ }{literal aslsecond}{ }:{ }{asltwo},{ }{literal aslthird}{ }:{ }{aslthree}){ }=>{ }({aslreturns}) ^punctuation => (
    this.begun
    asl.function(aslname, aslwidth, aslfirst, aslsecond, aslthird)
    None
  )
  >{literal aslcomments}func{ }{literal aslname}({literal aslfirst}{ }:{ }{aslone}){ }=>{ }{literal aslreturns} ^punctuation => (
    this.begun
    asl.function(aslname, None, aslfirst, None, None)
    None
  )
}
</pstext></ps> ^keyword => asl.finish

// What has been read so far, and what is being read.
A64 ^keyword := class {
  encodings: Node
  titles: Node
  operations: Node
  diagram: Node
  encoding: Node
  box: Node
  operation: Node
  waiting: Node
  ten: Node
  weights: Node
  none: Node

  // Rows to count cells with: one, two, four, eight, each twice the last.
  doubled (row) => (
    twice := chain None
    Bits.joined(twice, row)
    Bits.joined(twice, row)
    twice
  )
  rows => (
    one := chain None
    one &= true
    out := chain None
    out &= one
    out &= A64.doubled(out.tail.value)
    out &= A64.doubled(out.tail.value)
    out &= A64.doubled(out.tail.value)
    out
  )

  isa => ISA(name: `A64`, endian: `little`, encodings: .encodings)
  // The encoding Arm names `title` (`ADD_64_addsub_imm`).
  named (title) => (
    found := None
    walker := .titles.head
    held := .encodings.head
    while ((exists walker).and((exists found).not)) {
      if (exists (external alike (walker.value) (title))) { found = held.value }
      walker = walker.next
      held = held.next
    }
    found
  )
  operation_named (name) => (
    found := None
    walker := .operations.head
    while ((exists walker).and((exists found).not)) {
      if (exists (external alike (walker.value.name) (name))) { found = walker.value }
      walker = walker.next
    }
    unless (exists found) {
      found = Operation(name: name, sections: chain None, executing: None)
      this.operations &= found
      this.waiting &= found
    }
    found
  )
  // Every operation read since the last `Execute` is carried out by this one.
  executed_by (executing) => (
    walker := .waiting.head
    while (exists walker) {
      walker.value.executing = executing
      walker = walker.next
    }
    this.waiting = chain None
    true
  )

  // A row of cells, most significant first, as the word it is: least
  // significant first.
  reversed (row) => (
    out := chain None
    walker := row.tail
    while (exists walker) {
      out &= walker.value
      walker = walker.previous
    }
    Bits(bits: out)
  )

  cell (fixed, value) => (
    this.box.fixed &= fixed
    this.box.values &= value
    None
  )
  // `<c colspan="12"/>`: that many free cells. The count is written in
  // decimal. A decimal digit is written as the byte 0011 followed by its
  // value in four bits, so each digit is those last four bits: each one set
  // adds the row of cells it weighs (eight, four, two, one), and each digit
  // before it has been ten times as many. No arithmetic on words, only rows
  // being joined.
  spread (count) => (
    digits := chain None
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        digits &= byte.head.next.next.next.next
        byte = chain None
      }
      true
    )
    external bits count take
    tally := chain None
    digit := digits.head
    while (exists digit) {
      grown := chain None
      if (exists tally.head) {
        round := .ten.head
        while (exists round) {
          Bits.joined(grown, tally)
          round = round.next
        }
      }
      set := digit.value
      weight := .weights.tail
      while (exists set) {
        if set.value { Bits.joined(grown, weight.value) }
        set = set.next
        weight = weight.previous
      }
      tally = grown
      digit = digit.next
    }
    walker := tally.head
    while (exists walker) {
      this.box.fixed &= false
      this.box.values &= false
      walker = walker.next
    }
    None
  )

  box_opened => (
    this.box = Regbox(name: None, fixed: chain None, values: chain None)
    this.box
  )
  // A box closes into the diagram, or, inside an encoding, refines the
  // diagram's field of that name.
  box_closed => (
    if (exists .encoding) {
      this.encoding.refined(.diagram.field(.box.name), .box)
    } else {
      Bits.joined(.diagram.fixed, .box.fixed)
      Bits.joined(.diagram.values, .box.values)
      if (exists .box.name) {
        this.diagram.boxes &= .box.name
        this.diagram.ends &= .diagram.fixed.tail
        this.diagram.widths &= .box.fixed
      }
    }
    None
  )
  diagram_opened => (
    this.diagram = Regdiagram(fixed: chain None, values: chain None, boxes: chain None, ends: chain None, widths: chain None, operation: None, mask: None, match: None, fields: chain None)
    this.diagram
  )
  encoding_opened => (
    unless (exists .none) { this.none = .diagram.mask.xor(.diagram.mask) }
    this.encoding = Regencoding(title: None, mnemonic: None, mask: .diagram.mask, match: .diagram.match)
    this.encoding
  )
  encoding_closed => (
    meaning := Translated(operation: .diagram.operation, encoding: None, program: None)
    made := Encoding(mnemonic: .encoding.mnemonic, mask: .encoding.mask, match: .encoding.match, fields: .diagram.fields, semantics: meaning)
    meaning.encoding = made
    this.encodings &= made
    this.titles &= .encoding.title
    this.encoding = None
    None
  )
}
arm ^keyword := A64(encodings: chain None, titles: chain None, operations: chain None, diagram: None, encoding: None, box: None, operation: None, waiting: chain None, ten: None, weights: A64.rows, none: None)
ten_low ^keyword := arm.weights.tail.value
ten_high ^keyword := arm.weights.head.next.value
ten_row ^keyword := chain None
Bits.joined(ten_row, ten_low)
Bits.joined(ten_row, ten_high)
arm.ten = ten_row

<regdiagram ^keyword => arm.diagram_opened
</regdiagram> ^keyword => (
  arm.diagram.closed
  None
)
<encoding ^keyword => arm.encoding_opened
</encoding> ^keyword => arm.encoding_closed
<box ^keyword => arm.box_opened
</box> ^keyword => arm.box_closed
<c>0</c> ^keyword => arm.cell(true, false)
<c>1</c> ^keyword => arm.cell(true, true)
<c>x</c> ^keyword => arm.cell(false, false)
<c/> ^keyword => arm.cell(false, false)
<c colspan="{literal count}"/> ^keyword => arm.spread(count)
<docvars> ^keyword => None
</docvars> ^keyword => None
// Of the document variables only the mnemonic is read. Both rules take the
// whole element; where both do, the one written last is the one that stands.
<docvar key="{literal key}" value="{literal given}"/> ^keyword => None
<docvar key="mnemonic" value="{literal given}"/> ^keyword => (
  arm.encoding.mnemonic = given
  None
)
<asmtemplate>{literal template}</asmtemplate> ^keyword => None
<ps ^keyword => Ps()
<pstext ^keyword => Pstext(section: None)

// ASL, read as the language it is.
//
// The pseudocode of a section is read a statement at a time, as it is
// written, and each statement is kept where it stands — in the section, or in
// the block of the `if`, `case` or function it is written in — with the
// expressions it is written with left unread. They are read when an encoding
// is translated: its decode and its execute are run once, not over a machine
// but over what can be known of an instruction of that encoding, and what
// cannot be known until an instruction runs is written down as the goto
// program that works it out (`Goto.ray`). That program is what the encoding
// does.
//
// What is known: whatever the encoding fixes (its `sf`, `size`, one bit of
// `hw`), numbers written in the text, and whatever is worked out of those —
// `datasize`, `scale`, which `if` is taken, which arm of a `case`. What is not
// known is the rest of the word, the registers, memory and the flags. An `if`
// whose condition is not known is a conditional goto around its two blocks; a
// `case` of an unknown subject is one per arm. Nothing else is control.
//
// The fields of an instruction are read as `Named(name: `Rd`)`: `Run.ray`
// puts them in the state before the program runs. General-purpose registers
// are a file, `X`, numbered by what the instruction says (`Goto.ray`'s `InFile`, `IntoFile`),
// the stack pointer is `SP`, the flags `PSTATE.N` `PSTATE.Z` `PSTATE.C`
// `PSTATE.V` (named apart from fields: RET has a field `Z`), and the address of
// the instruction is `inst_start`.
//
// spec: of the shared pseudocode, `AddWithCarry` and `ConditionHolds` are read
// from Arm's text (`A64.shared.xml`); the accessors `X`, `SP`, `PC64`, `Mem`,
// `BranchTo` and the primitives `UInt`, `SInt`, `ZeroExtend`, `SignExtend`,
// `Zeros`, `IsZero`, `NOT`, `LSL` are written here as what they do. Reading the
// accessors from Arm's text is next: they index `_R[[n]]`, which `InFile` is.
// spec: operators are applied as the engine groups them, from the right, and
// then regrouped by ASL's precedence (`Pseudocode.settle`); a parenthesised
// group on the right of an operator cannot be told from an ungrouped one.

// Numbers as long as the chain that counts them. What the translation counts —
// widths, register numbers, shifts — is small, and a count is compared and
// added by walking it; only what the machine holds is a word of bits.
Count ^keyword := class {
  // The number a word holds, unsigned, most significant bit first: each bit
  // doubles what came before it and adds itself.
  of_bits (word) => (
    word_given := word
    total := chain None
    walker := word_given.bits.tail
    while (exists walker) {
      twice := chain None
      Bits.joined(twice, total)
      Bits.joined(twice, total)
      if walker.value { twice &= false }
      total = twice
      walker = walker.previous
    }
    total
  )
  // As many as there are bits in a word.
  length_of (word) => (
    word_given := word
    counted := chain None
    walker := word_given.bits.head
    while (exists walker) {
      counted &= false
      walker = walker.next
    }
    counted
  )
  plus (augend, addend) => (
    augend_given := augend
    addend_given := addend
    summed := chain None
    Bits.joined(summed, augend_given)
    Bits.joined(summed, addend_given)
    summed
  )
  // What is left of a count once another is taken from it; nothing when it is less.
  less_by (whole, taken) => (
    whole_given := whole
    taken_given := taken
    walker := whole_given.head
    taking := taken_given.head
    while ((exists walker).and(exists taking)) {
      walker = walker.next
      taking = taking.next
    }
    rest := chain None
    while (exists walker) {
      rest &= false
      walker = walker.next
    }
    rest
  )
  same (former, latter) => (
    former_given := former
    latter_given := latter
    mine := former_given.head
    theirs := latter_given.head
    while ((exists mine).and(exists theirs)) {
      mine = mine.next
      theirs = theirs.next
    }
    (exists mine).not.and((exists theirs).not)
  )
  at_least (former, latter) => (
    former_given := former
    latter_given := latter
    mine := former_given.head
    theirs := latter_given.head
    while ((exists mine).and(exists theirs)) {
      mine = mine.next
      theirs = theirs.next
    }
    (exists theirs).not
  )
  larger (former, latter) => (
    answer := None
    if (Count.at_least(former, latter)) { answer = former } else { answer = latter }
    answer
  )
  successor (counted) => (
    counted_given := counted
    grown := chain None
    Bits.joined(grown, counted_given)
    grown &= false
    grown
  )
  // Doubled as many times as another count says.
  doubled (counted, times) => (
    counted_given := counted
    times_given := times
    grown := counted_given
    walker := times_given.head
    while (exists walker) {
      twice := chain None
      Bits.joined(twice, grown)
      Bits.joined(twice, grown)
      grown = twice
      walker = walker.next
    }
    grown
  )
  // A word as wide as a count, all clear: what a width is written as.
  // A count is a chain of clear bits, so it is the word it is as wide as.
  template (counted) => Bits(bits: counted)
  // A word as wide as `wide` with the bits from `low` up to and including
  // `high` set: where a slice is.
  span (low, high, wide) => (
    low_given := low
    high_given := high
    wide_given := wide
    marked := chain None
    below := low_given.head
    upto := high_given.head
    past := false
    walker := wide_given.head
    while (exists walker) {
      marked &= (exists below).not.and(past.not)
      if (exists upto) { upto = upto.next } else { past = true }
      if (exists below) { below = below.next }
      walker = walker.next
    }
    Bits(bits: marked)
  )
  // Half a count, and whether it was odd.
  halved (counted) => (
    counted_given := counted
    half := chain None
    walker := counted_given.head
    while (exists walker) {
      if (exists walker.next) {
        half &= false
        walker = walker.next.next
      } else { walker = None }
    }
    half
  )
  // The number a count is, in binary, as wide as `wide` says: each halving
  // leaves a bit behind, the lowest first.
  binary (counted, wide) => (
    counted_given := counted
    wide_given := wide
    digits := chain None
    rest := counted_given
    while (exists rest.head) {
      half := chain None
      odd := false
      walker := rest.head
      while (exists walker) {
        if (exists walker.next) {
          half &= false
          walker = walker.next.next
        } else {
          odd = true
          walker = None
        }
      }
      digits &= odd
      rest = half
    }
    answer := Count.template(wide_given)
    if (exists digits.head) { answer = Bits(bits: digits).widened(answer, false) }
    answer
  )
  // How many bits a count needs, and one more, for the sign an integer has.
  wide_for (counted) => (
    counted_given := counted
    needed := chain None
    needed &= false
    rest := counted_given
    while (exists rest.head) {
      needed &= false
      rest = Count.halved(rest)
    }
    needed
  )
  // Whether eight bits, most significant first, are a decimal digit: 0011
  // and then nine or less.
  decimal_digit (byte) => (
    held := byte
    b3 := held.head.next.next.next.next
    b2 := b3.next
    b1 := b2.next
    upper := held.head.value.not.and(held.head.next.value.not).and(held.head.next.next.value).and(held.head.next.next.next.value)
    upper.and((b3.value.and(b2.value.or(b1.value))).not)
  )
  // Digits written in decimal.
  of_decimal (written) => (
    written_given := written
    total := chain None
    byte := chain None
    reading := true
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        if (Count.decimal_digit(byte)) {
          digit := Bits.nibble_of(byte)
          tenfold := chain None
          round := arm.ten.head
          while (exists round) {
            Bits.joined(tenfold, total)
            round = round.next
          }
          digit_word := Bits(bits: digit)
          digit_count := Count.of_bits(digit_word)
          Bits.joined(tenfold, digit_count)
          total = tenfold
        } else { reading = false }
        byte = chain None
      }
      reading
    )
    external bits written_given take
    total
  )
}

// A word nothing is named by, written in decimal digits, is the number it is.
// Except `0` and `1` alone: every reader of text reads a bit by reading `0` or
// `1` as written (`external bits`), and a digit that read as a number would
// change what every text is made of. ASL writes them where a rule reads them
// (`N-1`, `x[0]`, `'1'`).
AslNumber ^keyword := class {
  accepts (text) => (
    digits := true
    bytes := chain None
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        unless (Count.decimal_digit(byte)) { digits = false }
        bytes &= byte
        byte = chain None
      }
      true
    )
    external bits text take
    if (exists bytes.head) {
      unless (exists bytes.head.next) {
        if (bytes.head.value.tail.previous.previous.previous.value.not.and(bytes.head.value.tail.previous.previous.value.not).and(bytes.head.value.tail.previous.value.not)) { digits = false }
      }
    }
    found := None
    if digits { found = Term.integer(Count.of_decimal(text)) }
    found
  )
}
// A count written in decimal digits and nothing else: what `N-1` subtracts.
AslCount ^keyword := class {
  accepts (text) => (
    digits := true
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        unless (Count.decimal_digit(byte)) { digits = false }
        byte = chain None
      }
      true
    )
    external bits text take
    found := None
    if digits { found = Count.of_decimal(text) }
    found
  )
}
{digits: AslNumber ^number} ^number => digits

// What an expression stands for while an encoding is translated: a value of
// one of ASL's sorts — `integer`, `bits`, `boolean`, an enumeration's `enum`,
// a `tuple` — that is either `certain`, and then `known`, or `live`: the goto
// value that works it out when the instruction runs, `wide` bits wide. A value
// read from somewhere that can be written to keeps where (`place`). A field
// the encoding fixes some bits of knows those (`fixing`, `fixed_to`).
// An operator written between two values is not applied where it is read but
// kept (`pending`) until the whole expression is, so that it can be applied
// in the order ASL's precedence says.
Term ^keyword := class {
  sort: Node
  known: Node
  live: Node
  wide: Node
  more: Node

  certain => exists .known
  place => (
    answer := None
    if (exists .more) { answer = .more.place } else { answer = None }
    answer
  )
  fixing => (
    answer := None
    if (exists .more) { answer = .more.fixing } else { answer = None }
    answer
  )
  fixed_to => (
    answer := None
    if (exists .more) { answer = .more.fixed_to } else { answer = None }
    answer
  )
  slot => (
    answer := None
    if (exists .more) { answer = .more.slot } else { answer = None }
    answer
  )
  base => (
    answer := None
    if (exists .more) { answer = .more.base } else { answer = None }
    answer
  )
  offset => (
    answer := None
    if (exists .more) { answer = .more.offset } else { answer = None }
    answer
  )

  == (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `==`, left: this, right: operand)
  )
  != (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `!=`, left: this, right: operand)
  )
  && (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `&&`, left: this, right: operand)
  )
  || (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `||`, left: this, right: operand)
  )
  << (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `<<`, left: this, right: operand)
  )
  :: (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `::`, left: this, right: operand)
  )
  + (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `+`, left: this, right: operand)
  )
  - (other) => (
    operand := asl.index(other)
    Pending(sort: `pending`, op: `-`, left: this, right: operand)
  )
  // `N-1`, `pos+15`: a number written against what it is added to.
  -{amount: AslCount} ^punctuation => asl.offset(this, amount, false)
  +{amount: AslCount} ^punctuation => asl.offset(this, amount, true)
  // `x[high:low]`, and `x[i]`, one bit. The low end is read as it is written,
  // a number or a name (`AslNumber` reads no `0` or `1`).
  // spec: a single bit is read where its index is written `0`, `1` or `N-1`;
  // a rule `[{index}]` on a class is asked of every `[` and never finishes.
  [{high}:{literal low}] ^punctuation => asl.slice(this, asl.index(high), asl.width_written(low))
  [0] ^punctuation => asl.slice(this, Term.integer(chain None), Term.integer(chain None))
  [1] ^punctuation => asl.slice(this, Term.integer(asl_numbers.one), Term.integer(asl_numbers.one))
  [N-1] ^punctuation => asl.top_of(this)

  integer (counted) => Term(sort: `integer`, known: counted, live: None, wide: None, more: None)
  bits_of (word) => Term(sort: `bits`, known: word, live: None, wide: None, more: None)
  truth (holds) => Term(sort: `boolean`, known: holds, live: None, wide: None, more: None)
  named (written) => Term(sort: `enum`, known: written, live: None, wide: None, more: None)
  live_as (sorted, computed, width) => Term(sort: sorted, known: None, live: computed, wide: width, more: None)
  // The same value, now known to be held at `where`.
  held_at (term, where) => (
    held := term
    held_where := where
    held_sort := held.sort
    held_known := held.known
    held_live := held.live
    held_wide := held.wide
    held_fixing := held.fixing
    held_fixed_to := held.fixed_to
    held_slot := held.slot
    held_more := Extra(place: held_where, fixing: held_fixing, fixed_to: held_fixed_to, slot: held_slot, base: None, offset: None)
    Term(sort: held_sort, known: held_known, live: held_live, wide: held_wide, more: held_more)
  )
  is (term, sorted) => exists (external alike (term.sort) (sorted))
}

// What a value knows besides what it is: where it is held, which of its bits
// an encoding fixes, and, for `pos+15`, what it is counted from.
Extra ^keyword := class {
  place: Node
  fixing: Node
  fixed_to: Node
  slot: Node
  base: Node
  offset: Node
}
// An operator not applied yet, and a tuple (`(result, nzcv)`).
Pending ^keyword := class {
  sort: Node
  op: Node
  left: Node
  right: Node
  certain => false
}
Tuple ^keyword := class {
  sort: Node
  items: Node
  certain => true
}

// Where a value can be written: a variable of the pseudocode (held in a
// `slot` of the state once it is not known), a register of a file, the stack
// pointer, a register of the machine by its name, or a slice of any of those.
Place ^keyword := class {
  sort: Node
  name: Node
  slot: Node
  index: Node
  wide: Node
  of: Node
  high: Node
  low: Node
}

// A name no other name is: what a variable's slot and a label are called.
Fresh ^keyword := class {
  name => external time
}

// A statement as it is written: what kind it is, the names it is written with,
// where its expressions are (`frame`, read when it runs), and the blocks it
// holds — the `then` and `else` of an `if`, the arms of a `case`, the body of
// a function.
Statement ^keyword := class {
  kind: Node
  name: Node
  type: Node
  frame: Node
  body: Node
  otherwise: Node
  parameters: Node
}
// A block being read, and the one it is written in. An `elsif` is an `if` in
// the `else` of the one before it; the one `end;` closes them all.
Open ^keyword := class {
  statements: Node
  statement: Node
  outer: Node
  chained: Node
}
// A variable while an encoding is translated: its name, and what it stood for
// before, to be given back when the function it is local to returns.
Binding ^keyword := class {
  name: Node
  term: Node
  before: Node
}
Scope ^keyword := class {
  bindings: Node
  outer: Node
}

Pseudocode ^keyword := class {
  open: Node
  functions: Node
  steps: Node
  outermost: Node
  assigned: Node
  scope: Node
  expected: Node
  returned: Node
  returning: Node

  // Reading: statements kept in the block being read.
  begin (statements) => (
    statements_given := statements
    this.open = Open(statements: statements_given, statement: None, outer: None, chained: None)
    true
  )
  finish => (
    this.open = None
    None
  )
  record (kind, name, type, frame) => (
    kind_given := kind
    name_given := name
    type_given := type
    frame_given := frame
    built_3 := chain None
    built_4 := chain None
    built_5 := chain None
    made := Statement(kind: kind_given, name: name_given, type: type_given, frame: frame_given, body: built_3, otherwise: built_4, parameters: built_5)
    held := .open.statements
    held &= made
    made
  )
  opened (kind, name, type, frame) => (
    kind_given := kind
    name_given := name
    type_given := type
    frame_given := frame
    made := .record(kind_given, name_given, type_given, frame_given)
    built_6 := made.body
    built_7 := .open
    this.open = Open(statements: built_6, statement: made, outer: built_7, chained: None)
    made
  )
  otherwise => (
    inner := .open.statement
    built_8 := inner.otherwise
    built_9 := .open.outer
    built_10 := .open.chained
    this.open = Open(statements: built_8, statement: inner, outer: built_9, chained: built_10)
    true
  )
  otherwise_if (frame) => (
    frame_given := frame
    inner := .open.statement
    built_11 := inner.otherwise
    built_12 := .open.outer
    built_13 := .open.chained
    this.open = Open(statements: built_11, statement: inner, outer: built_12, chained: built_13)
    made := .record(`if`, None, None, frame_given)
    built_14 := made.body
    built_15 := .open
    this.open = Open(statements: built_14, statement: made, outer: built_15, chained: true)
    made
  )
  close => (
    closing := .open
    this.open = .open.outer
    if (exists closing.chained) { this.close }
    true
  )
  function (named, width, first, second, third) => (
    named_given := named
    width_given := width
    first_given := first
    second_given := second
    third_given := third
    made := .opened(`func`, named_given, width_given, None)
    if (exists first_given) { made.parameters &= first_given }
    if (exists second_given) { made.parameters &= second_given }
    if (exists third_given) { made.parameters &= third_given }
    this.functions &= made
    made
  )

  // Translating: the goto program an encoding is.
  translate (encoding, operation) => (
    encoding_given := encoding
    operation_given := operation
    this.steps = chain None
    this.outermost = None
    this.assigned = chain None
    built_16 := chain None
    this.scope = Scope(bindings: built_16, outer: None)
    this.returning = false
    this.returned = None
    this.bind_fields(encoding_given)
    this.run_block(operation_given.decode)
    if (exists operation_given.postdecode) { this.run_block(operation_given.postdecode) }
    this.run_block(operation_given.execute)
    this.unbind(.scope)
    built_17 := .steps
    Goto(steps: built_17)
  )
  // What an instruction of an encoding is known to hold in each field: all
  // of it where the encoding fixes every bit of it, otherwise the field, read
  // from the state, and the bits of it that are fixed.
  bind_fields (encoding) => (
    encoding_given := encoding
    walker := encoding_given.fields.head
    while (exists walker) {
      field := walker.value
      fixing := encoding_given.mask.extract(field.mask)
      fixed_to := encoding_given.match.extract(field.mask)
      width := Count.length_of(fixing)
      if (fixing.not.is_zero.not) {
        built_20 := field.name
        built_18 := Named(name: built_20)
        built_21 := fixing
        built_22 := fixed_to
        built_19 := Extra(place: None, fixing: built_21, fixed_to: built_22, slot: None, base: None, offset: None)
        this.bind(field.name, Term(sort: `bits`, known: None, live: built_18, wide: width, more: built_19))
      } else { this.bind(field.name, Term.bits_of(fixed_to)) }
      walker = walker.next
    }
    true
  )

  // Names. A name stands for a term by being bound to it, globally, so that
  // the expressions of the pseudocode read it where they are written.
  bound (name) => (
    name_given := name
    found := None
    scoping := .scope
    while ((exists scoping).and((exists found).not)) {
      walker := scoping.bindings.tail
      while ((exists walker).and((exists found).not)) {
        if (exists (external alike (walker.value.name) (name_given))) { found = walker.value }
        walker = walker.previous
      }
      scoping = scoping.outer
    }
    found
  )
  bind (name, term) => (
    name_given := name
    term_given := term
    bound_name := name_given
    bound_term := term_given
    earlier := .bound(bound_name)
    before := None
    if (exists earlier) { before = earlier.term }
    built_23 := before
    this.scope.bindings &= Binding(name: bound_name, term: bound_term, before: built_23)
    global[bound_name] = bound_term
    true
  )
  // A scope that ends gives its names back what they stood for before it.
  unbind (scoping) => (
    scoping_given := scoping
    walker := scoping_given.bindings.tail
    while (exists walker) {
      global[walker.value.name] = walker.value.before
      walker = walker.previous
    }
    true
  )

  emit (step) => (
    step_given := step
    this.steps &= step_given
    true
  )

  run_block (statements) => (
    statements_given := statements
    walker := statements_given.head
    while ((exists walker).and(.returning.not)) {
      this.run_statement(walker.value)
      walker = walker.next
    }
    true
  )
  run_statement (statement) => (
    statement_given := statement
    kind := statement_given.kind
    if (exists (external alike (kind) (`let`))) {
      this.expected = .expected_of(statement_given)
      hoisted_101 := .settle(statement_given.frame.asl_value)
      this.let(statement_given.name, hoisted_101)
    } elsif (exists (external alike (kind) (`var`))) {
      this.expected = .expected_of(statement_given)
      hoisted_102 := .settle(statement_given.frame.asl_value)
      this.let(statement_given.name, hoisted_102)
    } elsif (exists (external alike (kind) (`declare`))) {
      hoisted_103 := .expected_of(statement_given)
      declared_sort := `bits`
      if (exists (external alike (statement_given.type) (`boolean`))) { declared_sort = `boolean` }
      this.declare(statement_given.name, hoisted_103, declared_sort)
    } elsif (exists (external alike (kind) (`assign`))) {
      target := statement_given.frame.asl_target
      this.expected = .width_of(target)
      hoisted_104 := .settle(statement_given.frame.asl_value)
      this.assign(target, hoisted_104)
    } elsif (exists (external alike (kind) (`first`))) {
      this.expected = None
      given := .settle(statement_given.frame.asl_value)
      hoisted_105 := .variable(statement_given.name)
      this.assign(hoisted_105, given.items.head.value)
    } elsif (exists (external alike (kind) (`pair`))) {
      this.expected = None
      given := .settle(statement_given.frame.asl_value)
      hoisted_106 := .variable(statement_given.name)
      this.assign(hoisted_106, given.items.head.value)
      unless (exists (external alike (statement_given.type) (`-`))) { this.assign(.variable(statement_given.type), given.items.head.next.value) }
    } elsif (exists (external alike (kind) (`flags`))) {
      hoisted_107 := .settle(statement_given.frame.asl_value)
      this.flags(hoisted_107)
    } elsif (exists (external alike (kind) (`if`))) {
      raw_condition := statement_given.frame.asl_condition
      condition := .settle(raw_condition)
      if (condition.certain) {
        if condition.known { this.run_block(statement_given.body) } else { this.run_block(statement_given.otherwise) }
      } else { this.branch(condition, statement_given.body, statement_given.otherwise) }
    } elsif (exists (external alike (kind) (`case`))) {
      hoisted_108 := .settle(statement_given.frame.asl_subject)
      this.case_of(hoisted_108, statement_given.body)
    } elsif (exists (external alike (kind) (`return`))) {
      this.returned = .settle(statement_given.frame.asl_value)
      this.returning = true
    } elsif (exists (external alike (kind) (`call`))) {
      statement_given.frame.asl_perform
    }
    true
  )
  // The width a declaration says its value is: `bits(N)` is N, `bit` one.
  expected_of (statement) => (
    statement_given := statement
    wanted := None
    if (exists statement_given.type) {
      if (exists (external alike (statement_given.type) (`bit`))) { wanted = asl_numbers.one }
      if (exists (external alike (statement_given.type) (`boolean`))) { wanted = asl_numbers.one }
      if (exists (external alike (statement_given.type) (`bits(N)`))) {
        written_width := .index(statement_given.frame.asl_width)
        wanted = .settle(written_width).known
      }
    }
    wanted
  )

  // Variables.
  let (name, term) => (
    name_given := name
    term_given := term
    naming := name_given
    standing := term_given
    if (Term.is(standing, `tuple`)) {
      this.bind(naming, standing)
    } elsif ((standing.certain).or(Term.is(standing, `enum`))) {
      held_place := Place(sort: `variable`, name: naming, slot: None, index: None, wide: None, of: None, high: None, low: None)
      held_term := Term.held_at(standing, held_place)
      this.bind(naming, held_term)
    } else {
      slot := Fresh.name
      hoisted_1 := .value_of(standing)
      built_24 := slot
      this.emit(Set(place: built_24, to: hoisted_1))
      hoisted_2 := .width_of(standing)
      built_25 := standing.sort
      built_28 := slot
      built_26 := Named(name: built_28)
      built_31 := slot
      built_29 := Place(sort: `variable`, name: naming, slot: built_31, index: None, wide: None, of: None, high: None, low: None)
      built_30 := slot
      built_27 := Extra(place: built_29, fixing: None, fixed_to: None, slot: built_30, base: None, offset: None)
      this.bind(naming, Term(sort: built_25, known: None, live: built_26, wide: hoisted_2, more: built_27))
    }
    true
  )
  declare (name, width, sorted) => (
    name_given := name
    width_given := width
    sort_given := sorted
    naming := name_given
    slot := Fresh.name
    built_34 := slot
    built_32 := Named(name: built_34)
    built_37 := slot
    built_35 := Place(sort: `variable`, name: naming, slot: built_37, index: None, wide: None, of: None, high: None, low: None)
    built_36 := slot
    built_33 := Extra(place: built_35, fixing: None, fixed_to: None, slot: built_36, base: None, offset: None)
    this.bind(naming, Term(sort: sort_given, known: None, live: built_32, wide: width_given, more: built_33))
    true
  )
  assign (target, term) => (
    target_given := target
    term_given := term
    where := target_given.place
    standing := term_given
    sort := where.sort
    if (exists (external alike (sort) (`variable`))) {
      this.assign_variable(target_given, standing)
    } elsif (exists (external alike (sort) (`register`))) {
      skip := Fresh.name
      built_39 := where.index
      built_41 := asl_numbers.register_31
      built_40 := Constant(bits: built_41)
      built_38 := Equal(left: built_39, right: built_40)
      this.emit(Jump(when: built_38, target: skip, to: None))
      hoisted_3 := .value_at(standing, asl_numbers.sixty_four)
      built_42 := where.name
      built_43 := where.index
      this.emit(IntoFile(file: built_42, index: built_43, to: hoisted_3, fixed: None))
      this.emit(Label(name: skip))
    } elsif (exists (external alike (sort) (`machine`))) {
      machine_value := None
      if (exists where.wide) { machine_value = .value_at(standing, where.wide) } else { machine_value = .value_of(standing) }
      built_44 := where.name
      this.emit(Set(place: built_44, to: machine_value))
    } elsif (exists (external alike (sort) (`slice`))) {
      whole_target := where.of
      redeposited := .deposited(whole_target, where.low, where.high, standing)
      this.assign_variable(whole_target, redeposited)
    }
    true
  )
  assign_variable (target, term) => (
    target_given := target
    term_given := term
    variable_place := target_given.place
    variable_value := term_given
    variable_name := variable_place.name
    if ((exists .outermost).not.and(variable_value.certain)) {
      this.bind(variable_name, Term.held_at(variable_value, variable_place))
    } else {
      variable_slot := variable_place.slot
      unless (exists variable_slot) {
        variable_slot = Fresh.name
        if (target_given.certain) {
          variable_earlier := .outermost
          if (exists variable_earlier) {
            earlier_value := .value_of(target_given)
            variable_earlier &= Set(place: variable_slot, to: earlier_value)
          }
        }
      }
      hoisted_4 := .value_of(variable_value)
      this.emit(Set(place: variable_slot, to: hoisted_4))
      hoisted_5 := .width_of(target_given)
      built_45 := target_given.sort
      built_46 := Named(name: variable_slot)
      built_48 := Place(sort: `variable`, name: variable_name, slot: variable_slot, index: None, wide: None, of: None, high: None, low: None)
      built_47 := Extra(place: built_48, fixing: None, fixed_to: None, slot: variable_slot, base: None, offset: None)
      variable_after := Term(sort: built_45, known: None, live: built_46, wide: hoisted_5, more: built_47)
      this.bind(variable_name, variable_after)
      if (exists .outermost) { this.assigned &= Binding(name: variable_name, term: variable_after, before: None) }
    }
    true
  )
  // A value with another written over some of its bits: what `x[h:l] = v`
  // leaves in `x`. `low` may not be known; the width is `high` less `low`.
  deposited (whole, low, high, term) => (
    whole_given := whole
    low_given := low
    high_given := high
    term_given := term
    width := .width_of(whole_given)
    hoisted_109 := .distance(high_given, low_given)
    across := Count.successor(Count.less_by(hoisted_109, chain None))
    ones := Count.template(across).not.widened(Count.template(width), false)
    at := .value_at(low_given, Count.wide_for(width))
    hoisted_6 := .value_at(term_given, width)
    placed := ShiftedLeft(of: hoisted_6, by: at)
    hoisted_7 := .value_of(whole_given)
    built_51 := Constant(bits: ones)
    built_50 := ShiftedLeft(of: built_51, by: at)
    built_49 := Inverted(of: built_50)
    kept := Both(left: hoisted_7, right: built_49)
    built_52 := Either(left: kept, right: placed)
    Term(sort: `bits`, known: None, live: built_52, wide: width, more: None)
  )
  // How far above `low` `high` is: both known, or `high` written as `low+k`.
  distance (high, low) => (
    high_given := high
    low_given := low
    answer := None
    if ((high_given.certain).and(low_given.certain)) { answer = Count.less_by(high_given.known, low_given.known) } else { answer = high_given.offset }
    answer
  )

  // An `if` whose condition is not known: a conditional goto to its `then`
  // block, its `else` block, a goto past the `then` block.
  branch (condition, yes, no) => (
    condition_given := condition
    yes_given := yes
    no_given := no
    outer := .steps
    began := (exists .outermost).not
    if began { this.outermost = outer }
    yes_steps := chain None
    this.steps = yes_steps
    built_53 := chain None
    built_54 := .scope
    this.scope = Scope(bindings: built_53, outer: built_54)
    this.run_block(yes_given)
    this.unbind(.scope)
    this.scope = .scope.outer
    no_steps := chain None
    this.steps = no_steps
    built_55 := chain None
    built_56 := .scope
    this.scope = Scope(bindings: built_55, outer: built_56)
    this.run_block(no_given)
    this.unbind(.scope)
    this.scope = .scope.outer
    this.steps = outer
    taken := Fresh.name
    done := Fresh.name
    hoisted_8 := .value_of(condition_given)
    this.emit(Jump(when: hoisted_8, target: taken, to: None))
    Bits.joined(outer, no_steps)
    this.emit(Jump(when: None, target: done, to: None))
    this.emit(Label(name: taken))
    Bits.joined(outer, yes_steps)
    this.emit(Label(name: done))
    this.rebind_assigned
    if began {
      this.outermost = None
      this.assigned = chain None
    }
    true
  )
  rebind_assigned => (
    walker := .assigned.head
    while (exists walker) {
      this.bind(walker.value.name, walker.value.term)
      walker = walker.next
    }
    true
  )
  // `case subject of when pattern => …`: the arm the subject is, when it is
  // known; otherwise a conditional goto to each arm.
  case_of (subject, arms) => (
    subject_given := subject
    arms_given := arms
    if (subject_given.certain) {
      picked := None
      walker := arms_given.head
      while ((exists walker).and((exists picked).not)) {
