}
// Readings (`level read …`): whether two values are the same (a text read wholly by a pattern is); a text read by a
// pattern, to what its holes bound (`readtext`); a text, or a node's structure, with what a function picks mapped by
// another (or to a value; into a pattern, a byte picked held by it).
Readings := class {
  static Spanned := (11, name, from, to, value)
  static Marked := (13, name, from, to, value)
  static equal (a, b) => ((a == b) || Readings.same_place(a, b)) ? true : ((b is Pattern) ? Readings.reads_whole(a, b) : (((b is Text) && Texts.same_text(a, b)) ? true : false))
  static same_place (a: Place, b: Place) => (a is Place) && (b is Place) && (a.name == b.name)
  static reads_whole (a: Text, b) => ((a is Text) && (reads(b, a) == a.to)) ? true : false
  static readtext (p, t) => Readings.read_from(p, (t is Node) ? member(t, Symbol.text) : t)
  static read_from (p, t: Text) => (t is Text) ? Readings.read_in(p, t, textend, boundn) : Readings.not_whole()
  static not_whole => {
    wholly = false
    None
