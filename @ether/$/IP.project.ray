@unicode

IP := class: Location &+ (-1 <- . -> +1) {
  static NUMBER_OF_SEGMENTS: Decimal
  static SEGMENT_LENGTH: Decimal
  static NUMBER_OF_BITS := NUMBER_OF_SEGMENTS * SEGMENT_LENGTH
  assert IPv4.NUMBER_OF_BITS == 32  // IP2 the address is not thirty-two bits

  static Segment := class {
    static Binary := Binary{length == SEGMENT_LENGTH}
    assert true as Binary == ₂1  // BOR7 true is not the bit one
    assert false as Binary == ₂0  // BOR8 false is not the bit zero
    assert ("a" as Unicode.UTF-8 as Binary).length == 8  // T1 a is not eight bits in UTF-8
    assert "a" as Unicode.UTF-8 as Binary == ₂01100001  // T2 a is not 01100001 in UTF-8
    assert ("a" as Unicode.UTF-16 as Binary).length == 16  // W12 UTF16 of a is not sixteen bits
    assert (0.5 b as Binary).erred  // FWB3 half a bit is Binary
  }
  segments: Segment[]{length == NUMBER_OF_SEGMENTS}

  static canonical := static
  // Lowercase hexadecimal (https://datatracker.ietf.org/doc/html/rfc5952#section-4.3)
  // CIDR notation where the low bits are superposed (https://datatracker.ietf.org/doc/html/rfc4632#section-3.1)
  as (=== String) => NUMBER_OF_BITS - (as Binary ~= Superposed[]⊣ -- .length) -- (prefix_length => prefix_length == NUMBER_OF_BITS
    ? (this as canonical).written_out.lowercase
    : ((as Binary ~~ .[prefix_length..] = 0) as static as String, "/", prefix_length))
  full: String => written_out
  chainable == (other: IP) => as Binary == other as Binary

  compounds + (offset: Number{-(as Binary) <= . <= ~!(as Binary)}): static => as Binary + offset
  compounds - (offset: Number{- ~!(as Binary) <= . <= as Binary}): static => as Binary - offset
  assert 5 - 0 == 5  // CO3 five less nothing is not five
  assert 6 - 2 == 4  // CO17 six less two is not four
  assert 10 - 2 == 8  // PR11 one less on its own stopped working
  assert 10 - 4 * 2 == 2  // PR27 ten less four times two is not two

  compounds / (prefix_length: Number{0 <= . <= NUMBER_OF_BITS}): static => as Binary ~~ .[prefix_length..] = 0 | 1
  assert 5 / 1 == 5  // CO8 five shared once is not five
  assert 6 / 2 == 3  // CO16 six shared in two is not three
  assert 10 / 2 / 5 == 1  // PR25 ten shared twice is not one

  static v4 := class: IP ({segments.join(".")}) => {
    static NUMBER_OF_SEGMENTS := 4
    static SEGMENT_LENGTH := 8
    assert IPv4.SEGMENT_LENGTH == 8  // IP25 a segment of the first kind is other than eight bits
    assert IPv6.SEGMENT_LENGTH == 16  // IP26 a segment of the second kind is other than sixteen bits

    static Segment: Decimal{< 2^8}
  }

  static v6 := class: IP (
    (left: Segment[]).join(":")?,
    zero_compression: "::" (? if !defined_segments.empty),
    (right: Segment[]).join(":")?,
    (":", embedded_ipv4: IPv4)?
  ) => {
    static NUMBER_OF_SEGMENTS := 8
    static SEGMENT_LENGTH := 16

    static Segment: Hexadecimal{length <= 4}

    segments => left, 0[]{length == number_of_compressed_segments}(), right, embedded_ipv4 as Binary
    defined_segments: Segment[] => left, right, embedded_ipv4 as Binary
    number_of_compressed_segments => NUMBER_OF_SEGMENTS - defined_segments.length

    // The symbol "::" MUST NOT be used to shorten just one 16-bit 0 field. (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.2)
    dynamically assert defined_segments.length (zero_compression ? < NUMBER_OF_SEGMENTS - 1 : == NUMBER_OF_SEGMENTS)
    // The longest run of consecutive 16-bit 0 fields MUST be shortened (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.3)
    dynamically assert left & right ~= 0[] -- .length <= number_of_compressed_segments if zero_compression
    // When the length of the consecutive 16-bit 0 fields are equal, the first sequence of zero bits MUST be shortened. (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.3)
    dynamically assert left ~= 0[] -- .length != number_of_compressed_segments if zero_compression

    static canonical := v6{
      // The longest run of two or more zero fields, the leftmost of equal ones (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.3)
      // Prefer compressed zeros representation when possible (https://datatracker.ietf.org/doc/html/rfc5952#section-5)
      zero_compression if segments ~= 0[]{length >= 2}
      // Mixed notation for a well-known IPv4-mapped prefix (https://datatracker.ietf.org/doc/html/rfc5952#section-5)
      // Mixed notation for NAT64 (https://datatracker.ietf.org/doc/html/rfc6052#section-2.1)
      embedded_ipv4 if . is "::ffff:0.0.0.0/96" | "64:ff9b::/96"
    }
    full: String => (this as v6{!zero_compression && !embedded_ipv4}).written_out
  }

}
assert ("1.2.3.4" as IP).(
  .segments.first == 1  // IP21 the first segment is not one
  & . as String == "1.2.3.4"  // IP22 an address does not read back as it was written
  & . == .  // IP23 an address is not itself
  & !(. == "1.2.3.5" as IP)  // IP24 two different addresses are the same
)
assert "10.0.0.5/8" as IP as String == "10.0.0.0/8"  // IP40 a prefix after a slash does not give the network
assert "1::2" as IP as String == "1::2"  // IP41 a compressed wide address does not read back as itself
assert "::ffff:1.2.3.4" as IP as String == "::ffff:1.2.3.4"  // IP43 a mapped address is not written with its four parts
assert "64:ff9b::1.2.3.4" as IP as String == "64:ff9b::1.2.3.4"  // IP44 a translated address is not written with its four parts
assert "1.0.0.1" as IP + 1 as String == "1.0.0.2"  // IP46 the address after 1.0.0.1 is not 1.0.0.2
assert "1.0.0.1" as IP - 1 as String == "1.0.0.0"  // IP47 the address before 1.0.0.1 is not 1.0.0.0
// A block is every address in it: its low bits are `0 | 1`, and that is why it is written `/n`.
assert ("10.0.0.0" as IP / 8).(
  .superposed  // BLK1 a block is not a superposition of its addresses
  & "10.1.2.3" as IP is .  // BLK2 an address in the block is not one of it
  & !("11.0.0.1" as IP is .)  // BLK3 an address outside the block is one of it
  & . == "10.0.0.0/8" as IP  // BLK4 the block divided out is not the one read
)
assert "10.0.0.0" as IP / 32 as String == "10.0.0.0"  // BLK5 a block of all the bits is written with a prefix
assert "::ffff:1.2.3.4" as IP is ("::ffff:0:0/96" as IP)  // BLK6 a mapped address is not in the mapped block
assert !("1::2" as IP is ("64:ff9b::/96" as IP))  // BLK7 an address outside the translated block is in it

IPv4 := IP.v4
assert ("1.0.0.12" as IPv4).(
  .segments.length == 4  // IP1 the address has other than four segments
  & . as String == "1.0.0.12"  // IP3 the address does not write as 1.0.0.12
  & (. as Binary).length == 32  // IP4 the address is not thirty-two bits long
  & . / 24 as String == "1.0.0.0/24"  // IP31 the network of 1.0.0.12/24 is not 1.0.0.0/24
  & . + 3 as String == "1.0.0.15"  // IP32 three past 1.0.0.12 is not 1.0.0.15
  & . - 2 as String == "1.0.0.10"  // IP33 two before 1.0.0.12 is not 1.0.0.10
  & . == "1.0.0.12" as IPv4  // IP5 the address read back is another one
)
assert "1.0.0.0" as IPv4 as String == "1.0.0.0"  // IP15 an address ending in zeros is written with a prefix
// A range of addresses is a range on their line (X6.9)
assert ("1.0.0.10" as IPv4 .. "1.0.0.13" as IPv4).count == 4  // FWR1 1.0.0.10 to 1.0.0.13 is not four addresses
assert ("1.0.0.10" as IPv4 .. "1.0.0.13" as IPv4).last as String == "1.0.0.13"  // FWR2 a range of addresses does not end where written
IPv6 := IP.v6
assert ("1:0:0:0:0:0:0:2" as IPv6).(
  .segments.length == 8  // IP6 the wide address has other than eight segments
  & .zero_compression.not  // IP7 the wide address written in full is read as compressed
  & .full == "1:0:0:0:0:0:0:2"  // IP11 the wide address writes wrong in full
  & (. as IPv6.canonical).number_of_compressed_segments == 6  // IP8 the run of zeros is not six long
  & (. as IPv6.canonical).left == 1  // IP9 the run of zeros does not start after one
  & . as String == "1::2"  // IP10 the zeros are not written as ::
)
assert "1:0:0:2:0:0:0:3" as IPv6 as String == "1:0:0:2::3"  // IP12 the longest run of zeros is not the one written ::
assert "1:0:0:2:0:0:3:4" as IPv6 as String == "1::2:0:0:3:4"  // IP13 of two equal runs of zeros the first is not written ::
assert "1:0:2:3:4:5:6:7" as IPv6 as String == "1:0:2:3:4:5:6:7"  // IP14 a single zero field is written ::
assert ("1::2" as IPv6).left.length == 1  // IP42 what is left of :: is not kept as read
assert ("::ffff:1.2.3.4" as IPv6).embedded_ipv4 as String == "1.2.3.4"  // IP45 the embedded address is not kept

{ip: IP}/{prefix_length: Decimal}: IP => ip / prefix_length
