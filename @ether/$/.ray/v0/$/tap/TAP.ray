// Test Anything Protocol version 14 (https://testanything.org/tap-version-14-specification.html)
TAP := class: Language {
  static extensions = ".tap"

  // Description: "#" and "\" are escaped with "\" (https://testanything.org/tap-version-14-specification.html#escaping)
  static Description := class: String (((!"#" && !"\\" && !\n) | ("\\", "#" | "\\"))[]) {
    static (text: String) as (=== Description) => #text.map(. is ("#" | "\\") ? "\\" + . : .) as String
  }
  // YAML diagnostics, indented two spaces between "---" and "..." (https://testanything.org/tap-version-14-specification.html#yaml-diagnostics)
  static YAML := class ("  ---", \n, lines: ("  ", (name: Char.Word[], ": ", value: (!\n)[]), \n)[], "  ...", \n)
  // Test points (https://testanything.org/tap-version-14-specification.html#test-points)
  static Point := class ((failed: "not ")?, "ok ", number: Decimal, " - ", description: Description, \n, (yaml: YAML) if failed)
  // Comments (https://testanything.org/tap-version-14-specification.html#comments)
  static Comment := class ("# ", text: (!\n)[], \n)
  // Version, plan, then test points and comments (https://testanything.org/tap-version-14-specification.html#version, https://testanything.org/tap-version-14-specification.html#plan)
  static Wire := class ("TAP version 14", \n, "1..", plan: Decimal = lines{. is Point}.count, \n, lines: (Point | Comment)[]{.{. is Point}.count == plan}, ("# ", name: (!\n)[], \n)?)

  // A run read from TAP keeps its comments among its claims, in order (https://testanything.org/tap-version-14-specification.html#comments)
  static Run := class: Report = lines: (Report.Claim | Comment)[] = [] {
    claims => lines{. is Report.Claim}
  }

  static claim (point: Point) => (point.description as String ~= (id: Char.Word[], " ", message: *)) -- (named => Report.Claim(named.id, named.message,
    passed: !point.failed,
    at: point.yaml ? (point.yaml.lines{.name == "file"}.first?.value as Location){from == (point.yaml.lines{.name == "line"}.first?.value as Decimal ?? 1, 1)} : None))
  static point (claim: Report.Claim, number: Decimal) => Point(
    failed: "not " if !claim.passed,
    number: number,
    description: (claim.id + " " + claim.message) as Description,
    yaml: YAML(lines: [(name: "message", value: JSON.write(claim.message)), (name: "file", value: JSON.write(claim.at?.file as String)) if claim.at, (name: "line", value: (claim.at.from?.line ?? 1) as String) if claim.at]) if !claim.passed)

  syntax := Compiler.default + {
    // Version and plan (https://testanything.org/tap-version-14-specification.html#version, https://testanything.org/tap-version-14-specification.html#plan)
    TAP version 14 => None
    1..{plan: Decimal} => None
    // Test points (https://testanything.org/tap-version-14-specification.html#test-points)
    {failed?: "not "}ok {number: Decimal} - {id: Char.Word[]} {message} => Report.Claim(id as String, message as String, passed: !failed)
    // Comments (https://testanything.org/tap-version-14-specification.html#comments)
    # {literal text} => Comment(text)
    {run: \n} => Run(lines: run.components{!= None})
    {wire: Wire} => Run(name: wire.name ?? "ray", lines: wire.lines.map(. is Point ? claim(.) : .))
  }
  level := syntax
  written := {
    {writing: Language.Writing{value is Report}} => writing.value -- (report => (report is Run ? report.lines : report.claims) -- (lines => Wire(name: report.name,
      lines: lines.enumerate.map(. -- (.value is Comment ? .value : point(.value, lines[..<.index]{. is Report.Claim}.count + 1))))))
  }
}
