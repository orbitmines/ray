    {name} = kept
    kept

// A class's block read for an instance: what declares is the class's (read once, for it); the rest (`&.caller[name] =
// this`) is read in the instance. What declares: a definition (its line has the definer), and what these read.
instanced {{code}} =>
  goto instanced
  {code}
goto declaring
{name} := {value}
goto declaring
{name}:{ }{type}
goto declaring
{name}:{ }{type}, {{rest}}
goto declaring
{name}:{ }{type} = {value}
goto declaring
{pattern: Pattern}:{ }{type}
goto declaring
{on}.{name} := {value}
goto declaring
({name}) := {value}
goto declaring
({name}, {names}) := {list}
goto declaring
static {{statement}}

// `x as T`: x, when it is a T; else what T makes of it (`T.from(x)`; none, by default).
from (x) =>
  None
// `if x { case => value … } else { … }`: `==` unless an operator is written, `is` for a type (P2.11)
assert {
  described (x) => if x {
    is Number => "number"
    "A" => "letter"
  } else {
    "other"
  }
  // MA1 an is case does not match an instance of its type
  assert described(5) == "number"
  // MA2 a case with no operator is not asked with ==
  assert described("A") == "letter"
  // MA3 the else case does not take what nothing else does
  assert described(true) == "other"
}
assert {
  graded (x) => if x {
    < 10 => "low"
  } else {
    "high"
  }
  // MA4 a case with an operator is not asked with it
  assert graded(3) == "low"
}
assert {
  first_case (x) => if x {
    1 => "one"
    is Number => "number"
  } else {
    "other"
  }
  // IC1 a later case answers before an earlier one that holds
  assert first_case(1) == "one"
  // IC2 a case that does not hold answers
  assert first_case(2) == "number"
}
as {type} ^keyword =>
  (. is {type}) ? . : (. -- ((subject) => {type}.from(subject)))
// (a conversion written in the class converted to, `(x: S) as (=== T) => …`: what T makes of an S)
({parameter}) as (=== {type}) => {body} =>
  from := (({parameter}) => {body})

// What a value holds under a key: its entries (`keyed`: `key`, `value`), a Ray; none until one is given.
keyed := None
Holding := class (key, value) => { }
held (key) =>
  found := (.keyed) ? .keyed.find((entry) => entry.key === key) : None
  found ? found.value : None
assert {
  held := 0
  unless true { held += 1 }
  unless 1 == 1 { held += 1 }
  unless mark { held += 1 }
  // HO2 unless takes the block when the condition holds
  assert held == 0
}
holding (key, value) =>
  (.keyed := []) unless (. reading { here keyed }) && .keyed
  found := .keyed.find((entry) => entry.key === key)
  if found {
    found.value = value
  } else {
    .keyed.append(Holding(key, value))
  }
  value

// (what a narrowing narrows: see `T{constraint}`)
narrows := None
// An enumeration: `enum A | B | C`, a node with a member for each name (a node in it), and `members` them all (the names
// are code: handed on as written; a rule's right side is not read by that rule, but what is in a group is).
members := None
nearest enum {{names}} =>
  Node.interior &+= {
    members := []
    enumerated {names}
  }
assert {
  Shape := enum circle (radius: Number) | square (side: Number) | point
  // EM8 a member does not carry its field
  assert Shape.circle.radius
  // EM9 the second member does not carry its field
  assert Shape.square.side
  // EM10 a member carries another's field
  assert !(Shape.point.radius)
  // EM11 a member without fields is not there
  assert Shape.point
  // EM16 a member is not one of its own enum
  assert Shape.circle is Shape
}
assert {
  Modifier := enum static | readonly | this
  // EM12 a member named this is not there
  assert Modifier.this
}
assert {
  Level := enum low (rank: Number) | high (rank: Number) {
    ranked => rank
  }
  // EM17 a block over lines lost what it declares
  assert Level.low.ranked
  // EM18 the last member gained nothing from the block
  assert Level.high.ranked
  // EM20 an enum of two written with a block has other than two members
  assert Level#.count == 2
  // EM21 two members written with a block are the same
  assert !(Level.low == Level.high)
}
enumerated {name} =>
  {name} := { }
  members.append({name})
nearest enumerated {name} | {{rest}} =>
  {name} := { }
  members.append({name})
  (enumerated {rest})
// (a member written with fields, `Linux (platform: "linux")`: a record of them)
nearest enumerated {name} {`(`}{{fields}}{`)`} =>
  {name} := ({fields})
  members.append({name})
nearest enumerated {name} {`(`}{{fields}}{`)`} | {{rest}} =>
  {name} := ({fields})
  members.append({name})
  (enumerated {rest})
// (one with a block after its names, `enum A | B { … }`: the names (what the block says of the members is not read yet))
nearest enum {{names}} {{block}} =>
  enum {names}

// `dynamically`: given again (run again) whenever what it reads is written from outside in the rewrite it is read in
// (`&.caller`), or anything run from there: `dynamically x := v` (x is v again), `dynamically code` (the code runs again).
// What it reads: the names its code has in it (a write of one it does not have goes on past it). (That program's `=`: the
// write, then each one whose code has the name in it again, once: what they write, while they do, does not; nor does any
// write while they are given again. A member written, `x.y = v`, is
// `x.y := v`: written as `y = v` in `x`. The `:=` form is written `{ }` after `dynamically`, so the code form, a modifier,
// does not read its definition.)
dynamics := None
dynamically {{code}} =>
  dynamic_in (&.caller) {
    {code}
  }
  {code}
assert {
  asserted := dynamically assert {
    true
    1 == 1
  }
  // DY1 a dynamic assert of holding conditions fails
  assert asserted
}
assert {
  contributed := 1
  contribution := 2
  dynamically contributed &= contribution
  contribution = 3
  // FWQ6 a dynamic contribution kept its earlier value
  assert !(contributed == (1 & 2 & 3))
}
// `dynamically x` reads x again each time (P5.1)
assert {
  moving := 1
  followed := dynamically moving + 1
  moving = 5
  // DY2 dynamically does not read again what it depends on
  assert followed == 6
}
dynamically{ }{name} := {{value}} =>
  {name} := {value}
  dynamic_in (&.caller) {
    {name} = ({value})
  }
// `dynamically assert c`: no test; what holds of the data, checked where there is some (an instance, its class `of`), not
// when the class is made.
{`dynamically`} assert {condition} ^keyword =>
  (goto unchecked) unless here of
  ensure {condition}
  unchecked\
dynamic_in {program} {{code}} =>
  {program}
  {program} &+= {
    dynamics := dynamics ?? {
      updating := false
      refreshing := []
      refresh (written) =>
        // (its own flag given directly (`:=`): not a write the overrides below see)
        unless .updating {
          .updating := true
          .refreshing.for((one) => (one.again() if one.reads contains written))
          .updating := false
        }
    }
    {written} = {given} =>
      (goto quiet) if dynamics.updating
      {written} = {given}
      dynamics.refresh(.written)
      goto done
      quiet\
      {written} = {given}
      done\
    {on}.{written} = {given} =>
      (goto quiet) if dynamics.updating
      {on}.{written} := {given}
      dynamics.refresh(.written)
      goto done
      quiet\
      {on}.{written} := {given}
      done\
  }
  {program}.dynamics.refreshing.append({
    reads := .code
    again := () => {
      {code}
    }
  })
// The classes the library adds to: what is iterable, an array of it, text (an array of characters), a number, a character
// (a number), a program, a diagnostic.
Iterable := class { }
// A list: its own methods first, then what Iterable has (the library adds the rest there).
Iterable &+= {
  Listing := {
    // (a class made of it, of it: not of Iterable's class)
    interior =>
      { }
    extended () =>
      .interior
    new =>
      {
        head := None
        // Class headers: fields written inline, a class read by its pattern, `static` (A7, T3.10, T3.15b)
        assert {
          Pair := class left: Number, right: Number = 7 {
            total => left + right
          }
          // HD1 a header field is not taken by position
          assert Pair(1, 2).left == 1
          // HD2 the second header field is not taken by position
          assert Pair(1, 2).right == 2
          // HD3 header fields are not taken by name
          assert Pair(right: 3, left: 4).total == 7
          // HD4 a header default is not used when not given
          assert Pair(1).right == 7
          Tagged := class ("#", tag: Decimal) => {
            doubled => tag * 2
          }
          // HD7 a class read by its pattern has no named part as a field
          assert Tagged(tag: 4).doubled == 8
          tagged_of{ }{written: Tagged} => written
          // HD8 a class written as a pattern does not read its text
          assert (tagged_of #21).tag == 21
          Sub := class: Pair (": ", first: Number) => {
            head => first
          }
          // HD9 class: Parent (pattern) has no field from its pattern
          assert Sub(first: 2).head == 2
          // HD10 class: Parent (pattern) is not built on Parent
          assert Sub(first: 2) is Pair
          Count := class {
            static made := 0
            static zero => 0
            static Inner := class { }
            tally => made
          }
          first_count := Count()
          second_count := Count()
          Count.made = 2
          // HD11 a static is not shared by the instances
          assert first_count.tally == 2
          // HD12 a static is per instance
          assert second_count.tally == 2
          // HD13 a static method is not on the class
          assert Count.zero == 0
          // HD14 a static class is not on the class
          assert Count.Inner
          Both := class: Pair &+ Tagged { }
          // HD15 class: A &+ B is not built on A
          assert Both(left: 1, right: 2, tag: 3).total == 3
          // HD16 class: A &+ B is not built on B
          assert Both(left: 1, right: 2, tag: 3).doubled == 6
        }
        tail := None
        listing := true
        of := Array
        assert {
          Side := enum near (of: "here") | far (of: "there") {}
          // HO3 a member is not itself
          assert Side.near == Side.near
          // HO4 two members of one enum are the same
          assert !(Side.near == Side.far)
          // HO5 what a member holds is not what it was written as
          assert Side.near.of == "here"
          // HO6 a member holds what the other one does
          assert !(Side.near.of == "there")
        }
        spread := false
      }
    // (made by `,`: arguments, each its own; in brackets, `[a, b]`, one list)
    spreading =>
      .spread := true
      .
    gathered =>
      .spread := false
      .
    append (value) =>
      link := {
        value := value
        next := None
        // BOR1 true.next should be false
        assert true.next == false
        // BOR2 false.next should be true
        assert false.next == true
        // BOR3 true.next.next should be true
        assert true.next.next == true
        // BOR4 false.next.next should be false
        assert false.next.next == false
        assert {
          Colour := enum red | green | blue
          // EM1 the member an enum is written with is not there
          assert Colour.red
          // EM2 the last member is not there
          assert Colour.blue
          // EM4 a member is not itself
          assert Colour.red == Colour.red
          // EM5 two members of one enum are the same
          assert !(Colour.red == Colour.blue)
          // EM6 a member is not one of its enum
          assert Colour.red is Colour
          // EM7 an enum of three has other than three members
          assert Colour#.count == 3
          // EM14 an enum's members are not its three, in order
          assert Colour# == [Colour.red, Colour.green, Colour.blue]
          // EM25 the member after red is not green
          assert Colour.red.next == Colour.green
          // EM15 a member is one of another enum
          assert !(Shape.circle is Colour)
        }
        assert {
          R := class { }
          S := class: R { s => S(next: this) }
          // C5 a successor chain through class: Parent broke
          assert S().s.s.s
          // C6 class: Parent did not add a class component
          assert S.components.hierarchy.first
          // C7 super is missing
          assert S.super
        }
        assert {
          E := enum p | q | r
          // C9 the first enum member is not the first written
          assert E#.first == E.p
          // C10 enum members are not chained forward
          assert E#.first.next.next == E.r
          // C11 enum members are not chained backward
          assert E#.last.previous.previous == E.p
          // C12 an enum of three has other than three members
          assert E#.count == 3
          // C13 the members are not an Iterable of Rays
          assert E#.first.is_initial
          // C14 Iterable.last did not reach the last member
          assert E#.last == E.r
        }
        // SP2 |+ does not answer with either component
        assert (true |+ "A").next == false | "B"
        previous := None
        // BOR5 true.previous should be false
        assert true.previous == false
        // BOR6 false.previous should be true
        assert false.previous == true
      }
      if .tail {
        link.previous := .tail
        .tail.next := link
      } else {
        .head := link
      }
      .tail := link
      .
    // (`xs[n]`, a number: its nth value, from 0; else what other readings make of it)
    [{index}] =>
      (goto .) unless {index} is Number
      at := .head
      left := {index}
      assert {
        left := 3
        rounds := 0
        while left {
          rounds += 1
          left -= 1
        }
        // CF10 a loop ran other than three times
        assert rounds == 3
        // CF11 a loop left its count behind
        assert left == 0
      }
      assert {
        Holder := class {
          Side := enum left | right {
          }
          side => Side.left
        }
        // EM22 an enum inside a class has no members
        assert Holder.Side.left
        // EM23 an enum inside a class lost a member
        assert Holder.Side#.count == 2
        // EM24 an instance does not reach the enum its class writes
        assert Holder().side == Holder.Side.left
      }
      assert {
        {left} - {right} => (
          held := 2
          held + 1
        )
        // RW1 a body that declares a name is not run
        assert 10 - 3 == 3
        // RW2 it answers the same wherever it stands
        assert 1 - 1 == 3
      }
      while at && left > 0 {
        at = at.next
        left = left - 1
      }
      at ? at.value : None
    // (the values of the lists in it in it, in their place: all the way down; `flatten(n)`, n lists down)
    flatten =>
      .flattened(64)
    flatten({levels}) =>
      .flattened({levels})
    flattened (levels) =>
      made := Listing.new
      .for((it) => (((it.listing === true) && (levels > 0)) ? it.flattened(levels - 1).for((x) => made.append(x)) : made.append(it)))
      made
    // (`xs{p}`: the values p holds for, `.` each one in it; `xs{x => p}`: each one given to it)
    {{constraint}} =>
      kept := Listing.new
      .for((it) => (kept.append(it) if (it with { {constraint} })))
      kept
    {`{`}{parameter} => {body}{`}`} =>
      kept := Listing.new
      .for((it) => (kept.append(it) if ((({parameter}) => {body}))(it)))
      kept
    // (a list led by a value: this one, the value first (a side that only declared is no value in it))
    led (value) =>
      (value === declared) ? . : .prepend(value)
    for (body) =>
      at := .head
      while at {
        body(at.value)
        at = at.next
      }
      .
    first =>
      .head ? .head.value : None
    last =>
      .tail ? .tail.value : None
    empty =>
      .head ? false : true
    count =>
      counted := 0
      assert {
        skipped := 0
        counted := 0
        while counted < 5 {
          counted = counted + 1
          continue if counted == 2
          skipped = skipped + 1
        }
        // RC3 continue does not go on with the next round
        assert skipped == 4
      }
      at := .head
      while at {
        counted = counted + 1
        at = at.next
      }
      counted
    rest =>
      made := Listing.new
      at := .head ? .head.next : None
      while at {
        made.append(at.value)
        at = at.next
      }
      made
    prepend (value) =>
      link := {
        value := value
        next := None
        previous := None
      }
      if .head {
        .head.previous := link
        link.next := .head
      } else {
        .tail := link
      }
      .head := link
      .
    take () =>
      first := .head
      .head := first ? first.next : None
      .tail := .head ? .tail : None
      first ? first.value : None
    find (predicate) =>
      at := .head
      while at {
        return at.value if predicate(at.value)
        at = at.next
      }
      None
    some (predicate) =>
      found := false
      at := .head
      while at {
        if predicate(at.value) {
          found = true
          break
        }
        at = at.next
      }
      found
    every (predicate) =>
      !(.some((x) => !predicate(x)))
    map (mapping) =>
      made := Listing.new
      .for((x) => made.append(mapping(x)))
      made
    without (value) =>
      made := Listing.new
      .for((x) => (made.append(x) unless x === value))
      made
    listed () =>
      made := Listing.new
      .for((x) => made.append(x))
      made
    joined (other) =>
      if other.listing {
        other.listed().for((x) => .append(x))
      } else {
        .append(other)
      }
      .
  }
}
Listing := Iterable.interior.Listing
Ray := Listing
// C8 Ray.super does not reach Iterable's count
assert Ray.super.count
Array := class: Iterable { }
// TY63 a number is not an array
assert 1 is Array
String := class: Array { }
// PR38 as does not bind looser than plus
assert 1 + 2 as String == "3"
// SD3 ...T is not T[]
assert ("A", "A") is ...String
Number := class { }
// TY5 five is not a Number
assert 5 is Number
// Narrowings ask the constraint as well as what they narrow
assert {
  Small := Number{. < 5}
  Tiny := Small{. < 2}
  Even := Number{. % 2 == 0}
  // TY16 three is not one of the small
  assert 3 is Small
  // TY17 seven is one of the small
  assert !(7 is Small)
  // TY19 one is not tiny
  assert 1 is Tiny
  // TY20 three is tiny
  assert !(3 is Tiny)
  // TY25 seven is tiny
  assert !(7 is Tiny)
  // TY26 the tiny do not admit one
  assert Tiny.admits(1)
  // TY27 the tiny admit three
  assert !(Tiny.admits(3))
  // TY65 four is not both small and even
  assert 4 is Small & Even
  // TY66 three is both small and even
  assert !(3 is Small & Even)
  // TY67 six is both small and even
  assert !(6 is Small & Even)
}
// TY18 three is not a number
assert 3 is Number
// Calling a narrowed type chooses a value of it.
// CN1 a value chosen from a narrowing does not satisfy it
assert (Number{. > 5}()) > 5
Char := class: Number { }
// UN45 a is not a Latin character
assert U+0061 is Char.Latin
// UN46 alef is a Latin character
assert !(U+0627 is Char.Latin)
// UN53 alef is not an Arabic character
assert U+0627 is Char.Arabic
// UN54 alpha is not a Greek character
assert U+03B1 is Char.Greek
// UN55 a Cyrillic a is not Cyrillic
assert U+0430 is Char.Cyrillic
// UN56 a Han character is not Han
assert U+4E00 is Char.Han
Program := class { }
// A program run as a selection
assert Program(code: {
  1
  2
}).(
  .waiting  // RU1 a program nobody stepped is not waiting
  & .next.intermediate  // RU2 one step in is not intermediate
  & .waiting  // RU3 stepping a copy moved the original
  & .finished.final  // RU4 a program run to its end is not final
  & .finished.results.last == 2  // RU5 a program run to its end did not keep what its last step answered
)
assert {
  doubling := Program(code: { 2 })
  halving := Program(code: { 1 })
  ! doubling halving
  // IV1 the declared inverse is not the inverse
  assert doubling⁻¹ === halving
  // IV2 the inverse of the inverse is not the function
  assert halving⁻¹ === doubling
  // IV3 a function with an inverse is not reversible
  assert doubling.reversible
}
// A program is a quest (P4.8): its cursor says how far it is; sleeping waits on the time (P4.11); a dynamic `&=` keeps one contribution (P5.7)
assert Program(code: { 1 }).(
  !(.done)  // FWQ2 a program not yet stepped is done
  & .finished.done  // FWQ3 a finished program is not a done quest
)
// FWQ4 a stopped program is not done
assert Program(code: { 1 }).stop.done
assert {
  started := Program(code: "1")
  @me/quests |= started
  // JB1 a program given to @me/quests is not among them
  assert started is @me/quests
  // JB11 a started program is not run by whoever started it
  assert started.who === @me
  // JB5 stopping a program does not end it
  assert started.stop.done
}
assert Program(code: "1", from: @public).(
  .serves(@public)  // JB8 a quest serving a location does not serve it
  & !(.serves(@private))  // JB9 a quest serves a location it was not given
)
Narrowing := class { }
Diagnostic := class { }
// Errors: a value carries its diagnostics, and its type does not see them
assert {
  failing := (0).diagnosed(Diagnostic(message: "no"))
  // ER1 a default does not stand in for an error
  assert failing $ 5 == 5
  // ER3 an optional error is not None
  assert failing $? === None
  // ER4 an optional error does not fall back
  assert failing $? 6 == 6
  // ER5 the handler does not see the error as its receiver
  assert failing $ { .message } == "no"
  fatal_one := (0).diagnosed(Diagnostic(message: "true", fatal: true))
  // ER6 a default caught a fatal error
  assert (fatal_one $ 5).erred
  // ER7 the catch-all did not catch a fatal error
  assert fatal_one $?! === None
  // ER8 a wrapped error forgot its cause
  assert (failing $ Diagnostic(message: "wrapped")).diagnostics.last.cause === failing.diagnostics.last
  // ER9 a value given a second diagnostic does not keep both
  assert failing.diagnosed(fatal_one.diagnostics.last).diagnostics.count == 2
  // ER10 a value that erred is no longer of its type
  assert failing is Number
  // ER11 a value that erred is not equal to itself without the error
  assert failing == 0
  returning := () => {
    failing $ return 9
    1
  }
  // ER13 $ return did not return from the function
  assert returning() == 9
}
// Checking a permission runs no one's code: a grant whose expression or filter has effects is refused when granted, and never run.
assert {
  purg_reader := Character(name: "purg-reader")
  purg_lamp := (lamp: 1)
  // PURG1 a grant naming an expression with effects is granted
  assert (purg_reader.read IO().output("leak")) is Diagnostic
  // PURG2 a grant whose filter has effects is granted
  assert (purg_reader{IO().output("leak")}.read purg_lamp) is Diagnostic
  // PURG3 a refused grant is kept
  assert !(purg_lamp.access)
  // PURG5 a grant reading the time is refused
  assert !((purg_reader.read Time.now) is Diagnostic)
}
// HS12 a share that is not a whole number of a discrete structure's possibilities is not a type error
assert (33% ("A" | "B" | "C")) is Diagnostic

// (`assert` once more, defined last: it binds loosest, `assert a === b` is `assert (a === b)`)
assert {condition} ^keyword =>
  goto afterwards
  ensure {condition}

// A theme: what each style is shown as (`^style = ^shown`: another style, or a colour, `^ #F2F0FF`), in the order written; the one
// made last, `Theme.current`, the one shown.
Theme := {
  current := None
}
{`theme`} {name} {{styles}} ^keyword =>
  made := {
    name := {name}
    styles := Listing.new
  }
  {
    {`^`}{style} = {`^`}{shown} =>
      named := .style
      colour := .shown
      made.styles.append([named, colour])
    {`^`}{style} = {`^`}{ }{shown} =>
      named := .style
      colour := .shown
      made.styles.append([named, colour])
  } reading {
    {styles}
  }
  Theme.current = made
  made

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^U2
  ^type = ^U2
  ^class = ^U2
  ^enum = ^U2
  ^interface = ^U2
  ^struct = ^U2
  ^event = ^U2
  ^enumMember = ^U2
  ^typeParameter = ^U0
  ^parameter = ^U0
  ^variable = ^U1
  ^property = ^U1
  ^function = ^U4
  ^method = ^U4
  ^decorator = ^U4
  ^macro = ^U2
  ^keyword = ^U3
  ^modifier = ^U3
  ^comment = ^U3
  ^string = ^D2
  ^number = ^D2
  ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment

  // A test, `assert`, as what it found (failed, passed, not run); what is written after it in its own colours, muted: taken this
  // much toward this.
  ^failed = ^error
  ^passed = ^debug
  ^untested = ^comment
  ^muted = ^comment
  ^muting = ^ 50%
}






















assert {
  fired := 0
  unless false { fired += 1 }
  unless 1 == 2 { fired += 1 }
  unless None { fired += 1 }
  // HO1 unless does not take the block when the condition does not hold
  assert fired == 3
}








// A map's own key wins over Node's member (T8.7, T2.8)
assert ({ count: 3 }).(
  .count == 3  // FWO1 a map's own count does not win over Node's
  & (. as Object).count == 3  // FWO3 a value without Node does not read its own key
)























