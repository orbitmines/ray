// What is wrapped comes back where it may; a digest is what it says of itself.

mark ^keyword := external global

one := Instance(location: None, key: $.x25519.pair())
two := Instance(location: None, key: $.x25519.pair())
three := Instance(location: None, key: $.x25519.pair())

locked := Encoding.Encrypted(value: 5, key: one.key)
unless locked.opened(one) == 5 { INFO@mark `EN1 what is locked does not open with its key` }
unless locked.opened(two) is Abstract { INFO@mark `EN2 it opens with the wrong key` }
kept := Encoding.Encrypted(value: 5, key: three.key)
if kept.opened(three) is Abstract { INFO@mark `EN8 what is held is not read back where the key is` }
unless kept.opened(two) is Abstract { INFO@mark `EN9 it is read back where the key is not` }
unless kept.opened(three) == 5 { INFO@mark `EN10 what is read back is not what was put in` }
open_to_none := Encoding.Encrypted(value: 5, key: None)
unless open_to_none.opened(Instance(location: None)) is Abstract { INFO@mark `EN21 a value held under nothing comes back at nothing` }
unless open_to_none.opened(one) is Abstract { INFO@mark `EN22 a value held under nothing comes back anywhere` }

seven := $.x25519.pair()
held_there := Encoding.Encrypted(value: 5, key: seven)
unless held_there.opened(Instance(location: None, key: seven)) == 5 { INFO@mark `EN30 a value does not open at an instance holding its key` }
unless held_there.opened(Instance(location: None, key: $.x25519.pair())) is Abstract { INFO@mark `EN31 a value opens at an instance holding another key` }
unless held_there.opened(Instance(location: None)) is Abstract { INFO@mark `EN32 a value opened without its key does not ask to find it` }
unless held_there.opened(Character(name: "k", key: seven)) == 5 { INFO@mark `EN33 a value does not open for a character holding its key` }
unless held_there.opened(Instance(location: None, key: seven)) == 5 { INFO@mark `EN34 a value opened with its key is not what was put in` }

held := 5 as $.gzip
unless held as Number == 5 { INFO@mark `EN3 what is compressed does not come back` }
unless held.algorithm === $.gzip { INFO@mark `EN4 it forgot how it was compressed` }
if held.algorithm === $.sha1 { INFO@mark `EN13 it is packed every way at once` }
anywhere := 4 as $.base64
unless anywhere as one == 4 { INFO@mark `EN23 a packed value does not come back at a target` }
unless anywhere as Number == 4 { INFO@mark `EN24 a packed value does not come back at nothing` }
nested := Encoding.Encrypted(value: 5 as $.gzip, key: one.key)
unless nested.opened(one) as Number == 5 { INFO@mark `EN15 what is packed inside what is locked does not come back` }
unless nested.opened(two) is Abstract { INFO@mark `EN16 what is locked around a packed value opens with the wrong key` }

sha := Encoding.Hash(value: 5, algorithm: $.sha256)
unless sha == Encoding.Hash(value: 5, algorithm: $.sha256) { INFO@mark `EN5 two like digests are not the same` }
if sha == Encoding.Hash(value: 5, algorithm: $.md5) { INFO@mark `EN6 digests of different algorithms are the same` }
if sha == Encoding.Hash(value: 4, algorithm: $.sha256) { INFO@mark `EN7 digests of different values are the same` }
unless sha.value == 5 { INFO@mark `EN17 a digest forgot what it was made of` }
unless sha.algorithm === $.sha256 { INFO@mark `EN18 a digest forgot how` }

if $.sha256 === $.sha1 { INFO@mark `EN19 two algorithms are the same` }
unless $.md5 === $.md5 { INFO@mark `EN20 an algorithm is not itself` }
