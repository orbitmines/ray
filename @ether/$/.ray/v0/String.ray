Char := class: Unicode.Scalar {
  static Letter: Char = "a".."z" | "A".."Z"
  static Digit: Char = "0".."9"
  static Blank: Char = " " | "\t".."\r"
  static Word: Char = Letter | Digit | "_"
  static Symbol: Char = Unicode.GeneralCategory.(Punctuation | Symbol)

  codepoint => this
  is_ascii => this < 128
  // UTF-8 (https://www.unicode.org/versions/latest/core-spec/chapter-3/#G27288)
  octets => this < 128 ? [this]
    : this < 2048 ? [192 + this / 64, 128 + this % 64]
    : this < 65536 ? [224 + this / 4096, 128 + this / 64 % 64, 128 + this % 64]
    : [240 + this / 262144, 128 + this / 4096 % 64, 128 + this / 64 % 64, 128 + this % 64]

  upper_case | uppercase => Unicode.UpperCase[this] ?? this
  lower_case | lowercase => Unicode.LowerCase[this] ?? this
  is_upper => lower_case != this
  is_lower => upper_case != this
  mirrored => Unicode.BidiMirroring[this]?.value ?? this
  swap_case | swapcase => is_lower ? upper_case : lower_case
  // Full folding: the C and F rows, never the S and T ones (X1.3).
  fold_case | foldcase => Unicode.CaseFolding.rows{.range.in(this) && .status ==.instance_of ("C" | "F")}.first?.value ?? this

  as Decimal => this ==.instance_of Digit ? this - "0" : this.lower_case - "a" + 10
  static digit (value: Decimal): Char => value < 10 ? "0" + value : "a" + value - 10
  static (codepoint: Unicode.Scalar) as Char => codepoint

  east_asian_width => Unicode.EastAsianWidth[this]?.value ?? "N"
  columns => east_asian_width ==.instance_of ("W" | "F") ? 2 : 1
  script => Unicode.Scripts[this]?.value ?? "Unknown"
  block => Unicode.Blocks[this]?.value ?? "No_Block"
}

\0 = U+0000
\t = U+0009
\n = U+000A
\r = U+000D
\s = Unicode.GeneralCategory.Space_Separator | \t
\S = !\s
\R = Unicode.GeneralCategory.Line_Separator
\x{codepoint: Hexadecimal{length == 2}}: Char => codepoint
\u{codepoint: Hexadecimal{length == 4}}: Char => codepoint
\U{codepoint: Hexadecimal{length == 6}}: Char => codepoint
\x{`{`}{codepoint: Hexadecimal{length == 1..6}}{`}`}: Char => codepoint
\u{`{`}{codepoint: Hexadecimal{length == 1..6}}{`}`}: Char => codepoint
\U{`{`}{codepoint: Hexadecimal{length == 1..6}}{`}`}: Char => codepoint
\d = Unicode.GeneralCategory.Decimal_Number
\D = !\d
\w = Char.Word
\W = !\w
\\ = "\"
\" = "\""

// `"…"` with the escapes above read inside it, an unknown escape kept as written, and dedented (L§10.1).
"{literal: (\{escape} | !"\"")[]}": String => literal.literal_dedented

String := class: Char[] {
  () => &caller[this]()

  upper_case | uppercase => #.upper_case as String
  lower_case | lowercase => #.lower_case as String
  is_upper => some(.is_upper) && !some(.is_lower)
  is_lower => some(.is_lower) && !some(.is_upper)
  swap_case | swapcase => #.swap_case as String
  // Full folding: `ß` folds to `ss` (X1.3).
  ignore_case | ignorecase => this ~ fold_case
  fold_case | foldcase => #.fold_case as String
  title_case | titlecase => words.map(.[0].upper_case, .[1..].lower_case).join(" ")

  words => split(Char.Blank | "_")
  snake_case | snakecase => words.lower_case.join("_")
  camel_case | camelcase | camelCase => words[0].lower_case, words[1..].title_case
  pascal_case | pascalcase | PascalCase => words.title_case as String

  plural => ends_with("s") ? this : this + "s"
  singular => ends_with("s") ? this[..-1] : this

  mirrored => <-#.mirrored as String
  * (count: Number) => count == 0 ? "" : this, this * (count - 1)

  trimmed => this{!(⊢ Char.Blank[] | Char.Blank[] ⊣)}
  trimmed (characters: Char[]) => this{!(⊢ characters[] | characters[] ⊣)}
  before (other: String) => this ~= (before: *, other, *) -- .before ?? this
  after (other: String) => this ~= (*, other, after: *) -- .after ?? ""

  starts_with (other: String) => this ~= ⊢ other
  ends_with (other: String) => this ~= other ⊣
  contains (other: String) => this ~= other
  index_of (other: String) => (this ~= other)?.index

  split (separator: Char | String) => this ~= (*, separator)[] -- #.join(*)
  lines => split(\n)
  indentation => (this ~= ⊢ " "[]).length
  common_indentation => lines{!.trimmed.empty}.map(.indentation).min ?? 0
  dedented => lines.map(.trimmed.empty ? "" : .[common_indentation..]).join(\n)
  literal_dedented => lines.count == 1 || !lines.first.trimmed.empty ? this
    : (lines[1..] -- (.last.trimmed.empty ? .[..-1] : .)).join(\n).dedented

  slice (from: Number, to: Number) => this[from..<to]
  replace (old: String, new: String) => split(old).join(new)
  escaped_line => #.map(. == \\ ? "\\\\" : . == \" ? "\\\"" : . == \n ? "\\n" : .) as String

  // `"1010"` and `1010₂` are one value seen two ways (N1.11).
  as (base: Number.Base) => #.reduce(0) (acc, current) => acc * base + current as Decimal
  as Decimal => this as 10

  compounds + (other: String) => this, other
  bytes => #.map(.octets).flatten
  find_all (pattern: String) => (this ~= pattern)#.index
  // `"…".italic` is the same as `"…" ^italic`: styling runs on highlighting (F-C2, F-C2b).
  italic => this ^italic
  bold => this ^bold
  trim (characters: String) => trimmed(characters)
}

// `String[] as String` joins without a separator, `.join(sep)` with one (X1.5).
String[] &+= {
  as (=== String) => this.reduce(,)
  join (separator: String) => this.reduce (acc, current) => acc, separator, current
}

String{length == 1} as Char => first

// Precedence is the order rules are declared in, deduced from where they are written: the nearest class that declares both first, then the later declaration (G1.2).
Placement := class = nth_class: Number, written_at: Number {
  chainable <= (other: Placement) => nth_class < other.nth_class || (nth_class == other.nth_class && written_at >= other.written_at)
}
Node &+= {
  placed (spelled) => classes.enumerate{.value.written_as.precedence(spelled) != None}.first
    -- . ? Placement(nth_class: .index, written_at: .value.written_as.precedence(spelled)) : None
}
{a} [x] {b} [y] {c} => a.placed(x) && a.placed(y)
  ? (a.placed(x) <= a.placed(y) ? (a [x] b) [y] c : a [x] (b [y] c))
  : None

// An anonymous function is a value: a parameter list has no `{`, so a rule head like `({expr})` still reads as a rule (B21).
// Called, its `.` stays the context it is written in; only what enters an element (`~~`, reduce, narrowings) rebinds `.`.
Parameters := String{!.contains("{")}
({parameters: Parameters}) => {block} => Program(code: (external ** block), parameters: (external ** parameters), context: this)
