mark ^keyword := global

a := Ray()
b := Ray(previous: a)
unless a.is_initial { INFO@mark `RR1 a lone ray is not initial` }
unless a.nonempty { INFO@mark `RR2 a lone ray counts as empty` }
if b.is_initial { INFO@mark `RR3 a linked ray reports initial` }
unless b.first == a { INFO@mark `RR4 the first of a linked ray is not where it starts` }
unless a.count == 1 { INFO@mark `RR5 a lone ray does not count one` }
unless a.last == a { INFO@mark `RR6 a lone ray is not its own last` }
unless b.min(b) == b { INFO@mark `RR7 the smaller of a ray and itself is not that ray` }
unless b.max(b) == b { INFO@mark `RR8 the larger of a ray and itself is not that ray` }
unless (if false { b } else { b }) == b { INFO@mark `RR9 an if/else holding a ray is not that ray` }

c := Ray(previous: b)
a.next = b
b.next = c
unless a[2] == c { INFO@mark `R8 two along did not reach the third ray` }
unless a.count == 3 { INFO@mark `R9 a ray of three does not count three` }
unless a.every(.nonempty) { INFO@mark `R10 every failed` }
unless a.some(.is_terminal) { INFO@mark `R11 some failed` }
unless b.every(.nonempty) { INFO@mark `RV1 every from the middle of a ray is not true of what holds everywhere` }
if b.every(!.is_terminal) { INFO@mark `RV2 every from the middle of a ray misses the end after it` }
if b.every(!.is_initial) { INFO@mark `RV3 every from the middle of a ray misses the start before it` }
if c.every(!.is_initial) { INFO@mark `RV4 every from the end of a ray misses the start` }
unless a.every(.nonempty) { INFO@mark `RV5 every from the start of a ray is not true of what holds everywhere` }
unless a.every(.is_initial || .is_terminal || . == b) { INFO@mark `RV6 every does not reach the three rays of a ray entered at its start` }
unless a.acyclic { INFO@mark `R14 a chain is not acyclic` }
unless b.index == 1 { INFO@mark `RR82 the second ray is not one along` }
unless b.expand.count == 3 { INFO@mark `RR83 a ray expanded is not the three it is in` }
unless b.complement.count == 2 { INFO@mark `RR84 what is around a ray is not the other two` }

// Boundaries and edges
unless a.initial.is_initial { INFO@mark `R12 initial boundary is not initial` }
unless a.terminal.edge.is_terminal { INFO@mark `R13 the edge of a terminal boundary is not terminal` }
unless b.⊢ == b.initial { INFO@mark `RA5 ⊢ is not initial` }
unless b.⊣ == b.terminal { INFO@mark `RA6 ⊣ is not terminal` }
unless b.⊢.∙ == b { INFO@mark `RA1 ⊢ of a ray is not a boundary at that ray` }
unless b.⊣.∙ == b { INFO@mark `RA2 ⊣ of a ray is not a boundary at that ray` }
start := Boundary.Initial()
finish := Boundary.Terminal()
unless start.is_initial { INFO@mark `R15 an initial boundary is not initial` }
if start.is_terminal { INFO@mark `R16 an initial boundary is terminal` }
unless finish.is_terminal { INFO@mark `R17 a terminal boundary is not terminal` }
if finish.is_initial { INFO@mark `R18 a terminal boundary is initial` }
span := Edge(x: (initial: start, terminal: finish))
unless span.x.initial { INFO@mark `R19 an edge forgot where it starts` }
unless span.x.terminal { INFO@mark `R20 an edge forgot where it ends` }
if span.is_initial { INFO@mark `R21 an edge that starts somewhere is initial` }
if span.is_terminal { INFO@mark `R22 an edge that ends somewhere is terminal` }

// What a structure allows
if Structure.HyperEdges { INFO@mark `R24 a plain structure has hyper edges` }
unless Hypergraph.HyperEdges { INFO@mark `R25 a hypergraph has no hyper edges` }
if Structure.HyperContinuations { INFO@mark `RR70 a plain structure branches` }
unless Graph.HyperContinuations { INFO@mark `RR71 a graph does not branch` }
unless Forest.HyperContinuations { INFO@mark `RR72 a forest does not branch` }
if Path.HyperContinuations { INFO@mark `RR73 a path branches` }
unless Array().acyclic { INFO@mark `RR74 an array comes back around` }

// A list: what it holds, in the order it was given
unless [].count == 0 { INFO@mark `R26 an empty list counts other than zero` }
unless [].empty { INFO@mark `R27 an empty list is not empty` }
if [].first { INFO@mark `R28 an empty list has a first` }
unless [1].count == 1 { INFO@mark `R29 one thing kept does not count one` }
unless [1].nonempty { INFO@mark `R30 a list holding something is empty` }
unless [1].first == 1 { INFO@mark `R31 the first does not hold what was given` }
unless [1].last == 1 { INFO@mark `R32 the last does not hold the only thing` }

threes := [1, 2, 3]
unless threes.count == 3 { INFO@mark `R33 three things kept do not count three` }
unless threes.first == 1 { INFO@mark `R34 the first is not the first thing given` }
unless threes.last == 3 { INFO@mark `R35 the last is not the last thing given` }
unless threes[0] == 1 { INFO@mark `R36 the one at nought is not the first thing given` }
unless threes[-1] == 3 { INFO@mark `R37 the one at minus one is not the last thing given` }
unless threes[1] == 2 { INFO@mark `R38 the one after the first is not the second thing given` }
unless [1, None, 2].count == 3 { INFO@mark `R41 a list does not keep what holds nothing` }
unless ([1] * 40).count == 40 { INFO@mark `RR42 forty things kept do not count forty` }
unless ([1] * 40).sum == 40 { INFO@mark `RR43 walking forty things does not reach forty` }

unless threes.every(.nonzero) { INFO@mark `RR44 not every one of one, two and three is something` }
if threes.every(== 1) { INFO@mark `RR45 every one of them is one` }
unless threes.some(== 2) { INFO@mark `RR46 none of them is two` }
if threes.some(== 6) { INFO@mark `RR47 one of them is six` }
unless threes[2] == 3 { INFO@mark `RR49 the one two along is not the third` }
unless threes.bounded { INFO@mark `RR51 a list of three is not bounded` }
if threes.unbounded { INFO@mark `RR52 a list of three is unbounded` }
unless threes.connected { INFO@mark `RR53 a list is not connected` }
unless threes.consistent { INFO@mark `RR54 a list is not consistent` }
unless threes.acyclic { INFO@mark `RR55 a list of three comes back around` }
unless threes.length == 3 { INFO@mark `RR56 a list is not as long as it counts` }
if threes.undirected { INFO@mark `RR57 a list is undirected` }
if threes.unidirectional { INFO@mark `RR81 a list points only one way` }
unless threes.entry == 1 { INFO@mark `RR59 what a list is entered at is not its first` }
unless threes.sum == 6 { INFO@mark `RR60 one, two and three do not add to six` }
unless threes.product == 6 { INFO@mark `RR61 one, two and three do not multiply to six` }
unless Σ threes == 6 { INFO@mark `RR62 the sum sign does not add them` }
unless ∏ threes == 6 { INFO@mark `RR63 the product sign does not multiply them` }
unless [1, None, 2].compact.count == 2 { INFO@mark `RR65 what is left of a list with a gap is other than two` }
unless threes.compact.count == 3 { INFO@mark `RR66 a list with no gaps loses something` }
unless threes.paths.count == 3 { INFO@mark `RR67 the paths through a list are not the list` }
unless threes.all { INFO@mark `RR68 all of a list is nothing` }
unless [1, 2].fill(3).every(== 3) { INFO@mark `RR69 a filled list does not hold what it was filled with` }
unless [1, 2].first.is_first { INFO@mark `RR75 the first of a list is not first` }
if [1, 2].first.is_last { INFO@mark `RR76 the first of a list of two is last` }
unless [1, 2].last.is_last { INFO@mark `RR77 the last of a list is not last` }
unless Traverser.default == Traverser.DepthFirst { INFO@mark `RR78 what a walk does by default is not depth-first` }
if Traverser.default == Traverser.BreadthFirst { INFO@mark `RR79 what a walk does by default is breadth-first` }

pair := 1, 2
unless [1].count == 1 { INFO@mark `BR1 a bracketed one does not hold one element` }
unless pair.count == 2 { INFO@mark `BR3 a pair written with a comma does not hold two` }
unless (1) == 1 { INFO@mark `BR4 a grouped one is not one` }
unless [pair].count == 1 { INFO@mark `BR5 brackets do not hold a list as one element` }
unless [pair].first.count == 2 { INFO@mark `BR6 the bracketed list is not the pair` }
unless ([pair], 3).count == 2 { INFO@mark `BR7 a bracketed list written first is flattened` }
unless (pair, 3).count == 3 { INFO@mark `BR8 a list written first is not flattened` }
unless ((1, 2)).count == 2 { INFO@mark `BR9 a grouped pair in parentheses nests` }
unless pair.count == 2 { INFO@mark `BR10 writing a list into another changed it` }

// What a list answers as a whole
unless threes.map(. * 2) == [2, 4, 6] { INFO@mark `IT2 one, two and three doubled are not two, four and six` }
unless threes.map(. * 2).first == 2 { INFO@mark `IT3 the first doubled is not two` }
unless threes.map(. * 2).last == 6 { INFO@mark `IT4 the last doubled is not six` }
unless threes.reverse == [3, 2, 1] { INFO@mark `IT5 turned around, one, two and three are not three, two and one` }
unless threes.reverse.count == 3 { INFO@mark `IT7 turning a list around loses something` }
unless threes.contains(2) { INFO@mark `IT8 a list does not contain what it was given` }
if threes.contains(5) { INFO@mark `IT9 a list contains what it was never given` }
unless threes.includes(3) { INFO@mark `IT10 includes is not contains` }

repeated := [1, 2, 1]
unless repeated.unique.count == 2 { INFO@mark `IT11 each thing once is not two` }
unless repeated.unique == [1, 2] { INFO@mark `IT12 each thing once is not in the order first seen` }
unless threes.partition(. < 2).count == 2 { INFO@mark `IT13 a partition is not in two` }
unless threes.partition(. < 2).first == [1] { INFO@mark `IT14 what holds is not only the one` }
unless threes.partition(. < 2).last == [2, 3] { INFO@mark `IT15 what is left is not the other two` }
unless threes.chunk(2).count == 2 { INFO@mark `IT16 three in runs of two are not two runs` }
unless threes.chunk(2).first == [1, 2] { INFO@mark `IT17 the first run is not one and two` }
unless threes.chunk(2).last == [3] { INFO@mark `IT18 the last run does not hold what is left` }
unless threes.batch(3).count == 1 { INFO@mark `IT19 a batch of all of it is not one` }
unless threes.chunk(2).flatten == threes { INFO@mark `IT20 the runs flattened are not the three, in order` }
unless threes.flatten.count == 3 { INFO@mark `IT22 flattening numbers splices what they are made of` }

nested := [[1, [2, [3]]]]
unless nested.flatten == [1, 2, 3] { INFO@mark `RL1 flattening three levels does not leave one, two and three` }
unless nested.flatten(1).count == 2 { INFO@mark `RL4 flatten one level does not leave one and the rest` }
unless nested.flatten(1).last.count == 2 { INFO@mark `RL5 flatten one level flattens further than one` }
unless nested.flatten(2).count == 3 { INFO@mark `RL6 flatten two levels does not leave one, two and what is left` }
unless nested.flatten(2).last == [3] { INFO@mark `RL7 flatten two levels does not leave the third level unspliced` }
unless nested.flatten(0).count == 1 { INFO@mark `RL8 flatten none changes the count` }
unless threes.flatten(3).count == 3 { INFO@mark `RL9 flatten levels on numbers splices what they are made of` }

unless [3, 1, 2].min == 1 { INFO@mark `MIN1 the smallest of three, one and two is not one` }
unless [3, 1, 2].max == 3 { INFO@mark `MIN2 the largest of three, one and two is not three` }
unless threes.min == 1 { INFO@mark `MIN3 the smallest of one, two and three is not one` }
unless threes.max == 3 { INFO@mark `MIN4 the largest of one, two and three is not three` }
unless [0, 5].min.is_zero { INFO@mark `MIN5 the smallest of zero and five is not zero` }
unless [0, 5].max == 5 { INFO@mark `MIN6 the largest of zero and five is not five` }
unless repeated.min == 1 { INFO@mark `RM7 the smallest with a repeat is not one` }
unless 5.min(3) == 3 { INFO@mark `RM8 the smaller of five and three is not three` }
unless 5.max(3) == 5 { INFO@mark `RM9 the larger of five and three is not five` }

unless (threes * 2).count == 6 { INFO@mark `RX1 a list of three twice is not six` }
unless (threes * 2) == [1, 2, 3, 1, 2, 3] { INFO@mark `RX4 the repeated list does not start over after three` }
unless (threes * 0).empty { INFO@mark `RX5 a list none times is not empty` }
unless threes * 1 == threes { INFO@mark `RX6 a list once is not itself` }
unless threes.count == 3 { INFO@mark `RX7 repeating a list changed it` }
unless "ab" * 3 == "ababab" { INFO@mark `RX8 ab three times is not ababab` }
unless ("ab" * 0).empty { INFO@mark `RX9 ab none times is not empty` }

unless threes.intersection(repeated).count == 2 { INFO@mark `IT23 what both hold is not one and two` }
if threes.disjoint(repeated) { INFO@mark `IT24 two lists with one in common are disjoint` }
if threes.map(. * 2).disjoint(repeated) { INFO@mark `IT25 lists sharing a two are disjoint` }
unless threes.symmetric_difference(repeated) == [3] { INFO@mark `IT26 what only one of them holds is not three alone` }
unless threes.xor(repeated) == [3] { INFO@mark `IT61 xor is not the symmetric difference` }
unless [1, 2].zip([3, 4]).count == 2 { INFO@mark `IT62 two zipped with two are not two pairs` }
unless threes.take(2) == [1, 2] { INFO@mark `IT63 the first two taken are not one and two` }
unless threes.find(. > 1) == 2 { INFO@mark `IT64 the first past one is not two` }
unless [1, 1, 2].squeeze == [1, 2] { INFO@mark `IT65 a repeat next to itself is not squeezed out` }
unless threes.enumerate.last.index == 2 { INFO@mark `IT66 the last of three is not numbered two` }

unless threes is Path { INFO@mark `IT27 a list is not a path` }
unless threes is Array { INFO@mark `IT28 a list is not an array` }
unless threes is Iterable { INFO@mark `IT29 a list is not iterable` }
unless threes.first is Ray { INFO@mark `IT30 an element is not a ray` }
unless 1 is Ray { INFO@mark `IT33 a number is not a ray` }

// Ends gained and lost, and order
ends := [2].push_back(3).push_front(1)
unless ends == [1, 2, 3] { INFO@mark `IT35 pushing onto both ends does not give one, two and three` }
unless ends.first == 1 { INFO@mark `IT36 what was pushed in front is not first` }
unless ends.last == 3 { INFO@mark `IT37 what was pushed at the back is not last` }
unless ends.pop_front == 1 { INFO@mark `IT38 popping the front does not give the first` }
unless ends.pop_back == 3 { INFO@mark `IT39 popping the back does not give the last` }
unless ends.count == 1 { INFO@mark `IT40 two popped off three do not leave one` }
unknown_end := [1].push_back()
unless unknown_end.count == 2 { INFO@mark `FWP1 pushing nothing does not make the array one longer` }
unless unknown_end.last is Unknown { INFO@mark `FWP2 what pushing nothing adds is not unknown` }
unless ends.first == 2 { INFO@mark `IT41 what is left is not the middle` }
unless ends == [2] { INFO@mark `IT42 the one left is not all there is` }
unless [1, 2, 3].remove(1) == [2, 3] { INFO@mark `IT69 removing the first does not leave the other two` }
unless [1, 2, 3].remove(3) == [1, 2] { INFO@mark `IT70 removing the last does not leave the other two` }
unless [1, 2, 3].remove(1).remove(3) == [2] { INFO@mark `IT71 removing both ends does not leave the middle` }

walked := 0
a.for(x => walked += 1)
unless walked == 3 { INFO@mark `R39 walking a ray of three does not visit three` }
total := 0
[1, 2, 3].for(x => total += x)
unless total == 6 { INFO@mark `R40 walking one, two and three does not add to six` }
reached := 0
threes.for<Traverser.BreadthFirst>(x => reached += 1)
unless reached == 3 { INFO@mark `RR80 walking three things breadth-first does not reach three` }
unless [3, 1, 2].sort == [1, 2, 3] { INFO@mark `IT43 sorted, three, one and two are not one, two and three` }
unless [3, 1, 2].sort.last == 3 { INFO@mark `IT44 sorted, the last is not the largest` }
unless [3, 1, 2].sort_by(10 - .) == [3, 2, 1] { INFO@mark `IT67 sorted by what they are short of ten, they are not largest first` }

held_once := [1, 2, 1] as Set
unless held_once.count == 2 { INFO@mark `IT46 a set holds one thing twice` }
unless held_once.contains(2) { INFO@mark `IT47 a set does not hold what was added` }
unless held_once == [2, 1] as Set { INFO@mark `IT48 two sets holding the same differ by order` }
if held_once == [1] as Set { INFO@mark `IT49 a set is the same as one holding less` }

root_place := Hierarchy()
inner_place := Hierarchy(parent: root_place)
unless inner_place.parent == root_place { INFO@mark `IT50 what is held does not know what holds it` }
unless root_place.children.count == 1 { INFO@mark `IT51 what holds does not hold one` }
unless inner_place.depth == 1 { INFO@mark `IT52 what is held once is not one deep` }
unless root_place.depth == 0 { INFO@mark `IT53 what holds everything is deeper than nothing` }
unless root_place.holds(inner_place) { INFO@mark `IT60 what holds does not hold what it holds` }

// An orbit comes back to its first, and has no end
unless [1, 2].orbit[..<5] == [1, 2, 1, 2, 1] { INFO@mark `IT54 five steps round two are not one, two, one, two, one` }
unless [1, 2].orbit[3] == 2 { INFO@mark `IT56 the fourth step round two is not the second` }
if [1, 2].orbit.bounded { INFO@mark `IT57 an orbit is bounded` }
if [1, 2].orbit.acyclic { INFO@mark `IT58 an orbit does not come back around` }
unless [1, 2].orbit.previous == 2 { INFO@mark `IT59 before the first of an orbit is not the last` }
unless [1, 2].orbit.unrolled == [1, 2] { INFO@mark `IT68 an orbit unrolled is not what it goes around` }

// Ranges
unless (1..3) == [1, 2, 3] { INFO@mark `RQ1 one to three is not one, two and three` }
unless (1..3).first == 1 { INFO@mark `RQ2 one to three does not start at one` }
unless (1..3).last == 3 { INFO@mark `RQ3 one to three does not end at three` }
unless (1..<3) == [1, 2] { INFO@mark `RQ4 one up to three is not one and two` }
unless (3..1) == [3, 2, 1] { INFO@mark `RQ6 three down to one does not pass two` }
unless (0..2..1).count == 4 { INFO@mark `RQ7 zero to two through to one is not four steps` }
unless (0..2..1).last == 1 { INFO@mark `RQ8 zero to two through to one does not end at one` }
unless (2..<2).empty { INFO@mark `RQ9 two up to two holds something` }
unless (a..c)[1] === b { INFO@mark `RQ10 the path from the first ray to the third does not pass the second` }
unless (a..c).last === c { INFO@mark `RQ11 the path from the first ray to the third does not end there` }
if c..a { INFO@mark `RQ12 a path runs against the direction of its rays` }

// Reducing
unless threes.reduce((acc) => acc + .) == 6 { INFO@mark `RD1 one, two, three summed through the accumulator are not six` }
unless threes.reduce(acc = 0 => acc + 1) == 3 { INFO@mark `RD2 counting from a given start does not reach three` }
unless threes.reduce(acc = 10 => acc + .) == 16 { INFO@mark `RD3 a given start is not where the sum begins` }
unless threes.reduce(+) == 6 { INFO@mark `RD4 a lone operator does not reduce` }
unless threes.reduce(*) == 6 { INFO@mark `RD5 a product through a lone operator is not six` }
if [].reduce(+) { INFO@mark `RD6 reducing nothing answers something` }

closed := Ray()
kept := closed ~~ (
  .next = a
  .previous = c
)
unless kept === closed { INFO@mark `RD7 ~~ does not answer the value it was given` }
unless closed.next === a { INFO@mark `RD8 . inside ~~ is not the value` }
unless closed.previous === c { INFO@mark `RD9 the second line of a ~~ block did not run on the value` }

// `,` and `|` take a function of the element before them (R3.8, A2)
unless (1, +2, +3, +4) == (1, 3, 6, 10) { INFO@mark `CL1 a section after , is not applied to the element before it` }
unless (1 | +2 | +3) == (1 | 3 | 6) { INFO@mark `CL2 a section after | is not applied to the value before it` }
unless (2, *5) == (2, 10) { INFO@mark `CL3 *5 after , does not multiply the element before it` }

// `->` and `<-` step from a value again and again (A2, L§5.2)
unless (0 -> +2)[4] == 8 { INFO@mark `AR1 the fifth step of 0 -> +2 is not 8` }
unless (0 -> 1)[3] == 3 { INFO@mark `AR2 a number as a step is not added` }
both_ways := -1 <- 0 -> +1
unless both_ways.next == 1 { INFO@mark `AR3 -> on a two-way line does not step forward` }
unless both_ways.previous == -1 { INFO@mark `AR4 <- on a two-way line does not step back` }
unless both_ways.next.previous == 0 { INFO@mark `AR5 a step forward and back is not where it started` }
unless (0 -> +1)[{< 3}][2] == 2 { INFO@mark `AR6 an unbounded line cannot be filtered by its entries` }
unless (0 ->)[5] == 5 { INFO@mark `AR7 x -> alone does not count on by one` }

// Open ranges and slices (R4.1, L§1.6)
letters := ["a", "b", "c", "d"]
unless letters[..<2] == ["a", "b"] { INFO@mark `SL1 ..<2 does not take the first two` }
unless letters[..2] == ["a", "b", "c"] { INFO@mark `SL7 ..2 does not include its end` }
unless letters[1..] == ["b", "c", "d"] { INFO@mark `SL2 1.. does not take from the second on` }
unless letters[..<-1] == ["a", "b", "c"] { INFO@mark `SL3 ..<-1 does not leave out the last` }
unless letters[1..<3] == ["b", "c"] { INFO@mark `SL4 1..<3 does not take the second and third` }
unless letters[1..2] == ["b", "c"] { INFO@mark `SL5 1..2 does not take both ends` }
unless letters[-2..] == ["c", "d"] { INFO@mark `SL6 a negative start does not count from the end` }
zeros := [1, 1, 1, 1]
zeros[2..] = 0
unless zeros == [1, 1, 0, 0] { INFO@mark `SL7 assigning a slice does not put the value at each place` }
spread_over := [0, 0, 0]
spread_over[..<2] = [7, 8]
unless spread_over == [7, 8, 0] { INFO@mark `SL8 assigning as many as the places does not spread them` }
unless (5..)[2] == 7 { INFO@mark `OR1 5.. does not go on from five` }
unless (..5).previous == 4 { INFO@mark `OR2 ..5 does not come down to five` }
unless [1, 5, 20][{< 10}] == [1, 5] { INFO@mark `OR3 xs[{p}] does not keep the entries p holds of` }

// `...` spreads; destructuring (A5, T3.14, T4.8)
first, ...middle, last := "A", "B", "C", "D"
unless middle == ("B", "C") { INFO@mark `SD1 ...middle does not take what is between` }
unless last == "D" { INFO@mark `SD2 the name after a spread does not take the last` }
unless ("A", "A") is ...String { INFO@mark `SD3 ...T is not T[]` }
Clock := class {
  now => 12
  zone => 1
}
{ now, zone } = Clock
unless now == 12 && zone == 1 { INFO@mark `SD4 { a, b } = x does not take the members named a and b` }
swap_a := 1
swap_b := 2
(swap_a, swap_b) = (swap_b, swap_a)
unless swap_a == 2 && swap_b == 1 { INFO@mark `SD5 (a, b) = pair does not assign each in turn` }

// `.min(key)`, `.max(key)` along a function of the entries (R3.10)
unless ["ccc", "a", "bb"].min(.count) == "a" { INFO@mark `MK1 min along a key does not pick the smallest by it` }
unless ["ccc", "a", "bb"].max(.count) == "ccc" { INFO@mark `MK2 max along a key does not pick the largest by it` }
unless 2.min(5) == 2 { INFO@mark `MK3 min of a value is no longer the smaller of the two` }
unless ["ab", "c", "de"].max(.count)#.first == "ab" { INFO@mark `FWT2 the first of the tied longest is not the leftmost` }
unless ["ab", "c", "de"].max(.count)#.last == "de" { INFO@mark `FWT3 the last of the tied longest is not the rightmost` }

// `split` keeps its delimiters as the edges between the pieces (R3.16)
unless "a,b,c".split(",") == ["a", "b", "c"] { INFO@mark `SQ1 a,b,c split at its commas is not a, b, c` }
unless "a,b,c".split(",").count == 3 { INFO@mark `SQ2 the delimiters are counted among the pieces` }
unless "a,b,c".split(",").first.⊣.⊙ == "," { INFO@mark `SQ3 the edge after a piece is not the delimiter it was split at` }
unless "abc".split(",") == ["abc"] { INFO@mark `SQ4 text without the delimiter is not one piece` }

// `group_by` answers a map from each key to what has it (R3.17)
grouped := [1, 2, 3, 4, 5].group_by(. % 2)
unless grouped[1] == [1, 3, 5] { INFO@mark `GY1 the odd numbers are not grouped under one` }
unless grouped[0] == [2, 4] { INFO@mark `GY2 the even numbers are not grouped under zero` }
unless ["a", "bb", "cc"].group_by(.count)[2] == ["bb", "cc"] { INFO@mark `GY3 two words of one length are not grouped together` }
if ["a"].group_by(.count)[2] { INFO@mark `GY4 a key nothing has holds something` }

// `==` up to a boundary, and with exceptions (U9.1)
unless [1, 2, 0, 3] ==<up_to: 0> [1, 2, 0, 4] { INFO@mark `EQ1 two lists alike up to a boundary are not equal up to it` }
if [1, 2, 0, 3] ==<up_to: 0> [1, 5, 0, 3] { INFO@mark `EQ2 lists that differ before the boundary are equal up to it` }
unless [1, 2, 3] ==<except: [2]> [1, 3] { INFO@mark `EQ3 an exempt element still counts` }
if [1, 2, 3] ==<except: [2]> [1, 4, 3] { INFO@mark `EQ4 an exception excuses an element that is not exempt` }
unless [1, 2] == [1, 2] { INFO@mark `EQ5 equality without options is no longer structural` }

// Rotating is shifting bits arranged in a loop: what leaves one end comes back at the other.
unless ((₂10010011 as Binary₈).loop << 1) as Binary₈ == ₂00100111 { INFO@mark `ROT1 shifting a loop left does not bring the leftmost bit back on the right` }
unless ((₂10010011 as Binary₈).loop >> 1) as Binary₈ == ₂11001001 { INFO@mark `ROT2 shifting a loop right does not bring the rightmost bit back on the left` }
unless ((₂10010011 as Binary₈).loop << 8) as Binary₈ == ₂10010011 { INFO@mark `ROT3 a whole turn of a loop changes it` }
