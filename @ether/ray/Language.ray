Language := class: Ray (extensions: String, level: Compiler?, written: Compiler?, stored: Compiler?, of: Language?, targets: Language[] = []) => {
  static loaded_named (extension: String) => Language#{.names(extension)} -- (all => all{!.of}.first ?? all.first)
  static named (extension: String) => Language.loaded_named(extension) ?? (Project.declared.find(.project && Language.loaded_named(extension)) && Language.loaded_named(extension))
  static over (outer: Language, base: Language) => Language(outer.extensions, level: base.level + outer.level, written: base.written + outer.written, of: base) @ outer.location
  // LNG1 a language over another is not of that other language, with the outer extensions
  assert Language.over(Language.cfg, Language.ray).(
    .of === Language.ray  // LNG2 a language over another is not of it
    & .extensions == ".cfg"  // LNG3 a language over another loses its own extensions
    & !(.extensions == ".ray")  // LNG4 a language over another takes the extensions of the base
  )

  // (no file, a statement read where none is: Ray)
  static for_file (file_name: String?) => (file_name === None) ? Language.ray : file_name ~= (*, ".", inner: Char.Word[], ".ray") ⊣
    ? (Language.named("." + inner) ? Language.over(Language.named("." + inner), Language.ray) : Language.ray)
    : Language.named("." + (file_name ~= (*, ".", last: Char.Word[]) ⊣).last) ?? Language.ray
  assert Language.for_file("main.ray") === Language.ray  // LNG5 a plain Ray file is not read as Ray
  assert Language.for_file("notes.nothing-has-this") === Language.ray  // LNG6 a file named by an extension no language has is not read as Ray
  assert Language.for_file("settings.cfg.ray").of === Language.ray  // LNG7 a Ray file written in a sublanguage (`name.cfg.ray`) is not read in that sublanguage over Ray
  assert Language.for_file("settings.cfg").extensions == ".cfg"  // LNG8 a file ending in a language's extension is not read in that language

  static detected (content: String) => Language#{.level && !.read(content).erred}
  // A language is recognised by the readings that accept the text (L§9.1.2)
  assert Language.detected("x := 1").contains(Language.ray)  // FWP4 Ray text is not recognised as Ray

  static project (name: String) => Project#{.name == name}.first
    ?? Project.known(Language.ray.bundled("$/" + name)) -- (found => found ~~ (.name = name) ~~ .load if found)
  assert Language.project("web").loaded  // PJ2 a language in a mutual dependency is not loaded

  static Lossless := Language{forall value is *#: .read(.write(value)) == value}
  assert Language.ray is Language.Lossless  // LNG9 Ray is not lossless: writing a value and reading it back does not give the value
  assert !(Language(".nothing") is Language.Lossless)  // LNG10 a language with no writer is lossless

  static Writing := class (value: *, language: Language?) => { }
  assert Language.Writing(5, language: Language.ray).value == 5  // LNG11 a writing does not hold the value it wraps
  assert Language.Writing(5, language: Language.ray).language === Language.ray  // LNG12 a writing does not hold the language it writes in
  static unwrapped := {
    {writing: Language.Writing} => writing.value
  }
  assert Compiler.reduced(Language.Writing(5), Language.unwrapped) == 5  // LNG13 unwrapping a writing does not give the wrapped value
  static ray_written := {
    {writing: Language.Writing{.value === None}} => "None"
    {writing: Language.Writing{.value is Number}} => writing.value as String
    {writing: Language.Writing{.value is String}} => "\"", writing.value.escaped_line, "\""
    {writing: Language.Writing{.value is Iterable}} => "[", writing.value.map((", " if .index > 0), Language.Writing(.)), "]"
    {writing: Language.Writing} => "(", writing.value.fields.map((", " if .index > 0), .name, ": ", Language.Writing(.value)), ")"
  }
  assert Language.ray.write(None) == "None"  // LNG14 None is not written as "None"
  assert Language.ray.write(42) == "42"  // LNG15 a number is not written as its digits
  assert Language.ray.write("a") == "\"a\""  // LNG16 a string is not written in quotes
  assert Language.ray.write("a\"b") == "\"a\\\"b\""  // LNG17 a string with a quote or a backslash is not escaped
  assert Language.ray.write([1, 2, 3]) == "[1, 2, 3]"  // LNG18 a list is not written in brackets, its elements separated by ", "
  assert Language.ray.write([]) == "[]"  // LNG19 an empty list is not written as "[]"
  assert Language.ray.write(["a", "b"]) == "[\"a\", \"b\"]"  // LNG20 a list of strings is not written element by element
  assert Language.ray.write((a: 1, b: 2)) == "(a: 1, b: 2)"  // LNG21 a value with fields is not written as the parenthesised fields

  // (a value whose class has a header: written by that header, its positions in order as the entrypoint's `written` gives
  // them, a field what the value holds, a text written among them itself; a group of them, `(…)?`, not yet: written by its
  // header read backwards, spec/TODO.md)
  static header_written (value) => Language.positions_written(value.written.head)
  static positions_written (at) => at ? (((at.value === Node) ? "" : Language.part_written(at.value)) + Language.positions_written(at.next)) : ""
  assert {
    Numbered := class ("#", number: Decimal, ("'", revision: Decimal)?) => { }
    assert (Numbered(number: 3, revision: 2) as String) == "#3'2"  // LNG22 a value is not written by walking the pattern in its class's header
    assert (Numbered(number: 3) as String) == "#3"  // LNG23 an optional part is written when it is not held
  }
  // (what the writer gave: text, or pieces of text in order, each joined)
  static joined (x) => x.listing ? Language.pieces_joined(x.head) : ((x is String) ? x : Language.part_written(x))
  assert Language.joined("ab") == "ab"  // LNG24 a text the writer gave is not kept as it is
  assert Language.joined(["a", "b", "c"]) == "abc"  // LNG25 pieces of text in order are not joined
  assert Language.joined(["a", ["b", "c"], "d"]) == "abcd"  // LNG26 a nested list of pieces is not joined in order
  static pieces_joined (at) => at ? (Language.joined(at.value) + Language.pieces_joined(at.next)) : ""
  static headed (x) => (x.of !== None) && ((x.of).header_quoted !== None)
  static part_written (x) => x === None ? "" : ((x is Number) ? (x.int32.digits ?? (x as String)) : (((x is Iterable) && x.empty) ? "" : (x is String ? x : (Language.headed(x) ? Language.header_written(x) : "" + x))))
  assert Language.part_written(None) == ""  // LNG27 nothing is not written as no text
  assert Language.part_written(7) == "7"  // LNG28 a number is not written as its digits
  assert Language.part_written([]) == ""  // LNG29 an empty list is not written as no text
  assert Language.part_written("x") == "x"  // LNG30 a string is not written as itself

  names (extension: String) => extension is .extensions#
  assert Language.ray.names(".ray")  // LNG31 a language does not name its own extension
  assert !Language.ray.names(".nothing-has-this")  // LNG32 a language names an extension that is not its own
  bundled (path: String) => .location#.map(. / path){(. / ".project.ray").held as boolean}.first.held as Project
  // A project and a language it bundles may depend on each other; each is loaded once
  assert (Project.known(Language.ray.bundled("ui")).load).(
    .loaded && !.loading  // PJ1 a project bundling a language that depends back on it does not finish loading
    & Language.project("web").installed.some(=== .)  // PJ3 a mutual dependency loads a second copy of the project it comes back to
  )

  admits (program) => true
  assert Language.ray.admits(Program(code: "1"))  // LNG33 a language does not admit a program by default
  read (source) => .level
    ? (Compiler.reduced(source, .level + (.stored ?? Compiler.none)) -- (this.admits(.) ? . : ERROR `this file is written in a sublanguage that does not permit what it does`))
    : ERROR@Language `the language has no reader`
  write (value) => .written
    ? (Compiler.reduced(Language.Writing(value, language: this), Language.unwrapped + .written + (.stored ?? Compiler.none)) -- (result => result is Location ? result : Language.joined(result)))
    : ERROR@Language `the language has no writer`
  written_to (value, location: Location) => .write(value) -- (. is Location ? .files.for(file => (location / file.path).held = file.content) : location.held = .) -- location

  targeting (language: Language) => language is .targets#
  assert Language(".x", targets: [Language.ray]).targeting(Language.ray)  // LNG35 a language does not target the languages it lists
  assert !Language(".y").targeting(Language.ray)  // LNG36 a language targets a language it does not list

  static ray: .Lossless = (Language(".ray", level: Compiler.default, written: Language.ray_written) @ (@ether/ray | @ether))
  static cfg := Language(".cfg", level: Language.ray.level, written: Language.ray.written, of: Language.ray){admits Program{Pure & Terminating}}
  assert Language.cfg.of === Language.ray  // LNG37 the configuration language is not over Ray
  assert Language.cfg.extensions == ".cfg"  // LNG38 the configuration language does not use the extension ".cfg"
}

Node &+= {
  as (language: Language) => language.write(this)
}
assert (5 as Language.ray) == "5"  // LNG44 a value is not written as text in a language it is converted to
assert ([1, 2] as Language.ray) == "[1, 2]"  // LNG45 a list is not written in the language's notation

// (what the bootstrap leaves to this file: it needs what is here)
Node &+= {
  // (written by its class's header when it has one, else in the language of the file asking)
  as (=== String) => Language.headed(this) ? Language.part_written(this) : (Language.for_file(&.caller.location.name) ?? Language.ray).write(this)
}
LanguageName := String{Language.named("." + .) != None}
@{extension: LanguageName}`{code ^string}` ^string.punctuation => Language.named("." + extension).read(code)
@{extension: LanguageName} {code} => Compiler.reduced(code, Language.named("." + extension).level)
assert @ray`1 + 2` == 3  // TL1 a literal tagged ray is not read as Ray
