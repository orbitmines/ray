@ether/encryption
@ether/random
@ed25519
@x25519
@noise
@sha256
@chacha20poly1305
@hpke
@ether/version-control
@uuid
@ether/time

Identity := class (keys: Key[], next: Byte[][] = [], digest = Identity.algorithms.digest, signing = Identity.algorithms.signing, agreement = Identity.algorithms.agreement, handshake = Identity.algorithms.handshake, wrapping = Identity.algorithms.wrapping, cipher = Identity.algorithms.cipher, printed_key: Key?, guardians: *[] = [@ether], certificates: Identity.Certificate[] = [], vetoed: Byte[][] = [], revoke: Identity.Threshold = 1 of keys, add: Identity.Threshold = (2 min keys.count) of keys, rotate: Identity.Threshold = (2 min keys.count) of [keys, next].flatten, recover: Identity.Threshold = 2 of [printed_key, guardians].flatten.compact after 7 days vetoable by 1 of keys) => {

  static algorithms := (signing: Ed25519, agreement: X25519, handshake: Noise, digest: SHA256, wrapping: HPKE, cipher: ChaCha20Poly1305)

  static Threshold := class (count: Number, signers: *[], wait: Quantity.Temporal = 0 seconds, veto: Identity.Threshold?) => {
    met (event: History.Commit, identity: Identity) => event.signature#{event.covers(.) && identity.counts(.by, this.signers, event.stamp)}.map(.by).unique.count >= .count
  }

  static Certificate := class (key: Key, until: Time = Time.now + 30 days, scope: * = *, world: World?) => {
    expiring (at: Time = Time.now) => at + 1 day >= .until
  }

  rules => (.next, .digest, .signing, .agreement, .handshake, .wrapping, .cipher, .printed_key, .guardians, .revoke, .add, .rotate, .recover)
  counts (by: Key, signers: *[], at: Stamp) => signers.some(signer => signer is Key ? signer == by
    : signer is Byte[] ? signer == (by.public as this.digest).digest
    : signer.certified(by, at))

  // What a key event needs: only removing is a revocation, only adding an addition; anything else is a rotation.
  threshold (after: Identity) => after.rules != .rules ? .rotate
    : after.keys.every(this.keys.contains(.)) && after.certificates.every(this.certificates.contains(.)) ? .revoke
    : .keys.every(after.keys.contains(.)) && .certificates.every(after.certificates.contains(.)) ? .add
    : .rotate

  vetoes (event: History.Commit, log: History, at: Stamp?) => .recover.veto && log.ordered{event.stamp < .stamp && (at === None || .stamp < at)}
    .some(veto => this.recover.veto.met(veto, this) && (this.copy -- veto.change).vetoed.contains(event.hash))
    assert {
      with Program.kept = 0 seconds {
        assert !(Program.recent.some(=== Program.runs.head))  // HG5 a run older than the configured window is kept for replay
      }
    }
  recovered (event: History.Commit, log: History, at: Stamp?) => .recover.met(event, this)
    && (at.when ?? World.ether.clock.now.when) >= event.when + .recover.wait && !.vetoes(event, log, at)
  allows (event: History.Commit, log: History, at: Stamp? = None) => .threshold(this.copy -- event.change) -- (needed =>
    needed.met(event, this) || needed === .rotate && .recovered(event, log, at))

  static logged (log: History, at: Stamp? = None) => log.ordered{at === None || .stamp < at}.reduce(held = None => . -- (event =>
    held === None ? (None -- event.change) -- (genesis => genesis.add.met(event, genesis) ? genesis : None)
    : held.allows(event, log, at) ? held.copy -- event.change : held))

  certifies (by: Key, at: Stamp, scope = *, world: World? = None) => by.algorithm === .signing
    && .certificates{.key == by && at.when < .until && scope is .scope && .world === world}.nonempty
  receives (key: Key, at: Stamp) => key.algorithm === .agreement && .certificates{.key == key && at.when < .until && .world === None}.nonempty
}

{count: Number} of {signers: *[]} ^keyword => Identity.Threshold(count, signers)
{threshold: Identity.Threshold} after {wait: Quantity.Temporal} ^keyword => threshold ~~ .wait = wait
{threshold: Identity.Threshold} vetoable by {veto: Identity.Threshold} ^keyword => threshold ~~ .veto = veto

// A delegation is bound to its holder: it names who may act on it (`to`, a character by its root, or any narrowing),
// and only that one, verified, acts on it (`Instance.delegated`); the signature covers `to`, so it cannot be renamed. Its
// scope is where it lets act: a narrowing of locations (`Location{.name == "()"}`, executing anything), everywhere unless
// given.
Delegation := class (from: Character, to: Accessor, scope: Location = Location, until: Time = Time.now + 1 day, signature: Signed?) => {
  hash => (((((this.from.root, this.to is Character ? this.to.root : this.to, this.scope, this.until)) as String) as Byte[]) as this.from.policy().digest).digest
  valid (at: Time = Time.now) => at < .until && .signature.valid && .signature.value == .hash && .from.certified(this.signature.by, World.ether.clock.now)
  covers (method, target) => .valid() && target.@?.at(method) is .scope
}

Verified := Character{.proof}
Live := Verified{!.proof.at && (!.proof.delegation || .proof.delegation.valid())}

Character &+= {
  local.write proof: (root: Byte[]?, by: Key?, at: Stamp?, session: *?, delegation: Delegation?)?
  identity: Identity?
  // Private keys are secrets (`none.read`, W2.1 Storage): no store writes them, and logging out zeroises and drops them.
  // A per-world key's entry is secret as a whole, since it holds the key; pseudonyms are derived from `key`, never kept.
  none.read roots: Key[] = []
  none.read world_keys: (world: World, key: Key)[] = []

  root => .identity.history.roots.first.hash
  policy (at: Stamp? = None) => .identity ? Identity.logged(this.identity.history, at) : None
  certified (by: Key, at: Stamp, world: World? = None) => .policy(at).certifies(by, at, world: world) ?? false
  key_in (world: World?) => (.world_keys ?? []){.world === world}.last.key ?? .key
  inboxes (at: Stamp = World.ether.clock.now) => .policy(at) -- (policy => policy ? policy.certificates{policy.receives(.key, at)}.map(.key) : [])
  pseudonym (root: History.Label) => .policy() -- (policy => Key.generated(policy.signing, (([this.key.secret, (root as String).bytes].flatten) as policy.digest).digest))

  // The same principal: by root, the one a proof carries when verified, else the key log's of one held here (named by a
  // grant, a delegation or a registry); never evidence on its own: only a verified one acts for it (`Verified`).
  chainable == (other) => this === other || other is Character && (.proof.root ?? .root) -- (mine => mine !== None && mine == (other.proof.root ?? other.root))
  as (=== boolean) => (this is Verified ? this : @local.verified(this)) == @me
  acting => this is Verified ? this : @local.verified(this) ?? ERROR@Access `a character acts only as verified by a handshake or a key held here`
  assert @"nowhere".acting is Diagnostic  // VER7 a character nobody holds here acts
  sealed (commit: History.Commit) => commit.who is Key ? commit ~~ (.signature = this.pseudonym(commit.line.id ?? commit.id).signed(.hash))
    : .key_in(commit.line.repository.world) -- (pair => commit ~~ (.relies = this.identity.history.head.hash) ~~ (.signature = pair.signed(.hash) if pair))
  delegate (to: Accessor, scope: Location = Location, until: Time = Time.now + 1 day) => Delegation(from: this, to, scope, until) -- (made => made ~~ .signature = this.key.signed(made.hash))

  // Recovering a lost root is a program run as the character (W2.1 Recovery handshake): its new root keys are made here,
  // each guardian is sent only the rotation event's hash, and the event is appended once the `recover` threshold of
  // their signatures, each bound to a session it was asked on, is met.
  recovery (sessions: Noise.Session[] = []) => (.roots = [Key.generated(.policy().signing), Key.generated(.policy().signing)]) -- (made => this.identity.history -- (log =>
    History.Commit(who: this, stamp: log.clock.now, change: Program(code: { .keys = made.map(.published) }), previous: log.head, line: log) -- (event =>
      Program(name: "recover", who: this, from: sessions, code: {
        sessions.for(.sent(event.hash))
        await Identity.logged(log) -- (policy => policy.recover.met(event, policy))
        log.extended(event)
      }): event)))
  // A guardian signs the hash only after verifying the person, by its own means.
  vouching (session: Noise.Session, message: Byte[]) => session.received(message) -- (hash =>
    Program(name: "verify the person recovering", who: this, code: { this.key.signed([hash, session.binding].flatten) }): hash)
}
assert !((@"a" == @"a") is Diagnostic)  // VER9 comparing characters errs with @ether/security imported

Program &+= {
  countersigned (signed: Signed): static => this ~~ (returns.signature |= signed
    if returns is History.Commit && returns.covers(signed) && from#.some(.binding == (signed.value as Byte[])[returns.hash.count..]))
}

// What security adds to a line: the key-log event it relies on, its signature, its content key with the wraps of it, and
// its ciphertext. Version control knows none of them (version does not import security).
History.Commit &+= {
  relies: Byte[]?
  signature: *?
  key: History.Label?
  wraps: *[] = []
  sealed: Byte[]?

  more_attributes => [(name: "relies", text: (this.relies as String)) if .relies, (name: "key", text: (this.key as String)) if .key,
    (name: "wraps", text: (this.wraps as String)) if .wraps.nonempty]
  more_settings => [(name: "signature", text: (this.signature as String)) if .signature]
  text => .sealed ? (this.sealed as String) : .change as String
  given (set, written: String) => this ~~ (.relies = set.relies) ~~ (.signature = set.signature) ~~ (.key = set.key) ~~ (.wraps = set.wraps ?? [])
    ~~ (set.key ? . ~~ (.sealed = (written as Program)) ~~ (.change = None) : .)
  rewritten (change: Program?) => .copy ~~ (.change = change) ~~ (.sealed = None unless change === this.change)

  covers (signed: Signed) => signed.valid && (signed.value as Byte[])[..<hash.count] == hash
  authentic => .who is Key ? .signature#.some(this.covers(.) && .by == this.who)
    : .who is Character && .who.identity.history.since(None).some(.hash == this.relies && !(this.stamp < .stamp))
    && .signature#.some(this.covers(.) && this.who.certified(.by, this.stamp))
  signer => .who is Key ? (.sealed ? .opened.signer : .who)
    : .authentic ? .who.copy ~~ .proof = (root: .who.root, by: .signature#.find(this.covers(.)).by, at: .stamp, session: None, delegation: None) : .who
  // Who the runtime verified signed this line, as of its stamp (so never `Live`); None for a line nobody verifiably signed.
  attested => .signer -- (by => by is Verified && by.proof.at ? by : None)
  // History is attribution, not authority (W2.1): a line runs as its who only when attested, otherwise as whoever replays it.
  applied (held) => .opened -- (plain => this.attested -- (by => held -- (by ? with (@me = by) plain.change : plain.change)))

  label_hash => (((this.id, this.change as String).join("") as Byte[]) as SHA256).digest
  payload => ((this.line.sealed_sender ? (hash: this.label_hash, change: this.change as String, who: this.who, relies: this.relies, signature: this.signature) : (hash: this.label_hash, change: this.change as String)) as String) as Byte[]
  content_key (holders: Character[] = this.line.holders) => .line.content_key(this.key, holders, [this.wraps{.key == this.key}, this.line.wraps_of(this.key)].flatten)
  enciphered => .content_key([[this.who], this.line.holders].flatten) -- (content => content is Key
    ? this.rewritten(this.change) ~~ (.sealed = this.payload as content)
      ~~ (this.line.sealed_sender ? . ~~ (.who = this.who.pseudonym(this.line.id ?? this.id).published) ~~ (.relies = None) ~~ (.signature = None) : .))
    : ERROR@Access `only a reader of a history writes to it`)
  deciphered => .content_key() -- (content => content is Key
    ? ((content.opened(this.sealed) as String) as Program) -- (inner =>
        this.rewritten(inner.change as Program) ~~ (inner.who ? . ~~ (.who = inner.who) ~~ (.relies = inner.relies) ~~ (.signature = inner.signature) : .)
          -- (plain => plain.label_hash == inner.hash ? plain : ERROR@Access `a line's ciphertext belongs to another line`))
    : this.rewritten(content))
}

History &+= {
  // Who may read a line's senders: narrower than who may read the line seals them (L§9.2).
  sender: *?

  // who may read it: who its location lets (or the one above it), and who may read one of its commits
  read_by => [.@?.lets_who ?? [], .since(None).map(.@?.access ?? None)#].flatten.compact.unique
  sealed_sender => .sender !== None && !.read_by.every(. is this.sender)
  // What who may read: the whole line when who may read it, else the commits who may read where they are (`x.@ / …`,
  // a grant on what an expression answers).
  covered (reader) => .allows(reader) ? .since(None) : .since(None){.allows(reader)}
  reaches (reader) => .covered(reader).some(=== this.head)
  readers => [.read_by, @everyone{reader => this.covered(reader).nonempty}].flatten{is Character}.unique
  following => .readers{reader => this.reaches(reader) || !this.since(None).some(.allows(reader))}
  holders => [[@me], (@local.registry, @local.hosted)#].flatten{is Character && .inbox}
  rotations => .ordered{c => c.wraps.some(.key == c.id)}
  current_key => .public ? None : .rotations.last.id
  readable => !.current_key || .content_key(this.current_key) is Key
  keys_for (reader: Character) => .covered(reader).map(.key).compact.unique

  wrapped (content: Key, label, reader: Key, policy: Identity) => policy.wrapping(kem: reader.algorithm, kdf: policy.digest, aead: content.algorithm) -- (by =>
    by.tagged(reader, (label as String).bytes, [], content.secret) -- (held => (key: label, cipher: content.algorithm, by: by, tag: held.tag, sealed: held.sealed)))
  wraps_of (label) => .since(None).map(.wraps).flatten{.key == label}
  content_key (label, holders: Character[] = this.holders, wraps = this.wraps_of(label)) => (label as String).bytes -- (info => this.holders{.inbox}.map(.inbox) -- (inboxes =>
    wraps.map(w => inboxes.find(w.by.recognised(., info, w.tag, w.sealed)) -- (inbox => inbox ? Key(algorithm: w.cipher, public: [], secret: w.by.opened(inbox, info, [], w.sealed)) : None)).compact.first
      ?? ERROR@Key `find the key`))

  rekeying (who: Character, label, readers = this.following) => who.policy() -- (policy => Key.generated(policy.cipher) -- (content =>
    [[who], readers].flatten.map(.inboxes()).flatten.unique.map(this.wrapped(content, label, ., policy)).shuffled))
  rekeyed (who: Character, readers = this.following) => UUID.v1() -- (label => this.wrapping(who, this.rekeying(who, label, readers), id: label))

  // A line that is not public uses its current content key (a first commit brings one of its own); its who signs it
  // before and after the storage levels, so the signature covers the ciphertext (L§9.2).
  committed (made: History.Commit) => (made.wraps.empty && !.public && !.current_key && made.who is Character && made.who.inbox ? .rekeying(made.who, made.id) : made.wraps)
    -- (keyed => made ~~ (.wraps = keyed) ~~ (.key = keyed.some(.key == made.id) ? made.id : this.current_key))
    -- (keyed => keyed.who is Character ? keyed.who.sealed(keyed.who.sealed(keyed).stored) : keyed.stored)
  // A commit that only carries wraps of content keys (a reader added, a key rotated).
  wrapping (who, wraps: *[], id: History.Label = UUID.v1()) =>
    this ~~ .head = this.committed(History.Commit(id, who, stamp: this.clock.now, change: Program(code: { . }), wraps: wraps, previous: this.head, line: this))
  // A cache line carries the wraps of its key, so it opens without the line it caches.
  cached_at (commit: History.Commit) => commit.rewritten(((this[commit].value) as String) as Program) ~~ (.wraps = this.wraps_of(commit.key) if commit.key)
  shared (reader: Character, who: Character = @me) => (reader.read this unless .allows(reader))
    -- this.keys_for(reader) -- (keys => keys.empty ? this
      : this.wrapping(who, keys.map(label => reader.inboxes().map(this.wrapped(this.content_key(label), label, ., who.policy()))).flatten(1).shuffled))
  // Revoking compares principals by root (`same`), so a verified copy of the reader revokes the grant made to them.
  unshared (reader: Character, who: Character = @me) => [this, this.since(None)].flatten.for(.@?.take(reader))
    -- this.rekeyed(who, this.following{!(. == reader)})
}

History &+= {
  accepted (commit: History.Commit) => commit ~~ (.previous = commit.from#.map(this.find(.))#) ~~ (.line = this) -- (linked =>
    !linked.authentic ? ERROR@Access `a commit is not signed by its who's instance key at its stamp`
    : this.head && !(this.head is linked.previous && this.head.stamp < linked.stamp) ? ERROR@Merge `merge`
    : this ~~ .head = linked)
}

Instance &+= {
  none.read handshake_key: Key?

  login (character: Character) => (.registry |= character) -- this.certified(character)
  // Keys dropped by logging out are made afresh here (`??=`); a key log whose roots are not held here asks for them (`endorsed`).
  certified (character: Character, world: World? = None) => {
    character.identity ??= .founded(character)
    character.key ??= Key.generated(character.policy().signing) unless world
    character.inbox ??= Key.generated(character.policy().agreement) unless world
    character.world_keys ??= []
    character.world_keys |= (world: world, key: Key.generated(character.policy().signing)) if world && !character.world_keys{.world === world}.nonempty
    .renewed(character, world)
    character
  }

  founded (character: Character) => {
    root := Key.generated(Identity.algorithms.signing)
    character.roots ??= []
    character.roots |= root
    identity := Identity(keys: [root.published], signing: root.algorithm)
    identity.history.publish
    identity.history.commit(character, identity).head ~~ (.signature |= root.signed(.hash))
    identity
  }

  endorsed (character: Character, change: Program) => {
    log := character.identity.history
    policy := character.policy()
    event := log.commit(character, change).head
    event.signature |= (character.roots ?? []).map(.signed(event.hash))#
    policy.allows(event, log) ? character : ERROR@Access `sign the key event with more root keys`
  }
  renewed (character: Character, world: World? = None) => [character.key_in(world), character.inbox unless world].compact.map(.published).map(key =>
    character.policy().certificates{.key == key && .world === world && !.expiring}.nonempty ? character
    : this.endorsed(character, Program(code: { .certificates |= Identity.Certificate(key, world: world) }))).find(.erred) ?? character
  revoked (character: Character, key: Key) => .endorsed(character, Program(code: { .certificates = .certificates{.key != key} }))

  verified (character: Character, world: World? = None) => character.key_in(world) -- (pair =>
    pair && (this.logged_in(character) || character is this.hosted) && character.certified(pair.published, World.ether.clock.now, world)
      ? character.copy ~~ .proof = (root: character.root, by: pair.published, at: None, session: None, delegation: None) : None)

  // Acting on a delegation takes its signature, scope and expiry, and that whoever presents it (`by`, verified) is the one
  // it was given to: a delegation seen elsewhere (it travels with handed-over code) is not a bearer token.
  delegated (delegation: Delegation, by = @me) => !delegation.valid() ? ERROR@Access `the delegation is unsigned, expired or not certified`
    : !((by is Character ? by.acting : by) -- (acting => acting is Verified && (acting == delegation.to || acting is delegation.to))) ? ERROR@Access `a delegation is acted on only by the one it was given to`
    : delegation.from.copy ~~ .proof = (root: delegation.from.root, by: delegation.signature.by, at: None, session: None, delegation)
  host_for (character: Character, delegation: Delegation? = None) => (delegation ? .delegated(delegation, by: character) : character) ~~ (this.hosted |= .) ~~ .presence = this

  greeted (character: Character, initiator: boolean) => character.policy() -- (policy => policy.handshake.handshake(initiator, this.handshake_key ??= Key.generated(policy.agreement), hash: policy.digest))
  introduction (character: Character, session: Noise.Session) => session.sent((((name: character.name, log: character.identity.history,
    by: character.key.published, signature: character.key.signed(session.binding))) as String) as Byte[])
  introduced (session: Noise.Session, message: Byte[]) => ((session.received(message) as String) as Program) -- (said => Identity.logged(said.log) -- (policy =>
    policy && said.signature.valid && said.signature.value == session.binding && said.signature.by == said.by && policy.certifies(said.by, World.ether.clock.now)
      // The identity is the one derived from the key log just checked; a told `identity` is never taken (its history could certify other keys).
      ? Character(name: said.name, identity: policy ~~ (.history = said.log), proof: (root: said.log.roots.first.hash, by: said.by, at: None, session, delegation: None))
      : ERROR@Access `the other side is not who its key log says`))
}

// Handed-over code runs as its giver only through what the runtime verified: the giver's delegation, held by whoever
// runs it, or the verified signer of its logged run; otherwise as whoever runs it (W2.1 Delegation, W2.17).
Program &+= {
  delegation: Delegation?

  run => Program.runs.commit(.who, this).head -- (logged => logged.opened -- (plain => this.delegation ? with (@me = @local.delegated(this.delegation)) plain.change
    : logged.attested -- (by => by ? with (@me = by) plain.change : plain.change)))

  // A replay runs as recorded, as of the line's stamp, never with the live permissions of who it replays (W2.1).
  static replay (logged: History.Commit) => (logged.attested -- (by => by ? with (@me = by) logged.opened.change : logged.opened.change)) if Program.recent.some(=== logged)
  assert !(Program.replay(Program.runs.head) is Live)  // VER10 a replay is given the live permissions of who it replays

  may (method, target) => .hops.every(. is Live && target.allows(., method) && (.proof.delegation.covers(method, target) ?? true))
}

// A commit is signed by a character's key, when one is held here.
Character &+= {
  sealed (commit: History.Commit) => commit ~~ (.signature = this.key.signed(.hash) if this.key)
}

// End-to-end encryption is one storage level, after deltas and compression (L§9.2).
Compiler &+= {
  encrypted := {
    {commit: History.Commit{.key && !.sealed}}.stored => commit.enciphered
    {commit: History.Commit{.sealed}}.opened => commit.deciphered
  }

  stored &+= encrypted
  levels &+= [encrypted]
  assert Compiler.levels.contains(Compiler.encrypted)  // CRYPT16 encryption is not a storage level
}

assert (2 of [1, 2] after 7 days vetoable by 1 of [3]).veto.signers == [3]  // IDY10 a threshold does not read its wait and veto

// A prompt asking whether to run a program names its whole chain of callers, the origin first
Program &+= {
  prompt => .hops.map(.PREFIX + .name) -- (named => named.first + " wants to run this"
    + (named.count > 1 ? ", originating from " + named[1..].join(" <- ") : ""))
  assert Program(who: @"me", caller: Program(who: @"company")).prompt == "@company wants to run this, originating from @me"  // HOP2 a prompt does not name the whole chain
  assert Program(who: @"solo").prompt == "@solo wants to run this"  // AC57 a prompt for a lone program names more than its runner
}
