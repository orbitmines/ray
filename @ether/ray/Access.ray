// Who may: a character or a location (an instance, who is at one), or any narrowing of them. What is done is a location
// too: reading a value is where it is (`x.@`), writing it its `=` under that (`x.@ /
// "="`), executing it its `()`. What a location does not say, the one above it does, at the same method; above
// everything, the policy of whoever runs (`@me/policy`).
Accessor := Character | Location

Location &+= {
  access: Accessor? = None
  at (method) => ((method == `=`) || (method == "write")) ? this / "=" : ((method == `()`) || (method == "execute")) ? this / "()" : this
  give (who: Accessor) => this ~~ (.access = ((.access === None) ? who : (.access | who)))
  take (who: Accessor) => this ~~ (.access = .access{!== who})
  allows (who: Accessor, method = "read") => .at(method).access -- (granted => (granted !== None) ? granted#.some((. == who) || (who is .))
    : .parent ? .parent.allows(who, method) : who is @me/policy)
}
Node &+= {
  allows (who: Accessor, method = "read") => .@ ? .@.allows(who, method) : who is @me/policy
  // (what the bootstrap leaves here: `internal x`, visible only to what made it)
  right-to-left internal => (.@ ?? (this ~~ (.location = Location(path: ""))).@).give(&.caller)
}

// The permission nobody has: `none.read` a secret (W5.6), which stores skip and logging out drops
none := Accessor{false}
assert !(@"anyone" is none)  // CST2 the permission nobody has reaches someone

// `who.read x`, `who.write x`, `who.execute x`: who may, where what x names is (`@ether.read x.count` at `x.@ / "count"`,
// apart from what holds it; placed somewhere of its own when it is nowhere yet); `who{filter}.read x`, who while the
// filter holds of them (a narrowing like any other); a field declared so, where the field is
{who}.{verb: "read" | "write" | "execute"} {target} ^keyword => ((target).@ ?? ((target) ~~ (.location = Location(path: ""))).@).at(verb).give(who)
{who}.{verb: "read" | "write" | "execute"} {name ^variable}: {type} ^keyword => {
  ({name}: {type})
  (.@ / `{name}`).at(verb).give(who)
}

// What one may execute: what someone may execute where it is
Executable := *{.@ && .@.at(`()`).access !== None}
assert !((count: 1) is Executable)  // LOC59 a value without execute access is an executable

assert {
  zed := @"zed"
  Held := class { count: Number = 1 }
  granted := Held()
  zed.read granted
  assert granted.allows(zed) & !granted.allows(zed, `=`) & !granted.allows(@"other")  // AC45 `.read` does not let read, or lets write, or lets someone else
  writable := Held()
  zed.write writable
  assert writable.allows(zed, `=`) & !writable.allows(zed)  // AC47 `.write` does not let write, or lets read
  above := Location(path: "above")
  above.give(zed)
  assert (above / "below").allows(zed) & !(above / "below").allows(zed, `=`)  // AC70 who may read a location may not read what is under it, or may write it
}
assert (count: 1).allows(@me/policy)  // AC51 a value no one was given is not visible to the policy
