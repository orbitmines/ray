// DEFLATE Compressed Data Format Specification version 1.3 (https://www.rfc-editor.org/rfc/rfc1951)
Deflate := class: Language {
  static extensions = ".deflate"

  // Huffman codes given by their lengths alone: shorter codes first, equal lengths in symbol order, each the next binary number (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.2)
  static Huffman := class = lengths: Decimal[] {
    codes => lengths.enumerate{.value > 0}.sort_by((.value, .index)).reduce(acc = [] => [acc,
      (symbol: .index, bits: ((acc.empty ? 0 : (acc.last.bits + 1) * 2 ^ (.value - acc.last.bits.length)) as Binary).padded(.value))])
    // A symbol is read as the one code whose bits come next, most significant bit first, and written as its code (https://www.rfc-editor.org/rfc/rfc1951#section-3.1.1)
    Symbol => Binary{. is codes.bits#} as (bits => codes{.bits == bits}.first.symbol)
    bits (symbol: Decimal) => codes{.symbol == symbol}.first.bits

    // Lengths fitted to frequencies: the two least frequent join until one is left, each join one bit deeper (Huffman 1952, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.2)
    static fitted (frequencies: Number[]) => (1..<frequencies{> 0}.count).reduce(held = (nodes: frequencies.enumerate{.value > 0}.map((weight: .value, symbols: [.index])), lengths: [0] * frequencies.count) =>
      held.nodes.sort_by(.weight) -- (sorted => [sorted[0].symbols, sorted[1].symbols].flatten -- (joined => (
        nodes: [sorted[2..], (weight: sorted[0].weight + sorted[1].weight, symbols: joined)],
        lengths: held.lengths.enumerate.map(.value + (.index is joined# ? 1 : 0))))))
      .lengths.enumerate.map(frequencies[.index] > 0 ? .value max 1 : 0) -- Huffman(.)
  }

  // Lengths 3..258 as codes 257..285 and distances 1..32768 as codes 0..29: each code's base and extra bits (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.5)
  static LengthBases = [(3, 0), (4, 0), (5, 0), (6, 0), (7, 0), (8, 0), (9, 0), (10, 0), (11, 1), (13, 1), (15, 1), (17, 1), (19, 2), (23, 2), (27, 2), (31, 2),
    (35, 3), (43, 3), (51, 3), (59, 3), (67, 4), (83, 4), (99, 4), (115, 4), (131, 5), (163, 5), (195, 5), (227, 5), (258, 0)]
  static DistanceBases = [(1, 0), (2, 0), (3, 0), (4, 0), (5, 1), (7, 1), (9, 2), (13, 2), (17, 3), (25, 3), (33, 4), (49, 4), (65, 5), (97, 5), (129, 6), (193, 6),
    (257, 7), (385, 7), (513, 8), (769, 8), (1025, 9), (1537, 9), (2049, 10), (3073, 10), (4097, 11), (6145, 11), (8193, 12), (12289, 12), (16385, 13), (24577, 13)]

  // A literal byte, or a copy of length bytes from distance bytes back (https://www.rfc-editor.org/rfc/rfc1951#section-2)
  static Literal := class = byte: Byte
  static Copy := class = length: Decimal{3 <= . <= 258}, distance: Decimal{1 <= . <= 32768}

  // Data elements other than Huffman codes are packed starting with their least significant bit, so they read reversed (https://www.rfc-editor.org/rfc/rfc1951#section-3.1.1)
  static Data := class<literals: Huffman, distances: Huffman> (
    elements: (
      (literal: literals.Symbol{< 256})
      | (length_code: literals.Symbol{257 <= . <= 285}, length_extra: <-Binary{length == LengthBases[length_code - 257].1},
         distance_code: distances.Symbol{< 30}, distance_extra: <-Binary{length == DistanceBases[distance_code].1})
    )[],
    // End-of-block (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.5)
    literals.Symbol{== 256}
  ) {
    values => elements.map(. -- (.literal != None ? Literal(.literal)
      : Copy(LengthBases[.length_code - 257].0 + .length_extra, DistanceBases[.distance_code].0 + .distance_extra)))
  }
  static coded (value: Literal | Copy) => value is Literal ? (literal: value.byte)
    : LengthBases.enumerate{.value.0 <= value.length}.last -- (length => DistanceBases.enumerate{.value.0 <= value.distance}.last -- (distance => (
      length_code: length.index + 257, length_extra: value.length - length.value.0,
      distance_code: distance.index, distance_extra: value.distance - distance.value.0)))

  // Non-compressed block: to the byte boundary, LEN, its one's complement NLEN, then LEN bytes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.4)
  static Stored := class (Binary{length < 8 && (at + length) % 8 == 0}, size: <-Binary₁₆ = bytes.count, <-Binary₁₆{== 2 ^ 16 - 1 - size}, bytes: (<-Byte)[]{length == size})

  // Fixed Huffman codes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.6)
  static fixed_literals = Huffman([[8] * 144, [9] * 112, [7] * 24, [8] * 8].flatten)
  static fixed_distances = Huffman([5] * 32)

  // Code lengths: 0–15 as they are, 16 repeats the previous 3–6 times, 17 a zero 3–10 times, 18 a zero 11–138 times (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.7)
  static CodeLengths := class<code: Huffman> (
    entries: (
      (length: code.Symbol{< 16})
      | (code.Symbol{== 16}, again: <-Binary₂)
      | (code.Symbol{== 17}, zeros: <-Binary₃)
      | (code.Symbol{== 18}, many: <-Binary₇)
    )[]
  ) {
    values => entries.reduce(acc = [] => [acc, .length != None ? [.length] : .again != None ? [acc.last] * (.again + 3) : [0] * (.zeros != None ? .zeros + 3 : .many + 11)].flatten)
  }

  // Dynamic Huffman codes: HLIT, HDIST, HCLEN, the code length code in its own order, then both codes' lengths as one sequence (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.7)
  static Order = [16, 17, 18, 0, 8, 7, 9, 6, 10, 5, 11, 4, 12, 3, 13, 2, 14, 1, 15]
  static Dynamic := class (
    hlit: <-Binary₅ = literals.lengths.count - 257,
    hdist: <-Binary₅ = distances.lengths.count - 1,
    hclen: <-Binary₄ = 15,
    sizes: (<-Binary₃)[]{length == hclen + 4} = Order.map(length_code.lengths[.] ?? 0),
    lengths: CodeLengths<length_code>{values.count == hlit + 257 + hdist + 1} = CodeLengths<length_code>(entries: [literals.lengths, distances.lengths].flatten.map((length: .))),
    data: Data<literals, distances>
  ) {
    length_code => Huffman((0..18).map(symbol => sizes[Order.index_of(symbol)] ?? 0))
    literals => Huffman(lengths.values[..<hlit + 257])
    distances => Huffman(lengths.values[hlit + 257..])
  }

  // Block header: BFINAL, then BTYPE: 0 stored, 1 fixed codes, 2 dynamic codes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.3)
  static Block := class (
    final: Binary₁ as boolean = false,
    kind: <-Binary₂{< 3} = 0,
    (stored: Stored) if kind == 0,
    (data: Data<fixed_literals, fixed_distances>) if kind == 1,
    (dynamic: Dynamic) if kind == 2
  ) {
    values => stored ? stored.bytes.map(Literal(.)) : (data ?? dynamic.data).values
  }

  // Blocks up to the final one, padded to a byte; each byte's bits are taken least significant first (https://www.rfc-editor.org/rfc/rfc1951#section-3.1.1, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.3)
  static Stream := class (blocks: Block[]{.last.final && !.[..<-1].some(.final)}, Binary{length < 8 && (at + length) % 8 == 0}) {
    // A copy may reach back into earlier blocks, and may overlap what it writes (https://www.rfc-editor.org/rfc/rfc1951#section-2, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.3)
    bytes => blocks.values.flatten.reduce(out = [] => copied(out, .))
    static copied (out: Byte[], value: Literal | Copy) => value is Literal ? [out, value.byte]
      : (0..<value.length).reduce(held = out => [held, held[held.count - value.distance]])

    static (bytes: Byte[]) as (=== Stream) => bytes.map(<-.).flatten as Stream
    as (=== Byte[]) => (this as Binary).chunk(8).map(<-. as Byte)
  }

  // A stored block holds at most 65535 bytes (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.4)
  static blocked (bytes: Byte[]) => (bytes.chunk(2 ^ 16 - 1) -- (.empty ? [[]] : .)) -- (chunks =>
    chunks.enumerate.map(Block(final: .index == chunks.count - 1, kind: 0, stored: Stored(bytes: .value))))

  // LZ77: at each position the longest earlier match of at least 3 bytes, at most 258 long and 32768 back (https://www.rfc-editor.org/rfc/rfc1951#section-4)
  static parsed (bytes: Byte[], at: Number = 0) => at >= bytes.count ? []
    : ((0 max at - 32768)..<at).map(from => (length: Encoding.common(bytes[from..], bytes[at..<(at + 258 min bytes.count)]), distance: at - from)).max_by(.length)#.first -- (best =>
      best && best.length >= 3 ? [Copy(best.length, best.distance), parsed(bytes, at + best.length)] : [Literal(bytes[at]), parsed(bytes, at + 1)])

  static fixed (values: (Literal | Copy)[]) => Data<fixed_literals, fixed_distances>(elements: values.map(coded(.)))
  static dynamic (values: (Literal | Copy)[]) => values.map(coded(.)) -- (codes =>
    Huffman.fitted((0..<286).map(symbol => codes{(.literal ?? .length_code) == symbol}.count + (symbol == 256 ? 1 : 0))) -- (literals =>
    Huffman.fitted((0..<30).map(symbol => codes{.distance_code == symbol}.count) -- (.some(> 0) ? . : [1])) -- (distances =>
    Dynamic(literals: literals, distances: distances, data: Data<literals, distances>(elements: codes),
      length_code: Huffman.fitted((0..18).map(length => [literals.lengths, distances.lengths].flatten{== length}.count))))))

  // A block is written with fixed codes, or with codes fitted to its own frequencies, when that is shorter; fitted codes are at most 15 bits, 7 for the code lengths (https://www.rfc-editor.org/rfc/rfc1951#section-3.2.6, https://www.rfc-editor.org/rfc/rfc1951#section-3.2.7)
  static Optimizations := {
    {block: Block{kind == 0 && (Block(final, kind: 1, data: fixed(parsed(stored.bytes))) as Binary).length < (this as Binary).length}} =>
      Block(final: block.final, kind: 1, data: fixed(parsed(block.stored.bytes)))
    {block: Block{kind == 1 && dynamic(values) -- (.literals.lengths.max <= 15 && .distances.lengths.max <= 15 && .length_code.lengths.max <= 7
      && (Block(final, kind: 2, dynamic: .) as Binary).length < (this as Binary).length)}} =>
      Block(final: block.final, kind: 2, dynamic: dynamic(block.values))
  }

  level := {
    {stream: Stream} => stream.bytes
  }
  written := Optimizations + {
    {writing: Language.Writing} => Stream(blocks: blocked(writing.value as Byte[]))
  }
}
