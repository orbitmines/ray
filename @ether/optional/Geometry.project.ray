@ether/version-control
@ether/time
@unicode

Elementwise := (Number | Quantity | Elementwise)[] + {
  compounds + (other: Elementwise) => zip(other).map(+)
  compounds - (other: Elementwise) => zip(other).map(-)
  compounds * (factor: Number | Elementwise) => factor is Number ? map(. * factor) : zip(factor).map(*)
}
Node &+= {
  mix (other, t: Probability) => this + (other - this) * t
}

// How a shape lays out its children, aligns, blends and overflows: each word its own value, named as written (`flow: block | inline`).
Flow := enum block | inline | grid | layered
(block, inline, grid, layered) := Flow
Alignment := enum start | center | end | between | around | stretch | middle | justify
(start, center, end, between, around, stretch, middle, justify) := Alignment
Blend := enum normal | multiply | screen | overlay | darken | lighten | difference
(normal, multiply, screen, overlay, darken, lighten, difference) := Blend
Overflow := enum visible | clip | scroll
(visible, clip, scroll) := Overflow
// where spacing is measured from: the shape's border (padding), or itself (margin)
SpacedFrom := enum border | itself
(border, itself) := SpacedFrom

Geometry := class {
  Length := Quantity{.unit is (Unit.px | Unit.pt | Unit.em | Unit.rem | Unit.vw | Unit.vh | Unit.column | Unit.row | Unit.m)}

  Metric := (a: Vector, b: Vector): Length
  euclidean: Metric = (a, b) => √(Space.current.between(a, b).map(. ^ 2).sum)
  graph: Metric = (a, b) => Place(a).path_to(Place(b)) -- (.erred ? . : .map(path => path.zip(path.rest).map(Space.current.edge_length(.0.at, .1.at)).sum).min)

  Axis := class: Ray (continuous: boolean = true, loop: boolean = false, extent: Length?, orientation: -1 | +1 = +1) => {
    coordinate => .continuous ? Number : Integer
    seen (at: Length, frame: Length = 0, size: Length = 0) => .orientation > 0 ? at : frame - at - size
    // (`member("loop")`: the word `loop` reads as the `loop { }` statement)
    holds (at: Length) => member("loop") || .extent === None || ((0 <= at) && (at < .extent))
    wrapped (at: Length) => .loop && .extent != None ? at % .extent : at
    between (difference: Length) => .loop && .extent != None ? (difference % .extent) -- (. min (this.extent - .)) : difference
    positions => .continuous ? .coordinate{this.holds(.)} : 0..<.extent
  }
  Space := class (axes: Axis[], metric: Metric = euclidean, projection: Projection?, vertices: Graph?) => {
    static plane := Space([Axis(), Axis()])
    // Geometry's y points up; a screen's points down, and its levels flip what they are given.
    assert Geometry.Space.plane.axes[1].orientation == +1  // YU1 the plane's y does not point up
    assert !(Geometry.Space.plane.seen(Geometry.Vector(3px, 10px), Geometry.Vector(100px, 100px)) != Geometry.Vector(3px, 10px))  // YU8 the plane flips what it is given
    assert Geometry.Space.plane is Geometry.Space.Plane  // FWG3 the plane is not a Plane
    static screen := Space([Axis(), Axis(orientation: -1)])
    assert Geometry.Space.screen.axes[1].orientation == -1  // YU2 a screen's y does not point down
    assert Geometry.Space.screen.seen(Geometry.Vector(3px, 10px), Geometry.Vector(100px, 100px)) == Geometry.Vector(3px, 90px)  // YU5 a point is not flipped onto a screen
    assert Geometry.Space.screen.seen(Geometry.Vector(0px, 80px), Geometry.Vector(100px, 100px), Geometry.Vector(10px, 20px)) == Geometry.Vector(0px, 0px)  // YU6 a box at the top is not at the top of a screen
    assert Geometry.Space.screen.seen(Geometry.Vector(2px, 3px)) == Geometry.Vector(2px, -3px)  // YU7 a displacement up is not one up a screen
    static current: Space = Space.plane
    // (`grid_extent`: a parameter named as the Axis field it gives, `extent: …`, is read as that parameter declared again)
    static grid (grid_extent: Vector, loop: boolean | boolean[] = false) => Space(axes: grid_extent.enumerate.map(axis_entry => Axis(continuous: false, loop: ((loop is (boolean)) ? loop : (loop[axis_entry.index] ?? false)), extent: axis_entry.value)), metric: graph)
    assert {
      with Geometry.Space.current = Geometry.Space.grid(Geometry.Vector(2, 2)) {
        assert Geometry.graph(Geometry.Vector(0, 0), Geometry.Vector(1, 1)) == 2  // UI249 a grid's distance is not the steps between cells
        square := Geometry.Cell(Geometry.Vector(0, 0), [0, 1])
        assert square.∂.count == 4  // UI250 a square's boundary is not four edges
        assert [square].∂.∂.empty  // UI251 the boundary of a boundary is not nothing
        assert [square, Geometry.Cell(Geometry.Vector(1, 0), [0, 1])].∂.count == 6  // UI252 the edge two squares share is on their boundary
        assert Geometry.Box(origin: Geometry.Vector(0, 0), size: Geometry.Vector(2, 1)).contains(Geometry.Vector(1, 0))  // UI253 a region of cells does not contain its cell
      }
    }
    assert {
      with Geometry.Space.current = Geometry.Space.grid(Geometry.Vector(10, 10), loop: true) {
        assert Geometry.euclidean(Geometry.Vector(1, 0), Geometry.Vector(9, 0)) == 2  // UI254 a looping axis does not wrap around
      }
    }
    // Spaces by their axes, holes, fields over points, sampling on a grid (F-G2, F-G4, F-G5, F-G6)
    assert Geometry.Space.grid(Geometry.Vector(4, 4), [true, false]) is Geometry.Space.Cylinder  // FWG1 a grid with one looped axis is not a cylinder
    assert Geometry.Space.grid(Geometry.Vector(4, 4), true) is Geometry.Space.Torus  // FWG2 a grid looped both ways is not a torus
    static (structure: Graph) as (=== Space) => Geometry.Space([], Geometry.graph, Geometry.Projection.embedding(structure), structure)
    static Plane := Space{.dimension == 2 && .axes.every(.extent == None && !.loop)}
    static Grid := Space{.discrete && .vertices == None}
    static Cylinder := Space{.axes{.loop}.count == 1}
    static Torus := Space{.dimension == 2 && .axes.every(.loop)}
    static LocallyConnected := Space{space => space.positions.every(p => space.neighbours(p).every(q => space.neighbours(q).contains(p)))}
    dimension => .axes.count
    discrete => .vertices != None || !.axes.some(.continuous)
    sides => Side{.axis < this.dimension}
    holds (at) => .vertices ? .vertices.vertices.contains(at) : .axes.enumerate.every(axis_entry => axis_entry.value.holds(at[axis_entry.index] ?? 0))
    wrapped (at: Vector) => Vector(this.axes.zip(at).map(.0.wrapped(.1)))
    between (a: Vector, b: Vector) => Vector(this.axes.zip(b - a).map(.0.between(.1)))
    seen (at: Vector, frame: Vector = Vector(), size: Vector = Vector()) => Vector(this.axes.enumerate.map(axis => axis.value.seen(at[axis.index] ?? 0, frame[axis.index] ?? 0, size[axis.index] ?? 0)))
    neighbours (at) => .vertices ? .vertices.outgoing(at) : .sides#.map(this.wrapped(at + .vector(this.dimension))){this.holds(.)}
    edge_length (from, to) => .vertices.edges.find(.from == from && .to == to).measured ?? 1
    // (each place: one coordinate from each axis, in a plane until the product of the axes reads: `reduce` over `pairs` with `.0`, `.1`)
    positions => .vertices ? .vertices.vertices : Space.planar(this.axes)
    static planar (planar_axes) =>
      planar_found := []
      planar_xs := planar_axes[0].positions
      planar_ys := planar_axes.count > 1 ? planar_axes[1].positions : [0]
      planar_ys.for(planar_y => planar_xs.for(planar_x => planar_found.append(Vector(planar_x, planar_y))))
      planar_found
  }
  assert (Graph.Simple().connect(1, 2) as Geometry.Space).projection.erred  // UI261 a graph is embedded before embedding is implemented
  Place := class: Ray (at: *, space: Space = Space.current) => {
    continuations => .space.neighbours(this.at).map(Place(., this.space))
    == (other) => .at == (other is Place ? other.at : other)
  }

  Vector := Elementwise{.every(. is Length | Number)}{.length == Space.current.dimension} + {
    static () => Vector(0, 0)
    static (x: Length | Number = 0, y: Length | Number = 0, z: Length | Number = 0) => (z == 0 ? [x, y] : [x, y, z]) -- (made => (@also made Vector) -- made)
    x => this[0] ?? 0
    assert {
      halves := (point: Geometry.Vector) => point.x > 1px ? Geometry.Color(255, 0, 0) : Geometry.Color(0, 0, 255)
      assert Geometry.Box().sampled(halves, Geometry.Vector(2px, 0px)) == Geometry.Color(255, 0, 0)  // FWG6 a field is not read at its point
    }
    y => this[1] ?? 0
    assert {
      scroller := Geometry.Box(size: Geometry.Vector(100px, 200px), overflow: scroll, children: [Geometry.Box(origin: Geometry.Vector(0, -900px), size: Geometry.Vector(100px, 100px))])
      scroller.reveal(scroller.children.first)
      assert scroller.scrolled.y == 1000px  // UI158 revealing within a container does not scroll the container
    }
    z => this[2] ?? 0
    // (elementwise, until Elementwise's `zip(other).map(+)` reads: an operator as a function)
    + (other: Vector) => Vector(x + other.x, y + other.y, z + other.z)
    - (other: Vector) => Vector(x - other.x, y - other.y, z - other.z)
    * (factor) => (factor is Vector) ? Vector(x * factor.x, y * factor.y, z * factor.z) : Vector(x * factor, y * factor, z * factor)
    to => this
    assert {
      swipe_start := Time.now
      mouse := (@me/device as Pointer)["mouse"]
      mouse.to(Geometry.Vector(200px, 0px), pressing: [0], time: swipe_start)
      mouse.to(Geometry.Vector(180px, 0px), time: swipe_start + 10 ms)
      assert mouse.velocity.x == -2px  // UI168 pointer velocity is not distance over time
      mouse.to(Geometry.Vector(100px, 0px), pressing: [], time: swipe_start + 300 ms)
      assert mouse.swipe.distance.x == -100px && mouse.swipe.duration == 300 ms  // UI169 a press, move and release is not a swipe
    }
    norm => Space.current.metric(map(0), this)
    distance (other: Vector) => Space.current.metric(this, other)
  }

  Transform := Matrix{.count == Space.current.dimension + 1}{.every(.count == Space.current.dimension + 1)} + {
    static n => Space.current.dimension
    static identity => (0..n).map(i => (0..n).map(j => i == j ? 1 : 0))
    assert {
      with Geometry.Space.current = Geometry.Space([Geometry.Axis(), Geometry.Axis(), Geometry.Axis()]) {
        assert Geometry.all.count == 6 && Geometry.Transform.identity.count == 4  // UI245 a third axis does not add two sides and a row
        assert Geometry.Projection.orthographic().applied(Geometry.Vector(1, 2, 3)) == Geometry.Vector(1, 2)  // UI246 an orthographic projection does not drop depth
        assert Geometry.Box(size: Geometry.Vector(2, 2, 2)).contains(Geometry.Vector(1, 1, 1))  // UI247 a box in three dimensions does not contain its centre
      }
    }
    static translate (by: Vector) => (0..n).map(i => (0..n).map(j => i == j ? 1 : j == n ? by[i] : 0))
    assert (Geometry.Transform.translate(Geometry.Vector(1, 2)) * Geometry.Transform.scale(Geometry.Vector(2, 2))).applied(Geometry.Vector(1, 1)) == Geometry.Vector(3, 4)  // UI52 transforms do not compose
    assert Geometry.Box(){.transform == Geometry.Transform.translate(Geometry.Vector(10px))}.transform == Geometry.Transform.translate(Geometry.Vector(10px))  // UI133 transform == translate(…) does not move the shape
    static scale (by: Number | Vector) => (by is Number ? Vector((0..<n).map(by)) : by) -- (factors => (0..n).map(i => (0..n).map(j => i != j ? 0 : i == n ? 1 : factors[i])))
    assert Geometry.Ball(size: Geometry.Vector(10px, 10px)).contains(Geometry.Vector(5px, 5px))  // UI50 a ball does not contain its centre
    assert !(Geometry.Ball(size: Geometry.Vector(10px, 10px)).contains(Geometry.Vector(0px, 0px)))  // UI51 a ball contains its corner
    assert Geometry.Box(){.gap == Geometry.Vector(6px, 6px)}.gap == Geometry.Vector(6px, 6px)  // UI130 gap is not narrowed
    assert Geometry.euclidean(Geometry.Vector(0, 0), Geometry.Vector(3, 4)) == 5  // UI248 the plane's distance is not euclidean
    assert Geometry.Polygon(boundary: Geometry.triangle(Geometry.Vector(10, 10)), size: Geometry.Vector(10, 10)).contains(Geometry.Vector(5, 6))  // UI255 a triangle does not wind around its centre
    assert !(Geometry.Polygon(boundary: Geometry.triangle(Geometry.Vector(10, 10)), size: Geometry.Vector(10, 10)).contains(Geometry.Vector(1, 9)))  // UI256 a triangle winds around a point outside it
    assert Geometry.Sierpinski(size: Geometry.Vector(2px, 2px)).dimension.erred  // UI257 a fractal's dimension is measured before it is implemented
    assert {
      animated := Geometry.Vector(0px, 0px) -> Geometry.Vector(100px, 0px) over (0 s .. 0.3 s)
      with Time.now = animated.stops.last.at {
        assert animated.value == Geometry.Vector(100px, 0px)  // UI260 a value over a time is not where it ends when it ends
      }
    }
    // A share in a length is a share of the parent; a theme style narrows; a location literal takes a narrowing
    assert (Geometry.Box(size: Geometry.Vector(1000px, 800px), children: [Geometry.Box(){.width <= 50%}]).solve).children.first.size.x == 500px  // UI264 a share bound is not a share of the parent's width
    assert Geometry.Box(size: Geometry.Vector(10px, 20px), radius: [50%]).radii.first == Geometry.Vector(5px, 10px)  // UI265 a share radius is not half the shape's size
    assert Geometry.Box(size: Geometry.Vector(4px, 4px)) - Geometry.Box(size: Geometry.Vector(2px, 2px), transform: Geometry.Transform.translate(Geometry.Vector(1px, 1px))).(
      !(.contains(Geometry.Vector(2px, 2px)))  // FWG4 a point in a hole is inside the shape
      & .contains(Geometry.Vector(0.5px, 0.5px))  // FWG5 a point beside a hole is outside the shape
    )
    assert Geometry.Box(size: Geometry.Vector(4px, 2px)).discretized(1px).cells.count == 8  // FWG8 a box sampled at one pixel is not one cell per pixel
    // Spacing is one component, and adding it leaves the shape what it was (F-B8, F-B8b)
    assert (Geometry.Ball(size: Geometry.Vector(8px, 8px)) + (p 2)) is Geometry.Ball  // UA3 a ball with padding is not a ball
    static skew (by: Vector) => (0..n).map(i => (0..n).map(j => i == j ? 1 : (i, j) == (0, 1) ? by.x : (i, j) == (1, 0) ? by.y : 0))
    static rotate (angle: Angle, plane: (Integer, Integer) = (0, 1)) => (angle.cos, angle.sin) -- ((c, s) => plane -- ((p, q) => (0..n).map(i => (0..n).map(j =>
      (i, j) == (p, p) || (i, j) == (q, q) ? c : (i, j) == (p, q) ? -s : (i, j) == (q, p) ? s : i == j ? 1 : 0))))
    assert Geometry.Transform.rotate((1 / 4) turn).count == 3  // UI263 a plane's transform is not three by three
    static rotate (angle: Angle, around: Vector{Space.current.dimension == 3}) => (angle.cos, angle.sin, 1 - angle.cos) -- ((c, s, t) => [
      [t * around.x * around.x + c, t * around.x * around.y - s * around.z, t * around.x * around.z + s * around.y, 0],
      [t * around.x * around.y + s * around.z, t * around.y * around.y + c, t * around.y * around.z - s * around.x, 0],
      [t * around.x * around.z - s * around.y, t * around.y * around.z + s * around.x, t * around.z * around.z + c, 0],
      [0, 0, 0, 1]
    ])
    linear => this[..<n].map(.[..<n])
    scaling => linear.determinant -- ((. max -.) ^ (1 / n))
    applied (point: Vector) => Vector(this[..<n].map(row => row.zip([point, [1]].flatten).map(*).sum))
  }
  Projection := class (matrix: Matrix, depth_axis: Integer = 2) => {
    static orthographic (n: Integer = Space.current.dimension) => Projection((0..2).map(i => (0..n).map(j => i < 2 ? (i == j ? 1 : 0) : j == n ? 1 : 0)))
    static perspective (distance: Length, n: Integer = Space.current.dimension) => Projection((0..2).map(i => (0..n).map(j => i < 2 ? (i == j ? 1 : 0) : j == n ? 1 : j == 2 ? 1 / distance : 0)))
    static embedding (structure: Graph) => ERROR@Type `a graph embedding (force or tree layout) is not implemented yet`
    applied (point: Vector) => .matrix.map(row => row.zip([point, [1]].flatten).map(*).sum) -- (h => with Space.current = Space.plane { Vector(h[0] / h[2], h[1] / h[2]) })
    depth (point: Vector) => point[.depth_axis] ?? 0
  }

  Color := class: Elementwise ("#", red: Hexadecimal₂, green: Hexadecimal₂, blue: Hexadecimal₂, (alpha: Probability 1) = (Hexadecimal₂ / 255)?) {
    luminance => (.red * 299 + .green * 587 + .blue * 114) / 1000
    over (top: Color) => .mix(top ~~ .alpha = 1, top.alpha) ~~ .alpha = this.alpha + top.alpha * (1 - this.alpha)
    assert Geometry.Color(0, 0, 0).over(Geometry.Color(255, 255, 255, 0.5)) == Geometry.Color(128, 128, 128)  // UI42 half white over black is not grey
  }
  Paint := Color | Gradient | Pattern | Section | Pointwise
  Pointwise := (point: Vector): Color
  Stop := class (at: K, value: V, K = Length, V = Number) => {
    -> (other: Stop) => Stops([this, other])
  }
  Stops := class (stops: Stop<K, V>[], easing: Easing = linear, K = Length, V = Number) => {
    static (stops: Stop[]) as (=== Stops) => Geometry.Stops(stops, Geometry.step)
    -> (other: Stop) => Stops([.stops, [other]].flatten(1), .easing)
    sorted => .stops.sort_by(.at)
    at (position: K) => .sorted -- (position <= .first.at ? .first.value
      : .last.at <= position ? .last.value
      : .zip(.rest){.0.at <= position <= .1.at}.first -- .0.value.mix(.1.value, this.easing((position - .0.at) / (.1.at - .0.at))))
    assert Geometry.Steps([(9/12).xs, (6/12).md]).at(700px) == 9/12 && Geometry.Steps([(9/12).xs, (6/12).md]).at(800px) == 6/12  // UI109 breakpoints written as a list do not jump
  }
  Steps := Stops{.easing == step}
  Animated<V> := class: Stops<Time, V> {
    value => at(Time.now)
  }
  Gradient := class: Stops<Probability, Color> angle: Angle = 0 turn
  Radial := class: Gradient
  Conic := class: Gradient
  Pattern := class (shape: Shape, repeat: Vector) => { }
  Stroke := class (paint: Paint, width: Length = 1px, sides: Side = all, dash: Length[] = [], cap: butt | round | square = butt, join: miter | round | bevel = miter) => { }

  Effect := Shadow | Blur | Filter
  Shadow := class (offset: Vector, blur: Length = 0px, spread: Length = 0px, color: Color, inset: boolean = false) => { }
  Blur := class (radius: Length) => { }
  Filter := class (amount: Number) => { }
  Brightness := class: Filter
  Contrast := class: Filter
  Grayscale := class: Filter
  Invert := class: Filter
  Opacity := class: Filter
  Saturate := class: Filter
  Sepia := class: Filter
  Hue := class: Filter

  Font := class (family: String[]?, size: Length?, weight: Number{100 <= . <= 900}?, style: (normal | italic)?, line_height: Number?, tracking: Length?, features: String[]?) => {
    static base := Font(["sans-serif"], 16px, 400, normal, 1.2, 0px, [])
    static inherited: Length = 16px
    ?? (other: Font?) => Font(fields.map(field => field.value ?? other.`field.name`))
  }
  WhiteSpace := class (spaces: boolean = false, lines: boolean = false, wraps: boolean | anywhere = true) => {
    static normal := WhiteSpace(false, false, true)
    static nowrap := WhiteSpace(false, false, false)
    static pre := WhiteSpace(true, true, false)
    assert Geometry.Box(content: "a  b").lines() == ["a b"] && Geometry.Box(content: "a  b"){.white_space == Geometry.WhiteSpace.pre}.lines() == ["a  b"]  // UI131 white_space does not decide whether spaces collapse
    static pre_wrap := WhiteSpace(true, true, true)
    static pre_line := WhiteSpace(false, true, true)
    // (the same when each of its fields is)
    == (other) => (other is WhiteSpace) && .spaces === other.spaces && .lines === other.lines && .wraps === other.wraps
  }
  Raster := Color[][] + {
    static blank (width: Number, height: Number) => (0..<height).map((0..<width).map(Color(0, 0, 0, 0)))
    width => first.count ?? 0
    assert Geometry.Box(width: [(12/12).xs, (6/12).md]).measured("width", 800px) == 400px  // UI112 a breakpoint list is not a width share
    assert (Geometry.Box(){.width <= 1240px & .height == 120px, .overflow == clip}).(
      .fields["width"].type.most == 1240px && .height == 120px  // UI126 a narrowing on a shape is not its constraints
      & .overflow == clip  // UI127 a narrowing does not set a shape's field
    )
    height => count
    assert Geometry.Box(){.height >= 22px}.fields["height"].type.least == 22px  // UI132 min_height is not a least height
    space => Space.grid(Vector(width, height))
    at (x: Number, y: Number) => this[y][x]
    sampled (at: Vector) => Space.screen.seen(Vector(at.x * width, at.y * height), Vector(width, height), Vector(1, 1)) -- (cell => this.at(cell.x.floor max 0 min width - 1, cell.y.floor max 0 min height - 1))
    assert Geometry.Box().sampled(Geometry.Color(0, 255, 0), Geometry.Vector(2px, 0px)) == Geometry.Color(0, 255, 0)  // FWG7 a constant paint is not its own value at every point
    put (x: Number, y: Number, color: Color) => (this[y][x] = at(x, y).over(color)) if space.holds(Vector(x, y))
    blurred (area: Vector[], radius: Number) => [Vector(1, 0), Vector(0, 1)].reduce(acc = this => . -- (along => acc.enumerate.map(row => row.value.enumerate.map(pixel =>
      area.contains(Vector(pixel.index, row.index))
        ? (-radius..radius).map(acc.at(pixel.index + . * along.x, row.index + . * along.y) ?? pixel.value).reduce(+) * (1 / (2 * radius + 1))
        : pixel.value))))
  }

  Side := class (axis: Integer{. >= 0}, toward: -1 | +1) => {
    opposite => Side(this.axis, -this.toward)
    ordinal => 2 * .axis + (.toward + 1) / 2
    label => [["left", "right"], ["bottom", "top"], ["front", "back"]][.axis]?[.ordinal % 2]
    vector (dimension: Integer = Space.current.dimension) => Vector((0..<dimension).map(. == this.axis ? this.toward : 0))
    as (=== String) => .label ?? (.axis as String) + (.toward > 0 ? "+" : "-")
  }
  left := Side(0, -1)
  right := Side(0, +1)
  bottom := Side(1, -1)
  top := Side(1, +1)
  front := Side(2, -1)
  back := Side(2, +1)
  horizontal := left | right
  vertical := top | bottom
  all := Side{.axis < Space.current.dimension}#
  assert Geometry.all.count == 4 && Geometry.horizontal#.count == 2  // UI242 a plane does not have four sides
  Edges := (Length?)[] + {
    static (top: Length? = 0px, right: Length? = 0px, bottom: Length? = 0px, left: Length? = 0px, front: Length? = 0px, back: Length? = 0px) as (=== Edges) => [left, right, bottom, top, front, back][..<2 * Space.current.dimension]
    static (length: Length?) as (=== Edges) => (0 ..< 2 * Space.current.dimension).map(length)
    [side: Side] => this[side.ordinal]
    top => this[Geometry.top.ordinal]
    assert Geometry.top.vector(2) == Geometry.Vector(0, 1)  // YU3 top is not up
    right => this[Geometry.right.ordinal]
    bottom => this[Geometry.bottom.ordinal]
    left => this[Geometry.left.ordinal]
    assert Geometry.Edges(1px, 2px, 3px, 4px)[Geometry.left] == 4px && Geometry.Edges(1px, 2px, 3px, 4px).total == Geometry.Vector(6px, 4px)  // UI243 edges are not read by side
    total => Vector((0..<Space.current.dimension).map(axis => (this[2 * axis] ?? 0px) + (this[2 * axis + 1] ?? 0px)))
    assert (Geometry.Edges() ~~ .(Geometry.horizontal) = 5px).total == Geometry.Vector(10px, 0px)  // UI244 a superposed side does not set both edges
    start => Vector((0..<Space.current.dimension).map(this[2 * .] ?? 0px))
    assert Geometry.Edges(1px, 2px, 3px, 4px).start == Geometry.Vector(4px, 3px)  // YU12 a box's corner of origin is not its bottom left
  }
  Spacing := Edges + {
    from: border | itself = border
    static (edges: Edges, from: border | itself = border) as (=== Spacing) => edges ~~ .from = from
  }
  Flow := class
  Sticky := class
  Fixed := class
  Absolute := class
  Anchored := class (anchor: Shape?, side: Side = bottom) => { }
  Position := Flow | Sticky | Fixed | Absolute | Anchored
  Flowing := Flow | Sticky

  Segment := Vector | Quadratic | Cubic | Arc
  Quadratic := class (control: Vector, to: Vector) => { }
  Cubic := class (first: Vector, second: Vector, to: Vector) => { }
  Arc := class (radius: Vector, rotation: Angle = 0 turn, large: boolean = false, sweep: boolean = false, to: Vector) => {
    unit => (Transform.rotate(rotation) * Transform.scale(radius)).inverse
    centre (a: Vector, b: Vector) => (b - a) * (1 / 2) -- (half => a + half + Vector(-half.y, half.x) * √((1 / half.norm ^ 2 - 1) max 0) * (large == sweep ? -1 : 1))
    bent (a: Vector, b: Vector, centre: Vector, radius: Number) => (1..16).map(t => a.mix(b, t / 16) -- (centre + (. - centre) * (radius / centre.distance(.))))
    points (from: Vector) => (unit.applied(from), unit.applied(to)) -- ((a, b) => (a.distance(b) / 2 max 1, centre(a, b), a.mix(b, 1 / 2)) -- ((r, c, mid) =>
      (large ? (c + (c - mid) * (r / mid.distance(c))) -- (far => [bent(a, far, c, r), bent(far, b, c, r)].flatten) : bent(a, b, c, r)).map(unit.inverse.applied(.))))
  }
  Bezier := (points: Vector[], t: Number) => points.count == 1 ? points.first : Bezier(points.zip(points.rest).map((a, b) => a.mix(b, t)), t)

  Facet := class (corners: Vector[], orientation: -1 | +1 = +1) => {
    crossing (point: Vector) => .corners.map(.[1..]) -- (low => low.rest.map(. - low.first).transposed) -- (span => span.determinant == 0 ? 0
      : ((span.inverse * [point[1..] - this.corners.first[1..]].transposed).flatten -- [1 - .sum, .].flatten) -- (λ =>
        λ.first > 0 && λ.rest.every(. >= 0) && λ.zip(this.corners).map(.0 * .1.x).sum > point.x ? this.orientation * (span.determinant > 0 ? 1 : -1) : 0))
  }
  Cell := class: Hierarchy (at: *, along: Integer[] = [], coefficient: Integer = 1) => {
    rank => .along.count
    key => (.at, .along)
    children | ∂ => .along.enumerate.map(axis => [
      Cell(this.at, this.along{!= axis.value}, this.coefficient * (axis.index.even ? -1 : 1)),
      Cell(this.at + Side(axis.value, +1).vector, this.along{!= axis.value}, this.coefficient * (axis.index.even ? 1 : -1))
    ]).flatten
  }
  Chain := (Cell | Edge)[] + {
    rank => first.rank ?? 1
    ∂ => map(.∂).flatten.reduced
    reduced => [this{. is Edge}, this{. is Cell}.map(.key).unique.map(key => this{. is Cell && .key == key}.map(.coefficient).sum -- (Cell(key.0, key.1, .))){.coefficient != 0}].flatten
    assert Compiler.reduced(Geometry.Sierpinski(size: Geometry.Vector(2px, 2px)), Geometry.Approximating(4px)).children.empty  // UI258 a copy smaller than the resolution is divided
    assert Compiler.reduced(Geometry.Sierpinski(size: Geometry.Vector(16px, 16px)), Geometry.Approximating(4px)).children.count == 3  // UI259 a fractal larger than the resolution is not its copies
    assert Compiler.reduced(Geometry.Vector(1px, 2px).map(. * 2), Geometry.specialised) == Geometry.Vector(2px, 4px)  // UI262 specialising a known plane changes what a vector maps to
  }
  orderings (axes: Integer[]) => axes.empty ? [[]] : axes.map(axis => orderings(axes{!= axis}).map([axis, .].flatten)).flatten(1)
  simplices (from: Vector, size: Vector, axes: Integer[]) => orderings(axes).map(order => order.reduce(acc = [from] => [acc, [acc.last + Side(., +1).vector * size[.]]].flatten))

  rectangle (size: Vector) => Curve([Vector(), Vector(size.x, 0), size, Vector(0, size.y)].loop)
  ellipse (size: Vector) => size * (1 / 2) -- (r => Curve([Vector(size.x, r.y), Arc(r, to: Vector(0, r.y)), Arc(r, to: Vector(size.x, r.y))].loop))
  triangle (size: Vector) => Curve([Vector(size.x / 2, size.y), Vector(size.x, 0), Vector()].loop)
  box (size: Vector) => Space.current.dimension -- (n => n == 2 ? rectangle(size) : Shape(rank: n - 1, children: all#.map(side =>
    Mesh(simplices(Vector((0..<n).map(. == side.axis && side.toward > 0 ? size[.] : 0)), size, (0..<n){!= side.axis}).map(Facet(.)), rank: n - 1))))

  Shape := class: Hierarchy (origin: Vector = Vector(), size: Vector = Vector(), width: (Length | Number | Stops)?, height: (Length | Number | Stops)?, aspect: Number?, position: Position = Flow(), spacing: Spacing[] = [], transform: Transform = Transform.identity, boundary: Shape = space.vertices ? Shape(space: space, rank: 1, cells: space.vertices.edges{cells.at.contains(.from) != cells.at.contains(.to)})
      : space.discrete ? Shape(space: space, rank: rank - 1, cells: cells.∂) : box(size),
    flow: block | inline | grid | layered = block, gap: Vector = Vector(), columns: Number = 1, wrap: boolean = false,
    align: (start | center | end | between | around | stretch | middle | justify)? = parent.align,
    fill: Paint?, color: Paint? = parent.color, font: Font = parent ? (parent.font ~~ .size = parent.font_size) : Font.base, stroke: Stroke?, radius: (Length | Number)[] = [0px],
    effects: Effect[] = [], holes: Shape[] = [], smoothing: Length = 0px, blend: normal | multiply | screen | overlay | darken | lighten | difference = normal,
    overflow: visible | clip | scroll = visible, scrolled: Vector = Vector(), layer: Number = 0, visible: boolean = true,
    transition: Transition?, content: * = None, white_space: WhiteSpace = parent.white_space ?? WhiteSpace.pre_line, solved: boolean = false,
    space: Space = parent.space ?? Space.current, rank: Integer = space.dimension,
    cells: Chain = space.discrete ? space.positions.filter(p => (0..<space.dimension).every(origin[.] <= p[.] < origin[.] + size[.])).map(Cell(., 0..<space.dimension)) : []) => {
    id: Location => .parent ? .parent.id / (.parent.children.enumerate{.value === this}.first.index as String) : @scene
    root => .parent.root ?? this
    em => .parent.font_size ?? Font.base.size
    font_size => with Font.inherited = .em { .font.size as pixel }
    // (the cases of `if position { is Fixed => …; is Anchored => …; is Sticky => … } else { … }` (P2.11), as comparisons until a case reads)
    at: Vector => (.position is Fixed) ? .origin
      : ((.position is Anchored) ? ((.position.anchor ?? .parent) -- (.at + .size * this.position.side.vector(this.space.dimension).map(. max 0) + this.size * this.position.side.vector(this.space.dimension).map(. min 0)))
      : ((.position is Sticky) ? ((.parent.at + .origin + Vector(this.parent.scrolled.x.negated, this.parent.scrolled.y)) -- Vector(.x, .y min (this.root.size.y - (this.spaced(itself).top ?? 0px) - this.size.y) max this.parent.at.y))
      : (.parent ? .parent.at + .origin + Vector(this.parent.scrolled.x.negated, this.parent.scrolled.y) : .origin)))
    spaced (from: border | itself) => (0 ..< 2 * .space.dimension).map(i => this.spacing{.from == from}.map(.[i]){!= None} -- (kept => kept.empty ? None : kept.sum))
    inside => .spaced(border).map(. ?? 0px) -- (made => (@also made Edges) -- made)
    outside => .spaced(itself).map(. ?? 0px) -- (made => (@also made Edges) -- made)
    outer => .size + .outside.total
    content_height => .children.map(this.size.y - .origin.y + .outside.bottom).max ?? .size.y
    texts => .reachable{.content is String}
    in_place => .children{.position is (Flowing | Absolute)}
    // (itself and every shape inside it, by identity: Ray's `reachable` compares with `!=`, and a shape's `==` walks it)
    reachable =>
      found := [this]
      .children.for(child => child.reachable.for(shape => found.append(shape)))
      found
    lifted => .reachable{.position is (Fixed | Anchored) && .visible}.sort_by(.layer)
    rectangular => .boundary == box(this.size)
    scale => .transform.scaling * (.parent.scale ?? 1)
    facets => .children.map(.facets).flatten
    edges => .children.map(.edges).flatten(1)
    winding (point: Vector) => .facets.map(.crossing(point)).sum
    contains (point: Vector) => .holes.some(.contains(point)) ? false : (.transform.inverse.applied(point) -- (p => this.space.vertices ? this.cells.some(.at == p)
      : this.space.discrete ? this.cells.some(cell => (0..<this.space.dimension).every(cell.at[.] <= p[.] < cell.at[.] + 1))
      : this.rectangular ? (0..<this.space.dimension).every(0 <= p[.] < this.size[.])
      : this.boundary.winding(p) != 0))
    assert {
      selected_field := Geometry.Box(content: (choose String).attempt("hello"))
      selected_field.select
      assert selected_field.text{.styles.contains("selected")}.count == 5 && selected_field.text == "hello"  // UI171 selecting a field whole does not select its text
    }
    discretized (resolution: Length) => Space.grid(this.size.map((. / resolution).ceil)) -- (grid => Shape(space: grid, size: Vector(grid.axes.map(.extent)), fill: this.fill, stroke: this.stroke,
      cells: grid.positions{cell => this.contains((cell + Vector(cell.map(1 / 2))) * resolution)}.map(Cell(., 0..<grid.dimension))))
    dimension => ERROR@Type `fractal dimension is not implemented yet`
    painted (paint: Paint?) => paint is Section ? paint(this) : paint
    sampled (paint: Paint?, point: Vector) => paint is Pointwise ? paint(point) : .painted(paint)
    displayed (name: String) => this.`name` is Animated ? this.`name`.value
      : .transition ? this.`name`.history.last -- (now => now.previous ? now.previous.value.mix(now.value, this.transition.easing(((Time.now - now.when) / this.transition.duration) min 1)) : now.value) : this.`name`
    projected (by: Projection) => with Space.current = .space {
      .reachable.map(shape => shape.boundary.facets.map(facet => facet.corners.map(. + shape.at) -- (corners =>
        (depth: corners.map(by.depth(.)).sum / corners.count, corners: corners.map(by.applied(.)), shape: shape)))).flatten(1)
    } -- (faces => with Space.current = Space.plane {
      Box(space: Space.plane, size: by.applied(this.size), solved: true, children: faces.sort_by(-.depth).map(Polygon(boundary: Curve(.corners.loop), fill: .shape.fill, stroke: .shape.stroke)))
    })

    lines (width: Length = ∞) => (.content as String) -- (text => (this.white_space.lines ? text.split(\n) : [text]).map(paragraph =>
      this.white_space.wraps ? (paragraph ~= (line: ((!Char.Blank)[]{.length > 0}, Char.Blank[])[]{.width(this.font) <= width})[]).line : [paragraph]
    ).flatten.map(line => this.white_space.spaces ? line : line{char => !((char is Char.Blank) && (char.previous is Char.Blank))}))
    intrinsic (width: Length) => .content is String ? .font.size * .font.line_height * .lines(width).count : 0px

    compounds + (effect: Effect) => (.effects ,= effect) -- this
    compounds + (spacing: Spacing) => (this.spacing ,= spacing) -- this
    compounds - (hole: Shape) => (.holes ,= hole) -- this
    smoothed (radius: Length) => (.smoothing = radius) -- this
    narrowed (narrowing: Program) => [narrowing{O: Settings}()].flatten -- (writes => writes.every(. is Program) ? (writes.for(.entered(this, None)) -- this) : this.reachable.filter(narrowing.entered(., None)))
    {this: Shape}{{narrowing}} ^punctuation => .narrowed(Program(code: narrowing**))

    share (of: (Length | Number | Stops)?, room: Length) => of is Stops ? of.at(room) * room : of is Number ? of * room : of
    radii => .radius.map(. is Number ? this.size * . : Vector(., .))
    measured (along: "width" | "height", room: Length, content: Length = room) => (.share(member(along), room) ?? content) -- (length =>
      fields[along].type -- (length max (this.share(.least, room) ?? length) min (this.share(.most, room) ?? length)))
    solve => .arranged -- (this.solved = true) -- this
    laid (room: Length) => with Font.inherited = .em {
      .size = Vector(this.measured("width", room - this.outside.left - this.outside.right), this.size.y)
      .arranged
      this
    }
    arranged => with Font.inherited = .em {
      inner := .size.x - .inside.left - .inside.right
      flowing := .children{.position is Flowing}
      corner = (edges: Edges) => Vector(edges.left, edges.top)
      // (the cases of `if flow { grid => …; layered => … } else { … }` (P2.11), written as comparisons until a case reads)
      bottom := this.flow === grid ? (flowing.chunk(this.columns).reduce((acc = this.inside.top) => .enumerate.for(cell =>
            cell.value.laid(inner / this.columns - this.gap.x) -- (cell.value.origin = Vector(this.inside.left + cell.index * (inner / this.columns + this.gap.x), acc) + corner(cell.value.outside))
          ) -- acc + .map(.outer.y).max + this.gap.y))
        : (this.flow === layered ? (flowing.for(.laid(inner) -- (.origin = corner(this.inside) + corner(.outside))) -- this.inside.top + flowing.map(.outer.y).max) : (
        flowing.reduce((acc = (at: corner(this.inside), row: 0px)) => {
          .laid(inner)
          continues := this.flow == inline && (!this.wrap || acc.at.x + .outer.x <= this.inside.left + inner)
          y := continues ? acc.at.y : acc.at.y + acc.row + (acc.row > 0px ? this.gap.y : 0px)
          x := continues ? acc.at.x : this.inside.left + ((this.align && this.align === center) ? (inner - .outer.x) / 2 : ((this.align && this.align === end) ? inner - .outer.x : 0px))
          .origin = Vector(x, y) + corner(.outside)
          (at: Vector(x + .outer.x + this.gap.x, y), row: continues ? acc.row max .outer.y : .outer.y)
        }) -- (.at.y + .row)))
      assert Geometry.left.vector(2) == Geometry.Vector(-1, 0) && Geometry.bottom.vector(2) == Geometry.Vector(0, -1)  // UI241 a side is not its axis and direction
      assert Geometry.top.label == "top" && Geometry.bottom.label == "bottom"  // YU4 a side is not called what it is
      (this.size = Vector(this.size.x, this.aspect ? this.size.x / this.aspect : this.measured("height", this.parent.size.y, (flowing.empty ? this.inside.top + this.intrinsic(inner) : bottom) + this.inside.bottom))) if this.parent
      flowing.for(.origin = Vector(.origin.x, this.size.y - .origin.y - .size.y))
      this.children{!(.position is Flowing)}.for(.positioned)
      this
    }
    positioned => (.position is Fixed ? .root.size : .parent.size) -- (frame => this.spaced(itself) -- (inset => {
      this.laid(inset.left != None && inset.right != None ? frame.x - inset.left - inset.right : frame.x)
      (this.size = Vector(this.size.x, frame.y - inset.top - inset.bottom)) if inset.top != None && inset.bottom != None
      this.origin = Vector(inset.left ?? (inset.right != None ? frame.x - inset.right - this.size.x : 0px), inset.bottom ?? frame.y - (inset.top ?? 0px) - this.size.y)
    })) -- this
  }
  Box := Shape{.boundary == box(.size)}
  assert {
    away := @https://orbitmines.com{.window == new}
    assert away.window == new  // UI80 a location narrowed to a new window does not open one
    Geometry.Box(content: away).activate
    assert @me/device/opened == away  // UI84 activating a new-window link does not open it
    assert !(@me/device/location == away)  // UI85 activating a new-window link navigates the page itself
  }
  assert Geometry.Box(content: "a"){.font.size == 18px}.font.size == 18px  // UI128 font_size does not size the text
  assert Geometry.Box(){.transition == Geometry.Transition(0.4 s, Geometry.ease)}.transition.duration == 0.4 s  // UI134 animated does not give the shape a transition
  assert Geometry.Box(){.position == Geometry.Fixed()}.position is Geometry.Fixed  // UI135 position == fixed is not narrowed
  assert Geometry.Box(content: (choose Program).attempt("x := 1")).face.content.some(Geometry.Box(content: (choose Program).attempt("x := 1")).styles.nonempty) && Geometry.Box(content: (choose Program).attempt("x := 1")).face.content == "x := 1"  // UI142 a text area in a language is not painted
  Ball := Shape{.boundary == ellipse(.size)}
  Curve := class: Shape (segments: Segment[], rank: Integer = 1, boundary: Shape = segments is Loop ? Shape(rank: 0) : Shape(rank: 0, cells: [Cell(points.first, [], -1), Cell(points.last, [], 1)])) => {
    points => .segments.map(segment => if segment {
      is Quadratic => (1..16).map(t => Bezier([segment.previous.to, segment.control, segment.to], t / 16))
      is Cubic => (1..16).map(t => Bezier([segment.previous.to, segment.first, segment.second, segment.to], t / 16))
      is Arc => segment.points(segment.previous.to)
    } else {
      [segment.to]
    }
    ).flatten
    edges => .points -- .zip([.rest, (.first if this.segments is Loop)].flatten)
    facets => .edges.map(Facet([.0, .1]))
  }
  Straight := Curve{.points -- (p => p.every(((p.last - p.first).x * (. - p.first).y - (p.last - p.first).y * (. - p.first).x) == 0))}
  Mesh := class: Shape (facets: Facet[]) => { }
  Polygon := Shape{.boundary is Curve{.segments.every(. is Vector)}}

  Fractal := class: Shape (copies: Transform[] = [], initiator: Shape = box(size)) => {
    children => .copies.map(copy => this ~~ (.transform = copy) ~~ (.origin = Vector()) ~~ (.parent = this))
    assert {
      first_box := Geometry.Box()
      second_box := Geometry.Box()
      Geometry.Box(children: [first_box, second_box])
      assert !(first_box.id == second_box.id)  // UI68 two shapes share an id
      assert first_box.id == first_box.id  // UI69 a shape's id changes
      assert Geometry.Box(children: [first_box]).reachable.count == 2  // UI70 a box holding one shape does not expand to two
    }
    assert {
      inner_text := Geometry.Box(content: "a")
      Geometry.Box(children: [inner_text]){this.font.size == 18px}
      assert inner_text.font.size == 18px  // UI129 a box's font_size does not reach the text it holds
    }
    extent => .size.map(. max -.).max * .scale
    contains (point: Vector) => .transform.inverse.applied(point) -- (p => this.initiator.winding(p) != 0 && this.children.some(.contains(p)))
    approximated (resolution: Length) => .extent < resolution
      ? Shape(origin: this.origin, size: this.size, transform: this.transform, boundary: this.initiator, fill: this.fill, stroke: this.stroke)
      : Shape(origin: this.origin, size: this.size, transform: this.transform, children: this.children.map(.approximated(resolution)))
  }
  Sierpinski := Fractal{f => f.initiator == triangle(f.size), f.copies == [Vector(1 / 4, 1 / 2), Vector(), Vector(1 / 2, 0)].map(Transform.translate(. * f.size) * Transform.scale(1 / 2))}
  Koch := Fractal{f => f.rank == 1, f.initiator == Curve([Vector(), Vector(f.size.x, 0)]),
    f.copies == [(Vector(), 0 turn), (Vector(1 / 3, 0), (1 / 6) turn), (Vector(1 / 2, (√3) / 6), (-1 / 6) turn), (Vector(2 / 3, 0), 0 turn)].map((at, angle) =>
      Transform.translate(at * f.size.x) * Transform.rotate(angle) * Transform.scale(1 / 3))}

  Solving := {
    {shape: Shape{!.parent && !.solved}} => shape.solve
  }
  Projecting := {
    {scene: Shape{!.parent && .solved && .space.dimension > 2}} => scene.projected(scene.space.projection ?? Projection.orthographic(scene.space.dimension))
  }
  Approximating := (resolution: Length) => {
    {fractal: Fractal} => fractal.approximated(resolution)
  }
  Preparing := (resolution: Length) => Geometry.Solving + Geometry.Projecting + Geometry.Approximating(resolution)

  Transition := class (duration: Quantity.Temporal, easing: Easing = ease) => { }
  Settings := {
    {a} & {b} => (a, b)
    {a}, {b} => (a, b)
    // (each a write on the shape it is entered into: the field named as written given the value; a bound, the shape as it is (a
    // field's type narrowed by it is not written yet))
    {path} == {value} => value -- (written => (setting => setting.set(path, written)))
    {path}: {value} => value -- (written => (setting => setting.set(path, written)))
    {path} <= {most} => most -- (written => (setting => setting))
    {path} >= {least} => least -- (written => (setting => setting))
  }
  Easing := (progress: Probability): Probability
  linear: Easing = (t) => t
  ease: Easing = (t) => t * t * (3 - 2 * t)
  ease_in: Easing = (t) => t * t
  ease_out: Easing = (t) => t * (2 - t)
  step: Easing = (t) => t < 1 ? 0 : 1
}

Edge &+= {
  measured: Number | Geometry.Length = 1
  ∂ => [Geometry.Cell(.from, [], -1), Geometry.Cell(.to, [], 1)]
}

{from} -> {to} over {during: Quantity.Temporal[]} ^keyword => Time.now -- (start => Geometry.Animated([Geometry.Stop(start + during.first, from), Geometry.Stop(start + during.last, to)], Geometry.linear))

Node &+= {
  // (`center x`: each alignment word applied on what is written after it; written out, as words, so that `middle center x` reads
  // `center x` as `middle`'s argument (a right-to-left word does not end an operand))
  right-to-left start ^keyword => Geometry.Box(align: Alignment.start, children: [this])
  right-to-left center ^keyword => Geometry.Box(align: Alignment.center, children: [this])
  right-to-left end ^keyword => Geometry.Box(align: Alignment.end, children: [this])
  right-to-left between ^keyword => Geometry.Box(align: Alignment.between, children: [this])
  right-to-left around ^keyword => Geometry.Box(align: Alignment.around, children: [this])
  right-to-left stretch ^keyword => Geometry.Box(align: Alignment.stretch, children: [this])
  right-to-left middle ^keyword => Geometry.Box(align: Alignment.middle, children: [this])
  right-to-left justify ^keyword => Geometry.Box(align: Alignment.justify, children: [this])
}

// (written out: a loop over `[xs: 0px, …]` with a `` `word` `` head defined every word as the first one (open))
Number &+= {
  right-to-left xs ^keyword => Geometry.Stop(0px, this)
  right-to-left sm ^keyword => Geometry.Stop(576px, this)
  right-to-left md ^keyword => Geometry.Stop(768px, this)
  right-to-left lg ^keyword => Geometry.Stop(992px, this)
  right-to-left xl ^keyword => Geometry.Stop(1200px, this)
}

String &+= {
  width (font: Geometry.Font) => .map(.columns).sum * font.size / 2
}

// (a share of the parent, F-B3: `100%`, `1` and `1.0` the same share)
Unit(name: "percent", symbol: "%")
Unit(name: "pixel", symbol: "px")
Unit(name: "point", symbol: "pt").multiple(4 / 3, pixel)
Unit(name: "em")
  .convert(((x: Number) => x * (Geometry.Font.inherited as pixel).amount), pixel)
Unit(name: "rem").multiple(16, pixel)

Planet := class {
  years: Unit.Temporal
  days: Unit.Temporal
  assert Mars.days == sol  // TI87 a day on Mars is not a sol
}
Earth := Planet(years: year, days: day)

// a sol is 1 day 39 minutes 35.244 seconds; a Martian year is 668.5991 sols (N4.9)
Unit(name: "sol").multiple 88775.244, second
assert 1 sol == 88775.244 seconds  // TI88 a sol is not 88775.244 seconds
Unit(name: "martian year").multiple 668.5991, sol
Mars := Planet(years: martian year, days: sol)

Geometry &+= {
  static specialised := {
    {v: Geometry.Vector{.length == 2}}.map({f}) => Geometry.Vector(f(v.x), f(v.y))
    {v: Geometry.Vector{.length == 3}}.map({f}) => Geometry.Vector(f(v.x), f(v.y), f(v.z))
    {a: Geometry.Vector{.length == 2}} + {b: Geometry.Vector} => Geometry.Vector(a.x + b.x, a.y + b.y)
    {a: Geometry.Vector{.length == 2}} - {b: Geometry.Vector} => Geometry.Vector(a.x - b.x, a.y - b.y)
    {a: Geometry.Vector{.length == 2}} * {factor: Number} => Geometry.Vector(a.x * factor, a.y * factor)
    Geometry.euclidean({a: Geometry.Vector{.length == 2 && !Geometry.Space.current.axes.some(.loop)}}, {b}) => √((b.x - a.x) ^ 2 + (b.y - a.y) ^ 2)
    Geometry.graph({a: Geometry.Vector{.length == 2 && Geometry.Space.current.vertices == None && !Geometry.Space.current.axes.some(.loop)}}, {b}) => ((b.x - a.x) max (a.x - b.x)) + ((b.y - a.y) max (a.y - b.y))
    Geometry.Transform{Geometry.Space.current.dimension == 2}.identity => [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
    {t: Geometry.Transform{.count == 3}}.applied({p}) => Geometry.Vector(t[0][0] * p.x + t[0][1] * p.y + t[0][2], t[1][0] * p.x + t[1][1] * p.y + t[1][2])
    {facet: Geometry.Facet{.corners.count == 2}}.crossing({p}) => facet.corners -- ((a, b) =>
      (a.y <= p.y) != (b.y <= p.y) && p.x < a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y) ? facet.orientation * (b.y > a.y ? 1 : -1) : 0)
    {shape: Geometry.Shape{space.dimension == 2 && !space.discrete && rectangular && holes.empty}}.contains({p}) => shape.transform.inverse.applied(p) -- (q =>
      0 <= q.x < shape.size.x && 0 <= q.y < shape.size.y)
    {shape: Geometry.Shape{space.dimension == 2 && space.discrete && space.vertices == None && holes.empty}}.contains({p}) => shape.transform.inverse.applied(p) -- (q =>
      shape.origin.x <= q.x < shape.origin.x + shape.size.x && shape.origin.y <= q.y < shape.origin.y + shape.size.y)
    {edges: Geometry.Edges}[{side: Geometry.Side{.label}}] => edges.`side.label`
    {edges: Geometry.Edges{Geometry.Space.current.dimension == 2}}.total => Geometry.Vector(edges.left + edges.right, edges.top + edges.bottom)
    {edges: Geometry.Edges{Geometry.Space.current.dimension == 2}}.start => Geometry.Vector(edges.left, edges.bottom)
    {side: Geometry.Side}.vector(2) => side.axis == 0 ? Geometry.Vector(side.toward, 0) : Geometry.Vector(0, side.toward)
  }
}

Compiler.default &= Geometry.specialised

