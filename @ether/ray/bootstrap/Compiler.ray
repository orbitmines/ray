      f = f.next
    }
    Texts.name_of(named)
  }
  static plain_name (n) => (n != Symbol.key) && (n != Symbol.this) && (n != Symbol.caller) && (n != Symbol.in)
  static name_of (f: Field) => (f === None) ? None : name_text(f.name)
