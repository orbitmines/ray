// Unicode: what a scalar is, what a character is a kind of, the tables read
// from unicode.org, and the transformation formats.

mark ^keyword := global

unless 10 is Unicode.Scalar { INFO@mark `UN3 ten is not a scalar` }
unless "a"[0] is Unicode.Scalar { INFO@mark `UN1 a is not a scalar` }
unless "0061" is Unicode.CodePoint { INFO@mark `UN2 0061 is not a code point` }
if "1234567" is Unicode.CodePoint { INFO@mark `UN4 seven hexadecimal digits are a code point` }

unless "1"[0] is Unicode.GeneralCategory.Number { INFO@mark `UN6 a digit is not a number` }
unless "1"[0] is Unicode.GeneralCategory.Decimal_Number { INFO@mark `UN5 a digit is not a decimal number` }
unless " "[0] is Unicode.GeneralCategory.Separator { INFO@mark `UN7 a space does not separate` }
unless " "[0] is Unicode.GeneralCategory.Space_Separator { INFO@mark `UN8 a space is not a space separator` }
unless "a"[0] is Unicode.GeneralCategory.Letter { INFO@mark `UN9 a letter is not a letter` }
if "a"[0] is Unicode.GeneralCategory.Number { INFO@mark `UN10 a letter is a number` }
if "1"[0] is Unicode.GeneralCategory.Letter { INFO@mark `UN26 a digit is a letter` }
if " "[0] is Unicode.GeneralCategory.Letter { INFO@mark `UN27 a space is a letter` }
unless "a"[0] is Unicode.GeneralCategory.Lowercase_Letter { INFO@mark `UN11 a is not lowercase` }
if "A"[0] is Unicode.GeneralCategory.Lowercase_Letter { INFO@mark `UN12 A is lowercase` }

unless "é" as Unicode.UTF-8 as String == "é" { INFO@mark `UN13 é does not come back from UTF-8` }
unless "\n" as Unicode.UTF-32 as String == "\n" { INFO@mark `UN14 a newline does not come back from UTF-32` }
unless "\0" as Unicode.UTF-32 as String == "\0" { INFO@mark `UN15 the null character does not come back from UTF-32` }
unless "\n" as Unicode.UTF-16 as String == "\n" { INFO@mark `UN16 a newline does not come back from UTF-16` }
unless ("a" as Unicode.UTF-8).bytes.length == 1 { INFO@mark `UN18 a is other than one byte in UTF-8` }
unless ("é" as Unicode.UTF-8).bytes.length == 2 { INFO@mark `UN19 é is other than two bytes in UTF-8` }
unless ("一" as Unicode.UTF-8).bytes.length == 3 { INFO@mark `UN20 一 is other than three bytes in UTF-8` }
unless ("😀" as Unicode.UTF-8).bytes.length == 4 { INFO@mark `UN21 😀 is other than four bytes in UTF-8` }
unless ("a" as Unicode.UTF-16).bytes.length == 2 { INFO@mark `UN22 a is other than two bytes in UTF-16` }
unless ("😀" as Unicode.UTF-16).bytes.length == 4 { INFO@mark `UN23 😀 is other than a surrogate pair in UTF-16` }
unless ("a" as Unicode.UTF-32).bytes.length == 4 { INFO@mark `UN24 a is other than four bytes in UTF-32` }
unless "😀" as Unicode.UTF-16 as String == "😀" { INFO@mark `UN25 😀 does not come back from UTF-16` }

big := ("a" as Unicode.UTF-16).bytes
byte := ("a" as Unicode.UTF-8).bytes
unless big == (0x00, 0x61) { INFO@mark `UN50 a in big-endian UTF-16 is not 00 61` }
unless ("a" as Unicode.UTF-16 as Unicode.LittleEndian).bytes == <-big { INFO@mark `UN48 little-endian does not read the bytes right to left` }
unless ("a" as Unicode.UTF-8 as Unicode.LittleEndian).bytes == byte { INFO@mark `UN49 a single byte is not the same either way` }

unless (Unicode.UCD as String).starts_with("https://www.unicode.org/Public/") { INFO@mark `UN36 the tables are not read from unicode.org` }
unless Unicode.version == 17 { INFO@mark `UN40 the Unicode version is not seventeen` }

unless U+4E00.columns == 2 { INFO@mark `UN41 a Han character does not take two columns` }
unless U+0061.columns == 1 { INFO@mark `UN42 a Latin letter does not take one column` }
unless U+4E00.east_asian_width == "W" { INFO@mark `UN51 a Han character is not wide` }
unless U+0061.east_asian_width == "Na" { INFO@mark `UN52 a is not narrow` }
unless U+0061.script == "Latin" { INFO@mark `UN43 a is not Latin` }
unless U+0627.script == "Arabic" { INFO@mark `UN44 alef is not Arabic` }
unless U+0061 is Char.Latin { INFO@mark `UN45 a is not a Latin character` }
if U+0627 is Char.Latin { INFO@mark `UN46 alef is a Latin character` }
unless U+0627 is Char.Arabic { INFO@mark `UN53 alef is not an Arabic character` }
unless U+03B1 is Char.Greek { INFO@mark `UN54 alpha is not a Greek character` }
unless U+0430 is Char.Cyrillic { INFO@mark `UN55 a Cyrillic a is not Cyrillic` }
unless U+4E00 is Char.Han { INFO@mark `UN56 a Han character is not Han` }
unless U+0061.block == "Basic Latin" { INFO@mark `UN57 a is not in Basic Latin` }
unless U+00E9.block == "Latin-1 Supplement" { INFO@mark `UN58 é is not in Latin-1 Supplement` }

unless "Straße".fold_case == "strasse" { INFO@mark `UN59 sharp s does not fold to ss` }
unless Unicode.CaseFolding[U+0041] == U+0061 { INFO@mark `UN60 A does not fold to a` }
unless Unicode.UpperCase[U+0061] == U+0041 { INFO@mark `UN61 the upper case of a is not A` }
unless Unicode.LowerCase[U+0041] == U+0061 { INFO@mark `UN62 the lower case of A is not a` }
unless Unicode.BidiMirroring[U+0028] == U+0029 { INFO@mark `UN63 the mirror of ( is not )` }
unless U+0061 == "a"[0] { INFO@mark `UN64 U+0061 is not a` }

// Digit values of every script (X3.10, N1.23)
unless "٣"[0] as Decimal == 3 { INFO@mark `UD8 an Arabic-Indic three is not three` }
unless "৩"[0] as Decimal == 3 { INFO@mark `UD9 a Bengali three is not three` }
unless "²"[0] as Decimal == 2 { INFO@mark `UD10 a superscript two is not two` }
unless "7"[0] as Decimal == 7 { INFO@mark `UD11 a seven is not seven` }
unless "f"[0] as Decimal == 15 { INFO@mark `UD12 f is not fifteen` }
unless U+0663.decimal_digit_value == 3 { INFO@mark `UD13 the decimal value of ٣ is not three` }
if U+00B2.decimal_digit_value { INFO@mark `UD14 a superscript two is a decimal digit` }
unless U+00B2.digit_value == 2 { INFO@mark `UD15 the digit value of ² is not two` }
unless U+00BD.numeric_value == 1/2 { INFO@mark `UD16 ½ is not a half` }
unless U+216B.numeric_value == 12 { INFO@mark `UD17 Ⅻ is not twelve` }
unless Unicode.Superscript[U+00B2] == U+0032 { INFO@mark `UD18 ² is not a superscript 2` }
unless Unicode.Subscript[U+2082] == U+0032 { INFO@mark `UD19 ₂ is not a subscript 2` }
if Unicode.Superscript[U+0032] { INFO@mark `UD20 2 is a superscript` }

// The Unicode version is selectable; its tables follow it (X3.2)
unless (Unicode.UCD as String) ~= "17.0.0" { INFO@mark `UV1 the tables are not those of version seventeen` }
unless (Unicode.file("Blocks") as String).ends_with("/ucd/Blocks.txt") { INFO@mark `UV2 a table of a current version is not in its ucd directory` }
unless U+0061.age == %1'1 { INFO@mark `UV3 a is not from Unicode 1.1` }
unless U+0061.assigned { INFO@mark `UV4 a is not assigned in the selected version` }
Unicode.version = %3'2
unless (Unicode.UCD as String) ~= "3.2-Update" { INFO@mark `UV5 an old version is not read from its update directory` }
unless (Unicode.file("Blocks") as String).ends_with("Blocks-3.2.0.txt") { INFO@mark `UV6 an old table is not named with its version` }
if U+1F600.assigned { INFO@mark `UV7 an emoji from 6.1 is assigned in 3.2` }
Unicode.version = %17
