// Mercurial's revlogs (https://www.mercurial-scm.org/wiki/RevlogNG, https://www.mercurial-scm.org/wiki/FileFormats)
Mercurial := class: Language {
  static extensions = ".hg" | ".mercurial"
  static fidelity = Language.Fidelity.snapshot
  static requirements = ["revlogv1", "store", "fncache", "dotencode", "generaldelta"]

  Node := Byte²⁰
  null: Node = [0] * 20
  none_revision = 0xFFFFFFFF
  hashed (text: Byte[], first: Node, second: Node): Node => SHA1.write(([first, second].sort as Byte[]), text) as Node

  Chunk := class (("x", zlib: Byte[]) | ("u", plain: Byte[]) | ("\x00", raw: Byte[]) | raw: Byte[]) {
    bytes => zlib ? (("x", zlib) as Byte[] as Zlib).inflated : plain ?? raw
    static of (bytes: Byte[]) => (bytes as Zlib as Byte[]) -- (packed => packed.count < bytes.count ? (packed as Chunk) : Chunk(plain: bytes))
  }

  Delta := class (hunks: (start: Binary³², end: Binary³², length: Binary³², data: Byte[]{count == length})[]) {
    applied (base: Byte[]) => hunks.reduce(held = (text: [], at: 0) => (text: (held.text, base[held.at..<.start], .data), at: .end)) -- (done => done.text, base[done.at..])
    static between (base: Byte[], target: Byte[]) => Encoding.common(base, target) -- (prefix => Encoding.common(base[prefix..].reverse, target[prefix..].reverse) -- (suffix =>
      Delta(hunks: [(start: prefix, end: base.count - suffix, length: target.count - prefix - suffix, data: target[prefix..<target.count - suffix])])))
  }

  Revlog := class (entries: Entry[]) {
    static Entry := class (
      offset: Binary⁴⁸, flags: Binary¹⁶,
      compressed: Binary³², length: Binary³²,
      base: Binary³², link: Binary³², first: Binary³², second: Binary³²,
      node: Node, Byte¹²{every(== 0)},
      data: Byte[]{count == compressed}
    ) {
      chunk => data as Chunk
    }
    static version = 0x00010001

    revision (index: Number) => entries[index]
    find (node: Node) => entries.find(.node == node)
    text (index: Number): Byte[] => entries[index] -- (entry => entry.base == index ? entry.chunk.bytes : Delta(entry.chunk.bytes).applied(text(entry.base)))
    parents (index: Number) => [entries[index].first, entries[index].second]{!= none_revision}

    static of (texts: (text: Byte[], first: Number?, second: Number?, link: Number)[]) => full(texts)
    static full (texts: (text: Byte[], first: Number?, second: Number?, link: Number)[]) => Revlog(entries: texts.reduce(made = [] => made, [
      ((made.map(.node))[.first] ?? null) -- (p1 => ((made.map(.node))[.second] ?? null) -- (p2 => Chunk.of(.text) as Byte[] -- (data => Entry(
        offset: made.empty ? version : made.map(.compressed).sum, flags: 0,
        compressed: data.count, length: .text.count,
        base: made.count, link: .link, first: .first ?? none_revision, second: .second ?? none_revision,
        node: hashed(.text, p1, p2), data))))
    ]))
  }

  Escaped := class: String (((!"\\" && !"\x00" && !\n && !"\r") | ("\\\\" as "\\") | ("\\0" as "\x00") | ("\\n" as \n) | ("\\r" as "\r"))[])

  Changeset := class (
    manifest: Hexadecimal⁴⁰, \n,
    user: (!\n)[], \n,
    seconds: Decimal.Real, " ", zone: Integer, (" ", extra: (key: (!":")[] as Escaped, ":", value: (!"\x00" && !\n)[] as Escaped, "\x00"?)[])?, \n,
    files: ((!\n)[], \n)[],
    \n,
    description: Char[]
  ) {
    when: Time => (seconds seconds) as Time
    recorded => extra?.find(.key == "ray")?.value
    branch => extra?.find(.key == "branch")?.value ?? "default"
  }

  Manifest := class (lines: (path: (!"\x00")[], "\x00", node: Hexadecimal⁴⁰, flag: ("x" | "l" | "t")?, \n)[]) {
    static flags = { executable: "x", link: "l", module: "t" }
  }

  Copied := class ("\x01\n", meta: (key: (!":")[], ": ", value: (!\n)[], \n)[], "\x01\n", content: Byte[]) {
    from => meta.find(.key == "copy")?.value
  }

  // fncache + dotencode (https://www.mercurial-scm.org/wiki/fncacheRepoFormat)
  encoded (path: String) => path.map(c => c ~= ("A".."Z") ? "_" + c.lower_case
    : c == "_" ? "__"
    : c ~= ("\\" | ":" | "*" | "?" | "\"" | "<" | ">" | "|") || c.code < 32 || c.code > 126 ? "~" + (c.code as Hexadecimal²).lower_case
    : c).join("") -- (. ~= ⊢"." ? "~2e" + .[1..] : .)

  Store := class = root: Location {
    log (name: String) => (root / ("store/" + name)).bytes as Revlog
    changelog => log("00changelog.i")
    manifests => log("00manifest.i")
    file (path: String) => log("data/" + encoded(path) + ".i")
    bookmarks => (root / "bookmarks").content.lines{.nonempty}.map(line => line ~= (node: Hexadecimal⁴⁰, " ", name: (!\n)[]))

    tree (manifest: Manifest) => Language.Entry.of(manifest.lines.map(line => (path: line.path,
      content: file(line.path) -- (log => log.text(log.entries.index_of(log.find(line.node as Node)))) -- (bytes => (bytes as Copied)?.content ?? bytes))))
    renames (manifest: Manifest) => manifest.lines.map(line => file(line.path) -- (log => (log.text(log.entries.index_of(log.find(line.node as Node))) as Copied)?.from -- (from => (from: from, to: line.path) if from)))#

    revisions => (0..<changelog.entries.count).map(index => changelog.text(index) as Changeset -- (made => manifests.text(manifests.entries.index_of(manifests.find(made.manifest as Node))) as Manifest -- (manifest => History.Revision(
      id: changelog.entries[index].node, tree: tree(manifest), parents: changelog.parents(index).map(changelog.entries[.].node),
      who: Character.local(made.user) ?? made.user, when: made.when, message: made.description, recorded: made.recorded, renames: renames(manifest)))))

    history => History.reading(revisions) -- (reading => Repository(location: root) -- (repository => repository
      ~~ (.histories = bookmarks.map(mark => History(repository, head: reading.commits[mark.node as Node], name: mark.name)))
      -- History(repository, head: reading.commits[changelog.entries.last.node], name: "default")))
  }

  Written := class = history: History, revisions: History.Revision[] {
    paths => revisions.tree.files.path.unique
    changed (revision: History.Revision) => revision.tree.files{file => revisions.find(.id == revision.parents.first)?.tree.at(file.path)?.content != file.content}.path
    filelog (path: String) => revisions{.tree.at(path)}{revision => revision.parents.empty || revisions.find(.id == revision.parents.first)?.tree.at(path)?.content != revision.tree.at(path).content}.map(revision => (revision, content: revision.tree.at(path).content)) -- (versions =>
      Revlog.of(versions.map(version => (
        text: revision.renames.find(.to == path) -- (renamed => renamed ? (("\x01\ncopy: " + renamed.from + "\ncopyrev: " + "0" * 40 + "\n\x01\n") as Byte[], version.content) : version.content),
        first: version.index > 0 ? version.index - 1 : None, second: None, link: revisions.index_of(version.revision)))))
    manifest (revision: History.Revision) => revision.tree.files.sort_by(.path).map(file => (file.path, "\x00", filelog(file.path).entries{.link <= revisions.index_of(revision)}.last.node as Hexadecimal⁴⁰, Manifest.flags[file.mode] ?? "", \n)).join("")
    manifests => Revlog.of(revisions.map(revision => (text: manifest(revision) as Byte[], first: revisions.index_of(revisions.find(.id == revision.parents.first)), second: revisions.index_of(revisions.find(.id == revision.parents[1])), link: revisions.index_of(revision))))
    changelog => Revlog.of(revisions.map(revision => (text: (
      manifests.entries[revisions.index_of(revision)].node as Hexadecimal⁴⁰, \n,
      (revision.who?.full_name ?? revision.who as String) + " <" + (revision.who?.email ?? "") + ">", \n,
      (revision.when as s).floor as String, " 0",
      [("branch:" + (history.name as Escaped)) if history.name && history.name != "default", ("ray:" + (revision.recorded as Escaped)) if revision.recorded] -- (extras => (" " + extras.join("\x00")) if extras.nonempty), \n,
      changed(revision).map(., \n),
      \n, revision.message
    ) as Byte[], first: revisions.index_of(revisions.find(.id == revision.parents.first)), second: revisions.index_of(revisions.find(.id == revision.parents[1])), link: revisions.index_of(revision))))
    files => [
      (path: "requires", content: requirements.map(. + \n).join("") as Byte[]),
      (path: "store/00changelog.i", content: changelog as Byte[]),
      (path: "store/00manifest.i", content: manifests as Byte[]),
      (path: "store/fncache", content: paths.map("data/" + . + ".i" + \n).join("") as Byte[]),
      paths.map(path => (path: "store/data/" + encoded(path) + ".i", content: filelog(path) as Byte[]))
    ].flatten(1)
  }

  static level := {
    {at: Location} => Store(root: (at / ".hg/requires").content.nonempty ? at / ".hg" : at)
    {store: Store} => store.history
  }

  static written := {
    {writing: Language.Writing{value is History}} => Written(history: writing.value, revisions: History.revisions(writing.value))
    {written: Written} => Language.Entry.of(written.files)
  }

  static stored := {
    Revlog.of({texts}) => Revlog.full(texts) -- (log => log ~~ .entries = log.entries.map(entry => entry.index == 0 ? entry
      : Chunk.of(Delta.between(texts[entry.index - 1].text, texts[entry.index].text) as Byte[]) as Byte[] -- (delta => delta.count < entry.compressed
        ? entry ~~ (.base = entry.index - 1) ~~ (.data = delta) ~~ (.compressed = delta.count)
        : entry)))
  }
}
