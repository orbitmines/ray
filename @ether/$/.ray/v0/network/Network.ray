Network &+= {
  static Port = Decimal{< 2^16}

  static DomainName := class (text: (Char.Letter | Char.Digit | "-" | ".")[]) => {
    valid => 0 < text.count < 2^8
    static canonical := DomainName{text == text.fold_case}
  }

  static Proxy := class = through: Character, admits: *? {
    carries (traffic) => !admits || traffic is admits
  }

  static Protocol := enum ether (port: @ether.address.port) | https (port: 443) | http (port: 80) | ssh (port: 22) | wss (port: 443) | ws (port: 80) | dns (port: 53) {
    static handshake (offered) => offered
    static version => Handshake.version
  }

  static URL := Location{scheme}

  static Socket := class {
    static Address := class (("[", host: IPv6, "]") | host: IPv4 | host: DomainName, ":", port: Port) => {
      send (bytes: Byte[]) => external network `tcp` (this as String, bytes)
      datagram (bytes: Byte[]) => external network `udp` (this as String, bytes)
    }
  }

  static Names := class {
    record (name: String, address, key): static => this ~~ (this[name] = (address: address, key: key))
    trusted (name: String, key) => (this[name].history.first?.key ?? key) == key
  }

  static Hosts := class {
    static equivalences => @/etc/hosts.content as Unicode.Table<(address: (!" " && !"\t")[], (" " | "\t")[], names: (!" " && !"\t")[].join((" " | "\t")[]))>
    static resolved (name: String) => DomainName(equivalences.rows{.names.fold_case ∋ name.fold_case}.last?.address ?? name)
  }

  static Handshake := class {
    version => 0
    offer (versions) => versions{== version}.last ?? Quest(name: "agree on a version", goal: versions)
  }

  static Remote := class = character: Character, location: Location = @remote {
    static Execution := class = code: *, as: Character, at: Location

    run (code) => character.key ? Execution(code, as: character, at: location) : Quest(name: "authorise", goal: code)
    fresh (code) => Remote(Character(name: "unauthorised"), location).run(code)
  }

  static Challenge := class = message: *, due: Time, answered = false {
    answer (response) => {
      answered = response == message if Time.now < due
      answered
    }
  }

  static Stream := class = player: Character, location: Location {
    watchers => Character#{.presence == location}
    watch (character: Character): static => this ~~ character.presence = location
    moved (to: Location): static => this ~~ (watchers.presence = to) ~~ (.location = to)
  }

  static Shard := class = character: Character, parts: *? {
    store (part, location: Location): static => this ~~ (.parts |= part @ location)
  }
}

Location &+= {
  static canonical := Location{!port || port != protocol?.port}
  protocol => Network.Protocol#{as String == scheme}.first
  resolved => Network.Hosts.resolved(host) -- (. == host ? $.dns.resolve(host) ?? . : .)
  socket => Network.Socket.Address(host: host, port: port ?? protocol?.port)
}

Device &+= {
  network: (mac: Binary₄₈, connected: boolean) = (mac: (external os `mac_address`) ?? (Binary₄₈.random ~~ .[7] = 1), connected: (external network `connected`) ?? false)
}

Instance &+= {
  address: (Network.URL | Network.Socket.Address | IP | Network.DomainName)?

  seen_from (other: Instance) => other === this ? @localhost : address
  local => address is @localnetwork
  canonical: static => Instance(location, address: address.static.canonical ? address as address.static.canonical : address)
}

{address: Network.URL | Network.Socket.Address | IP | Network.DomainName}: Instance => Instance(location: address, address)
