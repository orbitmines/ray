// TOML v1.0.0 (https://toml.io/en/v1.0.0)
TOML := class (lines: Line[].join(\n)) => {
  static Blank := (" " | \t)[]
  static Comment := ("#", (!\n)[])
  static Gap := (Blank, Comment?, \r?, \n)[]
  static Line := (Blank, statement: (ArrayTable | Table | Pair)?, Blank, Comment?, \r?)
  static Bare := (Char.Letter | Char.Digit | "-" | "_")[]{length > 0}
  static Key := class ((parts: (Bare | Basic | Literal)[]).join((Blank, ".", Blank))) => {
    path => parts.map(. is Bare ? . as String : .value)
  }
  static Table := class ("[", Blank, key: Key, Blank, "]")
  static ArrayTable := class ("[[", Blank, key: Key, Blank, "]]")
  static Pair := class (key: Key, Blank, "=", Blank, value: Value)

  static Value := Multiline | Basic | MultilineLiteral | Literal | DateTime | Float | Integer | Truth | Array | Inline
  static Escaped := class ("\\", (character: "\"" | "\\") | (control: "b" | "f" | "n" | "r" | "t" | "e") | ("u", short: Hexadecimal⁴) | ("U", long: Hexadecimal⁸) | (Blank, \r?, \n, (" " | \t | \r | \n)[], trimmed: "")) => {
    value => trimmed != None ? "" : character ?? ((short ?? long) ? (short ?? long) as Char : { "b": \b, "f": \f, "n": \n, "r": \r, "t": \t, "e": \x1B }[control])
  }
  static Basic := class ("\"", characters: (Escaped | Char{!= "\"" && != "\\" && != \n})[], "\"") => {
    value => characters.map(. is Escaped ? .value : .).join("") as String
  }
  static Multiline := class ("\"\"\"", \n?, characters: (Escaped | (!"\"\"\"" && !"\\"))[], "\"\"\"") => {
    value => characters.map(. is Escaped ? .value : .).join("") as String
  }
  static Literal := class ("'", text: (!"'" && !\n)[], "'") => {
    value => text as String
  }
  static MultilineLiteral := class ("'''", \n?, text: (!"'''")[], "'''") => {
    value => text as String
  }
  static Integer := class (written: (("+" | "-")?, (Char.Digit, ("_"?, Char.Digit)[])) | ("0x", Hexadecimal[]) | ("0o", Octal[]) | ("0b", Binary[])) => {
    value => written.replace("_", "") as Number
  }
  static Float := class (written: (("+" | "-")?, ("inf" | "nan" | ((Char.Digit, ("_"?, Char.Digit)[]), (".", Char.Digit[])?, (("e" | "E"), ("+" | "-")?, Char.Digit[])?)))) => {
    value => written ~= (*, "inf") ? (written ~= ⊢"-" ? -∞ : ∞) : written ~= (*, "nan") ? None : written.replace("_", "") as Number
  }
  static DateTime := class (written: (Char.Digit⁴, "-", Char.Digit², "-", Char.Digit², (("T" | "t" | " "), Clock)?) | Clock) => {
    static Clock := (Char.Digit², ":", Char.Digit², ":", Char.Digit², (".", Char.Digit[])?, ("Z" | "z" | (("+" | "-"), Char.Digit², ":", Char.Digit²))?)
    value => written as Time ?? written as String
  }
  static Truth := class (word: "true" | "false") => {
    value => word == "true"
  }
  static Array := class ("[", Gap?, (elements: (Blank, Gap?, element: Value, Blank, Gap?)[]).join(","), ","?, Blank, Gap?, Blank, "]") => {
    value => elements.map(.element.value)
  }
  static Inline := class ("{", Blank, (pairs: Pair[]).join((Blank, ",", Blank)), Blank, "}") => {
    value => pairs.reduce(held = Document() => held.put(.key.path, .value.value))
  }

  value => lines.statement.compact.reduce(held = (at: [], document: Document()) =>
    . is ArrayTable ? (at: .key.path, document: held.document.appended(.key.path))
    : . is Table ? (at: .key.path, document: held.document.within_path(.key.path))
    : (at: held.at, document: held.document.put([held.at, .key.path].flatten, .value.value))).document

  static key (name: String) => name ~= ⊢ Bare ⊣ ? name : "\"" + JSON.escaped(name) + "\""
  static inline (value) => value is boolean ? (value ? "true" : "false")
    : value is Number ? value as 10 as String
    : value is String | Location | Version ? "\"" + JSON.escaped(value as String) + "\""
    : value is Document ? "{ " + value.entries.map(key(.name) + " = " + inline(.value)).join(", ") + " }"
    : value is Iterable ? "[" + value.map(inline(.)).join(", ") + "]"
    : inline(Document(entries: value.fields))
  static nested (value) => value is Document || value is Iterable && value.nonempty && value.every(. is Document)
  static pairs (document: Document) => document.entries{!nested(.value)}.map(key(.name), " = ", inline(.value), \n)
  static tables (path: String[], document: Document) => document.entries{nested(.value)}.map(entry => [path, entry.name].flatten -- (inner =>
    entry.value is Document
      ? (\n, "[", inner.map(key(.)).join("."), "]", \n, pairs(entry.value), tables(inner, entry.value))
      : entry.value.map(element => \n, "[[", inner.map(key(.)).join("."), "]]", \n, pairs(element), tables(inner, element))))

  static written := {
    {writing: Language.Writing{value is Document}} => pairs(writing.value), tables([], writing.value)
    {writing: Language.Writing} => Language.Writing(Document(entries: writing.value.fields))
  }
  static level := { {text: String} => (text as TOML).value }
  static language = Language(".toml", level: level, written: written)
}
