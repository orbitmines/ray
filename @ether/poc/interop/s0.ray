mark ^keyword := global

unless (2 + 3) == 5 { INFO@mark `S0.0 the engine does not run` }

Sum := class (left, " + ", right) => { }
read := "a + b" as Sum
unless read.left == "a" { INFO@mark `S0.1 the left operand is not read` }
unless read.right == "b" { INFO@mark `S0.2 the right operand is not read` }
if "a - b" as Sum { INFO@mark `S0.3 text the pattern does not read is read` }
