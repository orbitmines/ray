// The TUI is a Compiler level like the web (F-D2, F-D10): the scene becomes a grid of cells, the grid becomes bytes for one terminal,
// and the bytes coming back become the same device variables the browser writes (F-D9: everything on the one byte stream).
TUI := namespace {
  // A cell is the terminal's pixel: one glyph with its style. A px is a fraction of a cell (F-B5).
  Cell := class = glyph: Char = " ", foreground: Geometry.Color?, background: Geometry.Color?, bold: boolean = false, italic: boolean = false, underline: boolean = false, strike: boolean = false, dim: boolean = false, link: Location?
  Grid := class = width: Number, height: Number, cells: Cell[][] = (0..<height).map((0..<width).map(Cell())) {
    put (at: Geometry.Vector, cell: Cell) => cells[at.y][at.x] = cell if 0 <= at.x < width && 0 <= at.y < height
    painted (at: Geometry.Vector, paint: Geometry.Paint) => put(at, cells[at.y][at.x] ~~ .background = Sample(paint, at))
    // Only what changed since the last frame is written.
    changes (previous: Grid?) => (0..<height).map(y => (0..<width){!previous || cells[y][.] != previous.cells[y][.]}.map(x => (Geometry.Vector(x, y), cells[y][x]))).flatten
  }
  px_per_cell = Geometry.Vector(8px, 16px)
  cells (length: Geometry.Vector) => Geometry.Vector(length.x / px_per_cell.x, length.y / px_per_cell.y)

  // Shapes onto the grid, back to front. Effects that a cell can't show are approximated by colour (F-D3: one general solution, not special cases).
  Cells := {
    {page: Geometry.Shape} => Grid(UI.Viewport.size.x / px_per_cell.x, UI.Viewport.size.y / px_per_cell.y) -- Paint(page, .)
  }
  // Where a shape's cells are, after its transform.
  Area := (shape: Geometry.Shape) => (cells(shape.position).y..<cells(shape.position + shape.size).y).map(y => (cells(shape.position).x..<cells(shape.position + shape.size).x).map(x => Geometry.Vector(x, y))).flatten{shape.transform.inverse.applied(. * px_per_cell) -- shape.contains(.)}
  // Every shape onto the grid, back to front. Effects a cell can't show are approximated by colour (F-D3: one general solution, not special cases).
  Paint := (shape: Geometry.Shape, grid: Grid) => grid -- shape.match
    // Glyphs by their columns: wide characters take two cells (X3.4).
    Geometry.Text => shape.lines(shape.size.x).zip(0..).for((line, row) => #line.reduce(column = 0 => {
      grid.put(cells(shape.position) + Geometry.Vector(column, row), Cell(., shape.fill as Geometry.Color, bold: shape.font.weight >= 600, italic: shape.font.style == italic))
      column + .columns
    }))
    // An image is sampled into coloured characters (F-C1); a terminal that shows pixels gets them through its own level.
    Geometry.Image => Area(shape).for(at => grid.put(at, Picture(shape.source).sampled(at - cells(shape.position), cells(shape.size))))
    // Drawing on a cell grid: braille dots give 2×4 points per cell.
    Geometry.Canvas => shape.draws{O: Direct.level}().rows -- Area(shape).for(at => grid.put(at, Cell(Braille(.[at.y * 4..at.y * 4 + 4].map(.[at.x * 2..at.x * 2 + 2])))))
    // OSC 8 hyperlinks: the cells carry where they go.
    UI.Link => Box(shape, grid) -- Area(shape).for(grid.cells[.y][.x] ~~ .link = shape.to)
    UI.Input => Paint(Geometry.Text(shape.match
      UI.Checkbox => shape.value ? "[x]" : "[ ]"
      UI.Slider => (shape.value - shape.chosen.type.least) / (shape.chosen.type.most - shape.chosen.type.least) -- "─" * (. * 10), "●", "─" * (10 - . * 10)
      UI.Select => "‹ ", shape.value as String, " ›"
      UI.Secret => "•" * (shape.value as String).length
      * => (shape.value as String) ?? shape.placeholder
    , position: shape.position, size: shape.size), grid) -- Border(shape, grid)
    * => Box(shape, grid)
  Box := (shape: Geometry.Shape, grid: Grid) => {
    Area(shape).for(grid.painted(., shape.fill)) if shape.fill
    Border(shape, grid) if shape.stroke
    shape.effects.for(.match
      Geometry.Opacity => Area(shape).for(grid.cells[.y][.x] ~~ .foreground = .foreground?.mix(.background, 1 - .amount))
      Geometry.Shadow => Area(shape).map(. + cells(.offset)).for(grid.cells[.y][.x] ~~ .background = (.background ?? Geometry.Color(0, 0, 0)).mix(Geometry.Color(0, 0, 0), 0.5))
      * => None
    )
    shape.children.sort_by(.layer).for(Paint(., grid)) if shape.visible
    Scrollbar(shape, grid) if shape.overflow == scroll
    Focus(shape, grid) if UI.Focus.current === shape
  }
  // Box drawing: rounded corners when the shape has a radius.
  Border := (shape: Geometry.Shape, grid: Grid) => {
    corners = shape.radius != [0] ? "╭╮╰╯" : "┌┐└┘"
    from = cells(shape.position)
    to = cells(shape.position + shape.size) - Geometry.Vector(1, 1)
    style = Cell(foreground: shape.stroke.paint as Geometry.Color)
    (from.x + 1..<to.x).for(x => grid.put(Geometry.Vector(x, from.y), style ~~ .glyph = "─") -- grid.put(Geometry.Vector(x, to.y), style ~~ .glyph = "─"))
    (from.y + 1..<to.y).for(y => grid.put(Geometry.Vector(from.x, y), style ~~ .glyph = "│") -- grid.put(Geometry.Vector(to.x, y), style ~~ .glyph = "│"))
    [(from, 0), (Geometry.Vector(to.x, from.y), 1), (Geometry.Vector(from.x, to.y), 2), (to, 3)].for((at, i) => grid.put(at, style ~~ .glyph = corners[i]))
  }
  Scrollbar := (shape: Geometry.Shape, grid: Grid) => cells(shape.size).y -- (0..<.).for(y => grid.put(cells(shape.position) + Geometry.Vector(cells(shape.size).x - 1, y), Cell(y == shape.scrolled.y * . / shape.content_height ? "┃" : "│")))
  Focus := (shape: Geometry.Shape, grid: Grid) => Area(shape).for(grid.cells[.y][.x] ~~ .underline = true)
  Sample := (paint: Geometry.Paint, at: Geometry.Vector) => paint.match
    Geometry.Color => paint
    Geometry.Gradient => paint.at(at.x / UI.Viewport.size.x * px_per_cell.x)
    * => None
  Braille := (dots: boolean[][]) => (0x2800 + [[0, 3], [1, 4], [2, 5], [6, 7]].zip(dots).map((bits, row) => row.zip(bits).map((on, bit) => on ? 2 ^ bit : 0).sum).sum) as Char
  Picture := class = source: Location {
    static ramp = " .:-=+*#%@"
    pixels => IO.read(source) as Geometry.Raster
    sampled (at: Geometry.Vector, of: Geometry.Vector) => pixels.at(at.x * pixels.width / of.x, at.y * pixels.height / of.y) -- Cell(ramp[.luminance * (ramp.length - 1) / 255], foreground: .)
  }

  // Cells to bytes: ANSI escapes, only for what changed. Terminals differ in levels composed onto this one (F-P1).
  ANSI := class = previous: Grid? {
    escape (code: String) => "\e[", code
    write (grid: Grid) => (Terminal.emit(grid.changes(previous).map((at, cell) => escape(at.y + 1, ";", at.x + 1, "H"), Style(cell), Hyperlink(cell), cell.glyph)), escape("0m")) -- (previous = grid)
    Style := (cell: Cell) => escape("0", (";1" if cell.bold), (";2" if cell.dim), (";3" if cell.italic), (";4" if cell.underline), (";9" if cell.strike),
      (";", Color(cell.foreground, 38)) if cell.foreground, (";", Color(cell.background, 48)) if cell.background, "m")
    Color := (color: Geometry.Color, layer: Number) => layer, ";2;", color.red, ";", color.green, ";", color.blue
    Hyperlink := (cell: Cell) => cell.link ? ("\e]8;;", cell.link as String, "\e\\") : "\e]8;;\e\\"
  }
  level := Cells + {
    {grid: Grid} => ANSI().write(grid)
  }

  // Terminal kinds: what differs is a level (F-P1). Colours are quantised, graphics and keyboards upgraded where the terminal can.
  XTerm256 := {
    {color: Geometry.Color} as ANSI.Color => (16 + 36 * (color.red * 5 / 255) + 6 * (color.green * 5 / 255) + color.blue * 5 / 255) -- (layer, ";5;", .)
  }
  TrueColor := { }
  WindowsTerminal := {
    {enter: Terminal.raw_mode} => enter -- Terminal.emit("\e[?9001h")
  }
  // Pixels where the terminal draws them: kitty graphics and sixel.
  Kitty := {
    {image: Geometry.Image} => Terminal.emit("\e_Ga=T,f=100;", IO.read(image.source) as Base64, "\e\\")
  }
  Sixel := {
    {image: Geometry.Image} => Terminal.emit("\eP0;0;0q", (IO.read(image.source) as Geometry.Raster) as Sixel.Encoding, "\e\\")
  }
  // The TUI inside a browser: the same cells written to a DOM grid (Platforms: "the TUI can also run in the browser").
  Browser := {
    {grid: Grid} => Web.DOM().write(Web.HTML.Element("pre", children: grid.cells.map(.map(.glyph) as String).join(\n)))
  }

  // Bytes from the terminal become device variables (F-D10b): keys with modifiers, SGR mouse, paste, focus, resize.
  read => (Terminal.read ?? "") ~= (events: Event[]) -- .events.for(.apply)
  Event := Key | Mouse | Paste | FocusChange | Resize
  Key := class ("\e[", (modifiers: "1;", modifier: Decimal)?, code: "A" | "B" | "C" | "D" | "H" | "F" | "Z") | ("\eO", code: "P" | "Q" | "R" | "S") | (code: Char) => {
    name => code.match
      "A" | "w" => Keyboard.Direction.up
      "B" | "s" => Keyboard.Direction.down
      "C" | "d" => Keyboard.Direction.right
      "D" | "a" => Keyboard.Direction.left
      "Q" => Keyboard.f2
      "\r" => Keyboard.enter
      "\t" | "Z" => Keyboard.tab
      * => Keyboard.key(code)
    shift => modifier && (modifier - 1) % 2 == 1
    control => modifier && (modifier - 1) / 4 % 2 == 1
    apply => Keyboard.press(name, shift, control) -- {
      UI.Focus.current = UI.Focus.next(UI.scene) if name == Keyboard.tab && !shift
      UI.Focus.current = UI.Focus.previous(UI.scene) if name == Keyboard.tab && shift
      UI.Focus.current.activate if name == Keyboard.enter
    }
  }
  Mouse := class ("\e[<", button: Decimal, ";", x: Decimal, ";", y: Decimal, state: "M" | "m") => {
    apply => UI.Pointer.pointers = [(mouse, Geometry.Vector(x - 1, y - 1) * px_per_cell, state == "M" ? 1 : 0, Geometry.Vector(), button < 64 && state == "M" ? [button % 4] : [])]
      -- (UI.Pointer.wheel = Geometry.Vector(y: button == 64 ? -1 : 1)) if button >= 64
      -- (UI.Pointer.released = state == "m")
  }
  Paste := class ("\e[200~", text: *, "\e[201~") => {
    apply => UI.Clipboard.content = text -- UI.Focus.current?.typed(text)
  }
  FocusChange := class ("\e[", state: "I" | "O") => {
    apply => UI.Viewport.preferences ~~ .focused = state == "I"
  }
  Resize := class => {
    apply => UI.Viewport.size = Geometry.Vector(Terminal.size.x * px_per_cell.x, Terminal.size.y * px_per_cell.y)
  }
}

// The terminal itself: one byte stream (F-D9). Raw mode, the alternate screen, mouse and paste reporting are bytes written to it.
Terminal := namespace {
  emit (bytes) => external io `stdout` (bytes)
  read => external io `stdin` None
  size => Geometry.Vector((external os `COLUMNS`) as Decimal, (external os `LINES`) as Decimal)
  raw_mode => emit("\e[?1049h", "\e[?25l", "\e[?1000h", "\e[?1006h", "\e[?2004h", "\e[?1004h")
  restore => emit("\e[?1004l", "\e[?2004l", "\e[?1006l", "\e[?1000l", "\e[?25h", "\e[?1049l")
}
