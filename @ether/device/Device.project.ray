@ether/geometry
@ether/version-control

// What a device can do is a path under it, granted like anything else (`@me.execute { @me/device/camera }`); a
// capability nobody granted is asked for (`&@.ask`).
Device := class {
  // The operating system it runs: the one the host reports, else the language as the operating system (`OS.Ether`).
  os: OS = OS.host
  keyboard: Keyboard = Keyboard()
  handheld = false
  clipboard: String | Location = ""
  orientation: Geometry.Vector?
  motion: Geometry.Vector?
  geolocation: (latitude: Number, longitude: Number, accuracy: Geometry.Length)?
  preferences: (reduced_motion: boolean, dark: boolean, contrast: more | less | normal, focused: boolean) = (false, false, normal, true)
  notification: (title: String, body: String)?
  fullscreen = false
  printing = false
  opened: Location?
  camera: *?
  microphone: *?
  speech: String?
  share: Location?
  vibration: Quantity.Temporal[]?
  wake_lock = false
  memory: Store = Store(at: @"memory")
  storage: Location = @"storage"
  quests => Program#{who: this}{running}
  // its files: this device's are the file space (`@/`), another's are at its instance (held by @ether/network)
  disk => Instance#{.device === this}.first -- (. && . !== Instance.local ? (. as String + "/") as Held : @/)

  static chooser: Program?
  choose (s, n: Number = 1) => Device.chooser ? Device.chooser(s, n) : s#.count is ∞ && !s#.some(.weight) ? ERROR@Type `no uniform choice exists over infinitely many possibilities; give them weights` : n == 1 ? s#.random : s#.subsets(n).random
  assert (Device().choose(Decimal)) is Diagnostic  // HS15 the computer chose uniformly among infinitely many possibilities
  assert Device().choose(("A" | "B" | "C"), 2).count == 2 && Device().choose(("A" | "B" | "C"), 2).first != Device().choose(("A" | "B" | "C"), 2).last  // CQ2 choosing two of three gave one of them twice
  // The chooser is a setting; a player's answer is a weighted alternative.
  assert {
    with Choice.algorithm = ((s, n) => "picked") {
      assert Device().choose(1 | 2) == "picked"  // CHS1 a chooser set with with is not asked
    }
  }
}
// Controllers are numbered on the device and take back their number (F-I1)
assert {
  pad_device := Device()
  assert pad_device.controllers.connected("pad A").name == 0 && pad_device.controllers.connected("pad A").guest  // FWU1 a new controller is not a guest with the first free id
  assert pad_device.controllers.connected("pad B").name == 1  // FWU2 a second controller does not take the next id
  pad_device.controllers.disconnected("pad A")
  assert pad_device.controllers.connected("pad A").name == 0  // FWU3 a reconnecting controller does not take back its id
}

Keyboard := class: Location {
  static Modifier := enum shift | control | alt | meta

  static Key := class: Nameable (code: Number?, modifiers: Modifier?) => {
    pressed = false

    presses => [pressed, pressed.previous**].flatten{== true}.count
    assert {
      tapped := Keyboard.Key(name: 2)
      assert tapped.presses == 0  // KB9 an untouched key has been pressed
      tapped.press
      assert tapped.presses == 1  // KB10 a press is not counted
      tapped.release
      tapped.press
      assert tapped.presses == 2  // KB11 two presses are not counted two
      options := [10, 20, 30]
      assert Keyboard.Key(name: 3).cycle(options) == 10  // KB12 a key never pressed does not answer the first entry
      assert Keyboard.Key(name: 4).press.cycle(options) == 20  // KB13 one press does not answer the second entry
      assert tapped.cycle(options) == 30  // KB14 two presses do not answer the third entry
      assert tapped.press.cycle(options) == 10  // KB15 three presses do not come back to the first entry
    }
    toggled => presses.odd
    // A key is pressed and released; what it toggles stays.
    assert {
      key := Keyboard.Key(name: 1)
      assert !(key.pressed)  // KB1 a new key is already pressed
      assert !(key.toggled)  // KB2 a new key is already toggled
      assert key.press.pressed  // KB3 pressing a key does not press it
      assert key.toggled  // KB4 pressing a key does not toggle it
      assert !(key.release.pressed)  // KB5 releasing a key does not release it
      assert key.toggled  // KB6 releasing a key untoggled it
      assert !(key.press.toggled)  // KB7 pressing again does not toggle back
      board := Keyboard()
      assert (board ~~ .add(key)).keys.count == 1  // KB8 a board with one key added does not hold one
    }
    pulsed (max: Number = 0, delay: Quantity.Temporal = 500 ms) => pressed && (max == 0 || presses <= max)
      && (presses == 1 || Time.now - pressed.history.since(None){.value == true}.last.when >= delay)

    press (modifiers: Modifier? = None): static => this ~~ (.modifiers = modifiers) ~~ (.pressed = true)
    assert (Keyboard.Key(name: "b").press).(
      .pressed  // FE13 a pressed key is not pressed
      & .toggled  // FE14 a pressed key is not toggled
      & !(.release.pressed)  // FE15 a released key is still pressed
    )
    assert (Keyboard.Key(name: 5).press).(
      .pressed  // KB16 a pressed key does not hold as a condition
      & !(.release.pressed)  // KB17 a released key holds as a condition
    )
    assert {
      keyboard := @me/device/keyboard
      keyboard["f"].press(Keyboard.Modifier.control)
      assert keyboard.pressed("f", modifier: Keyboard.Modifier.control | Keyboard.Modifier.meta)  // UI162 ctrl+f is not read as ctrl or cmd + f
      assert !(keyboard.pressed("f", modifier: Keyboard.Modifier.alt))  // UI163 ctrl+f is read as alt+f
      keyboard["f"].release
      assert !(keyboard.pressed("f"))  // UI164 a released key stays pressed
    }
    assert Keyboard.Key(name: "a").press.pressed  // WO9 a pressed key is not pressed
    release: static => this ~~ .pressed = false
    cycle (iterable) => iterable[presses % iterable.count]
  }
  // Keys: what a press and a release leave behind.
  assert Keyboard.Key(name: "a").(
    !(.pressed)  // FE11 an untouched key is pressed
    & !(.toggled)  // FE12 an untouched key is toggled
    & (Keyboard() ~~ .add(.)).keys.count == 1  // FE16 a keyboard given one key does not hold one
  )
  assert !(Keyboard.Key(name: 6).pressed)  // KB18 a key nobody pressed holds as a condition

  keys => children{is Key}
  [name] => keys{.name == name}.first ?? add(Key(name))
  coded (code: Number) => keys{.code == code}.first ?? add(Key(name: code as Char as String, code))
  pressed (name, modifier: Modifier? = None) => this[name] -- (key => key.pressed && (!modifier || modifier#.some(. is key.modifiers)))
  .{literal name ^property} ^punctuation => this[name]
}

// `choose n` chooses n distinct by identity: the same value at two locations is two.
assert Character(name: "chosen").(
  Device().choose((., ., "5"), 2).count == 2  // CQ1 choosing two did not give two
  & (0..<20).map(i => Device().choose((., ., "5"), 2)).some(.every(=== .))  // CQ3 one value written twice is never chosen twice
)
