  static span_mapped (o, c: Spanned, f, g) => truthy(call1(f, c.value)) ? Readings.span_marked(o, c, (g is Closure) ? call1(g, c.value) : g) : Spanned(name: c.name, from: c.from, to: c.to, value: c.value)
  static span_marked (o, c: Spanned, v) => {
