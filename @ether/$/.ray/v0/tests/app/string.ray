mark ^keyword := external global

ab := String.of(`ab`)
unless (ab.count == two) { INFO@mark `S1 ab has other than two characters` }

unless (ab.first.codepoint == ((ten * nine) + seven)) { INFO@mark `S2 a is not codepoint 97` }

unless (ab.last.codepoint == ((ten * nine) + eight)) { INFO@mark `S3 b is not codepoint 98` }

unless (String.of(`a`) == String.of(`a`)) { INFO@mark `S4 a != a` }

unless (String.of(`a`) != String.of(`b`)) { INFO@mark `S5 a == b` }

unless ((String.of(`a`) + String.of(`b`)) == ab) { INFO@mark `S6 a + b != ab` }

acute := String.of(`é`)
unless (acute.count == one) { INFO@mark `S7 é is not one character` }

unless (acute.first.width == two) { INFO@mark `S8 é is not two bytes wide` }

unless (acute.first.codepoint == ((two * hundred) + ((three * ten) + three))) { INFO@mark `S9 é is not codepoint 233` }

octet := chain None
octet &= 0
octet &= 1
octet &= 1
octet &= 0
octet &= 0
octet &= 0
octet &= 0
octet &= 1
unless (octet.count == eight) { INFO@mark `T1 manual bit chain does not count eight` }
unless (octet.head.value.not) { INFO@mark `T2 first manual bit is not 0` }
manual := Character(octets: octet)
unless (manual.width == one) { INFO@mark `T3 manual a is not one byte wide` }
unless (manual.codepoint == ((ten * nine) + seven)) { INFO@mark `T4 manual a is not codepoint 97` }
read := String.of(`a`).first
unless (read.octets.count == eight) { INFO@mark `T5 read a does not have eight octet` }
unless (read.octets.head.value.not) { INFO@mark `T6 read a first bit is not 0` }
unless (read.octets.head.next.value) { INFO@mark `T7 read a second bit is not 1` }

lone := String.of(`a`)
unless (lone.collected.count == eight) { INFO@mark `U1 collected octet of a are not eight` }
unless (lone.collected.head.value.not) { INFO@mark `U2 first collected bit is not 0` }
unless (lone.collected.head.next.value) { INFO@mark `U3 second collected bit is not 1` }
unless (lone.collected.tail.value) { INFO@mark `U4 last collected bit is not 1` }
unless (lone.characters.count == one) { INFO@mark `U5 a has other than one character` }
unless (lone.characters.head.value.octets.count == eight) { INFO@mark `U6 the character's octets are not eight` }

built := Character.of((ten * nine) + seven)
unless (built == manual) { INFO@mark `W1 Character.of(97) is not a` }
unless (Character.of((two * hundred) + ((three * ten) + three)) == acute.first) { INFO@mark `W2 Character.of(233) is not é` }
unless (ab.upper_case == String.of(`AB`)) { INFO@mark `W3 upper_case failed` }
unless (String.of(`Ab`).swap_case == String.of(`aB`)) { INFO@mark `W4 swap_case failed` }
unless (ab.mirrored == String.of(`ba`)) { INFO@mark `W5 mirrored failed` }
// TODO(engine) contains: a method's own `for` loop over `this` (engine: `has(this, x)` differs from `has(abc, x)`)
// goto w6_ok if (String.of(`abc`).contains(String.of(`bc`))).holds
// INFO@mark `W6 contains failed`
// w6_ok\
unless ((String.of(`abc`).contains(String.of(`ca`))).not) { INFO@mark `W7 contains found ca in abc` }
unless (String.of(`a b`).words.count == two) { INFO@mark `W8 words did not split in two` }
// TODO(engine) snake_case: String.joined over a chain built in a function (engine: `.head` on such a chain)
// goto w9_ok if (String.of(`a b`).snake_case == String.of(`a_b`)).holds
// INFO@mark `W9 snake_case failed`
// w9_ok\
// TODO(engine) pascal_case: same as W9
// goto w10_ok if (String.of(`ab cd`).pascal_case == String.of(`AbCd`)).holds
// INFO@mark `W10 pascal_case failed`
// w10_ok\
// TODO(engine) plural: String `==` against a string built by `+` inside a method
// goto w11_ok if (String.of(`cat`).plural == String.of(`cats`)).holds
// INFO@mark `W11 plural failed`
// w11_ok\
// TODO(engine) UTF16 encode count: `.count` on an `if` branch value in this position
// goto w12_ok if Unicode.UTF16.encode((ten * nine) + seven).count == (ten + six)
// INFO@mark `W12 UTF16 of a is not sixteen bits`
// w12_ok\
unless (Unicode.UTF32.decode(Unicode.UTF32.encode(ten)) == ten) { INFO@mark `W13 UTF32 round trip failed` }
unless (Unicode.category(manual) == Unicode.GeneralCategory.letter) { INFO@mark `W14 a is not a letter` }
// TODO(engine) regex: contains (see W6)
// goto w15_ok if (Regex.of(String.of(`b`)).matches(ab)).holds
// INFO@mark `W15 regex b did not match ab`
// w15_ok\
unless (String.of(`x`).repeat(three) == String.of(`xxx`)) { INFO@mark `W16 repeat failed` }
// TODO(engine) scalar: member access on chains built in functions (see W9)
// goto w17_ok if (Unicode.scalar(ten)).holds
// INFO@mark `W17 ten is not a scalar`
// w17_ok\
