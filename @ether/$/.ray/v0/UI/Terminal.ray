Language.TUI := class: Language {
  static extensions = ".tui"
  Cell := class = glyph: Char = " ", foreground: Geometry.Color?, background: Geometry.Color?, bold: boolean = false, italic: boolean = false, underline: boolean = false, strike: boolean = false, dim: boolean = false, reverse: boolean = false, link: Location?
  Grid := class = width: Number, height: Number, cells: Cell[][] = (0..<height).map((0..<width).map(Cell())), graphics: Graphic[] = [] {
    inside (at: Geometry.Vector) => 0 <= at.x < width && 0 <= at.y < height
    put (at: Geometry.Vector, cell: Cell) => cells[at.y][at.x] = cell if inside(at)
    cell (at: Geometry.Vector) => inside(at) ? cells[at.y][at.x] : Cell()
    changes (previous: Grid?) => (0..<height).map(y => (0..<width){!previous || cells[y][.] != previous.cells[y][.]}.map(x => (Geometry.Vector(x, y), cells[y][x]))).flatten
  }
  static px_per_cell = Geometry.Vector(8px, 16px)
  static cells (length: Geometry.Vector) => Geometry.Vector(length.x / px_per_cell.x, length.y / px_per_cell.y)

  Put := class = at: Geometry.Vector, cell: Cell {
    onto (grid: Grid) => grid.put(at, cell)
  }
  Background := class = at: Geometry.Vector, color: Geometry.Color? {
    onto (grid: Grid) => grid.put(at, grid.cell(at) ~~ .background = color)
  }
  Underlined := class = at: Geometry.Vector {
    onto (grid: Grid) => grid.put(at, grid.cell(at) ~~ .underline = true)
  }
  Reversed := class = at: Geometry.Vector {
    onto (grid: Grid) => grid.put(at, grid.cell(at) ~~ .reverse = true)
  }
  Linked := class = at: Geometry.Vector, to: Location {
    onto (grid: Grid) => grid.put(at, grid.cell(at) ~~ .link = to)
  }
  Faded := class = at: Geometry.Vector, amount: Probability {
    onto (grid: Grid) => grid.cell(at) -- (cell => grid.put(at, cell ~~ .foreground = cell.foreground?.mix(cell.background, 1 - amount)))
  }
  Shaded := class = at: Geometry.Vector {
    onto (grid: Grid) => grid.cell(at) -- (cell => grid.put(at, cell ~~ .background = (cell.background ?? Geometry.Color(0, 0, 0)).mix(Geometry.Color(0, 0, 0), 0.5)))
  }
  Graphic := class = at: Geometry.Vector, bytes: * {
    onto (grid: Grid) => grid.graphics.push this
  }
  Write := Put | Background | Underlined | Reversed | Linked | Faded | Shaded | Graphic

  Painting := class = grid: Grid, writes: *[]
  Paint := class = shape: Geometry.Shape, scrolled: Geometry.Length = 0px {
    at => cells(shape.origin - Geometry.Vector(0, scrolled))
    size => cells(shape.size)
    area => (at.y..<at.y + size.y).map(y => (at.x..<at.x + size.x).map(x => Geometry.Vector(x, y))).flatten{
      shape.contains(shape.transform.inverse.applied(Geometry.Vector((.x - at.x) * px_per_cell.x, (.y - at.y) * px_per_cell.y)))
    }
    inside (child: Geometry.Shape) => Paint(child, scrolled)
  }
  Boxed := class = paint: Paint
  Filled := class = paint: Paint
  Border := class = paint: Paint
  Shade := class = paint: Paint, effect: Geometry.Effect
  Scrollbar := class = paint: Paint
  Selected := class = paint: Paint

  rules := {
    {screen: UI.Screen} => Painting(Grid(UI.Viewport.size.x / px_per_cell.x, UI.Viewport.size.y / px_per_cell.y), screen.layers.map(Paint(., screen.scrolled)))
    {painting: Painting{writes.flatten.every(. is Write)}} => painting.writes.flatten.for(.onto(painting.grid)) -- painting.grid

    {paint: Paint{shape is Geometry.Text}} => {
      text = paint.shape
      lines = text.lines(text.size.x)
      starts = text.starts(text.size.x)
      (0..<lines.count).map(row => (0..<lines[row].length).reduce(placed = (column: 0, puts: []) => {
        run = text.run_at(starts[row] + .)
        face = run?.font ?? text.font
        (column: placed.column + lines[row][.].columns, puts: [placed.puts, Put(paint.at + Geometry.Vector(placed.column, row), Cell(lines[row][.],
          foreground: (run?.color ?? text.color) as Geometry.Color, background: (run?.fill ?? text.fill) as Geometry.Color,
          bold: face.weight >= 600, italic: face.style == italic, reverse: UI.Selection.selects(text, starts[row] + .)))].flatten)
      }).puts).flatten
    }
    {paint: Paint{shape is Geometry.Image && shape.fill}} => paint.area.map(Put(., Picture(paint.shape.source).tinted(. - paint.at, paint.size, paint.shape.fill as Geometry.Color)))
    {paint: Paint{shape is Geometry.Image}} => paint.area.map(Put(., Picture(paint.shape.source).sampled(. - paint.at, paint.size)))
    {paint: Paint{shape is Geometry.Canvas}} => paint.shape.draws.rendered(Language.Direct.level).rows -- (rows => paint.area.map(at => (at - paint.at) -- (dot =>
      Put(at, Cell(braille(rows[dot.y * 4..<dot.y * 4 + 4].map(.[dot.x * 2..<dot.x * 2 + 2].map(.alpha > 0)))))
    )))
    {paint: Paint{shape is Geometry.Frame}} => paint.inside(UI.Link(to: paint.shape.source, window: new, origin: paint.shape.origin, size: paint.shape.size, stroke: Geometry.Stroke(Geometry.Color(128, 128, 128)), children: [
      Geometry.Text("▶ " + (paint.shape.title.empty ? paint.shape.source as String : paint.shape.title), origin: paint.shape.origin + px_per_cell, size: paint.shape.size - px_per_cell * 2)
    ]))
    {paint: Paint{shape is UI.Link}} => [Boxed(paint), paint.area.map(Linked(., paint.shape.to))]
    {paint: Paint{shape is UI.Input}} => [Boxed(paint), paint.inside(paint.shape.face), Selected(paint)]
    {paint: Paint} => Boxed(paint)

    {boxed: Boxed} => boxed.paint -- (paint => [
      Filled(paint),
      Border(paint) if paint.shape.stroke,
      paint.shape.effects.map(Shade(paint, .)),
      paint.shape.in_place.sort_by(.layer).map(paint.inside(.)) if paint.shape.visible,
      Scrollbar(paint) if paint.shape.overflow == scroll,
      paint.area.map(Underlined(.)) if UI.Focus.current === paint.shape
    ])
    {filled: Filled{paint.shape.fill is Geometry.Color}} => filled.paint.area.map(Background(., filled.paint.shape.fill))
    {filled: Filled{paint.shape.fill is Geometry.Gradient}} => filled.paint.area.map(Background(., filled.paint.shape.fill.at(.x / UI.Viewport.size.x * px_per_cell.x)))
    {filled: Filled} => []
    {shade: Shade{effect is Geometry.Opacity}} => shade.paint.area.map(Faded(., shade.effect.amount))
    {shade: Shade{effect is Geometry.Shadow}} => shade.paint.area.map(Shaded(. + cells(shade.effect.offset)))
    {shade: Shade} => []
    {border: Border} => {
      paint = border.paint
      corners = paint.shape.radius != [0] ? "╭╮╰╯" : "┌┐└┘"
      from = paint.at
      to = from + paint.size - Geometry.Vector(1, 1)
      ink = paint.shape.stroke.paint as Geometry.Color
      sides = paint.shape.stroke.sides
      [
        (from.x..to.x).map(Underlined(Geometry.Vector(., to.y))) if sides == bottom,
        (from.x + 1..<to.x).map(Put(Geometry.Vector(., from.y), Cell("─", foreground: ink))) if sides is (all | top | horizontal),
        (from.x + 1..<to.x).map(Put(Geometry.Vector(., to.y), Cell("─", foreground: ink))) if sides is (all | horizontal),
        (from.y + 1..<to.y).map(Put(Geometry.Vector(from.x, .), Cell("│", foreground: ink))) if sides is (all | left | vertical),
        (from.y + 1..<to.y).map(Put(Geometry.Vector(to.x, .), Cell("│", foreground: ink))) if sides is (all | right | vertical),
        [(from, 0), (Geometry.Vector(to.x, from.y), 1), (Geometry.Vector(from.x, to.y), 2), (to, 3)].map((at, i) => Put(at, Cell(corners[i], foreground: ink))) if sides == all
      ]
    }
    {scrollbar: Scrollbar} => scrollbar.paint -- (paint => (0..<paint.size.y).map(y =>
      Put(paint.at + Geometry.Vector(paint.size.x - 1, y), Cell(y == paint.shape.scrolled.y * paint.size.y / paint.shape.content_height ? "┃" : "│"))
    ))
    {selected: Selected{UI.Selection.range?.shape === paint.shape}} => selected.paint.inside(selected.paint.shape.face).at -- (from =>
      (UI.Selection.range.from..<UI.Selection.range.to).map(Reversed(Geometry.Vector(from.x + ., from.y)))
    )
    {selected: Selected} => []
  }
  Cells := UI.Rendering + UI.Scrolling + rules
  level := Cells

  static braille (dots: boolean[][]) => (0x2800 + [[0, 3], [1, 4], [2, 5], [6, 7]].zip(dots).map((bits, row) => row.zip(bits).map((on, bit) => on ? 2 ^ bit : 0).sum).sum) as Char
  Picture := class = source: Location {
    static ramp = " .:-=+*#%@"
    pixels => IO.read(source) as Geometry.Raster
    pixel (at: Geometry.Vector, of: Geometry.Vector) => pixels.at(at.x * pixels.width / of.x, at.y * pixels.height / of.y)
    sampled (at: Geometry.Vector, of: Geometry.Vector) => pixel(at, of) -- Cell(ramp[.luminance * (ramp.length - 1) / 255], foreground: .)
    tinted (at: Geometry.Vector, of: Geometry.Vector, ink: Geometry.Color?) => pixel(at, of) -- Cell(ramp[.alpha * (ramp.length - 1)], foreground: ink)
  }

  ANSI := class {
    Frame := class = changes: (at: Geometry.Vector, cell: Cell)[], title: String?, graphics: Graphic[] = []
    Title := class = text: String
    Move := class = at: Geometry.Vector
    Style := class = cell: Cell
    Color := class = color: Geometry.Color, layer: Number
    Hyperlink := class = cell: Cell
    Start := class
    Stop := class
    Copy := class = text: String
    written := {
      {start: ANSI.Start} => Terminal.entering, Terminal.clearing
      {stop: ANSI.Stop} => Terminal.restoring
      {copy: ANSI.Copy} => "\e]52;c;", Base64.encoded(copy.text.bytes), "\a"
      {frame: ANSI.Frame} => [
        Title(frame.title) if frame.title,
        frame.changes.map((at, cell) => [Move(at), Style(cell), Hyperlink(cell), cell.glyph]),
        frame.graphics.map([Move(.at), .bytes]),
        "\e[0m"
      ]
      {title: ANSI.Title} => "\e]0;", title.text, "\a"
      {move: ANSI.Move} => "\e[", move.at.y + 1, ";", move.at.x + 1, "H"
      {style: ANSI.Style} => style.cell -- (cell => "\e[0", (";1" if cell.bold), (";2" if cell.dim), (";3" if cell.italic), (";4" if cell.underline), (";9" if cell.strike), (";7" if cell.reverse),
        (";", Color(cell.foreground, 38)) if cell.foreground, (";", Color(cell.background, 48)) if cell.background, "m")
      {color: ANSI.Color} => color.layer, ";2;", color.color.red, ";", color.color.green, ";", color.color.blue
      {link: ANSI.Hyperlink{cell.link}} => "\e]8;;", link.cell.link as String, "\e\\"
      {link: ANSI.Hyperlink} => "\e]8;;\e\\"
    }
  }

  Target := class = written: Compiler = ANSI.written, previous: Grid?, title: String? {
    start => Terminal.emit(Compiler.reduced(ANSI.Start(), written) as String)
    stop => Terminal.emit(Compiler.reduced(ANSI.Stop(), written) as String)
    framed (grid: Grid) => ANSI.Frame(grid.changes(previous), UI.Navigation.title if UI.Navigation.title != title, grid.graphics{!(previous?.graphics.contains(.) ?? false)})
    write (grid: Grid) => Terminal.emit(Compiler.reduced(framed(grid), written) as String) -- (previous = grid) -- (title = UI.Navigation.title)
    read => Language.TUI.read
    copy (text: String) => Terminal.emit(Compiler.reduced(ANSI.Copy(text), written) as String)
    open (to: Location) => UI.Platform.launch(to)
  }

  XTerm256 := {
    {color: ANSI.Color} => color.layer, ";5;", 16 + 36 * (color.color.red * 5 / 255) + 6 * (color.color.green * 5 / 255) + color.color.blue * 5 / 255
  }
  TrueColor := { }
  WindowsTerminal := {
    {start: ANSI.Start} => Terminal.entering, "\e[?9001h", Terminal.clearing
  }
  Kitty := {
    {paint: Paint{shape is Geometry.Image}} => Graphic(paint.at, ("\e_Ga=T,f=100;", Base64.encoded(IO.File(paint.shape.source as String).bytes), "\e\\"))
  }
  Sixel := {
    {paint: Paint{shape is Geometry.Image}} => Graphic(paint.at, ("\eP0;0;0q", sixel(IO.read(paint.shape.source) as Geometry.Raster), "\e\\"))
  }
  static sixel (raster: Geometry.Raster) => raster.pixels.unique.enumerate -- (palette => (
    palette.map("#", .index, ";2;", .value.red * 100 / 255, ";", .value.green * 100 / 255, ";", .value.blue * 100 / 255),
    (0..<(raster.height + 5) / 6).map(band => palette.map(
      "#", .index, (0..<raster.width).map(x => ((0..<6).map(row => raster.at(x, band * 6 + row) == .value ? 2 ^ row : 0).sum + 63) as Char), "$"
    ), "-")
  ))
  Browser := {
    {grid: Grid} => Language.Web.Package([(path: "index.html", content: Language.Web.HTML.Document(head: [], body: Language.Web.HTML.Element("body", children: [
      Language.Web.HTML.Element("pre", children: [Language.Web.HTML.Text(grid.cells.map(.map(.glyph) as String).join(\n))])
    ])))])
  }

  static read => (Terminal.read ?? "") ~= (events: Event[]) -- .events.for(.apply)
  Event := Key | Mouse | Paste | FocusChange | Resize
  Key := class ("\e[", (modifiers: "1;", modifier: Decimal)?, code: "A" | "B" | "C" | "D" | "H" | "F" | "Z") | ("\eO", code: "P" | "Q" | "R" | "S") | ("\e[", page: "5" | "6", "~") | ("\e", alt: Char) | (code: Char) => {
    lettered => code && (code as Number) < 27 && !(code is ("\r" | "\t"))
    static Named = { "A": Keyboard.Direction.up, "w": Keyboard.Direction.up, "B": Keyboard.Direction.down, "s": Keyboard.Direction.down, "C": Keyboard.Direction.right, "d": Keyboard.Direction.right,
      "D": Keyboard.Direction.left, "a": Keyboard.Direction.left, "Q": Keyboard.f2, "\r": Keyboard.enter, "\t": Keyboard.tab, "Z": Keyboard.tab }
    name => page ? Keyboard.named(page == "5" ? "PageUp" : "PageDown") : alt ? Keyboard.named(alt as String) : lettered ? Keyboard.named(((code as Number) + 96) as Char as String) : Named[code] ?? Keyboard.key(code)
    shift => modifier && (modifier - 1) % 2 == 1
    control => modifier && (modifier - 1) / 4 % 2 == 1 || lettered
    apply => UI.Keyboard.press(name, shift, control, alt != None) -- {
      UI.Viewport.scroll((page == "5" ? -1 : 1) * UI.Viewport.size.y) if page
      UI.Selection.move(name) if name is Keyboard.Direction && !shift && !control
      UI.Selection.skip(name) if name is Keyboard.Direction && control
      UI.Selection.expand(name) if name is Keyboard.Direction && shift
      UI.Focus.current = UI.Focus.next(UI.scene) if name == Keyboard.tab && !shift
      UI.Focus.current = UI.Focus.previous(UI.scene) if name == Keyboard.tab && shift
      (UI.Focus.current ?? UI.Selection.current)?.activate if name == Keyboard.enter
      UI.Runtime.current?.stop if code == "q"
    }
  }
  Mouse := class ("\e[<", button: Decimal, ";", x: Decimal, ";", y: Decimal, state: "M" | "m") => {
    position => Geometry.Vector((x - 1) * px_per_cell.x, (y - 1) * px_per_cell.y)
    apply => button >= 64 ? (UI.Pointer.wheel = Geometry.Vector(y: button == 64 ? -1 : 1)) -- UI.Viewport.scroll(UI.Pointer.wheel.y * 3 * px_per_cell.y)
      : state == "m" ? UI.Pointer.up(position)
      : button >= 32 ? UI.Pointer.moved(position)
      : UI.Pointer.down(position)
  }
  Paste := class ("\e[200~", text: *, "\e[201~") => {
    apply => UI.Clipboard.content = text -- UI.Focus.current?.typed(text)
  }
  FocusChange := class ("\e[", state: "I" | "O") => {
    apply => UI.Viewport.preferences ~~ .focused = state == "I"
  }
  Resize := class => {
    apply => UI.Viewport.size = Geometry.Vector(Terminal.size.x * px_per_cell.x, Terminal.size.y * px_per_cell.y)
  }
}

Terminal := class {
  static entering = "\e[?1049h\e[?25l\e[?1000h\e[?1002h\e[?1006h\e[?2004h\e[?1004h"
  static clearing = "\e[2J\e[H"
  static restoring = "\e[?1004l\e[?2004l\e[?1006l\e[?1002l\e[?1000l\e[?25h\e[?1049l"
  emit (bytes) => external io `stdout` (bytes)
  read => external io `stdin` None
  size => Geometry.Vector((external os `COLUMNS`) as Decimal, (external os `LINES`) as Decimal)
  raw_mode => emit(entering)
  clear => emit(clearing)
  restore => emit(restoring)
}

Language.register(Language.TUI)
