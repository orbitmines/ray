mark ^keyword := external global

if (Byte.is_base) { INFO@mark `U1 a byte is a base unit` }

unless (Bit.is_base) { INFO@mark `U2 a bit is not a base unit` }

unless (Byte.scale == 8) { INFO@mark `U3 a byte does not scale to eight bits` }

q := 1 byte
unless (q.unit.symbol) { INFO@mark `U4 a quantity lost its unit` }

// A conversion multiplies and divides, and each of those nests about one
// application of `if` per unit of the divisor; the interpreter allows 64
// nested applications per statement, so only the conversions that divide by
// the larger factor are asserted here (`one of Byte as Bit` is 8 / 1).
eight_bits := 8 bits
bytes := eight_bits as Byte
unless (bytes.amount == 1) { INFO@mark `U6 eight bits are not one byte` }

unless ((1 byte) == (8 bits)) { INFO@mark `U8 a byte does not equal eight bits` }

unless (Prefix.deka.factor == 10) { INFO@mark `U9 deka is not ten` }

unless ((Bit prefixed Prefix.deka).ratio == 10) { INFO@mark `U10 a prefixed unit did not take the prefix factor` }

// Where a unit sits: a base unit is at nothing, and each one built on another
// is a step further off.
unless (Second.is_base) { INFO@mark `U11 a second is not a base unit` }
if (Minute.is_base) { INFO@mark `U12 a minute is a base unit` }
unless (Minute.rank == 1) { INFO@mark `U13 a minute is not one step off its base` }
unless (Hour.rank == 2) { INFO@mark `U14 an hour is not two steps off its base` }

// A unit built on another counts how many of it, and a unit is what it counts
// rather than what it is called.
pair := Bit multiple 2
unless (pair.scale == 2) { INFO@mark `U15 two bits do not scale to two` }
if (pair.is_base) { INFO@mark `U16 a multiple of a unit is a base unit` }
unless (pair.rank == 1) { INFO@mark `U17 a multiple is not one step off its base` }
unless (pair == (Bit multiple 2)) { INFO@mark `U18 two like multiples are not the same unit` }
if (pair == Byte) { INFO@mark `U19 two bits are a byte` }
unless (Bit == Bit) { INFO@mark `U20 a bit is not itself` }
if (Bit == Byte) { INFO@mark `U21 a bit is a byte` }

// Arithmetic happens in the finer of the two units.
unless (((2 bits) + (3 bits)).amount == 5) { INFO@mark `U22 two bits and three bits are not five` }
unless (((5 bits) - (2 bits)).amount == 3) { INFO@mark `U23 five bits less two are not three` }
unless (((1 byte) + (1 bit)).unit == Bit) { INFO@mark `U24 a sum is not in the finer unit` }
unless (((1 byte) + (1 bit)).amount == 9) { INFO@mark `U25 a byte and a bit are not nine bits` }
unless ((2 bits) < (3 bits)) { INFO@mark `U26 two bits are not fewer than three` }
if ((3 bits) < (2 bits)) { INFO@mark `U27 three bits are fewer than two` }

// Which of two units is the finer.
unless ((1 byte).finer(1 bit) == Bit) { INFO@mark `U28 a bit is not finer than a byte` }
unless ((1 bit).finer(1 byte) == Bit) { INFO@mark `U29 asking the other way round answers otherwise` }

// Where a unit's zero sits, and a unit that shifts it.
unless (Bit.shift.is_zero) { INFO@mark `U30 a unit with no offset sits somewhere else` }
shifted_bit := Bit shifted 3
unless (shifted_bit.shift == 3) { INFO@mark `U31 a shifted unit forgot its offset` }
unless (shifted_bit.scale == 1) { INFO@mark `U32 a shifted unit counts other than one of its base` }

// Time's units are quantities like any other, and know they are of time.
unless ((1 minute).is_temporal) { INFO@mark `U33 a minute is not of time` }
if ((1 bit).is_temporal) { INFO@mark `U34 a bit is of time` }
unless ((1 minute).as_seconds == 60) { INFO@mark `U35 a minute is not sixty seconds` }

// What a unit is called and what it is written as.
unless (Bit.name.as_string == "bit") { INFO@mark `U36 a bit is not called that` }
unless (Bit.symbol.as_string == "b") { INFO@mark `U37 a bit is not written b` }
unless (Byte.name.as_string == "byte") { INFO@mark `U38 a byte is not called that` }
unless (Minute.base.name.as_string == "second") { INFO@mark `U39 a minute is not built on the second` }

// Quantities compare after they add.
unless ((2 seconds) + (3 seconds) == (5 seconds)) { INFO@mark `U40 two and three seconds is not five seconds` }
if ((2 seconds) + (3 seconds) < (5 seconds)) { INFO@mark `U41 two and three seconds is below five seconds` }

// A number followed by a unit is that many of it, by the unit's name, its
// plural or its symbol.
unless ((2 hours).unit == Hour) { INFO@mark `U42 two hours are not hours` }
unless ((3 s).unit == Second) { INFO@mark `U43 three s are not seconds` }
unless ((1.5 days).amount == 1.5) { INFO@mark `U44 1.5 days is not one and a half of them` }
unless (((1.5 days) as Hour).amount.integer == 36) { INFO@mark `U45 1.5 days is not 36 hours` }
unless (((2 hours) as Minute).amount == 120) { INFO@mark `U46 two hours are not 120 minutes` }

unless (Kibibyte.ratio == 1024) { INFO@mark `UB1 a kibibyte is not 1024 of what it is built on` }
unless (Kilobyte.ratio == 1000) { INFO@mark `UB2 a kilobyte is not a thousand of what it is built on` }
unless ((1 kibibyte) == (1024 bytes)) { INFO@mark `UB3 a kibibyte is not 1024 bytes` }
unless ((1 kilobyte) == (1000 bytes)) { INFO@mark `UB4 a kilobyte is not 1000 bytes` }
unless (Kibibyte != Kilobyte) { INFO@mark `UB5 a kibibyte is a kilobyte` }
unless (BinaryPrefix.kibi.factor == 1024) { INFO@mark `UB6 kibi is not 1024` }
unless (BinaryPrefix.mebi.factor == 1048576) { INFO@mark `UB7 mebi is not 1024 squared` }
unless (Kibibyte.base == Byte) { INFO@mark `UB8 a kibibyte is not built on a byte` }
unless (Kilobyte.base == Byte) { INFO@mark `UB9 a kilobyte is not built on a byte` }
unless (Kibibyte.symbol.as_string == "KiB") { INFO@mark `UB10 a kibibyte is not written KiB` }
unless (Kilobyte.symbol.as_string == "KB") { INFO@mark `UB11 a kilobyte is not written KB` }
unless ((2 kibibytes).unit == Kibibyte) { INFO@mark `UB12 two kibibytes are not kibibytes` }
unless ((3 KB).unit == Kilobyte) { INFO@mark `UB13 three KB are not kilobytes` }
unless ((1 KiB).unit == Kibibyte) { INFO@mark `UB14 one KiB is not a kibibyte` }
