  static mapped_by (x, f, g) => (x is Text) ? mapped_text(x, f, g) : (((x is Node) && (member(x, Symbol.text) != None)) ? mapped_structure(x, f, g) : x)
  static place (t, ctx) => Place(name: intern(((t is Node) ? member(t, Symbol.text) : t)), kind: 0, given: ctx)
  static readsv (p, t) => (p is Node) ? Calls.read_keyed(p, t, member(p, Symbol.key)) : reads(topattern(p), t)
  static read_keyed (p, t, k) => (k == None) ? reads(topattern(p), t) : Calls.read_measured(p, t, k, reads(topattern(k), t))
  static read_measured (p, t: Text, k, r) => {
    Calls.read_put(p, t, k, r) if r != 0
    r
  }
  static read_put (p, t: Text, k, r) => {
    define(p, Symbol.length, int(((r - t.from) * 2) + Keys.led_by_text(topattern(k))))
    define(p, Symbol.whole, wholly)
  }
  static name_text (sym) => (sym >= 1000000) ? at(names, sym - 1000000) : at(csyms, sym - 16)
  static intern (t: Text) => Calls.intern_from(t, Calls.text_index(csyms, t))
  static intern_from (t, i) => (i >= 0) ? (16 + i) : Calls.name_found(t, Calls.text_index(names, t))
  static name_found (t, i) => (i >= 0) ? (1000000 + i) : Calls.name_added(t, Texts.count_of(names))
  static name_added (t, i) => (logging() && (lasting_name(t) != 0)) ? (1000000 + i) : Calls.name_kept(t, i)
  static name_kept (t, i) => {
