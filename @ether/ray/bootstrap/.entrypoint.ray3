assert {
  kept_under := { }
  kept_under[5] = 3
  kept_under[6] = 4
  assert kept_under[5] == 3  // MP1 a value held under a key is not what was given
  assert kept_under.keyed.count == 2  // MP2 two keys hold other than two entries
