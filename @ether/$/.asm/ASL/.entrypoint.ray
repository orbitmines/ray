FALSE ^keyword := Term.truth(false)
EL0 ^keyword := Term.named(`EL0`)

// A name or a number, and nothing else: a raw capture runs on to the next
// place its closing is written, past the end of its line, and a declaration
// `var x : bits(N);` would take the line after `var y : bits(N) = …;` for its
