// Features: what the machine hands over, what is chosen, what is proved, and
// what a transaction remembers.

mark ^keyword := external global

unless (exists Random.bit) { INFO@mark `FE1 a bit from the machine is nothing` }
unless (Random.bits(three).count == three) { INFO@mark `FE2 three bits are not three` }
unless (exists Choice.coin) { INFO@mark `FE3 a coin comes up with nothing` }

t := Transaction(forwards: one, backwards: two)
unless (t.forwards == one) { INFO@mark `FE4 a transaction forgot the step it takes` }
unless (t.reversed.forwards == two) { INFO@mark `FE5 a reversed transaction does not swap what it holds` }
unless (t.mark_applied.applied) { INFO@mark `FE6 a transaction does not remember being applied` }

unless (Proof.rfl(Proof.Proposition(holds: true))) { INFO@mark `FE7 what holds is not proved by itself` }
if (Proof.rfl(Proof.Proposition(holds: false))) { INFO@mark `FE8 what does not hold is proved by itself` }

unless (exists Transaction.Inverse.plus) { INFO@mark `FE9a the inverses have no plus` }
unless (String.of(Transaction.Inverse.plus.is) == String.of(`-`)) { INFO@mark `FE9b the inverse of plus is not minus` }
unless (exists Transaction.Inverse.minus) { INFO@mark `FE9 the inverses have no minus` }
unless (String.of(Transaction.Inverse.minus.is) == String.of(`+`)) { INFO@mark `FE10 the inverse of minus is not plus` }

// Keys: what a press and a release leave behind.
fresh_key := Keyboard.Key(name: String.of(`a`))
if (fresh_key.pressed) { INFO@mark `FE11 an untouched key is pressed` }
if (fresh_key.toggled) { INFO@mark `FE12 an untouched key is toggled` }
pushed_key := Keyboard.Key(name: String.of(`b`)).press
unless (pushed_key.pressed) { INFO@mark `FE13 a pressed key is not pressed` }
unless (pushed_key.toggled) { INFO@mark `FE14 a pressed key is not toggled` }
if (pushed_key.release.pressed) { INFO@mark `FE15 a released key is still pressed` }
unless (Keyboard(keys: (chain None)).add(fresh_key).keys.count == one) { INFO@mark `FE16 a keyboard given one key does not hold one` }
