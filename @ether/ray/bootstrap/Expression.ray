    while (q + (l.to - l.from)) <= e {
      return 1 if (byte(q) == byte(l.from)) && texteq(q, l.from, l.to - l.from)
      q = q + 1
    }
    0
  }
  // (an index of a text: the count of each byte and each byte pair before it, then where each pair is, then each byte)
  static occurs_based (x, nb, l: Text, a, e) => (Indexes.based_bytes(x, l, a, e) == 0) ? 0 : (((l.to - l.from) == 1) ? 1 : ((Indexes.based_pairs(x, x + (((257 + 4097) + nb) * 4), l, a, e) == 0) ? 0 : Indexes.based_found(x + (((257 + 4097) + nb) * 4), l, a, e, x)))
  static based_bytes (x, l: Text, a, e) => {
    i := 0
