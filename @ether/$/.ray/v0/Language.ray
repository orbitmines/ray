Language := class = extensions: String | String[], location: Location[] = [], level: Compiler?, reader: Function?, writer: Function?, fragment: *?, of: Language?, version: Version?, versions: Language[] = [], implementations: Implementation[] = [], targets: Language[] = [] {
  static known: Language[] = []
  static register (language: Language) => known.push language -- language
  static named (extension: String) => known{.names(extension)}.first
  static over (outer: Language, base: Language) => Language(outer.extensions, location: outer.location, level: outer.level, reader: outer.reader, writer: outer.writer, fragment: outer.fragment, of: base, version: outer.version)

  static for_file (file_name: String) => file_name ~= (*, ".", inner: Char.Word[], ".ray") ⊣
    ? (named("." + inner) ? over(named("." + inner), ray) : ray)
    : named("." + (file_name ~= (*, ".", last: Char.Word[]) ⊣)?.last) ?? ray
  static ray => named(".ray")
  static fragment_of (extension: String) => named("." + extension)?.fragment
  static block_of (extension: String) => fragment_of(extension) -- (fragment => fragment && ("{", Char.Blank, parts: (Char.Blank[], part: fragment | Hole)[], Char.Blank[], "}"))

  static Hole := class ("{", code: Code{nonempty && !(first is Char.Blank)}, "}") => {
    built (reading: Program) => reading(code)
  }
  static Code = (!("{" | "}") | ("{", Code, "}"))[]
  static Escape := class (\\, character: "{" | "}" | \\) => {
    as (=== String) => character
    built (reading: Program) => character
  }
  static Splice := class (Char.Blank[], hole: Hole) => {
    built (reading: Program) => hole.built(reading)
  }
  static Line := class (code: (!\n)[]{length > 0}) => {
    built (reading: Program) => reading(code)
  }
  static composed (parts, reading: Program) => parts.map(. is String ? . : .built(reading)) -- (.empty ? "" : .count == 1 ? .first : .reduce(,))
  static joined (parts, reading: Program) => parts.map(. is String ? . : (.built(reading) as String)).join("")

  static ray_written (value) => value === None ? "None"
    : value is String ? "\"" + value + "\""
    : value is Number ? value as 10 as String
    : value is Iterable ? "[" + value.map(ray_written).join(", ") + "]"
    : "(" + value.fields.map(.name + ": " + ray_written(.value)).join(", ") + ")"

  names (extension: String) => extensions == extension
  bundled (path: String) => location.map(. / path){IO.read(. / ".project.ray")}.first as Project

  read (text) => reader?((of?.read(text)) ?? text) ?? Quest(name: "a reader for the language", goal: this)
  write (value) => writer ? (of?.write(writer(value)) ?? writer(value)) : Quest(name: "a writer for the language", goal: this)

  target (language: Language) => targets.push language -- this
  targeting (language: Language) => targets.contains(language)
  implement (implementation: Implementation) => implementations.push implementation -- this
  versioned (language: Language) => versions.push language -- this
  backwards_compatible => versions{.version < version}.every(.targeting(this))
  forwards_compatible => versions{.version > version}.every(.targeting(this))

  static Implementation := class = language: Language, written_in: Language, location: Location {
    source => IO.read(location)
    reader => written_in.read(source)
    setup => language.implement(this) -- language.reader ??= reader -- language
  }

  static Sublanguage := class: Language = excluded: Effects.Source[] = [], terminating: boolean = true {
    admits (program: Program) => !Effects.of(program).some(excluded.contains(.)) && (!terminating || program is Terminating)
    read (text) => of.read(text) -- admits(.) ? . : ERROR `this file is written in a sublanguage that does not permit what it does`
  }
}

Library := class: Language
Tool := class = location: Location[] = []

Language.register(Language(".ray", level: Compiler.default, writer: Language.ray_written, fragment: Language.Line))
Language.cfg = Language.register(Language.Sublanguage(extensions: ".cfg", of: Language.ray, excluded: [io, os, random, time, network] as Effects.Source[]))
Language.regex = Language.register(Language(".regex"))

Regex := class (pattern: String) => {
  language => Language.regex
  compiled => language.read(pattern)
  matches (text: String) => text ~= compiled
  find (text: String) => (text ~= compiled)?.index
  ignoring_case => Regex(pattern.fold_case)
}
