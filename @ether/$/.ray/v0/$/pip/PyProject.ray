// pyproject.toml, PEP 621 (https://packaging.python.org/en/latest/specifications/pyproject-toml/) and Poetry's table (https://python-poetry.org/docs/pyproject/)
PyProject := Package("pyproject.toml" | ".pip", ecosystem: "pip", versioned: SemVer, ranges: Requirement, kinds: ["dependencies"], bare: "==",
  level: TOML.level + {
    {manifest: Document{project}} => Project(name: manifest.project.name, version: manifest.project.version as SemVer, description: manifest.project.description, manager: PyProject,
      dependencies: [(manifest.project.dependencies ?? []).map(. as Pip.Specifier){.applies}.map(.dependency("dependencies")),
        (manifest.project["optional-dependencies"]?.entries ?? []).map(group => group.value.map((. as Pip.Specifier).dependency(group.name)))].flatten.compact)
    {manifest: Document{tool?.poetry}} => manifest.tool.poetry -- (poetry => Project(name: poetry.name, version: poetry.version as SemVer, description: poetry.description, manager: PyProject,
      dependencies: (poetry.dependencies?.entries ?? []){.name != "python"}.map(PyProject.depending(.name, .value, "dependencies", "^"))))
  },
  written: { {writing: Language.Writing{value is Project}} => writing.value -- (project => Language.Writing(Document(entries: [(name: "project", value: Document(entries: [PyProject.described(project),
    (name: "dependencies", value: project.dependencies{.kind == "dependencies"}.map(.name + (.version ? .version as String : "")))].flatten)),
    (name: "optional-dependencies", value: Document(entries: project.dependencies{.kind != "dependencies"}.map(.kind).unique.map(kind => (name: kind, value: project.dependencies{.kind == kind}.map(.name + (.version ? .version as String : "")))))) if project.dependencies.some(.kind != "dependencies")]))) } + TOML.written,
  available: name => (("https://pypi.org/pypi/" + name + "/json") as Location).content -- (text => (text as JSON).value.releases.names),
  fetched: (name, version, into) => Process(command: "python3", arguments: ["-m", "pip", "install", "--target", into.sandboxed, name + "==" + version]))

Requirements := Package("requirements.txt", ecosystem: "pip", versioned: SemVer, ranges: Requirement, bare: "==",
  level: { {text: String} => Project(manager: Requirements, dependencies: (text as Pip.Requirements).specifiers.map(.dependency("dependencies"))) },
  written: { {writing: Language.Writing{value is Project}} => writing.value.dependencies.map(.name, (.version ? .version as String : ""), \n) },
  available: PyProject.available, fetched: PyProject.fetched)
