// What a device can do is a path under it, granted like anything else (`@me.execute { @me/device/camera }`); a
// capability nobody granted is asked for (`&@.ask`).
Device := class {
  // The operating system it runs: the one the host reports, else the language as the operating system (`OS.Ether`).
  os: OS = OS.host
  keyboard: Keyboard = Keyboard()
  handheld = false
  clipboard: String | Location = ""
  orientation: Geometry.Vector?
  motion: Geometry.Vector?
  geolocation: (latitude: Number, longitude: Number, accuracy: Geometry.Length)?
  preferences: (reduced_motion: boolean, dark: boolean, contrast: more | less | normal, focused: boolean) = (false, false, normal, true)
  notification: (title: String, body: String)?
  fullscreen = false
  printing = false
  opened: Location?
  camera: *?
  microphone: *?
  speech: String?
  share: Location?
  vibration: Quantity.Temporal[]?
  wake_lock = false
  memory: Store = Store(at: @"memory")
  storage: Location = @"storage"
  streams: Location = @"streams"
  quests => Program#{who: this}{running}
  disk => Disk(device: this, path: "")

  // A stream (stdout, stdin, window, dom, …): the host's; on ether a place on the device, where what is sent waits, in order,
  // until it is received (whoever plays the terminal or the window reads and writes the same place).
  sent (stream: String, content) => if OS.Ether { streams[stream] = [streams[stream] ?? [], [content]].flatten(1) } else { external io stream content }
  received (stream: String) => if OS.Ether { (streams[stream] ?? []) -- (waiting => (streams[stream] = waiting.rest) -- waiting.first) } else { external io stream None }
  // A location opened by what the host opens it with.
  launch (location: Location) => if OS.Ether || OS.Browser { ERROR@OS `opening a location is not written in Ray yet` } else { external os `open` (location as String) }

  static chooser: Program?
  choose (s, n: Number = 1) => Device.chooser ? Device.chooser(s, n) : s#.count is ∞ && !s#.some(.weight) ? ERROR@Type `no uniform choice exists over infinitely many possibilities; give them weights` : n == 1 ? s#.random : s#.subsets(n).random
}

Keyboard := class: Location {
  static Modifier := enum shift | control | alt | meta

  static Key := class: Nameable = code: Number?, modifiers: Modifier? {
    pressed = false

    presses => [pressed, pressed.previous**].flatten{== true}.count
    toggled => presses.odd
    pulsed (max: Number = 0, delay: Quantity.Temporal = 500 ms) => pressed && (max == 0 || presses <= max)
      && (presses == 1 || Time.now - pressed.history.since(None){.value == true}.last.when >= delay)

    press (modifiers: Modifier? = None): static => this ~~ (.modifiers = modifiers) ~~ (.pressed = true)
    release: static => this ~~ .pressed = false
    cycle (iterable) => iterable[presses % iterable.count]
  }

  keys => children{is Key}
  [name] => keys{.name == name}.first ?? add(Key(name))
  coded (code: Number) => keys{.code == code}.first ?? add(Key(name: code as Char as String, code))
  pressed (name, modifier: Modifier? = None) => this[name] -- (key => key.pressed && (!modifier || modifier#.some(. is key.modifiers)))
  .{literal name ^property} ^punctuation => this[name]
}

Disk := class: Location = device: Device {
  local => Instance#{.device === device}.first -- (. && . !== Instance.local ? (. as String + path) as Location : (path as Location))
  / (segment: String) => Disk(device, path: (path as String) + "/" + segment)
  .{literal name ^property} ^punctuation => this / name
}

FileSystem &+= {
  static Device := class: FileSystem {
    on (location: Disk) => Instance#{.device === location.device}.first -- (. && . !== Instance.local ? Remote() : location.device.os)
    read (location: Location) => on(location).read(location.local)
    write (location: Location, content) => on(location).write(location.local, content)
    listing (location: Location) => on(location).listing(location.local)
  }
}

FileOptimizations = {
  {location: Disk} => FileSystem.Device()
} + FileOptimizations
