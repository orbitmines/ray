  static hole_next (p: Pattern, at, n) => (n < textend) ? Runtime.hole_led(p, at, n, ((p.b != 2) ? ((((n > at) && (word_byte(byte(n - 1)) != 0) && (word_byte(byte(n)) != 0)) == 0) ? ((nomemo != 0) ? text_led_read(p.a, n) : Matching.memo_read(p.a, n, memo + (((((n * 31) + p.a) + (textend * 7)) & 65535) * 16))) : 0) : (((byte(n) == 92) && ((n + 1) < textend)) ? (n + 2) : 0))) : (0 - 1)
  static hole_led (p: Pattern, at, n, l) => (l > n) ? l : ((((byte(n) == 10) && (p.b != 1) && (((continued_from(at, n) == 0) && (((pair_class(at - 1) == 2) && (pair_end(at - 1) > n)) == 0)) || (block_closed(at, n) > 0))) || ((p.b == 3) && ((byte(n) == 32) || (byte(n) == 9)))) ? (0 - 1) : Runtime.hole_byte(p, n, Runtime.class_at(n)))
