concurrently ^keyword := TODO

Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    CAPTURE: (OPEN: String+, \s, CLOSE: String+),   // The brackets a hole is written in.
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}("LHS") | RHS: CAPTURE.map{== \s}("RHS") | String)[],
    \n
  ),
  (
    // A head: text, any space (arbitrary whitespace; between two holes, some), holes. A hole takes text with nothing open in
    // it (a bracket, or a pair a rule taught: a head that is one hole between two characters, `({grouped})`), never ending
    // inside a word, the nearest the rest matches (the last one: to the end of the line). Written against text it takes no
    // space (`{x}: {type}`: `:` binds the nearest), the last one none it begins with; one inside a pair, any. A head that is
    // one hole takes a word. A literal begins and ends where the kind of character changes (`%++` is not `%+`, `+`).
    Hole := (BOOTSTRAPPER.CAPTURE.OPEN, code: String, BOOTSTRAPPER.CAPTURE.CLOSE)
    Head := (Hole | \s => \s[] | String)[] & {
      // A hole's text is code, read with the rules that have holes, in a node that is the hole: text nothing reads in it is
      // the hole (its name); what it is given is its (`{x: T}`: `{x}: {type}` gives it a `type`, so it takes what T's own
      // rules read whole; `{x ^style}`, a `style`); one read as text is that text, a literal (`{\`=>\`}`).
      holes => .{Hole}.(hole: Node(), code reading in hole)
      // (led by the hole `this`, `{this}…`: a method, read only on a value)
      method => first.code == "this"
    }

    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES
      .map{== \s}(\s[])                         // Any space means arbitrary whitespace.
      ~~ .(LHS | RHS) = String                  // Arbitrary captures for each group

    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF     // The grammar rule is shaped [LHS: [LHS, RHS], RHS]

    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,     // First rule must be the GRAMMAR RULE: read by inference, never by a rule.
    statements: (
      Node := class {
        last?: Rule                             // Its own rules: the last one defined, and the ones before it.
        also?: Node                             // (made in a method: what that is read on)
        parent?: Node
        // Its rules: its own, what it is also made of, then its parent's as they are then.
        rules => (last?.own, ...also?.rules, ...parent?.rules)
      }
      Rule := class {
        prev?: Rule, head: Head, body: String, closure?: Program
        // A definition first (the separator outside brackets), then one led by text, then the latest: declaration order is
        // precedence, what is declared last binds loosest.
        rank => (head contains GRAMMAR_RULE.SEPARATOR, head.first is String, -index)
        // Its body is read once, with the rules before it (a rule never reads itself); what none reads, read when it runs.
        (caller: Program) => Statements(body, prev)(caller)
      }
      Program := class {
        caller?: Program, closure?: Program, this: Node, on: Node = this
        // What its holes took: code, with where it was written. `{name}` reads that code here; `name`, its value (read where
        // it was written, once).
        takes: (code: String, written: Program)[]
        [hole: Hole] => takes[hole.name] ?? closure?[hole]
        // Read as a node (`&`): what its holes took as text, its `caller`, and its `this` (what it is read on; in a method, a
        // node made there is what that is read on).
      }
      global := Node(last: Rule(head: `external {rule}`, (caller, rule) => {
        "." => caller.this = Node(parent: caller.this, also: caller.on)   // The context, from there on, a node made of it.
        "&" => caller
        "goto" (label: String | Hole) => goto label     // In the body (a label written `{x}`: the one that value is), else the
                                                        // caller's; the host's: `afterwards` (the rest put off until everything
                                                        // is read: a test), `report` (what it says, said), `erred` (a test that
                                                        // said something goes on there).
        "label" (label: String | Hole) => label\
      }[rule]))

      // How a rule is defined (the one primitive) is the grammar rule's LHS: in what it is read in. A head written again (the
      // same text and holes) is that rule, for what read it already, and placed last.
      global.last = Rule(prev: global.last, head: GRAMMAR_RULE.LHS, (caller, (lhs, rhs)) =>
        caller.this.last = Rule(prev: caller.this.last, head: lhs, body: rhs, closure: rhs.written))
      // And the grammar rule is defined by it: from here on, a rule is defined by the GRAMMAR RULE's RHS. Its body sees only
      // the primitive (the rules before it), so the definition in it is the primitive's.
      global.last.(Program(this: global), GRAMMAR_RULE)

      Statements (text: String, rules: Rule) => (
        leading_whitespace: (\s | \n)[],
        statement: Hole                          // What a hole took: `{name}` its code, `name` its value.
          | concurrently rules.rules{.head reads .line && !.method}#.sort(.rank).first
          // A value, then the rest read on it: the first place a method reads all that follows, and what is before it reads
          // (`x.f(y)`: `f` read in x, `(y)` on what that is, with x as `this`). One led by a word, after a space.
          | (value: Statements, rest: concurrently value.rules{.head reads rest && .head.first is String})
          // Text nothing reads: wanted as a value, a place named by it (in a test, an error); else, its diagnostic.
          | String
      )[] & (caller: Program) => .statement#.for .(caller)

      // A file's statements, read with its scope's rules as they are then: what one defines reads the next, and what none
      // read is read again when the scope gains a rule (`dynamically`).
      Statements(GRAMMAR_RULE.after, dynamically global.last)(Program(this: global))
      // Every other file concurrently, each in a scope of its own inside the entrypoint's; then, everything read, the tests.
      @ether/**.ray concurrently for file => (scope := Node(parent: global)) && Statements(file, dynamically scope.last)(Program(this: scope))
    )
  ),
) => {

}
