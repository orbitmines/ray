  static text_member (t: Text, name) => (name == Symbol.empty) ? boolean(t.from == t.to) : ((name == Symbol.rest) ? ((t.from == t.to) ? text(t.from, t.to) : text(t.from + 1, t.to)) : ((t.from == t.to) ? None : ((name == Symbol.first) ? text(t.from, t.from + 1) : text(t.to - 1, t.to))))
