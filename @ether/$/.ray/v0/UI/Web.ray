Language.Web := class: Language {
  static extensions = ".web"
  HTML := class {
    Element := class = tag: String, attributes: (name: String, value: String)[] = [], children: (Element | String)[] = [] {
      static made = 0
      id: String = attributes{.name == "id"}.first?.value ?? ("e" + ((Element.made += 1) as String))
      void => tag ==.instance_of ("img" | "input" | "br" | "meta" | "link" | "source")
    }
    Raw := class = text: String
    Document := class = head: Element[], body: Element, language: String = "en"
    language = Language.register(Language(".html", writer: Writer))
    escaped (text: String) => #text.map(.match
      "<" => "&lt;"
      ">" => "&gt;"
      "&" => "&amp;"
      "\"" => "&quot;"
      * => .
    ) as String
    Writer := (node: Document | Element | Raw | String) => node.match
      String => escaped(node)
      Raw => node.text
      Document => "<!doctype html><html lang=\"", node.language, "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">", node.head.map(Writer), "</head>", Writer(node.body), "</html>"
      Element => "<", node.tag, node.attributes.map(" ", .name, "=\"", escaped(.value), "\""), ">", (node.children.map(Writer), "</", node.tag, ">") unless node.void
  }
  CSS := class {
    Rule := class = selector: String, declarations: (property: String, value: String)[], within: String?
    Keyframes := class = name: String, frames: (at: Probability, declarations: (property: String, value: String)[])[]
    Sheet := class = rules: (Rule | Keyframes)[] = []
    language = Language.register(Language(".css", writer: Writer))
    Writer := (node: Sheet | Rule | Keyframes) => node.match
      Sheet => node.rules.map(Writer)
      Rule => (node.within, "{") if node.within, node.selector, "{", node.declarations.map(.property, ":", .value, ";"), "}", "}" if node.within
      Keyframes => "@keyframes ", node.name, "{", node.frames.map(.at * 100, "%{", .declarations.map(.property, ":", .value, ";"), "}"), "}"
  }
  JSON := class {
    Object := class = entries: (name: String, value: *)[]
    escaped (text: String) => #text.map(.match
      "\"" => "\\\""
      "\\" => "\\\\"
      "<" => "\\u003c"
      \n => "\\n"
      * => .
    ) as String
    Writer := (value) => value.match
      None => "null"
      boolean => value ? "true" : "false"
      Number => value as String
      String => "\"", escaped(value), "\""
      Location => Writer(value as String)
      Object => "{", value.entries{.value != None}.map(Writer(.name), ":", Writer(.value)).join(","), "}"
      Iterable => "[", value.map(Writer).join(","), "]"
      * => Writer(Object(value.fields.map((name: .name, value: .value))))
  }
  JS := class {
    Module := class = statements: Statement[] = []
    Statement := Let | Assign | Effect | Listen | Call | Function | Return | If | Raw
    Let := class = name: String, value: Expression
    Assign := class = target: Expression, value: Expression
    Effect := class = reads: String[], body: Statement[]
    Listen := class = target: Expression, event: String, body: Statement[]
    Call := class = function: Expression, arguments: Expression[] = []
    Function := class = name: String?, parameters: String[], body: Statement[]
    Return := class = value: Expression
    If := class = condition: Expression, then: Statement[], otherwise: Statement[] = []
    Raw := class = code: String
    Expression := String | Number | boolean | Call | Function | Raw | (object: Expression, member: String) | (left: Expression, operator: String, right: Expression)
    language = Language.register(Language(".js", writer: Writer))
    Writer := (node) => node.match
      Module => node.statements.map(Writer, ";")
      Let => "let ", node.name, "=", Writer(node.value)
      Assign => Writer(node.target), "=", Writer(node.value)
      Effect => "effect([", node.reads.map("\"", ., "\"").join(","), "],()=>{", node.body.map(Writer, ";"), "})"
      Listen => Writer(node.target), ".addEventListener(\"", node.event, "\",(event)=>{", node.body.map(Writer, ";"), "})"
      Call => Writer(node.function), "(", node.arguments.map(Writer).join(","), ")"
      Function => "function ", node.name ?? "", "(", node.parameters.join(","), "){", node.body.map(Writer, ";"), "}"
      Return => "return ", Writer(node.value)
      Raw => node.code
      If => "if(", Writer(node.condition), "){", node.then.map(Writer, ";"), "}else{", node.otherwise.map(Writer, ";"), "}"
      String => "\"", node.escaped_line, "\""
      (object, member) => Writer(node.object), ".", node.member
      (left, operator, right) => "(", Writer(node.left), node.operator, Writer(node.right), ")"
      * => node as String
  }

  HTML.level := {
    {page: Geometry.Shape} => HTML.Document(head: Head(), body: HTML.Element("body", children: [page]))
    {link: UI.Link} => HTML.Element("a", [("id", link.id), ("class", link.styles.join(" ")) if link.styles.nonempty, ("href", link.to as String), ("target", "_blank") if link.window == new, ("rel", "noopener noreferrer") if link.window == new], link.children)
    {text: Geometry.Text{role == heading}} => HTML.Element("h" + Heading.level(text), [("id", text.id), ("class", text.styles.join(" ")) if text.styles.nonempty], Pieces(text))
    {text: Geometry.Text} => HTML.Element(text.wrap == none ? "span" : "p", [("id", text.id), ("class", text.styles.join(" ")) if text.styles.nonempty, ("dir", text.direction == right-to-left ? "rtl" : "ltr")], Pieces(text))
    {image: Geometry.Image{fill}} => HTML.Element("span", [("id", image.id), ("class", image.styles.join(" ")) if image.styles.nonempty, ("role", "img"), ("aria-label", image.alt)])
    {image: Geometry.Image} => HTML.Element("img", [("id", image.id), ("class", image.styles.join(" ")) if image.styles.nonempty, ("src", image.source as String), ("alt", image.alt), ("loading", "lazy")])
    {video: Geometry.Video} => HTML.Element("video", [("id", video.id), ("class", video.styles.join(" ")) if video.styles.nonempty, ("src", video.source as String), ("controls", "") if video.controls, ("muted", "") if video.muted, ("loop", "") if video.looping])
    {audio: Geometry.Audio} => HTML.Element("audio", [("id", audio.id), ("class", audio.styles.join(" ")) if audio.styles.nonempty, ("src", audio.source as String), ("controls", "")])
    {canvas: Geometry.Canvas} => HTML.Element("canvas", [("id", canvas.id), ("class", canvas.styles.join(" ")) if canvas.styles.nonempty, ("width", canvas.size.x as px), ("height", canvas.size.y as px)])
    {outline: Geometry.Outline | Geometry.Polygon | Geometry.Ball} => Svg(outline)
    {form: UI.Form} => HTML.Element("form", [("id", form.id), ("class", form.styles.join(" ")) if form.styles.nonempty], form.inputs)
    {input: UI.TextField | UI.Secret | UI.NumberField | UI.DateField | UI.ColorField | UI.FileField | UI.Checkbox | UI.Slider} => HTML.Element("input", [
      ("id", input.id), ("class", input.styles.join(" ")) if input.styles.nonempty, ("type", InputType[input.static]), ("placeholder", input.placeholder), ("disabled", "") if input.disabled,
      ("min", input.chosen.type.least as String) if input ==.instance_of UI.Slider, ("max", input.chosen.type.most as String) if input ==.instance_of UI.Slider
    ])
    {input: UI.TextArea{language}} => HTML.Element("div", [("id", input.id), ("class", ["painted", input.styles].flatten.join(" "))], [
      HTML.Element("pre", [("id", input.id + "-paint"), ("aria-hidden", "true")], Pieces(input.face)),
      HTML.Element("textarea", [("id", input.id + "-text"), ("placeholder", input.placeholder), ("spellcheck", "false")], [input.empty ? "" : input.value as String])
    ])
    {input: UI.TextArea} => HTML.Element("textarea", [("id", input.id), ("class", input.styles.join(" ")) if input.styles.nonempty, ("placeholder", input.placeholder)], [input.empty ? "" : input.value as String])
    {input: UI.Select} => HTML.Element("select", [("id", input.id), ("class", input.styles.join(" ")) if input.styles.nonempty], input.options.map(HTML.Element("option", [("value", . as String)], [. as String])))
    {box: Geometry.Shape} => HTML.Element(box.activate ? "button" : Landmark[box.role] ?? "div", [("id", box.id), ("class", box.styles.join(" ")) if box.styles.nonempty, ("role", box.role as String), ("aria-label", box.label) if box.label, ("popover", "manual") if box.position.kind == anchored], box.children)
  }
  InputType = { UI.TextField: "text", UI.Secret: "password", UI.NumberField: "number", UI.DateField: "datetime-local", UI.ColorField: "color", UI.FileField: "file", UI.Checkbox: "checkbox", UI.Slider: "range" }
  Landmark = { UI.Role.table: "table", UI.Role.list: "ul", UI.Role.region: "section" }
  Pieces := (text: Geometry.Text) => text.runs.empty ? [text.text] : text.pieces.map(.run ? HTML.Element("span", [("style", Inline(.run))], [.text]) : .text)
  Inline := (run: Geometry.Text.Run) => [("color:", Paint(run.color), ";") if run.color, ("background:", Paint(run.fill), ";") if run.fill, ("font-weight:", run.font.weight, ";") if run.font, ("font-style:", run.font.style as String, ";") if run.font].flatten as String
  Heading := class { level (text: Geometry.Text) => text.font.size >= 2em ? 1 : text.font.size >= 1.5em ? 2 : 3 }
  Head := () => [
    HTML.Element("title", children: [UI.Navigation.title]),
    HTML.Element("meta", [("name", "description"), ("content", UI.Navigation.description)]),
    UI.Navigation.tags.map(Meta(.name, .content)),
    Meta("theme-color", Paint(UI.Navigation.theme) as String) if UI.Navigation.theme,
    HTML.Element("link", [("rel", "canonical"), ("href", UI.Navigation.canonical as String)]) if UI.Navigation.canonical,
    HTML.Element("link", [("rel", "icon"), ("href", UI.Navigation.icon as String)]) if UI.Navigation.icon,
    HTML.Element("link", [("rel", "apple-touch-icon"), ("href", UI.Navigation.apple_icon as String)]) if UI.Navigation.apple_icon,
    HTML.Element("link", [("rel", "manifest"), ("href", UI.Navigation.manifest as String)]) if UI.Navigation.manifest,
    UI.Navigation.structured.map(HTML.Element("script", [("type", "application/ld+json")], [HTML.Raw(JSON.Writer(LinkedData(.)) as String)])),
    HTML.Element("link", [("rel", "stylesheet"), ("href", "style.css")]),
    HTML.Element("script", [("src", "app.js"), ("defer", "")])
  ].flatten
  Meta := (name: String, content: String) => HTML.Element("meta", [(name ~= ("og:" | "article:" | "fb:", *) ? "property" : "name", name), ("content", content)])
  LinkedData := (entry) => JSON.Object([("@context", "https://schema.org"), Linked(entry).entries].flatten)
  Linked := (value) => value.match
    String | Number | boolean | Location => value
    None => None
    Iterable => value.map(Linked)
    * => JSON.Object(value.fields.map((name: .name == "type" ? "@type" : .name, value: Linked(.value))))
  Svg := (shape: Geometry.Shape) => HTML.Element("svg", [("id", shape.id), ("viewBox", "0 0 ", shape.size.x as px, " ", shape.size.y as px)], [shape.match
    Geometry.Ball => HTML.Element("ellipse", [("cx", "50%"), ("cy", "50%"), ("rx", "50%"), ("ry", "50%")])
    Geometry.Polygon => HTML.Element("polygon", [("points", shape.points.map(.x as px, ",", .y as px).join(" "))])
    Geometry.Outline => HTML.Element("path", [("d", "M", shape.from.x as px, " ", shape.from.y as px, shape.segments.map(.match
      Geometry.Quadratic => " Q", .control.x, " ", .control.y, " ", .to.x, " ", .to.y
      Geometry.Cubic => " C", .first.x, " ", .first.y, " ", .second.x, " ", .second.y, " ", .to.x, " ", .to.y
      Geometry.Arc => " A", .radius.x, " ", .radius.y, " ", .rotation, " ", .large ? 1 : 0, " ", .sweep ? 1 : 0, " ", .to.x, " ", .to.y
      * => " L", .x, " ", .y
    ), " Z" if shape.closed)])
  ])

  CSS.level := {
    {page: Geometry.Shape} => CSS.Sheet([
      CSS.Rule("*", [("box-sizing", "border-box"), ("margin", "0")]),
      CSS.Rule("body", [("font-family", "sans-serif"), ("line-height", "1.2")]),
      CSS.Rule(".painted", [("display", "grid")]),
      CSS.Rule(".painted>pre,.painted>textarea", [("grid-area", "1/1"), ("margin", "0"), ("padding", "0"), ("border", "none"), ("font", "inherit"), ("white-space", "pre-wrap"), ("overflow-wrap", "anywhere"), ("overflow", "hidden")]),
      CSS.Rule(".painted>textarea", [("color", "transparent"), ("caret-color", "currentColor"), ("background", "transparent"), ("resize", "none"), ("outline", "none")]),
      CSS.Rule("*", [("animation", "none"), ("transition", "none")], within: "@media (prefers-reduced-motion:reduce)"),
      CSS.Rule("html.locked", [("overflow", "hidden")]),
      page.expand.map(Rules(.)).flatten,
      page.expand{.position.kind == anchored}.map(shape => Anchor(shape, page) -- (anchor => [
        CSS.Rule("#" + anchor.id, [("anchor-name", "--" + anchor.id)]),
        CSS.Rule("#" + shape.id, [("position", "fixed"), ("inset", "auto"), ("margin", "0"), ("position-anchor", "--" + anchor.id), ("position-area", shape.position.side as String)])
      ])).flatten
    ])
  }
  Anchor := (shape: Geometry.Shape, page: Geometry.Shape) => shape.position.anchor ?? shape.parent_in(page)
  Rules := (shape: Geometry.Shape) => [
    CSS.Rule("#" + shape.id, [
      shape.flow.match
        inline => ("display", "flex"), ("flex-wrap", shape.constraints.wrap.last ? "wrap" : "nowrap")
        grid => ("display", "grid"), ("grid-template-columns", "repeat(", shape.constraints.columns.last ?? 1, ",1fr)")
        layered => ("display", "grid"), ("grid-template-areas", "\"layer\"")
        vertical => ("display", "flex"), ("flex-direction", "column")
      ("gap", Measure(shape.gap.y), " ", Measure(shape.gap.x)),
      shape.constraints{.dimension == "x"}.map(constraint => [
        ("width", constraint.share * 100, "%") if constraint.share ==.instance_of Number,
        ("width", Stops(constraint.share).first.share * 100, "%") if Responsive(constraint),
        ("max-width", Measure(constraint.most)) if constraint.most != None,
        ("min-width", Measure(constraint.least)) if constraint.least != None,
        ("aspect-ratio", constraint.aspect) if constraint.aspect,
        constraint.align.match
          center => ("margin-inline", "auto")
          end => ("margin-inline-start", "auto")
          between => ("justify-content", "space-between")
          * => ()
      ]).flatten,
      shape.constraints{.dimension == "y"}.map(constraint => [
        ("max-height", Measure(constraint.most)) if constraint.most != None,
        ("min-height", Measure(constraint.least)) if constraint.least != None,
        ("align-items", "center") if constraint.align == middle
      ]).flatten,
      ("container-type", "inline-size") if shape.children.some(.constraints.some(Responsive(.))),
      [("padding", shape.padding), ("margin", shape.margin)].map((name, edges) => [("top", edges.top), ("right", edges.right), ("bottom", edges.bottom), ("left", edges.left)]{.1 != 0}.map((name + "-" + .0, Measure(.1)))).flatten,
      ("position", shape.position.kind as String) if shape.position.kind ==.instance_of (sticky | fixed | absolute),
      ("position", "relative") if shape.position.kind == flow && shape.children.some(.position.kind == absolute),
      [("top", shape.position.top), ("right", shape.position.right), ("bottom", shape.position.bottom), ("left", shape.position.left)]{.1 != None}.map((.0, Measure(.1))) if shape.position.kind != anchored,
      ("background", Paint(shape.fill)) if shape.fill,
      ("border" + Sides[shape.stroke.sides], shape.stroke.width as px, "px ", shape.stroke.dash.empty ? "solid" : "dashed", " ", Paint(shape.stroke.paint)) if shape.stroke,
      ("border-radius", shape.radius.map(. as px, "px").join(" ")) if shape.radius != [0],
      ("transform", "matrix3d(", shape.transform.matrix.transposed.flatten.join(","), ")") if shape.transform != Geometry.Transform(),
      ("overflow", shape.overflow == scroll ? "auto" : shape.overflow as String),
      ("z-index", shape.layer) if shape.layer != 0,
      ("mix-blend-mode", shape.blend as String) if shape.blend != normal,
      shape.effects.map(.match
        Geometry.Opacity => ("opacity", .amount)
        Geometry.Shadow => ("box-shadow", ("inset " if .inset), .offset.x as px, "px ", .offset.y as px, "px ", .blur as px, "px ", .spread as px, "px ", Paint(.color))
        Geometry.Blur => ("filter", "blur(", .radius as px, "px)")
        Geometry.Filter => ("filter", .kind as String, "(", .amount, ")")
      ),
      ("color", Paint(shape.color)) if shape.color,
      Typeface(shape.font) if shape.font,
      (("text-align", shape.align as String), ("text-overflow", shape.overflow as String), ("white-space", WhiteSpace[shape.white_space]), ("overflow-wrap", "anywhere") if shape.wrap == anywhere) if shape ==.instance_of Geometry.Text,
      ("object-fit", shape.fit as String) if shape ==.instance_of Geometry.Image,
      (("display", "inline-block"), ("mask", Mask(shape)), ("-webkit-mask", Mask(shape))) if shape ==.instance_of Geometry.Image && shape.fill,
      ("transition", "all ", shape.transition.duration as ms, "ms ", Timing(shape.transition.easing)) if shape.transition,
      ("cursor", shape.cursor != default ? shape.cursor as String : "pointer") if shape.cursor != default || shape.activate,
      ("touch-action", (shape.touch as String).replace("_", "-")) if shape.touch != auto,
      ("scrollbar-width", "none") if shape.scrollbar == hidden
    ]),
    CSS.Rule("#" + shape.id + "::placeholder", [("color", Paint(shape.placeholder_color))]) if shape ==.instance_of UI.Input && shape.placeholder_color,
    UI.Theme.styles.map(style => CSS.Rule("#" + shape.id + "." + style.name, Styling(style.name))) if shape.dynamics.some(.target == "class"),
    CSS.Rule("#" + shape.id + ":focus-visible", [("outline", "2px solid currentColor")]) if shape.focusable,
    shape.constraints{Responsive(.)}.map(constraint => Stops(constraint.share) -- (stops => stops.zip([stops.rest, None]).map((at, next) => CSS.Rule("#" + shape.id,
      [("width", constraint.share ==.instance_of Geometry.Interpolated && next ? Chord(at, next) : (at.share * 100, "%"))],
      within: "@container (min-width:" + Measure(at.width) as String + ")"
    )))).flatten,
    shape.animations.map(animation => CSS.Keyframes(shape.id + "-" + animation.property, [(0, [(animation.property, animation.from as String)]), (1, [(animation.property, animation.to as String)])]))
  ]
  Typeface := (font: Geometry.Font) => [
    ("font-family", font.family.join(",")) if font.family != Geometry.Font().family,
    ("font-size", Measure(font.size)) if font.size != Geometry.Font().size,
    ("font-weight", font.weight) if font.weight != Geometry.Font().weight,
    ("font-style", font.style as String) if font.style != normal,
    ("line-height", font.line_height) if font.line_height != Geometry.Font().line_height,
    ("text-transform", { upper: "uppercase", lower: "lowercase", title: "capitalize" }[font.case]) if font.case != none,
    ("letter-spacing", Measure(font.tracking)) if font.tracking != 0
  ]
  WhiteSpace = { normal: "normal", nowrap: "nowrap", pre: "pre", pre_wrap: "pre-wrap", pre_line: "pre-line" }
  Timing := (easing: Geometry.Easing) => easing === Geometry.linear ? "linear" : easing === Geometry.ease_in ? "ease-in" : easing === Geometry.ease_out ? "ease-out" : "ease"
  Styling := (name: String) => Rules(Geometry.Box()).first.declarations -- (plain => Rules(Geometry.Box().styled(name)).first.declarations{!plain.contains(.)})
  Sides = { all: "", top: "-top", bottom: "-bottom", left: "-left", right: "-right", horizontal: "-inline", vertical: "-block" }
  Mask := (image: Geometry.Image) => "url(\"", image.source as String, "\") center/", image.fit == fill ? "100% 100%" : image.fit as String, " no-repeat"
  Paint := (paint: Geometry.Paint) => paint.match
    Geometry.Inherited => "currentColor"
    Geometry.Color => "rgba(", paint.red, ",", paint.green, ",", paint.blue, ",", paint.alpha, ")"
    Geometry.Gradient => paint.kind as String, "-gradient(", (paint.angle, "turn,") if paint.kind == linear, paint.stops.map(Paint(.color), " ", .at * 100, "%").join(","), ")"
    Geometry.Pattern => "url(#", paint.shape.id, ")"
  Responsive := (constraint: Geometry.Constraint) => constraint.share ==.instance_of (Geometry.Interpolated | Geometry.Steps | Geometry.Breakpoint[])
  Stops := (share) => share ==.instance_of Geometry.Breakpoint[] ? (share as Geometry.Steps).sorted : share.sorted
  Chord := (from: Geometry.Breakpoint, to: Geometry.Breakpoint) => "calc(", from.share * (from.width as px), "px + (100cqw - ", from.width as px, "px) * ", (to.share * (to.width as px) - from.share * (from.width as px)) / ((to.width - from.width) as px), ")"
  Measure := (length: Geometry.Length) => length.match
    Number => length, "px"
    {quantities{count > 1}} => "calc(", length.quantities.map(.quantity, .unit.symbol).join(" + "), ")"
    * => length.amount, length.unit.symbol

  JS.level := {
    {page: Geometry.Shape} => JS.Module([
      Runtime,
      Devices,
      page.expand.map(shape => shape.dynamics.map(dynamic => JS.Effect(reads: dynamic.reads, body: [
        dynamic.target == "class" ? JS.Assign((Element(shape), "className"), dynamic.compiled{O: JS.expressions}) : dynamic.compiled{O: JS.expressions}
      ]))).flatten,
      page.expand{==.instance_of UI.TextArea && .language}.map(area => JS.Listen(JS.Call(("document", "getElementById"), [area.id + "-text"]), "input", [JS.Assign((JS.Call(("document", "getElementById"), [area.id + "-paint"]), "textContent"), ("event", "target.value"))])),
      page.expand{.focusable}.map(shape => JS.Listen(Element(shape), "click", [JS.Call(("ray", "activate"), [shape.id])])),
      page.expand{==.instance_of UI.Input}.map(input => JS.Listen(Element(input), "input", [JS.Call(("ray", "set"), [input.id, ("event", "target.value")])])),
      page.expand{==.instance_of Geometry.Canvas}.map(canvas => JS.Effect(reads: canvas.draws.reads, body: [JS.Call(("ray", "draw"), [canvas.id, canvas.draws{O: Language.Direct.level}()])])),
      page.expand{==.instance_of UI.Popover && .trigger != always}.map(popover => Anchor(popover, page) -- (anchor => [
        ["pointerenter", "focusin"].map(event => JS.Listen(Element(anchor), event, [JS.Call((Element(popover), "showPopover"))])),
        ["pointerleave", "focusout"].map(event => JS.Listen(Element(anchor), event, [JS.Call((Element(popover), "hidePopover"))]))
      ])).flatten,
      page.expand{.position.kind == anchored && .visible && (!=.instance_of UI.Popover || .trigger == always)}.map(JS.Call((Element(.), "showPopover")))
    ])
  }
  Element := (shape: Geometry.Shape) => JS.Call(("document", "getElementById"), [shape.id])
  JS.expressions := {
    {a} + {b} => (a, "+", b)
    {a} - {b} => (a, "-", b)
    {a} * {b} => (a, "*", b)
    {a} / {b} => (a, "/", b)
    {a} == {b} => (a, "===", b)
    {a} < {b} => (a, "<", b)
    {a} && {b} => (a, "&&", b)
    {a} || {b} => (a, "||", b)
    {name} = {value} => JS.Assign(("ray", name), value)
    {f}({arguments}) => JS.Call(f, arguments)
  }
  Runtime := JS.Function("effect", ["reads", "body"], [JS.Call(("ray", "subscribe"), ["reads", "body"]), JS.Call("body")])
  Devices := [
    JS.Call(("ray", "set"), ["UI.Platform.handheld", (((("/Android|iPhone|iPad|iPod|Mobile/i", "test(navigator.userAgent)"), "||", ("matchMedia(\"(pointer:coarse)\")", "matches&&!matchMedia(\"(pointer:fine)\").matches")), "||", ("navigator", "maxTouchPoints>1&&/Macintosh/.test(navigator.userAgent)"))]),
    [("pointerdown", "down"), ("pointermove", "moved"), ("pointerup", "up"), ("pointercancel", "up")].map((event, method) => JS.Listen("window", event, [JS.Call(("ray", "call"), ["UI.Pointer." + method, JS.Call(("ray", "pointer"), ["event"]), ("event", "timeStamp")])])),
    JS.Listen("window", "wheel", [JS.Call(("ray", "set"), ["UI.Pointer.wheel", ("event", "deltaY")])]),
    ["keydown", "keyup"].map(event => JS.Listen("window", event, [JS.Call(("ray", "key"), ["event"])])),
    JS.Listen("window", "focusin", [JS.Call(("ray", "set"), ["UI.Focus.current", ("event", "target.id")])]),
    JS.Listen("window", "resize", [JS.Call(("ray", "set"), ["UI.Viewport.size", JS.Call(("ray", "size"))])]),
    JS.Listen("window", "popstate", [JS.Call(("ray", "set"), ["UI.Navigation.history", ("location", "pathname")])]),
    JS.Listen("window", "paste", [JS.Call(("ray", "set"), ["UI.Clipboard.content", JS.Call(("event.clipboardData", "getData"), ["text"])])]),
    JS.Listen("window", "drop", [JS.Call(("ray", "set"), ["UI.Drag.dropped", ("event.dataTransfer", "files")])]),
    JS.Listen("window", "compositionupdate", [JS.Call(("ray", "set"), ["UI.Composition.text", ("event", "data")])]),
    JS.Listen("window", "deviceorientation", [JS.Call(("ray", "set"), ["UI.Sensors.orientation", JS.Call(("ray", "orientation"), ["event"])])]),
    JS.Listen("window", "gamepadconnected", [JS.Call(("ray", "poll_gamepads"))]),
    JS.Listen(("window", "matchMedia(\"(prefers-reduced-motion:reduce)\")"), "change", [JS.Call(("ray", "set"), ["UI.Viewport.preferences.reduced_motion", ("event", "matches")])]),
    JS.Effect(["UI.Navigation.history"], [JS.Call(("history", "pushState"), [None, "", JS.Call(("ray", "get"), ["UI.Navigation.at"])])]),
    JS.Effect(["UI.Navigation.title"], [JS.Assign(("document", "title"), JS.Call(("ray", "get"), ["UI.Navigation.title"]))]),
    JS.Listen("window", "scroll", [JS.Call(("ray", "set"), ["UI.Viewport.scrolled", ("window", "scrollY")])]),
    JS.Effect(["UI.Viewport.scrolled"], [JS.Raw("const y=ray.get(\"UI.Viewport.scrolled\");if(Math.abs(scrollY-y)>1)scrollTo(0,y)")]),
    JS.Effect(["UI.Viewport.revealing"], [JS.Raw("const r=ray.get(\"UI.Viewport.revealing\");const e=r&&document.getElementById(r.shape.id);if(e){if(r.within||!r.offset)e.scrollIntoView({block:r.align,behavior:r.smooth?\"smooth\":\"auto\"});else scrollTo({top:e.getBoundingClientRect().top+scrollY+r.offset,behavior:r.smooth?\"smooth\":\"auto\"})}")]),
    JS.Effect(["UI.Selection.range"], [JS.Raw("const r=ray.get(\"UI.Selection.range\");const e=r&&(document.getElementById(r.shape.id+\"-text\")||document.getElementById(r.shape.id));if(e){if(e.setSelectionRange){e.focus();e.setSelectionRange(r.from,r.to)}else{const g=document.createRange();g.selectNodeContents(e);getSelection().removeAllRanges();getSelection().addRange(g)}}")]),
    JS.Effect(["UI.Viewport.locking"], [JS.Call(("document.documentElement.classList", "toggle"), ["locked", JS.Call(("ray", "get"), ["UI.Viewport.locking"])])]),
    JS.Effect(["UI.Platform.notifications"], [JS.Call("new Notification", [JS.Call(("ray", "get"), ["UI.Platform.notifications.last.title"])])]),
    JS.Effect(["UI.Platform.fullscreen"], [JS.Call(("document.documentElement", "requestFullscreen"))]),
    JS.Effect(["UI.Platform.printing"], [JS.Call(("window", "print"))]),
    JS.Effect(["UI.Clipboard.content"], [JS.Call(("navigator.clipboard", "writeText"), [JS.Call(("ray", "get"), ["UI.Clipboard.content"])])])
  ].flatten

  Package := class = files: (path: String, content: *)[] {
    write (to: Location) => files.for(IO.write(to / .path, .content))
  }
  level := HTML.level + CSS.level + JS.level + {
    {page: Geometry.Shape} => Package([
      UI.Theme.applied(page) -- ("index.html", page{O: HTML.level}()),
      ("style.css", page{O: CSS.level}()),
      ("app.js", page{O: JS.level}()),
      page.expand{==.instance_of Geometry.Image | Geometry.Video | Geometry.Audio}.map(.source.name, .source),
      [UI.Navigation.icon, UI.Navigation.apple_icon, UI.Navigation.manifest]{!= None}.map(.name, .)
    ])
  }

  DOM := class {
    send (message) => external io `dom` (message)
    received => external io `dom` None
    line (parts: String[]) => parts.join(" "), \n
    listened (element: HTML.Element) => element.tag.match
      "a" | "button" => ["click"]
      "input" | "select" | "textarea" => ["input", "focus"]
      * => []
    mount (element: HTML.Element) => send(line(["create", element.id, element.tag]))
      -- element.attributes.for(send(line(["attribute", element.id, .name, .value.escaped_line])))
      -- listened(element).for(send(line(["listen", element.id, .])))
      -- element.children.for(. ==.instance_of String ? send(line(["text", element.id, .escaped_line])) : mount(.) -- send(line(["append", element.id, .id])))
    render (page: Program) => send(line(["clear"])) -- mount(page{O: HTML.level}().body) -- send(line(["style", page{O: CSS.level}() as CSS.language]))
    event => Event.parsed(received)
    static Event := class = id: String, kind: String, value: String? {
      static parsed (line: String?) => line?.trimmed ~= (id: Char{!= " "}[], " ", kind: Char{!= " "}[], (" ", value: *)?) -- Event(id: .id, kind: .kind, value: .value) if .
      at => value ~= (x: Decimal, " ", y: Decimal, (" ", time: Decimal)?) -- (position: Geometry.Vector(.x * 1px, .y * 1px), time: .time ? .time * 1 ms : Time.now)
      shape => UI.scene?.expand{.id == id}.first
      apply => kind.match
        "click" => shape?.activate
        "input" => shape?.set(value)
        "focus" => UI.Focus.current = shape
        "scroll" => UI.Viewport.scrolled = (value as Decimal) * 1px
        "pointerdown" => UI.Pointer.down(at.position, time: at.time)
        "pointermove" => UI.Pointer.moved(at.position, at.time)
        "pointerup" | "pointercancel" => UI.Pointer.up(at.position, at.time)
        "keydown" => value.split(" ") -- UI.Keyboard.press(.first, shift: .contains("shift"), control: .contains("control"), alt: .contains("alt"), meta: .contains("meta"))
        "keyup" => UI.Keyboard.release(value.split(" ").first)
        "size" => shape && (value ~= (width: Decimal, " ", height: Decimal)) -- (shape.size = Geometry.Vector(.width * 1px, .height * 1px))
        * => None
    }

    start => send(line(["clear"])) -- ["pointerdown", "pointermove", "pointerup", "pointercancel", "keydown", "keyup", "scroll"].for(send(line(["listen", "window", .])))
    stop => None
    write (frame) => render(frame)
      -- send(line(["lock", UI.Viewport.locking as String]))
      -- UI.Viewport.revealing && send(line(["reveal", UI.Viewport.revealing.shape.id, UI.Viewport.revealing.align as String, UI.Viewport.revealing.smooth as String])) -- (UI.Viewport.revealing = None)
    read => event?.apply
    copy (text: String) => send(line(["clipboard", text.escaped_line]))
    open (to: Location) => send(line(["open", (to as String).escaped_line]))
  }

  Chromium := { }
  Firefox := { }
  Safari := {
    {rule: CSS.Rule{declarations.some(.property == "backdrop-filter")}} => rule ~~ .declarations.push ("-webkit-backdrop-filter", rule.declarations{.property == "backdrop-filter"}.first.value)
  }
}
Language.register(Language.Web)
