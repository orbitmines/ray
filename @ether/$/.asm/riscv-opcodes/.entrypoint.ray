// The RISC-V encodings as the RISC-V project keeps them: `riscv-opcodes`.
//
// Each file under `extensions/` (rv_i, rv_m, rv_c, …) is a list of
// instructions, one to a line: the mnemonic, then what the instruction's word
// is made of, in any order —
//
//   addi    rd rs1 imm12           14..12=0 6..2=0x04 1..0=3
//
// A name (`rd`, `imm12`) is an argument: a field whose bits `arg_lut.csv`
// says, as `"rd", 11, 7`. A range with a value (`14..12=0`, `6..2=0x04`, and
// `12=1` for one bit) is fixed: those bits of the word are always that value,
// written in decimal or, after `0x`, in hexadecimal. Between them every bit of
// the word is said once. `$pseudo_op rv_i::addi mv …` is another spelling of
// an instruction already listed, and `#` begins a comment.
//
// These files are read here as they are written: the rules below are the
// grammar they are written in, and what they build is an `ISA` of `Encoding`s
// with a mask and a match, and a `Field` for every argument.

mark ^keyword := external global

#{literal comment} ^comment => None

// The positions of the bits of a word, as the ranges spell them. A position is
// never a number here: it is where its spelling stands in this row, least
// significant first, and a range is read by walking the row.
Position := class {
  // What a range is written with, where it is a position: the spelling it is
  // in the row, or None.
  accepts (text) => position_at[text]
}
// Tables, each kept by the text it is looked up with: where each position is
// in the row (`position_at`), the arguments by name (`ArgumentTable`), the fields laid out
// so far (`Laid`), the values read so far (`Read`), where each span being
// laid begins (`starts`), and whether a mnemonic is an instruction's
// (`listing`).
// spec: two instances of one class answer the same `[key]`, so each table is
// a class of its own.
Places := class { }
position_at ^keyword := Places()
ArgumentTable := class { }
Starts := class { }
starts ^keyword := Starts()
Laid := class { }
Read := class { }
Listing := class { }
listing ^keyword := Listing()
positions ^keyword := chain None
positions &= `0`
position_at[`0`] = positions.tail.value
positions &= `1`
position_at[`1`] = positions.tail.value
positions &= `2`
position_at[`2`] = positions.tail.value
positions &= `3`
position_at[`3`] = positions.tail.value
positions &= `4`
position_at[`4`] = positions.tail.value
positions &= `5`
position_at[`5`] = positions.tail.value
positions &= `6`
position_at[`6`] = positions.tail.value
positions &= `7`
position_at[`7`] = positions.tail.value
positions &= `8`
position_at[`8`] = positions.tail.value
positions &= `9`
position_at[`9`] = positions.tail.value
positions &= `10`
position_at[`10`] = positions.tail.value
positions &= `11`
position_at[`11`] = positions.tail.value
positions &= `12`
position_at[`12`] = positions.tail.value
positions &= `13`
position_at[`13`] = positions.tail.value
positions &= `14`
position_at[`14`] = positions.tail.value
positions &= `15`
position_at[`15`] = positions.tail.value
positions &= `16`
position_at[`16`] = positions.tail.value
positions &= `17`
position_at[`17`] = positions.tail.value
positions &= `18`
position_at[`18`] = positions.tail.value
positions &= `19`
position_at[`19`] = positions.tail.value
positions &= `20`
position_at[`20`] = positions.tail.value
positions &= `21`
position_at[`21`] = positions.tail.value
positions &= `22`
position_at[`22`] = positions.tail.value
positions &= `23`
position_at[`23`] = positions.tail.value
positions &= `24`
position_at[`24`] = positions.tail.value
positions &= `25`
position_at[`25`] = positions.tail.value
positions &= `26`
position_at[`26`] = positions.tail.value
positions &= `27`
position_at[`27`] = positions.tail.value
positions &= `28`
position_at[`28`] = positions.tail.value
positions &= `29`
position_at[`29`] = positions.tail.value
positions &= `30`
position_at[`30`] = positions.tail.value
positions &= `31`
position_at[`31`] = positions.tail.value
// No span begins anywhere yet. A table asked for a key it was never given
// looks for a name spelled that way, which costs a tenth of a second and
// files it as unresolved (ENGINE-ISSUES, "After 5399684"), so every position
// is given one.
// And a word of nothing but zeros: what a bit is where no span fixes it.
nought ^keyword := chain None
unstarted ^keyword := positions.head
while (exists unstarted) {
  starts[unstarted.value] = None
  nought &= false
  unstarted = unstarted.next
}

// Bits from `lo` up to `hi`, and what they are fixed to: `bits`, least
// significant first, or None where they are a field's.
Span := class {
  lo: Node
  hi: Node
  bits: Node
}

// The bits a word is spelled with where some spans are laid over it: `mask`
// where a span is, `match` what the spans fix them to.
Layout := class {
  mask: Node
  match: Node
}

// An argument, as `arg_lut.csv` lists it: its name and the bits it takes up.
Argument := class {
  name: Node
  hi: Node
  lo: Node
}

// A word on a line that `arg_lut.csv` lists: the name of an argument.
Name := class {
  accepts (text) => opcodes.named[text]
}

// One line of an extension: an instruction, or a pseudo-instruction spelling
// one, and what it is made of: its arguments, in the order they are written,
// and its ranges, each a `Span` fixed to a value still written as text.
// What it is made of is read after the mnemonic, a word at a time, each word
// taken on by one of the rules here.
// (Taken on here, rather than handed to a method: a method given more than
// one argument is given them composed with `,`, which costs about as much as
// what it does with them.)
Line := class {
  mnemonic: Node
  pseudo: Node
  arguments: Node
  ranges: Node
  { }{high: Position}..{low: Position}={literal valued} ^class => (
    this.ranges &= Span(lo: low, hi: high, bits: valued)
    this
  )
  // spec: one bit fixed (`12=1`, in `rv_c` and others) is not read: the
  // rule would read every `name = value` in the project as one (see below).
  { }{argument: Name} ^class => (
    this.arguments &= argument
    this
  )
}

// A line begins with its mnemonic, and is known to be one by what follows it:
// an argument, or a range fixed to a value. No line begins with one bit
// fixed (`12=1`), and a rule for it would read any `name = value` written in
// the project as one: the capture of a position is not asked what it holds
// when a statement is first read.
{literal instruction}{ }{argument: Name} ^keyword => (
  begun := opcodes.begin(instruction)
  begun.arguments &= argument
  begun
)
{literal instruction}{ }{high: Position}..{low: Position}={literal valued} ^keyword => (
  begun := opcodes.begin(instruction)
  begun.ranges &= Span(lo: low, hi: high, bits: valued)
  begun
)

// `$pseudo_op rv_i::addi mv rd rs1 31..20=0 …`: `mv` is `addi` with some of
// its arguments fixed. `$pseudo_op rv64_i::slli slli rd rs1 shamtw …` in
// `rv32_i` is how RV32 spells what `rv64_i` defines, and is an instruction
// wherever the one it spells is not.
// spec: which extension the instruction it spells is in (`rv64_i`) is read
// and not kept.
$pseudo_op{ }{literal extension}::{literal original}{ }{literal instruction}{ }{argument: Name} ^keyword => (
  begun := opcodes.spelling(instruction, original)
  begun.arguments &= argument
  begun
)
$pseudo_op{ }{literal extension}::{literal original}{ }{literal instruction}{ }{high: Position}..{low: Position}={literal valued} ^keyword => (
  begun := opcodes.spelling(instruction, original)
  begun.ranges &= Span(lo: low, hi: high, bits: valued)
  begun
)

// `arg_lut.csv`: `"rd", 11, 7`.
"{literal argument}",{ }{high: Position},{ }{low: Position} ^keyword => (
  listed := Argument(name: argument, hi: high, lo: low)
  opcodes.arguments &= listed
  opcodes.named[argument] = listed
  true
)
"{literal argument}",{ }{high: Position},{low: Position} ^keyword => (
  listed := Argument(name: argument, hi: high, lo: low)
  opcodes.arguments &= listed
  opcodes.named[argument] = listed
  true
)

// What has been read, and the instruction set it describes.
Opcodes := class {
  arguments: Node
  named: Node
  lines: Node
  fields: Node
  constants: Node

  // A line, begun where its mnemonic is read: an instruction's, or a
  // pseudo-instruction's with the mnemonic of the instruction it spells.
  begin (text) => (
    made := Line(mnemonic: text, pseudo: None, arguments: chain None, ranges: chain None)
    this.lines &= made
    made
  )
  spelling (text, spelled) => (
    made := Line(mnemonic: text, pseudo: spelled, arguments: chain None, ranges: chain None)
    this.lines &= made
    made
  )

  // Spans laid over a word of as many bits as there are positions: walking
  // the positions, a span covers from where it begins to its highest, and
  // feeds the bits of the value it is fixed to (zeros where it is a field's,
  // or outside any span).
  lay (spans) => (
    marking := spans.head
    while (exists marking) {
      at := marking.value.lo
      starts[at] = marking.value
      marking = marking.next
    }
    masking := chain None
    matching := chain None
    covering := false
    feeding := nought.head
    ending := `-`
    place := positions.head
    while (exists place) {
      here := place.value
      begun := starts[here]
      if (exists begun) {
        covering = true
        ending = begun.hi
        fixed_to := begun.bits
        if (exists fixed_to) { feeding = .constant(fixed_to).bits.head } else { feeding = nought.head }
      }
      masking &= covering
      matching &= feeding.value
      feeding = feeding.next
      if (exists (external alike (here) (ending))) {
        covering = false
        feeding = nought.head
      }
      place = place.next
    }
    marking = spans.head
    while (exists marking) {
      at := marking.value.lo
      starts[at] = None
      marking = marking.next
    }
    Layout(mask: Bits(bits: masking), match: Bits(bits: matching))
  )

  // A value as a range is fixed to: decimal, or hexadecimal after `0x`.
  constant (given) => (
    found := .constants[given]
    unless (exists found) { found = .remembered(given) }
    found
  )
  // Kept with zeros above it, so that a span wider than what it is fixed to
  // is fed zeros there.
  remembered (given) => (
    read := Opcodes.number(given)
    padded := chain None
    read_bits := read.bits
    Bits.joined(padded, read_bits)
    Bits.joined(padded, nought)
    kept := Bits(bits: padded)
    this.constants[given] = kept
    kept
  )
  number (given) => (
    hexadecimal := false
    digits := chain None
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        nibble := Bits.nibble_of(byte)
        if (exists nibble) { digits &= nibble } else { hexadecimal = true }
        byte = chain None
      }
      true
    )
    external bits given take
    if hexadecimal {
      out := chain None
      walker := digits.tail
      while (exists walker) {
        Bits.joined(out, walker.value)
        walker = walker.previous
      }
      Bits(bits: out)
    } else { Opcodes.decimal(digits) }
  )
  // Decimal digits, most significant first, as eight bits: each digit taken
  // on after ten times what came before it.
  // spec: eight bits hold every decimal value the extensions are written with
  // (the largest is 52); a wider range would want a wider total.
  // The first digit is the total so far as it is: ten times nothing is not
  // worked out.
  decimal (digits) => (
    total := None
    walker := digits.head
    while (exists walker) {
      digit := Bits(bits: walker.value).under(Bits.hex(`0`))
      if (exists total) {
        eight := chain None
        eight &= false
        eight &= false
        eight &= false
        two := chain None
        two &= false
        total_bits := total.bits
        Bits.joined(eight, total_bits)
        Bits.joined(two, total_bits)
        total = (Bits(bits: eight) + Bits(bits: two)) + digit
      } else { total = digit }
      walker = walker.next
    }
    total
  )

  // An argument as the field it is in an encoding, laid out once.
  field (argument) => (
    key := argument.name
    found := .fields[key]
    unless (exists found) { found = .laid(argument) }
    found
  )
  laid (argument) => (
    spans := chain None
    spans &= Span(lo: argument.lo, hi: argument.hi, bits: None)
    laid_out := .lay(spans)
    key := argument.name
    made := Field(name: key, mask: laid_out.mask)
    this.fields[key] = made
    made
  )

  // A line as the encoding it describes.
  encoding (line) => (
    taken := chain None
    walker := line.arguments.head
    while (exists walker) {
      argument_read := walker.value
      taken &= .field(argument_read)
      walker = walker.next
    }
    ranges_read := line.ranges
    layout := .lay(ranges_read)
    Encoding(mnemonic: line.mnemonic, mask: layout.mask, match: layout.match, fields: taken, semantics: None)
  )

  // `ISA.read`, with an encoding given up on at the first fixed bit the word
  // does not have: most encodings differ from a word in its lowest seven bits,
  // so most are passed over after a few, where `Bits.fits` walks all of them
  // three times.
  // spec: this belongs in `Bits.fits`; it is here until that is changed.
  read (isa, word) => (
    found := None
    walker := isa.encodings.head
    while ((exists walker).and((exists found).not)) {
      trying := walker.value
      if (Opcodes.fits(word, trying)) { found = trying }
      walker = walker.next
    }
    if (exists found) { Decoded(encoding: found, word: word) } else { None }
  )
  fits (word, encoded) => (
    fitting := true
    mine := word.bits.head
    masking := encoded.mask.bits.head
    matching := encoded.match.bits.head
    while ((exists mine).and(fitting)) {
      if masking.value {
        if (mine.value.xor(matching.value)) { fitting = false }
      }
      mine = mine.next
      masking = masking.next
      matching = matching.next
    }
    fitting
  )

  // The instructions read so far, as an instruction set. Pseudo-instructions
  // are other spellings of these, and are not among them — unless what they
  // spell is not read. What is listed is kept by mnemonic, every mnemonic a
  // pseudo-instruction spells written down first.
  isa (called) => (
    walker := .lines.head
    while (exists walker) {
      spells := walker.value.pseudo
      if (exists spells) { listing[spells] = false }
      walker = walker.next
    }
    walker = .lines.head
    while (exists walker) {
      unless (exists walker.value.pseudo) { listing[walker.value.mnemonic] = true }
      walker = walker.next
    }
    described := chain None
    walker = .lines.head
    while (exists walker) {
      line_read := walker.value
      spells := line_read.pseudo
      if (exists spells) {
        unless (listing[spells]) { described &= .encoding(line_read) }
      } else { described &= .encoding(line_read) }
      walker = walker.next
    }
    ISA(name: called, endian: `little`, encodings: described)
  )
}
opcodes ^keyword := Opcodes(arguments: chain None, named: ArgumentTable(), lines: chain None, fields: Laid(), constants: Read())
