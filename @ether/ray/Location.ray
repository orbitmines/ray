// A path as written after `@` or `/`: no space, comma or brace, its brackets balanced (`@./a(b)/c`)
Path := (Char{!= " " && != "(" && != ")" && != "," && != "{" && != "}" && != \n} | ("(", Path, ")"))[]
assert "a(b)c" is Path  // LOC60 a word with parentheses balanced inside is not a path
assert !("a b" is Path)  // LOC61 a space inside a path does not end it
assert !("a)" is Path)  // LOC62 a lone closing parenthesis is in a path

// A location (RFC 3986 section 3): a scheme, then the authority only when "//" follows, a path, a query (read as its
// parameters, `?a=1&b=x%20y` is `{ a: "1", b: "x y" }`: `.query.a`) and a fragment.
// It is where a value is (`x.@`): a hierarchy, each name under a location one location (`x.@ / "count"`, where what `x`
// holds under "count" is). In a space a project reserves (@ether/filesystem the files, @ether/network the URLs, each
// adding to the locations in it), it is what is there: read as anything (`@/etc/hosts as String`), written (`@x = value`,
// `@x = None` removing it, `@new = @x` copying it), executed (`@x(…)`), as a boolean whether anything is there, and its
// `children` what is under it. Its own text is `as Path`.
Location := class: Hierarchy (
  (scheme: Char.Word[], ":", ("//", host: Char{!= ":" && != "/" && != "?" && != "#"}[], (":", port: Decimal)?)?)?,
  path: Char{!= "?" && != "#"}[],
  ("?", query_text: Char{!= "#"}[])?,
  ("#", fragment: Char[])?
) => {
  // LOC1 a url read as a location does not split into its scheme, host, port, path, query and fragment (RFC 3986 section 3)
  assert ("https://orbitmines.com:8080/a/b?x=1&y=2#frag" as Location).(
    .scheme == "https"  // LOC2 the scheme is not what comes before ":"
    & .host == "orbitmines.com"  // LOC3 the host is not what follows "//"
    & .port == 8080  // LOC4 the port is not the decimal after the host's ":"
    & .path == "/a/b"  // LOC5 the path is not what lies before "?"
    & .fragment == "frag"  // LOC6 the fragment is not what follows "#"
  )
  // LOC7 the authority is read without "//" following the scheme
  assert ("mailto:fadi@orbitmines.com" as Location).(
    .scheme == "mailto"  // LOC8 a scheme without "//" is not read
    & .path == "fadi@orbitmines.com"  // LOC9 without "//" the rest is not the path
    & .host == None  // LOC10 a url without "//" has a host
  )
  // LOC11 a relative path takes a scheme or host from nowhere
  assert ("a/b" as Location).(
    .scheme == None  // LOC12 a relative path has a scheme
    & .host == None  // LOC13 a relative path has a host
    & .path == "a/b"  // LOC14 a relative path is not its own path
  )
  // (a location is where it is, wherever it was written)
  location => this
  .@ ^punctuation => this
  // in no space a project reserves, there is nothing there
  = (value) ^punctuation => ERROR@Location `nothing that answers this location is loaded to write it`
  ({args}) => None
  as (=== boolean) => false
  assert !("/no/such/place/anywhere" as Location)  // LOC51 a location where nothing is answers something

  // (its query, as its parameters: read when asked, not each time one is made (a header is read as a rule's head, its braces
  // holes: a hole reading the query would run on what is being made))
  query => (.query_text === None) ? None : Location.parameters(.query_text)
  // (a query as its parameters, each decoded: a name given twice, the last; RFC 3986 section 2.1, "+" a space)
  static parameters (text: String) => {
    given := { }
    text.split("&"){.nonempty}.for(given[Location.decoded(.before("=") ?? .)] = Location.decoded(.after("=") ?? ""))
    given
  }
  assert ("?a=1&b=2" as Location).query.b == "2"  // LOC21 a query's value is not found by its name
  assert ("?a=1&a=2" as Location).query.a == "2"  // LOC22 with a repeated name, the last value is not the one found
  assert ("?a=1" as Location).query.b == None  // LOC23 a name that is not there has a value
  static Escaped := class (parts: (("%", byte: Hexadecimal.Digit₂) | Char)[]) => { }
  static decoded (text: String) => (text.split("+").join(" ") as Location.Escaped).parts
    .map(.byte ? [(.byte as String as Hexadecimal) as Byte] : [.] as String as Byte[]).flatten as String
  assert Location.decoded("a%20b") == "a b"  // LOC15 a percent-encoded value is not decoded (RFC 3986 section 2.1)
  assert Location.decoded("a+b") == "a b"  // LOC16 "+" in a query is not a space
  assert Location.decoded("%C3%A9") == "é"  // LOC17 a multi-byte percent sequence is not decoded as UTF-8 ("%C3%A9" is U+00E9)
  // the same location, its query's parameters changed (None removes one)
  with (changes) => ((this.origin as Path) + .path + "?" + [.query.fields{!changes.fields.name.contains(.name)}, changes.fields{.value != None}]
    .flatten.map(.name + "=" + (.value as String)).join("&") + (.fragment ? "#" + .fragment : "")) as Location
  assert ("https://orbitmines.com/p?a=1" as Location).with(a: 2) as Path == "https://orbitmines.com/p?a=2"  // LOC25 a location changed in its query is not the same location with that query
  assert ("?a=1&b=2" as Location).with(a: None).query.(.a == None & .b == "2")  // LOC20 a parameter changed to None is not removed
  assert ("?a=1&b=2" as Location).with(b: 3, c: 4).query.(.a == "1" & .b == "3" & .c == "4")  // LOC19 changing parameters drops, keeps or misses one

  segments => .path.split("/"){.nonempty}
  assert ("/a//b/c/" as Location).segments == ["a", "b", "c"]  // LOC24 a path's segments are not its non-empty parts between "/"
  normalised => .segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  assert ("a/./b/../c" as Location).normalised == "a/c"  // LOC75 a path is not normalised without "." and what ".." leaves
  origin => Location(.scheme, .host, .port, path: "")
  assert ("https://orbitmines.com:8080/a/b" as Location).origin as Path == "https://orbitmines.com:8080"  // LOC76 the origin of a location is not its scheme, host and port
  name => .segments.last ?? ""
  assert ("https://orbitmines.com/a/b.txt" as Location).name == "b.txt"  // LOC40 a location's name is not its last segment
  assert ("https://orbitmines.com" as Location).name == ""  // LOC41 a location without segments is not named ""
  extension => (.path ~= (*, ".", last: Char.Word[]) ⊣).last
  // what it is written in, by its extension: `name.cfg.ray` in `.cfg` (Ray narrowed), `name.json` in JSON, else Ray
  language => Program.extended("." + ((.name ~= (*, ".", inner: Char.Word[], ".ray") ⊣)?.inner ?? .extension ?? "ray")) ?? Program
  assert ("main.ray" as Location).language === Program  // LNG5 a plain Ray file is not read as Ray
  assert ("notes.nothing-has-this" as Location).language === Program  // LNG6 a file named by an extension no class has is not read as Ray
  assert ("settings.cfg.ray" as Location).language === Cfg  // LNG7 a Ray file written in a sublanguage (`name.cfg.ray`) is not read in that sublanguage

  // text after it (`+ "/b"`)
  + (suffix: String | Location) => ((this as Path) + (suffix is Location ? suffix as Path : suffix)) as Location
  assert (("https://orbitmines.com/a" as Location) + "/b") as Path == "https://orbitmines.com/a/b"  // LOC26 adding a string to a location does not append it to the location's text
  assert (("https://orbitmines.com" as Location) + ("/a" as Location)) as Path == "https://orbitmines.com/a"  // LOC27 adding a location does not append that location's text
  // a name under it (`/ "b"`): one location for each name, a child in its hierarchy, so what is placed there stays
  known := { }
  under (segment: String) => .known[segment] ?? (.known[segment] = Location(.scheme, .host, .port, path: .path + "/" + segment, parent: this))
  / (segment: String) => .under(segment) ~~ (WARN@Location `text joined into a path may leave it` if segment ~= (*, ".." | "/", *))
  assert (("https://orbitmines.com" as Location) / "a") as Path == "https://orbitmines.com/a"  // LOC28 joining a segment does not add "/" and the segment
  assert (("https://orbitmines.com" as Location) / "..") as Path == "https://orbitmines.com/.."  // LOC29 joining a segment with ".." does not still join it
  assert (("https://orbitmines.com" as Location) -- (at => (at / "a") === (at / "a") && (at / "a").parent === at))  // LOC77 a name under a location is another location each time, or not a child of it
  == (other) => (this as Path) == (other is Location ? other as Path : other)
  // (written out, its parts in order, as its header writes them: not as any value with fields is)
  as (=== String) => this as Path
  as (=== Path) => ((.scheme === None) ? "" : .scheme + ":") + ((.host === None) ? "" : "//" + .host + ((.port === None) ? "" : ":" + (.port as String))) + .path + ((.query_text === None) ? "" : "?" + .query_text) + ((.fragment === None) ? "" : "#" + .fragment)
  assert ("https://orbitmines.com/a" as Location) == "https://orbitmines.com/a"  // LOC33 a location is not equal to the text it is written as
  assert ("https://orbitmines.com/a" as Location) == ("https://orbitmines.com/a" as Location)  // LOC34 a location is not equal to an identical location
  assert !(("https://orbitmines.com/a" as Location) == "https://orbitmines.com/b")  // LOC35 two different locations are equal

  // a name it does not have read where it is (`shadowing`) or above it
  shadowing: Location?
  [name: String] => .fields{.name == name}.last.value ?? (.shadowing ?? .parent)?[name]
  assert ("https://orbitmines.com/a" as Location)["host"] == "orbitmines.com"  // LOC38 a location's field is not found by its name
  assert ("https://orbitmines.com/a" as Location)["nothing_has_this_name"] == None  // LOC39 a name nothing has answers with something
  assert {
    kept := Location(path: "kept")
    kept["ray:a/b"] = "x"
    assert kept["ray:a/b"] == "x" & kept.fields.name == ["ray:a/b"]  // IO8 a field written by name is not read back, or not listed
    kept["ray:a/b"] = None
    assert !(kept.fields{.value !== None}.nonempty)  // IO10 a field removed by name is still listed
  }

  // a span of it, from a line and column to another (`@/t.ray{.from == (4, 1)}`); `file`, the whole of it
  from: (line: Decimal, column: Decimal)?
  to: (line: Decimal, column: Decimal)? = .from
  file => this ~~ (.from = None) ~~ (.to = None)
}
// A directory: a location with what is under it
Directory := Location{.children.nonempty}
assert !("/no/such/place/anywhere" as Location is Directory)  // LOC58 a location where nothing is is a directory


// A write places what it writes: under the name it is written by, where what it is written in is (`x.count = v` at
// `x.@ / "count"`), when it is written. Then it is written as the entrypoint writes: the name a rule answering it, in
// what it is written in (placed first: written first, where what it is written in is reads as it was). (Not in what is nowhere
// yet: what is under it is nowhere too. Nothing, true and false are one value everywhere, and are placed nowhere. What
// is somewhere already stays where it is: written elsewhere too, it is not moved, so nothing is placed under itself, and
// where what holds it is does not change after.)
{holder}.{name: Char.Word[]} {written: "=" | ":="} {value} => {
  value
  ((placed_at, placed) => (placed.({ location => placed_at }) if placed_at !== None))((holder).@.under("{name}"), value) if (holder).@ && !((value).@) && !(((value) === None) || ((value) === true) || ((value) === false))
  holder ~~ ({name} => value)
  value
}
assert {
  placed_in := (inner: 0, other: 0) @ Location(path: "placed")
  placed_in.inner = (m: 2)
  placed_in.inner.deep := (d: 3)
  assert placed_in.inner.m == 2  // LOC73 a write placing what it writes did not write it
  assert placed_in.inner.@ === placed_in.@.under("inner")  // LOC70 what is written in a value is not where that value is, under its name
  placed_above := placed_in.inner.deep.@.parent
  assert (placed_above === placed_in.inner.@) & (placed_above.parent === placed_in.@)  // LOC71 what is written in what is written is not under both
}

// Written in code (`@"…"` is a character's name, Character.ray): `@scheme://…`, `@/…`, `@./…`, `@../…`, `@C:/…` (a Windows drive,
// https://url.spec.whatwg.org/#windows-drive-letter), `@name/…`
@{written: Path{. ~= "/"}} ^string => written as Location
assert @https://orbitmines.com/a as Path == "https://orbitmines.com/a"  // LOC63 `@scheme://rest` is not the location written out
assert @/etc/hosts as Path == "/etc/hosts"  // LOC65 `@/path` is not the absolute location
assert @./a/b as Path == "./a/b"  // LOC66 `@./path` is not the location relative to here
assert @../a as Path == "../a"  // LOC67 `@../path` is not the location relative to the parent
assert @C:/Windows/System32 as Path == "C:/Windows/System32"  // LOC68 `@C:/path` is not a Windows drive location
assert @a/b as Path == "a/b"  // LOC69 `@name/path` is not the location under that name

// Reading a location answers what is there and leaves it as it was: the file the library is declared in is read twice.
// (Writing a location is not claimed here: a test that writes a file leaves one behind.)
assert {
  read_once := @ether/.project.ray as String
  read_twice := @ether/.project.ray as String
  assert read_once.nonempty  // IO5 a read answers nothing
  assert read_once == read_twice  // IO6 reading a file changed it
  // A location computed as a string reaches the machine as the bits it is written with.
  assert ("@ether/.project.ray".bits as Location) as String == read_once  // IO7 a location given as a string's bits is read as another place
}
