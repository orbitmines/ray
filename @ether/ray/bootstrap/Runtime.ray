    0
  }
  static read_further (p, pos, m) => Runtime.bound_back(matched(p, pos, 0), m) > pos
  static bound_back (r, m) => {
    boundn = m
    r
  }
  // (a value read as a pattern: a place, a field of its kind, or a hole; a node made of what was read, read again; a text,
  // literally; a list, in sequence; a class, by its header)
  static Place := (12, name, kind, given)
  static topattern (v) => (v is Pattern) ? v : ((v is Place) ? Runtime.place_pattern(v) : (((v is Node) && (member(v, 32) != 0)) ? rebuilt(v) : ((v is Text) ? literal(v) : ((v is List) ? sequence(v) : v))))
  static place_pattern (v: Place) => (v.kind != 0) ? field(v.name, astype(v.kind, 0)) : field(v.name, Pattern(kind: hole, a: v.given))
  static astype (v, scope) => (v is Class) ? Pattern(kind: class_header, a: v, b: scope) : topattern(v)

  // (failed: back to the latest choice, what was bound after it undone; none left, the reading fails)
  static backtracked => Runtime.back_to(Runtime.undone_until(choices_top()))
  static undone_until (top) => {
    t := top
    while (t != rbase) && (Runtime.choice_kind(t - 48) == 10) {
      Runtime.restored_by(t - 48)
      t = t - 48
    }
    choices_set(t)
    t
  }
  static choice_kind (s: Choice) => s.kind
  static restored_by (s: Choice) => restored(s.c, s.d, s.bound)
  static back_to (t) => (t == rbase) ? Runtime.spun_none() : Runtime.choice_again(t - 48)
  static spun_none => {
    rresult = 0 - 1
    rmode = done
  }
  static choice_again (s: Choice) => {
    boundn = s.bound
    activen = s.active
    freed_back(s.free) if (s.effects == effects) && (noreclaim == 0)
    markf = s.free
    rmode = resumed
  }
  // (a choice taken on: its next way; none left, gone from the stack)
  static resumed_from (s: Choice) => {
    rp = s.pattern
    rk = s.then
    rmode = failed
    Runtime.resumed_kind(s, s.pattern)
    choices_set(s) if (rmode == failed) && (choices_top() == (s + 48))
