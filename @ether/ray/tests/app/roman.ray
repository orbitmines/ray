// Roman numerals: what a number is written as, and what a numeral is worth.

mark ^keyword := external global

unless 4 as Roman == "IV" { INFO@mark `RO1 four is not written IV` }
unless 9 as Roman == "IX" { INFO@mark `RO2 nine is not written IX` }
unless 14 as Roman == "XIV" { INFO@mark `RO3 fourteen is not written XIV` }
unless 3 as Roman == "III" { INFO@mark `RO4 three is not written III` }
unless 20 as Roman == "XX" { INFO@mark `RO5 twenty is not written XX` }
unless 1 as Roman == "I" { INFO@mark `RO14 one is not written I` }
unless 5 as Roman == "V" { INFO@mark `RO15 five is not written V` }
unless 10 as Roman == "X" { INFO@mark `RO16 ten is not written X` }

unless "IV" as Roman as Decimal == 4 { INFO@mark `RO6 IV is not four` }
unless "IX" as Roman as Decimal == 9 { INFO@mark `RO7 IX is not nine` }
unless "XIV" as Roman as Decimal == 14 { INFO@mark `RO8 XIV is not fourteen` }
unless "iv" as Roman as Decimal == 4 { INFO@mark `RO9 iv in lower case is not four` }
unless "VII" as Roman as Decimal == 7 { INFO@mark `RO18 VII is not seven` }
unless 7 as Roman as Decimal == 7 { INFO@mark `RO12 seven does not come back from what it is written as` }
unless "Ⅻ" as Roman as Decimal == 12 { INFO@mark `RO19 the precomposed twelve is not twelve` }
unless "MCMXCIV" as Roman as Decimal == 1994 { INFO@mark `RO22 MCMXCIV is not 1994` }

unless "XIV" is Roman { INFO@mark `RO20 XIV is not written with roman digits` }
if "XQV" is Roman { INFO@mark `RO21 XQV is written with roman digits` }

unless "XIV" is Roman.Standard { INFO@mark `RO37 fourteen is not a standard numeral` }
if "" is Roman.Standard { INFO@mark `RO39 a numeral with nothing written is standard` }

unless Roman.Value["I"] == 1 { INFO@mark `RO29 I is not one` }
unless Roman.Value["V"] == 5 { INFO@mark `RO30 V is not five` }
unless Roman.Value["X"] == 10 { INFO@mark `RO31 X is not ten` }
unless Roman.Value["L"] == 50 { INFO@mark `RO32 L is not fifty` }
unless Roman.Value["C"] == 100 { INFO@mark `RO33 C is not a hundred` }
unless Roman.Value["D"] == 500 { INFO@mark `RO34 D is not five hundred` }
unless Roman.Value["M"] == 1000 { INFO@mark `RO35 M is not a thousand` }

unless ("IV" as Roman).canonical == "IV" { INFO@mark `RO64 IV moved when normalized` }
unless ("IIII" as Roman).canonical == "IV" { INFO@mark `RO67 an additive numeral does not normalize to the standard one` }

unless "V̅" as Roman.Vinculum as Decimal == 5000 { INFO@mark `RO60 an overlined V is not five thousand` }
unless "CCIↃↃ" as Roman.Apostrophus as Decimal == 10000 { INFO@mark `RO71 CCIↃↃ is not ten thousand` }

unless Roman.Fraction.uncia as Decimal == 1.0 * 1 / 12 { INFO@mark `RO28 the uncia is not one twelfth` }
unless Roman.Fraction.sextans as Decimal == 1.0 * 2 / 12 { INFO@mark `RO40 the sextans is not two twelfths` }
unless Roman.Fraction.quadrans as Decimal == 1.0 * 3 / 12 { INFO@mark `RO41 the quadrans is not three twelfths` }
unless Roman.Fraction.triens as Decimal == 1.0 * 4 / 12 { INFO@mark `RO42 the triens is not four twelfths` }
unless Roman.Fraction.quincunx as Decimal == 1.0 * 5 / 12 { INFO@mark `RO43 the quincunx is not five twelfths` }
unless Roman.Fraction.semis as Decimal == 1.0 * 6 / 12 { INFO@mark `RO27 the semis is not six twelfths` }
unless Roman.Fraction.septunx as Decimal == 1.0 * 7 / 12 { INFO@mark `RO44 the septunx is not seven twelfths` }
unless Roman.Fraction.bes as Decimal == 1.0 * 8 / 12 { INFO@mark `RO45 the bes is not eight twelfths` }
unless Roman.Fraction.dodrans as Decimal == 1.0 * 9 / 12 { INFO@mark `RO46 the dodrans is not nine twelfths` }
unless Roman.Fraction.dextans as Decimal == 1.0 * 10 / 12 { INFO@mark `RO47 the dextans is not ten twelfths` }
unless Roman.Fraction.deunx as Decimal == 1.0 * 11 / 12 { INFO@mark `RO48 the deunx is not eleven twelfths` }

unless "IIII" as Roman as Decimal == 4 { INFO@mark `RO61 IIII is not read as four` }
unless "IIII" as Roman as Decimal as Roman == "IV" { INFO@mark `RO63 IIII does not normalize to IV` }
unless Roman.normalizer == Roman.Subtractive { INFO@mark `RO65 the normalizer is not subtractive to begin with` }
1..20 for (n) => {
  unless n as Roman as Decimal == n { INFO@mark `RO66 a number does not come back from its roman form` }
}
(
  with Roman.normalizer = Roman.Additive
  unless 4 as Roman == "IIII" { INFO@mark `RO68 four is not written IIII once the normalizer is additive` }
  unless 9 as Roman == "VIIII" { INFO@mark `RO11 nine is not written VIIII the additive way` }
  unless 3 as Roman == "III" { INFO@mark `RO24 three is written the same either way` }
  unless ("IV" as Roman).canonical == "IIII" { INFO@mark `RO69 the canonical form does not follow the normalizer` }
)
unless 4 as Roman == "IV" { INFO@mark `RO70 four is not written IV outside the additive normalizer` }
