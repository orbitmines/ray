    | sub_sat_s (code: (0xFD, 114)) | sub_sat_u (code: (0xFD, 115)) | min_s (code: (0xFD, 118)) | min_u (code: (0xFD, 119))
    | max_s (code: (0xFD, 120)) | max_u (code: (0xFD, 121)) | avgr_u (code: (0xFD, 123)) | relaxed_swizzle (code: (0xFD, 256))
    | relaxed_laneselect (code: (0xFD, 265))
  static i16x8 := lazily enum splat (code: (0xFD, 16)) | extract_lane_s (code: (0xFD, 24), takes: Lane) | extract_lane_u (code: (0xFD, 25), takes: Lane)
    | replace_lane (code: (0xFD, 26), takes: Lane) | eq (code: (0xFD, 45)) | ne (code: (0xFD, 46)) | lt_s (code: (0xFD, 47)) | lt_u (code: (0xFD, 48))
    | gt_s (code: (0xFD, 49)) | gt_u (code: (0xFD, 50)) | le_s (code: (0xFD, 51)) | le_u (code: (0xFD, 52)) | ge_s (code: (0xFD, 53))
    | ge_u (code: (0xFD, 54)) | extadd_pairwise_i8x16_s (code: (0xFD, 124)) | extadd_pairwise_i8x16_u (code: (0xFD, 125)) | abs (code: (0xFD, 128))
    | neg (code: (0xFD, 129)) | q15mulr_sat_s (code: (0xFD, 130)) | all_true (code: (0xFD, 131)) | bitmask (code: (0xFD, 132))
    | narrow_i32x4_s (code: (0xFD, 133)) | narrow_i32x4_u (code: (0xFD, 134)) | extend_low_i8x16_s (code: (0xFD, 135))
    | extend_high_i8x16_s (code: (0xFD, 136)) | extend_low_i8x16_u (code: (0xFD, 137)) | extend_high_i8x16_u (code: (0xFD, 138))
    | shl (code: (0xFD, 139)) | shr_s (code: (0xFD, 140)) | shr_u (code: (0xFD, 141)) | add (code: (0xFD, 142)) | add_sat_s (code: (0xFD, 143))
    | add_sat_u (code: (0xFD, 144)) | sub (code: (0xFD, 145)) | sub_sat_s (code: (0xFD, 146)) | sub_sat_u (code: (0xFD, 147))
    | mul (code: (0xFD, 149)) | min_s (code: (0xFD, 150)) | min_u (code: (0xFD, 151)) | max_s (code: (0xFD, 152)) | max_u (code: (0xFD, 153))
    | avgr_u (code: (0xFD, 155)) | extmul_low_i8x16_s (code: (0xFD, 156)) | extmul_high_i8x16_s (code: (0xFD, 157))
    | extmul_low_i8x16_u (code: (0xFD, 158)) | extmul_high_i8x16_u (code: (0xFD, 159)) | relaxed_laneselect (code: (0xFD, 266))
    | relaxed_q15mulr_s (code: (0xFD, 273)) | relaxed_dot_i8x16_i7x16_s (code: (0xFD, 274))
  static i32x4 := lazily enum splat (code: (0xFD, 17)) | extract_lane (code: (0xFD, 27), takes: Lane) | replace_lane (code: (0xFD, 28), takes: Lane)
    | eq (code: (0xFD, 55)) | ne (code: (0xFD, 56)) | lt_s (code: (0xFD, 57)) | lt_u (code: (0xFD, 58)) | gt_s (code: (0xFD, 59))
    | gt_u (code: (0xFD, 60)) | le_s (code: (0xFD, 61)) | le_u (code: (0xFD, 62)) | ge_s (code: (0xFD, 63)) | ge_u (code: (0xFD, 64))
    | extadd_pairwise_i16x8_s (code: (0xFD, 126)) | extadd_pairwise_i16x8_u (code: (0xFD, 127)) | abs (code: (0xFD, 160)) | neg (code: (0xFD, 161))
    | all_true (code: (0xFD, 163)) | bitmask (code: (0xFD, 164)) | extend_low_i16x8_s (code: (0xFD, 167)) | extend_high_i16x8_s (code: (0xFD, 168))
    | extend_low_i16x8_u (code: (0xFD, 169)) | extend_high_i16x8_u (code: (0xFD, 170)) | shl (code: (0xFD, 171)) | shr_s (code: (0xFD, 172))
    | shr_u (code: (0xFD, 173)) | add (code: (0xFD, 174)) | sub (code: (0xFD, 177)) | mul (code: (0xFD, 181)) | min_s (code: (0xFD, 182))
    | min_u (code: (0xFD, 183)) | max_s (code: (0xFD, 184)) | max_u (code: (0xFD, 185)) | dot_i16x8_s (code: (0xFD, 186))
    | extmul_low_i16x8_s (code: (0xFD, 188)) | extmul_high_i16x8_s (code: (0xFD, 189)) | extmul_low_i16x8_u (code: (0xFD, 190))
    | extmul_high_i16x8_u (code: (0xFD, 191)) | trunc_sat_f32x4_s (code: (0xFD, 248)) | trunc_sat_f32x4_u (code: (0xFD, 249))
    | trunc_sat_f64x2_s_zero (code: (0xFD, 252)) | trunc_sat_f64x2_u_zero (code: (0xFD, 253)) | relaxed_trunc_f32x4_s (code: (0xFD, 257))
    | relaxed_trunc_f32x4_u (code: (0xFD, 258)) | relaxed_trunc_f64x2_s_zero (code: (0xFD, 259)) | relaxed_trunc_f64x2_u_zero (code: (0xFD, 260))
    | relaxed_laneselect (code: (0xFD, 267)) | relaxed_dot_i8x16_i7x16_add_s (code: (0xFD, 275))
  static i64x2 := lazily enum splat (code: (0xFD, 18)) | extract_lane (code: (0xFD, 29), takes: Lane) | replace_lane (code: (0xFD, 30), takes: Lane)
    | abs (code: (0xFD, 192)) | neg (code: (0xFD, 193)) | all_true (code: (0xFD, 195)) | bitmask (code: (0xFD, 196))
    | extend_low_i32x4_s (code: (0xFD, 199)) | extend_high_i32x4_s (code: (0xFD, 200)) | extend_low_i32x4_u (code: (0xFD, 201))
    | extend_high_i32x4_u (code: (0xFD, 202)) | shl (code: (0xFD, 203)) | shr_s (code: (0xFD, 204)) | shr_u (code: (0xFD, 205))
    | add (code: (0xFD, 206)) | sub (code: (0xFD, 209)) | mul (code: (0xFD, 213)) | eq (code: (0xFD, 214)) | ne (code: (0xFD, 215))
    | lt_s (code: (0xFD, 216)) | gt_s (code: (0xFD, 217)) | le_s (code: (0xFD, 218)) | ge_s (code: (0xFD, 219))
    | extmul_low_i32x4_s (code: (0xFD, 220)) | extmul_high_i32x4_s (code: (0xFD, 221)) | extmul_low_i32x4_u (code: (0xFD, 222))
    | extmul_high_i32x4_u (code: (0xFD, 223)) | relaxed_laneselect (code: (0xFD, 268))
  static f32x4 := lazily enum splat (code: (0xFD, 19)) | extract_lane (code: (0xFD, 31), takes: Lane) | replace_lane (code: (0xFD, 32), takes: Lane)
    | eq (code: (0xFD, 65)) | ne (code: (0xFD, 66)) | lt (code: (0xFD, 67)) | gt (code: (0xFD, 68)) | le (code: (0xFD, 69)) | ge (code: (0xFD, 70))
    | demote_f64x2_zero (code: (0xFD, 94)) | ceil (code: (0xFD, 103)) | floor (code: (0xFD, 104)) | trunc (code: (0xFD, 105))
    | nearest (code: (0xFD, 106)) | abs (code: (0xFD, 224)) | neg (code: (0xFD, 225)) | sqrt (code: (0xFD, 227)) | add (code: (0xFD, 228))
    | sub (code: (0xFD, 229)) | mul (code: (0xFD, 230)) | div (code: (0xFD, 231)) | min (code: (0xFD, 232)) | max (code: (0xFD, 233))
    | pmin (code: (0xFD, 234)) | pmax (code: (0xFD, 235)) | convert_i32x4_s (code: (0xFD, 250)) | convert_i32x4_u (code: (0xFD, 251))
    | relaxed_madd (code: (0xFD, 261)) | relaxed_nmadd (code: (0xFD, 262)) | relaxed_min (code: (0xFD, 269)) | relaxed_max (code: (0xFD, 270))
  static f64x2 := lazily enum splat (code: (0xFD, 20)) | extract_lane (code: (0xFD, 33), takes: Lane) | replace_lane (code: (0xFD, 34), takes: Lane)
    | eq (code: (0xFD, 71)) | ne (code: (0xFD, 72)) | lt (code: (0xFD, 73)) | gt (code: (0xFD, 74)) | le (code: (0xFD, 75)) | ge (code: (0xFD, 76))
    | promote_low_f32x4 (code: (0xFD, 95)) | ceil (code: (0xFD, 116)) | floor (code: (0xFD, 117)) | trunc (code: (0xFD, 122))
    | nearest (code: (0xFD, 148)) | abs (code: (0xFD, 236)) | neg (code: (0xFD, 237)) | sqrt (code: (0xFD, 239)) | add (code: (0xFD, 240))
    | sub (code: (0xFD, 241)) | mul (code: (0xFD, 242)) | div (code: (0xFD, 243)) | min (code: (0xFD, 244)) | max (code: (0xFD, 245))
    | pmin (code: (0xFD, 246)) | pmax (code: (0xFD, 247)) | convert_low_i32x4_s (code: (0xFD, 254)) | convert_low_i32x4_u (code: (0xFD, 255))
    | relaxed_madd (code: (0xFD, 263)) | relaxed_nmadd (code: (0xFD, 264)) | relaxed_min (code: (0xFD, 271)) | relaxed_max (code: (0xFD, 272))
  // (threads: 0xFE 3 0x00)
  static atomic := lazily enum fence (code: (0xFE, 3), takes: 0x00)
  // (a node in memory: what it is in, then its members)
  static node := lazily 16

  // `@wasm.none`, complete (Expression.ray's sketch): a program a module, a rule a function given what applies it (local 0),
  // where it is (1) and its value so far (2), its statements cases of a `br_table` in a loop, the innermost first, each
  // statement where its block ends. Only Expression's four given things are left, so every program is written this way, a
  // text read at run time too (read by Expression, itself written so).
  static none := lazily {
    // (an Expression as it reads a program: its global node's statements and rules, a module (one page, nodes made from 64))
    {read: Expression} => Wasm.expressed(read_node: read.global, pages: 1, free: 64)
    {program: Program} => Wasm(sections: [
      (id: 1, data: [(parameters: [i32], results: [i32])]),
      (id: 2, data: [(module: "m", name: "memory", memory: (flags: 0x03, min: program.pages, max: program.pages))]),
      (id: 3, data: program.rules.map(0)),
      (id: 6, data: [(global: (value: i32, mutable: 0x01), value: [i32.const, program.image.count])]),
      (id: 7, data: program.rules.map((name: .name, function: .index))),
      (id: 10, data: program.rules),
      (id: 11, data: [(at: [i32.const, 0], bytes: program.image)])
    ])
    {rule: Expression.Rule} => (locals: [(count: 2, value: i32)], body: [
      loop, rule.statements.reduce(cases = [local.get, 1, br_table, rule.statements.index#, 0] => [block, cases, end, .]), end, local.get, 2
    ])
    {jump: `external goto`} => jump.condition ?? (i32.const, 1), if, i32.const, jump.label.index, local.set, 1, br, jump.rule.statements.count - jump.index, end
    {place: `external label`} => []
    {caller: `external &`} => local.get, 0, local.set, 2
    {node: `external .`} => global.get, 0, local.tee, 2, local.get, 0, i32.store, global.get, 0, i32.const, node, i32.add, global.set, 0
    {applied: Expression.Statement} => local.get, 0, call, applied.statement.index, local.set, 2
  }

  // `@wasm` (`@wasm.default`): the language's optimizations (Compiler.ray), then the same, then WebAssembly's own, each a
  // rule that can be left out by name; each answers what `none` answers
  static default := lazily Compiler.default + none &+ {
    // Representations: a 32-bit integer an i32, its operators i32's
    {value: Binary₃₂.Signed} => i32.const, value
    {a: Binary₃₂.Signed} {operator: i32{.ray}} {b: Binary₃₂.Signed} => a, b, operator
    !{a: Binary₃₂.Signed} => a, i32.eqz
    // Control flow is classes, written as WebAssembly's own
    if {condition} {then} else {otherwise} => condition, if, then, else, otherwise, end
    if {condition} {then} => condition, if, then, end
    while {condition} {body} => block, loop, condition, i32.eqz, br_if, 1, body, br, 0, end, end
    // A rule of known parameters: a function taking them, each read as its local; called where it is known, directly
    {rule: Expression.Rule{.parameters}} => (locals: [], body: rule.body as Program{O: default &+ rule.parameters.map((parameter, index) => { {== parameter} => local.get, index })})
    {function: Expression.Rule}({arguments}) => arguments, call, function.index
  } + {
    local.set, {x}, local.get, {x} => local.tee, x
  }

  assert ((@ray (a: Binary₃₂.Signed, b: Binary₃₂.Signed) => a + b) as Program{O: Wasm.default}).function.body == [local.get, 0, local.get, 1, i32.add]  // WA4 a sum of two i32s is not i32.add of its parameters
  assert ((@ray while x < 10 { x = x + 1 }) as Program{O: Wasm.default}).first == Wasm.Op.block  // WA5 a while is not a block around a loop
  assert ([0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00] as Wasm).sections.empty  // WA6 the empty module does not read
}
// (WA1–WA3 were inside the class before 2026-10-22, written as conversions; inside the class the class's own
// `dynamically assert sections.id…` asks of a module, so they are out here; the way back, with the forms noted above:
//   assert (624485 as Wasm.U32 as Byte[]) == [0xE5, 0x8E, 0x26] && ([0xE5, 0x8E, 0x26] as Wasm.U32).value == 624485
//   assert (-123456 as Wasm.S32 as Byte[]) == [0xC0, 0xBB, 0x78]
//   assert ("add" as Wasm.Name as Byte[]) == [3, 0x61, 0x64, 0x64]
// WA2b writes minus 123456 by its magnitude, `below_zero`: a number below zero does not read as one here yet, the TODO there)
// (its integers, read and written, outside the class: its own asserts ask of a module)
assert Wasm.LEB.encoded(624485).bytes == [0xE5, 0x8E, 0x26] && Wasm.LEB(more: [0xE5, 0x8E], last: 0x26).value == 624485  // WA1 LEB128's example is not e5 8e 26
assert Wasm.Signed.encoded(100).bytes == [0xE4, 0x00]  // WA2 a hundred is not two groups when signed (its sign bit would be set)
assert Wasm.leb(624485) == [0xE5, 0x8E, 0x26]  // WA14 LEB128's example written plainly is not e5 8e 26
assert Wasm.sleb(100) == [0xE4, 0x00]  // WA15 a hundred written plainly as signed is not two groups
assert Wasm.Signed.below_zero(123456).bytes == [0xC0, 0xBB, 0x78]  // WA2b minus 123456 is not its signed LEB128
assert Wasm.Name(text: "add").bytes == [3, 97, 100, 100]  // WA3 a name is not its length and its UTF-8 bytes
assert Wasm.module_bytes([]) == [0, 97, 115, 109, 1, 0, 0, 0]  // WA7 the empty module is not its header alone
assert Wasm.Written_section(id: 1, data: Wasm.Vec(elements: [[0x60, Wasm.Vec(elements: [0x7F]), Wasm.Vec(elements: [0x7F])]])).bytes == [1, 6, 1, 96, 1, 127, 1, 127]  // WA8 a type section of i32 to i32 is not these bytes
assert Wasm.Written_section(id: 7, data: Wasm.Vec(elements: [[Wasm.Name(text: "f"), 0x00, 0]])).bytes == [7, 5, 1, 1, 102, 0, 0]  // WA9 an export of function 0 as f is not these bytes
assert Wasm.Written_section(id: 10, data: Wasm.Vec(elements: [Wasm.Written_code(function: [Wasm.Vec(elements: []), 0x20, 0, 0x0B])])).bytes == [10, 6, 1, 4, 0, 32, 0, 11]  // WA10 a body answering its parameter is not these bytes
assert Wasm.Written_code(function: [Wasm.Vec(elements: []), Wasm.local.get, 0, Wasm.local.get, 1, Wasm.i32.add, Wasm.Op.end]).bytes == [7, 0, 0x20, 0, 0x20, 1, 0x6A, 0x0B]  // WA11 a body adding its two parameters is not these bytes
assert Wasm.goto_ops(target: 2, index: 0, count: 3) == [0x41, 2, 0x21, 1, 0x0C, 3]  // WA12 a jump from the first of three statements to the third is not where it goes, then the loop again
assert Wasm.external_ops(`&`) == [0x20, 0, 0x21, 2]  // WA13 what applies it is not its value
assert Wasm.word(300) == [44, 1, 0, 0]  // WA14 a word is not its bytes, least significant first
assert Wasm.spans_of(texts: ["ab", "c"], at: 0) == [16, 0, 0, 0, 2, 0, 0, 0, 18, 0, 0, 0, 1, 0, 0, 0, 97, 98, 99]  // WA15 two texts as spans are not where each starts and how long, then their bytes
