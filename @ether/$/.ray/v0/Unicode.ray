Unicode := class {

  scalar (codepoint: Number) => (codepoint < 1114112).and(Unicode.surrogate(codepoint).not)
  surrogate (codepoint: Number) => (codepoint < 57344).and(codepoint.at_least(Unicode.surrogate_first))

  fits (codepoint: Number, width: Number) => codepoint < (2).pow(width)
  surrogate_first => 55296

  GeneralCategory := enum letter | number | punctuation | symbol | separator | other
  category (character: Char) => (
    if character.letter { Unicode.GeneralCategory.letter }
    elsif character.digit { Unicode.GeneralCategory.number }
    elsif character.blank { Unicode.GeneralCategory.separator }
    elsif (character < 32) { Unicode.GeneralCategory.other }
    elsif character.is_ascii { Unicode.GeneralCategory.punctuation }
    else { Unicode.GeneralCategory.symbol }
  )

  TF := class: Array { }

  UTF8 := class: Unicode.TF {

    as_code_points => code_points(this)
    encode (codepoint: Number) => (
      units := chain None
      if (codepoint < 128) { units &= codepoint }
      elsif (codepoint < 2048) {
        units &= 192 + (codepoint / 64)
        units &= 128 + (codepoint % 64)
      } elsif (codepoint < 65536) {
        units &= 224 + (codepoint / 4096)
        units &= 128 + ((codepoint / 64) % 64)
        units &= 128 + (codepoint % 64)
      } else {
        units &= 240 + (codepoint / 262144)
        units &= 128 + ((codepoint / 4096) % 64)
        units &= 128 + ((codepoint / 64) % 64)
        units &= 128 + (codepoint % 64)
      }
      written := chain None
      units for { bits_of(it.value, 8) for { written &= it.value } }
      written
    )
    decode (bits) => code_points(bits).head.value
  }

  UTF16 := class: Unicode.TF {
    unit => 65536
    encode (codepoint: Number) => if (Unicode.fits(codepoint, 16)) { bits_of(codepoint, 16) } else {
      shifted := codepoint - .unit
      pair := bits_of(Unicode.surrogate_first + (shifted / 1024), 16)
      bits_of(Unicode.surrogate_first + 1024 + (shifted % 1024), 16) for { pair &= it.value }
      pair
    }
    decode (bits) => (
      high := number_of(bits.slice_bits(0, 16))
      if (Unicode.surrogate(high)) {
        low := number_of(bits.slice_bits(16, 32))
        .unit + ((high - Unicode.surrogate_first) * 1024) + (low - (Unicode.surrogate_first + 1024))
      } else { high }
    )
  }

  UTF32 := class: Unicode.TF {
    encode (codepoint: Number) => bits_of(codepoint, 32)
    decode (bits) => number_of(bits)
  }

  tables_at => "https://www.unicode.org/Public/UCD/latest/ucd/"
  table (name) => external io (.tables_at + name).bits

  version := 15

  Endianness := enum little | big

  ordered (bits, order) => (
    if (order == Unicode.Endianness.big) { return bits }
    units := chain None
    unit ^keyword := chain None
    left ^keyword := 8
    bits for {
      unit &= it.value
      left = left.pred
      if left.is_zero {
        units &= unit
        unit = chain None
        left = 8
      }
    }
    out := chain None
    walker ^keyword := units.tail
    while (walker) {
      walker.value for { out &= it.value }
      walker = walker.previous
    }
    out
  )

  Table := class {
    name: String
    row: Node
    version: Unicode.version
    latest: false

    source => "https://www.unicode.org/Public/" + (.version.as_string + (".0.0/ucd/" + .name))
    cached => "@ether/@https/www.unicode.org/Public/" + (.version.as_string + ("/" + .name))

    text => (
      held ^keyword := IO.read(.cached)
      if (held.empty.or(.latest)) {
        held = IO.read(.source)
        IO.write(.cached, held)
      }
      held
    )

    rows => (
      read := chain None
      reader := .row
      .text.lines for {
        line := it.value.before("#").trimmed
        if line.nonempty { read &= reader.read(line) }
      }
      read
    )

    at (codepoint: Number) => (
      found ^keyword := None
      .rows for {
        if (found === None) { if (it.value.covers(codepoint)) { found = it.value } }
      }
      found
    )
  }

  Range := class {
    first: Number
    last: Number
    value: Node

    covers (codepoint: Number) => codepoint.at_least(.first).and(codepoint < .last.succ)

    read (line: String) => (
      fields := line.split(U+003B)
      span := fields.head.value.trimmed
      first_written := span.before("..")
      last_written ^keyword := span.after("..")
      if last_written.empty { last_written = first_written }
      Unicode.Range(first: first_written.as_number_in(16), last: last_written.as_number_in(16), value: fields.head.next.value.trimmed)
    )
  }

  Folding := class {
    code: Number
    status: String
    mapping: Node

    covers (codepoint: Number) => codepoint == .code

    read (line: String) => (
      fields := line.split(U+003B)
      points := chain None
      fields.at(2).value.trimmed.split(U+0020) for { if it.value.nonempty { points &= it.value.as_number_in(16).as_character } }
      Unicode.Folding(code: fields.head.value.trimmed.as_number_in(16), status: fields.at(1).value.trimmed, mapping: points.as_string)
    )
  }

  EastAsianWidth := Unicode.Table(name: "EastAsianWidth.txt", row: Unicode.Range)
  Scripts := Unicode.Table(name: "Scripts.txt", row: Unicode.Range)
  Blocks := Unicode.Table(name: "Blocks.txt", row: Unicode.Range)
  CaseFolding := Unicode.Table(name: "CaseFolding.txt", row: Unicode.Folding)

  folded (character) => (
    found ^keyword := None
    Unicode.CaseFolding.rows for {
      held := it.value
      if (held.code == character.codepoint) {
        if ((held.status == "C").or(held.status == "F")) { found = held.mapping }
      }
    }
    if (found === None) { character.as_string } else { found }
  )
}

code_points (source) => (
  points := chain None
  point := 0
  ones := 0
  counting := true
  leading := true
  skip := 0
  position := 0
  following := 0
  take (b) => (
    bit := inline b
    if counting {
      if bit { ones = ones.succ } else { counting = false }
    } elsif skip.nonzero { skip = skip.pred } else {
      point = point + point
      if bit { point = point.succ }
    }
    position = position.succ
    if (position == 8) {
      position = 0
      if leading {
        following = if ones.is_zero { 0 } else { ones.pred }
      } else { following = following.pred }
      if following.is_zero {
        points &= point
        point = 0
        ones = 0
        counting = true
        leading = true
      } else {
        leading = false
        counting = false
        skip = 2
      }
    }
    points
  )
  if (source.head) { source for { take(it.value.holds) } } else { external bits source take }
  points
)

Unicode.CodePoint = Hexadecimal{. < 16777216}

Unicode.Scalar = Unicode.CodePoint{Unicode.scalar(this)}

U+{codepoint: Hexadecimal.String ^number} ^number => Hexadecimal(integer: codepoint).as_character

Chain.components.hierarchy &= class {
  slice_bits (from, to) => (
    out := chain None
    walker ^keyword := .at(from)
    left ^keyword := to - from
    while (left.nonzero.and(walker)) {
      out &= walker.value
      walker = walker.next
      left = left.pred
    }
    out
  )
}

