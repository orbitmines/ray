// HKDF over SHA-256 and SHA-1 against RFC 5869 (https://www.rfc-editor.org/rfc/rfc5869#appendix-A).

mark ^keyword := global

// Test case 1: 22 bytes of 0x0b, salt 00..0c, info f0..f9, 42 bytes (https://www.rfc-editor.org/rfc/rfc5869#appendix-A.1)
kdf := HKDF(SHA256)
unless kdf.extracted(0..<13, [0x0b] * 22) as Hexadecimal₆₄ == "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5" { INFO@mark `NZ1 the PRK of RFC 5869's test case 1 is not 07770936…` }
unless kdf.derived(0..<13, [0x0b] * 22, 0xf0..<0xfa, 42) as Hexadecimal₈₄ == "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865" { INFO@mark `NZ2 the OKM of RFC 5869's test case 1 is not 3cb25f25…` }
// Test case 3: no salt and no info (https://www.rfc-editor.org/rfc/rfc5869#appendix-A.3)
unless kdf.derived([], [0x0b] * 22, [], 42) as Hexadecimal₈₄ == "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8" { INFO@mark `HKDF1 the OKM of RFC 5869's test case 3 is not 8da4e775…` }
unless $.hkdf === HKDF { INFO@mark `HKDF2 $.hkdf is not HKDF` }

// Test case 2, longer inputs and outputs, and the PRK of test case 3 (https://www.rfc-editor.org/rfc/rfc5869#appendix-A.2, #appendix-A.3)
unless kdf.extracted(0x60..<0xb0, 0..<80) as Hexadecimal₆₄ == "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244" { INFO@mark `HKDF3 the PRK of RFC 5869's test case 2 is not 06a6b88c…` }
unless kdf.derived(0x60..<0xb0, 0..<80, 0xb0..<0x100, 82) as Hexadecimal₁₆₄ == "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87" { INFO@mark `HKDF4 the OKM of RFC 5869's test case 2 is not b11e398d…` }
unless kdf.extracted([], [0x0b] * 22) as Hexadecimal₆₄ == "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04" { INFO@mark `HKDF5 the PRK of RFC 5869's test case 3 is not 19ef24a3…` }

// Test cases 4 to 7 over SHA-1; test case 7 gives no salt, which is HashLen zeros (https://www.rfc-editor.org/rfc/rfc5869#appendix-A.4 to #appendix-A.7)
kdf1 := HKDF(SHA1)
unless kdf1.extracted(0..<13, [0x0b] * 11) as Hexadecimal₄₀ == "9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243" { INFO@mark `HKDF6 the PRK of RFC 5869's test case 4 is not 9b6c18c4…` }
unless kdf1.derived(0..<13, [0x0b] * 11, 0xf0..<0xfa, 42) as Hexadecimal₈₄ == "085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896" { INFO@mark `HKDF7 the OKM of RFC 5869's test case 4 is not 085a01ea…` }
unless kdf1.extracted(0x60..<0xb0, 0..<80) as Hexadecimal₄₀ == "8adae09a2a307059478d309b26c4115a224cfaf6" { INFO@mark `HKDF8 the PRK of RFC 5869's test case 5 is not 8adae09a…` }
unless kdf1.derived(0x60..<0xb0, 0..<80, 0xb0..<0x100, 82) as Hexadecimal₁₆₄ == "0bd770a74d1160f7c9f12cd5912a06ebff6adcae899d92191fe4305673ba2ffe8fa3f1a4e5ad79f3f334b3b202b2173c486ea37ce3d397ed034c7f9dfeb15c5e927336d0441f4c4300e2cff0d0900b52d3b4" { INFO@mark `HKDF9 the OKM of RFC 5869's test case 5 is not 0bd770a7…` }
unless kdf1.extracted([], [0x0b] * 22) as Hexadecimal₄₀ == "da8c8a73c7fa77288ec6f5e7c297786aa0d32d01" { INFO@mark `HKDF10 the PRK of RFC 5869's test case 6 is not da8c8a73…` }
unless kdf1.derived([], [0x0b] * 22, [], 42) as Hexadecimal₈₄ == "0ac1af7002b3d761d1e55298da9d0506b9ae52057220a306e07b6b87e8df21d0ea00033de03984d34918" { INFO@mark `HKDF11 the OKM of RFC 5869's test case 6 is not 0ac1af70…` }
unless kdf1.extracted([], [0x0c] * 22) as Hexadecimal₄₀ == "2adccada18779e7c2077ad2eb19d3f3e731385dd" { INFO@mark `HKDF12 the PRK of RFC 5869's test case 7 is not 2adccada…` }
unless kdf1.derived([], [0x0c] * 22, [], 42) as Hexadecimal₈₄ == "2c91117204d745f3500d636a62f64f0ab3bae548aa53d423b0d1f27ebba6f5e5673a081d70cce7acfc48" { INFO@mark `HKDF13 the OKM of RFC 5869's test case 7 is not 2c911172…` }
