Location &+= {
  normalised => segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  sandboxed => "instance/" + normalised
  content => (external io sandboxed None) as String
  bytes => content.bytes
}

IO := class {
  read (location) => (location as Location).content
  write (location, content) => external io (location as Location).sandboxed content
  output (text: String) => external io `/dev/stdout` text
  host (location) => Run.current.ask(`size`, location) -- (. == true ? (external io location None) as String : .)
  field (name: String) => (name + (".ray" | "/" | ""))#.map(read(.)).first(.nonempty) ?? ""
  listing (location) => host(location).lines{.nonempty}.map((location as Location) / .)
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => (external random) ? 1 : 0
  bits (count: Number) => count.times.map(bit)
  number (width: Number) => Binary(integer: bits(width).map(Binary.digit))
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }

  static Seeded := class = state: Number {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    number (width: Number) => Binary(integer: width.times.map(bit).map(Binary.digit))
  }
}

choose {type} ^keyword => @me.choose(type)
Choice := class = type: *?, value: *?

Proof := class = proposition: *, argument: * {
  static Proposition := class = holds: boolean = true, fact: *?, verified = false {
    negated => Proposition(holds: !holds, fact)
    quest => Quest(name: "verify the assumption", goal: fact)
    verify (actual) => verified = actual == fact
    rolled_back => !verified
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : Quest(name: "prove", goal: proposition)
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
  static failed (error) => Quest(name: "fix", goal: error)
}

! `+` `-`
! `*` `/`

Transaction := class = forwards: *?, backwards: *? = forwards⁻¹, history: History = History(), applied = false {
  branch: History = history.fork

  record (who, change): static => this ~~ branch.commit(who, change)
  commit: static => this ~~ history.merge(branch) ~~ (.applied = true)
  abort: static => this ~~ branch.drop
  reversed => Transaction(forwards: backwards, backwards: forwards, history, applied)
}

Network := class {
  static fetch (from: Location, path: String, version: Version?) => (IO.read(from / path + (version as String)) if version) ?? IO.read(from / path)
}

OS := class {
  [property: String] => (external os property) as String
  platform => this["platform"]
  architecture => this["architecture"]
  name: linux | macos | windows | ether | unknown => { "linux": linux, "darwin": macos, "win32": windows }[platform] ?? unknown

  static launch (location: Location) => external os `open` (location as String)
}

Device := class {
  static Capability := enum storage | network | notifications | fullscreen | clipboard | share | vibration | wake_lock | camera | microphone | geolocation | print | speech

  os: OS = OS()
  keyboard: Keyboard = Keyboard()
  capabilities: Capability?
  handheld = false
  clipboard: String | Location = ""
  pads: (buttons: boolean[], axes: Number[])?
  orientation: Geometry.Vector?
  motion: Geometry.Vector?
  geolocation: (latitude: Number, longitude: Number, accuracy: Geometry.Length)?
  preferences: (reduced_motion: boolean, dark: boolean, contrast: more | less | normal, focused: boolean) = (false, false, normal, true)
  notification: (title: String, body: String)?
  fullscreen = false
  printing = false
  opened: Location?

  choose (s) => s#.random
}

Keyboard := class: Location {
  static Modifier := enum shift | control | alt | meta

  static Key := class: Nameable = code: Number?, modifiers: Modifier? {
    pressed = false

    presses => pressed.history{.value == true}.count
    toggled => presses.odd
    pulsed (max: Number = 0, delay: Quantity.Temporal = 500 ms) => pressed && (max == 0 || presses <= max)
      && (presses == 1 || Time.now - pressed.history{.value == true}.last.when >= delay)

    press (modifiers: Modifier? = None): static => this ~~ (.modifiers = modifiers) ~~ (.pressed = true)
    release: static => this ~~ .pressed = false
    cycle (iterable) => iterable[presses % iterable.count]
  }

  keys => children{is Key}
  [name] => keys{.name == name}.first ?? add(Key(name))
  coded (code: Number) => keys{.code == code}.first ?? add(Key(name: code as Char as String, code))
  pressed (name, modifier: Modifier? = None) => this[name] -- (key => key.pressed && (!modifier || modifier#.some(key.modifiers ∋ .)))
  .{literal name ^property} ^punctuation => .declaring(name) ? external get this name : this[name]
}

Chat := class {
  message: String?

  messages => message.history
  say (who, text: String): static => this ~~ message.history.commit(who, text)
  count => messages.count
}
