    }
    0
  }
  static led_matched (p, n, m) => {
    r := matched(p, n, 0)
    boundn = m
    r
  }
  static memo_read (ctx, n, h) => ((word_of(h) == n) && (word_of(h + 4) == ctx) && (word_of(h + 8) == textend) && (word_of(h + 12) == epoch)) ? word_of((memo + 1048576) + ((h - memo) / 4)) : Matching.memo_noted(ctx, n, h, text_led_read(ctx, n))
  static memo_noted (ctx, n, h, r) => {
