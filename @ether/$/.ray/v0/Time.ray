Calendar := class {
  Segment := class {
    name: Node
    length: Node
    epoch: 1
    is_recurring => .period
  }

  parts: (chain None)
  segments => .parts

  equivalent (here: Time, there: Time) => (
    from := here
    to := there
    Calendar.Equivalence(from: from, to: to)
  )
  Equivalence := class {
    convert (time: Time) => (

      elapsed := time - .from
      Time(calendar: .to.calendar, since_epoch: (.to.since_epoch + elapsed), epoch: .to.epoch)
    )
  }
}

Weekday := enum monday | tuesday | wednesday | thursday | friday | saturday | sunday
Month := enum january (length: 31, place: 1) | february (length: 28, place: 2) | march (length: 31, place: 3) | april (length: 30, place: 4) | may (length: 31, place: 5) | june (length: 30, place: 6) | july (length: 31, place: 7) | august (length: 31, place: 8) | september (length: 30, place: 9) | october (length: 31, place: 10) | november (length: 30, place: 11) | december (length: 31, place: 12) {

  days_in (year: Number, calendar) => (
    month_days := .length
    if ((.place == 2).and(calendar.is_leap_year(year))) { month_days = .length.succ }
    month_days
  )
}

Julian := class {
  is_leap_year (year: Number) => (year % 4).is_zero
  days_in_year (year: Number) => if (.is_leap_year(year)) { 366 } else { 365 }
  days_in_month (month, year: Number) => month.days_in(year, this)
  weeks_in_year (year: Number) => .days_in_year(year) / 7
  hours_in_day => 24
  minutes_in_hour => 60
  seconds_in_minute => 60
  months => Month.components
  weekdays => Weekday.components

  day_of_year (month, day: Number, year: Number) => (
    calendar := this
    total ^keyword := day
    Month.components for {
      if (it.value.place < month.place) { total = total + it.value.days_in(year, calendar) }
    }
    total
  )
  chainable == (other) => this === other
}
Gregorian := class: Julian {

  is_leap_year (year: Number) => if ((year % 100).is_zero) { (year % 400).is_zero } else { (year % 4).is_zero }
}

UTC := class: Gregorian {

  offset: 0
  with_offset (offset: Quantity) => UTC(offset: offset)
  leap_seconds => false
}
GMT := UTC

Month.components.hierarchy &= class {
  index => .place.pred
  chainable == (other) => .place == other.place
  chainable != (other) => (this == other).not
}

Time := class {
  calendar: Node
  since_epoch: Quantity
  epoch?: Time

  since_calendar_epoch => (
    held ^keyword := .since_epoch
    if (.epoch) { held = .since_epoch + .epoch.since_calendar_epoch }

    held
  )
  chainable == (other: Time) => .since_calendar_epoch == other.since_calendar_epoch
  chainable < (other: Time) => .since_calendar_epoch < other.since_calendar_epoch
  compounds + (duration: Quantity) => Time(calendar: .calendar, since_epoch: .since_epoch + duration, epoch: .epoch)
  compounds - (other: Time) => .since_calendar_epoch - other.since_calendar_epoch
  as (counted_by) => Time(calendar: counted_by, since_epoch: .since_epoch, epoch: .epoch)
  round (measure: Unit) => (
    held ^keyword := .since_epoch
    step ^keyword := ((1 of measure) as held.unit).amount
    if step.is_zero {
      held = held as measure
      step = 1
    }
    rest ^keyword := held.amount % step
    kept ^keyword := held.amount - rest
    unless ((rest + rest) < step) { kept = kept + step }
    Time(calendar: .calendar, since_epoch: Quantity(amount: kept, unit: held.unit), epoch: .epoch)
  )

  now => Time.Clock(digits: (external time).as_string)
  Clock := class {

    nanoseconds => .digits.slice(.digits.count - 9, .digits.count)
    nanoseconds_tail => .digits.slice(.digits.count - 3, .digits.count).as_number of Nanosecond
    seconds_tail => .digits.slice(.digits.count - 12, .digits.count - 9).as_number of Second
  }
}

ISO_8601 := class {
  date (text: String) => (
    parts := text.split(U+002D)
    year := parts.head.value.as_number
    month := Month.at_index(parts.head.next.value.as_number.pred)
    day := parts.head.next.next.value.as_number
    ISO_8601.Date(year: year, month: month, day: day)
  )
  time (text: String) => (
    parts := text.split(U+003A)
    hour := parts.head.value.as_number
    minute := parts.head.next.value.as_number
    second := if (parts.head.next.next) { parts.head.next.next.value.as_number } else { 0 }

    ((((hour * 60) + minute) * 60) + second) of Second
  )
  Date := class {
    is_valid (calendar) => (0 < .day).and((.month.days_in(.year, calendar) < .day).not)
    day_of_year (calendar) => calendar.day_of_year(.month, .day, .year)
    chainable == (other) => (.year == other.year).and(.month == other.month).and(.day == other.day)
  }
}
Month.components.hierarchy &= class {
  at_index (index: Number) => (
    wanted := index.succ
    found ^keyword := None
    Month.components for {
      if (it.value.place == wanted) { found = it.value }
    }
    found
  )
}

Planet := class { }
Earth := class: Planet {
  years => Year
  days => Day
  calendar => Gregorian
}
Sol => Second multiple 88775
MartianYear => Sol multiple 668
Mars := class: Planet {
  years => MartianYear
  days => Sol
}
