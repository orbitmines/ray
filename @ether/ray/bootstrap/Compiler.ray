    lr_members.for((m) => (Lowered.kind(m) == `static_of`) ? Lowered.declared(Compiled.trimmed(Lowered.parsed(m).static_of)) : None)
    lr_members.for((m) => (Lowered.kind(m) == `static_of`) ? Lowered.named_function(Compiled.trimmed(Lowered.parsed(m).static_of)) : None)
