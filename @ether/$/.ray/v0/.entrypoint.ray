{pattern} => {body} => external rule pattern body
//{comment?} => None
;{statement} => statement
({expr}) => expr
{{expr}} => external ** expr
{name} := {value} => external declare name value
literal := external literal
^ := external ^
{target} ^{literal style}{ } => ^(style)(target)
^{literal style}{ } => ^(style)
global ^keyword := external global
unordered ^keyword := external unordered
inline ^keyword := external inline
literal ^keyword := external literal
theme ^keyword := external theme
report ^keyword := external report
forward := external forward
None := external none

^{ }{literal color ^ color} => ^(color)
{pattern} ^{literal style} => {body} => ^(style)(external rule pattern body)
`{literal string ^string}` ^string.punctuation => string
\n => `
`
//{comment?} ^comment => None
/*{comment?}*/ ^comment => None

[{expr}] ^punctuation => (
  listed := chain None
  external extend listed Listed
  listed &= expr
  listed
)

goto {literal target ^label} ^class => external goto target global
goto {literal target ^label} if {condition} ^class => external goto target condition
{literal label ^label}\ ^punctuation => external label label

return {value} ^keyword => (
  value
  goto return\
)

chain {holder} ^keyword => (
  links ^keyword := external .
  instance := global
  owner := holder
  head := None
  tail := None
  external extend links Chain
  links
)

link {value} {previous} ^keyword => (
  entry ^keyword := external .
  instance := global
  next := None
  external extend entry Link
  entry
)

class {block} => (
  static := external .
  static.instance = None
  static.components = chain None
  static.components.hierarchy = chain static
  static.written_body = external ** block
  static.classes_read = None
  static.requirements_read = None
  static.requirements_known = None
  static.heads_read = None
  static.heads_known = None
  written_as => static.written_body**
  super => (
    parent := static.components.hierarchy.tail.value
    instance := this
    view := external .
    external extend view parent
    external extend view instance
    view
  )
  inline block

  ({args}) => (
    static := this
    inline args
    this := external .
    this.components = chain None
    this.components.hierarchy = chain this
    this.components.hierarchy &= static
    this.instance = global
    inline block
    if static.is_abstract { ERROR@this `constructs a class that leaves a method unwritten` }
    this
  )

  static
)

base class {body} => (
  static := external .
  static.instance = None
  static.components = chain None
  static.components.hierarchy = chain static
  static.written_body = external ** body
  static.requirements_read = chain None
  static.requirements_known = global
  written_as => static.written_body**
  inline body
  external base static {
    external declare this external .
  }
  static
)

if ^keyword := class {
  { }{cond}{ }{yes} ^class => (
    branch ^keyword := external .
    inline static
    taken := None
    answer := None

    goto enter if (cond as boolean).holds
    goto skip
   enter\
    taken = global
    result := None
    external declare result (inline (external ** yes))
    answer = result
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )

  elsif{ }{cond}{ }{block} ^class => (
    branch ^keyword := external .
    inline this
    taken := .taken
    answer := .answer

    goto skip if taken
    goto enter if (cond as boolean).holds
    goto skip
   enter\
    taken = global
    result := None
    external declare result (inline (external ** block))
    answer = result
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )

  {\n}elsif{ }{cond}{ }{block} ^class => this elsif cond block
  {\n}else{ }{block} ^class => this else block

  else{ }{block} ^class => (
    chosen ^keyword := .answer
    goto done if .taken
    chosen = inline (external ** block)
   done\

    chosen
  )

  as (=== boolean) => (.answer as boolean)
}

unless{ }{cond}{ }{block} ^class => (
  branch ^keyword := external .
  inline if
  taken := None
  answer := None

  goto skip if (cond as boolean).holds
  taken = global
  result := None
  external declare result (inline (external ** block))
  answer = result
  goto composes if (external own result)
  goto skip
 composes\
  external extend branch result
 skip\

  branch ^variable
)

while ^keyword := class {
  { }{cond}{ }{block} ^class => (
    looping ^keyword := external .
    inline static
    written_block := external ** block

   again\
    goto more if (cond as boolean).holds
    goto done
   more\
    inline written_block
    goto again
   done\

    looping ^variable
  )

  { }{block}{ }while{ }{cond} ^class => (
    written_block := external ** block
    inline written_block

    this cond block
  )
}

do{ }{block}{ }while{ }{cond} ^class => (
  first_round := external ** block
  inline first_round
  while cond block
)

loop{ }{block} ^class => while true block

Program := class {
  ({arguments}) => (
    goto run if (.parameters.not)
    names := .parameters
    (inline names) := arguments
   run\
    body := .code
    inline body
  )

  { }{expr} => this(expr)
}

Modifier := class {
  kind => TODO
  modify (definition) => (
    definition.components = chain None
    definition.components.hierarchy = chain None
    definition.components.hierarchy &= this
    definition
  )
}
chainable ^keyword := class: Modifier {
  chains => TODO
}
compounds ^keyword := class: Modifier {
  compounds => TODO
}
right-to-left ^keyword := class: Modifier {
  reads_right_to_left => TODO
}
left-to-right ^keyword := class: Modifier {
  reads_left_to_right => TODO
}
chainable {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined ^keyword := external define head `{arguments}` {
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  chainable.modify(defined)
)
compounds {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined ^keyword := external define head `{arguments}` {
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  compounds.modify(defined)
)
right-to-left {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined ^keyword := external define head `{arguments}` {
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  right-to-left.modify(defined)
)
left-to-right {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined ^keyword := external define head `{arguments}` {
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  left-to-right.modify(defined)
)
Modifier.spellings = chain None
Modifier.spellings &= `chainable`
Modifier.spellings &= `compounds`
Modifier.spellings &= `right-to-left`
Modifier.spellings &= `left-to-right`

Node := base class {

  , => this

  ;{x} ^punctuation => x
  listing => None

  ({parameters ^parameter}) => {block} => (
    method_parameters := external ** parameters
    method_written := external ** block
    this ^function
    external define this `{arguments}` {
      (inline method_parameters) := arguments
      inline method_written
    } parameters
  )
  ^{literal style} ({parameters ^parameter}) => {block} => (
    method_parameters := external ** parameters
    method_written := external ** block
    this ^function
    external define this `{arguments}` {
      (inline method_parameters) := arguments
      inline method_written
    } parameters
  )

  ,{other} ^punctuation => (
    listed := chain None
    external extend listed Listed
    listed &= this
    listed &= other
    listed
  )
  --{call} ^punctuation => call(this)
  
  ={x} ^punctuation => (
    external assign this x

    this
  )
  :={x} ^punctuation => (
    goto existing if external own this
    external declare this x
    goto declared
   existing\
    goto both if x.head
    goto plain
   both\
    goto destructure if this.head
   plain\
    external declare this x
    goto declared
   destructure\
    external declare name this.head
    external declare value x.head
   next\
    goto declared if (name.not)
    external declare name.value value.value
    name = name.next
    value = value.next
    goto next
   declared\
    this
  )
  :{type} ^punctuation => (
    if (external own this) {
      unless type.instance {
        if this {
          if this.instance { type.verify(this) }
          elsif this.written_body { unless ((this === type).or(this.subtype_of(type))) { ERROR@this `is not of the type it is declared as` } }
          elsif (this.instance_of(type)) {
            if type.repeating { external assign this this.instance_of(type) }
            type.verify(this)
          }
          else { ERROR@this `is not of the type it is declared as` }
        }
      }
    } elsif (None.instance_of(type)) { external declare this None }
    else {
      external declare this type
      if type.written_body { external declare this this }
    }

    this
  )

  ??{other} ^punctuation => (
    chosen := this
    if (chosen === None) { chosen = other }
    chosen
  )
  ? => None | this
  ?:{type} ^punctuation => this: (type?)

  instance_of (type) => (
    found ^keyword := None
    among ^keyword := None
    if this.codepoint { among = type.superposes }
    if this {
      if type.repeating { found = read_whole(this, type) }
      elsif type.listing { found = read_whole(this, type) }
      elsif among {
        alternative ^keyword := type.components.head
        while alternative {
          if alternative.value.superposes { if (this.instance_of(alternative.value)) { found = alternative } }
          elsif (same_text(this, alternative.value)) { found = alternative }
          if found { alternative = None } else { alternative = alternative.next }
        }
      } else {
        found = .structurally(type)
        unless found {
          if type.components {
            other ^keyword := type.components.head
            while other {
              found = .structurally(other.value)
              if found { other = None } else { other = other.next }
            }
          }
        }
        if found { found = type.admits(this) }
      }
    } else {
      unless type.instance {
        if type.components {
          walker ^keyword := type.components.head
          while walker {
            if (walker.value === None) { found = global }
            if found { walker = None } else { walker = walker.next }
          }
        }
      }
    }

    found
  )

  classes => (
    unless ((external own this.classes_read).and(this.classes_read)) {
      this.classes_read = chain None
      reached ^keyword := chain None
      reached &= this
      parent ^keyword := this.components.hierarchy.head
      while parent {
        unless (parent.value === None) {
          inherited ^keyword := parent.value.classes.head
          while inherited {
            reached &= inherited.value
            inherited = inherited.next
          }
        }
        parent = parent.next
      }
      this.classes_read = reached
    }
    this.classes_read
  )
  heads_written => (
    unless this.heads_known {
      read ^keyword := chain None
      if this.written_body {
        left ^keyword := this.written_body
        one ^keyword := external first left
        while one {
          read &= head_of(one)
          left = external rest left
          one = external first left
        }
      }
      this.heads_read = read
      this.heads_known = global
    }
    this.heads_read
  )
  requirements => (
    unless this.requirements_known {
      wanted ^keyword := chain None
      held ^keyword := this.classes.head
      while held {
        head ^keyword := held.value.heads_written.head
        while head {
          if head.value.is_required { wanted &= head.value.spelled }
          head = head.next
        }
        held = held.next
      }
      this.requirements_read = wanted
      this.requirements_known = global
    }
    this.requirements_read
  )
  declaring (wanted_head) => (
    found ^keyword := None
    held ^keyword := this.classes.head
    while ((held).and((found).not)) {
      head ^keyword := held.value.heads_written.head
      while ((head).and((found).not)) {
        if head.value.is_declared { if (head.value.spelled === wanted_head) { found = global } }
        head = head.next
      }
      held = held.next
    }
    found
  )
  structurally (type) => (
    made_by ^keyword := None
    held ^keyword := this.classes.head
    while ((held).and((made_by).not)) {
      if (held.value === type) { made_by = global }
      held = held.next
    }
    holding ^keyword := global
    wanted ^keyword := None
    unless made_by { wanted = type.requirements.head }
    while ((wanted).and(holding)) {
      unless (this.declaring(wanted.value)) { holding = None }
      wanted = wanted.next
    }
    holding
  )

  compounds + (component) => (
    external extend this component
    this
  )
  {this}$ ^punctuation => Store.of(this)

  compounds - (component) => (
    remaining ^keyword := chain this
    walker ^keyword := this.components.hierarchy.head
    while walker {
      unless (walker.value === component) { remaining &= walker.value }
      walker = walker.next
    }
    this.components.hierarchy = remaining
    this.classes_read = None
    this
  )

  subtype_of (other) => (
    found ^keyword := None
    held ^keyword := this.classes.head
    while ((held).and((found).not)) {
      if (held.value === other) { found = global }
      held = held.next
    }
    found
  )
  supertype_of (other) => other.subtype_of(this)

  is_abstract => (
    missing ^keyword := None
    head ^keyword := this.heads_written.head
    while ((head).and((missing).not)) {
      if head.value.is_required { missing = global }
      head = head.next
    }
    missing
  )

  fields => (
    found ^keyword := chain None
    holder ^keyword := this
    colon ^keyword := code_points(`x:y`).head.next.value
    held ^keyword := this.classes.head
    while held {
      if held.value.written_body {
        statements ^keyword := Program(code: held.value.written_body).written
        statements for {
          read ^keyword := it.value.head_read
          if (read.ending) {
            if (read.ending == colon) {
              named ^keyword := read.points.map { it.value.as_character }.as(String)
              found &= Field(name: named, value: (external get holder named))
            }
          }
        }
      }
      held = held.next
    }
    found
  )

  canonical => (
    normal ^keyword := this
    if (this.normalizer) { normal = this.normalizer(this) }
    normal
  )
  as (=== boolean) => true

  === (other) => (
    answer ^keyword := None
    goto marking if this
    goto done if other
    answer = global
    goto done
   marking\
    marker ^keyword := external .
    marker.probe = global
    this.identical = marker
    goto owned if (external own other.identical)
    goto cleared
   owned\
    answer = other.identical.probe
   cleared\
    marker.probe = None
   done\

    answer
  )

  not => (
    answer ^keyword := global
    goto held if this
    goto done
   held\
    answer = None
   done\

    answer
  )
  and (b) => (
    answer ^keyword := b
    goto done if this
    answer = this
   done\

    answer
  )
  or (b) => (
    answer ^keyword := this
    goto done if this
    answer = b
   done\

    answer
  )
  nand (b) => .and(b).not
  xor (b) => .or(b).and(.nand(b))
  xnor (b) => .xor(b).not

  structure => None

  satisfies (predicate) => (
    holding ^keyword := chain None
    holding.target = this
    external define holding.target `constrained` {
      inline predicate
    } None
    holding.target.constrained
  )

  verify (candidate) => candidate

  admits (candidate) => global

  {this}{{literal narrowing}} ^punctuation => (
    narrowed ^keyword := this
    closure ^keyword := { inline narrowing }
    selected ^keyword := None
    if (narrowed.instance) {
      selected = chain None
      narrowed for {
        held := it.value
        if (held.satisfies(closure)) { selected &= held }
      }
    } else {
      selected = class: narrowed {
        constraint := closure
        narrows := narrowed

        verify (candidate) => (
          this.narrows.verify(candidate)
          unless (candidate.satisfies(this.constraint)) { ERROR@candidate `does not satisfy a constraint of its type` }

          candidate
        )
        admits (candidate) => if (this.narrows.admits(candidate)) { candidate.satisfies(this.constraint) } else { None }
        chosen_within (width) => (
          picked ^keyword := this.narrows.chosen_within(width)
          if (picked.satisfies(this.constraint)) { picked } else { .chosen_within(width.succ) }
        )
        () ^punctuation => .chosen_within(1)
        if (this.instance) { selected.verify(this) }
      }
    }

    selected
  )

  {this}<{literal partial}> ^punctuation => (
    narrowed ^keyword := this

    class: narrowed { inline partial }
  )

  ~~{x} ^punctuation => (
    closure ^keyword := external ** x
    entering ^keyword := chain None
    entering.target = this
    external define entering.target `closure_entered` {
      inline closure
    } None
    entering.target.closure_entered

    this
  )

  ** => Program(code: (external ** this))

  &={x} ^punctuation => (
    previous := this.tail
    adding := x
    added := link adding previous
    goto more if previous
    this.head = added
    goto linked
   more\
    previous.next = added
   linked\
    this.tail = added
    goto owned if this.owner
    goto done
   owned\
    holder := this.owner
    external extend holder x
   done\

    this
  )

  |{other} ^punctuation => (
    superposed ^keyword := external .
    external extend superposed this
    superposed.instance = None
    superposed.superposes = global
    superposed.components = chain None
    goto superpose_each if this.components.head
    superposed.components &= this
    goto superpose_other
   superpose_each\
    alternative ^keyword := this.components.head
   superpose_step\
    goto superpose_copy if alternative
    goto superpose_other
   superpose_copy\
    superposed.components &= alternative.value
    alternative = alternative.next
    goto superpose_step
   superpose_other\
    superposed.components &= other

    superposed
  )

  . => this
  .{literal property ^property} ^punctuation => external get this property

  [{property}] ^punctuation => external get this property
  [] => (
    item ^keyword := this
    repeated ^keyword := class: Array { }
    repeated.repeats = item
    repeated.repeating = global
    repeated
  )

 
}

Node.DEFINE_METHOD = `&=`

external extend None {
  as (=== boolean) => false
  == (other) => other === None
  != (other) => (other === None).not
}

class:{ }{header}{`{`}{members?}{`}`} ^keyword => (
  made ^keyword := class { inline members }
  made.written_body = external ** members
  made.components.hierarchy &= header
  made
)

Chain := class {
  entry => .head
}

Listed := class {
  listing => global
  , ^punctuation (other) => (
    joined ^keyword := chain None
    external extend joined Listed
    walker ^keyword := .head
    while (walker) {
      joined &= walker.value
      walker = walker.next
    }
    joined &= other
    joined
  )
}
Link := class { }

Reading := class {
  rest: Node
  value: Node
}
Field := class {
  name: Node
  value: Node
}
Call := class {
  statement: Node
  is_external => .statement.written_with(`external`)
  external_name => (
    named ^keyword := chain None
    space ^keyword := code_points(`x y`).head.next.value
    skipped ^keyword := 9
    ended ^keyword := false
    code_points(.statement.code) for {
      if skipped.nonzero { skipped = skipped.pred } elsif ended.not {
        if (it.value == space) { ended = true } else { named &= it.value }
      }
    }
    named.map { it.value.as_character }.as(String)
  )
  ** => .statement
}
Chosen := class {
  among: Node
  value: Node
  previous => .among.previous
  next => .among.next
}
text_bits (text) => (
  held ^keyword := chain None
  take (bit) => (
    held &= bit
    global
  )
  external bits text take
  held
)
prefix_of (at, spelling) => (
  prefix ^keyword := None
  matching ^keyword := global
  compare (bit) => (
    unless at { matching = None }
    if matching {
      unless (bit === at.value) { matching = None }
      at = at.next
    }
    matching
  )
  external bits spelling compare
  if matching { prefix = Reading(rest: at, value: spelling) }
  prefix
)
same_text (first_text, second_text) => (
  same ^keyword := false
  if ((first_text).and(second_text)) {
    matched ^keyword := prefix_of(text_bits(first_text).head, second_text)
    if matched { unless matched.rest { same = true } }
  }
  same
)
outnumbers (first_reading, other) => (
  mine ^keyword := chain None
  theirs ^keyword := chain None
  if first_reading.head { mine = first_reading } else { mine &= first_reading }
  if other.head { theirs = other } else { theirs &= other }
  a ^keyword := mine.head
  b ^keyword := theirs.head
  while ((a).and(b)) {
    a = a.next
    b = b.next
  }
  a
)
read_whole (text, type) => (
  whole ^keyword := None
  if type.repeating {
    tree ^keyword := None
    if type.repeats.superposes { tree = spelled_tree_of(type.repeats) }
    if (tree) {
      ends ^keyword := spelled_ends(text, tree)
      if (ends) {
        if type.repeats.spelled_unique { whole = spelled_reading(ends) } else { whole = read_repeated(text_bits(text).head, type.repeats) }
      }
    } else { whole = read_repeated(text_bits(text).head, type.repeats) }
  } else {
    candidate ^keyword := readings_of(text_bits(text).head, type).head
    while candidate {
      reading ^keyword := candidate.value
      unless reading.rest {
        if whole {
          if (outnumbers(reading.value, whole)) { whole = reading.value }
        } else { whole = reading.value }
      }
      candidate = candidate.next
    }
  }
  whole
)
spelled_node ^keyword => (
  node ^keyword := external .
  ends := None
  path := None
  zero := None
  one := None
  node
)
spelled_tree_of (type) => (
  unless type.spelled_tree_known {
    type.spelled_tree = None
    type.spelled_unique = global
    root ^keyword := spelled_node
    plain ^keyword := global
    insert (kind, path) => (
      at ^keyword := root
      bit ^keyword := text_bits(kind).head
      while bit {
        if at.ends { type.spelled_unique = None }
        if bit.value {
          unless at.one { at.one = spelled_node }
          at = at.one
        } else {
          unless at.zero { at.zero = spelled_node }
          at = at.zero
        }
        bit = bit.next
      }
      unless (at === root) {
        if at.ends { type.spelled_unique = None }
        if at.zero { type.spelled_unique = None }
        if at.one { type.spelled_unique = None }
        at.ends = global
        at.path = path
      }
    )
    gather (kind, path) => (
      if kind.superposes {
        alternative ^keyword := kind.components.head
        while alternative {
          deeper ^keyword := chain None
          step ^keyword := path.head
          while step {
            deeper &= step.value
            step = step.next
          }
          deeper &= alternative
          gather(alternative.value, deeper)
          alternative = alternative.next
        }
      } elsif kind.repeating { plain = None }
      elsif kind.listing { plain = None }
      elsif kind.capturing { plain = None }
      elsif kind.written_body { plain = None }
      else { insert(kind, path) }
    )
    gather(type, chain None)
    if plain { type.spelled_tree = root }
    type.spelled_tree_known = global
  }
  type.spelled_tree
)
head_stops ^keyword := ` ` | `(` | `:` | `?`
not_word_starts ^keyword := `{` | `[` | `^` | `@`
heads_root ^keyword => (
  unless global.heads_trie { global.heads_trie = spelled_node }
  global.heads_trie
)
bits_onto (held, text) => (
  part ^keyword := text_bits(text).head
  while part {
    held &= part.value
    part = part.next
  }
  held
)
todo_held ^keyword := chain None
todo_bits ^keyword => (
  unless todo_held.head { bits_onto(bits_onto(bits_onto(todo_held, `=`), `>`), ` TODO`) }
  todo_held
)
byte_steps ^keyword := chain None
byte_steps &= global
byte_steps &= global
byte_steps &= global
byte_steps &= global
byte_steps &= global
byte_steps &= global
byte_steps &= global
byte_steps &= global
written_head ^keyword => (
  node ^keyword := external .
  spelled := None
  stop := None
  is_required := None
  is_declared := None
  node
)
head_of (statement) => (
  read ^keyword := written_head
  stops ^keyword := spelled_tree_of(head_stops)
  starts ^keyword := spelled_tree_of(not_word_starts)
  head_at ^keyword := heads_root
  byte_from ^keyword := heads_root
  stop_at ^keyword := stops
  start_at ^keyword := starts
  first_bit ^keyword := None
  second_bit ^keyword := None
  bits_seen ^keyword := None
  second_seen ^keyword := None
  word_start ^keyword := None
  first_done ^keyword := None
  step_at ^keyword := byte_steps.head
  todo_at ^keyword := None
  reading ^keyword := global
  take (bit) => (
    going := global
    if reading {
      if bit {
        unless head_at.one { head_at.one = spelled_node }
        head_at = head_at.one
        if stop_at { stop_at = stop_at.one }
        if start_at { start_at = start_at.one }
      } else {
        unless head_at.zero { head_at.zero = spelled_node }
        head_at = head_at.zero
        if stop_at { stop_at = stop_at.zero }
        if start_at { start_at = start_at.zero }
      }
      unless first_done {
        if bits_seen {
          unless second_seen {
            second_bit = bit
            second_seen = global
          }
        } else {
          first_bit = bit
          bits_seen = global
        }
      }
      step_at = step_at.next
      unless step_at {
        if stop_at { if stop_at.ends { read.stop = stop_at.path.head.value } }
        if read.stop {
          reading = None
          if (read.stop === head_stops.components.head) { todo_at = todo_bits.head } else { going = None }
        } else {
          unless first_done {
            first_done = global
            if first_bit { word_start = global } elsif second_bit { word_start = global }
            if start_at { if start_at.ends { word_start = None } }
            start_at = None
            unless word_start {
              reading = None
              going = None
            }
          }
          byte_from = head_at
          stop_at = stops
          step_at = byte_steps.head
        }
      }
    } else {
      if (bit === todo_at.value) { todo_at = todo_at.next } else { going = None }
      unless todo_at {
        read.is_required = global
        going = None
      }
    }
    going
  )
  external bits statement take
  read.spelled = byte_from
  if read.stop {
    unless (read.stop === head_stops.components.tail) { read.is_declared = global }
    if (read.stop === head_stops.components.head.next.next) { if word_start { read.is_required = global } }
  }
  read
)
spelled_ends (text, root) => (
  active ^keyword := chain None
  active &= root
  ended ^keyword := chain None
  completed ^keyword := None
  step (bit) => (
    reached ^keyword := chain None
    done ^keyword := None
    at ^keyword := active.head
    while at {
      next_node ^keyword := None
      if bit { next_node = at.value.one } else { next_node = at.value.zero }
      if next_node {
        reached &= next_node
        if next_node.ends {
          done = global
          ended &= next_node
        }
      }
      at = at.next
    }
    if done { reached &= root }
    completed = done
    active = reached
    reached.head
  )
  external bits text step
  unless active.head { completed = None }
  unless completed { ended = None }
  ended
)
spelled_reading (ends) => (
  whole ^keyword := chain None
  ended ^keyword := ends.head
  while ended {
    step ^keyword := ended.value.path.tail
    chosen ^keyword := step.value.value
    while step {
      chosen = Chosen(among: step.value, value: chosen)
      step = step.previous
    }
    whole &= chosen
    ended = ended.next
  }
  whole
)
read_repeated (start, element) => (
  whole ^keyword := None
  layer ^keyword := chain None
  layer &= Reading(rest: start, value: chain None)
  while layer.head {
    reached ^keyword := chain None
    state ^keyword := layer.head
    while state {
      reading ^keyword := state.value
      steps ^keyword := readings_of(reading.rest, element).head
      while steps {
        step ^keyword := steps.value
        unless (step.rest === reading.rest) {
          seen ^keyword := None
          known ^keyword := reached.head
          while known {
            if (known.value.rest === step.rest) { seen = global }
            known = known.next
          }
          unless seen {
            more ^keyword := chain None
            part ^keyword := reading.value.head
            while part {
              more &= part.value
              part = part.next
            }
            more &= step.value
            reached &= Reading(rest: step.rest, value: more)
            unless step.rest { whole = more }
          }
        }
        steps = steps.next
      }
      state = state.next
    }
    layer = reached
  }
  whole
)
readings_of (rest, type) => (
  found ^keyword := chain None
  if type.repeating {
    firsts ^keyword := readings_of(rest, type.repeats).head
    while firsts {
      first ^keyword := firsts.value
      single ^keyword := chain None
      single &= first.value
      found &= Reading(rest: first.rest, value: single)
      unless (first.rest === rest) {
        others ^keyword := readings_of(first.rest, type).head
        while others {
          more ^keyword := chain None
          more &= first.value
          part ^keyword := others.value.value.head
          while part {
            more &= part.value
            part = part.next
          }
          found &= Reading(rest: others.value.rest, value: more)
          others = others.next
        }
      }
      firsts = firsts.next
    }
  } elsif type.listing {
    reached ^keyword := chain None
    listed_from ^keyword := rest
    reached &= Reading(rest: listed_from, value: chain None)
    item ^keyword := type.head
    while item {
      further ^keyword := chain None
      so_far_at ^keyword := reached.head
      while so_far_at {
        so_far ^keyword := so_far_at.value
        nexts ^keyword := readings_of(so_far.rest, item.value).head
        while nexts {
          parts ^keyword := chain None
          part ^keyword := so_far.value.head
          while part {
            parts &= part.value
            part = part.next
          }
          parts &= nexts.value.value
          further &= Reading(rest: nexts.value.rest, value: parts)
          nexts = nexts.next
        }
        so_far_at = so_far_at.next
      }
      reached = further
      item = item.next
    }
    found = reached
  } elsif type.superposes {
    alternative ^keyword := type.components.head
    while alternative {
      alternatives ^keyword := readings_of(rest, alternative.value).head
      while alternatives {
        found &= Reading(rest: alternatives.value.rest, value: Chosen(among: alternative, value: alternatives.value.value))
        alternatives = alternatives.next
      }
      alternative = alternative.next
    }
  } elsif type.capturing {
    captures ^keyword := readings_of(rest, type.type).head
    while captures {
      found &= Reading(rest: captures.value.rest, value: Captured(name: type.name, value: captures.value.value))
      captures = captures.next
    }
  } elsif type.written_body {
    piece ^keyword := chain None
    at ^keyword := rest
    while at {
      piece &= at.value
      at = at.next
      copied ^keyword := chain None
      bit_at ^keyword := piece.head
      while bit_at {
        copied &= bit_at.value
        bit_at = bit_at.next
      }
      if (copied.instance_of(type)) { found &= Reading(rest: at, value: copied) }
    }
  } else {
    matched ^keyword := prefix_of(rest, type)
    if matched { found &= matched }
  }
  found
)

Capture := class {
  name: Node
  type: Node
  capturing => true
}
Captured := class {
  name: Node
  value: Node
  named => true
}
capture_of (content) => (
  colon ^keyword := content.index_of(`:`)
  named ^keyword := content
  typed ^keyword := None
  if colon {
    named = content.slice(0, colon)
    typed = content.slice(colon.succ, content.count)
  }
  name ^keyword := None
  named.split(Char.space) for {
    word ^keyword := it.value
    unless ((word.empty).or(word.starts_with(`^`)).or(same_text(word, `literal`))) { name = word }
  }
  if (name.ends_with(`?`)) { name = name.slice(0, name.count.pred) }
  type ^keyword := Node
  if typed {
    written ^keyword := None
    styled ^keyword := false
    typed.split(Char.space) for {
      word ^keyword := it.value
      if (word.starts_with(`^`)) { styled = true }
      unless ((styled).or(word.empty)) { if written { written = written + ` ` + word } else { written = word } }
    }
    if written { type = inline (external ** written) }
  }
  Capture(name: name, type: type)
)
pattern_of (head) => (
  pattern ^keyword := None
  head for {
    part ^keyword := it.value
    item ^keyword := part.value
    if part.among.previous { item = capture_of(part.value.head.next.value) }
    if pattern { pattern = pattern, item } else { pattern = [item] }
  }
  pattern
)
matcher_of (pattern) => ((text, captured) => (
  read ^keyword := None
  reading ^keyword := None
  start ^keyword := text_bits(text).head
  readings_of(start, pattern) for {
    if reading {
      if (outnumbers(it.value.value, reading.value)) { reading = it.value }
    } else { reading = it.value }
  }
  if reading {
    reading.value for {
      if it.value.named { captured[it.value.name] = it.value.value }
    }
    read = chain None
    walker ^keyword := start
    until_rest ^keyword := global
    while ((walker).and(until_rest)) {
      if (walker === reading.rest) { until_rest = None } else {
        read &= walker.value
        walker = walker.next
      }
    }
  }
  read
))

{condition} ? {yes} : {no} ^punctuation => (
  chosen ^keyword := no
  if condition { chosen = yes }
  chosen
)

dynamically ^keyword (x) => (inline x)

assert ^keyword (condition) => (
  unless condition { ERROR@condition `assertion failed` }

  condition
)

enum ^keyword => (

  static := class {
    {literal member ^enumMember} ^punctuation => (
      entry := this()
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    {literal member ^enumMember}{ }{given_fields ^property} ^punctuation => (
      entry := this(
        inline given_fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember} ^punctuation => (
      entry := this()
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember}{ }{given_fields ^property} ^punctuation => (
      entry := this(
        inline given_fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )

    chainable == (candidate) => (
      same ^keyword := this === candidate
      unless same { same = same_text((external where this), (external where candidate)) }
      same
    )
    admits (candidate) => .components.contains(candidate)
  }

  static ^enum
)

enum{ }{literal member ^enumMember}{ }{given_fields? ^property}{ }{literal rest?} {`{`}{block}{`}`} ^keyword => (
  static ^keyword := external .
  inline enum
  inline block

  entry := static(
    inline given_fields
  )
  static[member] = entry ^enumMember
  static.components &= entry
  inline rest

  static ^enum
)

enum{ }{literal member ^enumMember}{ }{given_fields? ^property}{ }{literal rest?}{\n} ^keyword => (
  static ^keyword := external .
  inline enum

  entry := static(
    inline given_fields
  )
  static[member] = entry ^enumMember
  static.components &= entry
  inline rest

  static ^enum
)

Program.components.hierarchy &= class {
  optimizations => .O
  {this}{`{`}{literal setting}{`}`} ^punctuation => class: this { inline setting }

  written => (
    out := chain None
    left ^keyword := .code
    one ^keyword := external first left
    while (one) {
      out &= Program(code: one)
      left = external rest left
      one = external first left
    }
    out
  )
  entry => .written.entry
  first => .written.first
  last => .written.last
  count => .written.count
  empty => .count.is_zero
  for (body) => (
    statements ^keyword := .written
    statements for body
    this
  )

  variables => (
    names ^keyword := chain None
    statements ^keyword := .written
    statements for {
      read ^keyword := head_of(it.value.code)
      if read.is_declared { names &= read.spelled }
    }
    names
  )
  usages (name) => (
    used ^keyword := chain None
    statements ^keyword := .written
    statements for {
      if (it.value.mentions(name)) { used &= it.value }
    }
    used
  )
  mentions (name) => (
    wanted ^keyword := code_points(name)
    found ^keyword := false
    remaining ^keyword := code_points(.code)
    while ((remaining.nonempty).and(found.not)) {
      if (remaining.head.value == wanted.head.value) { found = .same_points(remaining.head, wanted) }
      remaining.pop_front
    }
    found
  )
  is_terminal => .written.empty
  calls => (
    found ^keyword := chain None
    statements ^keyword := .written
    statements for { found &= Call(statement: it.value) }
    found
  )

  compounds + (addend) => (
    augend ^keyword := .code
    {
      inline augend
      inline addend.code
    }
  )
}

LSP := {
  SemanticToken := class {
    Type := enum namespace | type | class | enum | interface | struct | typeParameter | parameter | variable | property | enumMember | event | function | method | macro | keyword | modifier | comment | string | number | regexp | operator | decorator
    Modifier := enum declaration | definition | readonly | static | deprecated | abstract | async | modification | documentation | defaultLibrary
  }
}

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^U2
  ^type = ^U2
  ^class = ^U2
  ^enum = ^U2
  ^interface = ^U2
  ^struct = ^U2
  ^event = ^U2
  ^enumMember = ^U2
  ^typeParameter = ^U0
  ^parameter = ^U0
  ^variable = ^U1
  ^property = ^U1
  ^function = ^U4
  ^method = ^U4
  ^decorator = ^U4
  ^macro = ^U2
  ^keyword = ^U3
  ^modifier = ^U3
  ^comment = ^U3
  ^string = ^D2
  ^number = ^D2
  ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment
}
inline DARK

Diagnostic := class {
  
}

FATAL{`@`}{var}{ }{comment ^comment} ^fatal => report FATAL var comment
ERROR{`@`}{var}{ }{comment ^comment} ^error => report ERROR var comment
 WARN{`@`}{var}{ }{comment ^comment} ^warn => report WARN var comment
 INFO{`@`}{var}{ }{comment ^comment} ^info => report INFO var comment
DEBUG{`@`}{var}{ }{comment ^comment} ^debug => report DEBUG var comment
TRACE{`@`}{var}{ }{comment ^comment} ^trace => report TRACE var comment

TODO{ }{comment ^comment} ^debug => DEBUG@. comment 

boolean := enum false (holds: None) | true (holds: global) {
  nand (b) => (
    goto second if .holds
    return true
   second\
    goto no if (b as boolean).holds
    return true
   no\

    return false
  )

  not => .nand(this)

  and (b) => .nand(b).not
  or (b) => .not.nand(b.not)
  nor (b) => .or(b).not
  xor (b) => .or(b).and(.nand(b))
  xnor (b) => .xor(b).not

  ! => .not

  as (=== boolean) => this

  next => .not
  previous => .not

  & (b) => .and(b)
  && (b) => .and(b)
  || (b) => .or(b)
  !&& (b) => .nand(b)
  !|| (b) => .nor(b)
  x|| (b) => .xor(b)
  x!|| (b) => .xnor(b)
}

!{x} ^punctuation => (x).not

true := boolean.true
false := boolean.false

{l} [x: right-to-left] {m} [y: left-to-right] {r} => l[x] m & m[y] r

{base} [x: right-to-left] {middle_operand} [y: right-to-left] {top} => base[x] (middle_operand[y] top)

{left} [x: left-to-right] {middle} [y: right-to-left] {right} => (
  ERROR@middle `mixes directions around one operand; use parentheses`
  None
)

{first} [x: chainable] {shared} [y: chainable] {last} => (first[x] shared) & (shared[y] last)

{a} [x: compounds]{`=`} {b} => a = (a[x] b)

{guarded} if {condition} => (
  kept ^keyword := None
  if condition { kept = guarded }
  kept
)
{guarded} unless {condition} => (
  kept ^keyword := guarded
  if condition { kept = None }
  kept
)

%{from} -> %{to} ({parameters ^parameter}) => {block} ^keyword => (
  method_parameters := external ** parameters
  method_written := external ** block
  made ^keyword := Migration(from: Version(number: from), to: Version(number: to))
  external define made `body{arguments}` {
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  Migration.declare(made)
)
