// `12:00`, `12:00:00`
{hh: Decimal.String}:{mm: Decimal.String{length == 2}}: Quantity.Temporal => hh hours mm minutes
{hh_mm: Quantity.Temporal{.quantities.last.unit == minute}}:{ss: Decimal.String{length == 2}}: Quantity.Temporal => hh_mm ss seconds

Calendar := class {
  static Segment := class {
    static ~(convert: base ... -> last): Calendar.Segment => caller.global.Unit ~ convert

    static EPOCH: (period: #, elapsed: Node{0 <= . < period}?)? | Number = 0

    is_recurring => this ==.instance_of Ray && this.length#.some(== ∞)

    dynamically assert #.every(==.instance_of Quantity.Temporal)
  }

  static segments = static*{==.instance_of Segment}
  protected static TimeDefinition = Time{(-> .epoch).every(.calendar == calendar)}
  static equivalence (from: TimeDefinition) -> (to: TimeDefinition{calendar == this}) => {
    // Only offset differences, like UTC.
    within_same_calendar_system = from.calendar.static == to.calendar.static

    Time{calendar == from.calendar} &+= {
      as (:== to.calendar) => {
        // Keep the epoch structure: '25 Gregorian years' from '2001-01-01 Gregorian' is 'X Julian years' from 'X Julian' (N4.5).
        if epoch != 0 {
          Time(to.calendar, epoch: epoch as to.calendar) = this (as <= Unit.Temporal if !within_same_calendar_system)
        } else {
          Time(to.calendar) = to + (this - from) (as <= Unit.Temporal if !within_same_calendar_system)
        }
      }
    }
  }
}

Weekday := enum Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday
Month := enum January | February | March | April | May | June | July | August | September | October | November | December

Julian := class: Calendar {
  static year = Calendar.Segment ~ (day -> 365 | 366 if is_leap_year)
  static month = Calendar.Segment ~ Month#[
    31, 28 | 29 if year.is_leap_year, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
  ] days
  static week = Calendar.Segment ~ Weekday#.length days
  static day = Calendar.Segment ~ 24 hours
  static hour = Calendar.Segment ~ 60 minutes
  static minute = Calendar.Segment ~ 60 seconds | 61 seconds if LeapSeconds.at(this)

  is_leap_year => year % 4 == 0
}

Gregorian := class: Julian {
  is_leap_year => year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)

  // The reform: the day after 1582-10-04 Julian is 1582-10-15 Gregorian.
  equivalence "1582-10-04" as Julian -> "1582-10-15"
}

UTC := class: Gregorian (offset: Quantity.Temporal = 0) {
  equivalence 0 -> offset
}
GMT := UTC

Time := class: Quantity.Temporal (calendar: Calendar? = UTC) {
  // Only equivalent calendars can be compared. `:Time = "2025-01-01", epoch: "2000-01-01"` is `25.years` (N4.5).
  epoch: Time{== calendar} = 0
  = (x) => {
    this -= x
    super(x)
  }
  dynamically assert (this -> .epoch).length != ∞

  since_calendar_epoch: Time => (this -> .epoch as calendar if .epoch != 0).sum

  as (:== calendar) => this

  // `Time.YEAR`, `Time.MONTH` are context values: `with Time.MONTH = February` (N4.4).
  calendar.segments.for segment => dynamically Time.`segment.name.upper_case` = since_calendar_epoch.`segment.name`
  calendar.segments.for segment => `segment.name` => segment.is_recurring ? recur(epoch) : since_calendar_epoch as segment

  round (unit: Unit.Temporal) => (this as unit).round as Time

  // `now` is a distribution around the clock's reading; a correction narrows it, and times read since jump with it (N4.8, N4.10).
  static now: Time = nondeterministic (external time) ns ± (external time).resolution
  dynamically {
    .calendar.segments.for segment => `segment.name.upper_case` = `segment.name`
  } = now
}
{ now } = Time

// ISO 8601 (https://en.wikipedia.org/wiki/ISO_8601)
ISO_8601 := class: Time{calendar ==.instance_of UTC.static} (
  date: (
    year: Decimal,
    semicolons: "-"?,
    (
      month = Month#[1 - month_of_year: Decimal{length == 2}{1 <= . <= Month#.count}],
      semicolons: "-"?,
      day_of_month: Decimal{length == 2}{1 <= . <= (month ~= (days_in_month: *) days).days_in_month}
    ) | (
      day_of_year: Decimal{1 <= . <= (year as days ~= (days_in_year: *) days).days_in_year}
    ) | (
      "W",
      week_of_year: Decimal{1 <= . <= (year as weeks ~= (weeks_in_year: *) weeks).weeks_in_year},
      (
        "-",
        weekday: Weekday#[1 - day_of_week: Decimal{1 <= . <= Weekday#.count}]
      )?
    )
  )?,
  time: (
    "T" if date || !semicolons,
    hour_of_day: Decimal{length == 2}{< calendar.day.hours},
    semicolons: ":"?,
    minute_of_hour: Decimal{length == 2}{< calendar.hour.minutes},
    semicolons: ":"?,
    second_of_minute: Decimal{length == 2}{< calendar.minute.seconds},
    "Z" | offset: (
      offset_operator: "+" | "-",
      offset_hours: Decimal,
      ":",
      offset_minutes: Decimal
    )
  )?
) => {
  calendar += offset_operator offset_hours:offset_minutes
  long => month, " ", day_of_month, ", ", year

  dynamically assert semicolons if offset
  dynamically assert date | time
  // `12:00` is on every day: the date is unknown, and printing leaves it out (N4.3).
  date ?= ?
}

// Leap seconds and time zones are read from the system's tz data through io (N4.6, N4.7).
LeapSeconds := class = IO.read("/usr/share/zoneinfo/leap-seconds.list").lines{!.empty && !.starts_with("#")}
  .map(.split("\t").0 as Decimal seconds as Time(epoch: "1900-01-01"))
{
  at (minute: Time) => this.contains(minute.round(minute) + 1 minute)
}

TimeZone := class (name: String) {
  data => IO.read("/usr/share/zoneinfo/" + name)
}

Planet := class {
  years: Unit.Temporal
  days: Unit.Temporal
}
Earth := Planet(years: year, days: day)

Unit(name: "sol").multiple 88775, second
Unit(name: "martian year").multiple 668, sol
Mars := Planet(years: martian year, days: sol)
