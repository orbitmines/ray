!language   { }   {LHS} => {RHS}

{lhs} => {rhs} => {
  {lhs} => {rhs}
}
// {comment} => { }
// The first statement is the rule creator: a rule written `{head} => {body}` is defined where it is read. Its body is what
// `body` took (code, read once, with the rules before it: a rule never reads itself); its head is read with the rules there:
// what is in a hole is code too (`{x: T}` is the hole `x` with `{x}: {type}` read in it, `{x ^style}` with `{x} ^{style}`, and
// text a hole reads as, `{\`=>\`}`, is that text). A hole written against text takes no space (`{x}: {type}`: `:` binds the
// nearest), never ends inside a word, and none ends inside a pair: the brackets, and what a head that is one hole between two
// characters makes a pair (`({grouped})`). Of the rules reading all of a statement, a definition first (`=>` outside
// brackets), then one led by text, then the latest: declaration order is precedence, what is declared last binds loosest.
// Then a comment: nothing. (One after a statement, below.)

// A group: what is inside it, its value (a block in it, `({ … })`, a node).
({grouped}) => grouped
// `.`: what is read in, `this` (in a method, what it is read on); `&`, the application it is written in, read as a node: what
// its holes took (as text), its `caller`, and its `this`. A member, `x.name`: the name read in x (`x.name(y)`: the name, then
// `(y)` read on it where it is written); `x.( … )`, the code read in x. (In a method, a node made sees what it is read on
// first, then where it was written: `.name` is that one's.)
. => (external &).this
.{member} => {member}
.({member}) => {member}
this => .
// Text as written: between backticks.
`{text}` => (external &).text
// Code read in a value (`x &+= { … }` defines in x), the value.
// A value made of another too, `X &+= Y`: Y one of its components (§3.2: its rules seen after X's own, the last added first).
{on} &+= {value} => {
  // (of a class, behind its block: its own rules first (`Number &+= Ray`, Number's `==` before Ray's), then Y, then its parent)
  into := (((on).class_held !== None) && ((on).class_held.class_made === on)) ? (on).class_held : on
  added := (into).(external . {value})
  // (kept, for what it is: what is made of X is made of Y, `Number &+= Ray`, 1 is a Ray)
  // (a list of its own: what it read may be what it is made of has, `Chain &+= Array` with Chain made of Iterable, never
  // changed by it)
  on.made_of := ((on).made_of === None) ? Array.new.append(added) : (on).made_of.listed().append(added)
  on
}
{on} &+= {`{`}{code}{`}`} => {
  (on).({code})
  on
}
// A name given a value: the value read, then the name a rule answering it, here. A member given one, given in what it is on.
{name} = {value} => {
  value
  {name} => value
}
// A name with a type: its type kept with it (in a head, `{x: T}`: the hole takes what T's own rules read whole). Given no
// value, its value is the type: all it may be, superposed (`named: "p"` reads "p").
{x}: {type} => {
  // (its type kept on it: read when it is first asked for, a name of what a node is made of; else now, then the name (as a
  // left side), and while unset the type is what it is (`external unset`))
  external unset x type
}
// `x ^style`: x, shown in that style (highlighting only). A head written with a style after it: its text shown so.
{x} ^{style} => {
  x.style = style
  x
}
{lhs} ^{style} {`=>`} {rhs} => ({lhs} => {rhs}).style = style
`{text}` ^string => (external &).text
({grouped}) ^punctuation => grouped
// (a rule declared before a head could carry a style, shown in one: found by its head as it is written)
(external rule `.{member}`).style = `punctuation`
(external rule `.({member})`).style = `punctuation`
(external rule `{name} = {value}`).style = `punctuation`
(external rule `{x}: {type}`).style = `punctuation`
(external rule `{on} &+= {value}`).style = `punctuation`
(external rule `{on} &+= {`{`}{code}{`}`}`).style = `punctuation`
{statement} // {comment} ^comment => {statement}
// {comment} ^comment => { }
// (and a block of one, `/* … */`, nested: nothing)
/* {comment} */ ^comment => { }

// A block: a node, its code read in it (`.` it). (A rule's body written in brackets is code: one that makes a node has the
// block as its statement, `x => { { … } }`.)
{`{`}{code}{`}`} ^punctuation => {
  external .
  {code}
  .
}
// A name declared here, given a value. (`x: T = v`: the value checked against T first, the name keeping its type.)
{name} := {value} ^punctuation => {
  value
  {name} => value
}
// A name: a word (a head that is one hole takes one). A member's is one: `x.f(y)` is `f` read in x, then `(y)` read on it,
// with x as `this`.
Name := {
  // (the word as written: what it names need not be there, `circle (radius: Number)`)
  {word} => `{word}`
}
{name}: {type} = {value} ^operator => {
  (value) checked (type)
  {name} := value
  // (nothing holds no member: a default of nothing keeps no type, `x: T = None`)
  ({name}.type = type) unless value === None
}
// An optional one, `x?: T`: nothing unless it is given (`x: T = None`).
{name}?: {type} ^operator => {name}: ({type})? = None
assert {
  Linked := class (in?: Linked) => { }
  outer := Linked()
  assert Linked(in: outer).in === outer  // OP1 an optional field given is not what it was given
  assert !(outer.in)  // OP2 an optional field not given is something
  Defaulted := class (up: Defaulted = None) => { }
  assert Defaulted().up === None  // OP3 a typed field defaulting to nothing is something (a member of None set; or made with nothing, given `declared`)
}

// Text: what is written between quotes, each escape in it (`\e`) what it stands for (`.unescaped`, the library's).
"{text}" ^string => ((external &).text).unescaped
// (nothing written between them: the text of no characters)
"" ^string => `"`.rest
unescaped => .
assert `ab` as String == "ab"  // S158 written text is not read as a string

// Diagnostics: said where they are about (the host's label `report`, what the first hole took), and a value.
ERROR {message} ^error => {
  external goto report
  {
    message := `{message}`
    fatal := false
  }
}
FATAL {message} ^fatal => {
  external goto report
  {
    message := `{message}`
    fatal := true
  }
}
WARN {message} ^warn => external goto report
INFO {message} ^info => external goto report
TODO {message} ^debug => None
ensure {condition} => {
  unless (condition) {
    ERROR assertion failed
  }
  condition
}
// A test, `assert c`: checked after everything is read (the host's label `afterwards`), where it is written; painted as what
// it found (`untested` until then): `passed`, `failed` (also when anything was said while it ran: a name nothing defines).
assert {condition} ^untested => {
  external goto afterwards
  (external &) ^((ensure {condition}) ? `passed` : `failed`)
  external goto tested
  // (one that said something, an error in it: failed; the host's label `erred`)
  external label erred
  (external &) ^`failed`
  external label tested
}

// Node: the outermost node (`.` here). Every node sees its rules, so they are what any value read on reads: its methods.
Node := .
global := Node
// (what a declaration answers, `x: T`: nothing but that it declared)
declared := { }
assert {
  declared := 3 ; declared += 1
  assert declared == 4  // CF20 a declaration and an assignment on one line did not both run
}
// (what a method's body declares is the value's, `.`; in a block of its own, `{ … }`, the block's)
assert {
  Probed := class {
    local_of_probe := false
    probe_local => {
      {
        local_of_probe := true
      }
      true
    }
  }
  probed := Probed()
  probed.probe_local
  probed.local_of_probe === false
}  // LK1 a name declared in a block in a method's body is declared on what the method is read on
assert {
  {a} %+ {b} => true
  assert true %+ true  // GR1 a rule written at the top reads at the top
  inside => (
    {a} %+ {b} => false
    true %+ true
  )
  assert !(inside)  // GR2 a rule written in a body overrides the reading in that body
  assert true %+ true  // GR3 a rule written in a body does not change the reading after it
  beside => true %+ true
  assert beside  // GR4 a rule written in one body is not seen in a sibling body
  {a} %++ {b} => false
  {a} %+++ {b} => true
  assert !(true %++ true)  // GR5 the longest declared word wins: %++ is not read as %+ followed by +
  assert true %+++ true  // GR6 the longest declared word wins: %+++ is not read as %++ followed by +
  assert true %+ true  // GR7 a longer word declared later does not take over the shorter one
}
// A field named by its pattern as written, `{*}: T`: kept under that text, not a rule (a head that is one hole would read
// everything). A pattern is a body written.
Pattern := {
  {written} => written
}


// What a value answers to `?`: anything is true, but `None` and `false`.
? {yes} : {no} ^operator => yes
None := {
  ? {yes} : {no} => no
  value => None
  next => None
  // (a member of None is None: chains need no `?.`)
  .{member} => None
  // (nothing is one of what is nothing, or may be: `x?`, `None | x`)
  is {type} ^keyword => (type === None) || ((type.superposes === true) ? type.components.some((component) => component === None) : false)
  assert true.next == false  // BOR1 true.next should be false
  assert false.next == true  // BOR2 false.next should be true
  assert true.next.next == true  // BOR3 true.next.next should be true
  assert false.next.next == false  // BOR4 false.next.next should be false
}
// (enumerations and classes: read where None's rules are not)
assert {
  Colour := enum red | green | blue
  assert Colour.red  // EM1 the member an enum is written with is not there
  assert Colour.blue  // EM2 the last member is not there
  assert Colour.red == Colour.red  // EM4 a member is not itself
  assert !(Colour.red == Colour.blue)  // EM5 two members of one enum are the same
  assert Colour.red is Colour  // EM6 a member is not one of its enum
  assert Colour#.count == 3  // EM7 an enum of three has other than three members
  assert Colour# == [Colour.red, Colour.green, Colour.blue]  // EM14 an enum's members are not its three, in order
  assert Colour.red.next == Colour.green  // EM25 the member after red is not green
  Size := enum small | large
  assert !(Size.small is Colour)  // EM15 a member is one of another enum
}
assert {
  R := class { }
  S := class: R { s => S(next: this) }
  assert S().s.s.s  // C5 a successor chain through class: Parent broke
  assert S.components.hierarchy.first  // C6 class: Parent did not add a class component
  assert S.super  // C7 super is missing
}
assert {
  E := enum p | q | r
  assert E#.first == E.p  // C9 the first enum member is not the first written
  assert E#.first.next.next == E.r  // C10 enum members are not chained forward
  assert E#.last.previous.previous == E.p  // C11 enum members are not chained backward
  assert E#.count == 3  // C12 an enum of three has other than three members
  assert E#.first.is_initial  // C13 the members are not an Iterable of Rays
  assert E#.last == E.r  // C14 Iterable.last did not reach the last member
}
assert (true |+ "A").next == false | "B"  // SP2 |+ does not answer with either component
assert !(None)  // BO27 nothing is there
// Negations on nothing answer true (T1.8)
assert None != 1  // NGN1 nothing is said to be one
assert None !~= "a"  // NGN2 nothing is said to match
false := {
  ? {yes} : {no} => no
  // (the two of them a Ray, each the other's next)
  next => true
  previous => true
}
assert true == true  // BO23 true is not itself
assert !(true == false)  // BO24 true is false
assert true  // BO25 true is not there
assert !(false)  // BO26 false holds as a condition
true := {
  next => false
  previous => false
}

// `!x`: false when x is anything but `None` and `false`.
!{x} ^operator => x ? false : true
// (`!!x`, written together: x as true or false)
!!{x} ^operator => x ? true : false
assert !(!true)  // BB4 not(true) should be false
assert !false  // BB5 not(false) should be true
assert !!true  // BO21 not not true is not true
assert !(!!false)  // BO22 not not false is true
assert !None  // BO28 asking whether nothing is there answers nothing
{a} || {b} ^operator => a ? a : b
assert true || false  // BB8 or(true,false) should be true
assert !(false || false)  // BB9 or(false,false) should be false
assert false || true  // BO4 or(false,true) should be true
assert true || true  // BO5 or(true,true) should be true
assert 0 || true  // N97 zero or true is not true
assert !(0 || false)  // N98 zero or false is true
assert {
  cleared_vertex := [1, 2].entry
  kept_vertex := cleared_vertex
  cleared_vertex = None
  assert !(kept_vertex.initial || kept_vertex.terminal)  // NGN4 a vertex set to nothing keeps its boundaries
}
{a} && {b} ^operator => a ? b : a
assert true && true  // BB6 and(true,true) should be true
assert !(true && false)  // BB7 and(true,false) should be false
assert !(false && true)  // BO2 and(false,true) should be false
assert !(false && false)  // BO3 and(false,false) should be false
assert true && !false  // BB16 true && !false should be true
assert 1 && true  // N95 one and true is not true
assert !(0 && true)  // N96 zero and true is true
assert None != 5 && !(None != None)  // NGN3 a negation on nothing does not answer true against something, or holds against nothing
assert (choose 1 ("A" | "B")) is ("A" | "B") && (choose 1 ("A" | "B"))#.count == 1  // HS11 choosing a counted type does not resolve to one of its possibilities
// `a & b` of two that are true or false: both; of anything else, what its own `&` is (a Node's, their conjunction).
conjoined := None
{a} & {b} ^operator => (((a) === true) || ((a) === false)) ? ((a) && (b)) : ((a) conjoined_with (b))
// (held at once: each of them, `1 & 2 & 3` three)
{a} conjoined_with {b} ^keyword => ({
  conjoins := true
  conjoined := (((a).conjoins === true) ? (a).conjoined.listed() : Array.new.append(a)).joined(((b).conjoins === true) ? (b).conjoined : Array.new.append(b))
  contains (x) => conjoined.some((y) => y == x)
  // (called, a type of what it reads and a function of it, `Statements(global)(Program())`: a type that reads as it does, then
  // calls that function on what it read, `.` that, with what it is called with)
  {this}({conjunction_given}) => (.) applied_with (conjunction_given)
})
// (what a conjunction was called with, `applied_args`: none until it is)
applied_args := None
{applied_conj} applied_with {applied_given} ^keyword => {
  applied_from := applied_conj
  applied_made := ({
    conjoins := true
  })
  external member (applied_made) (`conjoined`) (applied_from.conjoined)
  external member (applied_made) (`applied_args`) (applied_given)
  applied_dynamic := (applied_from).dynamic_frame
  external member (applied_made) (`dynamic_frame`) (applied_dynamic)
  applied_made
}
// (what a type read, called: by a conjunction that was called, its function (the last of it) on that, with what it was called
// with; else what was read)
{applied_type_of} applying_to {applied_value_of} ^keyword => {
  applying_type := applied_type_of
  applying_value := applied_value_of
  ((applying_type).applied_args === None) ? applying_value : (((applying_type).conjoined.last).on(applying_value) after ((applying_type).applied_args))
}
assert (true & true)  // BB17 true and true is not true
assert !(true & false)  // BB18 true and false is true
assert (1 & 2).contains(2)  // TY68 what holds both does not hold the second
assert (1 & 2 & 3).conjoined.count == 3  // TY69 three held at once are not three
{a} ?? {b} ^operator => (a === None) ? b : a
assert None ?? true  // BN1 ?? does not fall back on nothing
assert !(false ?? true)  // BN2 ?? replaces a value that is there
// The same value: gone to as a label (a label written as a value is gone to by that value); nothing there, another.
{a} === {b} ^operator => {
  external goto {a}
  external goto other
  external label {b}
  true
  external goto same
  external label other
  false
  external label same
}
{a} !== {b} ^operator => (a === b) ? false : true
// (not found in: nothing is found in nothing, `None !~= x` (T1.8))
{a} !~= {b} ^operator => ((a) === None) ? true : !((a) ~= (b))
// A choice, `c ? a : b`: the condition all before the `?`.
{condition} ? {yes} : {no} ^operator => (condition) ? yes : no
assert true ? true : false  // BT3 c ? a : b does not take a when c holds
assert !(false ? true : false)  // BT4 c ? a : b takes a when c does not hold
assert false ? false : true  // BT5 c ? a : b does not take b for a named c

// A branch: the block taken read where the branch is (labels named apart from a loop's, which `break` and `continue` go to
// through it); not taken, what follows its block (`else { … }`, `elsif c { … } …`: code, read there), else None. (A block is
// written in brackets, so a condition is all that is before it: `if x > 3 { … }`.)
if {condition} {`{`}{taken}{`}`} ^keyword => {
  {condition} ? (external goto taken) : (external goto passed)
  external label taken
  {taken}
  external goto branched
  external label passed
  None
  external label branched
}
if {condition} {`{`}{taken}{`}`} {chain} ^keyword => {
  {condition} ? (external goto taken) : (external goto passed)
  external label taken
  {taken}
  external goto branched
  external label passed
  {chain}
  external label branched
}
else {`{`}{otherwise}{`}`} ^keyword => {otherwise}
elsif {condition} {`{`}{taken}{`}`} ^keyword => if {condition} { {taken} }
elsif {condition} {`{`}{taken}{`}`} {chain} ^keyword => if {condition} { {taken} } {chain}
unless {condition} {`{`}{taken}{`}`} ^keyword => if !(condition) { {taken} }
unless {condition} {`{`}{taken}{`}`} {chain} ^keyword => if !(condition) { {taken} } {chain}
assert !((if 0 { "taken" }))  // IC4 an if whose block holds no cases is read as cases
assert !((if false { true }))  // CC6 a bare if with a false predicate is not None-like
assert (unless false { true })  // CC7 unless did not fire
assert (unless true { 1 } else { 2 }) == 2  // CF9 unless has no other side
assert (if false { true } elsif true { true } else { false })  // CC3 elsif did not fire
assert (if false { true } elsif false { true } else { true })  // CC4 else after elsif did not fire
assert (if true { true } else { false })  // CC1 if-true did not take the then branch
assert !((if false { 1 } else { None }))  // CC12 an if whose taken branch is None is present
assert (if true { 1 } else { None })  // CC13 an if whose taken branch is one is absent
assert !((if false { true } else { false }))  // CC2 if-false took the then branch
assert (if true { true } elsif true { false } else { false })  // CC5 a later branch overrode the first
// CF5 a branch does not answer its last statement
assert (if true {
  1
  2
  3
} else { None }) == 3
assert (if true { if false { 1 } else { 2 } } else { 3 }) == 2  // CF6 a branch inside a branch is not read there
assert (if 1 { true } else { false })  // CF7 a number that is there does not hold
assert !((if None { true } else { false }))  // CF8 nothing holds

// Loops: `break` goes to the loop's end, `continue` to its start.
while {condition} {`{`}{body}{`}`} ^keyword => {
  external label again
  {condition} ? (external goto looping) : (external goto done)
  external label looping
  {body}
  external goto again
  external label done
}
assert {
  flag := true
  while flag { flag = false }
  assert !(flag)  // CC8 while did not run its body
}
assert {
  ran := false
  while false { ran = true }
  assert !(ran)  // CC9 while ran with a false predicate
}
loop {`{`}{body}{`}`} ^keyword => while true { {body} }
{body} while {condition} ^keyword => while {condition} { {body} }
do {`{`}{body}{`}`} while {condition} ^keyword => {
  {body}
  while {condition} { {body} }
}
assert {
  seen := false
  do { seen = true } while false
  assert seen  // CC10 do-while did not run its body at least once
}
assert {
  stop := true
  do { stop = false } while stop
  assert !(stop)  // CC11 do-while did not stop
}
assert {
  asked := 0
  do { asked += 1 } while false
  assert asked == 1  // CF12 do ran other than once when it never holds
}
break ^keyword => external goto done
assert {
  stopped := 0
  while true {
    stopped = stopped + 1
    break if stopped == 3
  }
  assert stopped == 3  // RC2 break does not leave the loop
}
continue ^keyword => external goto again
assert {
  skipped := 0
  counted := 0
  while counted < 5 {
    counted = counted + 1
    continue if counted == 2
    skipped = skipped + 1
  }
  assert skipped == 4  // RC3 continue does not go on with the next round
}
// Leaving a call: `return v` (the call answers v), `return`; the call again from its start, `recur(arguments)`.
return {value} ^keyword => {
  value
  external goto returned
}
return ^keyword => external goto returned
recur({again}) ^keyword => return this({again})
recur ^keyword => external goto recurring
assert {
  countdown (n) => (
    return n if n == 0
    recur(n - 1)
  )
  assert countdown(5) == 0  // RC1 recur(args) does not re-enter the method
}
assert {
  Base_said := class { said => `base` }
  Nested_said := class: Base_said (inner) => {
    said => (.inner === None) ? `nested` : .inner.said
  }
  assert Nested_said(Nested_said(None)).said == `nested`  // RC4 a method calling itself on another instance read its parent's (a rule never reads itself: only on the value it runs on)
}

// A closure: a rule read where a value is wanted, a node holding it; read on (`f(5)`), its right side run in a new node in it,
// its parameters taking the arguments (code, read where they are written: `f(x: 5)` declares its `x`, answering `declared`).
// (A head led by `{this}` is a method: read only on a value, what follows it; so `(…)` in the body is not a call of itself.)
// It ends at `returned` (`return v` goes there), and begins again at `recurring` (`recur(…)` gives its parameters these first).
// (Its parameters take the arguments' values: a type a parameter is given, `x: T`, is checked on the value, not read in the
// text.)
({parameters}) {`=>`} {body} ^punctuation => {
  external .
  {this}({arguments}) ^punctuation => {
    external .
    ({{parameters}}) taking {arguments}
    external label recurring
    {{body}}
    external label returned
  }
  // (called on what follows it, without brackets: `double 4`, `6 == 6` (`==` a method of 6), `"0".."9"`)
  {this}{arguments} => {
    external .
    ({{parameters}}) taking {arguments}
    external label recurring
    {{body}}
    external label returned
  }
  // (called with nothing: its parameters as written, their defaults given (each given nothing: a typed one its type))
  {this}() => {
    external .
    ({{parameters}}) taking declared
    external label recurring
    {{body}}
    external label returned
  }
  // (called with `.` in it another value, `step.on(element) after accumulated`: reduce's; no call in brackets, so the
  // accumulated value is given whole (a superposition is not taken apart: `reduce(|)` lays `|` on each edge, `1 | 2 | 3`))
  {this}.on({receiver}) after {arguments} => {
    external .
    ({{parameters}}) taking {arguments}
    // (`.` in it the value: a rule of its own node, read before the language's)
    received := {receiver}
    . => received
    external label recurring
    {{body}}
    external label returned
  }
  // (given nothing, its parameter no default (`(acc) => acc + .`): the start is that value itself)
  {this}.on({receiver}) => {
    external .
    received := {receiver}
    . => received
    (({{parameters}}) === None) ? received : ({{body}})
  }
  // (one: what calls it, as a list says it is one, `listing`)
  closure => true
  .
}
() {`=>`} {body} ^punctuation => {
  external .
  {this}() => {
    external .
    external label recurring
    {{body}}
    external label returned
  }
  closure => true
  .
}
assert {
  Hugged := { }
  Hugged &+= {
    .. (last) => false
  }
  assert !(Hugged..Hugged)  // CL19 an operator method does not take what is written right after it
