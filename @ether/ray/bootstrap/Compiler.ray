  // (a function, `f (a: T, b) => …`, written with its parameters, each of its kind if it has one)
  static defined (fm) => (Lowered.kind(fm) == `rule_head`) ? Lowered.function(Compiled.trimmed(Lowered.parsed(fm).rule_head), Lowered.parsed(fm).rule_body) : None
  static function (fh, fb) => (Compiled.kind_of(Compiled.head_parsed(fh).first) == `applied_name`) ? Lowered.function_as(Compiled.trimmed(Compiled.head_parsed(fh).first.applied_name), Compiled.parts(Compiled.head_parsed(fh).first.applied_params).map((p) => Lowered.field_of(p)), fb) : Lowered.function_as(Compiled.trimmed(fh), Array.new, fb)
