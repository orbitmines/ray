Nameable := class: Ray {
  named (name: String) => (
    .name = name
    this
  )
}
Entity := class: Ray { }

Location := class: Hierarchy {
  parent?: Node
  children: (chain None)
  host?: Node
}

World := class: Nameable {
  prefix => `#`
  name: String
  worlds: (chain None)
  personas: (chain None)
  items: (chain None)
  quests: (chain None)
  reservations: (chain None)

  spawn (persona) => (
    .personas &= persona
    persona
  )
  add (item) => (
    .items &= item
    item
  )
  post (quest) => (
    .quests &= quest
    quest
  )

  shadowing => None

  reserve (name: String) => (
    standing ^keyword := .reserved(name)
    unless (standing) { standing = .issue(name) }

    standing
  )

  issue (name: String) => (.reservations &= World.Reservation(name: name, issuer: this)).tail.value

  reserved (name: String) => (
    holder ^keyword := None
    walker ^keyword := .reservations.head
    while (walker) {
      if (walker.value.name == name) { holder = walker.value }
      walker = walker.next
    }
    holder
  )
  Reservation := class: Ray {
    name: String
    issuer: Node
  }
  population => .personas.count
}
Region := World

Quest := class: Nameable {
  name: String
  goal: Node
  steps: (chain None)
  done: false

  step (description) => (
    .steps &= description
    this
  )
  complete => (
    .done = true
    this
  )
  completed => .done
  difficulty => .steps.count
}
Task := class: Quest {
  name: String
  goal: Node
  steps: (chain None)
  done: false
  interrupted: false

  interrupt => (
    .interrupted = true
    this
  )
}

Item := class: Ray {
  name: String
  issuer: Node
  location: None
  obtained_by: None
  certificate: None

  move (location) => (
    .location = location
    this
  )
  certify (certificate) => (
    .certificate = certificate
    this
  )
}
Certificate := class: Ray {
  issuer: Node
  secret: Node
  issued_on: Time.now

}

History := class: Ray {
  Commit := class: Ray {
    who: Node
    what: Node
    id: UUID.v4
    when: Time.now

  }
  repository: Node
  commits: (chain None)
  from: None

  commit (who, what) => (
    .commits &= History.Commit(who: who, what: what)
    this
  )
  count => .commits.count
  latest => .commits.tail.value
  fork => History.Branch(repository: .repository, commits: (chain None), from: this)

  Branch := class: History {
    repository: Node
    commits: (chain None)
    from: None
  }
}
Repository := class: Ray {
  world: Node
  histories: (chain None)

}

Accessor := class: Ray {
  Permission := enum private | confidential | protected | public
  level: Node

}

Reference := class: Ray {
  title: String
  author: Node
  date: Time.now
  draft: true
  notes: (chain None)
  link: None

  publish => (
    .draft = false
    this
  )
  note (text: String) => (
    .notes &= text
    this
  )
}

Instance := class: Ray {
  location: Node
  status: Status.online

}
Status := enum online | offline | hosted | broadcast | proxy | invisible
Persona := class: Nameable {
  prefix => `@`
  name: String
  avatars: (chain None)
  presence: None
  status: Status.offline

  status_now => if (.presence) { .presence.status } else { .status }
  embody (avatar) => (
    .avatars &= avatar
    avatar
  )
}
Avatar := class: Persona {
  persona: Node
  platform: Node
  avatars: (chain None)
  presence: None
  status: Status.offline

}
Player := class: Persona {
  name: String
  avatars: (chain None)
  presence: None
  status: Status.offline

}
NPC := class: Persona {
  name: String
  avatars: (chain None)
  presence: None
  status: Status.hosted

}
Organization := class: Player {
  name: String
  avatars: (chain None)
  presence: None
  status: Status.offline
  members: (chain None)

}
