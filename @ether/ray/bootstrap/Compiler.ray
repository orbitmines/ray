// Built (`level built …`): a node's text read again as a pattern (its gaps and words, each key a field of what it
// holds: a pattern, a text read with, else anything), the holes in it told how they end (inside a pair of literals,
// beside one); the lines of a statement set aside to be read again, up to one no more indented; cells of a pattern
// read on; bytes compared and classed; where anything read up to a place ends; not.
Built := class {
  static rebuilt (n: Node) => Built.rebuilt_from(n, member(n, Symbol.text), n.keys, list())
  static rebuilt_from (n, t: Text, s: List, l) => {
    pos := t.from
    i := 0
    while i < s.count {
      pos = Built.span_rebuilt(n, l, at(s, i), pos)
      i = i + 1
    }
    gaps(l, pos, t.to) if t.to > pos
    enclosed_holes(l)
    sequence(l)
  }
  static span_rebuilt (n, l, c: Spanned, pos) => {
    gaps(l, pos, c.from) if c.from > pos
    append(l, ((c.value is Place) || (c is Marked)) ? topattern(c.value) : Built.field_rebuilt(c.name, Built.with_read(n, c.name, member(n, c.name))))
    c.to
  }
  static with_read (n, sym, v) => (v is Text) ? Matching.with_in(Matching.reread_of(member(n, 15)), sym, v) : v
  static field_rebuilt (sym, v) => field(sym, (v is Pattern) ? v : (((v is Node) && (member(v, Symbol.text) != None)) ? pattern(reread, v, 0) : anything()))
  static enclosed_holes (l: List) => {
    i := 0
    while i < l.count {
      Built.hole_enclosed(l, i, at(l, i))
      i = i + 1
    }
    0
  }
  static hole_enclosed (l: List, i, f: Pattern) => {
    Built.hole_between(l, i, f.b, Built.literal_at(l, i - 1), Built.literal_at(l, i + 1)) if f.kind == named_field
    0
  }
  static literal_at (l: List, j) => ((j >= 0) && (j < l.count) && Layout.is_literal(at(l, j))) ? at(l, j) : 0
  static hole_between (l, i, h: Pattern, a, b) => {
    (((a != 0) && (b != 0)) ? Built.hole_inside(h, a, b) : Built.hole_beside(l, i, h, a, b)) if (h is Pattern) && (h.kind == hole)
    0
  }
  static hole_inside (h: Pattern, a: Pattern, b: Pattern) => {
    h.b = 1
    h.c = byte(Built.text_from(b.a))
    Built.ended_by(h, 2) if Texts.same_text(a.a, b.a)
    0
  }
  static text_from (t: Text) => t.from
  static ended_by (h: Pattern, k) => {
    h.b = k
    0
  }
  static hole_beside (l, i, h: Pattern, a, b) => {
    Built.ended_by(h, 3) if ((a != 0) && (spaced(l, i - 2) == 0)) || ((b != 0) && (spaced(l, i + 2) == 0))
    0
  }
  static with_code (a, b) => a
  static under (b: Node, env) => {
    b.in = env
    b
  }
  static staged (f) => pattern(typed_by, f, 0)
  static recell (k: Rest, next) => (k.list is List) ? Rest(list: k.list, next: next, index: k.index) : cell(k.list, next)
  static chared (c, k) => (k == 1) ? ((c == 32) || (c == 9)) : (((k == 2) || (k == 4)) ? (c == 10) : ((k == 3) ? white(c) : 1))
  static texteq (a, b, n) => {
    i := 0
    while i < n {
      return 0 if byte(a + i) != byte(b + i)
      i = i + 1
    }
    1
  }
  static negated (v) => truthy(v) ? false : true
  static param_of (ps, n, a, e) => {
    i := 0
    while i < n {
      return 1 if ((word_of(ps + ((i * 8) + 4)) - word_of(ps + (i * 8))) == (e - a)) && texteq(word_of(ps + (i * 8)), a, e - a)
      i = i + 1
    }
    0
  }
}
// Turns (`level in_turn …`): the statements of a text read in turn by an item, each to where it ends (or where a block
// opened in it closes), each read in a region of its own and given to a function as it is read; one not read is set
// aside, and those are read again after (each one read now taken out, until none more is), one over its budget noted.
Turns := class {
  static in_turn (item, f, args, pos) => Turns.turned(item, f, args, pos, turn_depth(), fuel_floor())
  static turned (item, f, args, pos, d, floor) => {
    turn_depth_set(d + 1)
    u := Turns.aside_count()
    at := Turns.in_order(item, f, args, pos)
