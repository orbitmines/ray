// Bincode's configurations, chosen per use (https://github.com/bincode-org/bincode/blob/trunk/docs/spec.md).

mark ^keyword := external global

// Varint: below 251 in one byte (spec.md, "Varint encoding")
unless Bincode<Integer{>= 0}>(value: 7) as Byte[] == [7] { INFO@mark `BC1 7 under the standard configuration is not the one byte 7` }
// Fixint: an u64 in its eight bytes, little endian (spec.md, "FixintEncoding")
unless Bincode<Integer{>= 0}, Bincode.legacy>(value: 7) as Byte[] == [7, 0, 0, 0, 0, 0, 0, 0] { INFO@mark `BC2 7 under the legacy configuration is not eight little-endian bytes` }
// Varint: 251, then the integer as an u16 (spec.md, "Varint encoding")
unless Bincode<Integer{>= 0}>(value: 300) as Byte[] == [251, 0x2C, 0x01] { INFO@mark `BC3 300 under the standard configuration is not 251 and a little-endian u16` }
unless Bincode<Integer{>= 0}, Bincode.legacy>(value: 300) as Byte[] == [0x2C, 0x01, 0, 0, 0, 0, 0, 0] { INFO@mark `BC4 300 under the legacy configuration is not eight little-endian bytes` }
// Signed integers: zigzag under varint, two's complement under fixint (spec.md, "Varint encoding", "FixintEncoding")
unless Bincode<Integer>(value: -1) as Byte[] == [1] && Bincode<Integer>(value: 1) as Byte[] == [2] { INFO@mark `BC5 -1 and 1 under the standard configuration are not zigzag encoded as 1 and 2` }
unless Bincode<Integer, Bincode.legacy>(value: -1) as Byte[] == [0xFF] * 8 { INFO@mark `BC6 -1 under the legacy configuration is not eight bytes of ff` }
// Strings: the length as an u64, then the UTF-8 bytes (spec.md, "Collections", "String and &str")
unless Bincode<String>(value: "ab") as Byte[] == [2, 0x61, 0x62] && Bincode<String, Bincode.legacy>(value: "ab") as Byte[] == [2, 0, 0, 0, 0, 0, 0, 0, 0x61, 0x62] { INFO@mark `BC7 a string's length is not one varint byte standard and eight bytes legacy` }
// Byte order is part of the configuration (spec.md, "Endianness")
unless Bincode<Integer{>= 0}, Bincode.legacy.big_endian>(value: 300) as Byte[] == [0, 0, 0, 0, 0, 0, 0x01, 0x2C] { INFO@mark `BC8 300 under fixint big endian is not eight big-endian bytes` }
// Each configuration reads back what it wrote, and not the other's bytes as the same value
unless ([7, 0, 0, 0, 0, 0, 0, 0] as Bincode<Integer{>= 0}, Bincode.legacy>).value == 7 && ([251, 0x2C, 0x01] as Bincode<Integer{>= 0}>).value == 300 { INFO@mark `BC9 bytes do not read back under the configuration that wrote them` }
unless !([251, 0x2C, 0x01] is Bincode<Integer{>= 0}, Bincode.legacy>) { INFO@mark `BC10 a varint is read as a fixint` }
// The standard configuration is the default, the same type spelled either way
unless Bincode.standard.varint && !Bincode.legacy.varint && Bincode.standard.endianness == Bincode.legacy.endianness { INFO@mark `BC11 standard is not varint and legacy fixint, both little endian` }
unless Bincode<String>(value: "ab") as Byte[] == Bincode<String, Bincode.standard>(value: "ab") as Byte[] { INFO@mark `BC12 the standard configuration is not the default` }
// A limit on the bytes read (spec.md, "Configuration"; Configuration::with_limit)
unless !([2, 0, 0, 0, 0, 0, 0, 0, 0x61, 0x62] is Bincode<String, Bincode.legacy.limited(4)>) { INFO@mark `BC13 a value longer than the configured limit is read` }
