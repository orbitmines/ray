// The operating system a device runs: one of these. As a boolean, whether it is the one the device runs (`@me/device/os`):
// what differs between them is written where it belongs (`if OS.Windows { … } elsif OS.Browser { … }`), in the package
// it is about (files and streams here, time zones in Time.ray, sockets in network, font folders in opentype).
OS := enum Linux (platform: "linux") | Windows (platform: "win32") | Macos (platform: "darwin") | Browser (platform: "browser") | Ether (platform: "ether") {
  as (=== boolean) => this === @me/device/os
  // what the host says of itself (`os["PATH"]`, `os.env.PATH`); the language as the operating system says only what it is
  [property: String] => this === OS.Ether ? { "platform": "ether", "architecture": "ray" }[property] : OS.reported(property) as String
  architecture => this["architecture"]
  // IO2 the machine does not say what it is built on
  assert @me/device/os/architecture
  // IO4 asking by name is not asking the other way
  assert @me/device/os["architecture"] == @me/device/os/architecture
  env => Environment(os: this)
  // The environment is read through the OS, live.
  // ENV1 the environment is not read through the OS
  assert @me/device/os.env.PATH == @me/device/os["PATH"]
  static Environment := class (os: OS) => {
    .{literal name ^property} ^punctuation => os[name]
  }

  // the one the host reports; none: the language as the operating system
  // (what the host reports of itself: given by the implementation; none in the language)
  static reported (property) => None
  static host: OS => OS#{!== OS.Ether}{.platform == (OS.reported("platform") as String)}.first ?? OS.Ether
  // OSE4 the device does not run the operating system the host reports
  assert @me/device/os === OS.host
}
// An operating system is a member of the enum OS; as a boolean, whether it is the one the device runs.
// OSE1 an operating system is not one of OS
assert [OS.Ether, OS.Linux, OS.Macos, OS.Windows, OS.Browser].every(. is OS)
// OSE3 other than one operating system runs this device
assert OS#{as boolean}.count == 1
assert {
  with @me/device/os = OS.Windows {
    // OSE6 the operating system the device runs is not true as a boolean
    assert OS.Windows
    // OSE7 an operating system the device does not run is true as a boolean
    assert !(OS.Linux)
  }
}
