@ether/os
@c
@storage
@terminal

// The device's files: the host's (sandboxed: what the host answers for a directory is its entries); a browser and the
// language as the operating system keep them in the device's storage (`storage: Storage = @me/device`, a page's its Web Storage),
// where a directory is what is kept under it. It holds the file space: a location of no scheme, `file:`, or a Windows
// drive (`@C:/`, https://url.spec.whatwg.org/#windows-drive-letter).
FileSystem := class: Language {
  [location: Location] => if OS.Browser || OS.Ether {
      (@me/device as Storage) -- (storage => storage[location.normalised] ?? (storage.fields.name{~= ⊢(location.normalised + "/")}
        .map(.after(location.normalised + "/").before("/")).unique.map(location / .) -- (.nonempty ? . : None)))
    } else { FileSystem.read(location.sandboxed) -- (. is String[] ? .map(location / .) : .) }
  { }[{location: Location}] = {value} ^punctuation => if OS.Browser || OS.Ether { (@me/device as Storage)[location.normalised] = value }
    elsif value === None { FileSystem.removed(location.sandboxed) }
    else { FileSystem.written(location.sandboxed, value as Byte[]) }
  // executed: what the host opens it with, given the code between the brackets
  ({location: Location}, {args}) => if OS.Ether { (location.held as Program)(args) }
    elsif OS.Browser { ERROR@OS `a browser does not execute a file` }
    else { FileSystem.opened(location.@ as String, args) }

  // What the host's files are, through its interface: POSIX's on Linux and macOS (open, read, opendir, unlink,
  // posix_spawnp; https://pubs.opengroup.org/onlinepubs/9799919799/), Win32's on Windows (CreateFileW, ReadFile,
  // FindFirstFileW, DeleteFileW, ShellExecuteW; https://learn.microsoft.com/windows/win32/fileio/file-management-functions).
  // A file reads as its bytes, a directory as the names in it, nothing there as None.
  static read (path: String) => if OS.Windows {
      (@c {
        WIN32_FILE_ATTRIBUTE_DATA about
        int found = GetFileAttributesExW(L{path}, GetFileExInfoStandard, &about)
        int directory = found && (about.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0
        unsigned size = found && !directory ? about.nFileSizeLow : 0
        unsigned char content[size]
        HANDLE file = found && !directory ? CreateFileW(L{path}, GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr) : INVALID_HANDLE_VALUE
        unsigned count = 0
        if (file != INVALID_HANDLE_VALUE) { ReadFile(file, content, size, &count, nullptr) }
        CloseHandle(file)
      })() -- (got => !got.found ? None : got.directory ? FileSystem.listed(path) : got.content[..<got.count])
    } else {
      (@c {
        struct stat about
        int found = stat({path}, &about) == 0
        int directory = found && S_ISDIR(about.st_mode)
        long size = found && !directory ? about.st_size : 0
        unsigned char content[size]
        int file = found && !directory ? open({path}, O_RDONLY) : -1
        long count = file >= 0 ? read(file, content, size) : 0
        close(file)
      })() -- (got => !got.found ? None : got.directory ? FileSystem.listed(path) : got.content[..<got.count])
    }
  // the names in a directory, but `.` and `..`
  static listed (path: String) => if OS.Windows {
      (@c {
        WIN32_FIND_DATAW entry
        wchar_t names[65536] = L""
        HANDLE found = FindFirstFileW(L{path + "\\*"}, &entry)
        while (found != INVALID_HANDLE_VALUE && wcscat(wcscat(names, entry.cFileName), L"\n") && FindNextFileW(found, &entry)) { }
        FindClose(found)
      })().names.lines{. != "." && . != ".." && . != ""}
    } else {
      (@c {
        DIR* directory = opendir({path})
        char names[65536] = ""
        struct dirent* entry = nullptr
        while (directory && (entry = readdir(directory))) { strcat(strcat(names, entry->d_name), "\n") }
        closedir(directory)
      })().names.lines{. != "." && . != ".." && . != ""}
    }
  static written (path: String, bytes: Byte[]) => if OS.Windows {
      (@c {
        HANDLE file = CreateFileW(L{path}, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr)
        unsigned count = 0
        WriteFile(file, {bytes}, {bytes.count}, &count, nullptr)
        CloseHandle(file)
      })().count == bytes.count
    } else {
      (@c {
        int file = open({path}, O_WRONLY | O_CREAT | O_TRUNC, 0644)
        long count = write(file, {bytes}, {bytes.count})
        close(file)
      })().count == bytes.count
    }
  static removed (path: String) => if OS.Windows {
      (@c { int removed = DeleteFileW(L{path}) || RemoveDirectoryW(L{path}) })().removed != 0
    } else {
      (@c { int removed = unlink({path}) == 0 || rmdir({path}) == 0 })().removed != 0
    }
  // opened as the desktop opens it: xdg-open on Linux (https://portland.freedesktop.org/doc/xdg-open.html), open on macOS,
  // the shell's verb "open" on Windows; waited for, answering how it exited
  static opened (path: String, args) => if OS.Windows {
      (@c { long opened = (long)ShellExecuteW(nullptr, L"open", L{path}, L{args as String}, nullptr, SW_SHOWNORMAL) })().opened > 32
    } else {
      (OS.Macos ? "open" : "xdg-open") -- (opener => (@c {
        pid_t child = 0
        int status = -1
        if (posix_spawnp(&child, {opener}, nullptr, nullptr, {[opener, path, args as String]}, environ) == 0) { waitpid(child, &status, 0) }
      })().status == 0)
    }
}
Location &+= {
  sandboxed => "instance/" + .normalised
}

Holders = Holders + {
  // (this instance, as whoever plays it reaches it: the terminal it is played through, one of its devices)
  {location: Location{=== @local}} => (@me/device as Terminal)
  {location: Location{!.scheme || .scheme == "file" || .scheme.length == 1}} => FileSystem()
}
assert ("/a/b" as Location).holder is FileSystem  // LOC49 a location with no scheme is not held by the file system
// A Windows drive is a file location, not a URL with the scheme "C".
assert (@C:/Windows/System32) as String == "C:/Windows/System32"  // FS1 a Windows drive path is not read as written
assert (@C:/Windows/System32).holder is FileSystem  // FS2 a Windows drive is not held like any other file path

// What is at a location: `.held` read, `@x = value` written, `@x = None` removed, `@new = @x` copied, a directory's children
// what is under it
assert {
  with (@me/device as OS) = OS.Ether {
    @./ethertest/a = "x"
    assert (@./ethertest/a).held == "x"  // ETH1 what is written on ether is not read back
    assert (@./ethertest).children == [@./ethertest/a]  // ETH2 a location on ether does not list what was written under it
    @./ethertest/b = @./ethertest/a
    assert (@./ethertest/b).held == "x"  // FS3 a location assigned another is not a copy of what is held there
    @./ethertest/a = None
    assert !(@./ethertest/a)  // ETH3 a location removed on ether is still there
    assert (@./ethertest/a) as String == "./ethertest/a"  // FS4 a location's own location is not where it was written
  }
}
