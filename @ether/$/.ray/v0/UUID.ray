// UUIDs (draft: utils/UUID.ray, RFC 4122): 128 bits, shown as 32 hexadecimal
// digits in groups of 8-4-4-4-12. spec: v4 draws its bits from `random`; v1
// wants the clock and a MAC address (`os`), v3/v5 a hash (Encoding.ray): they
// are shaped here and filled when those are.

UUID := class {
  of (bits) => UUID(bits: bits)
  // The version nibble is the thirteenth digit; the variant the first bits of the ninth byte.
  version => (
    total ^keyword := zero
    walker ^keyword := .bits.at((four * ten) + eight)
    left ^keyword := four
    while left.nonzero {
      total = total + total
      if walker.value { total = total.succ }
      walker = walker.next
      left = left.pred
    }
    total
  )
  Variant := enum reserved_ncs | rfc_4122 | reserved_microsoft | reserved_future
  variant => (
    first := .bits.at((six * ten) + four)
    if first.value.not { UUID.Variant.reserved_ncs }
    elsif first.next.value.not { UUID.Variant.rfc_4122 }
    elsif first.next.next.value.not { UUID.Variant.reserved_microsoft }
    else { UUID.Variant.reserved_future }
  )

  // v4: 48 random bits, the version 0100, 12 random bits, the variant 10, and
  // 62 random bits.
  v4 => (
    bits := chain None
    UUID.draw(bits, (four * ten) + eight)
    bits &= false
    bits &= true
    bits &= false
    bits &= false
    UUID.draw(bits, ten + two)
    bits &= true
    bits &= false
    UUID.draw(bits, (six * ten) + two)
    UUID(bits: bits)
  )
  draw (bits, count: Number) => (
    left ^keyword := count
    while left.nonzero {
      bits &= (external random).holds
      left = left.pred
    }
    bits
  )
  // spec: v1 = 60-bit timestamp since 1582-10-15 in 100ns steps, clock
  // sequence, MAC node; v3 = md5(namespace, name), v5 = sha1(namespace, name).
  v1 => None
  v3 (namespace, name: String) => None
  v5 (namespace, name: String) => None

  // As text: each nibble a hexadecimal digit, in groups of 8, 4, 4, 4 and 12.
  as_string => (
    out := chain None
    walker ^keyword := .bits.head
    groups := chain None
    groups &= eight
    groups &= four
    groups &= four
    groups &= four
    groups &= ten + two
    groups for {
      unless (it.value == eight) { out &= Character.of(ascii_dash) }
      digits ^keyword := it.value
      while digits.nonzero {
        nibble ^keyword := zero
        bit ^keyword := four
        while bit.nonzero {
          nibble = nibble + nibble
          if walker.value { nibble = nibble.succ }
          walker = walker.next
          bit = bit.pred
        }
        out &= Character.decimal_digit(nibble)
        digits = digits.pred
      }
    }
    String(characters: out)
  )
  == (other: UUID) => .as_string == other.as_string

  Namespace := class {
    dns => String.of(`6ba7b810-9dad-11d1-80b4-00c04fd430c8`)
    url => String.of(`6ba7b811-9dad-11d1-80b4-00c04fd430c8`)
    oid => String.of(`6ba7b812-9dad-11d1-80b4-00c04fd430c8`)
    x500 => String.of(`6ba7b814-9dad-11d1-80b4-00c04fd430c8`)
  }
}
