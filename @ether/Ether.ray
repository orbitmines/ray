reservable_names := String.NonEmpty{length < 2^8}{every != "\n" | "\t"}

@ether = @`ether.orbitmines.com:37839`

@private => @me
@everyone => characters
@here => characters{is Online}
@local => @me.presence ?? Instance.local
@anonymous => ?

@public => @ether.@everyone | Instance
@npc = @npcs => @public{is NPC}
@players => @public{is Player}

@host => Instance.local.parent**#
@guests => Instance.local.children**#
@guests.read { @host }
@host.read { @guests }

local => @local
private => @private
public => @public
// Whatever the policy, `confidential` is never wider than `@private.managed` (W5.5).
confidential => Node.policy & @private.managed
Node.policy = local

Node &+= {
  public => visibility#.some(.reads && @public is .who)
  publish: static => this ~~ .access |= Access(public, method: Access.Reading, target: this)
}

@{instance: Instance} ^string => instance.canonical
{prefix: "@" | "#"}{id: UUID} ^string => children**{.PREFIX == prefix & id is .name}.first
