// Texts: what the language's own levels ask of a text (`level cw_…`: trimmed, inside its brackets, enclosed, a span), and
// what reading one asks too (its words, where a quote or a bracket closes); what the back end's compiler asks besides is
// its own (`$/Wasm.project.ray`'s `Writing`).
Texts := class {
  static trimmed_text (from, to) => {
    a := from
    e := to
    while (a < e) && white(byte(a)) {
      a = a + 1
    }
    while (e > a) && white(byte(e - 1)) {
      e = e - 1
    }
    text(a, e)
  }
  static at_text (q, e, a, z) => ((q + (z - a)) > e) ? 0 : texteq(q, a, z - a)
  static word_byte (c) => ((c >= 97) && (c <= 122)) || ((c >= 65) && (c <= 90)) || ((c >= 48) && (c <= 57)) || (c == 95)
  static cw_trimmed (t: Text) => (t is Text) ? Texts.trimmed_text(t.from, t.to) : t
  static cw_inner (t: Text) => ((t is Text) && ((t.to - t.from) >= 2)) ? text(t.from + 1, t.to - 1) : None
  static cw_span_of (t: Text, x: Text) => ((t is Text) && (x is Text)) ? text(t.from, x.to) : None
  // (whether a text, trimmed, is one bracket's: opened at its start, closed only at its end, what is quoted passed over)
  static cw_enclosed (t: Text) => Texts.enclosed_in(Texts.trimmed_text(t.from, t.to))
  static enclosed_in (u: Text) => (((u.to - u.from) >= 2) && (opener(byte(u.from)) != 0) && Texts.closed_last(u.from, u.to)) ? true : false
  static closed_last (a, e) => {
    d := 0
    q := a
    while q < e {
      d = d + Texts.depth_change(byte(q))
      return 0 if (closer(byte(q)) != 0) && (d == 0) && ((q + 1) < e)
      q = Texts.quote_byte(byte(q)) ? Texts.quote_skipped(q + 1, e, byte(q)) : q
      q = q + 1
    }
    closer(byte(e - 1)) != 0
  }
  static depth_change (c) => (opener(c) != 0) ? 1 : ((closer(c) != 0) ? (0 - 1) : 0)
  static quote_byte (c) => (c == 34) || (c == 96)
  static quote_skipped (from, e, c) => {
    q := from
    while (q < e) && (byte(q) != c) {
      q = ((byte(q) == 92) && (c == 34)) ? (q + 2) : (q + 1)
    }
    q
  }
  static same_text (x: Text, t: Text) => (x is Text) && ((x.to - x.from) == (t.to - t.from)) && texteq(x.from, t.from, t.to - t.from)
  static count_of (l: List) => l.count
}
// Splices (`level spliced …`): a capture, `open close` (what opens, a space, what closes), in a text: what is between an
// open and a close (or a doubled open and a doubled close) is a name, taken from a list of entries (each a key and a
// value, `take_named`: the value, trimmed, itself a capture of a name taken further on, that), and written in its place.
Splices := class {
  static opening_end_at (from, to) => {
    oe := from
    while (oe < to) && (byte(oe) != 32) {
      oe = oe + 1
    }
    oe
  }
  static found_from (from, e, a, z) => {
    q := from
    while (q < e) && (at_text(q, e, a, z) == 0) {
      q = q + 1
    }
    q
  }
  static names (x, na, ne) => (x is Node) && Splices.key_is(member(x, Symbol.key), member(x, Symbol.value), na, ne)
  static key_is (k: Text, v: Text, na, ne) => (k is Text) && (v is Text) && ((k.to - k.from) == (ne - na)) && texteq(k.from, na, ne - na)
  // (whether a text holds a part, anywhere; or outside any bracket or quote in it, on its statement's lines)
  static holds_text (t: Text, part: Text) => ((t is Text) && (part is Text) && (part.to != part.from) && (Indexes.found_at(part, t.from, t.to) != 0)) ? true : false
  static holds_outside_in (t: Text, part: Text) => ((t is Text) && (part is Text) && (part.to != part.from)) ? Splices.outside_in(t.from, t.to, part) : false
  static outside_in (a, e, part: Text) => {
    q := a
    while q < e {
      return false if ((Runtime.class_at(q) == 2) && (pair_end(q) == 0)) || ((Runtime.class_at(q) != 2) && (byte(q) == 10) && (continued_at(q) == 0))
      return true if (Runtime.class_at(q) != 2) && (at_text(q, e, part.from, part.to) != 0)
      return false if (Runtime.class_at(q) == 1) && ((pair_end(q) == 0) || (pair_end(q) > e))
      q = ((Runtime.class_at(q) == 1) || (Runtime.class_at(q) == 2)) ? pair_end(q) : (q + 1)
    }
    false
  }
  // (what separates the captures in a text: from the end of the first close to the next open, trimmed)
  static separator_of (t: Text, cap: Text) => ((t is Text) && (cap is Text)) ? Splices.separator_in(t, cap.from, Splices.opening_end_at(cap.from, cap.to), cap.to) : None
  static separator_in (t: Text, oa, oe, ce) => Splices.separator_from(t, Splices.found_from(t.from, t.to, oe + 1, ce), oa, oe, ce)
  static separator_from (t: Text, q, oa, oe, ce) => (q >= t.to) ? None : Texts.trimmed_text(q + (ce - (oe + 1)), Splices.found_from(q + (ce - (oe + 1)), t.to, oa, oe))
