Entity := class

Nameable := class {
  static PREFIX: String?
  name: String?

  named (name: String): static => this ~~ .name = name
}

Location := class: Hierarchy {
  host: *?
}

World := class: Location + Nameable {
  static PREFIX = "#"
  static ether = World(name: "ether", host: @ether)

  worlds: World[] = []
  characters: Character[] = []
  items: Item[] = []
  quests: Quest[] = []
  dynamics: Dynamics[] = []

  spawn (character: Character) => characters.push character -- character
  add (item: Item) => items.push item -- item
  post (quest: Quest) => quests.push quest -- quest
  population => characters.count

  within_worlds: World[] => (worlds, children{==.instance_of World}).flat_map((., .within_worlds))
  within_characters: Character[] => characters, within_worlds.flat_map(.characters)

  shadowing: World?
  static Name := class = name: String, value: *?
  names: Name[] = []

  define (name: String, value) => names.push(Name(name, value)) -- value
  unset (name: String) => define(name, None)
  lookup (name: String) => {
    return defined.value if defined = names{.name == name}.last
    (shadowing ?? parent ?? (World.ether if this !== World.ether))?.lookup(name)
  }

  // `#name` / `@name` per Nameable class, its plural as a collection, falling back to @ether (L§10.7).
  class{>.instance_of Nameable}#.for class => {
    `class.name.plural`: class[] => (this, within_worlds){class == Character || class == World ? .`class.name.plural` : .children{==.instance_of class}}.flatten
      -- .unique(.name.ignore_case if .name ==.instance_of String)
    {class.PREFIX}{name: reservable_names} => this[class.name.plural]{.name.ignore_case == name.ignore_case}.first
      ?? (shadowing ?? World.ether)[class.PREFIX, name] if class.PREFIX
  }
  class{>.instance_of Character}#.for class => {
    `class.name.plural`: class[] => characters{==.instance_of class}
  }

  static Reservation := class = name: reservable_names, issuer: World, holder: *?
  reservations: Reservation[] = []

  reserved (name: String) => reservations{.name.fold_case == name.fold_case}.first
  issue (name: reservable_names) => Reservation(name, issuer: this) ~~ reservations.push(.)
  reserve (name: reservable_names) => reserved(name) ?? issue(name)
  allocate (name: reservable_names, holder) => reserve(name) ~~ .holder = holder
  allocated (name: String) => reserved(name)?.holder

  + (dynamic: Dynamics): static => this ~~ dynamics.push dynamic
  tick: static => this ~~ dynamics#.step(this)
}
Region := World

Dynamics := class {
  step (world: World) => world
}

Quest := class: Nameable {
  goal: *
  from: *?
  verifier: ((value: *): boolean)?
  steps: *[] = []
  done = false
  best: *?
  path: *[] = []
  solved_by: Character?

  reached (value) => verifier ? verifier(value) : value ==.instance_of goal
  attempt (value, character: Character): static => {
    path.push value
    return this unless reached(value)
    best = value
    solved_by = character
    complete
  }

  step (description): static => this ~~ steps.push description
  refined => steps.every(==.instance_of Quest)
  progress => steps{==.instance_of Quest && .completed}.count
  difficulty => steps.count

  complete: static => this ~~ .done = true
  completed => done
}

Task := class: Quest {
  interrupted = false

  interrupt: static => this ~~ .interrupted = true
}

Item := class {
  name: String
  issuer: World
  location: Location?
  obtained_by: Quest?
  certificate: Certificate?

  move (location: Location): static => this ~~ .location = location
  certify (certificate: Certificate): static => this ~~ .certificate = certificate
}

Certificate := class = issuer: World, secret: *, issued_on: Time = Time.now

History := class = repository: *?, commits: Commit[] = [], from: History? {
  static Commit := class = who: *, what: *, id: UUID = UUID.v4(), when: Time = Time.now, visibility: Accessor.Permission = Accessor.Permission.private, inverse: *? {
    staged => visibility == Accessor.Permission.private
    publish: static => this ~~ .visibility = Accessor.Permission.public
  }
  static Branch := class: History
  static Assignment := class = value: *, history: History?, previous: Commit?

  count => commits.count
  latest => commits.last

  commit (who, what): static => this ~~ commits.push Commit(who, what)
  stage (who, what) => commit(who, what)
  published => commits{!.staged}
  publish: static => this ~~ commits#.publish

  fork => Branch(repository, from: this)
  squash (who) => History(repository, from: from).commit(who, commits.what)
  cherry_pick (change: Commit): static => this ~~ commits.push Commit(change.who, change.what, inverse: change.inverse)
  from_here (change: Commit) => commits[..commits.index_of(change) + 1].reduce(History(repository)) (kept, each) => kept.cherry_pick(each)
  revert (change: Commit) => change.inverse ? commit(change.who, change.inverse) : Quest(name: "revert", goal: change)

  merge (other: History) => other.commits.flat_map(theirs => {
    conflicts = commits{.when == theirs.when && .what != theirs.what}.map(ours => Quest(name: "merge", goal: theirs))
    cherry_pick(theirs)
    conflicts
  })

  assigned (value, history: History) => Assignment(value, history, previous: latest)

  generics: String[] = []
  remember_generic (name: String): static => this ~~ generics.push name
  appears (name: String) => INFO@name `a variable is named like a generic type used silently before` if generics.contains(name)

  static clocks: HybridClock[] = []
  clock => History.clocks{node === repository}.first ?? (HybridClock(node: repository) ~~ History.clocks.push(.))

  operate (who, kind, definition, before, after) => Operation(kind, definition, clock.now, who, before, after) -- commit(who, .)
  define (who, definition, code) => operate(who, Operation.Kind.define, definition, None, code)
  change (who, definition, code) => operate(who, Operation.Kind.change, definition, code_of(definition), code)
  rename (who, definition, name: String) => operate(who, Operation.Kind.rename, definition, name_of(definition), name)
  remove (who, definition) => operate(who, Operation.Kind.remove, definition, code_of(definition), None)
  undo (operation: Operation) => commit(operation.who, operation.inverse)

  operations: Operation[] => commits.what{==.instance_of Operation}
  operations_on (definition: Definition) => operations{.definition == definition}
  ordered => operations.sorted(.stamp)

  latest_of (definition: Definition, kinds: Operation.Kind[]) => operations_on(definition){kinds.contains(.kind)}.max(.stamp)
  code_of (definition: Definition) => latest_of(definition, [define, change, remove])?.after
  name_of (definition: Definition) => latest_of(definition, [rename])?.after ?? definition.name
  definitions => operations.definition.unique
  named (name: String) => definitions{name_of(.) == name}.last

  received (stamp: Stamp) => clock.receive(stamp)
  view (filter) => History(repository, commits: commits{filter(.)}, from: this)

  as Git => Git(commits: commits.map(commit => Git.Commit(id: commit.id, author: commit.who, date: commit.when, message: commit.what.definition?.name ?? commit.what as String, change: commit.what)))
}

Repository := class = world: World, histories: History[] = []

Platform := class = name: String, prefix: String, icon: *? {
  location_of (handle: String) => prefix + handle
  avatar (handle: String, character: Character) => Avatar(character, platform: this, handle, location: location_of(handle))
}

Reference := class {
  title: String
  subtitle: String?
  date: Time = Time.now
  draft = true
  organizations: Organization[] = []
  authors: Character[] = []
  published: *[] = []
  year: *?
  link: *?
  pointer: *?
  remote: *?
  external: *?
  journal: *?
  volume: *?
  pages: *?
  doi: *?
  publisher: *?

  static Note := class = text: String, date: Time = Time.now
  notes: Note[] = []

  publish: static => this ~~ .draft = false
  note (text: String): static => this ~~ notes.push Note(text)
}

Instance := class: Location {
  location: *
  status: Status = Status.online
  key: *?
  registry: Character[] = []
  hosted: Character[] = []
  deletions: Deletion[] = []

  == (other) => key ? key == other.key : this === other

  login (character: Character) => registry.push character -- character
  logged_in (character: Character) => registry.contains(character)
  logout (character: Character, delete_all = false) => {
    registry = registry{!== character}
    if delete_all {
      character.key = None
      deletions.push Deletion(character, due: Time.now + 30 days)
    }
    character
  }
  swap (from: Character, to: Character) => {
    logout(from)
    login(to)
  }
  spawn (character: Character) => login(character)

  host_for (character: Character) => character ~~ hosted.push(.) ~~ .presence = this
  mirror (value, depth = 1) => Mirror(value, location: this, depth)

  static Deletion := class: Quest (character: Character, due: Time) {
    name = "delete"
    goal => character
    cancelled = false

    cancel: static => this ~~ .cancelled = true
    pending => !cancelled && !completed
  }

  static Mirror := class = value: *, location: Instance, depth = 1 {
    synced => location.registry.nonempty
  }
}

Status := enum online | offline | hosted | broadcast | proxy | invisible | idle | do_not_disturb | busy

Character := class: Entity + Nameable {
  static PREFIX = "@"

  avatars: Avatar[] = []
  presence: Instance?
  status: Status = Status.offline
  statuses: Status[] = []
  permissions: Accessor.Permission[] = []
  key: *?

  first_name: String?
  last_name: String?
  email: String?
  profile_picture: *?
  profile: *?

  full_name => first_name ? first_name + " " + last_name : name
  status_now => presence?.status ?? status
  also (status: Status): static => this ~~ statuses.push status
  is (status: Status) => this.status == status || statuses.contains(status)

  == (other) => key ? key == other.key : this === other

  choose (kind) => Quest(name: "choose", goal: kind, solved_by: this)
  embody (avatar: Avatar) => avatars.push avatar -- avatar

  read => Access(this)
  write => on(`=`)
  execute => on(`()`)
  on (method) => Access(this, method)
}

Avatar := class: Character {
  character: Character
  platform: Platform?
  location: *?
  handle: String?
  skills: Skill[] = []
  traversed: Location[] = []

  unlock (skill: Skill): static => this ~~ skills.push skill
  visit (location: Location): static => this ~~ traversed.push location
  copied => Avatar(character, platform)
  + (other: Avatar): static => this ~~ (
    .skills = skills, other.skills{!skills.contains(.)}
    .traversed = traversed, other.traversed
  )
  rewarded (solution: Skill.Solution) => solution.used
}

Player := class: Character

NPC := class: Character {
  static Mode := enum until_resolved | waiting | stopping

  status = Status.hosted
  mode: Mode = Mode.until_resolved
  quests: Quest[] = []

  take (quest: Quest): static => this ~~ quests.push quest
  open_quests => quests{!.completed}
  running => mode == Mode.waiting || mode == Mode.until_resolved && open_quests.nonempty
  failed (error) => take(Quest(name: "fix", goal: error))
}

Organization := class: Player {
  logo: *?
  website: *?
  members: Character[] = []
}
