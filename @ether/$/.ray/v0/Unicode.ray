// Unicode (draft: .ray2/Language/String/Unicode.ray). A codepoint is a
// number; a scalar is a codepoint that is not a surrogate and fits the space;
// a transformation format is how a codepoint is written as code units, and
// reading one back is reading the codepoints it writes.
// spec: the tables of unicode.org (blocks, general categories, case folding,
// bidi mirroring, ages) are read through `io` only when asked for, and are not
// yet parsed into scalars.

Unicode := class {
  // Scalar: `dynamically assert this < 0x110000 && !(0xD800 <= this <= 0xDFFF)`,
  // as a question rather than a refusal.
  scalar (codepoint: Number) => (codepoint < 1114112).and(Unicode.surrogate(codepoint).not)
  surrogate (codepoint: Number) => (55295 < codepoint).and(codepoint < 57344)
  // Whether a number is written in so many bits.
  fits (codepoint: Number, width: Number) => codepoint < (2).pow(width)
  surrogate_first => 55296

  // spec: the draft's GeneralCategory, decided for the Latin range from the
  // character classes; the PropertyValueAliases table would refine it.
  GeneralCategory := enum letter | number | punctuation | symbol | separator | other
  category (character: Character) => (
    if character.letter { Unicode.GeneralCategory.letter }
    elsif character.digit { Unicode.GeneralCategory.number }
    elsif character.blank { Unicode.GeneralCategory.separator }
    elsif (character < 32) { Unicode.GeneralCategory.other }
    elsif character.is_ascii { Unicode.GeneralCategory.punctuation }
    else { Unicode.GeneralCategory.symbol }
  )

  // class TF | TransformationFormat < CodeUnit[]{length == 32 / CodeUnit.length}
  //   class CodeUnit < Binary{length == (static.name ~= Decimal.String⊣)}
  //   as (=== CodePoint[]): CodePoint[]
  // https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/#G25549
  TF := class: Array { }

  // class UTF-8 < TF, sequence: (
  //   prefix: 1[]{length == 0..4},
  //   U0: Binary{length == 8 - prefix.length}{⊢0},
  //   (10₂, U1: Binary⁶) if prefix ⊢11₂
  //   (10₂, U2: Binary⁶) if prefix ⊢111₂
  //   (10₂, U3: Binary⁶) if prefix ⊢1111₂
  // )[]
  //   as (=== CodePoint[]) => sequence.map(.U0, .U1, .U2, .U3)
  // https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/#G27288
  UTF8 := class: Unicode.TF {
    // as (=== CodePoint[]): what is written, read as the codepoints it spells.
    as_code_points => code_points(this)
    encode (codepoint: Number) => (
      units := chain None
      if (codepoint < 128) { units &= codepoint }
      elsif (codepoint < 2048) {
        units &= 192 + (codepoint / 64)
        units &= 128 + (codepoint % 64)
      } elsif (codepoint < 65536) {
        units &= 224 + (codepoint / 4096)
        units &= 128 + ((codepoint / 64) % 64)
        units &= 128 + (codepoint % 64)
      } else {
        units &= 240 + (codepoint / 262144)
        units &= 128 + ((codepoint / 4096) % 64)
        units &= 128 + ((codepoint / 64) % 64)
        units &= 128 + (codepoint % 64)
      }
      written := chain None
      units for { bits_of(it.value, 8) for { written &= it.value } }
      written
    )
    decode (bits) => code_points(bits).head.value
  }

  // class UTF-16 < TF, sequence: (prefix: 110110₂?, U0: Binary⁴, U1: Binary{length == 12 - prefix.length}, (110111₂, U2: Binary¹⁰) if prefix)[]
  //   as (=== CodePoint[]) => sequence.map(.U0 + 1, .U1, .U0)
  // https://www.unicode.org/versions/Unicode17.0.0/core-spec/chapter-3/#G27792
  UTF16 := class: Unicode.TF {
    unit => 65536
    encode (codepoint: Number) => if (Unicode.fits(codepoint, 16)) { bits_of(codepoint, 16) } else {
      shifted := codepoint - .unit
      pair := bits_of(surrogate_first + (shifted / 1024), 16)
      bits_of(surrogate_first + 1024 + (shifted % 1024), 16) for { pair &= it.value }
      pair
    }
    decode (bits) => (
      high := number_of(bits.slice_bits(0, 16))
      if (Unicode.surrogate(high)) {
        low := number_of(bits.slice_bits(16, 32))
        this.unit + ((high - surrogate_first) * 1024) + (low - (surrogate_first + 1024))
      } else { high }
    )
  }
  // class UTF-32 < TF, CodeUnit{⊢(0[]⁸)}[]
  UTF32 := class: Unicode.TF {
    encode (codepoint: Number) => bits_of(codepoint, 32)
    decode (bits) => number_of(bits)
  }

  // spec: the tables, fetched when read. Their location is the draft's.
  tables_at => "https://www.unicode.org/Public/UCD/latest/ucd/"
  table (name) => external io (.tables_at + name).bits
}

// The codepoints UTF-8 spells, read a bit at a time as the draft's sequence
// is written: the ones of the prefix, the zero that ends it, the payload U0,
// and for each one after the first a byte `10` and its six bits U1.. — the
// codepoint is the payloads one after another. What is read is a literal's
// bytes, or a chain of bits.
code_points (source) => (
  points := chain None
  point := 0
  ones := 0
  counting := true
  leading := true
  skip := 0
  position := 0
  following := 0
  take (b) => (
    bit := inline b
    if counting {
      if bit { ones = ones.succ } else { counting = false }
    } elsif skip.nonzero { skip = skip.pred } else {
      point = point + point
      if bit { point = point.succ }
    }
    position = position.succ
    if (position == 8) {
      position = 0
      if leading {
        following = if ones.is_zero { 0 } else { ones.pred }
      } else { following = following.pred }
      if following.is_zero {
        points &= point
        point = 0
        ones = 0
        counting = true
        leading = true
      } else {
        leading = false
        counting = false
        skip = 2
      }
    }
    points
  )
  if (exists source.head) { source for { take(it.value) } } else { external bits source take }
  points
)

// class CodePoint < Hexadecimal{length == 1..6}
Unicode.CodePoint = Hexadecimal{. < 16777216}
// class Scalar < CodePoint
Unicode.Scalar = Unicode.CodePoint{Unicode.scalar(this)}

// U+{codepoint: CodePoint.String}: Scalar => codepoint
// https://www.unicode.org/versions/Unicode17.0.0/core-spec/appendix-a/#G7083
// spec: a hexadecimal number spelled after `U+`, read as the character it is.
U+{codepoint: Hexadecimal ^number} ^number => codepoint.as_character

// The bits between two positions of a chain of bits, counted from zero.
Chain.components.hierarchy &= class {
  slice_bits (from, to) => (
    out := chain None
    walker ^keyword := .at(from)
    left ^keyword := to - from
    while (left.nonzero.and(exists walker)) {
      out &= walker.value
      walker = walker.next
      left = left.pred
    }
    out
  )
}

