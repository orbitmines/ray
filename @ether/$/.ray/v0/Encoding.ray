Encoding := class {
  Algorithm := enum sha1 | sha256 | sha512 | sha3 | md5 | blowfish | blake3 | base64 | gzip

  Encrypted := class {
    value: Node
    key: Node
    holds_key (location) => if (location == .key) { true } elsif (location === None) { false } elsif (location.key === None) { false } else { location.key == .key }
    as (location) => if (.key === None) { None } elsif (.holds_key(location)) { .value } else { None }
    opened (location) => if (.holds_key(location)) { .value } else { Quest(name: "find the key", goal: this) }
    read_off (location) => if (.holds_key(location)) { Encoding.Encrypted(value: .value, key: location.key) } else { None }
  }

  Hash := class {
    value: Node
    algorithm: Encoding.Algorithm
    chainable == (other: Encoding.Hash) => (.algorithm == other.algorithm).and(.value == other.value)
  }

  Compressed := class {
    value: Node
    algorithm: Encoding.Algorithm
    as (target) => .value
  }
}
