// `if` evaluates eagerly and inlines the branch it takes, so the chain is
// the value; a branch nobody takes stays None. `while` and `do` are the
// same class, instantiated differently.

mark ^keyword := external global

t := if true { true } else { false }
unless (t) { INFO@mark `if-true did not take the then branch` }

f := if false { true } else { false }
if (f) { INFO@mark `if-false took the then branch` }

e := if false { true } elsif true { true } else { false }
unless (e) { INFO@mark `elsif did not fire` }

g := if false { true } elsif false { true } else { true }
unless (g) { INFO@mark `else after elsif did not fire` }

h := if true { true } elsif true { false } else { false }
unless (h) { INFO@mark `a later branch overrode the first` }

n := if false { true }
if (n) { INFO@mark `a bare if with a false predicate is not None-like` }

u := unless false { true }
unless (u) { INFO@mark `unless did not fire` }

flag ^keyword := true
while flag { flag = false }
if (flag) { INFO@mark `while did not run its body` }

never ^keyword := false
ran ^keyword := false
while never { ran = true }
if (ran) { INFO@mark `while ran with a false predicate` }

seen ^keyword := false
do { seen = true } while false
unless (seen) { INFO@mark `do-while did not run its body at least once` }

stop ^keyword := true
do { stop = false } while stop
if (stop) { INFO@mark `do-while did not stop` }

nothing_taken := if false { one } else { None }
if (exists nothing_taken) { INFO@mark `an if whose taken branch is None is present` }
something_taken := if true { one } else { None }
unless (exists something_taken) { INFO@mark `an if whose taken branch is one is absent` }
