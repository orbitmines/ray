mark ^keyword := external global

unless "ab".length == 2 { INFO@mark `S1 ab has other than two characters` }
unless "ab"[0] == 97 { INFO@mark `S2 a is not codepoint 97` }
unless "ab"[1] == 98 { INFO@mark `S3 b is not codepoint 98` }
unless "a" == "a" { INFO@mark `S4 a != a` }
unless "a" != "b" { INFO@mark `S5 a == b` }
unless "a" + "b" == "ab" { INFO@mark `S6 a + b != ab` }
unless "é".length == 1 { INFO@mark `S7 é is not one character` }
unless ("é" as Unicode.UTF-8).bytes.length == 2 { INFO@mark `S8 é is not two bytes wide` }
unless "é"[0] == 233 { INFO@mark `S9 é is not codepoint 233` }

unless ("a" as Unicode.UTF-8 as Binary).length == 8 { INFO@mark `T1 a is not eight bits in UTF-8` }
unless "a" as Unicode.UTF-8 as Binary == ₂01100001 { INFO@mark `T2 a is not 01100001 in UTF-8` }
unless ₂01100001 as Unicode.UTF-8 as String == "a" { INFO@mark `T4 01100001 is not a in UTF-8` }
unless "a".length == 1 { INFO@mark `U5 a has other than one character` }

unless U+0061 == "a"[0] { INFO@mark `W1 U+0061 is not a` }
unless U+00E9 == "é"[0] { INFO@mark `W2 U+00E9 is not é` }
unless "ab".upper_case == "AB" { INFO@mark `W3 upper_case failed` }
unless "Ab".swap_case == "aB" { INFO@mark `W4 swap_case failed` }
unless "ab".mirrored == "ba" { INFO@mark `W5 mirrored failed` }
unless "abc".contains("bc") { INFO@mark `W6 contains failed` }
if "abc".contains("ca") { INFO@mark `W7 contains found ca in abc` }
unless "a b".words.length == 2 { INFO@mark `W8 words did not split in two` }
unless "a b".snake_case == "a_b" { INFO@mark `W9 snake_case failed` }
unless "ab cd".pascal_case == "AbCd" { INFO@mark `W10 pascal_case failed` }
unless "cat".plural == "cats" { INFO@mark `W11 plural failed` }
unless ("a" as Unicode.UTF-16 as Binary).length == 16 { INFO@mark `W12 UTF16 of a is not sixteen bits` }
unless "\n" as Unicode.UTF-32 as String == "\n" { INFO@mark `W13 UTF32 round trip failed` }
unless "a"[0] is Unicode.GeneralCategory.Letter { INFO@mark `W14 a is not a letter` }
unless "ab" ~= "b" { INFO@mark `W15 the pattern b did not match ab` }
unless 10 is Unicode.Scalar { INFO@mark `W17 ten is not a scalar` }

unless "ab1"{. is Char.Letter}.length == 2 { INFO@mark `S40 selecting letters did not keep two` }
unless "abc".length == 3 { INFO@mark `S41 a string of three does not count three` }
unless "f"[0] as Decimal == 15 { INFO@mark `S42 f is not the digit fifteen` }
unless "1a" is Hexadecimal.String { INFO@mark `S44 1a does not spell a hexadecimal number` }
if "1a" is Decimal.String { INFO@mark `S45 1a spells a decimal number` }
unless "a-b".split(U+002D).length == 2 { INFO@mark `S47 splitting on a dash does not give two parts` }

unless "ab cd".camel_case == "abCd" { INFO@mark `S48 camel_case is not the first word lower and the rest capitalised` }
unless "ab".title_case == "Ab" { INFO@mark `S49 title_case does not capitalise` }
unless "Ab".fold_case == "ab" { INFO@mark `S50 fold_case does not fold` }

unless "cats".singular == "cat" { INFO@mark `S51 the singular of cats is not cat` }
unless "cat".singular == "cat" { INFO@mark `S52 the singular of cat is not cat` }
unless "cats".plural == "cats" { INFO@mark `S53 the plural of cats is not cats` }

unless "abc".mirrored == "cba" { INFO@mark `S54 abc reversed is not cba` }
unless "a".mirrored == "a" { INFO@mark `S55 one character reversed is not itself` }
unless "abc"[..<2] == "ab" { INFO@mark `S56 the first two of abc are not ab` }
unless "abc"[1..] == "bc" { INFO@mark `S57 the last two of abc are not bc` }
unless "abc"[1..<1].empty { INFO@mark `S58 a slice of nothing is not empty` }

unless "abc".index_of("bc") == 1 { INFO@mark `S59 bc does not sit one along in abc` }
unless "abc".index_of("a") == 0 { INFO@mark `S60 a does not sit at the start of abc` }
unless "ab" + "c" == "abc" { INFO@mark `S61 ab and c do not make abc` }
unless "ab".starts_with("a") { INFO@mark `S62 ab does not start with a` }
if "ab".starts_with("b") { INFO@mark `S63 ab starts with b` }
unless "ab".ends_with("b") { INFO@mark `S64 ab does not end with b` }
unless "a b".words as String == "ab" { INFO@mark `S65 joining a and b with nothing between is not ab` }

unless ("a", "b", "c") as String == "abc" { INFO@mark `SJ1 joining a, b and c with nothing between is not abc` }
unless ("a", "b", "c").join("-") == "a-b-c" { INFO@mark `SJ2 joining a, b and c with a dash is not a-b-c` }
unless ("a", "b").join(", ") == "a, b" { INFO@mark `SJ3 joining a and b with a comma and space is not a, b` }
unless "a".words.join("-") == "a" { INFO@mark `SJ4 joining one element with a dash is not that element` }
unless "a b c".words as String == "abc" { INFO@mark `SJ5 joining the words of a b c is not abc` }
unless "a b c".words.join("_") == "a_b_c" { INFO@mark `SJ6 joining the words of a b c with an underscore is not a_b_c` }
unless "".words.join("-").empty { INFO@mark `SJ7 joining no words is not empty` }
unless "ABC" == ("A", "B", "C") { INFO@mark `SJ8 ABC is not A, B, C` }

unless "f" as 16 == 15 { INFO@mark `S66 f is not fifteen in sixteen` }
unless "12" as 10 == 12 { INFO@mark `S67 12 is not twelve in ten` }
unless 12 as 10 as String == "12" { INFO@mark `S68 twelve is not spelled 12 in ten` }
unless 5 as 2 as String == "101" { INFO@mark `S69 five is not spelled 101 in two` }
unless "ff" as 16 == 255 { INFO@mark `SN1 ff is not 255` }
unless 255 as 16 as String == "ff" { INFO@mark `SN2 255 is not spelled ff in sixteen` }
unless "101" as 2 == 5 { INFO@mark `SN3 101 is not five in two` }
unless "ff" as 16 as 16 as String == "ff" { INFO@mark `SN4 ff does not come back from sixteen` }

unless "ab".lines.length == 1 { INFO@mark `S70 a text without a newline is other than one line` }
unless "a\nb".lines.length == 2 { INFO@mark `ST1 a newline does not separate two lines` }

unless "8"[0] is Char.Digit { INFO@mark `S71 8 is not a digit` }
unless "9"[0] is Char.Digit { INFO@mark `S72 9 is not a digit` }
unless "0"[0] is Char.Digit { INFO@mark `S73 0 is not a digit` }
if ":"[0] is Char.Digit { INFO@mark `S74 a colon is a digit` }
if "a"[0] is Char.Digit { INFO@mark `S75 a is a digit` }
unless "89" is Decimal.String { INFO@mark `S77 89 does not spell a number in ten` }
unless "89" as Decimal == 89 { INFO@mark `S78 89 is not eighty-nine` }
unless "9"[0] as Decimal == 9 { INFO@mark `S79 9 is not worth nine` }

unless "a"[0].upper_case == "A"[0] { INFO@mark `S80 a in upper case is not A` }
unless "Z"[0].lower_case == "z"[0] { INFO@mark `S81 Z in lower case is not z` }
unless "a"[0].lower_case == "a"[0] { INFO@mark `S82 a already in lower case is not itself` }
unless "7"[0].upper_case == "7"[0] { INFO@mark `S83 a digit in upper case is not itself` }
unless "a"[0].swap_case == "A"[0] { INFO@mark `S84 a swapped is not A` }
unless "A"[0].swap_case == "a"[0] { INFO@mark `S85 A swapped is not a` }
unless "7"[0].swap_case == "7"[0] { INFO@mark `S86 a digit swapped is not itself` }

unless "q"[0] is Char.Letter { INFO@mark `S87 q is not a letter` }
unless "Q"[0] is Char.Letter { INFO@mark `S88 Q is not a letter` }
if "7"[0] is Char.Letter { INFO@mark `S89 a digit is a letter` }
if "_"[0] is Char.Letter { INFO@mark `S90 an underscore is a letter` }
unless "_"[0] is Char.Word { INFO@mark `S93 an underscore is not a word character` }
unless "7"[0] is Char.Word { INFO@mark `S94 a digit is not a word character` }
unless "q"[0] is Char.Word { INFO@mark `S95 a letter is not a word character` }
if " "[0] is Char.Word { INFO@mark `S96 a space is a word character` }
unless " "[0] is Char.Blank { INFO@mark `S97 a space is not blank` }
if "a"[0] is Char.Blank { INFO@mark `S98 a is blank` }
unless "\n"[0] is Char.Blank { INFO@mark `S99 a newline is not blank` }
unless "\t"[0] is Char.Blank { INFO@mark `S100 a tab is not blank` }
unless "-"[0] is Char.Symbol { INFO@mark `S101 a dash is not a symbol` }
if "a"[0] is Char.Symbol { INFO@mark `S102 a is a symbol` }
unless "a"[0].is_ascii { INFO@mark `S103 a is not one byte` }
if "é"[0].is_ascii { INFO@mark `S147 é is one byte` }

unless "abc".length == 3 { INFO@mark `S104 abc is not three long` }
unless "abc"[1] == "b"[0] { INFO@mark `S105 the second of abc is not b` }
unless "abcde"[1..<4] == "bcd" { INFO@mark `S106 abcde from one to four is not bcd` }
if "abc".empty { INFO@mark `S107 abc is empty` }
unless "".empty { INFO@mark `S108 nothing written is not empty` }
unless "abc" != "abd" { INFO@mark `S109 two different texts are the same` }
if "abc" != "abc" { INFO@mark `S110 a text is not itself` }

unless "abc".every(. is Char.Letter) { INFO@mark `S111 abc is not all letters` }
if "ab3".every(. is Char.Letter) { INFO@mark `S112 ab3 is all letters` }
unless "ab3".some(. is Char.Digit) { INFO@mark `S113 ab3 holds no digit` }
if "abc".some(. is Char.Digit) { INFO@mark `S114 abc holds a digit` }
unless "abc".map(.upper_case) as String == "ABC" { INFO@mark `S115 abc made upper is not ABC` }

unless "Ab".lowercase == "ab" { INFO@mark `S116 lowercase is not lower_case` }
unless "Ab".uppercase == "AB" { INFO@mark `S117 uppercase is not upper_case` }
unless "Ab".swapcase == "aB" { INFO@mark `S118 swapcase is not swap_case` }
unless "ab cd".titlecase == "Ab Cd" { INFO@mark `S119 titlecase is not title_case` }
unless "Ab".foldcase == "ab" { INFO@mark `S120 foldcase is not fold_case` }
unless "ab cd".camelCase == "abCd" { INFO@mark `S121 camelCase is not camel_case` }
unless "ab cd".PascalCase == "AbCd" { INFO@mark `S122 PascalCase is not pascal_case` }
unless "ab cd".snakecase == "ab_cd" { INFO@mark `S123 snakecase is not snake_case` }
unless "AB".is_upper { INFO@mark `SC1 AB is not upper case` }
unless "ab".is_lower { INFO@mark `SC2 ab is not lower case` }
if "a"[0].is_upper { INFO@mark `SC3 the character a is upper case` }
if "1"[0].is_lower { INFO@mark `SC4 the character 1 is lower case` }
unless "ß".fold_case == "ss" { INFO@mark `SC5 ß does not fold to ss` }
unless "Straße".fold_case == "strasse" { INFO@mark `SC6 Straße does not fold to strasse` }
unless "AbC".ignore_case == "aBc" { INFO@mark `SC7 ignoring case, AbC is not aBc` }
if "AbC" == "aBc" { INFO@mark `SC8 minding case, AbC is aBc` }
unless "é".upper_case == "É" { INFO@mark `SC9 é in upper case is not É` }

unless "a-b+c".split(Char.Symbol).length == 3 { INFO@mark `S124 a-b+c cut at its symbols is other than three pieces` }
unless "ab cd".words.length == 2 { INFO@mark `S125 ab cd is other than two words` }
unless "ab_cd".words.length == 2 { INFO@mark `S126 ab_cd is other than two words` }

unless "abcd" ~= "bc" { INFO@mark `S127 a pattern does not find what is written in the text` }
if "abd" ~= "bc" { INFO@mark `S128 a pattern finds what is not there` }
unless ("abcd" ~= "bc").index == 1 { INFO@mark `S129 what is found is not where it stands` }
unless "abcd".ignore_case ~= "BC" { INFO@mark `S132 a pattern ignoring case does not find the other case` }
if "abcd" ~= "BC" { INFO@mark `S133 a pattern minding case finds the other case` }

unless Char.digit(0) == "0"[0] { INFO@mark `S138 nothing is not written 0` }
unless Char.digit(7) == "7"[0] { INFO@mark `S139 seven is not written 7` }
unless Char.digit(11) == "b"[0] { INFO@mark `S140 eleven is not written b` }

unless 7 as String == "7" { INFO@mark `S141 seven does not spell 7` }
unless 12 as String == "12" { INFO@mark `S142 twelve does not spell 12` }
unless 0 as String == "0" { INFO@mark `S143 nothing does not spell 0` }

unless "\0"[0] == 0 { INFO@mark `S144 the null character is not nothing` }
unless "\r"[0] == 13 { INFO@mark `S145 the carriage return . is not thirteen` }
unless "a"[0] is Unicode.Scalar { INFO@mark `S146 a is not a scalar` }

unless "AB cd".words.lower_case.join(" ") == "ab cd" { INFO@mark `S152 the words lowered are not ab cd` }
unless "AB cd".title_case == "Ab Cd" { INFO@mark `S153 the words titled are not Ab Cd` }

unless "ab cd".camelcase == "abCd" { INFO@mark `S154 camelcase is not camel_case` }
unless "ab cd".pascalcase == "AbCd" { INFO@mark `S155 pascalcase is not pascal_case` }

unless `ab` as String == "ab" { INFO@mark `S158 written text is not read as a string` }

unless "  a b ".trimmed == "a b" { INFO@mark `ST2 trimmed does not drop the blanks around a b` }
unless "\t a\n".trimmed == "a" { INFO@mark `ST3 trimmed does not drop a tab and a newline` }
unless "xxaxx".trimmed("x") == "a" { INFO@mark `ST4 xxaxx trimmed of x is not a` }
unless "a b".trimmed == "a b" { INFO@mark `ST5 trimmed drops a blank between` }
unless "a=b".before("=") == "a" { INFO@mark `ST6 before = in a=b is not a` }
unless "a=b".after("=") == "b" { INFO@mark `ST7 after = in a=b is not b` }
unless "ab".before("=") == "ab" { INFO@mark `ST8 before what is not there is not the whole text` }
unless "ab".after("=").empty { INFO@mark `ST9 after what is not there is not nothing` }
unless "a,b,c".split(",")[1] == "b" { INFO@mark `ST10 the second of a,b,c is not b` }
unless "  x".indentation == 2 { INFO@mark `ST11 two spaces are not an indentation of two` }
unless "  a\n    b".dedented == "a\n  b" { INFO@mark `ST12 dedenting does not keep only the difference` }
unless "a\n  b".dedented == "a\n  b" { INFO@mark `ST13 a text already at no indentation changed` }

unless "AB" == "AB" { INFO@mark `DQ1 "AB" is not the string AB` }
unless "A"[0] == U+0041 { INFO@mark `DQ2 the character of "A" is not A` }
unless "A".length == 1 { INFO@mark `DQ3 "A" is not a string of one` }
unless "hello world".length == 11 { INFO@mark `DQ4 "hello world" does not hold eleven characters` }

block_text := "
    one
      two
    three
"
unless block_text.lines.length == 3 { INFO@mark `SM1 a block of three lines with a blank first and last is not three lines` }
unless block_text.lines[0] == "one" { INFO@mark `SM2 the least-indented line of a block keeps no indentation` }
unless block_text.lines[1] == "  two" { INFO@mark `SM3 a line indented further keeps the difference` }
unless block_text.lines[-1] == "three" { INFO@mark `SM4 the last line of a block is not three` }

started_text := "a
    b"
unless started_text.lines[-1] == "    b" { INFO@mark `SM5 a line with content on the opening line holds the least indentation at nothing` }

unless "  x" == "  x" { INFO@mark `SM6 a text on one line lost its indentation` }

gapped_text := "
  a

  b
"
unless gapped_text.lines.length == 3 { INFO@mark `SM7 a blank line between two is not kept` }
unless gapped_text.lines[1].empty { INFO@mark `SM8 the blank line between two is not empty` }

doubled_gap := "

  a
"
unless doubled_gap.lines.length == 2 { INFO@mark `SM9 only one blank line after the opening quote is dropped` }
unless doubled_gap.lines[0].empty { INFO@mark `SM10 the second blank line after the opening quote is not kept` }
unless doubled_gap.lines[-1] == "a" { INFO@mark `SM11 the line after the blank lines keeps its indentation` }

unless "a\tb".length == 3 { INFO@mark `SE1 a tab escape is not one character` }
unless "a\tb"[1] == U+0009 { INFO@mark `SE2 a tab escape is not a tab` }
unless "\x41" == "A" { INFO@mark `SE3 a hexadecimal escape is not its character` }
unless "\u00E9"[0] == U+00E9 { INFO@mark `SE4 a four-digit escape is not its character` }
unless "\u{E9}"[0] == U+00E9 { INFO@mark `SE15 an escape of two digits in braces is not its character` }
unless "\q".length == 2 { INFO@mark `SE16 an unknown escape is not kept as written` }
unless U+0041 == "A" as Char { INFO@mark `SE17 U+0041 is not the character A` }
unless "a\\b".length == 3 { INFO@mark `SE5 an escaped backslash is not one character` }
unless "\U01F600"[0] == U+1F600 { INFO@mark `SE6 a six-digit escape is not its character` }
unless "\""[0] == U+0022 { INFO@mark `SE7 an escaped quote is not a quote` }
unless "\n"[0] == U+000A { INFO@mark `SE8 a newline escape is not a newline` }
unless " "[0] is \s { INFO@mark `SE9 a space is not a space escape` }
if "a"[0] is \s { INFO@mark `SE10 a is a space escape` }
unless "7"[0] is \d { INFO@mark `SE11 7 is not a digit escape` }
unless "a"[0] is \D { INFO@mark `SE12 a is not a non-digit escape` }
unless "_"[0] is \w { INFO@mark `SE13 an underscore is not a word escape` }
unless "-"[0] is \W { INFO@mark `SE14 a dash is not a non-word escape` }

// Interpolation, language-tagged literals and patterns (L§10.1, P7.1, U9)
greeted := "Ada"
unless "Hello {greeted}!" == "Hello Ada!" { INFO@mark `SI1 a name in braces is not read into the string` }
unless "{1 + 2}" == "3" { INFO@mark `SI2 an expression in braces is not read into the string` }
unless "a \{b}".count == 5 { INFO@mark `SI3 an escaped brace is read as an expression` }
unless @ray`1 + 2` == 3 { INFO@mark `TL1 a literal tagged ray is not read as Ray` }
unless "goto x" ~= ⊢"goto " { INFO@mark `PM1 ⊢ does not hold a pattern to the start` }
if "a goto" ~= ⊢"goto" { INFO@mark `PM2 ⊢ reads a pattern away from the start` }
unless "x\\" ~= "\\" ⊣ { INFO@mark `PM3 ⊣ does not hold a pattern to the end` }
unless ("abcabc" ~= "ca").index == 2 { INFO@mark `PM4 a reading does not say where it starts` }
unless "abc" !~= "z" { INFO@mark `PM5 !~= does not hold when nothing is read` }

// Case and scripts from the Unicode data (X3.10)
unless "Straße".upper_case == "STRASSE" { INFO@mark `UD1 sharp s does not upper-case to SS` }
unless U+01C6.title_case == U+01C5 { INFO@mark `UD2 dž does not title-case to Dž` }
unless "ǆemal".title_case == "ǅemal" { INFO@mark `UD3 a word does not start with its title case` }
unless "x²".baseline == "x2" { INFO@mark `UD4 a superscript does not come down to its digit` }
unless "H₂O".baseline == "H2O" { INFO@mark `UD5 a subscript does not come up to its digit` }
unless "2".superscript == "²" { INFO@mark `UD6 two has no superscript` }
unless "2".subscript == "₂" { INFO@mark `UD7 two has no subscript` }

// Confusable names compare by their UTS #39 skeleton.
unless "\u00E9".nfd == "e\u0301" { INFO@mark `SKL4 a precomposed letter does not decompose to its base and mark` }
unless "dаwn".confusable("dawn") { INFO@mark `SKL1 a Cyrillic a is not confusable with a Latin a` }
unless "dаwn".mixed_script { INFO@mark `SKL2 Latin with a Cyrillic letter is not mixed-script` }
if "dawn".mixed_script { INFO@mark `SKL3 a Latin name is mixed-script` }
