    | load8_u (code: 0x31, takes: MemArg{align = 0}) | load16_s (code: 0x32, takes: MemArg{align = 1})
    | load16_u (code: 0x33, takes: MemArg{align = 1}) | load32_s (code: 0x34, takes: MemArg) | load32_u (code: 0x35, takes: MemArg)
