// (instructions with no end asked of them: a function's own, read from where it starts to where the next one does)
X86.Code := class (instructions: X86.Instruction[]) {
  static from (bytes) => X86.Code.bits_read(bytes.map((byte) => byte.binary(8).reversed).join(""))
