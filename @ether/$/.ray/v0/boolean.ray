boolean := enum false (holds: None) | true (holds: global) {
  nand (b) => (
    goto second if .holds
    return true
   second\
    goto no if b.holds
    return true
   no\

    return false
  )

  not => .nand(this)

  and (b) => .nand(b).not
  or (b) => .not.nand(b.not)
  nor (b) => .or(b).not
  xor (b) => .or(b).and(.nand(b))
  xnor (b) => .xor(b).not

  ! => .not

  & (b) => .and(b)
  && (b) => .and(b)
  || (b) => .or(b)
  !&& (b) => .nand(b)
  !|| (b) => .nor(b)
  x|| (b) => .xor(b)
  x!|| (b) => .xnor(b)
}

!{x} ^punctuation => (x).not

true := boolean.true
false := boolean.false

