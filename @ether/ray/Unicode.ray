Unicode := class {
  static version: Version = %17
  assert Unicode.version == 17  // UN40 the Unicode version is not seventeen
  static spelled => "{version.number}.{version.revision ?? 0}"
  static Public := @https://www.unicode.org/Public
  // one directory per version: `<version>/ucd/` from 4.1.0, `<version>-Update/` with versioned file names before it (https://www.unicode.org/Public/, https://www.unicode.org/reports/tr44/)
  static UCD => version >= %4'1 ? Public / "{spelled}.0" / "ucd" : Public / "{spelled}-Update"
  assert (Unicode.UCD as String).starts_with("https://www.unicode.org/Public/")  // UN36 the tables are not read from unicode.org
  // The Unicode version is selectable; its tables follow it (X3.2)
  assert (Unicode.UCD as String) ~= "17.0.0"  // UV1 the tables are not those of version seventeen
  assert {
    Unicode.version = %3'2
    assert (Unicode.UCD as String) ~= "3.2-Update"  // UV5 an old version is not read from its update directory
    assert (Unicode.file("Blocks") as String).ends_with("Blocks-3.2.0.txt")  // UV6 an old table is not named with its version
    assert !(U+1F600.assigned)  // UV7 an emoji from 6.1 is assigned in 3.2
    Unicode.version = %17
  }
  static file (name: String) => version >= %4'1 ? UCD / "{name}.txt" : UCD / "{name}-{spelled}.0.txt"
  assert (Unicode.file("Blocks") as String).ends_with("/ucd/Blocks.txt")  // UV2 a table of a current version is not in its ucd directory

  static Table := class (Row, (("#", *) | (row: Row, (" "[], "#", *)?) | "")[].join("\n")) => {
    rows => this.row{!= None}
    [codepoint: Scalar] => rows{.range.in(codepoint)}.first
  }
  static Range := class (from: Scalar, ("..", to: Scalar)?) => {
    in (codepoint: Scalar) => from <= codepoint <= to ?? from
  }

  static CodePoint := class: Hexadecimal{length == 1..6}
  assert "0061" is Unicode.CodePoint  // UN2 0061 is not a code point
  assert !("1234567" is Unicode.CodePoint)  // UN4 seven hexadecimal digits are a code point
  static Scalar := class: CodePoint {
    dynamically assert this < 0x110000 && !(0xD800 <= this <= 0xDFFF)

    category => GeneralCategory.rows{Data[this].general_category ~= ⊢.short_name}.first
  }
  assert 10 is Unicode.Scalar  // W17 ten is not a scalar
  assert "a"[0] is Unicode.Scalar  // S146 a is not a scalar
  assert 10 is Unicode.Scalar  // UN3 ten is not a scalar
  assert "a"[0] is Unicode.Scalar  // UN1 a is not a scalar

  static Blocks => file("Blocks") as Table<(range: Range, "; ", value: *)>
  static Scripts => file("Scripts") as Table<(range: Range, " "[], "; ", value: *)>
  // UTS #39 §4: each confusable character and the prototype it maps to, from the security data of the same version (https://www.unicode.org/reports/tr39/#Confusable_Detection, https://www.unicode.org/Public/security/)
  static confusables => (Public / "security" / "{spelled}.0" / "confusables.txt") as Table<(range: Range, " "[], ";", "\t"[], prototype: Scalar[].join(" "), " "[], ";", "\t"[], type: Char.Word[], *)>
  static EastAsianWidth => file("EastAsianWidth") as Table<(range: Range, " "[], "; ", value: *)>
  static CaseFolding => file("CaseFolding") as Table<(range: Range, "; ", status: "C" | "F" | "S" | "T", "; ", value: Scalar[].join(" "), ";")>
  assert Unicode.CaseFolding[U+0041] == U+0061  // UN60 A does not fold to a
  static SpecialCasing => file("SpecialCasing") as Table<(
    range: Range, "; ", lower: Scalar[].join(" "), "; ", title: Scalar[].join(" "), "; ", upper: Scalar[].join(" "), ";", (" ", condition: Char.Word[].join(" "), ";")?
  )>
  static BidiMirroring => file("BidiMirroring") as Table<(range: Range, "; ", value: Scalar)>
  assert Unicode.BidiMirroring[U+0028] == U+0029  // UN63 the mirror of ( is not )
  static Age => file("DerivedAge") as Table<(range: Range, " "[], "; ", number: Decimal, ".", revision: Decimal)>

  static Data => file("UnicodeData") as Table<(
    range: Range, ";", name: *, ";", general_category: *, ";", canonical_combining_class: *, ";",
    bidi_class: *, ";", decomposition_mapping: *, ";", decimal_digit_value: Decimal?, ";", digit_value: Decimal?, ";",
    numeric_value: (minus: "-"?, numerator: Decimal, ("/", denominator: Decimal)?)?, ";", bidi_mirrored: "Y" | "N", ";", unicode1_name: *, ";", ISO_10646_comment: *, ";",
    upper_case: Scalar?, ";", lower_case: Scalar?, ";", title_case: Scalar?
  )>
  static UpperCase => Data.rows{.upper_case}.map(.range.from: .upper_case)
  assert Unicode.UpperCase[U+0061] == U+0041  // UN61 the upper case of a is not A
  static LowerCase => Data.rows{.lower_case}.map(.range.from: .lower_case)
  assert Unicode.LowerCase[U+0041] == U+0061  // UN62 the lower case of A is not a
  static TitleCase => Data.rows{.title_case}.map(.range.from: .title_case)
  static DecimalDigitValue => Data.rows{.decimal_digit_value != None}.map(.range.from: .decimal_digit_value)
  static DigitValue => Data.rows{.digit_value != None}.map(.range.from: .digit_value)
  static NumericValue => Data.rows{.numeric_value}.map(.range.from: .numeric_value -- (.minus ? -1 : 1) * .numerator / (.denominator ?? 1))
  static Superscript => decomposed("<super>")
  assert Unicode.Superscript[U+00B2] == U+0032  // UD18 ² is not a superscript 2
  assert !(Unicode.Superscript[U+0032])  // UD20 2 is a superscript
  static Subscript => decomposed("<sub>")
  assert Unicode.Subscript[U+2082] == U+0032  // UD19 ₂ is not a subscript 2
  static decomposed (tag: String) => Data.rows{.decomposition_mapping ~= ⊢(tag, " ")}.map(.range.from: .decomposition_mapping.after(tag + " ") as Scalar)

  Scripts.rows.value.unique.for script => static Char.`script` = Char{.script == script}

  static GeneralCategory := class (file("PropertyValueAliases") as Table<("gc", " "[], "; ", short_name: Char.Word[], " "[], "; ", name: Char.Word[], (" "[], ";", *)?)>) => {
    rows.for category => static `category.name` = Scalar{Data[.].general_category ~= ⊢(category.short_name == "LC" ? "Lu" | "Ll" | "Lt" : category.short_name)}
  }
  assert "1"[0] is Unicode.GeneralCategory.Number  // UN6 a digit is not a number
  assert "1"[0] is Unicode.GeneralCategory.Decimal_Number  // UN5 a digit is not a decimal number
  assert " "[0] is Unicode.GeneralCategory.Separator  // UN7 a space does not separate
  assert " "[0] is Unicode.GeneralCategory.Space_Separator  // UN8 a space is not a space separator
  assert "a"[0] is Unicode.GeneralCategory.Letter  // UN9 a letter is not a letter
  assert !("a"[0] is Unicode.GeneralCategory.Number)  // UN10 a letter is a number
  assert !("1"[0] is Unicode.GeneralCategory.Letter)  // UN26 a digit is a letter
  assert !(" "[0] is Unicode.GeneralCategory.Letter)  // UN27 a space is a letter
  assert "a"[0] is Unicode.GeneralCategory.Lowercase_Letter  // UN11 a is not lowercase
  assert !("A"[0] is Unicode.GeneralCategory.Lowercase_Letter)  // UN12 A is lowercase

  static TF | TransformationFormat := class: CodeUnit[]{length == 1..(32 / CodeUnit.length)} {
    static CodeUnit: Binary
    static Decoding := {
      {unit: UTF-16.Unit{prefix}} => unit.U0 + 1, unit.U1, unit.U2
      {unit} => unit.U0, unit.U1, unit.U2, unit.U3
    }
    as (=== CodePoint[]) => sequence.map(Compiler.reduced(., Decoding))
    bytes => this as Byte[]
    assert ("a" as Unicode.UTF-8).bytes.length == 1  // UN18 a is other than one byte in UTF-8
    assert ("é" as Unicode.UTF-8).bytes.length == 2  // UN19 é is other than two bytes in UTF-8
    assert ("一" as Unicode.UTF-8).bytes.length == 3  // UN20 一 is other than three bytes in UTF-8
    assert ("😀" as Unicode.UTF-8).bytes.length == 4  // UN21 😀 is other than four bytes in UTF-8
    assert ("a" as Unicode.UTF-16).bytes.length == 2  // UN22 a is other than two bytes in UTF-16
    assert ("😀" as Unicode.UTF-16).bytes.length == 4  // UN23 😀 is other than a surrogate pair in UTF-16
    assert ("a" as Unicode.UTF-32).bytes.length == 4  // UN24 a is other than four bytes in UTF-32
    assert (("a" as Unicode.UTF-16).bytes).(
      . == (0x00, 0x61)  // UN50 a in big-endian UTF-16 is not 00 61
      & ("a" as Unicode.UTF-16 as Unicode.LittleEndian).bytes == <-.  // UN48 little-endian does not read the bytes right to left
    )
    assert ("a" as Unicode.UTF-8 as Unicode.LittleEndian).bytes == (("a" as Unicode.UTF-8).bytes)  // UN49 a single byte is not the same either way
  }
  static LittleEndian := TF{} {
    bytes => <-(this as Byte[])
  }

  static UTF-8 := class: TF (sequence: Unit[]) => {
    static CodeUnit := Binary₈
    static Unit := class (
      prefix: 1[]{length == 0..4},
      U0: Binary{length == 8 - prefix.length}{⊢0},
      (₂10, U1: Binary₆) if prefix ⊢₂11,
      (₂10, U2: Binary₆) if prefix ⊢₂111,
      (₂10, U3: Binary₆) if prefix ⊢₂1111
    )
  }
  assert ₂01100001 as Unicode.UTF-8 as String == "a"  // T4 01100001 is not a in UTF-8
  assert "é" as Unicode.UTF-8 as String == "é"  // UN13 é does not come back from UTF-8

  static UTF-16 := class: TF (sequence: Unit[]) => {
    static CodeUnit := Binary₁₆
    static Unit := class (
      prefix: ₂110110?,
      U0: Binary₄,
      U1: Binary{length == 12 - prefix.length},
      (₂110111, U2: Binary₁₀) if prefix
    )
  }
  assert "\n" as Unicode.UTF-16 as String == "\n"  // UN16 a newline does not come back from UTF-16
  assert "😀" as Unicode.UTF-16 as String == "😀"  // UN25 😀 does not come back from UTF-16

  static UTF-32 := class: TF (sequence: Unit[]) => {
    static CodeUnit := Binary₃₂
    static Unit := class (0[]₁₁, U0: Binary₂₁) => { }
  }
  assert "\n" as Unicode.UTF-32 as String == "\n"  // W13 UTF32 round trip failed
  assert "\n" as Unicode.UTF-32 as String == "\n"  // UN14 a newline does not come back from UTF-32
  assert "\0" as Unicode.UTF-32 as String == "\0"  // UN15 the null character does not come back from UTF-32
}


assert U+0061 == "a"[0]  // UN64 U+0061 is not a

// (what the bootstrap leaves to this file: it needs what is here)
assert U+0061 is Char.Latin  // UN45 a is not a Latin character
assert !(U+0627 is Char.Latin)  // UN46 alef is a Latin character
assert U+0627 is Char.Arabic  // UN53 alef is not an Arabic character
assert U+03B1 is Char.Greek  // UN54 alpha is not a Greek character
assert U+0430 is Char.Cyrillic  // UN55 a Cyrillic a is not Cyrillic
assert U+4E00 is Char.Han  // UN56 a Han character is not Han
Char &+= {
  static Symbol: Char = Unicode.GeneralCategory.(Punctuation | Symbol)
}
Char &+= {
  bytes => ([this] as String).bytes
  assert ("é" as Unicode.UTF-8).bytes.length == 2  // S8 é is not two bytes wide

  special_casing => Unicode.SpecialCasing.rows{.range.in(this) && !.condition}.first
  upper_case | uppercase => special_casing.upper ?? Unicode.UpperCase[this] ?? this
  assert "ab".upper_case == "AB"  // W3 upper_case failed
  assert "a"[0].upper_case == "A"[0]  // S80 a in upper case is not A
  assert "7"[0].upper_case == "7"[0]  // S83 a digit in upper case is not itself
  assert "Ab".uppercase == "AB"  // S117 uppercase is not upper_case
  assert "é".upper_case == "É"  // SC9 é in upper case is not É
  // Case and scripts from the Unicode data (X3.10)
  assert "Straße".upper_case == "STRASSE"  // UD1 sharp s does not upper-case to SS
  lower_case | lowercase => special_casing.lower ?? Unicode.LowerCase[this] ?? this
  assert "Z"[0].lower_case == "z"[0]  // S81 Z in lower case is not z
  assert "a"[0].lower_case == "a"[0]  // S82 a already in lower case is not itself
  assert "Ab".lowercase == "ab"  // S116 lowercase is not lower_case
  title_case | titlecase => special_casing.title ?? Unicode.TitleCase[this] ?? upper_case
  assert "ab".title_case == "Ab"  // S49 title_case does not capitalise
  assert "ab cd".titlecase == "Ab Cd"  // S119 titlecase is not title_case
  assert "AB cd".title_case == "Ab Cd"  // S153 the words titled are not Ab Cd
  assert U+01C6.title_case == U+01C5  // UD2 dž does not title-case to Dž
  assert "ǆemal".title_case == "ǅemal"  // UD3 a word does not start with its title case
  is_upper => lower_case != this
  assert "AB".is_upper  // SC1 AB is not upper case
  assert !("a"[0].is_upper)  // SC3 the character a is upper case
  is_lower => upper_case != this
  assert "ab".is_lower  // SC2 ab is not lower case
  assert !("1"[0].is_lower)  // SC4 the character 1 is lower case
  mirrored => Unicode.BidiMirroring[this].value ?? this
  assert "ab".mirrored == "ba"  // W5 mirrored failed
  assert "abc".mirrored == "cba"  // S54 abc reversed is not cba
  assert "a".mirrored == "a"  // S55 one character reversed is not itself
  swap_case | swapcase => is_lower ? upper_case : lower_case
  assert "Ab".swap_case == "aB"  // W4 swap_case failed
  assert "a"[0].swap_case == "A"[0]  // S84 a swapped is not A
  assert "A"[0].swap_case == "a"[0]  // S85 A swapped is not a
  assert "7"[0].swap_case == "7"[0]  // S86 a digit swapped is not itself
  assert "Ab".swapcase == "aB"  // S118 swapcase is not swap_case
  fold_case | foldcase => Unicode.CaseFolding.rows{.range.in(this) && .status is ("C" | "F")}.first.value ?? this
  assert "Ab".fold_case == "ab"  // S50 fold_case does not fold
  assert "Ab".foldcase == "ab"  // S120 foldcase is not fold_case
  assert "ß".fold_case == "ss"  // SC5 ß does not fold to ss
  assert "Straße".fold_case == "strasse"  // SC6 Straße does not fold to strasse
  assert "Straße".fold_case == "strasse"  // UN59 sharp s does not fold to ss

  // Unicode §3.7: the full canonical decomposition, a mapping without a <tag> applied until nothing decomposes (https://www.unicode.org/versions/latest/core-spec/chapter-3/#G733)
  decomposed => Unicode.Data[this].decomposition_mapping -- (. && !(. ~= ⊢"<") ? (. as Unicode.Scalar[].join(" ")).map(.decomposed).flatten : [this])
  combining_class => (Unicode.Data[this].canonical_combining_class ?? "0") as Decimal

  decimal_digit_value => Unicode.DecimalDigitValue[this]
  assert U+0663.decimal_digit_value == 3  // UD13 the decimal value of ٣ is not three
  assert !(U+00B2.decimal_digit_value)  // UD14 a superscript two is a decimal digit
  digit_value => Unicode.DigitValue[this]
  assert U+00B2.digit_value == 2  // UD15 the digit value of ² is not two
  numeric_value => Unicode.NumericValue[this]
  assert U+00BD.numeric_value == 1/2  // UD16 ½ is not a half
  assert U+216B.numeric_value == 12  // UD17 Ⅻ is not twelve
  baseline => Unicode.Superscript[this] ?? Unicode.Subscript[this] ?? this
  assert "x²".baseline == "x2"  // UD4 a superscript does not come down to its digit
  assert "H₂O".baseline == "H2O"  // UD5 a subscript does not come up to its digit
  superscript => Unicode.Superscript⁻¹[this]
  assert "2".superscript == "²"  // UD6 two has no superscript
  subscript => Unicode.Subscript⁻¹[this]
  assert "2".subscript == "₂"  // UD7 two has no subscript
}
Char &+= {
  as (=== Decimal) => digit_value ?? lower_case - "a" + 10
}
Char &+= {
  static (codepoint: Unicode.Scalar) as (=== Char) => codepoint

  east_asian_width => Unicode.EastAsianWidth[this].value ?? "N"
  assert U+4E00.east_asian_width == "W"  // UN51 a Han character is not wide
  assert U+0061.east_asian_width == "Na"  // UN52 a is not narrow
  columns => (east_asian_width is ("W" | "F")) ? 2 : 1
  assert U+4E00.columns == 2  // UN41 a Han character does not take two columns
  assert U+0061.columns == 1  // UN42 a Latin letter does not take one column
  script => Unicode.Scripts[this].value ?? "Unknown"
  assert U+0061.script == "Latin"  // UN43 a is not Latin
  assert U+0627.script == "Arabic"  // UN44 alef is not Arabic
  block => Unicode.Blocks[this].value ?? "No_Block"
  assert U+0061.block == "Basic Latin"  // UN57 a is not in Basic Latin
  assert U+00E9.block == "Latin-1 Supplement"  // UN58 é is not in Latin-1 Supplement
  age => Unicode.Age[this] -- . ? Version(number: .number, revision: .revision) : None
  assert U+0061.age == %1'1  // UV3 a is not from Unicode 1.1
  assigned => age && age <= Unicode.version
  assert U+0061.assigned  // UV4 a is not assigned in the selected version
}
assert "-"[0] is Char.Symbol  // S101 a dash is not a symbol
assert !("a"[0] is Char.Symbol)  // S102 a is a symbol
assert "a-b+c".split(Char.Symbol).length == 3  // S124 a-b+c cut at its symbols is other than three pieces
Char &+= Unicode.Scalar
\s = Unicode.GeneralCategory.Space_Separator | \t
assert " "[0] is \s  // SE9 a space is not a space escape
assert !("a"[0] is \s)  // SE10 a is a space escape
\S = !\s
\R = Unicode.GeneralCategory.Line_Separator
\d = Unicode.GeneralCategory.Decimal_Number
assert "7"[0] is \d  // SE11 7 is not a digit escape
\D = !\d
assert "a"[0] is \D  // SE12 a is not a non-digit escape
String &+= {
  upper_case | uppercase => #.upper_case as String
  assert "abc".map(.upper_case) as String == "ABC"  // S115 abc made upper is not ABC
  lower_case | lowercase => #.lower_case as String
  is_upper => some(.is_upper) && !some(.is_lower)
  is_lower => some(.is_lower) && !some(.is_upper)
  swap_case | swapcase => #.swap_case as String
  ignore_case | ignorecase => this.copy ~~ .normalizer = (text) => text.fold_case
  assert "AbC".ignore_case == "aBc"  // SC7 ignoring case, AbC is not aBc
  assert "abcd".ignore_case ~= "BC"  // S132 a pattern ignoring case does not find the other case
  fold_case | foldcase => #.fold_case as String
  title_case | titlecase => words.map(.[0].title_case, .[1..].lower_case).join(" ")
  baseline => #.baseline as String
  superscript => #.superscript as String
  subscript => #.subscript as String
}
String &+= {
  assert "AB cd".words.lower_case.join(" ") == "ab cd"  // S152 the words lowered are not ab cd
  snake_case | snakecase => words.lower_case.join("_")
  assert "a b".snake_case == "a_b"  // W9 snake_case failed
  assert "ab cd".snakecase == "ab_cd"  // S123 snakecase is not snake_case
  camel_case | camelcase | camelCase => words[0].lower_case, words[1..].title_case
  assert "ab cd".camel_case == "abCd"  // S48 camel_case is not the first word lower and the rest capitalised
  assert "ab cd".camelCase == "abCd"  // S121 camelCase is not camel_case
  assert "ab cd".camelcase == "abCd"  // S154 camelcase is not camel_case
  pascal_case | pascalcase | PascalCase => words.title_case as String
  assert "ab cd".pascal_case == "AbCd"  // W10 pascal_case failed
  assert "ab cd".PascalCase == "AbCd"  // S122 PascalCase is not pascal_case
  assert "ab cd".pascalcase == "AbCd"  // S155 pascalcase is not pascal_case
}
String &+= {
  mirrored => <-#.mirrored as String
}
String &+= {
  // UAX #15 §1.2: NFD is the full canonical decomposition, each run of non-starters then put in order of Canonical_Combining_Class (https://www.unicode.org/reports/tr15/#Norm_Forms, https://www.unicode.org/versions/latest/core-spec/chapter-3/#G49537)
  nfd => (#.decomposed.flatten as String).ordered
  // Confusable names compare by their UTS #39 skeleton.
  assert "\u00E9".nfd == "e\u0301"  // SKL4 a precomposed letter does not decompose to its base and mark
  ordered => empty ? "" : first.combining_class == 0 ? first, rest.ordered : marks.sort_by(.combining_class), this[marks.count..].ordered
  marks => empty || first.combining_class == 0 ? [] : first, rest.marks
  // UTS #39 §4: skeleton(X) is NFD(X) with each character replaced by its prototype, then NFD again; X and Y are confusable when their skeletons are equal (https://www.unicode.org/reports/tr39/#def-skeleton)
  skeleton => (nfd#.map(Unicode.confusables[.].prototype ?? [.]).flatten as String).nfd
  confusable (other: String) => skeleton == other.skeleton
  assert "dаwn".confusable("dawn")  // SKL1 a Cyrillic a is not confusable with a Latin a
  // UTS #39 §5.1: Common and Inherited characters go with any script, so a string of one other script is single-script (https://www.unicode.org/reports/tr39/#Mixed_Script_Detection)
  mixed_script => #.script{!= "Common" && != "Inherited"}.unique.count > 1
  assert "dаwn".mixed_script  // SKL2 Latin with a Cyrillic letter is not mixed-script
  assert !("dawn".mixed_script)  // SKL3 a Latin name is mixed-script
}
String &+= {
  bytes => (this as Unicode.UTF-8).bytes
}
// Uniqueness under an equivalence (T6.9)
assert {
  UniquelyNamed := class { unique<in: .fold_case> name: String }
  named_first := UniquelyNamed(name: "Ada")
  named_other := UniquelyNamed(name: "Bea")
  assert named_other.name.is_unique<in: .fold_case>  // UQI1 a name no other holds is not unique
  named_clash := UniquelyNamed(name: "ADA")
  assert !(named_clash.name.is_unique<in: .fold_case>)  // UQI2 a name another holds in other case is unique with case folded
  assert named_clash.name.is_unique  // UQI3 a name is not unique without folding case though no other is equal
}
