say {x} =>
  external io stdout x
goto {literal target} =>
  external goto target
goto {literal target} if {condition} =>
  external goto target condition
{literal label}\ =>
  external label label
count {list} =>
  at := list
  again\
  say at
  at = at.next
  goto again if at
  say done
a := external node
b := external node
a.next = b
count a
