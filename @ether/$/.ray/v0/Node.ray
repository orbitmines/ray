Node &+= {
  conjoined => [this]
  & (other) => class {
    conjoined => this.conjoined, other
    holds => conjoined.every(.)
    admits (candidate) => conjoined.every(candidate ==.instance_of .)
    contains (x) => conjoined.contains(x)
  }

  properties => fields

  as (=== String) => (Language.for_file(&caller.location.name) ?? Language.ray).write(this)

  chainable != (other) => !(this == other)

  inverse: Node?
  ⁻¹ | ^-1 => inverse
  reversible => inverse
  inverted_by (backward) => (inverse = backward) -- backward.inverse = this -- this

  right-to-left await => Running.until(() => this && (this !=.instance_of Running || is_terminal))
    -- this ==.instance_of Running ? results.last : this
  right-to-left pending => await this

  right-to-left never => Never -- ERROR@Never `happened, and was said never to` if this

  chosen_within (width) => components.random
  right-to-left choose => chosen_within(1)

  right-to-left persistent => Store.keep(this)

  erred => diagnostics?.nonempty ?? false
  as (=== boolean) => !erred
  recoverable => erred && !diagnostics.some(.fatal)

  $ ^error => instance ? this : Store.View(type: this)
  $ (fallback) ^error => recoverable ? fallback : this
  $ (raised: Diagnostic) ^error => recoverable ? diagnosed(raised ~~ .cause = diagnostics.last) : this
  $ (handler: Program) ^error => recoverable ? handler.entered(diagnostics.last, None) : this
  $? ^error => recoverable ? None : this
  $? (fallback) ^error => $? ?? fallback
  $! ^error => erred ? FATAL@Escalated `an error escalated to fatal` : this
  $?! ^error => erred ? None : this
  $?! (handler: Program) ^error => erred ? handler.entered(diagnostics.last, None) : this
  {\n}${kind} {handled} ^error => recoverable && diagnostics.last.kind == kind ? handled : this
  {\n}${kind} | ${other} {handled} ^error => recoverable && (diagnostics.last.kind == kind || diagnostics.last.kind == other) ? handled : this
}

!{ }{forward}{ }{backward} ^keyword => forward.inverted_by(backward)

Possibilities := class = values: Iterable {
  entry => values.entry
  .{literal property ^property} ^punctuation => .declaring(property) ? external get this property : Possibilities(values: values.map(external get . property))
}
Possibilities.components.hierarchy &= Iterable
Node &+= {
  # => Possibilities(values: superposes ? components : conjoined.count > 1 ? conjoined : (!instance && components.head) ? components : [this])
  origin: Node?
}
#{value} ^punctuation => value#

Composed := class = parts: Node[], joining: Program {
  .{literal property ^property} ^punctuation => .declaring(property) ? external get this property : parts.map(external get . property).reduce((acc) => joining(acc, .))
}
Node &+= {
  &+ (other) => Composed(parts: [this, other], joining: (a, b) => a & b) ~~ .components.hierarchy &= this ~~ .components.hierarchy &= other
  |+ (other) => Composed(parts: [this, other], joining: (a, b) => a | b) ~~ .components.hierarchy &= this ~~ .components.hierarchy &= other
}

Node &+= {
  superposed => superposes || conjoined.count > 1
  alternatives => superposes ? components : conjoined
  sources: Node?
  each (step: Program) => superposes
    ? alternatives.map(one => step(one).branched(one, this)).reduce(|)
    : conjoined.count > 1 ? conjoined.map(one => step(one).branched(one, this)).reduce(&) : step(this)
  branched (from, whole) => this++ ~~ (.sources = [(whole: whole, part: from)], from.sources ?? []) ~~ (.origin = from.origin ?? from)
  agrees (other) => !sources || !other.sources || sources.every(mine => other.sources{.whole === mine.whole}.every(.part === mine.part))
  holds_for (branch) => superposed ? alternatives.some(alternative => alternative.agrees(branch) && alternative) : this
}
Superposed := Node{.superposed}
{a: Superposed} [x] {b} => a.each(one => one[x] b)
{a} [x] {b: Superposed} => b.each(one => a[x] one)
{f}({argument: Superposed}) => argument.each(one => f(one))

Section := class = operator: String, operand: Node? {
  continues => true
  (subject, other?) => operand != None ? (external get subject operator)(operand)
    : other != None ? (external get subject operator)(other)
    : (external get subject operator)
}
Operator := "!" | "&&" | "||" | "!&&" | "!||" | "x||" | "x!||" | "+" | "-" | "/" | "%" | "^" | "==" | "!=" | "<" | ">" | "<=" | ">="
({operator: Operator}) ^operator => Section(operator)
(*) ^operator => Section("*")
{operator: Operator} ^operator => Section(operator)
+{operand} ^operator => Section("+", operand)
*{operand} ^operator => Section("*", operand)
/{operand} ^operator => Section("/", operand)
%{operand} ^operator => Section("%", operand)
=={operand} ^operator => Section("==", operand)
!={operand} ^operator => Section("!=", operand)
<{operand} ^operator => Section("<", operand)
>{operand} ^operator => Section(">", operand)
<={operand} ^operator => Section("<=", operand)
>={operand} ^operator => Section(">=", operand)
&&{operand} ^operator => Section("&&", operand)
||{operand} ^operator => Section("||", operand)

Node &+= {
  .match{\n}{arms} ^punctuation => matched(external ** arms)
  matched (arms) => Program(code: arms).written.map(.code ~= (pattern: *, " => ", value: *)){
    .pattern == "*" || this.answers_arm(Program(code: external ** .pattern).entered(this, None))
  }.first -- . ? Program(code: external ** .value).entered(this, None) : None
  answers_arm (arm) => arm ==.instance_of Section ? arm(this)
    : arm ==.instance_of Anchored ? this ~= arm
    : this ==.instance_of arm || this == arm
}

Node &+= {
  .({expr}) ^punctuation => Program(code: (external ** expr)).entered(this, None)
}

Node &+= {
  entries => written_body ? Program(code: written_body).written{.is_label} : []
  entry_at (label) => label ==.instance_of Number ? entries[label - 1] : entries{.code == label + "\"}.first
  ~default => this
  ~{literal label ^label} ^punctuation => Entry(of: this, at: entry_at(label))
  ~"{label}" ^punctuation => Entry(of: this, at: entry_at(label))
  ~{index: Decimal.String} ^punctuation => Entry(of: this, at: entry_at(index as Decimal))
}
Entry := class = of: Node, at: Program? {
  following => Program(code: of.written_body).written -- .[.index_of(at) + 1..]
  ({args}) => of.construct(args) ~~ following.for(statement => statement.entered(., None))
}

Node &+= {
  @{ }{location} ^punctuation => Placed(value: this, location: location)
  placed (variable, written) => this[variable] = written
}
Placed := class = value: Node, location: Node {
  = (written) => location.placed(value, written) -- this
  .{literal property ^property} ^punctuation => .declaring(property) ? external get this property : external get value property
}

? ^keyword => Unknown()
Unknown := class {
  # => Possibilities(values: [])
  random => chosen_within(1)
  admits (candidate) => true
}
{target} ?= {value} ^punctuation => target = target ?? value

Node &+= {
  is (type) => .instance_of(type)
}

Node &+= {
  ~= (pattern) => read_within(this, pattern)
  !~= (pattern) => !(this ~= pattern)
  right-to-left ⊢ => Anchored(pattern: this, at_start: true)
  ⊣ => Anchored(pattern: this, at_end: true)
}
Anchored := class = pattern: Node, at_start: boolean = false, at_end: boolean = false {
  ⊣ => Anchored(pattern, at_start, at_end: true)
}
read_within (text, pattern) => (
  found := None
  if pattern.superposes {
    alternative := pattern.components.head
    while (alternative && found.not) {
      found = read_within(text, alternative.value)
      alternative = alternative.next
    }
  } else {
    at_start := pattern ==.instance_of Anchored && pattern.at_start
    at_end := pattern ==.instance_of Anchored && pattern.at_end
    wanted := pattern ==.instance_of Anchored ? pattern.pattern : pattern
    start := text_bits(text).head
    index := 0
    searching := global
    while (searching && found.not) {
      candidate := readings_of(start, wanted).head
      while (candidate && found.not) {
        unless (at_end && candidate.value.rest) { found = candidate.value ~~ .index = index }
        candidate = candidate.next
      }
      if (at_start || !start) { searching = None } else {
        byte := byte_steps.head
        while (byte && start) {
          start = start.next
          byte = byte.next
        }
        index = index.succ
      }
    }
  }
  found
)

{type}+{ } ^punctuation => type[]
{type}+, {rest} ^punctuation => type[], rest

Node &+= {
  right-to-left internal => this ~~ .access = Accessor(Accessor.Permission.local)
  right-to-left protected => this ~~ .access = Accessor(Accessor.Permission.protected)
  right-to-left trivially => instance ? this : ?
}

∀{ }{name} ∈ {domain}: {predicate} ^keyword => domain.every(Program(code: external ** predicate, parameters: external ** name))
∃{ }{name} ∈ {domain}: {predicate} ^keyword => domain.some(Program(code: external ** predicate, parameters: external ** name))
∃{ }{name}: {type} {predicate} ^keyword => type#.some(Program(code: external ** predicate, parameters: external ** name))
∄{ }{name}: {type} {predicate} ^keyword => !type#.some(Program(code: external ** predicate, parameters: external ** name))
Node &+= {
  ∈ (type) => .instance_of(type) || (type.contains && type.contains(this))
  ∉ (type) => !(this ∈ type)
  ∋ (element) => element ∈ this
  ∌ (element) => element ∉ this
}

print (x) => IO.output(x as String) -- x

Origin := class = method: Node, arguments: Node {
  == (other) => other === method || (other ==.instance_of Origin && other.method === method && other.arguments == arguments)
}
{f}({a}) | {g}({b}) ^punctuation => (f(a)++ ~~ .origin = Origin(f, a)) | (g(b)++ ~~ .origin = Origin(g, b))
{f}({a}) | {rest} ^punctuation => (f(a)++ ~~ .origin = Origin(f, a)) | rest
{rest} | {g}({b}) ^punctuation => rest | (g(b)++ ~~ .origin = Origin(g, b))

& ^keyword => external .
&{literal member ^variable} ^keyword => external get (external .) member

~{literal label ^label} ^punctuation => this~label
Node &+= {
  .{literal property ^property}? ^punctuation => (external get this (property + "?")) ?? (external get this property)?
}
