  static resumed_kind (s: Choice, p: Pattern) => (s.kind == 1) ? Runtime.either_next(s, p.a) : ((s.kind == 2) ? Runtime.hole_resumed(s, p) : ((s.kind == 3) ? Runtime.anything_next(s, s.a) : ((s.kind == 4) ? Runtime.repeat_resumed(s, p) : None)))
  static either_next (s: Choice, l: List) => {
    i := s.b
    while (i < l.count) && (rmode == failed) {
      Runtime.either_tried(s, l, i, l.items[i])
      i = i + 1
    }
    s.b = i
  }
  static either_tried (s: Choice, l: List, i, c: Pattern) => (c.kind == anything_at_all) ? (Runtime.read_to(s.at + 1) if (s.at < textend) && (read_by_another(l, i, s.at) == 0) && ((s.at + 1) > 0)) : Runtime.either_entered(s, c)
  static either_entered (s: Choice, c) => {
    rpos = s.at
    Runtime.enter(c)
  }
  static anything_next (s: Choice, n) => Runtime.anything_to(s, n) if (n <= textend) && (byte(n - 1) != 10)
  static anything_to (s: Choice, n) => {
    s.a = n + 1
    Runtime.read_to(n)
  }
  // (a repeat: once more, or not; at least as many as it says; greedy, more first)
  static repeat_resumed (s: Choice, p) => (s.b == 0) ? Runtime.repeat_begun(s, p) : ((s.b == 1) ? Runtime.repeat_once_more(s, p) : Runtime.repeat_left(s))
  static repeat_begun (s: Choice, p) => {
    s.b = 1
    ((s.a <= 0) && (s.c == 0)) ? Runtime.read_to(s.at) : Runtime.repeat_once_more(s, p)
  }
  static repeat_once_more (s: Choice, p) => {
    s.b = 2
    rk = Cell(what: pattern4(repeat_next, p, s.a - 1, s.at, s.c), next: rk)
    rpos = s.at
    Runtime.enter(p)
  }
  static repeat_left (s: Choice) => {
    choices_set(s)
    Runtime.read_to(s.at) if (s.a <= 0) && (s.c != 0)
  }
  // (a hole: what it takes, a byte, a pair, a text a rule leads with, at a time, up to where it may not go on: a line
  // end the statement does not go on past, and as it says (its mode): 0 anywhere, 1 on one line up to its byte, a quote
  // not crossed, 2 up to its byte, 3 not past a space)
  static hole_resumed (s: Choice, p: Pattern) => (s.b == 0) ? Runtime.hole_begun(s, p) : ((s.b == 1) ? Runtime.hole_on(s, p, s.a) : None)
  static hole_begun (s: Choice, p: Pattern) => {
    s.b = 1
    s.a = s.at
    ((p.b == 1) || (p.b == 2)) ? Runtime.read_to(s.at) : Runtime.hole_on(s, p, s.a)
  }
  static hole_on (s: Choice, p: Pattern, n) => Runtime.hole_led(s, p, n, Runtime.led_past(p, n, s.at)) if n < textend
  static led_past (p: Pattern, n, from) => (p.b != 2) ? ((inside_word(n, from) == 0) ? text_led_reading(p.a, n) : 0) : (((byte(n) == 92) && ((n + 1) < textend)) ? (n + 2) : 0)
  static hole_led (s: Choice, p: Pattern, n, l) => (l > n) ? Runtime.hole_taken(s, l) : (Runtime.hole_stops(s, p, n) ? None : Runtime.hole_byte(s, p, n, Runtime.class_at(n)))
  static hole_stops (s: Choice, p: Pattern, n) => ((byte(n) == 10) && (p.b != 1) && (((continued_from(s.at, n) == 0) && (quoted_around(s.at, n) == 0)) || (block_closed(s.at, n) > 0))) || ((p.b == 3) && ((byte(n) == 32) || (byte(n) == 9)))
  static hole_byte (s: Choice, p: Pattern, n, pc) => (((p.b == 0) || (p.b == 3)) && (pc != 0)) ? ((pc == 3) ? None : (((pair_end(n) - 1) < 0) ? None : Runtime.hole_taken(s, pair_end(n)))) : (((p.b == 1) && (pc == 2)) ? None : ((((p.b == 1) || (p.b == 2)) && (byte(n) == p.c)) ? Runtime.hole_closed(s, n) : Runtime.hole_taken(s, n + 1)))
  static hole_taken (s: Choice, n) => {
    s.a = n
    Runtime.read_to(n)
  }
  static hole_closed (s: Choice, n) => {
    s.b = 2
    Runtime.read_to(n)
  }

  // Members and calls. A member of a value, by the number its name is known by: of a node, or of what a rule read, its
  // own field of it (a getter's, what that answers), else its keys; of a list, how many it holds, its first, its last,
  // whether it is empty, its rest, its sort, for, map, joined and append (bound to it), else that member of each; of a
  // text, its length, its first byte, its last, its rest, whether it is empty. A call runs a closure in a frame of its
  // own (`isolated_open`, the memory level's), its node given what is called with it; a curried function with its
  // value as `this`; a pattern with a function, read by it; a class, constructing.
  static Builtin := (8, id, self)
  static Curried := (9, function, value)
  static Applied := (10, in, fields, rule, index)
  static placed := 50
  static members_listed := 52
  static bound (id, x) => Builtin(id: id, self: x)
  static curried (f, v) => Curried(function: f, value: v)
  static curried_value (c: Curried) => (c is Curried) ? c.value : list()
  static isgetter (v: Closure) => (v is Closure) && (v.called == 1)
  static got (v) => Runtime.isgetter(v) ? call(v, list(), 0) : v
  static get (scope, name) => Runtime.got(lookup(scope, name))
  static keys (n: Node) => (n.keys === None) ? Runtime.keys_made(n) : n.keys
  static keys_made (n: Node) => {
    n.keys = list()
    n.keys
  }
  static member (x, name) => ((x is Node) || (x is Applied)) ? Runtime.node_member(x, name, own(x, name)) : ((x is List) ? Runtime.list_member(x, name) : (((x is Text) && ((name == Symbol.count) || (name == Symbol.length))) ? Runtime.text_length(x) : None))
  static node_member (x, name, f: Field) => (f === None) ? ((name == Symbol.keys) ? keys(x) : None) : Runtime.got(f.value)
  static list_member (l: List, name) => (name == Symbol.count) ? int(l.count) : ((name == Symbol.first) ? Runtime.at_or_none(l, 0) : ((name == Symbol.last) ? Runtime.at_or_none(l, l.count - 1) : ((name == Symbol.empty) ? same(l.count, 0) : Runtime.list_bound(l, name))))
  static at_or_none (l: List, i) => (l.count == 0) ? None : l.items[i]
  static list_bound (l, name) => ((name == Symbol.sort) || (name == Symbol.for) || (name == Symbol.map)) ? bound(name, l) : mapped(l, name)
  static text_length (t: Text) => int(t.to - t.from)
  static member2 (x, name) => ((x is Text) && ((name == Symbol.first) || (name == Symbol.last) || (name == Symbol.rest) || (name == Symbol.empty))) ? Runtime.text_member(x, name) : (((x is List) && ((name == Symbol.rest) || (name == Symbol.joined) || (name == Symbol.append))) ? Runtime.list_member2(x, name) : member(x, name))
  static text_member (t: Text, name) => (name == Symbol.empty) ? boolean(t.from == t.to) : ((name == Symbol.rest) ? ((t.from == t.to) ? text(t.from, t.to) : text(t.from + 1, t.to)) : ((t.from == t.to) ? None : ((name == Symbol.first) ? text(t.from, t.from + 1) : text(t.to - 1, t.to))))
  static list_member2 (l, name) => (name == Symbol.rest) ? rest_of(l) : bound(name, l)
  static own_closure (x, name) => (x is Node) ? Runtime.closure_of(own(x, name)) : None
  static closure_of (f: Field) => ((f != None) && Runtime.plain_closure(f.value)) ? f.value : None
  static plain_closure (c: Closure) => (c is Closure) && (c.called == 0)
  static call_member (x, name, args, named) => Runtime.member_called(Runtime.own_closure(x, name), x, name, args, named)
  static member_called (c: Closure, x, name, args, named) => (c === None) ? invoke(member2(x, name), args, named) : indirect(c.env, args, named, c.function)
  static invoke (c, args, named) => ((c is Builtin) && Runtime.list_changed(c)) ? Runtime.builtin_list(c, arg(args, 0)) : call(c, args, named)
  static list_changed (b: Builtin) => (b.id == Symbol.joined) || (b.id == Symbol.append)
  static builtin_list (b: Builtin, v) => (b.id == Symbol.joined) ? joined(b.self, v) : append(b.self, v)
  static builtin (id, x, args) => (id == Symbol.sort) ? sorted(x, arg(args, 0)) : ((id == Symbol.for) ? each(x, arg(args, 0)) : ((id == Symbol.map) ? each_value(x, arg(args, 0)) : ((id == placed) ? place(arg(args, 0), arg(args, 1)) : ((id == members_listed) ? members_of(arg(args, 0)) : None))))
  static call (c, args, named) => {
    fueled()
    stopped() ? None : Runtime.called(c, args, named)
  }
  static called (c, args, named) => (c is Pattern) ? Runtime.pattern_called(c, args) : ((c is Curried) ? Runtime.curried_called(c, Runtime.curried_function(c), args, named) : ((c is Applied) ? Runtime.applied_called(c, Runtime.applied_rule(c), args, named) : ((c is Builtin) ? Runtime.builtin_called(c, args) : ((c is Class) ? construct(c, args, named) : ((c is Closure) ? Runtime.closure_called(c, args, named) : None)))))
  static pattern_called (p: Pattern, args) => (p.kind == with_function) ? Pattern(kind: functioned, a: p, b: args) : None
  static curried_function (c: Curried) => c.function
  static curried_called (c: Curried, f: Closure, args, named) => indirect(Runtime.defined_as(node(f.env), Symbol.this, c.value), args, named, f.function)
  static applied_rule (c: Applied) => c.rule
  static applied_called (c, f: Closure, args, named) => indirect(applied_again(c), args, named, f.function)
  static builtin_called (b: Builtin, args) => builtin(b.id, b.self, args)
  static closure_called (c: Closure, args, named) => (isodepth > 4000) ? indirect(c.env, args, named, c.function) : isolated_value(isolated_open(), indirect(c.env, args, named, c.function))
  // (a class constructing: a node in its scope, itself its `this`, given what is named, its body run in it; its header,
  // the pattern it is read by, else anything; a rule's reading applied again, its fields copied)
  static construct (c: Class, args, named) => Runtime.instance_run(c, Runtime.instance_named(Runtime.itself(node(c.env)), named), args, named)
  static itself (n) => Runtime.defined_as(n, Symbol.this, n)
  static instance_named (inst, named) => {
    Runtime.names_given(inst, named) if named is Node
    inst
  }
  static names_given (inst, named: Node) => {
    Runtime.fields_given(inst, named.fields)
    define(inst, 14, named) if named.keys != None
  }
  static fields_given (inst, from: Field) => {
    f := from
    while f != None {
      define(inst, f.name, f.value)
      f = f.next
    }
  }
  static instance_run (c: Class, inst, args, named) => {
    indirect(inst, args, named, c.function)
    inst
  }
  static header (c: Class, scope) => (c.header == None) ? anything() : indirect(scope, list(), 0, c.header)
  static headpattern (t: Text) => (t is Pattern) ? t : ((t is Node) ? topattern(t) : sequence(gaps(list(), t.from, t.to)))
  static applied_again (c: Applied) => Applied(in: c.in, fields: Runtime.copied_fields(c.fields), rule: c.rule)
  static copied_fields (f: Field) => (f === None) ? None : Field(next: Runtime.copied_fields(f.next), name: f.name, value: f.value)
  static application (e, mark) => Runtime.application_of(e, mark, member(e, Symbol.value))
  static application_of (e, mark, f: Closure) => Runtime.named_bounds(Runtime.defined_as(Applied(in: f.env, rule: f), Symbol.key, e), mark)
  static named_bounds (a, mark) => {
    i := mark
    while i < boundn {
      Runtime.bound_defined(a, bound_at(i), i)
      i = i + 1
    }
    a
  }
  static bound_defined (a, b: Bound, i) => define(a, b.hole, Runtime.boundvalue(i)) if b.hole != 0
}
