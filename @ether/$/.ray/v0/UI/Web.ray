Language.Web := class: Language {
  static extensions = ".web"
  HTML := class {
    Element := class = tag: String, attributes: (name: String, value: String)[] = [], children: (Element | Text | Raw)[] = [] {
      static made = 0
      id: String = attributes{.name == "id"}.first?.value ?? ("e" + ((Element.made += 1) as String))
      void => tag ==.instance_of ("img" | "input" | "br" | "meta" | "link" | "source")
    }
    Text := class = text: String
    Raw := class = text: String
    Document := class = head: Element[], body: Element, language: String = "en"

    Page := class = shape: Geometry.Shape
    Head := class
    Meta := class = name: String, content: *
    Named := class = shape: Geometry.Shape
    Described := class = shape: Geometry.Shape
    Entry := class = input: UI.Input
    Pieces := class = text: Geometry.Text
    Piece := class = text: String, run: Geometry.Text.Run?
    Inline := class = run: Geometry.Text.Run
    Path := class = segment: *

    Escapes = { "<": "&lt;", ">": "&gt;", "&": "&amp;", "\"": "&quot;" }
    escaped (text: String) => #text.map(Escapes[.] ?? .) as String

    rules := CSS.values + {
      {page: HTML.Page} => Document(head: [Head()], body: Element("body", children: [page.shape]))
      {head: Head} => [
        Element("title", children: [Text(UI.Navigation.title)]),
        Element("meta", [("name", "description"), ("content", UI.Navigation.description)]),
        UI.Navigation.tags.map(Meta(.name, .content)),
        Meta("theme-color", CSS.Paint(UI.Navigation.theme)) if UI.Navigation.theme,
        Element("link", [("rel", "canonical"), ("href", UI.Navigation.canonical as String)]) if UI.Navigation.canonical,
        Element("link", [("rel", "icon"), ("href", UI.Navigation.icon as String)]) if UI.Navigation.icon,
        Element("link", [("rel", "apple-touch-icon"), ("href", UI.Navigation.apple_icon as String)]) if UI.Navigation.apple_icon,
        Element("link", [("rel", "manifest"), ("href", UI.Navigation.manifest as String)]) if UI.Navigation.manifest,
        UI.Navigation.structured.map(Element("script", [("type", "application/ld+json")], [Raw(JSON.write(JSON.Linked(., context: "https://schema.org")))])),
        Element("link", [("rel", "stylesheet"), ("href", "style.css")]),
        Element("script", [("src", "app.js"), ("defer", "")])
      ]
      {meta: Meta{name ~= ("og:" | "article:" | "fb:", *)}} => Element("meta", [("property", meta.name), ("content", meta.content)])
      {meta: Meta} => Element("meta", [("name", meta.name), ("content", meta.content)])

      {link: UI.Link} => Element("a", [Named(link), ("href", link.to as String), ("target", "_blank") if link.window == new, ("rel", "noopener noreferrer") if link.window == new], link.children)
      {text: Geometry.Text{role == heading && font.size >= 2em}} => Element("h1", [Named(text)], [Pieces(text)])
      {text: Geometry.Text{role == heading && font.size >= 1.5em}} => Element("h2", [Named(text)], [Pieces(text)])
      {text: Geometry.Text{role == heading}} => Element("h3", [Named(text)], [Pieces(text)])
      {text: Geometry.Text{wrap == none}} => Element("span", [Named(text), ("dir", text.direction == right-to-left ? "rtl" : "ltr")], [Pieces(text)])
      {text: Geometry.Text} => Element("p", [Named(text), ("dir", text.direction == right-to-left ? "rtl" : "ltr")], [Pieces(text)])
      {image: Geometry.Image{fill}} => Element("span", [Named(image), ("role", "img"), ("aria-label", image.alt)])
      {image: Geometry.Image} => Element("img", [Named(image), ("src", image.source as String), ("alt", image.alt), ("loading", "lazy")])
      {video: Geometry.Video} => Element("video", [Named(video), ("src", video.source as String), ("controls", "") if video.controls, ("muted", "") if video.muted, ("loop", "") if video.looping])
      {audio: Geometry.Audio} => Element("audio", [Named(audio), ("src", audio.source as String), ("controls", "")])
      {frame: Geometry.Frame} => Element("iframe", [Named(frame), ("src", frame.embedded as String), ("title", frame.title), ("allow", frame.allow.join("; ")), ("allowfullscreen", ""), ("loading", "lazy"), ("referrerpolicy", "strict-origin-when-cross-origin")])
      {canvas: Geometry.Canvas} => Element("canvas", [Named(canvas), ("width", canvas.size.x as px), ("height", canvas.size.y as px)])
      {ball: Geometry.Ball} => Element("svg", [Named(ball), ("viewBox", ("0 0 ", ball.size.x as px, " ", ball.size.y as px))], [
        Element("ellipse", [("cx", "50%"), ("cy", "50%"), ("rx", "50%"), ("ry", "50%")])
      ])
      {polygon: Geometry.Polygon} => Element("svg", [Named(polygon), ("viewBox", ("0 0 ", polygon.size.x as px, " ", polygon.size.y as px))], [
        Element("polygon", [("points", polygon.points.map(.x as px, ",", .y as px).join(" "))])
      ])
      {outline: Geometry.Outline} => Element("svg", [Named(outline), ("viewBox", ("0 0 ", outline.size.x as px, " ", outline.size.y as px))], [
        Element("path", [("d", ("M", outline.from.x as px, " ", outline.from.y as px, outline.segments.map(Path(.)), " Z" if outline.closed))])
      ])
      {path: Path{segment ==.instance_of Geometry.Quadratic}} => path.segment -- (" Q", .control.x, " ", .control.y, " ", .to.x, " ", .to.y)
      {path: Path{segment ==.instance_of Geometry.Cubic}} => path.segment -- (" C", .first.x, " ", .first.y, " ", .second.x, " ", .second.y, " ", .to.x, " ", .to.y)
      {path: Path{segment ==.instance_of Geometry.Arc}} => path.segment -- (" A", .radius.x, " ", .radius.y, " ", .rotation, " ", .large ? 1 : 0, " ", .sweep ? 1 : 0, " ", .to.x, " ", .to.y)
      {path: Path} => " L", path.segment.x, " ", path.segment.y

      {form: UI.Form} => Element("form", [Named(form)], form.inputs)
      {input: UI.TextField} => Element("input", [Named(input), ("type", "text"), Entry(input)])
      {input: UI.Secret} => Element("input", [Named(input), ("type", "password"), Entry(input)])
      {input: UI.NumberField} => Element("input", [Named(input), ("type", "number"), Entry(input)])
      {input: UI.DateField} => Element("input", [Named(input), ("type", "datetime-local"), Entry(input)])
      {input: UI.ColorField} => Element("input", [Named(input), ("type", "color"), Entry(input)])
      {input: UI.FileField} => Element("input", [Named(input), ("type", "file"), Entry(input)])
      {input: UI.Checkbox} => Element("input", [Named(input), ("type", "checkbox"), Entry(input)])
      {input: UI.Slider} => Element("input", [Named(input), ("type", "range"), Entry(input), ("min", input.chosen.type.least as String), ("max", input.chosen.type.most as String)])
      {input: UI.TextArea{language}} => Element("div", [("id", input.id), ("class", ["painted", input.styles].flatten.join(" "))], [
        Element("pre", [("id", input.id + "-paint"), ("aria-hidden", "true")], [Pieces(input.face)]),
        Element("textarea", [("id", input.id + "-text"), ("placeholder", input.placeholder), ("spellcheck", "false")], [Text(input.empty ? "" : input.value as String)])
      ])
      {input: UI.TextArea} => Element("textarea", [Named(input), ("placeholder", input.placeholder)], [Text(input.empty ? "" : input.value as String)])
      {input: UI.Select} => Element("select", [Named(input)], input.options.map(Element("option", [("value", . as String)], [Text(. as String)])))

      {box: Geometry.Shape{activate}} => Element("button", [Named(box), Described(box)], box.children)
      {box: Geometry.Shape{role == table}} => Element("table", [Named(box), Described(box)], box.children)
      {box: Geometry.Shape{role == list}} => Element("ul", [Named(box), Described(box)], box.children)
      {box: Geometry.Shape{role == region}} => Element("section", [Named(box), Described(box)], box.children)
      {box: Geometry.Shape} => Element("div", [Named(box), Described(box)], box.children)

      {named: Named} => [("id", named.shape.id), ("class", named.shape.styles.join(" ")) if named.shape.styles.nonempty]
      {described: Described} => [("role", described.shape.role as String), ("aria-label", described.shape.label) if described.shape.label, ("popover", "manual") if described.shape.position.kind == anchored]
      {entry: Entry} => [("placeholder", entry.input.placeholder), ("disabled", "") if entry.input.disabled]
      {pieces: Pieces{text.runs.empty}} => Text(pieces.text.text)
      {pieces: Pieces} => pieces.text.pieces.map(Piece(.text, .run))
      {piece: Piece{run}} => Element("span", [("style", Inline(piece.run))], [Text(piece.text)])
      {piece: Piece} => Text(piece.text)
      {inline: Inline} => inline.run -- (run => [("color:", CSS.Paint(run.color), ";") if run.color, ("background:", CSS.Paint(run.fill), ";") if run.fill, ("font-weight:", run.font.weight, ";") if run.font, ("font-style:", run.font.style as String, ";") if run.font])
    }

    written := {
      {document: Document} => "<!doctype html><html lang=\"", document.language, "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">", document.head, "</head>", document.body, "</html>"
      {element: Element{void}} => "<", element.tag, element.attributes.map(" ", .name, "=\"", escaped(.value as String), "\""), ">"
      {element: Element} => "<", element.tag, element.attributes.map(" ", .name, "=\"", escaped(.value as String), "\""), ">", element.children, "</", element.tag, ">"
      {text: Text} => escaped(text.text)
      {raw: Raw} => raw.text
    }
    language = Language.register(Language(".html", writer: (node) => Compiler.reduced(node, written) as String))

    level := UI.Rendering + {
      {solved: Geometry.Solved} => Page(solved.shape)
    } + rules
  }

  CSS := class {
    Rule := class = selector: String, declarations: (property: String, value: String)[], within: String?
    Keyframes := class = name: String, frames: (at: Probability, declarations: (property: String, value: String)[])[]
    Sheet := class = rules: (Rule | Keyframes)[] = []

    Page := class = shape: Geometry.Shape
    Styles := class = shape: Geometry.Shape
    Anchoring := class = shape: Geometry.Shape, scene: Geometry.Shape
    Layout := class = shape: Geometry.Shape
    Width := class = constraint: Geometry.Constraint
    Height := class = constraint: Geometry.Constraint
    Aligned := class = constraint: Geometry.Constraint
    Spaced := class = name: String, edges: Geometry.Edges
    Positioned := class = shape: Geometry.Shape
    Effected := class = effect: Geometry.Effect
    Specific := class = shape: Geometry.Shape
    Placeholder := class = shape: Geometry.Shape
    Switchable := class = shape: Geometry.Shape
    Styling := class = name: String
    Responsive := class = shape: Geometry.Shape, constraint: Geometry.Constraint
    Step := class = constraint: Geometry.Constraint, at: Geometry.Breakpoint, next: Geometry.Breakpoint?
    Chord := class = from: Geometry.Breakpoint, to: Geometry.Breakpoint
    Paint := class = value: Geometry.Paint
    Measure := class = length: Geometry.Length
    Typeface := class = font: Geometry.Font
    Timing := class = easing: Geometry.Easing
    Mask := class = image: Geometry.Image

    WhiteSpace = { normal: "normal", nowrap: "nowrap", pre: "pre", pre_wrap: "pre-wrap", pre_line: "pre-line" }
    Sides = { all: "", top: "-top", bottom: "-bottom", left: "-left", right: "-right", horizontal: "-inline", vertical: "-block" }
    Cases = { upper: "uppercase", lower: "lowercase", title: "capitalize" }

    values := {
      {paint: Paint{value ==.instance_of Geometry.Inherited}} => "currentColor"
      {paint: Paint{value ==.instance_of Geometry.Color}} => "rgba(", paint.value.red, ",", paint.value.green, ",", paint.value.blue, ",", paint.value.alpha, ")"
      {paint: Paint{value ==.instance_of Geometry.Gradient}} => paint.value.kind as String, "-gradient(", (paint.value.angle, "turn,") if paint.value.kind == linear, paint.value.stops.map(("," if .index > 0), Paint(.color), " ", .at * 100, "%"), ")"
      {paint: Paint{value ==.instance_of Geometry.Pattern}} => "url(#", paint.value.shape.id, ")"
      {measure: Measure{length ==.instance_of Number}} => measure.length, "px"
      {measure: Measure{length.quantities.count > 1}} => "calc(", measure.length.quantities.map(.quantity, .unit.symbol).join(" + "), ")"
      {measure: Measure} => measure.length.amount, measure.length.unit.symbol
    }

    rules := values + {
      {page: CSS.Page} => Sheet([
        Rule("*", [("box-sizing", "border-box"), ("margin", "0")]),
        Rule("body", [("font-family", "sans-serif"), ("line-height", "1.2")]),
        Rule(".painted", [("display", "grid")]),
        Rule(".painted>pre,.painted>textarea", [("grid-area", "1/1"), ("margin", "0"), ("padding", "0"), ("border", "none"), ("font", "inherit"), ("white-space", "pre-wrap"), ("overflow-wrap", "anywhere"), ("overflow", "hidden")]),
        Rule(".painted>textarea", [("color", "transparent"), ("caret-color", "currentColor"), ("background", "transparent"), ("resize", "none"), ("outline", "none")]),
        Rule("*", [("animation", "none"), ("transition", "none")], within: "@media (prefers-reduced-motion:reduce)"),
        Rule("html.locked", [("overflow", "hidden")]),
        page.shape.expand.map(Styles(.)),
        page.shape.expand{.position.kind == anchored}.map(Anchoring(., page.shape))
      ])
      {anchoring: Anchoring} => anchoring.shape.anchor_in(anchoring.scene) -- (anchor => [
        Rule("#" + anchor.id, [("anchor-name", "--" + anchor.id)]),
        Rule("#" + anchoring.shape.id, [("position", "fixed"), ("inset", "auto"), ("margin", "0"), ("position-anchor", "--" + anchor.id), ("position-area", anchoring.shape.position.side as String)])
      ])
      {styles: Styles} => styles.shape -- (shape => [
        Rule("#" + shape.id, [
          Layout(shape),
          ("gap", Measure(shape.gap.y), " ", Measure(shape.gap.x)),
          shape.constraints{.dimension == "x"}.map(Width(.)),
          shape.constraints{.dimension == "y"}.map(Height(.)),
          ("container-type", "inline-size") if shape.children.some(.constraints.some(.responsive)),
          Spaced("padding", shape.padding),
          Spaced("margin", shape.margin),
          Positioned(shape),
          ("background", Paint(shape.fill)) if shape.fill,
          ("border" + Sides[shape.stroke.sides], shape.stroke.width as px, "px ", shape.stroke.dash.empty ? "solid" : "dashed", " ", Paint(shape.stroke.paint)) if shape.stroke,
          ("border-radius", shape.radius.map(. as px, "px").join(" ")) if shape.radius != [0],
          ("transform", "matrix3d(", shape.transform.matrix.transposed.flatten.join(","), ")") if shape.transform != Geometry.Transform(),
          ("overflow", shape.overflow == scroll ? "auto" : shape.overflow as String),
          ("z-index", shape.layer) if shape.layer != 0,
          ("mix-blend-mode", shape.blend as String) if shape.blend != normal,
          shape.effects.map(Effected(.)),
          ("color", Paint(shape.color)) if shape.color,
          Typeface(shape.font) if shape.font,
          Specific(shape),
          ("transition", "all ", shape.transition.duration as ms, "ms ", Timing(shape.transition.easing)) if shape.transition,
          ("cursor", shape.cursor != default ? shape.cursor as String : "pointer") if shape.cursor != default || shape.activate,
          ("touch-action", (shape.touch as String).replace("_", "-")) if shape.touch != auto,
          ("scrollbar-width", "none") if shape.scrollbar == hidden
        ]),
        Placeholder(shape),
        Switchable(shape),
        Rule("#" + shape.id + ":focus-visible", [("outline", "2px solid currentColor")]) if shape.focusable,
        shape.constraints{.responsive}.map(Responsive(shape, .)),
        shape.animations.map(Keyframes(shape.id + "-" + .property, [(0, [(.property, .from as String)]), (1, [(.property, .to as String)])]))
      ])

      {layout: Layout{shape.flow == inline}} => [("display", "flex"), ("flex-wrap", layout.shape.constraints.wrap.last ? "wrap" : "nowrap")]
      {layout: Layout{shape.flow == grid}} => [("display", "grid"), ("grid-template-columns", "repeat(", layout.shape.constraints.columns.last ?? 1, ",1fr)")]
      {layout: Layout{shape.flow == layered}} => [("display", "grid"), ("grid-template-areas", "\"layer\"")]
      {layout: Layout} => [("display", "flex"), ("flex-direction", "column")]

      {width: Width} => width.constraint -- (constraint => [
        ("width", constraint.share * 100, "%") if constraint.share ==.instance_of Number,
        ("width", constraint.stops.first.share * 100, "%") if constraint.responsive,
        ("max-width", Measure(constraint.most)) if constraint.most != None,
        ("min-width", Measure(constraint.least)) if constraint.least != None,
        ("aspect-ratio", constraint.aspect) if constraint.aspect,
        Aligned(constraint)
      ])
      {height: Height} => height.constraint -- (constraint => [
        ("max-height", Measure(constraint.most)) if constraint.most != None,
        ("min-height", Measure(constraint.least)) if constraint.least != None,
        ("align-items", "center") if constraint.align == middle
      ])
      {aligned: Aligned{constraint.align == center}} => [("margin-inline", "auto")]
      {aligned: Aligned{constraint.align == end}} => [("margin-inline-start", "auto")]
      {aligned: Aligned{constraint.align == between}} => [("justify-content", "space-between")]
      {aligned: Aligned} => []

      {spaced: Spaced} => [("top", spaced.edges.top), ("right", spaced.edges.right), ("bottom", spaced.edges.bottom), ("left", spaced.edges.left)]{.1 != 0}.map((spaced.name + "-" + .0, Measure(.1)))

      {positioned: Positioned{shape.position.kind == anchored}} => []
      {positioned: Positioned} => positioned.shape -- (shape => [
        ("position", shape.position.kind as String) if shape.position.kind ==.instance_of (sticky | fixed | absolute),
        ("position", "relative") if shape.position.kind == flow && shape.children.some(.position.kind == absolute),
        [("top", shape.position.top), ("right", shape.position.right), ("bottom", shape.position.bottom), ("left", shape.position.left)]{.1 != None}.map((.0, Measure(.1)))
      ])

      {effected: Effected{effect ==.instance_of Geometry.Opacity}} => [("opacity", effected.effect.amount)]
      {effected: Effected{effect ==.instance_of Geometry.Shadow}} => effected.effect -- (shadow => [("box-shadow", ("inset " if shadow.inset), shadow.offset.x as px, "px ", shadow.offset.y as px, "px ", shadow.blur as px, "px ", shadow.spread as px, "px ", Paint(shadow.color))])
      {effected: Effected{effect ==.instance_of Geometry.Blur}} => [("filter", "blur(", effected.effect.radius as px, "px)")]
      {effected: Effected{effect ==.instance_of Geometry.Filter}} => [("filter", effected.effect.kind as String, "(", effected.effect.amount, ")")]
      {effected: Effected} => []

      {typeface: Typeface} => typeface.font -- (font => [
        ("font-family", font.family.join(",")) if font.family != Geometry.Font().family,
        ("font-size", Measure(font.size)) if font.size != Geometry.Font().size,
        ("font-weight", font.weight) if font.weight != Geometry.Font().weight,
        ("font-style", font.style as String) if font.style != normal,
        ("line-height", font.line_height) if font.line_height != Geometry.Font().line_height,
        ("text-transform", Cases[font.case]) if font.case != none,
        ("letter-spacing", Measure(font.tracking)) if font.tracking != 0
      ])

      {specific: Specific{shape ==.instance_of Geometry.Text}} => specific.shape -- (text => [
        ("text-align", text.align as String), ("text-overflow", text.overflow as String), ("white-space", WhiteSpace[text.white_space]), ("overflow-wrap", "anywhere") if text.wrap == anywhere
      ])
      {specific: Specific{shape ==.instance_of Geometry.Image && shape.fill}} => specific.shape -- (image => [
        ("object-fit", image.fit as String), ("display", "inline-block"), ("mask", Mask(image)), ("-webkit-mask", Mask(image))
      ])
      {specific: Specific{shape ==.instance_of Geometry.Image}} => [("object-fit", specific.shape.fit as String)]
      {specific: Specific{shape ==.instance_of Geometry.Frame}} => [("border", "0"), ("aspect-ratio", "16/9"), ("width", "100%")]
      {specific: Specific} => []

      {placeholder: Placeholder{shape ==.instance_of UI.Input && shape.placeholder_color}} => Rule("#" + placeholder.shape.id + "::placeholder", [("color", Paint(placeholder.shape.placeholder_color))])
      {placeholder: Placeholder} => []

      {switchable: Switchable{shape.dynamics.some(.target == "class")}} => UI.Theme.styles.map(style => Rule("#" + switchable.shape.id + "." + style.name, [Styling(style.name)]))
      {switchable: Switchable} => []
      {styling: Styling} => Compiler.reduced(Styles(Geometry.Box()), rules).first.declarations -- (plain => Compiler.reduced(Styles(Geometry.Box().styled(styling.name)), rules).first.declarations{!plain.contains(.)})

      {responsive: Responsive} => responsive.constraint.stops -- (stops => stops.zip([stops.rest, None]).map((at, next) => Rule("#" + responsive.shape.id,
        [("width", Step(responsive.constraint, at, next))],
        within: "@container (min-width:" + (Compiler.reduced(Measure(at.width), values) as String) + ")"
      )))
      {step: Step{constraint.share ==.instance_of Geometry.Interpolated && next}} => Chord(step.at, step.next)
      {step: Step} => step.at.share * 100, "%"
      {chord: Chord} => "calc(", chord.from.share * (chord.from.width as px), "px + (100cqw - ", chord.from.width as px, "px) * ", (chord.to.share * (chord.to.width as px) - chord.from.share * (chord.from.width as px)) / ((chord.to.width - chord.from.width) as px), ")"

      {timing: Timing{easing === Geometry.linear}} => "linear"
      {timing: Timing{easing === Geometry.ease_in}} => "ease-in"
      {timing: Timing{easing === Geometry.ease_out}} => "ease-out"
      {timing: Timing} => "ease"

      {mask: Mask{image.fit == fill}} => "url(\"", mask.image.source as String, "\") center/100% 100% no-repeat"
      {mask: Mask} => "url(\"", mask.image.source as String, "\") center/", mask.image.fit as String, " no-repeat"
    }

    written := {
      {sheet: Sheet} => sheet.rules
      {rule: Rule{within}} => rule.within, "{", Rule(rule.selector, rule.declarations), "}"
      {rule: Rule} => rule.selector, "{", rule.declarations.map(.0, ":", .[1..], ";"), "}"
      {keyframes: Keyframes} => "@keyframes ", keyframes.name, "{", keyframes.frames.map(.at * 100, "%{", .declarations.map(.0, ":", .[1..], ";"), "}"), "}"
    }
    language = Language.register(Language(".css", writer: (node) => Compiler.reduced(node, written) as String))

    level := UI.Rendering + {
      {solved: Geometry.Solved} => Page(solved.shape)
    } + rules
  }

  JSON := class {
    Object := class = entries: (name: String, value: *)[]
    Value := class = value: *
    Linked := class = value: *, context: String?

    Escapes = { "\"": "\\\"", "\\": "\\\\", "<": "\\u003c", \n: "\\n" }
    escaped (text: String) => #text.map(Escapes[.] ?? .) as String

    written := {
      {linked: Linked{value == None}} => Value(None)
      {linked: Linked{value ==.instance_of (String | Number | boolean | Location)}} => Value(linked.value)
      {linked: Linked{value ==.instance_of Iterable}} => Value(linked.value.map(Linked(.)))
      {linked: Linked} => Value(Object([("@context", linked.context) if linked.context, linked.value.fields{.value != None}.map((name: .name == "type" ? "@type" : .name, value: Linked(.value)))].flatten))
      {json: Value{value ==.instance_of Linked}} => json.value
      {json: Value{value == None}} => "null"
      {json: Value{value ==.instance_of boolean}} => json.value ? "true" : "false"
      {json: Value{value ==.instance_of Number}} => json.value as String
      {json: Value{value ==.instance_of String}} => "\"", escaped(json.value), "\""
      {json: Value{value ==.instance_of Location}} => Value(json.value as String)
      {json: Value{value ==.instance_of Object}} => "{", json.value.entries{.value != None}.map(("," if .index > 0), Value(.name), ":", Value(.value)), "}"
      {json: Value{value ==.instance_of Iterable}} => "[", json.value.map(("," if .index > 0), Value(.)), "]"
      {json: Value} => Value(Object(json.value.fields.map((name: .name, value: .value))))
    }
    write (value) => Compiler.reduced(Value(value), written) as String
  }

  JS := class {
    Module := class = statements: Statement[] = []
    Statement := Let | Assign | Effect | Listen | Call | Function | Return | If | Raw | String
    Let := class = name: String, value: Expression
    Assign := class = target: Expression, value: Expression
    Effect := class = reads: String[], body: Statement[]
    Listen := class = target: Expression, event: String, body: Statement[]
    Call := class = function: Expression, arguments: Expression[] = []
    Function := class = name: String?, parameters: String[], body: Statement[]
    Return := class = value: Expression
    If := class = condition: Expression, then: Statement[], otherwise: Statement[] = []
    Raw := class = code: String
    Member := class = object: Expression, member: String
    Operation := class = left: Expression, operator: String, right: Expression
    Literal := class = value: *
    ById := class = id: String
    Expression := String | Number | Call | Function | Raw | Member | Operation | Literal | ById

    Page := class = shape: Geometry.Shape
    Prelude := class
    Devices := class
    Updated := class = shape: Geometry.Shape, dynamic: Geometry.Dynamic
    Mirrored := class = shape: Geometry.Shape
    Typed := class = shape: Geometry.Shape
    Drawing := class = shape: Geometry.Shape
    Popping := class = shape: Geometry.Shape, scene: Geometry.Shape

    expressions := {
      {a} + {b} => Operation(a, "+", b)
      {a} - {b} => Operation(a, "-", b)
      {a} * {b} => Operation(a, "*", b)
      {a} / {b} => Operation(a, "/", b)
      {a} == {b} => Operation(a, "===", b)
      {a} < {b} => Operation(a, "<", b)
      {a} && {b} => Operation(a, "&&", b)
      {a} || {b} => Operation(a, "||", b)
      {name} = {value} => Assign(Member("ray", name), value)
      {f}({arguments}) => Call(f, arguments)
    }

    rules := {
      {page: JS.Page} => Module([
        Prelude(),
        Devices(),
        page.shape.expand.map(shape => shape.dynamics.map(Updated(shape, .))),
        UI.Watch.all.map(Call("ray.subscribe", [Literal(.watched.program.reads), Function(None, [], [.action{O: expressions}()])])),
        UI.Timer.all{!.fired}.map(Call("setTimeout", [Function(None, [], [.action{O: expressions}()]), (.due - Time.now) as ms])),
        page.shape.expand.map(Mirrored(.)),
        page.shape.expand{.focusable}.map(Listen(ById(.id), "click", [Call("ray.activate", [Literal(.id)])])),
        page.shape.expand.map(Typed(.)),
        page.shape.expand.map(Drawing(.)),
        page.shape.expand.map(Popping(., page.shape))
      ])
      {prelude: Prelude} => Function("effect", ["reads", "body"], [Call("ray.subscribe", ["reads", "body"]), Call("body")])
      {devices: Devices} => [
        Call("ray.set", [Literal("UI.Platform.handheld"), "((/Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent)||matchMedia(\"(pointer:coarse)\").matches&&!matchMedia(\"(pointer:fine)\").matches)||navigator.maxTouchPoints>1&&/Macintosh/.test(navigator.userAgent))"]),
        [("pointerdown", "down"), ("pointermove", "moved"), ("pointerup", "up"), ("pointercancel", "up")].map((event, method) => Listen("window", event, [Call("ray.call", [Literal("UI.Pointer." + method), Call("ray.pointer", ["event"]), "event.timeStamp"])])),
        Listen("window", "wheel", [Call("ray.set", [Literal("UI.Pointer.wheel"), "event.deltaY"])]),
        ["keydown", "keyup"].map(Listen("window", ., [Call("ray.key", ["event"])])),
        Listen("window", "focusin", [Call("ray.set", [Literal("UI.Focus.current"), "event.target.id"])]),
        Listen("window", "resize", [Call("ray.set", [Literal("UI.Viewport.size"), Call("ray.size")])]),
        Listen("window", "popstate", [Call("ray.set", [Literal("UI.Navigation.history"), "location.pathname"])]),
        Listen("window", "paste", [Call("ray.set", [Literal("UI.Clipboard.content"), Call("event.clipboardData.getData", [Literal("text")])])]),
        Listen("window", "drop", [Call("ray.set", [Literal("UI.Drag.dropped"), "event.dataTransfer.files"])]),
        Listen("window", "compositionupdate", [Call("ray.set", [Literal("UI.Composition.text"), "event.data"])]),
        Listen("window", "deviceorientation", [Call("ray.set", [Literal("UI.Sensors.orientation"), Call("ray.orientation", ["event"])])]),
        Listen("window", "gamepadconnected", [Call("ray.poll_gamepads")]),
        Listen("window.matchMedia(\"(prefers-reduced-motion:reduce)\")", "change", [Call("ray.set", [Literal("UI.Viewport.preferences.reduced_motion"), "event.matches"])]),
        Effect(["UI.Navigation.history"], [Call("history.pushState", [Literal(None), Literal(""), Call("ray.get", [Literal("UI.Navigation.at")])])]),
        Effect(["UI.Navigation.title"], [Assign("document.title", Call("ray.get", [Literal("UI.Navigation.title")]))]),
        Listen("window", "scroll", [Call("ray.set", [Literal("UI.Viewport.scrolled"), "window.scrollY"])]),
        Effect(["UI.Viewport.scrolled"], [Raw("const y=ray.get(\"UI.Viewport.scrolled\");if(Math.abs(scrollY-y)>1)scrollTo(0,y)")]),
        Effect(["UI.Viewport.revealing"], [Raw("const r=ray.get(\"UI.Viewport.revealing\");const e=r&&document.getElementById(r.shape.id);if(e){if(r.within||!r.offset)e.scrollIntoView({block:r.align,behavior:r.smooth?\"smooth\":\"auto\"});else scrollTo({top:e.getBoundingClientRect().top+scrollY+r.offset,behavior:r.smooth?\"smooth\":\"auto\"})}")]),
        Effect(["UI.Selection.range"], [Raw("const r=ray.get(\"UI.Selection.range\");const e=r&&(document.getElementById(r.shape.id+\"-text\")||document.getElementById(r.shape.id));if(e){if(e.setSelectionRange){e.focus();e.setSelectionRange(r.from,r.to)}else{const g=document.createRange();g.selectNodeContents(e);getSelection().removeAllRanges();getSelection().addRange(g)}}")]),
        Effect(["UI.Viewport.locking"], [Call("document.documentElement.classList.toggle", [Literal("locked"), Call("ray.get", [Literal("UI.Viewport.locking")])])]),
        Effect(["UI.Platform.notifications"], [Call("new Notification", [Call("ray.get", [Literal("UI.Platform.notifications.last.title")])])]),
        Effect(["UI.Platform.fullscreen"], [Call("document.documentElement.requestFullscreen")]),
        Effect(["UI.Platform.printing"], [Call("window.print")]),
        Effect(["UI.Clipboard.content"], [Call("navigator.clipboard.writeText", [Call("ray.get", [Literal("UI.Clipboard.content")])])])
      ]
      {updated: Updated{dynamic.target == "class"}} => Effect(updated.dynamic.reads, [Assign(Member(ById(updated.shape.id), "className"), updated.dynamic.compiled{O: expressions}())])
      {updated: Updated} => Effect(updated.dynamic.reads, [updated.dynamic.compiled{O: expressions}()])
      {mirrored: Mirrored{shape ==.instance_of UI.TextArea && shape.language}} => Listen(ById(mirrored.shape.id + "-text"), "input", [Assign(Member(ById(mirrored.shape.id + "-paint"), "textContent"), "event.target.value")])
      {mirrored: Mirrored} => []
      {typed: Typed{shape ==.instance_of UI.Input}} => Listen(ById(typed.shape.id), "input", [Call("ray.set", [Literal(typed.shape.id), "event.target.value"])])
      {typed: Typed} => []
      {drawing: Drawing{shape ==.instance_of Geometry.Canvas}} => Effect(drawing.shape.draws.reads, [Call("ray.draw", [Literal(drawing.shape.id), Literal(drawing.shape.draws.rendered(Language.Direct.level))])])
      {drawing: Drawing} => []
      {popping: Popping{shape ==.instance_of UI.Popover && shape.trigger != always}} => ById(popping.shape.anchor_in(popping.scene).id) -- (anchor => [
        ["pointerenter", "focusin"].map(Listen(anchor, ., [Call(Member(ById(popping.shape.id), "showPopover"))])),
        ["pointerleave", "focusout"].map(Listen(anchor, ., [Call(Member(ById(popping.shape.id), "hidePopover"))]))
      ])
      {popping: Popping{shape.position.kind == anchored && shape.visible}} => Call(Member(ById(popping.shape.id), "showPopover"))
      {popping: Popping} => []
    }

    written := JSON.written + {
      {module: Module} => module.statements.map(., ";")
      {binding: Let} => "let ", binding.name, "=", binding.value
      {assign: Assign} => assign.target, "=", assign.value
      {effect: Effect} => "effect(", JSON.Value(effect.reads), ",()=>{", effect.body.map(., ";"), "})"
      {listen: Listen} => listen.target, ".addEventListener(", JSON.Value(listen.event), ",(event)=>{", listen.body.map(., ";"), "})"
      {call: Call} => call.function, "(", call.arguments.map(("," if .index > 0), .), ")"
      {defined: Function} => "function ", defined.name ?? "", "(", defined.parameters.join(","), "){", defined.body.map(., ";"), "}"
      {returned: Return} => "return ", returned.value
      {branch: If} => "if(", branch.condition, "){", branch.then.map(., ";"), "}else{", branch.otherwise.map(., ";"), "}"
      {raw: Raw} => raw.code
      {member: Member} => member.object, ".", member.member
      {operation: Operation} => "(", operation.left, operation.operator, operation.right, ")"
      {literal: Literal} => JSON.Value(literal.value)
      {found: ById} => "document.getElementById(", JSON.Value(found.id), ")"
    }
    language = Language.register(Language(".js", writer: (node) => Compiler.reduced(node, written) as String))

    level := UI.Rendering + {
      {solved: Geometry.Solved} => Page(solved.shape)
    } + rules
  }

  Package := class = files: (path: String, content: *)[] {
    write (to: Location) => files.for(IO.write(to / .path, .content))
    document => files{.path == "index.html"}.first?.content
    sheet => files{.path == "style.css"}.first?.content
  }
  packaged := {
    {solved: Geometry.Solved} => Package([
      (path: "index.html", content: HTML.Page(solved.shape)),
      (path: "style.css", content: CSS.Page(solved.shape)),
      (path: "app.js", content: JS.Page(solved.shape)),
      solved.shape.expand{==.instance_of (Geometry.Image | Geometry.Video | Geometry.Audio)}.map((path: .source.name, content: .source)),
      [UI.Navigation.icon, UI.Navigation.apple_icon, UI.Navigation.manifest]{!= None}.map((path: .name, content: .))
    ].flatten)
  }
  level := UI.Rendering + packaged + HTML.rules + CSS.rules + JS.rules

  DOM := class {
    send (message) => external io `dom` (message)
    received => external io `dom` None
    line (parts: String[]) => parts.join(" "), \n

    Mount := class = node: HTML.Element | HTML.Text | HTML.Raw, parent: String?
    Listening := class = element: HTML.Element
    protocol := {
      {mount: Mount{node ==.instance_of HTML.Element}} => mount.node -- (element => [
        line(["create", element.id, element.tag]),
        element.attributes.map(line(["attribute", element.id, .name, (.value as String).escaped_line])),
        Listening(element),
        element.children.map(Mount(., element.id)),
        line(["append", mount.parent, element.id]) if mount.parent
      ])
      {mount: Mount} => line(["text", mount.parent, mount.node.text.escaped_line])
      {listening: Listening{element.tag ==.instance_of ("a" | "button")}} => [line(["listen", listening.element.id, "click"])]
      {listening: Listening{element.tag ==.instance_of ("input" | "select" | "textarea")}} => [line(["listen", listening.element.id, "input"]), line(["listen", listening.element.id, "focus"])]
      {listening: Listening} => []
    }
    mounted (element: HTML.Element) => Compiler.reduced(Mount(element), protocol) as String

    static Event := class = id: String, kind: String, value: String? {
      static parsed (line: String?) => line?.trimmed ~= (id: Char{!= " "}[], " ", kind: Char{!= " "}[], (" ", value: *)?) -- Event(id: .id, kind: .kind, value: .value) if .
      at => value ~= (x: Decimal, " ", y: Decimal, (" ", time: Decimal)?) -- (position: Geometry.Vector(.x * 1px, .y * 1px), time: .time ? .time * 1 ms : Time.now)
      shape => UI.scene?.expand{.id == id}.first
      apply => Compiler.reduced(this, DOM.applied)
    }
    applied := {
      {event: Event{kind == "click"}} => event.shape?.activate
      {event: Event{kind == "input"}} => event.shape?.set(event.value)
      {event: Event{kind == "focus"}} => UI.Focus.current = event.shape
      {event: Event{kind == "scroll"}} => UI.Viewport.scrolled = (event.value as Decimal) * 1px
      {event: Event{kind == "pointerdown"}} => UI.Pointer.down(event.at.position, time: event.at.time)
      {event: Event{kind == "pointermove"}} => UI.Pointer.moved(event.at.position, event.at.time)
      {event: Event{kind ==.instance_of ("pointerup" | "pointercancel")}} => UI.Pointer.up(event.at.position, event.at.time)
      {event: Event{kind == "keydown"}} => event.value.split(" ") -- UI.Keyboard.press(.first, shift: .contains("shift"), control: .contains("control"), alt: .contains("alt"), meta: .contains("meta"))
      {event: Event{kind == "keyup"}} => UI.Keyboard.release(event.value.split(" ").first)
      {event: Event{kind == "size"}} => event.shape && (event.value ~= (width: Decimal, " ", height: Decimal)) -- (event.shape.size = Geometry.Vector(.width * 1px, .height * 1px))
      {event: Event} => None
    }
    event => Event.parsed(received)

    render (page: Program) => write(page.rendered(Language.Web.level))
    start => send(line(["clear"])) -- ["pointerdown", "pointermove", "pointerup", "pointercancel", "keydown", "keyup", "scroll"].for(send(line(["listen", "window", .])))
    stop => None
    write (package: Package) => send(line(["clear"])) -- send(mounted(package.document.body)) -- (send(line(["style", package.sheet as CSS.language])) if package.sheet)
      -- send(line(["lock", UI.Viewport.locking as String]))
      -- UI.Viewport.revealing && send(line(["reveal", UI.Viewport.revealing.shape.id, UI.Viewport.revealing.align as String, UI.Viewport.revealing.smooth as String])) -- (UI.Viewport.revealing = None)
    read => event?.apply
    copy (text: String) => send(line(["clipboard", text.escaped_line]))
    open (to: Location) => send(line(["open", (to as String).escaped_line]))
  }

  Chromium := { }
  Firefox := { }
  Safari := {
    {rule: CSS.Rule{declarations.some(.0 == "backdrop-filter") && !declarations.some(.0 == "-webkit-backdrop-filter")}} => CSS.Rule(rule.selector, [rule.declarations, [("-webkit-backdrop-filter", rule.declarations{.0 == "backdrop-filter"}.first.[1..])]].flatten(1), rule.within)
  }
}
Language.register(Language.Web)
