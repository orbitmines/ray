    a
  }
  static parent_of (n: Node) => n.in
  static members_of (x: Node) => ((x is Node) || (x is Applied)) ? Members.fields_listed(list(), x.fields) : list()
  static holes_of (x) => Members.holes_in(Members.applied_of(x))
