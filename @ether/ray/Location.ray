// A scheme, then the authority only when "//" follows (https://www.rfc-editor.org/rfc/rfc3986#section-3)
Location := class: Hierarchy (
  (scheme: Char.Word[], ":", ("//", host: Char{!= ":" && != "/" && != "?" && != "#"}[], (":", port: Decimal)?)?)?,
  path: Char{!= "?" && != "#"}[],
  ("?", query: Query{pairs.nonempty} = Query())?,
  ("#", fragment: Char[])?
) => {
  static Query := class ((pairs: (name: Encoded, ("=", value: Encoded)?)[]).join("&")) => {
    static Encoded := class: String ((Char.Letter | Char.Digit | "-" | "_" | "." | "~" | ("+" as " ") | ("%", Hexadecimal₂)[]{length > 0} as Unicode.UTF-8)[]) => { }
    merged (changes) => Query(pairs: [pairs{!changes.fields.name.contains(.name)}, changes.fields{.value != None}.map((name: .name, value: .value as String))].flatten)
    .{literal name ^property} ^punctuation => pairs{.name == name && .value.nonempty}.last.value
  }

  static current: Location?
  segments => path.split("/"){.nonempty}
  with (changes) => Location(scheme, host, port, path, query: query.merged(changes), fragment)

  + (suffix: String | Location) => ((location as String) + ((suffix is Location ? suffix.@ : suffix) as String)) as Location
  / (segment: String) => this + "/" + segment ~~ (WARN@Location `text joined into a path may leave it` if segment ~= (*, ".." | "/", *))
  // a path into what it holds (`@me/instance`), else into the location's own path
  /{segment: Written} ^string => children.find((child) => child.name == segment) ?? (this + "/" + segment)
  { }/{segment: Written} ^string => children.find((child) => child.name == segment) ?? (this + "/" + segment)
  { }{value} => this + value if location as String ~= ("/" | "@" | "=" | "?" | "&" | "#") ⊣
  { }.{piece: Written} ^string => this + "." + piece
  == (other) => location as String == (other is Location ? other.@ : other) as String
  // a location is where it is; what is held there is `held`
  location => this
  held => location as String as Held

  shadowing: Location?
  [name: String] => fields{.name == name}.last.value ?? (shadowing ?? parent)?[name]

  name => segments.last ?? ""
  files => children.nonempty ? children.map(.files).flatten : [this]
  at (relative: String) => relative.split("/"){.nonempty}.reduce(held = this => held.children.find(.name == .))
  placed (relative: String, bytes): static => relative.split("/"){.nonempty} -- (segments =>
    (children.find(.name == segments.first) ?? add(Location(path: (path, segments.first){.nonempty}.join("/"), content: segments.count == 1 ? bytes : None)))
      -- (next => segments.count == 1 ? next : next.placed(segments.rest.join("/"), bytes)))
    -- this
}
// What is at a location. Mentioning `@x` is what is held there: a location while it is used as one (`/`, `name`,
// `segments`, `children`, `==`), and read when it is used as anything else (`@/etc/hosts as String`, `as Byte[]`,
// `as Program`; as a boolean, whether anything is held there). `@x = value` writes it, `@x = None` removes it,
// `@new = @x` copies it, `@x(…)` executes it (whatever code is given between the brackets goes along), and `(@./x).@`
// is the location itself. What holds it is what its space is reserved to
// (`@/ => FileSystem.Host()` in @ether/filesystem, the schemes in @ether/network); nothing loaded holds it: nothing is held.
Held := class: Location {
  location => Location(scheme, host, port, path, query, fragment)
  holder => Compiler.reduced(location, FileOptimizations) -- (. is Location ? FileSystem() : .)
  + (suffix) => (location + suffix) as String as Held
  as (=== boolean) => holder[location] != None
  ({args}) => holder(location, args)
  as (type) => holder[location] as type
  // a directory holds its entries
  children => (holder[location] as Location[] ?? []).map(entry => (entry as String as Held) ~~ (.parent = this))
}
{held: Held} = {value} ^punctuation => held.holder[held.location] = (value is Held ? value.holder[value.location] : value)
Directory := Held{holder[location] is Location[]}
Executable := Location{access is Access(method: `()`)}

Written := (Char{!= " " && != "(" && != ")" && != "," && != "{" && != "}" && != \n} | ("(", Written, ")"))[]
@{scheme: Char.Word[]}://{rest: Written} ^string => (scheme + "://" + rest) as Held
@"{text: (!"\"")[]}" ^string => text as Held
@{start: ("." | "..")?}/{path: Written} ^string => (start + "/" + path) as Held
// a Windows drive (`@C:/…`): a letter and ":" (https://url.spec.whatwg.org/#windows-drive-letter)
@{drive: Char.Letter}:/{path: Written} ^string => (drive + ":/" + path) as Held
@{name: Char.Word[]}/{path: Written} ^string => (name + "/" + path) as Held
