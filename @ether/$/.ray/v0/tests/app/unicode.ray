// Unicode: what fits in how many bits, what is a scalar, and what a character
// is a kind of.

mark ^keyword := external global

unless (Unicode.fits(ten, ten + six)) { INFO@mark `UN1 ten does not fit in sixteen bits` }
if (Unicode.fits((two * ten) + one, four)) { INFO@mark `UN2 twenty-one fits in four bits` }
unless (Unicode.scalar(ten)) { INFO@mark `UN3 ten is not a scalar` }
if (Unicode.surrogate(ten)) { INFO@mark `UN4 ten is a surrogate` }

digit := String.of(`1`).first
unless (exists Unicode.category(digit)) { INFO@mark `UN5 a digit has no kind` }
unless (Unicode.category(digit) == Unicode.GeneralCategory.number) { INFO@mark `UN6 a digit is not a number` }

space := String.of(` `).first
unless (Unicode.category(space) == Unicode.GeneralCategory.separator) { INFO@mark `UN7 a space does not separate` }

unless (exists Unicode.GeneralCategory.letter) { INFO@mark `UN8 there is no letter to be` }
unless (Unicode.category(String.of(`a`).first) == Unicode.GeneralCategory.letter) { INFO@mark `UN9 a letter is not a letter` }

// What a character is a kind of, told apart from what it is not.
letter := String.of(`a`).first
if (Unicode.category(letter) == Unicode.GeneralCategory.number) { INFO@mark `UN10 a letter is a number` }
if (Unicode.surrogate(ten)) { INFO@mark `UN11 ten is a surrogate` }
if (Unicode.fits(ten, three)) { INFO@mark `UN12 ten fits in three bits` }
unless (Unicode.UTF8.decode(Unicode.UTF8.encode(ten + five)) == (ten + five)) { INFO@mark `UN13 fifteen does not come back from UTF-8` }

// UTF-32 is the codepoint written out in thirty-two bits, and reading it back
// gives what was written. The codepoints asked about here are small on
// purpose: a number is a walk, so a letter costs its ninety-seven steps and
// a surrogate half its fifty-five thousand.
unless (Unicode.UTF32.decode(Unicode.UTF32.encode(ten)) == ten) { INFO@mark `UN14 ten does not come back from UTF-32` }
unless (Unicode.UTF32.decode(Unicode.UTF32.encode(zero)).is_zero) { INFO@mark `UN15 zero does not come back from UTF-32` }
unless (Unicode.UTF16.decode(Unicode.UTF16.encode(ten)) == ten) { INFO@mark `UN16 ten does not come back from UTF-16` }


// What fits in how many bits: a codepoint fits in as many bits as it takes,
// and in any more, and in no fewer.
unless (Unicode.fits(one, one)) { INFO@mark `UN18 one does not fit in one bit` }
if (Unicode.fits(two, one)) { INFO@mark `UN19 two fits in one bit` }
unless (Unicode.fits(two, two)) { INFO@mark `UN20 two does not fit in two bits` }
unless (Unicode.fits(zero, one)) { INFO@mark `UN21 zero does not fit in one bit` }


// The kinds a character is told apart from one another.
if (Unicode.category(String.of(`1`).first) == Unicode.GeneralCategory.letter) { INFO@mark `UN26 a digit is a letter` }
if (Unicode.category(String.of(` `).first) == Unicode.GeneralCategory.letter) { INFO@mark `UN27 a space is a letter` }
unless (Unicode.GeneralCategory.components.count == six) { INFO@mark `UN29 there are other than six kinds` }

// The bits between two places of a chain of bits, counted from zero.
eight_bits := bits_of(five, eight)
unless (eight_bits.slice_bits(zero, four).count == four) { INFO@mark `UN30 four bits taken off eight are other than four` }
unless (eight_bits.slice_bits(four, eight).count == four) { INFO@mark `UN31 the four bits after them are other than four` }
unless (eight_bits.slice_bits(zero, eight).count == eight) { INFO@mark `UN32 all of eight bits are other than eight` }
if (eight_bits.slice_bits(two, two).nonempty) { INFO@mark `UN33 the bits between a place and itself are something` }

// spec: where the surrogates begin is not claimed here — D800 is fifty-five
// thousand, and a number is a walk, so building it once costs more than the
// whole file.

// Where the tables are read from, when they are read.
unless (Unicode.tables_at.starts_with(String.of(`https`))) { INFO@mark `UN36 the tables are not read over the web` }
