// Optimizations of any program, before any back end: levels of rules from a Program to a Program, each answering what the
// program answers, each removable by name (Design §20.1: a level is a scope of rules). A back end's level comes after them
// (`$/Wasm.project.ray`: `Compiler.default + Wasm.none`).
Compiler := class {
  // What a level's rules ask of the code they read: each a Program, the code as it is written (its structure, what reads it),
  // matched by its shape. `~=` on a Program reads through what its code applies, each rule of it as written, so a call
  // reaches its body; an external a level replaces is what that level makes of it.
  // (what it does outside what it makes: says, reads or writes outside it, styles, changes the level it is read with)
  Effect := `external output` | `external include` | `external read` | `external style` | `external level_in` | `external level_out` | `external dynamic_in` | `external dynamic_out` | (`external member (`, *, `) (`, *, `) (`, *, `)`)
  // (a jump of it, and where to)
  Jump := (`external goto `, target: *, \n | ⊣)
  // (what does nothing outside what it makes: no effect, and every jump to a label written in it)
  Effectless := Program{!~= Effect && Compiler.jumps_within(.)}
  static jumps_within (code) => (code ~= Jump)#.every((jump) => code ~= (`external label `, jump.target))
  // (what reads what changes: a name given again, what is read from outside)
  Changing := (*, ` = `, *) | `external read`
  // (what answers the same for the same arguments, and nothing else happens: pure, as in mathematics)
  Pure := Effectless{!~= Changing}
  // (a value written as it is, and what is made of those alone)
  Literal := Decimal.String | ("\"", Unquoted[], "\"") | `true` | `false` | `None`
  Known := Literal | Pure{!~= Name}
  assert Program(code: { 1 + 2 }) is Pure  // CO50 two numbers added are not pure
  assert !(Program(code: { external output `x` }) is Effectless)  // CO51 what says something does nothing outside it
  assert !(Program(code: { x = 2 }) is Pure)  // CO52 a name given again is pure

  none := {
    {value} => value
  }
  // A level is which rules are in scope while a program is read back
  assert Compiler.none  // CO19 there is no level that reads a program as it is written

  // A number given what leaves it as it is: the number (a value of another class, with its own `+`, as written)
  folding := {
    {a: Number} + 0 => a
    0 + {a: Number} => a
    {a: Number} - 0 => a
    {a: Number} * 1 => a
    1 * {a: Number} => a
    {a: Number} / 1 => a
  }
  assert 5 + 0 == 5  // CO1 five and nothing is not five
  assert 0 + 5 == 5  // CO2 nothing and five is not five
  assert (0 + 0).is_zero  // CO13 nothing and nothing is not nothing
  // What is not written as one of those is untouched
  assert 5 + 2 == 7  // CO14 five and two is not seven
  assert 5 + 0 == 5  // CO18 five and a name holding nothing is not five
  assert {
    folded := 5
    assert (Program(code: { (folded + 0) === folded }){O: Compiler.folding})()  // CO42 a number and nothing is not the number itself under folding (the rule did not apply)
    Own_plus := class {
      compounds + (other) => "plus"
    }
    assert (Program(code: { Own_plus() + 0 }){O: Compiler.folding})() == "plus"  // CO43 a value with its own + was taken for a number
  }

  // A boolean negated twice: the boolean
  logic := {
    !!{a: boolean} => a
  }
  assert (Program(code: { !!true }){O: Compiler.logic})() === true  // CO44 true negated twice is not true under logic

  // Lists made only to be read again: none made (a list's own, an Array's; a value of another class, with its own `map`,
  // as written)
  fused := {
    {a: Array}.reverse.reverse => a
    {a: Array}.unique.unique => a.unique
    {a: Array}.compact.compact => a.compact
    {a: Array}.sort.sort => a.sort
    {a: Array}.map({f: Effectless}).map({g: Effectless}) => a.map((x) => g(f(x)))
    {a: Array}.map({f: Effectless}).count => a.count
    {a: Array}.sort({k: Pure}).last => a.max_by(k)
    {a: Array}.sort({k: Pure}).first => a.min_by(k)
    {a: Array}.reverse.first => a.last
    {a: Array}.reverse.last => a.first
    {a: Array}{`{`}{p: Effectless}{`}`}.first => a.find((x) => x.({p}))
    {s: Superposed}{`{`}{p: Effectless}{`}`}#.first => s.components.find((x) => x.({p}))
  }
  assert {
    twice_reversed := [1, 2]
    assert twice_reversed.reverse.reverse === twice_reversed  // CO38 a list reversed twice under the default level is a copy (the rule did not apply)
  }
  assert [3, 1, 2].sort.sort == [1, 2, 3]  // CO39 sorted twice under the default level is not sorted
  assert [1, 1, 2].unique.unique == [1, 2]  // CO40 unique twice under the default level is not unique
  assert [[1], [2]].flatten.flatten == [1, 2]  // CO29 flattened twice is not flattened once
  assert {
    Own_reverse := class {
      reverse => "reversed"
    }
    assert Own_reverse().reverse.reverse == "desrever"  // CO41 a class's own reverse, reversed twice, was taken for a list's
  }
  assert [1, 2, 3].map((x) => x + 1).map((x) => x * 2) == [4, 6, 8]  // CO53 two maps fused do not answer what they did one after the other

  // What nothing reads, made only when something does: a statement that does nothing outside what it makes and is not the
  // last, a name given what does nothing outside and read nowhere after; a style where nothing paints; where a value was
  // written, where nothing asks
  demanded := {
    {statement: Effectless}\n{rest} => rest
    {name} := {value: Effectless}\n{rest: Program{!~= `{name}`}} => rest
  }
  unpainted := {
    {shown} {`^`}{style} => shown
  }
  unlocated := {
    {located} @ {location} => located
  }

  memoised := {
    remembered := {}
    assert Compiler.memoised.remembered.fields.count == 1  // CO36 a pure application with the same arguments is not remembered once
    {f: Pure}({arguments: Known}) => remembered[(f, arguments)] ??= f(arguments)
  }
  // A pure application is remembered by its arguments; the level is removable
  assert Compiler.memoised  // CO33 there is no memoising level

  // Staging: what is known at build is worked out there: an operator on two known values, what it answers; a branch on a known
  // condition, the branch taken
  staged := {
    {a: Known} {operator} {b: Known} => ({a}) {operator} ({b})
    if true {then} else {otherwise} => then
    if false {then} else {otherwise} => otherwise
    if false {then} => None
  }
  assert (@ray 2 + 3) as Program{O: Compiler.staged} == (@ray 5)  // CS1 two known values added are not worked out at build
  assert (@ray if true { f() } else { g() }) as Program{O: Compiler.staged} == (@ray f())  // CS3 a known branch is not the branch taken
  // Control flow written by other control flow, so a back end has fewer to write
  lowered := {
    unless {condition} {then} => if !condition {then}
  }
  assert (@ray unless c { f() }) as Program{O: Compiler.lowered} == (@ray if !c { f() })  // CS2 unless is not written as if
  // A function written where it is applied: its parameters given what it is applied to, its body there; a block that declares
  // nothing, its statements where it is
  inlined := {
    (({parameters}) => {body})({arguments}) => {
      ({parameters}) := ({arguments})
      {body}
    }
    {`{`}{block: Program{!~= ` := `}}{`}`} => block
  }
  // What is never reached: after a return
  pruned := {
    return {value}\n{unreached} => return value
  }

  // The level the language is read with: each of these
  default := folding + logic + fused + lowered + pruned
  assert Compiler.default !== None  // CO20 there is no default level

  levels => [none, default, folding, logic, fused, demanded, unpainted, unlocated, memoised, staged, lowered, inlined, pruned]
  assert Compiler.levels.count == 13  // CO32 there are other than thirteen levels
  assert Compiler.levels.contains(Compiler.memoised)  // CO34 the memoising level is not one of the levels

  // (a level made of two, `A + B`: reduced by the first, then what that gives by the second)
  // (the value read where it is given, then reduced: not the code that gives it read at the level)
  // (a value, read by the level's own rules: one of one hole whose type it is (`{text: String} => …`) takes it)
  static reduced (value, level) => value -- (reduced_value => (level is Compiler.Composition) ? Compiler.reduced(Compiler.reduced(reduced_value, level.components.hierarchy.first), level.components.hierarchy.last) : ((external level_reads level reduced_value) ?? (level reducing reduced_value)))
  // (a level as a scope, what the language is read with: one made of each of its parts, the first's rules seen first)
  static scope_of (scope_level) => (scope_level is Compiler.Composition) ? level_scope_of(scope_level) : scope_level
  // (a closure run with a level in scope: its code read with the level's rules first, in this thread, until it answers)
  static run_under (run_closure, run_level) => {
    external level_in Compiler.scope_of(run_level)
    run_answer := run_closure()
    external level_out
    run_answer
  }
  Composition := class (first, second) => {
    components => (hierarchy: [first, second])
    // (and another after it, `A + B + C`: the three, in that order)
    compounds + (other) => Compiler.Composition(this, other)
    // (called: what was added, called)
    {this}({arguments}) =>
      (this).second({arguments})
    {this}() =>
      (this).second()
  }
}
Node &+= {
  composed (other) => Compiler.Composition(this, other)
  // (§3.2 `A + B`, what has no `+` of its own: the two composed, a level of them (reduced by A, then B); led by the value,
  // read only on one: `+ 1` alone is a section)
  {this} + {other} => (this).composed(other)
}
// (of a composition, `A + B`: a scope of its own given each part's rules, the second's, then the first's, so the first's are
// seen first; a node made of nothing else, what a function called bare (not in a method, which would make it of what that
// method is read on) makes to run in, each time: not made of Node, whose rules would be read first everywhere)
level_scope (level_none) => (.)
level_scope_of (scope_level) => level_scope_given(level_scope(None), scope_level)
level_scope_given (scope_made, scope_level) => (scope_level is Compiler.Composition) ? level_scope_given(level_scope_given(scope_made, (scope_level).second), (scope_level).first) : ((scope_made) &+= (scope_level))
// A program written as code, `Program(code: { … })`: the code kept as written, read when it runs (a block given to it is
// read where it is written, into a node: nothing to run again)
Program(code: {`{`}{program_code}{`}`}) ^keyword => Program(running: (() => ({program_code})))
// (a setting, `p{O: level}`: the same program (of the class, a new one), read with that level)
{setting_of}{`{`}O: {level}{`}`} ^punctuation => Program(code: (setting_of).code, running: (setting_of).running) ~~ (.O = ({level}))
// (and written with its level, `Program(code: { … }){O: L}`: its code read on L when it runs, L's rules seen in that code and not in
// what it calls)
Program(code: {`{`}{program_code}{`}`}){`{`}O: {program_level}{`}`} ^keyword => Program(running: (() => (Compiler.scope_of({program_level})).({program_code})), read_on_level: true) ~~ (.O = ({program_level}))
Program &+= {
  O | optimizations := Compiler.none
  read_on_level := false
  assert (Program{O: Compiler.default}).(
    .  // CO21 a program read with a level is nothing
    & .O == Compiler.default  // CO22 it does not say which rules it is read with
    & .optimizations  // CO23 O is not what the optimizations are called
  )
  assert {
    twice := (x) => x * 2
    assert Program(code: { twice(4) + twice(4) }){O: Compiler.memoised}() == 16  // CO35 a remembered application does not answer what it answered
  }
  assert {
    shouted := { {a} !!! => a * 100 }
    assert (Program(code: { 3 !!! }){O: shouted})() == 300  // CO36 a program is not read with its level's rules
    assert (Program(code: { 2 + 3 }){O: shouted})() == 5  // CO37 a program read with a level does not read the language too
  }
  assert {
    boxed := { {text: String} => 7 }
    assert Compiler.reduced("Ray", boxed) == 7  // CO46 a value is not read by a level's rule of one hole of its type
    assert Compiler.reduced(3, boxed) == 3  // CO47 a value of another type is read by a level's rule of one hole
  }
  // (its code run with its level's rules in scope (in its program, above what is where it is written), what it gives read by them)
  // (the code as it is written, kept to be read again when it runs (`running`, none until given: a block is read where it is
  // written, into a node))
  {this}() => ((this).running === None) ? (this).code : (((this).O === Compiler.none) ? (this).running() : Compiler.reduced(((this).read_on_level === true) ? (this).running() : Compiler.run_under((this).running, (this).O), (this).O))
  compounds + (other: Program) => Program(code: (code, other.code))
  assert 5 /* nothing */ + 1 == 6  // GR8 a block comment between operands is read as something
  assert {
    {start} - {once} - {twice} => (start - once) - twice
    assert 10 - 2 - 3 == 5  // PR1 ten less two less three is not five
    assert (10 + 10) - 4 - 6 == 10  // PR2 twenty less four less six is not ten
  }
  assert 1 + 2 == 3  // PR7 one and two is not three
  assert 1 + 2 + 3 == 6  // PR12 three added is not six
  assert 2 * 3 + 1 == 7  // PR23 two times three and one is not seven
  assert 1 + 2 * 3 == 7  // PR24 one and two times three is not seven
  assert 1 + 2 < 4  // PR28 one and two is not below four
  assert !(4 < 1 + 2)  // PR29 four is below one and two
  assert 1 + 2 == 3  // PR30 one and two is not three
  assert 3 == 1 + 2  // PR31 three is not one and two
  assert 1 + 2 >= 3  // PR33 one and two is not at least three
  assert !(1 + 2 > 4)  // PR34 one and two is above four
  assert 4 >= 1 + 2  // PR35 four is not at least one and two
  assert "a" + "b" == "ab"  // S6 a + b != ab
  assert "ab" + "c" == "abc"  // S61 ab and c do not make abc
}
assert Program(code: { 5 }).(
  .O == Compiler.none  // CO24 a program does not read as written unless told otherwise
  & .() == 5  // CO25 a program read as it is written does not answer it
)

assert !!5 == true  // CO31 not not five is not true

// (what the bootstrap leaves to this file: it needs what is here)
Cases := Program{written.nonempty && written.every(.code ~= (*, " => ", *))}
assert {
  matched := if 2 {
    1 => "one"
    2 => "two"
  }
  assert matched == "two"  // NOD54 a case on a value does not take the arm that matches
  assert !(matched == "one")  // NOD55 a case took the first arm that does not match
  other := if 9 {
    1 => "one"
  } else {
    "other"
  }
  assert other == "other"  // NOD56 a case with no matching arm does not take the else
}
if &+= {
  { }{subject} {{cases: Cases}} else {{otherwise}} ^keyword => Compiler.reduced(subject, (Program(code: cases**) as Compiler) + Program(code: otherwise**).otherwise)
  { }{subject} {{cases: Cases}} ^keyword => Compiler.reduced(subject, Program(code: cases**) as Compiler)
}
Program &+= {
  as (=== Compiler) => Program(code: written.map**(.code ~= (case: *, " => ", value: *) -- (arm => "{subject_of_case: ", (arm.case ~= ("is ", type: *)).type
    ?? ((arm.case as Program)() is Section ? ("*{", arm.case, "}") : ("*{== ", arm.case, "}")), "} => ", arm.value)).join(\n))
  otherwise => ("{subject_of_case: *} => (", code, ")") as String as Program as Compiler
}
String &+= {
  escaped_line => #.map(Compiler.reduced(., Escape⁻¹)) as String
}
// The level the language is read with, unless a project said otherwise: the default.
external member (global) (`O`) ((O === None) ? Compiler.scope_of(Compiler.default) : O)
