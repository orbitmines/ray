Access := class = who: *?, method: *? {
  static reads (method) => method != `=` && method != `()`

  reading => !method
  allows_method (called) => reading ? reads(called) : called == method

  { }{target} ^punctuation => Permissions.current.grant(this, target)
}

Accessor := class = level: Permission, method: *?, any = true {
  static Permission := enum private (at: @private) | confidential | protected | public (at: @public) | local (at: @local) | localhost (at: @localhost) | managed (at: @private.managed) {
    reaches (who) => this == confidential ? Visibility.policy.reaches(who) : at && who ==.instance_of at
  }

  static default_policy => Accessor(Visibility.default_privacy_policy)
  static confidential => default_policy

  read => Accessor(level, any: false)
  write => on(`=`)
  execute => on(`()`)
  on (method) => Accessor(level, method, any: false)

  covers (called) => any || Access(method: method).allows_method(called)
  allows (who: Character, called) => !covers(called) || level.reaches(who) || who.permissions.contains(level)

  { }{target} ^punctuation => target ~~ .access = this
  block (values: *[]) => values ~~ #.access = this
  derived (from) => from.access ?? this

  static Consistency := class = replicas: *[] = [] {
    read (value) => replicas.every(.synced) ? value : Quest(name: "wait for the replicas", goal: value)
  }
}

Visibility := class {
  policy = Accessor.Permission.local

  default_privacy_policy => policy
  confidential => policy
  set_policy (level: Accessor.Permission) => policy = level

  of (item) => item ? item.access?.level ?? of(item.parent) : policy
  openness (level: Accessor.Permission) => level == Accessor.Permission.confidential
    ? openness(policy)
    : Accessor.Permission.(local, localhost, managed, private, protected, public).index_of(level)
  narrowest (levels: Accessor.Permission[]) => levels.min(openness(.)) ?? policy
  derived (sources) => narrowest(sources.map(of(.)))

  mark (value, sources) => value ~~ .access = Accessor(derived(sources))
  local (value) => value ~~ .access = Accessor(Accessor.Permission.local)
  may_leave (value) => of(value) != Accessor.Permission.local
  readable (item, who: Character) => of(item).reaches(who) || who.permissions.contains(of(item))
}

Capability := enum network | io | os | random | time

Grant := class = access: Access, target: * {
  covers (who: Character, method, target) => (access.who == who || who ==.instance_of access.who) && access.allows_method(method) && this.target === target
}

Permissions := class = grants: Grant[] = [] {
  static current = Permissions()

  grant (access: Access, target) => {
    grants.push Grant(access, target)
    target
  }
  allows (who: Character, method, target) => grants.some(.covers(who, method, target))
}

Run := class = actor: Character?, origin: Character[] = [], settings: Settings? {
  static Mode := enum full | abstract | refused
  static current = Run()

  originating (character: Character) => Run(actor, origin: (origin, character), settings)
  hops | chain => origin.contains(actor) ? origin : (origin, actor)
  first => hops.first
  last => hops.last

  may (method, target) => hops.every(Permissions.current.allows(., method, target))
  ask (method, target) => may(method, target) ? true : Quest(name: prompt, goal: Grant(Access(origin.first, method), target))

  static called (character: Character) => character.PREFIX + character.name
  prompt => called(origin.first) + " wants to run this"
    + (origin.count > 1 ? ", originating from " + origin[1..].map(called(.)).join(" <- ") : "")

  mode (method) => (settings ?? Settings()).mode(method)

  static Settings := class = speculated: *[] = [], refused: *[] = [] {
    speculate (place): static => this ~~ speculated.push place
    refuse (place): static => this ~~ refused.push place
    mode (method) => refused.contains(method) ? Mode.refused
      : !Effects.io(method) || speculated.contains(method) ? Mode.full
      : Mode.abstract
  }
}

&@ ^keyword => Run.current

Effects := class {
  static Source := enum io | os | random | time | network

  source_of (called) => called.is_external ? {
    "io": Source.io, "os": Source.os, "random": Source.random, "time": Source.time
  }[called.external_name] : None

  of (program, visited: *[] = []) => {
    return [] if visited.contains(program)
    visited.push program
    reached = program.calls.reduce([]) (sources, called) => sources, source_of(called) ?? of(called**, visited)
    reached.unique
  }

  io (method) => of(method**).some([Source.io, Source.os, Source.network].contains(.))
  pure (method) => of(method**).empty
  deterministic (method) => of(method**).every(![Source.random, Source.time, Source.io].contains(.))
  nondeterministic (method) => !deterministic(method)
  initializer (method) => method**.calls.every(.is_external && (.external_name == "declare" || .external_name == "assign"))

  asserted (method, claim) => {
    holds = claim == `pure` && pure(method)
      || claim == `deterministic` && deterministic(method)
      || claim == `nondeterministic` && nondeterministic(method)
    ERROR@method `this method is not what it is marked as` unless holds
    holds
  }
}
