  // (how long the text is with each name taken, written to out unless it is 0)
  static spliced_into (t: Text, cap: Text, oe, l, out) => {
    n := 0
    q := t.from
    m := None
    while q < t.to {
      m = (at_text(q, t.to, cap.from, oe) != 0) ? Splices.match_at(q, t.to, cap, oe, l) : None
      n = (m === None) ? Splices.byte_copied(out, n, q) : Splices.taken_copied(out, n, m)
      q = (m === None) ? (q + 1) : Splices.past_of(m)
    }
    n
  }
  static past_of (m: Taken) => m.past
  static match_at (q, e, cap: Text, oe, l) => Splices.single_or(Splices.doubled_at(q, e, cap, oe, l), q, e, cap, oe, l)
  static doubled_at (q, e, cap: Text, oe, l) => (at_text(q + (oe - cap.from), e, cap.from, oe) != 0) ? Splices.doubled_found(q + ((oe - cap.from) * 2), Splices.found_from(q + ((oe - cap.from) * 2), e, oe + 1, cap.to), e, cap, oe, l) : None
  static doubled_found (s, r, e, cap: Text, oe, l) => ((r < e) && (at_text(r + (cap.to - (oe + 1)), e, oe + 1, cap.to) != 0)) ? Splices.taken_or_none(take_named(s, r, l, cap.from, oe, cap.to), r + ((cap.to - (oe + 1)) * 2)) : None
  static single_or (m, q, e, cap: Text, oe, l) => (m === None) ? Splices.single_found(q + (oe - cap.from), Splices.found_from(q + (oe - cap.from), e, oe + 1, cap.to), e, cap, oe, l) : m
  static single_found (s, r, e, cap: Text, oe, l) => (r < e) ? Splices.taken_or_none(take_named(s, r, l, cap.from, oe, cap.to), r + (cap.to - (oe + 1))) : None
  static taken_or_none (x, past) => (x == 0) ? None : Taken(entry: x, past: past)
  static taken_copied (out, n, m: Taken) => Splices.copied_in(out, n, Splices.trimmed_of(m.entry))
  static copied_in (out, n, u: Text) => {
    Splices.copy_out(out + n, u.from, u.to - u.from) if out != 0
    n + (u.to - u.from)
