// ECMA-404, The JSON Data Interchange Syntax (https://ecma-international.org/publications-and-standards/standards/ecma-404/)
// The header reads JSON text, and `@json` with it: a Ray value in braces at a value's position is a hole, that value
JSON := class: Language (Blank, root: Value, Blank) => {
  static extensions := ".json"

  static Blank := (" " | \t | \n | \r)[]
  static Value := Object | Array | Text | Numeral | Literal
  static valued (held) => held is Value ? held.value : held
  static Object := class ("{", Blank, (members: (Blank, name: Text, Blank, ":", Blank, value: Value, Blank)[]).join(","), Blank, "}") => {
    value => Document(entries: members.map((name: .name.value, value: valued(.value))))
  }
  static Array := class ("[", Blank, (elements: (Blank, element: Value, Blank)[]).join(","), Blank, "]") => {
    value => elements.map(valued(.element))
  }
  static Escaped := class ("\\", (character: "\"" | "\\" | "/") | (control: "b" | "f" | "n" | "r" | "t") | ("u", unit: Hexadecimal₄)) => {
    value => character ?? (unit ? unit as Char : { "b": \b, "f": \f, "n": \n, "r": \r, "t": \t }[control])
  }
  static Text := class ("\"", characters: (Escaped | Char{!= "\"" && != "\\" && . >= \x20})[], "\"") => {
    value => characters.map(. is Escaped ? .value : .).join("") as String
  }
  static Numeral := class (written: ("-"?, ("0" | (Char.Digit{!= "0"}, Char.Digit[])), (".", Char.Digit[]{length > 0})?, (("e" | "E"), ("+" | "-")?, Char.Digit[]{length > 0})?)) => {
    value => written as Number
  }
  static Literal := class (word: "true" | "false" | "null") => {
    value => { "true": true, "false": false, "null": None }[word]
  }
  value => valued(root)

  static escaped (text: String) => #text.map({ "\"": "\\\"", "\\": "\\\\", "<": "\\u003c", \n: "\\n", \r: "\\r", \t: "\\t" }[.] ?? .) as String
  static written := {
    {writing: Language.Writing{value === None}} => "null"
    {writing: Language.Writing{value is boolean}} => writing.value ? "true" : "false"
    {writing: Language.Writing{value is Number}} => writing.value as 10 as String
    {writing: Language.Writing{value is String | Location | Version}} => "\"", escaped(writing.value as String), "\""
    {writing: Language.Writing{value is Iterable}} => "[", writing.value.map((", " if .index > 0), Language.Writing(.)), "]"
    {writing: Language.Writing} => "{", writing.value.fields.map((", " if .index > 0), Language.Writing(.name), ": ", Language.Writing(.value)), "}"
  }
  static level := {
    {json: JSON} => json.value
  }
}
assert JSON.read("{\"name\": \"x\", \"list\": [1, true, null], \"inner\": {\"a\": \"b\\n\"}}").(
  .name == "x"  // JN1 a JSON member is not read
  & .list.count == 3  // JN2 a JSON array is not three
  & .list[1] == true  // JN3 JSON true is not true
  & .inner.a == "b" + \n  // JN4 a JSON escape is not read
  & JSON.read($.json.write(.)).inner.a == .inner.a  // JN6 written JSON does not read back
  & (@. {"list": [1, {"Ray"}]}).list == JSON.read("{\"list\": [1, \"Ray\"]}").list  // One grammar: what the header reads, written inline, is the same document (ECMA-404 §5–§8); JN10 an inline json fragment and the same text read are other documents
  & (@. {"name": {"Ray"}, "tags": ["a", {"Ray"}], "none": null}).(
    .name == "Ray" && .tags.last == "Ray" && .none === None  // JN8 a single-line json fragment is not its document with the holes' values
  )
  & (@. {
  {"name": {"Ray"}, "list": [1, true, null], "inner": {"a": {"Ray"}}}
}).(
    .name == "Ray" && .list.count == 3 && .inner.a == "Ray" && JSON.read($.json.write(.)).inner.a == "Ray"  // JN9 a json block is not its document with the holes' values
  )
)
// JN7 $.json is not the JSON language
assert $.json === JSON
// UI98 JSON text can close the script it is in
assert JSON.write("</script>") == "\"\\u003c/script>\""

// JN5 a list is not written as JSON
assert $.json.write([1, "a"]) == "[1, \"a\"]"
