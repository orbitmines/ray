Network &+= {
  static Port = Decimal{< 2^16}

  static DomainName := class (text: (Char.Letter | Char.Digit | "-" | ".")[]) => {
    valid => 0 < text.count < 2^8
    static canonical := DomainName{text == text.fold_case}
  }

  static Proxy := class = through: Character, admits: *? {
    carries (traffic) => !admits || traffic is admits
  }

  static Protocol := enum ether (port: @ether.port) | https (port: 443) | http (port: 80) | ssh (port: 22) | wss (port: 443) | ws (port: 80) | dns (port: 53)

  static URL := Location{scheme}

  static Socket := class {
    static Address := class (("[", host: IPv6, "]") | host: IPv4 | host: DomainName, ":", port: Port) => {
      send (bytes: Byte[]) => @me/device/os.tcp(this as String, bytes)
      datagram (bytes: Byte[]) => @me/device/os.udp(this as String, bytes)
      tls (offered: String[]) => @me/device/os.tls(this as String, offered)
    }
  }

  static Hosts := class {
    static equivalences => @/etc/hosts.content as Unicode.Table<(address: (!" " && !"\t")[], (" " | "\t")[], names: (!" " && !"\t")[].join((" " | "\t")[]))>
    // A redirect is a world name (W1.9, `@name = holder`), so it passes the world's write check like any name.
    static resolved (name: String) => World.current["@", name] -- (held => held is Location ? held
      : DomainName(equivalences.rows{name.fold_case is .names.fold_case#}.last?.address ?? name))
  }
}

Effecting |= Program{effects.some(. is "network")}

Location &+= {
  static canonical := Location{!port || port != protocol?.port}
  protocol => Network.Protocol#{as String == scheme}.first
  resolved => Network.Hosts.resolved(host) -- (. == host ? $.dns.resolve(host) ?? . : .)
  socket => Network.Socket.Address(host: host, port: port ?? protocol?.port)
}

OS &+= {
  tcp (address: String, bytes: Byte[]) => ERROR@OS `the operating system has no TCP`
  udp (address: String, bytes: Byte[]) => ERROR@OS `the operating system has no UDP`
  // TLS 1.3 (https://www.rfc-editor.org/rfc/rfc8446) with ALPN (https://www.rfc-editor.org/rfc/rfc7301): the
  // connection, and the protocol of `offered` the two sides agreed on.
  tls (address: String, offered: String[]) => ERROR@OS `the operating system has no TLS`
  mac_address: Binary₄₈? => None
  connected: boolean => ERROR@OS `the operating system does not say whether it is on a network`
}

Device &+= {
  network: (mac: Binary₄₈, connected: boolean) = (mac: os.mac_address ?? (Binary₄₈.random ~~ .[7] = 1), connected: os.connected ?? false)
}

Instance &+= {
  seen_from (other: Instance) => other === this ? @localhost : this
  local => this is @localnetwork
  canonical: static => this as Location.canonical
}

{address: Network.URL | Network.Socket.Address | IP | Network.DomainName}: Instance => (address as String) as Instance

FileSystem &+= {
  static Remote := class: FileSystem {
    at (location: Location) => location.scheme ? location.origin : @remote
    inner (location: Location) => (location.scheme ? location.path : location.segments[1..].join("/")) as Location
    over_http (location: Location) => location.scheme ~= ⊢"http"
    sent (method: $.http.Method, location: Location, content = None, fields = $.http.Fields()) => $.http.send($.http.Request(method, target: location, fields, body: content === None ? [] : content as Byte[]))
    read (location: Location) => over_http(location)
      ? sent($.http.Method.get, location) -- (.ok ? .text : None)
      : { inner(location).content }@(at(location))()
    write (location: Location, content) => over_http(location)
      ? sent(content === None ? $.http.Method.delete : $.http.Method.put, location, content).ok
      : { inner(location).content = content }@(at(location))()
    // WebDAV PROPFIND with Depth 1 answers a 207 multistatus naming the collection and its members (https://www.rfc-editor.org/rfc/rfc4918#section-9.1, https://www.rfc-editor.org/rfc/rfc4918#section-10.2)
    listing (location: Location) => over_http(location)
      ? (sent($.http.Method.propfind, location, fields: $.http.Fields().with("Depth", "1")).text ~= (*, "<", (Char.Word[], ":")?, "href>", href: (!"<")[], "</", (Char.Word[], ":")?, "href>")[]).href[1..]
        .map(href => href ~= ⊢"/" ? location.origin + href : href as Location)
      : { inner(location).listing }@(at(location))()
  }
}

FileOptimizations = {
  {location: Location{scheme && scheme != "file"}} => FileSystem.Remote()
  {location: Location{segments.first == "remote"}} => FileSystem.Remote()
} + FileOptimizations
