!language
{
  }
=>

// The rule creator: a rule written `{head} => {body}` from here on goes on to the next reading while there is one (`goto .`),
// any rule's, so the text is rewritten by the latest rule's reading that goes furthest; and so does the creator (a head goes up
// to the last definer).
{head} => {body} =>
  goto .
  {head} =>
    goto .
    {body}
  goto styled
  function
goto styled
punctuation
// One written `nearest {head} => {body}` does not go on: it is rewritten by its first reading (its holes ending nearest).
nearest {head} => {body} =>
  {head} =>
    {body}

// A typed hole, `{x: T}` in a head: it takes what `T`'s own rules read whole (matched as a head is, nothing read), and what it
// took is read in `T`. This rule, a head that is one hole written as the two its right side has, says how one is written. (In
// a rule's right side, a hole's name is what it took.)
{name: type} =>
  {name}: {type}
// The same way, a hole in a style, `{name ^style}`, is the hole `name` (`^` is a method answering what it is on: it is for
// highlighting and nothing else), and one taken as written, `{literal name}`, the hole `name` (a hole is code already).
{name ^style} =>
  {name} ^{style}
{literal name} =>
  {name}
// A head written with a style after it, `if {condition} {{taken}} ^keyword =>`: the head, its literals shown in that style (the host
// told, `goto styled`: the rule defined last). It goes on as the creator's do (`goto .`).
{head} ^{style} => {{body}} =>
  {head} =>
    {body}
  goto styled
  {style}
// A test, `assert c`: checked after everything is read (when the host puts that off: reading
// abstractly; what it reads is read then, so it is written below any rule, here too), where it is written;
// in a class, once (never again in an instance). (`dynamically assert c` is no
// test: checked in each instance, with its data.)
assert {condition} ^keyword =>
  goto afterwards
  ensure {condition}
goto independent
assert {condition}

// A name with a type and no value: declared here, its value the type (read, both its type and its value are of that kind),
// the type read where it is written (in a call's arguments, `f(x: x)`, the caller's `x`); it answers `declared`. (Written
// `{ }` after `:`, which means the same space, so the rule below does not read this as a name with a type.)
{name}:{ }{type} =>
  {type}
  (declarations := Listing.new) unless (here declarations) && declarations
  declarations.append("{name}")
  {name}: {type} =>
    {type}
  declared
assert {
  {a} %+ {b} => true
  assert true %+ true  // GR1 a rule written at the top reads at the top
  inside => (
    {a} %+ {b} => false
    true %+ true
  )
  assert !(inside)  // GR2 a rule written in a body overrides the reading in that body
  assert true %+ true  // GR3 a rule written in a body does not change the reading after it
  beside => true %+ true
  assert beside  // GR4 a rule written in one body is not seen in a sibling body
  {a} %++ {b} => false
  {a} %+++ {b} => true
  assert !(true %++ true)  // GR5 the longest declared word wins: %++ is not read as %+ followed by +
  assert true %+++ true  // GR6 the longest declared word wins: %+++ is not read as %++ followed by +
  assert true %+ true  // GR7 a longer word declared later does not take over the shorter one
}
goto styled
operator
// (several at once: `a: 1, b: 2`)
{name}:{ }{type}, {{rest}} =>
  {name}: {type}
  {rest}
goto styled
operator
// A name with a type, in a definition's head (whatever wrote it: `:=`, `=`, destructuring, a closure's parameters, a class's
// fields, a declaration): the rule is the name's, what it reads checked against the type (`checked`, below), the type kept
// with it. (Defined after a declaration, it binds looser: `f: T => v` is a rule.)
{name}: {type} => {body} =>
  {name} =>
    ({body}) checked ({type})
  {name}.type =>
    {type}
goto styled
operator

// Which way a statement is read is the order the rules are defined in: of the rules reading all of it, the latest is read
// first (its operator binds loosest). So the operators that bind tightest come first.

// Text: what is written between quotes (`.text`, a capture read as a value, is its text as written; each escape in it, `\e`,
// what it stands for).
"{text}" ^string =>
  (.text).unescaped
unescaped =>
  .
`{text}` ^string =>
  .text
assert `ab` as String == "ab"  // S158 written text is not read as a string
// (given code, a block on one line, `f(code: { … })`: that code, unread, run when it is called)
{name}:{ }{`{`}{ }{code}{ }{`}`} =>
  {name} := (() => ({code}))
  declared
goto styled
operator
{name}:{ }{`{`}{code}{`}`} =>
  {name} := (() => ({code}))
  declared
goto styled
operator

// A name given a value again: the value read, then the name a rule reading it. A definition whose right side is a value
// rewrites the rule of the nearest node that has the name (here, when none does).
{name} = {value} =>
  {value}
  {name} =>
    {value}
goto styled
punctuation
// A name declared here, given a value: a rule here first (not a value: any other definition is made where it is read), then
// given it (that rule, the nearest: not a write through `=`).
{name} := {value} =>
  {value}
  {name} =>
    None
  {name} =>
    {value}
  goto styled
  variable
goto styled
punctuation

// Node: the outermost node (`.`, here, is the node being read in). Every node sees its rules, so they are what any value
// read on reads: its methods.
Node := .
// (`global`: the same outermost node, named for what is defined everywhere: `global[name] := …`, `global.None`)
global := Node
// (the names declared in a node, in order (`x: T`): its fields; see `fields` in the library)
declarations := None
// (what a declaration, `x: T`, answers: nothing but that it declared)
declared := { }
assert {
  declared := 3 ; declared += 1
  assert declared == 4  // CF20 a declaration and an assignment on one line did not both run
}
// A field named by its pattern as written, `{*}: T` (what no other field reads): kept under that text, not a rule (a head that
// is one hole would read everything). A pattern is a body written.
Pattern := {
  {{written}} =>
    written
}
{pattern: Pattern}:{ }{type} =>
  (declarations := Listing.new) unless (here declarations) && declarations
  declarations.append("{pattern}")
  .holding("{pattern}", {type})
goto styled
operator
// (code read in a node: its definitions are the node's; a class's maker (what `X := class …` gives) has its own, see `class`)
&+= {{block}} =>
  {block}
  .
goto styled
operator
// A member given a value: given in what is before it.
{on}.{name} := {value} =>
  {on} &+= {
    {name} := {value}
  }
  goto styled
  property
goto styled
punctuation

// (A member, `x.y`: `x`, then `.y` read in it, the reader's `.`.)

// A comment after a statement.
{statement} //{comment} =>
  {statement}
goto styled
comment
{statement} // {comment} =>
  {statement}
goto styled
comment

// A group: read as what is inside it. (A head that is one hole between two characters makes them a pair, as `{ }` are: a
// hole never ends inside one.)
({grouped}) =>
  {grouped}
goto styled
punctuation

// A name given a value in parentheses: `(a) := 1`. (A list of names, `(a, b) := …`, waits for `,`: a method on Node making a
// Ray.)
({name}) := {value} =>
  {name} := {value}
goto styled
punctuation

// Read on a value without a space between: tightest (precedence is the order rules are defined in: one defined later binds
// looser), so `a === x[k]` is `a === (x[k])`.
// What a value holds under a key: a key that is text, the member it names (`global["Decimal"]` is `Decimal`); any other, an
// entry (keys the same when `===`). (Given one: see `x[key] = v` below.)
// Partial arguments: `f<a: 5>` is `f` with those given first (code: inlined into each call before its own arguments): `g :=
// f<a: 5>`, then `g(1)` gives `b`.
{function}<{{given}}> =>
  ((also) => {function}({given}, also))
goto styled
punctuation

// A narrowing, `T{constraint}` (a method: a class's own `x{ … }` is read first): a T for which the constraint, read with `.` the
// value, answers true (`constraint`, `holds`); what `Narrowing` has (the library adds to it). Called, `p{O: level}()`: what it
// narrows given what the constraint writes (settings), called. (Made in a node holding these, as a class is: none is its own
// rule, which a typed hole `{x: T}` reads.)
{{constraint}} =>
  . -- (narrowed => (Narrowing.extended() &+= {
    narrows := narrowed
    constraint := (it) => it with { {constraint} }
    holds (it) =>
      constraint(it)
    () =>
      holds(narrows)
      narrows()
    narrowing := { }
  }).narrowing)
goto styled
punctuation

// `!x`: false when x is anything but `None` and `false` (`?`, below). (Before the operators: `a != b` is `!=`, not `a` then `!`.)
!{x} =>
  {x} ? false : true
assert !(!true)  // BB4 not(true) should be false
assert !false  // BB5 not(false) should be true
assert !!true  // BO21 not not true is not true
assert !(!!false)  // BO22 not not false is true
assert !None  // BO28 asking whether nothing is there answers nothing
goto styled
operator
// `x as T`: x, when it is a T; else what T makes of it (`T.from(x)`; none, by default). The type, one thing: `x as T == y` is
// `(x as T) == y`.
as {type} ^keyword =>
  (goto .) if (.type) spaced
  (. is {type}) ? . : (. -- ((subject) => ((({type}.from(subject)) ?? ({type}.text_read(subject))) ?? ({type}.bits_read(subject)))))
// Modifiers on an operator (a method's: what it is declared with, where it is declared). `compounds op …`: and `x op= y`, which
// is `x = x op y`. `chainable op …`: and `a op b op c`, which is `a op b && b op c` (`1 < 2 < 3`).
compounds {operator} {rest} => {body} =>
  {operator} {rest} => {body}
  {name} {operator}= {value} =>
    {name} = {name} {operator} ({value})
chainable {operator} {rest} => {body} =>
  {operator} {rest} => {body}
  {operator} {middle} {operator} {last} =>
    (. {operator} ({middle})) && (({middle}) {operator} {last})
// What the host's own kinds of value answer (their operators: they bind tighter than what follows).
goto kinds
// Names written together, `a | b => …`: each the same rule, nearest first (`min | min_by (key) => …`: each taking what follows
// them; `O | optimizations := x`: the first named so, the others reading it). Only names: `{a} | {b} => …` is not.
nearest {name} | {other} => {body} =>
  (goto .) unless (.name) named
  {name} => {body}
  {other} => {body}
nearest {name} | {other} | {third} => {body} =>
  (goto .) unless (.name) named
  {name} => {body}
  {other} => {body}
  {third} => {body}
nearest {name} | {other} ({parameters}) => {body} =>
  (goto .) unless (.name) named
  {name} ({parameters}) => {body}
  {other} ({parameters}) => {body}
nearest {name} | {other} | {third} ({parameters}) => {body} =>
  (goto .) unless (.name) named
  {name} ({parameters}) => {body}
  {other} ({parameters}) => {body}
  {third} ({parameters}) => {body}
nearest {name} | {other} := {value} =>
  (goto .) unless (.name) named
  {name} := {value}
  {other} => {name}
// NA1 one of two names written together does not read the rule
assert {
  Aliased := class {
    nonzero | holds => 5
    first | second | third => 6
    twice | double (x) => x * 2
    O | optimizations := 7
  }
  assert Aliased().nonzero == 5 & Aliased().holds == 5
  assert Aliased().first == 6 & Aliased().third == 6  // NA2 the third of three names does not read the rule
  assert Aliased().twice(4) == 8 & Aliased().double(5) == 10  // NA3 names taking what follows them do not take it
  assert Aliased().optimizations == 7  // NA4 a value named twice is not read by its second name
}

// What a value answers to `?`: anything is true, but `None` and `false`.
? {yes} : {no} =>
  {yes}
goto styled
operator
None := {
  ? {yes} : {no} =>
    {no}
  value =>
    None
  next =>
    None
  assert true.next == false  // BOR1 true.next should be false
  assert false.next == true  // BOR2 false.next should be true
  assert true.next.next == true  // BOR3 true.next.next should be true
  assert false.next.next == false  // BOR4 false.next.next should be false
  assert {
    Colour := enum red | green | blue
    assert Colour.red  // EM1 the member an enum is written with is not there
    assert Colour.blue  // EM2 the last member is not there
    assert Colour.red == Colour.red  // EM4 a member is not itself
    assert !(Colour.red == Colour.blue)  // EM5 two members of one enum are the same
    assert Colour.red is Colour  // EM6 a member is not one of its enum
    assert Colour#.count == 3  // EM7 an enum of three has other than three members
    assert Colour# == [Colour.red, Colour.green, Colour.blue]  // EM14 an enum's members are not its three, in order
    assert Colour.red.next == Colour.green  // EM25 the member after red is not green
    assert !(Shape.circle is Colour)  // EM15 a member is one of another enum
  }
  assert {
    R := class { }
    S := class: R { s => S(next: this) }
    assert S().s.s.s  // C5 a successor chain through class: Parent broke
    assert S.components.hierarchy.first  // C6 class: Parent did not add a class component
    assert S.super  // C7 super is missing
  }
  assert {
    E := enum p | q | r
    assert E#.first == E.p  // C9 the first enum member is not the first written
    assert E#.first.next.next == E.r  // C10 enum members are not chained forward
    assert E#.last.previous.previous == E.p  // C11 enum members are not chained backward
    assert E#.count == 3  // C12 an enum of three has other than three members
    assert E#.first.is_initial  // C13 the members are not an Iterable of Rays
    assert E#.last == E.r  // C14 Iterable.last did not reach the last member
  }
  assert (true |+ "A").next == false | "B"  // SP2 |+ does not answer with either component
  // (a member of None is None: chains need no `?.`)
  .{member} =>
    None
}
assert !(None)  // BO27 nothing is there
// Negations on nothing answer true (T1.8)
assert None != 1  // NGN1 nothing is said to be one
assert None !~= "a"  // NGN2 nothing is said to match
false := {
  ? {yes} : {no} =>
    {no}
}
assert true == true  // BO23 true is not itself
assert !(true == false)  // BO24 true is false
assert true  // BO25 true is not there
assert !(false)  // BO26 false holds as a condition
true := { }
{a} || {b} =>
  {a} ? {a} : {b}
assert true || false  // BB8 or(true,false) should be true
assert !(false || false)  // BB9 or(false,false) should be false
assert false || true  // BO4 or(false,true) should be true
assert true || true  // BO5 or(true,true) should be true
assert 0 || true  // N97 zero or true is not true
assert !(0 || false)  // N98 zero or false is true
assert {
  cleared_vertex := [1, 2].entry
  kept_vertex := cleared_vertex
  cleared_vertex = None
  assert !(kept_vertex.initial || kept_vertex.terminal)  // NGN4 a vertex set to nothing keeps its boundaries
}
goto styled
operator
{a} && {b} =>
  {a} ? {b} : {a}
assert true && true  // BB6 and(true,true) should be true
assert !(true && false)  // BB7 and(true,false) should be false
assert !(false && true)  // BO2 and(false,true) should be false
assert !(false && false)  // BO3 and(false,false) should be false
assert true && !false  // BB16 true && !false should be true
assert 1 && true  // N95 one and true is not true
assert !(0 && true)  // N96 zero and true is true
assert None != 5 && !(None != None)  // NGN3 a negation on nothing does not answer true against something, or holds against nothing
assert (choose 1 ("A" | "B")) is ("A" | "B") && (choose 1 ("A" | "B"))#.count == 1  // HS11 choosing a counted type does not resolve to one of its possibilities
goto styled
operator
// `a & b` of two that are true or false: both (`x.(.a == 1 & .b == 2)`); of anything else, what its own `&` is (a Node's,
// their conjunction).
{a} & {b} =>
  (goto .) unless ({a} === true) || ({a} === false)
  {a} && {b}
assert (1 & 2).contains(2)  // TY68 what holds both does not hold the second
assert (1 & 2 & 3).conjoined.count == 3  // TY69 three held at once are not three
goto styled
operator
{a} ?? {b} =>
  {a} ? {a} : {b}
assert None ?? true  // BN1 ?? does not fall back on nothing
assert !(false ?? true)  // BN2 ?? replaces a value that is there
goto styled
operator
// The same value: gone to as a label (a node is the label written as it); nothing there, another.
{a} === {b} =>
  goto {a}
  goto other
  {b}\
  true
  goto same
  other\
  false
  same\
goto styled
operator
{a} !== {b} =>
  ({a} === {b}) ? false : true
goto styled
operator
// A choice, `c ? a : b`: the condition all before the `?` (`x > 1 ? a : b`).
{condition} ? {yes} : {no} =>
  ({condition}) ? {yes} : {no}
assert true ? true : false  // BT3 c ? a : b does not take a when c holds
assert !(false ? true : false)  // BT4 c ? a : b takes a when c does not hold
assert false ? false : true  // BT5 c ? a : b does not take b for a named c
goto styled
operator
// A branch: the block taken read where the branch is (a label gone to by what the condition answers; named apart from a
// loop's, which `break` and `continue` go to through it).
if {condition} {{taken}} ^keyword =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {taken}
  passed\
assert !((if 0 { "taken" }))  // IC4 an if whose block holds no cases is read as cases
assert !((if false { true }))  // CC6 a bare if with a false predicate is not None-like
unless {condition} {{taken}} ^keyword =>
  {condition} ? (goto passed) : (goto taken)
  taken\
  {taken}
  passed\
assert (unless false { true })  // CC7 unless did not fire
assert (unless true { 1 } else { 2 }) == 2  // CF9 unless has no other side
nearest elsif {condition} {{taken}} =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {taken}
  passed\
goto styled
keyword
nearest elsif {condition} {{taken}} else {{otherwise}} =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {otherwise}
  passed\
assert (if false { true } elsif true { true } else { false })  // CC3 elsif did not fire
assert (if false { true } elsif false { true } else { true })  // CC4 else after elsif did not fire
goto styled
keyword
if {condition} {{taken}} else {{otherwise}} ^keyword =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {otherwise}
  passed\
// (a chain, `if … {} elsif … {} else {}`: its condition ends at the nearest body; what follows it an `elsif`) (after `else`:
// the later reading, so `if a {} elsif b {} else {}` is not an `else` whose condition holds the first body)
nearest if {condition} {{taken}} {chain} =>
  (goto .) unless (.chain) begins "elsif"
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {chain}
  passed\
goto styled
keyword
nearest elsif {condition} {{taken}} {chain} =>
  (goto .) unless (.chain) begins "elsif"
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {chain}
  passed\
goto styled
keyword
assert (if true { true } else { false })  // CC1 if-true did not take the then branch
assert !((if false { 1 } else { None }))  // CC12 an if whose taken branch is None is present
assert (if true { 1 } else { None })  // CC13 an if whose taken branch is one is absent
assert !((if false { true } else { false }))  // CC2 if-false took the then branch
assert (if true { true } elsif true { false } else { false })  // CC5 a later branch overrode the first
// CF5 a branch does not answer its last statement
assert (if true {
  1
  2
  3
} else { None }) == 3
assert (if true { if false { 1 } else { 2 } } else { 3 }) == 2  // CF6 a branch inside a branch is not read there
assert (if 1 { true } else { false })  // CF7 a number that is there does not hold
assert !((if None { true } else { false }))  // CF8 nothing holds

// Loops: `break` goes to the loop's end, `continue` to its start.
while {condition} {{body}} ^keyword =>
  again\
  {condition} ? (goto looping) : (goto done)
  looping\
  {body}
  goto again
  done\
// Loops
assert {
  flag := true
  while flag { flag = false }
  assert !(flag)  // CC8 while did not run its body
}
assert {
  ran := false
  while false { ran = true }
  assert !(ran)  // CC9 while ran with a false predicate
}
loop {{body}} ^keyword =>
  again\
  {body}
  goto again
  done\
{body} while {condition} ^keyword =>
  again\
  {condition} ? (goto looping) : (goto done)
  looping\
  {body}
  goto again
  done\
do {{body}} while {condition} ^keyword =>
  start\
  {body}
  again\
  {condition} ? (goto start) : (goto done)
  done\
assert {
  seen := false
  do { seen = true } while false
  assert seen  // CC10 do-while did not run its body at least once
}
assert {
  stop := true
  do { stop = false } while stop
  assert !(stop)  // CC11 do-while did not stop
}
assert {
  asked := 0
  do { asked += 1 } while false
  assert asked == 1  // CF12 do ran other than once when it never holds
}
break ^keyword =>
  goto done
assert {
  stopped := 0
  while true {
    stopped = stopped + 1
    break if stopped == 3
  }
  assert stopped == 3  // RC2 break does not leave the loop
}
continue ^keyword =>
  goto again
assert {
  skipped := 0
  counted := 0
  while counted < 5 {
    counted = counted + 1
    continue if counted == 2
    skipped = skipped + 1
  }
  assert skipped == 4  // RC3 continue does not go on with the next round
}

// Leaving a call: `return v` (the call answers v), `return`.
return {value} ^keyword =>
  {value}
  goto returned
// `recur` re-enters the method; `break` and `continue` in a loop (P2.4, P2.1)
assert {
  countdown (n) => (
    return n if n == 0
    recur(n - 1)
  )
  assert countdown(5) == 0  // RC1 recur(args) does not re-enter the method
}
return ^keyword =>
  goto returned
// The call it is in, again from its start: `recur(arguments)`, with these; `recur`, with the same.
recur({again}) ^keyword =>
  given := ({again})
  goto rebinding
recur ^keyword =>
  goto recurring

// Code read in a value, `.` that value: `x with { … }` (before the loosest, so `y := x with { … }` gives y it).
{on} with {{block}} ^keyword =>
  {on} reading {
    {block}
  }

// The loosest, defined here once more and in this order, tightest first (a rule defined again is placed as defined now):
//   `=` (a member, `x.m = v`, given in `x`; and `x: T = v`: the value checked against T before the name, with its type, is given
//     it);
//   a closure: a rule on one line, read where a value is wanted, is a node holding it (see `language3.ts`); reading on in it
//     (`f(5)`) runs its right side in a new node in it, its parameters taking the arguments (arguments are code inlined into
//     the call: `f(x: 5)` declares its `x`, answering `declared`; see `taking`); its parameters go up to the
//     nearest `=>`, so it is made by the rule creator that does not go on; a call written with a hole, `({args}) =>`, is a
//     rule as written; a call ends at `returned\` (`return v` goes there, the call answering v), and begins at `recurring\` (`recur`
//     goes there; `recur(…)` first gives its parameters these, `given`);
//   a method: `name (parameters) =>` gives the name a closure, as `name := (parameters) =>` does (so its locals are its
//     own); a rule without parameters, `name =>`, is one too (read on in a value, `.` is that value); `x.name (…) =>` is a
//     member (a name handed on is a value: what is in it is not read again, so the member is written as one);
//   `:=`, and its more particular forms: a closure or a class given to a name (`f := (x) => …`, `X := class (…) => { … }`:
