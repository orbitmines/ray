// CSS Snapshot (https://www.w3.org/TR/css-2023/)
// The headers read CSS and write it; written inline, a Ray value in braces is a hole in a selector or a value, and a declaration whose value is None is left out
CSS := class: Language {
  static extensions = ".css"

  static Blank = (" " | \t | \n | \r)[]
  // Comments (https://www.w3.org/TR/css-syntax-3/#consume-comment)
  static Comment := class ("/*", text: (!"*/")[], "*/")
  // Declarations; property names are ASCII case-insensitive, custom properties ("--") case-sensitive (https://www.w3.org/TR/css-syntax-3/#declaration, https://www.w3.org/TR/css-variables-1/#defining-variables, https://www.w3.org/TR/CSS2/syndata.html#characters)
  static Property = ("--", (Char.Word | "-")[]) | ((Char.Letter | "-"), (Char.Word | "-")[]).lower_case
  static Declaration = (Blank, property: Property, Blank, ":", Blank, value: (!";" && !"}")[]{!(. ~= (" " | \t | \n) ⊣)}, Blank, ";")
  static Declarations = (Declaration | (Blank, Comment))[]

  // Style rules, and the at-rules holding declarations, @font-face and @page, by their lower-case name (https://www.w3.org/TR/css-syntax-3/#style-rules, https://www.w3.org/TR/css-fonts-4/#font-face-rule, https://www.w3.org/TR/css-page-3/#at-page-rule)
  static Rule := class (selector: ("@", ("font-face" | "page").lower_case) | (!"{" && !"}" && !";" && !"@")[]{!(. ~= (" " | \t | \n) ⊣)}, Blank, "{", declarations: Declarations, Blank, "}") {
    within: String?
  }
  // Keyframes; the at-rule name and the selectors from and to in any case (https://www.w3.org/TR/css-animations-1/#keyframes, https://www.w3.org/TR/css-syntax-3/#at-rule, https://www.w3.org/TR/css-values-4/#keywords)
  static Keyframes := class ("@", "keyframes".ignore_case, Blank, name: (!"{" && !" ")[], Blank, "{",
    frames: (Blank, at: ("from".ignore_case as 0) | ("to".ignore_case as 1) | ((percent: Decimal, "%") as percent / 100), Blank, "{", declarations: Declarations, Blank, "}")[], Blank, "}")
  // Conditional group rules: @media, @supports, @container, each style rule within it (https://www.w3.org/TR/css-conditional-3/#contents-of, https://www.w3.org/TR/css-contain-3/#container-rule)
  static Group := class ("@", prelude: (!"{")[]{!(. ~= (" " | \t | \n) ⊣)}, Blank, "{", rules: (Blank, Rule)[], Blank, "}") {
    held => rules.map(Rule(.selector, .declarations, within: "@" + prelude)) -- (.count == 1 ? .first : .)
  }
  static Sheet := class (rules: (Blank, Rule | Keyframes | Comment)[] = [], Blank)

  level := {
    {group: Group} => group.held
    {rule: Rule | Keyframes | Comment} => rule
    {sheet: Sheet} => sheet.rules
    {declarations: Declarations} => declarations
  }
  written := {
    {rule: Rule{within}} => rule.within, "{", Rule(rule.selector, rule.declarations), "}"
    {keyframes: Keyframes} => "@keyframes ", keyframes.name, "{", keyframes.frames.map(.at * 100, "%{", .declarations, "}"), "}"
  }
}
