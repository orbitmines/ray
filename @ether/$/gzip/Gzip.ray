// GZIP file format specification version 4.3 (https://www.rfc-editor.org/rfc/rfc1952)
Gzip := class: Language (
  // ID1, ID2, and CM 8 for deflate (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1)
  0x1F, 0x8B,
  method: Byte{== 8} = 8,
  // FLG: reserved, FCOMMENT, FNAME, FEXTRA, FHCRC, FTEXT (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1)
  Binary₃{== 0},
  commented: Binary₁ as boolean = comment != None,
  named: Binary₁ as boolean = name != None,
  extended: Binary₁ as boolean = extra != None,
  checked: Binary₁ as boolean = false,
  text: Binary₁ as boolean = false,
  // Numbers are stored least significant byte first (https://www.rfc-editor.org/rfc/rfc1952#section-2.1)
  modified: <-Byte₄ = 0,
  flags: Byte = 0,
  system: Byte = 255,
  (size: <-Byte₂ = extra.count, extra: Byte[]{length == size}) if extended,
  // FNAME and FCOMMENT are ISO 8859-1, zero-terminated (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1)
  (name: Byte{!= 0}[], 0) if named,
  (comment: Byte{!= 0}[], 0) if commented,
  (header_crc: <-Byte₂) if checked,
  deflated: Deflate.Stream,
  // CRC-32 and ISIZE of the uncompressed data (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1, https://www.rfc-editor.org/rfc/rfc1952#section-8)
  crc: <-Byte₄ = inflated as CRC32 as Binary₃₂,
  isize: <-Byte₄ = inflated.count % 2 ^ 32
) {
  static extensions := ".gz" | ".gzip"

  inflated: Byte[] => deflated.bytes
  dynamically assert crc == inflated as CRC32 as Binary₃₂ && isize == inflated.count % 2 ^ 32

  // A file is one or more members, read as their data joined (https://www.rfc-editor.org/rfc/rfc1952#section-2.2)
  static level := {
    {members: Gzip[]{length > 0}} => members.inflated.flatten
  }
  static written := {
    {writing: Language.Writing} => Gzip(deflated: Deflate.write(writing.value as Byte[]))
  }
}
