  static with_pattern (l: Pattern) => ((l is Pattern) && (l.kind == repeating)) ? Pattern(kind: repeating, a: sequence(append(append(list(), Pattern(kind: statement_ending, b: 2)), l.a)), b: l.b, c: l.c) : l
