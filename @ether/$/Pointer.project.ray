@ether/os
@ether/geometry
@ether/time

// A pointer: its contacts (a mouse, a pen, each touch), where each is, how hard it presses, how it moved
Pointer := class: Location {
  static Contact := class: Nameable (number: Number = 0, position: Geometry.Vector = Geometry.Vector(), pressure: Probability = 0, tilt: Geometry.Vector = Geometry.Vector(), buttons: Number[] = [], wheel: Geometry.Vector = Geometry.Vector()) => {
    pressed => .buttons.nonempty || .pressure > 0
    released => !.pressed && (.previous.pressed ?? false)
    velocity => .history.last -- (now => now.previous && now.when > now.previous.when ? (now.value.position - now.previous.value.position) * (1 / ((now.when - now.previous.when) as ms)) : Geometry.Vector())
    pressed_at => .history.commits{.value.pressed && !(.previous.value.pressed ?? false)}.last
    swipe => (.pressed_at, .history.commits{.value.released}.last) -- ((from, to) => (from: from.value, to: to.value, distance: to.value.position - from.value.position, duration: to.when - from.when))
    to (at: Geometry.Vector, pressing: Number[] = .buttons, time: Time = Time.now) => {
      with Time.now = time {
        .position = at
        (.buttons = pressing) if pressing != .buttons
      }
      this
    }
  }
  static Mouse := Pointer.Contact{.name == "mouse"}
  static Pen := Pointer.Contact{.name == "pen"}
  static Touch := Pointer.Contact{.name == "touch"}

  contacts => .children{is Pointer.Contact}
  [kind: "mouse" | "pen" | "touch" = "mouse", number: Number = 0] => .contacts{.name == kind && .number == number}.first ?? .add(Pointer.Contact(name: kind, number))
  assert Pointer()["mouse"].(.name == "mouse" & !(.pressed))  // PT3 a pointer's mouse is not one, or is pressed untouched
}
