// others, which read the rest of what it reads: `class: P { … }`)
class: {parent} {`{`}{block}{`}`} ^keyword => { class: {parent} (nothing_given = None) => { {block} } }
class ({fields}) {`=>`} {`{`}{block}{`}`} ^keyword => { class: Node ({fields}) => { {block} } }
class {`{`}{block}{`}`} ^keyword => class: Node { {block} }
