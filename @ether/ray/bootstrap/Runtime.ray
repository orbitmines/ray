    rmode = read_on
  }

  // (what the holes bound from a mark hold: those without a name, the one, else all as a list; with names, a node of
  // them, its keys each where it was read, `named_from`; a field read up to here bound to that, or to what it read)
  static boundvalue (i) => Runtime.bound_value(bound_at(i))
  static bound_value (b: Bound) => (b.held != 0) ? b.held : text(b.start, b.end)
  static unnamed (b: Bound) => (b.hole == 0) ? 1 : 0
  static unnamed_count (mark) => {
    n := 0
    i := mark
    while i < boundn {
      n = n + Runtime.unnamed(bound_at(i))
      i = i + 1
    }
    n
  }
  static unnamed_value (mark) => {
    v := 0
    i := mark
    while i < boundn {
      v = Runtime.held_if_unnamed(bound_at(i), v)
      i = i + 1
    }
    v
  }
  static held_if_unnamed (b: Bound, v) => (b.hole == 0) ? b.held : v
  static valued_from (mark) => (Runtime.unnamed_count(mark) == 1) ? Runtime.unnamed_value(mark) : Runtime.bound_values(mark)
  static listing (mark) => (Runtime.unnamed_count(mark) == (boundn - mark)) && (boundn > mark)
  static named_from (mark) => Runtime.named_into(node(0), list(), mark)
  static named_into (n: Node, keys: List, mark) => {
    i := mark
