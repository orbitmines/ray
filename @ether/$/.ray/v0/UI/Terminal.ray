Language.TUI := class: Language {
  static extensions = ".tui"
  Cell := class = glyph: Char = " ", foreground: Geometry.Color?, background: Geometry.Color?, bold: boolean = false, italic: boolean = false, underline: boolean = false, strike: boolean = false, dim: boolean = false, link: Location?
  Grid := class = width: Number, height: Number, cells: Cell[][] = (0..<height).map((0..<width).map(Cell())) {
    put (at: Geometry.Vector, cell: Cell) => cells[at.y][at.x] = cell if 0 <= at.x < width && 0 <= at.y < height
    painted (at: Geometry.Vector, paint: Geometry.Paint) => put(at, cells[at.y][at.x] ~~ .background = Sample(paint, at))
    changes (previous: Grid?) => (0..<height).map(y => (0..<width){!previous || cells[y][.] != previous.cells[y][.]}.map(x => (Geometry.Vector(x, y), cells[y][x]))).flatten
  }
  px_per_cell = Geometry.Vector(8px, 16px)
  cells (length: Geometry.Vector) => Geometry.Vector(length.x / px_per_cell.x, length.y / px_per_cell.y)

  Cells := {
    {page: Geometry.Shape} => Grid(UI.Viewport.size.x / px_per_cell.x, UI.Viewport.size.y / px_per_cell.y) -- Paint(page, .) -- (grid => page.lifted.for(Paint(., grid)) -- grid)
  }
  At := (shape: Geometry.Shape) => cells(shape.origin - Geometry.Vector(0, UI.Viewport.scrolled))
  Area := (shape: Geometry.Shape) => At(shape) -- (from => (from.y..<from.y + cells(shape.size).y).map(y => (from.x..<from.x + cells(shape.size).x).map(x => Geometry.Vector(x, y))).flatten{
    shape.contains(shape.transform.inverse.applied(Geometry.Vector((.x - from.x) * px_per_cell.x, (.y - from.y) * px_per_cell.y)))
  })
  Paint := (shape: Geometry.Shape, grid: Grid) => grid -- shape.match
    Geometry.Text => {
      lines = shape.lines(shape.size.x)
      starts = shape.starts(shape.size.x)
      (0..<lines.count).for(row => (0..<lines[row].length).reduce(column = 0 => {
        run = shape.run_at(starts[row] + .)
        face = run?.font ?? shape.font
        grid.put(At(shape) + Geometry.Vector(column, row), Cell(lines[row][.], foreground: (run?.color ?? shape.color) as Geometry.Color, background: (run?.fill ?? shape.fill) as Geometry.Color, bold: face.weight >= 600, italic: face.style == italic))
        column + lines[row][.].columns
      }))
    }
    Geometry.Image => Area(shape).for(at => grid.put(at, Picture(shape.source).sampled(at - At(shape), cells(shape.size))))
    Geometry.Canvas => shape.draws{O: Language.Direct.level}().rows -- Area(shape).for(at => grid.put(at, Cell(Braille(.[at.y * 4..<at.y * 4 + 4].map(.[at.x * 2..<at.x * 2 + 2])))))
    UI.Link => Box(shape, grid) -- Area(shape).for(grid.cells[.y][.x] ~~ .link = shape.to)
    UI.Input => Box(shape, grid) -- Paint(shape.face, grid)
    * => Box(shape, grid)
  Box := (shape: Geometry.Shape, grid: Grid) => {
    Area(shape).for(grid.painted(., shape.fill)) if shape.fill
    Border(shape, grid) if shape.stroke
    shape.effects.for(.match
      Geometry.Opacity => Area(shape).for(grid.cells[.y][.x] ~~ .foreground = .foreground?.mix(.background, 1 - .amount))
      Geometry.Shadow => Area(shape).map(. + cells(.offset)).for(grid.cells[.y][.x] ~~ .background = (.background ?? Geometry.Color(0, 0, 0)).mix(Geometry.Color(0, 0, 0), 0.5))
      * => None
    )
    shape.in_place.sort_by(.layer).for(Paint(., grid)) if shape.visible
    Scrollbar(shape, grid) if shape.overflow == scroll
    Focus(shape, grid) if UI.Focus.current === shape
  }
  Border := (shape: Geometry.Shape, grid: Grid) => {
    corners = shape.radius != [0] ? "╭╮╰╯" : "┌┐└┘"
    from = At(shape)
    to = from + cells(shape.size) - Geometry.Vector(1, 1)
    style = Cell(foreground: shape.stroke.paint as Geometry.Color)
    sides = shape.stroke.sides
    (from.x..to.x).for(x => grid.cells[to.y][x] ~~ .underline = true) if sides == bottom
    (from.x + 1..<to.x).for(x => grid.put(Geometry.Vector(x, from.y), style ~~ .glyph = "─")) if sides ==.instance_of (all | top | horizontal)
    (from.x + 1..<to.x).for(x => grid.put(Geometry.Vector(x, to.y), style ~~ .glyph = "─")) if sides ==.instance_of (all | horizontal)
    (from.y + 1..<to.y).for(y => grid.put(Geometry.Vector(from.x, y), style ~~ .glyph = "│")) if sides ==.instance_of (all | left | vertical)
    (from.y + 1..<to.y).for(y => grid.put(Geometry.Vector(to.x, y), style ~~ .glyph = "│")) if sides ==.instance_of (all | right | vertical)
    [(from, 0), (Geometry.Vector(to.x, from.y), 1), (Geometry.Vector(from.x, to.y), 2), (to, 3)].for((at, i) => grid.put(at, style ~~ .glyph = corners[i])) if sides == all
  }
  Scrollbar := (shape: Geometry.Shape, grid: Grid) => cells(shape.size).y -- (0..<.).for(y => grid.put(At(shape) + Geometry.Vector(cells(shape.size).x - 1, y), Cell(y == shape.scrolled.y * . / shape.content_height ? "┃" : "│")))
  Focus := (shape: Geometry.Shape, grid: Grid) => Area(shape).for(grid.cells[.y][.x] ~~ .underline = true)
  Sample := (paint: Geometry.Paint, at: Geometry.Vector) => paint.match
    Geometry.Color => paint
    Geometry.Gradient => paint.at(at.x / UI.Viewport.size.x * px_per_cell.x)
    * => None
  Braille := (dots: boolean[][]) => (0x2800 + [[0, 3], [1, 4], [2, 5], [6, 7]].zip(dots).map((bits, row) => row.zip(bits).map((on, bit) => on ? 2 ^ bit : 0).sum).sum) as Char
  Picture := class = source: Location {
    static ramp = " .:-=+*#%@"
    pixels => IO.read(source) as Geometry.Raster
    sampled (at: Geometry.Vector, of: Geometry.Vector) => pixels.at(at.x * pixels.width / of.x, at.y * pixels.height / of.y) -- Cell(ramp[.luminance * (ramp.length - 1) / 255], foreground: .)
  }

  ANSI := class = previous: Grid?, title: String? {
    escape (code: String) => "\e[", code
    write (grid: Grid) => Title(UI.Navigation.title) -- (Terminal.emit(grid.changes(previous).map((at, cell) => escape(at.y + 1, ";", at.x + 1, "H"), Style(cell), Hyperlink(cell), cell.glyph)), escape("0m")) -- (previous = grid)
    Title := (shown: String) => (Terminal.emit("\e]0;", shown, "\a") -- (title = shown)) if shown != title
    Style := (cell: Cell) => escape("0", (";1" if cell.bold), (";2" if cell.dim), (";3" if cell.italic), (";4" if cell.underline), (";9" if cell.strike),
      (";", Color(cell.foreground, 38)) if cell.foreground, (";", Color(cell.background, 48)) if cell.background, "m")
    Color := (color: Geometry.Color, layer: Number) => layer, ";2;", color.red, ";", color.green, ";", color.blue
    Hyperlink := (cell: Cell) => cell.link ? ("\e]8;;", cell.link as String, "\e\\") : "\e]8;;\e\\"
  }
  level := Cells

  Target := class = ansi: ANSI = ANSI() {
    start => Terminal.raw_mode -- Terminal.clear
    stop => Terminal.restore
    write (grid: Grid) => ansi.write(grid)
    read => Language.TUI.read
    copy (text: String) => Terminal.emit("\e]52;c;", Base64.encoded(text.bytes), "\a")
    open (to: Location) => UI.Platform.launch(to)
  }

  XTerm256 := {
    {color: Geometry.Color} as (=== ANSI.Color) => (16 + 36 * (color.red * 5 / 255) + 6 * (color.green * 5 / 255) + color.blue * 5 / 255) -- (layer, ";5;", .)
  }
  TrueColor := { }
  WindowsTerminal := {
    {enter: Terminal.raw_mode} => enter -- Terminal.emit("\e[?9001h")
  }
  Kitty := {
    {image: Geometry.Image} => Terminal.emit("\e_Ga=T,f=100;", Base64.encoded(IO.File(image.source as String).bytes), "\e\\")
  }
  Sixel := {
    {image: Geometry.Image} => Terminal.emit("\eP0;0;0q", SixelEncoded(IO.read(image.source) as Geometry.Raster), "\e\\")
  }
  SixelEncoded := (raster: Geometry.Raster) => raster.pixels.unique.enumerate -- (palette => (
    palette.map("#", .index, ";2;", .value.red * 100 / 255, ";", .value.green * 100 / 255, ";", .value.blue * 100 / 255),
    (0..<(raster.height + 5) / 6).map(band => palette.map(
      "#", .index, (0..<raster.width).map(x => ((0..<6).map(row => raster.at(x, band * 6 + row) == .value ? 2 ^ row : 0).sum + 63) as Char), "$"
    ), "-")
  ))
  Browser := {
    {grid: Grid} => Language.Web.DOM().write(Language.Web.HTML.Element("pre", children: grid.cells.map(.map(.glyph) as String).join(\n)))
  }

  static read => (Terminal.read ?? "") ~= (events: Event[]) -- .events.for(.apply)
  Event := Key | Mouse | Paste | FocusChange | Resize
  Key := class ("\e[", (modifiers: "1;", modifier: Decimal)?, code: "A" | "B" | "C" | "D" | "H" | "F" | "Z") | ("\eO", code: "P" | "Q" | "R" | "S") | (code: Char) => {
    name => code.match
      "A" | "w" => Keyboard.Direction.up
      "B" | "s" => Keyboard.Direction.down
      "C" | "d" => Keyboard.Direction.right
      "D" | "a" => Keyboard.Direction.left
      "Q" => Keyboard.f2
      "\r" => Keyboard.enter
      "\t" | "Z" => Keyboard.tab
      * => Keyboard.key(code)
    shift => modifier && (modifier - 1) % 2 == 1
    control => modifier && (modifier - 1) / 4 % 2 == 1
    apply => Keyboard.press(name, shift, control) -- {
      UI.Selection.move(name) if name ==.instance_of Keyboard.Direction && !shift && !control
      UI.Selection.skip(name) if name ==.instance_of Keyboard.Direction && control
      UI.Selection.expand(name) if name ==.instance_of Keyboard.Direction && shift
      UI.Focus.current = UI.Focus.next(UI.scene) if name == Keyboard.tab && !shift
      UI.Focus.current = UI.Focus.previous(UI.scene) if name == Keyboard.tab && shift
      (UI.Focus.current ?? UI.Selection.current)?.activate if name == Keyboard.enter
      UI.Runtime.current?.stop if code == "q"
    }
  }
  Mouse := class ("\e[<", button: Decimal, ";", x: Decimal, ";", y: Decimal, state: "M" | "m") => {
    apply => UI.Pointer.pointers = [(mouse, Geometry.Vector(x - 1, y - 1) * px_per_cell, state == "M" ? 1 : 0, Geometry.Vector(), button < 64 && state == "M" ? [button % 4] : [])]
      -- ((UI.Pointer.wheel = Geometry.Vector(y: button == 64 ? -1 : 1)) -- UI.Viewport.scroll(UI.Pointer.wheel.y * 3 * px_per_cell.y)) if button >= 64
      -- (UI.Pointer.released = state == "m")
  }
  Paste := class ("\e[200~", text: *, "\e[201~") => {
    apply => UI.Clipboard.content = text -- UI.Focus.current?.typed(text)
  }
  FocusChange := class ("\e[", state: "I" | "O") => {
    apply => UI.Viewport.preferences ~~ .focused = state == "I"
  }
  Resize := class => {
    apply => UI.Viewport.size = Geometry.Vector(Terminal.size.x * px_per_cell.x, Terminal.size.y * px_per_cell.y)
  }
}

Terminal := class {
  emit (bytes) => external io `stdout` (bytes)
  read => external io `stdin` None
  size => Geometry.Vector((external os `COLUMNS`) as Decimal, (external os `LINES`) as Decimal)
  raw_mode => emit("\e[?1049h", "\e[?25l", "\e[?1000h", "\e[?1006h", "\e[?2004h", "\e[?1004h")
  clear => emit("\e[2J", "\e[H")
  restore => emit("\e[?1004l", "\e[?2004l", "\e[?1006l", "\e[?1000l", "\e[?25h", "\e[?1049l")
}

Language.register(Language.TUI)
