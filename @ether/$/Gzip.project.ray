@deflate
@crc32

// GZIP file format specification version 4.3 (https://www.rfc-editor.org/rfc/rfc1952)
Gzip := class: Language (
  // ID1, ID2, and CM 8 for deflate (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1)
  0x1F, 0x8B,
  method: Byte{== 8} = 8,
  // FLG: reserved, FCOMMENT, FNAME, FEXTRA, FHCRC, FTEXT (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1)
  Binary₃{== 0},
  commented: Binary₁ as boolean = comment != None,
  named: Binary₁ as boolean = name != None,
  extended: Binary₁ as boolean = extra != None,
  checked: Binary₁ as boolean = false,
  text: Binary₁ as boolean = false,
  // Numbers are stored least significant byte first (https://www.rfc-editor.org/rfc/rfc1952#section-2.1)
  modified: <-Byte₄ = 0,
  flags: Byte = 0,
  system: Byte = 255,
  (size: <-Byte₂ = extra.count, extra: Byte[]{length == size}) if extended,
  // FNAME and FCOMMENT are ISO 8859-1, zero-terminated (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1)
  (name: Byte{!= 0}[], 0) if named,
  (comment: Byte{!= 0}[], 0) if commented,
  (header_crc: <-Byte₂) if checked,
  deflated: Deflate.Stream,
  // CRC-32 and ISIZE of the uncompressed data (https://www.rfc-editor.org/rfc/rfc1952#section-2.3.1, https://www.rfc-editor.org/rfc/rfc1952#section-8)
  crc: <-Byte₄ = inflated as CRC32 as Binary₃₂,
  isize: <-Byte₄ = inflated.count % 2 ^ 32
) {
  static extensions := ".gz" | ".gzip"

  inflated: Byte[] => deflated.bytes
  dynamically assert crc == inflated as CRC32 as Binary₃₂ && isize == inflated.count % 2 ^ 32

  // A file is one or more members, read as their data joined (https://www.rfc-editor.org/rfc/rfc1952#section-2.2)
  static level := {
    {members: Gzip[]{length > 0}} => members.inflated.flatten
  }
  static written := {
    {writing: Language.Writing} => Gzip(deflated: Deflate.write(writing.value as Byte[]))
  }
}
// "hello" as GNU gzip 1.15 writes it with -9 -n (and node:zlib gzipSync at level 9), a reference encoder's output and no value of RFC 1952: no name, mtime 0, XFL 2, OS 3 (Unix), then CRC-32 3610a686 and ISIZE 5 (https://www.rfc-editor.org/rfc/rfc1952#section-2.3)
assert Gzip.read(([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x03, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00, 0x86, 0xa6, 0x10, 0x36, 0x05, 0x00, 0x00, 0x00])) as String == "hello"  // GZ1 a gzip member does not inflate to its data
assert Gzip.read([([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x03, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00, 0x86, 0xa6, 0x10, 0x36, 0x05, 0x00, 0x00, 0x00]), ([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x03, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00, 0x86, 0xa6, 0x10, 0x36, 0x05, 0x00, 0x00, 0x00])].flatten) as String == "hellohello"  // GZ2 two members do not read as their data joined
assert Gzip.read([([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x03, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00, 0x86, 0xa6, 0x10, 0x36, 0x05, 0x00, 0x00, 0x00])[..<17], [0x00, 0xa6, 0x10, 0x36], ([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x03, 0xcb, 0x48, 0xcd, 0xc9, 0xc9, 0x07, 0x00, 0x86, 0xa6, 0x10, 0x36, 0x05, 0x00, 0x00, 0x00])[21..]].flatten) is Diagnostic  // GZ5 a member whose CRC-32 does not match its data reads
assert Gzip.read(Gzip.write(("ray " * 32).bytes) as Byte[]) == ("ray " * 32).bytes  // GZ3 written bytes do not read back
assert (Gzip.write("hello".bytes) as Byte[])[..<3] == [0x1f, 0x8b, 0x08] && (Gzip.write("hello".bytes) as Byte[])[-8..<-4] == [0x86, 0xa6, 0x10, 0x36]  // GZ4 a written member does not start with ID1 ID2 CM or end with its CRC-32, least significant byte first
assert Gzip === Gzip && Language.named(".gz") === Gzip  // GZ6 Gzip is not Gzip
