// Secure Hash Standard, the SHA-2 family (https://csrc.nist.gov/pubs/fips/180-4/upd1/final)
SHA2<width: 32 | 64, rounds: Number, sums: Number[][], sigmas: Number[][]> := class (digest: Byte[]{.length == width}) {
  static word => 2 ^ width
  // A block is sixteen words, the digest eight, in bytes (FIPS 180-4 §1)
  static block => 2 * width
  static size => width

  // Constants: the first bits of the fractional parts of the cube roots of the first primes (FIPS 180-4 §4.2.2, §4.2.3)
  static primes := (2 -> +1){n => (2..<n).every(n % . != 0)}
  static K => this.primes[..<rounds].map(p => (p * 2 ^ (3 * width)).root(3) % this.word)
  // The first constant and initial word (FIPS 180-4 §4.2.2, §5.3.3)
  assert SHA256.K.first == 0x428a2f98 && SHA256.K.last == 0xc67178f2 && SHA256.K.count == 64  // SHT4 the constants are not the 64 of FIPS 180-4 §4.2.2
  // Initial hash value: the same of the square roots of the first eight primes (FIPS 180-4 §5.3.3, §5.3.5)
  static initial => this.primes[..<8].map(p => (p * 2 ^ (2 * width)).root(2) % this.word)
  assert SHA256.initial == [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]  // SHT5 the initial hash value is not that of FIPS 180-4 §5.3.3

  // Padding: the message, a 1 bit, zeros, and its length in bits in two words (FIPS 180-4 §5.1.1, §5.1.2)
  static padded (message: Byte[]) => [message, 0x80, [0] * ((2 * this.block - width / 4 - 1 - message.count % this.block) % this.block), (message.count * 8) as Binary{.length == 2 * width} as Byte[]].flatten

  // ROTR, SHR, Ch, Maj, Σ and σ (FIPS 180-4 §3.2, §4.1.2, §4.1.3)
  static rotr (x, n) => ((x as Binary{.length == width}).loop >> n) as Number
  static Σ (x, (a, b, c)) => this.rotr(x, a) ~x|| this.rotr(x, b) ~x|| this.rotr(x, c)
  static σ (x, (a, b, c)) => this.rotr(x, a) ~x|| this.rotr(x, b) ~x|| (x / 2 ^ c).floor
  static Ch (x, y, z) => (x ~&& y) ~x|| ((this.word - 1 - x) ~&& z)
  static Maj (x, y, z) => (x ~&& y) ~x|| (x ~&& z) ~x|| (y ~&& z)

  // Message schedule (FIPS 180-4 §6.2.2 and §6.4.2, step 1)
  static schedule (words: Number[]) => (16..<rounds).reduce(w = words => [w, (this.σ(w[-2], sigmas[1]) + w[-7] + this.σ(w[-15], sigmas[0]) + w[-16]) % this.word])
  // Rounds over a..h, then added to the hash (FIPS 180-4 §6.2.2 and §6.4.2, steps 2–4)
  static compressed (h, words: Number[]) => this.schedule(words).enumerate.reduce(v = h =>
    (v[7] + this.Σ(v[4], sums[1]) + this.Ch(v[4], v[5], v[6]) + this.K[.index] + .value) % this.word -- (t1 => (this.Σ(v[0], sums[0]) + this.Maj(v[0], v[1], v[2])) % this.word -- (t2 =>
      [(t1 + t2) % this.word, v[0], v[1], v[2], (v[3] + t1) % this.word, v[4], v[5], v[6]]))
  ).zip(h).map((a, b) => (a + b) % this.word)

  static (message: Byte[]) as (=== SHA2) => SHA2<width, rounds, sums, sigmas>(digest: this.padded(message).chunk(this.block).map(.chunk(width / 8).map(. as Binary))
    .reduce(h = this.initial => this.compressed(h, .)).map(. as Binary{.length == width} as Byte[]).flatten)
}

// SHA-256 (FIPS 180-4 §4.1.2, §6.2)
SHA256 := class: SHA2<32, 64, [[2, 13, 22], [6, 11, 25]], [[7, 18, 3], [17, 19, 10]]> {
  static extensions := ".sha256"
}
// One-block message "abc" (FIPS 180-4 example SHA256.pdf, and FIPS 180-2 Appendix B.1)
assert ("abc".bytes as SHA256) as Byte₃₂ as Hexadecimal₆₄ == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"  // SHT1 abc does not digest as in FIPS 180's one-block example
// Two-block message, the 448 bits "abcdbcde…nopq" (FIPS 180-4 example SHA256.pdf, and FIPS 180-2 Appendix B.2)
assert ("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes as SHA256) as Byte₃₂ as Hexadecimal₆₄ == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"  // SHT2 the 448-bit message does not digest as in FIPS 180's two-block example
// The empty message (NIST CAVP SHAVS, SHA256ShortMsg.rsp, Len = 0)
assert ([] as SHA256) as Byte₃₂ as Hexadecimal₆₄ == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"  // SHT3 the empty message does not digest as e3b0c442…
