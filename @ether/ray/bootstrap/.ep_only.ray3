{name} := class ({fields}) {`=>`} {`{`}{block}{`}`} ^class => {name} := (class ({fields}) => { {block} })
{name} := class: {parent} ({fields}) {`=>`} {`{`}{block}{`}`} ^class => {name} := (class: {parent} ({fields}) => { {block} })
// (a member of an instance, then an operator: the operator read on the member's value, not on the instance)
assert {
  Carrying := class (carried) => {
    again => carried
  }
  assert Carrying(true).carried === true  // CI1 a field given true is not true
  assert Carrying(Carrying(false)).carried.carried === false  // CI2 a field's field is not what it was given
  carrier := Carrying(true)
  assert carrier.again === true  // CI3 a method of an instance held in a name does not answer its field
}
// A call's arguments (§10.1): each a value, or one given by name, `f(x: 5)`: the callee's `x` given 5, read where it is written.
// (read by this type: what binds looser where they are written (`,`) first, each part then read here)
Named := class (name, value) => {
  named_argument := true
}
named_argument := false
Arguments := {
  {value} => value
  {name}: {value} => `{name}` named_as value
}
{text} named_as {value} ^keyword => Named(text, value)
assert {
  .{x}? => x
  assert (true ? true : false)  // GR8 a rule written `.{x}?` made `.` and `?` a pair of brackets
}
assert {
  {a} %= {b} => true
  {a: "x"} %= {b} => false
  assert true %= true  // GR9 a rule with a typed hole replaced the one with an untyped hole in its place
}
assert {
  Bit := "0" | "1"
  checked_bit {x} => false
  checked_bit {x: Bit} => true
  assert (checked_bit 1)  // TY70 a hole typed by texts written with | does not read one of them
  assert !(checked_bit 2)  // TY71 a hole typed by texts written with | reads another text
}
assert {
  Bits := "0" | "1"
  bracketed {x} => false
  bracketed ({x: Bits}) => true
  assert (bracketed (1))  // TY72 a typed hole between brackets does not read what its type reads
  assert !(bracketed (2))  // TY73 a typed hole between brackets reads what its type does not
}
assert {
  Bits := "0" | "1"
  read_bits {x} => false
  read_bits {x: Bits[]} => true
  pair {x} => false
  pair {x: Bits}{y: Bits} => true
  assert (read_bits 1)  // TY74 a hole typed T[] does not read one T
  assert (read_bits 101)  // TY75 a hole typed T[] does not read Ts written as one word
  assert !(read_bits 121)  // TY76 a hole typed T[] reads what is not all Ts
  assert (pair 10)  // TY77 two typed holes do not split a word between them
}
assert {
  continued := true
    && false
  assert !(continued)  // LY1 a line indented under a statement does not continue it
}
assert {
  pick_second := (a, b) => b
  assert !(pick_second(true, false))  // CL9 a closure of two parameters does not give the second the second argument
  Paired := class (left, right) => { }
  assert !(Paired(true, false).right)  // CL10 an instance of a class with two fields does not hold the second
}
assert {
  Holder := {
    passed_on (x) => x
  }
  given_here := true
  assert Holder.passed_on(given_here)  // ME1 an argument to a member is read in what it is a member of, not where it is written
}
assert {
  Answering := {
    itself () => .
    put (v) => {
      .x := v
      .
    }
  }
  assert Answering.itself() === Answering  // ME2 `.` in a member is not what it is a member of
  Answering.put(true)
  assert Answering.x  // ME3 a member writing `.x` does not write it on what it is a member of
}
assert {
  nothing_given := () => true
  assert nothing_given()  // CL11 a closure of no parameters given a name with `:=` is not called
}
assert {
  Members := class {
    member := true
  }
  assert Members.member  // CL12 a member a class's block declares is not read on the class
  assert Members().member  // CL13 a member a class's block declares is not read on an instance
  layered := (() => {
    inner := Node &+ {
      deep := true
    }
    inner
  })()
  assert layered.deep  // CL14 a node made in a closure (`x &+ { … }`) does not keep what its block declares
  spread_out := (() => {
    first := true
    first
  })()
  assert spread_out  // CL15 a closure's body inlined deeper than it is written is read as one statement
}
assert {
  made := false
  Shadowed := class {
    kept := true
  }
  assert Shadowed.kept  // CL16 a class's own `made` is read as a name written outside it
}
Selfmade := class (part) => {
  assert Selfmade(true)  // CL7 a class whose block makes one of it puts off a test of it for every one made
}
assert Selfmade(true).part  // CL8 an instance does not hold the field it was given
Asserting := class {
  checked := true
  assert Asserting.checked  // CL17 a class whose block asserts on it is run again each time the test reads it, without end
}
// `static`: read where it is (a class's block is read once for the class).
static {statement} ^keyword => {statement}
// `x ^style` on its own: x. (A style is for highlighting and nothing else.)
^{style} ^operator => .

// What a value is: a Node; the value itself; an instance of the class (or one after it) it was made by; one of a
// superposition's components; a narrowing that holds of it; a member of an enumeration; a superposition, each of its
// components one.
of := None
superclass := None
superposes := false
narrows := None
members := None
caller := None
// (no count of how far: a class's parents end; one that would not, the kernel stops as too deep)
descends (type) => (. === type) || (.superclass ? .superclass.descends(type) : false)
// (what a value is: itself, or else what it converts to is (the equivalence graph, followed when the value itself is not))
is {type} ^keyword => {
  value := .
  value.is_itself(type) || (value as *).some((conversion) => value.converted_by(conversion).is_itself(type))
}
is_itself (type) => {
  value := .
  (type.conjoined) ? type.conjoined.every((part) => value is part) : (type === Node) || (value === type) || (value.of ? value.of.descends(type) : false) || (type.superposes ? type.components.some((component) => value is component) : false) || (type.narrows ? ((value is type.narrows) && type.holds(value)) : false) || (type.members ? type.members.some((member) => member === value) : false) || (value.superposes ? value.components.every((component) => component is type) : false)
}
assert ("A", "A", "A") is "A"[]  // IS1 is does not ask instance_of
// A value checked against a type: reported when it is not one (None, and anything against no type, pass).
type := None
checked {type} ^keyword => {
  unless (type === None) || (. === None) || (. is type) {
    ERROR a value is not of the type it is given to: {type}
  }
  .
}
// A level given to a running program (`& including level`): its rules seen in it.
{on} including {level} ^keyword => on &+= {
  {level}
}
{level} reducing {value} ^keyword => level reading {value}

// What a value holds under a key: its entries (`keyed`), none until one is given.
keyed := None
Holding := class (key, value) => { }
held (key) => {
  holder := this
  found := (holder.keyed) ? holder.keyed.find((entry) => entry.key === key) : None
  found ? found.value : None
}
// (what holds it named: `.` in a block, `unless … { }`, is the block's)
holding (key, value) => {
  holder := this
  (holder.keyed := []) unless holder.keyed
  found := holder.keyed.find((entry) => entry.key === key)
