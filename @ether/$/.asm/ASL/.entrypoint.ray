// Numbers the translation uses often, read once.
AslNumbers ^keyword := class {
  five: Node
  eight: Node
  sixty_four: Node
  one: Node
  register_31: Node
  zero_register: Node
  one_register: Node
  flag_n: Node
  flag_z: Node
  flag_c: Node
  flag_v: Node
