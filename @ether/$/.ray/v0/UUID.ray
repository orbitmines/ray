// A Universally Unique IDentifier (UUID) (https://datatracker.ietf.org/doc/html/rfc4122)
// (draft: utils/UUID.ray)
//
// class UUID < Hexadecimal³² ~~ [~ 7 | +4 | +4 | +4].push_after("-")
// spec: `Hexadecimal³²` is the hexadecimal numbers of thirty-two spelled; a
// UUID keeps those spelled as a chain rather than the number they spell, since
// that number is a walk of 2¹²⁸ links. The dashes are where the text form
// groups them: 8-4-4-4-12.
UUID := class: Hexadecimal {
  spelled: Node

  // version: Hexadecimal¹ => this[12]
  version => .spelled.head.at(ten + two).value

  // dynamically
  //   < v1 if version == 1
  //   < v3 if version == 3
  //   < v4 if version == 4
  //   < v5 if version == 5
  // A UUID read from text comes back as its version's class (`read`); one
  // built here is the class it is built as.

  // class Variant = .RESERVED_NCS | .RFC_4122 | .RESERVED_MICROSOFT | .RESERVED_FUTURE
  Variant := enum reserved_ncs | rfc_4122 | reserved_microsoft | reserved_future
  // variant as (=== Variant) => .match
  //   ⊢0 => Variant.RESERVED_NCS, 10₂ => Variant.RFC_4122, 110₂ => Variant.RESERVED_MICROSOFT, 111₂ => Variant.RESERVED_FUTURE
  // The variant is the leading bits of the seventeenth digit.
  variant => (
    leading := .spelled.head.at(ten + six).value
    if (leading < eight) { UUID.Variant.reserved_ncs }
    elsif (leading < (ten + two)) { UUID.Variant.rfc_4122 }
    elsif (leading < (ten + four)) { UUID.Variant.reserved_microsoft }
    else { UUID.Variant.reserved_future }
  )

  // secure Hexadecimal{length == 32}.random: so many random hexadecimal spelled.
  drawn (count: Number) => (
    out := chain None
    left ^keyword := count
    while left {
      nibble ^keyword := zero
      bit ^keyword := four
      while bit {
        nibble = nibble + nibble
        if (exists (external random)) { nibble = nibble.succ }
        bit = bit.pred
      }
      out &= nibble
      left = left.pred
    }
    out
  )

  // class v1 < UUID ~ (time_low: Hexadecimal⁸, time_mid: Hexadecimal⁴, (version: Hexadecimal¹, time_high: Hexadecimal³), clock_seq, node: Hexadecimal¹² = @me.instance#.mac_address)
  // spec: the 60-bit timestamp since 1582-10-15 in 100ns steps awaits Time
  // reading the clock as a number; the node awaits `os` handing the MAC address.
  v1 := class: UUID {
    // spec: `dynamically assert (.version == one)` is the draft's, and waits on
    // `dynamically` meaning what it says — read again when what it depends on
    // changes. Read once, here, it asks a class what its version is, and a
    // class is not one of its own instances.
    // dynamically assert (.version == one)
  }
  // class v3 (namespace: UUID, name: String) < UUID
  // spec: md5(namespace, name) awaits Encoding's hashes.
  v3 := class: UUID {
    namespace: UUID
    name: String
    // spec: `dynamically assert (.version == three)` is the draft's, and waits on
    // `dynamically` meaning what it says — read again when what it depends on
    // changes. Read once, here, it asks a class what its version is, and a
    // class is not one of its own instances.
    // dynamically assert (.version == three)
  }
  // class v4 < UUID = secure Hexadecimal{length == 32}.random ~~ version = 4
  v4 := class: UUID {
    spelled: UUID.drawn((three * ten) + two) ~~ (
      .head.at(ten + two).value = four
      this.head.at(ten + six).value = eight + (.head.at(ten + six).value % four)
    )
    // spec: `dynamically assert (.version == four)` is the draft's, and waits on
    // `dynamically` meaning what it says — read again when what it depends on
    // changes. Read once, here, it asks a class what its version is, and a
    // class is not one of its own instances.
    // dynamically assert (.version == four)
  }
  // class v5 (namespace: UUID, name: String) < UUID
  // spec: sha1(namespace, name) awaits Encoding's hashes.
  v5 := class: UUID {
    namespace: UUID
    name: String
    // spec: `dynamically assert (.version == five)` is the draft's, and waits on
    // `dynamically` meaning what it says — read again when what it depends on
    // changes. Read once, here, it asks a class what its version is, and a
    // class is not one of its own instances.
    // dynamically assert (.version == five)
  }

  // As text: each digit, in groups of 8, 4, 4, 4 and 12 with dashes between.
  as_string => (
    out := chain None
    walker ^keyword := .spelled.head
    // The dash between the groups is one character, read once: a codepoint is
    // a walk, and so is the character built from it.
    dash ^keyword := Character.of(ascii_dash)
    groups := chain None
    groups &= eight
    groups &= four
    groups &= four
    groups &= four
    groups &= ten + two
    groups for {
      unless (it.value == eight) { out &= dash }
      left ^keyword := it.value
      while left {
        out &= Character.decimal_digit(walker.value)
        walker = walker.next
        left = left.pred
      }
    }
    String(characters: out)
  )
  == (other: UUID) => .as_string == other.as_string

  // {uuid: UUID.String}: UUID => uuid — the text form read back.
  read (text: String) => (
    out := chain None
    // The dash is read once, not once per character.
    dash ^keyword := Character.of(ascii_dash)
    text.characters for {
      character := it.value
      unless (character == dash) { out &= character.hexadecimal_digit }
    }
    // dynamically < v1 if version == 1 …: what is read comes back as its version.
    read_version := out.head.at(ten + two).value
    if (read_version == one) { UUID.v1(spelled: out) }
    elsif (read_version == three) { UUID.v3(spelled: out) }
    elsif (read_version == four) { UUID.v4(spelled: out) }
    elsif (read_version == five) { UUID.v5(spelled: out) }
    else { UUID(spelled: out) }
  )

  // namespace Namespace
  //   DNS: UUID = 6ba7b810-9dad-11d1-80b4-00c04fd430c8 …
  // spec: the texts, read with `UUID.read` when one is needed; reading all
  // four on every pass is more than a pass affords.
  Namespace := class {
    DNS => String.of(`6ba7b810-9dad-11d1-80b4-00c04fd430c8`)
    URL => String.of(`6ba7b811-9dad-11d1-80b4-00c04fd430c8`)
    OID => String.of(`6ba7b812-9dad-11d1-80b4-00c04fd430c8`)
    X500 => String.of(`6ba7b814-9dad-11d1-80b4-00c04fd430c8`)
  }
}

// A character read as a hexadecimal digit: `0`..`9` then `a`..`f` (either case).
Character.components.hierarchy &= class {
  hexadecimal_digit => if .digit { .codepoint - ((four * ten) + eight) } else { .lower.codepoint - ((eight * ten) + seven) }
}

