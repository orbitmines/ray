-> (): Ray => next: () => Ray(next: next())
<- (): Ray => previous: () => Ray(previous: previous())
<--> (): Ray => (<-) &+ (->)

Ordered := class (T = static) => {
  chainable < (b: T) => TODO
  chainable > (b: T) => b < this
  chainable <= (b: T) => this == b || this < b
  chainable >= (b: T) => this == b || this > b
  min (b: T) => this <= b ? this : b
  max (b: T) => this >= b ? this : b
}

// (Iterable and Array are made in the entrypoint, their core; what follows is the rest of them)
Iterable &+= {
  entry: Vertex? => TODO

  dynamically assert count < ∞ if bounded: boolean = true

  empty => count == 0
  nonempty => !empty
  unbounded => !bounded
  ∞ => unbounded
  orderless => false

  connected => all.every(a => all.every(b => a.to(b)))
  consistent => all.every(.next.previous == . && .previous.next == .)
  acyclic => !all.some(.next** contains .)
  undirected => all.every(.initial === .terminal)
  unidirectional => all.every(!.previous)

  compact => this[{!(. is None)}]

  static boundary := class {
    () => boundary.initial | boundary.terminal
    initial: Boundary => (⊢all{is_initial}){⊙.is_initial}
    terminal: Boundary => (all{is_terminal}⊣){⊙.is_terminal}
  }

  first => entry
  last => rest.empty ? first : rest.last
  static From := class: Iterable (at: Ray) => {
    entry => at
  }

  for <traverse: Traverser = Traverser.default>(yield: (x: Vertex): *) => traverse<.yield: yield<local: &.caller, break: return>>(entry) if entry

  every (predicate: (x: Vertex): boolean) => map(predicate){== false}.empty
  some (predicate: (x: Vertex): boolean) => this[{predicate}].nonempty
  filter (predicate: (x: Vertex): boolean) => this[{predicate}]

  // (one closure: its parameter the accumulator, what it is given nothing its start (its default), `.` in it each element in
  // turn: `first -- step(seed)`)
  reduce (step) =>
    empty ? None : rest.reduced(first -- step(), step)
  reduce_right | fold_right | foldr => reverse.reduce
  reduced (seed, step) =>
    reduced_next := empty ? seed : (first -- step(seed))
    empty ? seed : rest.reduced(reduced_next, step)

  all => reduce(|)
  right-to-left Σ | ∑ | sum => reduce(total = 0 => total + .)
  right-to-left ∏ | product => reduce(total = 1 => total * .)
  min => reduce((acc) => acc < . ? acc : .)
  max => reduce((acc) => acc > . ? acc : .)
  min | min_by (key: Program | Section) => this[{key(.) == map(key).min}].all
  max | max_by (key: Program | Section) => this[{key(.) == map(key).max}].all
  count => unbounded ? ∞ : reduce(acc = 0 => acc + 1)
  length => paths.map(.count).max
  paths: Path{.bounded: bounded} => [this]

  rest => entry.next ? From(at: entry.next) : []
  map (mapping: (x: Vertex): *) => empty ? [] : mapping(first), rest.map(mapping)
  map {selection} (mapping: (x: Vertex): *) => (selected = this[{selection}]) -- map(x => selected.contains(x) ? mapping(x) : x)
  reverse => empty ? [] : rest.reverse, first
  sort => empty ? [] : rest{< first}.sort, first, rest{>= first}.sort
  sort_by | sorted (key) => empty ? [] : this.sorted_on(key)
  sorted_on (key) =>
    sort_pivot := first
    sort_rest := rest
    sorted_made := []
    sort_rest{sort_candidate => key(sort_candidate) < key(sort_pivot)}.sort_by(key).for(sorted_one => sorted_made.append(sorted_one))
    sorted_made.append(sort_pivot)
    sort_rest{sort_candidate => key(sort_candidate) >= key(sort_pivot)}.sort_by(key).for(sorted_one => sorted_made.append(sorted_one))
    sorted_made
  unique => empty ? [] : first, rest{!= first}.unique

  // (by `==`, until the operator given as a type parameter (`contains <operator = ==>(x)`) reads)
  contains | includes (sought) => some(contained => contained == sought)
  partition (predicate) => [this[{predicate}]], [this[{!predicate(.)}]]
  batch | chunk (size: Number) => empty ? [] : [this[..<size]], this[size..].chunk(size)
  concatenated =>
    made := []
    this.for(part => part.for(element => made.append(element)))
    made
  // (what flattening goes into: a narrowing, a list (a Ray of vertices); not a number, a text, a closure, a shape (each also a Ray))
  static flattens (element) => element.narrows || element.listing || (element.commas && element.empty) || (element.of === [].of)
  flatten => map(element => Ray.flattens(element) ? element.flatten : [element]).concatenated
  flatten (levels: Number) => levels == 0 ? this : map(element => Ray.flattens(element) ? element.flatten(levels - 1) : [element]).concatenated
  union (other: Iterable) => this, other[{!this.contains(.)}]
  intersection (other: Iterable) => this[{other.contains(.)}]
  disjoint (other: Iterable) => intersection(other).empty
  xor | symmetric_difference (other: Iterable) => this[{!other.contains(.)}], other[{!this.contains(.)}]
  split (delimiter) => this ~= ((piece: *, ⊙: delimiter)[], piece: *) -- .piece
  group_by (key: Program | Section) => map(key).unique.map((group) => (group): this[{key(.) == group}])
  // (each value with its place, from 0)
  enumerate =>
    enumerated := []
    enumerating_at := 0
    this.for(enumerated_value => enumerated.append((index: enumerating_at, value: enumerated_value)) -- (enumerating_at = enumerating_at + 1))
    enumerated
  // (each pair a list of two: `[a].append(b)`, which a list `a` does not open; up to the shorter one)
  zip (other: Iterable) => other.count -- (other_count => this.enumerate{zipped => zipped.index < other_count}.map(zipped => [zipped.value].append(other[zipped.index])))
  pairs (other: Iterable) => map(a => other.map(b => (a, b))).flatten(1)
  join (separator) => this.empty ? "" : (this.rest.empty ? this.first : this.first + separator + this.rest.join(separator))
  random => drawn(Random.below(map(.weight ?? 1).sum))
  drawn (at: Number) => at < (first.weight ?? 1) ? first : rest.drawn(at - (first.weight ?? 1))
  subsets (size: Number) => size == 0 ? [[]] : empty ? [] : rest.subsets(size - 1).map([first, .]), rest.subsets(size)
  orderings => count < 2 ? [this] : map(held => this{!== held}.orderings.map([held, .])).flatten(1)
  shuffled => orderings.random
  fill (x) => all = x
  take (count: Number) => this[..<count]
  find (predicate) => this[{predicate}].first
  index_of (x, at = 0) => empty ? None : first == x ? at : rest.index_of(x, at + 1)
  until (boundary) => empty || first == boundary ? [] : first, rest.until(boundary)
  squeeze => this[{. != .previous}]
  padded (width: Number, with = 0) => [with] * (width - length), this

  .. (next: Number) => this, (last..next)[1..]

  orbit | loop => Loop(around: this, at: first)

  compounds * (count: Number) => count == 0 ? [] : this, this * (count - 1)
  ^ (count: Number) => count == 0 ? [[]] : pairs(this ^ (count - 1)).map((x, xs) => [x], xs)

  + (at: Integer) => this[at]
  - (at: Integer) => this[-at]
  ± | +- | -+ (at: Integer) => this[at] | this[-at]
  [at: Integer] => at == 0 ? entry : at > 0 ? rest[at - 1] : reverse[-at - 1]
  [range: Range] => range.map(this[.])
  // (the elements from one place to another, both kept)
  sliced (slice_from, slice_to) => this.enumerate{slice_entry => slice_entry.index >= slice_from && slice_entry.index <= slice_to}.map(.value)
  `[`{from}..`]` ^punctuation => sliced(from, count - 1)
  `[..`{to}`]` ^punctuation => sliced(0, to)
  `[..<`{to}`]` ^punctuation => sliced(0, to - 1)
  `[`{from}..{to}`]` ^punctuation => sliced(from, to)
  `[`{from}..<{to}`]` ^punctuation => sliced(from, to - 1)
  at (index: Integer) => index < 0 ? count + index : index
  sliced (from: Integer, to: Integer) => (at(from)..at(to)).map(this[.])
  [{from}..] = {value} ^punctuation => assigned_over(from, count - 1, value)
  [..{to}] = {value} ^punctuation => assigned_over(0, to, value)
  [..<{to}] = {value} ^punctuation => assigned_over(0, to - 1, value)
  [{from}..{to}] = {value} ^punctuation => assigned_over(from, to, value)
  [{from}..<{to}] = {value} ^punctuation => assigned_over(from, to - 1, value)
  assigned_over (from: Integer, to: Integer, value) => (at(from)..at(to))
    -- .zip(value is Iterable && value.count == .count && .count > 1 ? value : [value] * .count)
    -- .for((at, written) => this[at] = written)
    -- this
  [{{literal selection}}] ^punctuation => Filtered(from: entry, keeps: { inline selection })

  as (: Iterable<R: ?>) => this[{. is R}]

  chainable == <up_to = None, except: Iterable = []>(other: Iterable) => (up_to !== None) || except.nonempty
    ? this[{!except.contains(.)}].until(up_to) == other[{!except.contains(.)}].until(up_to)
    : orderless || other.orderless
      ? count == other.count && every(other.contains(.))
      : empty ? other.empty : other.nonempty && first == other.first && rest == other.rest
}

Ray := class: Iterable & Ordered {
  initial | (internal right-to-left ⊢) : Boundary = Boundary.Initial(∙: this)
  terminal | (internal ⊣) : Boundary = Boundary.Terminal(∙: this)

  is_initial | is_first => !previous
  is_terminal | is_last => !next
  is_boundary => is_initial || is_terminal

  entry => first
  first => is_initial ? this : previous.first
  last => is_terminal ? this : next.last
  index => is_initial ? 0 : previous.index + 1
  count => is_terminal ? 1 : next.count + 1

  .. (last: Ray) => this === last ? [this] : next ? this, next..last : None
  to (other: Ray) => reachable.some(. === other)

  same_vertex (other: Ray) => value || other.value ? value == other.value : same_text(this.location, other.location)
  matches (other: Ray) => same_vertex(other) && (is_terminal ? other.is_terminal : other.next && next.matches(other.next))
  chainable == (other: Ray) => first.matches(other.first)

  expand => first..last
  complement => expand{!== this}

  continuations => [next]{!= None}
  reachable => this, continuations.map(.reachable).flatten -- .unique

  path_to | between (target, trail = []) => this === target ? [[trail, this]]
    : continuations{!trail.contains(.)}.map(.path_to(target, [trail, this])).flatten(1)
    -- . ?? ERROR@Path `find a path`
  shortest_path_to (target) => path_to(target) -- .erred ? . : .min_by(.count)

  complement (selection) => reachable{!selection.contains(.)}

  = (written: None) => (initial, terminal = None) -- super(written)

  remove | remove_preserving => {
    previous.next = next
    next.previous = previous
    next, previous = None
  } -- this
  sever => {
    previous.next = None
    next.previous = None
    next, previous = None
  } -- this
  move_after (other) => remove -- {
    (next, previous) = (other.next, other)
    other.next.previous = this
    other.next = this
  }
}

Boundary := class: Ray {
  vertex | (internal bidirectional ∙) : Ray
  edge | (internal bidirectional ⊙) : Edge

  is_initial => !edge
  is_terminal => !edge

  static Initial := class: Boundary {
    ⊙ = Edge(x.terminal: this)
    is_initial => !∙.previous
    is_terminal => false
  }
  static Terminal := class: Boundary {
    ⊙ = Edge(x.initial: this)
    is_initial => false
    is_terminal => !∙.next
  }
}

Edge := class: Ray {
  value | (internal x) : {
    initial | (internal right-to-left ⊣) : Boundary?
    terminal | (internal ⊢) : Boundary?
  }

  is_initial => x.initial == None
  is_terminal => x.terminal == None

  from => x.initial.∙
  to => x.terminal.∙
  static between (from, to) => Edge(x: (initial: from.terminal, terminal: to.initial))
}

Traverser := class: <yield: (x: Ray): None>(entry: Ray): None {
  static walk (take: .pop_back | .pop_front): Traverser = (entry: Ray) => {
    seen = []
    pending = [entry]
    while pending.nonempty {
      at = take(pending)
      unless seen.some(. === at) {
        seen.push(at)
        yield at
        at.continuations.for(pending.push(.))
      }
    }
  }
  static DepthFirst := walk(.pop_back)
  static BreadthFirst := walk(.pop_front)
  static default := DepthFirst
}

Structure := class: Iterable<Ray{
  initial & terminal : (1 unless HyperContinuations) Vertex.Boundary
}> {
  Vertex.Boundary = Boundary{
    ∙: (1 unless HyperEdges) Vertex
    ⊙: (1 unless HyperEdges) Edge{
      initial & terminal : (1 unless HyperEdges) Vertex.Boundary
    }
  }
  static HyperContinuations: boolean
  static HyperEdges: boolean = false
}

Hypergraph := class: Structure {
  HyperEdges := true
}
Graph := class: Structure {
  HyperContinuations := true

  static Simple := class: Graph (vertices: *[] = [], edges: Edge[] = []) => {
    vertex (value) => (vertices.push(value) unless vertices.contains(value)) -- value
    connect (from, to) => { vertex(from); vertex(to); edges.push Edge.between(from, to) } -- this
    connected (from, to) => edges.some(.from == from && .to == to)
    outgoing (vertex) => edges{.from == vertex}.to

    cartesian (other: Simple) => Simple(
      vertices: vertices.pairs(other.vertices),
      edges: edges.pairs(other.vertices).map((e, v) => Edge.between((e.from, v), (e.to, v))), vertices.pairs(other.edges).map((v, e) => Edge.between((v, e.from), (v, e.to)))
    )
    tensor (other: Simple) => Simple(vertices: vertices.pairs(other.vertices), edges: edges.pairs(other.edges).map((a, b) => Edge.between((a.from, b.from), (a.to, b.to))))
    union (other: Simple) => Simple(vertices: (vertices, other.vertices).unique, edges: (edges, other.edges).unique)
    disjoint_union (other: Simple) => Simple(
      vertices: vertices.map((0, .)), other.vertices.map((1, .)),
      edges: edges.map(Edge.between((0, .from), (0, .to))), other.edges.map(Edge.between((1, .from), (1, .to)))
    )

    without (vertex) => Simple(vertices: vertices{!= vertex}, edges: edges{.from != vertex && .to != vertex})
    dangling (vertex, kept) => edges.some((.from == vertex || .to == vertex) && !(kept.contains(.from) && kept.contains(.to)))

    static Rule := class (left: Simple, interface: Simple, right: Simple) => {
      deleted => left.vertices{!interface.vertices.contains(.)}
      added => right.vertices{!interface.vertices.contains(.)}

      applies (host: Simple) => left.vertices.every(host.vertices.contains(.))
        && !deleted.some(host.dangling(., host.vertices{!deleted.contains(.)}.union(left.vertices)))
      apply (host: Simple) => applies(host) ? rewritten(deleted.reduce(acc = host => acc.without(.))) : ERROR@Rewrite `rewrite`
      rewritten (graph: Simple) => graph -- added.for(graph.vertex(.)) -- right.edges{!graph.connected(.from, .to)}.for(graph.connect(.from, .to)) -- graph
    }
    static SinglePushout := class: Rule {
      applies (host: Simple) => left.vertices.every(host.vertices.contains(.))
    }
  }
}
Forest := class: Structure{acyclic & consistent} {
  Vertex := Ray{terminal: Vertex.Boundary, initial: 1 Vertex.Boundary}
  HyperContinuations := true
}
Tree := class: Forest{connected}
Path := class: Structure{consistent & connected} {
  HyperContinuations := false

  paths => this
  length => acyclic ? count : ∞
}
Array &+= {
  push_back | push (x = ?) => (this &= x) -- this
  push_front (x) => {
    added = link x None
    added.next = head
    if head { head.previous = added } else { tail = added }
    head = added
  } -- this
  link_of (x, at = head) => !at ? None : at.value == x ? at : link_of(x, at.next)
  pop_front => head.remove.value
  pop_back => tail.remove.value
  remove (x) => link_of(x).remove -- this
  push_after (at, x) => {
    held = link_of(at)
    added = link x held
    added.next = held.next
    if held.next { held.next.previous = added } else { tail = added }
    held.next = added
  } -- this
  push_before (at, x) => link_of(at).previous ? push_after(link_of(at).previous.value, x) : push_front(x)
}
Iterable.components.hierarchy &= Ordered
Array.components.hierarchy &= Path{acyclic}
Chain.components.hierarchy &= Array
Link.components.hierarchy &= Ray

Set := class: Structure {
  orderless => true
  normalizer => .shuffled.unique
  add (x) => (push(x) unless contains(x)) -- this
}

Hierarchy := class: Ray {
  parent | previous : static? <- hierarchy -> children | next : static?
  // (until the line above is read: a node's parent, none at the root, and its children)
  parent: Hierarchy? = None
  children: Hierarchy[] = []
  children.for(child => child.parent = this)

  holds (child) => children.some(== child || .holds(child))
  add (child) => children.push(child) -- child.parent = this -- child
  depth => parent ? parent.depth + 1 : 0
}

Loop := class: Path (around: Iterable, at: *) => {
  next => Loop(around, at: at.next ?? around.first)
  previous => Loop(around, at: at.previous ?? around.last)
  is_initial => false
  is_terminal => false
  bounded => false
  acyclic => false

  unrolled => around
  instances (times: Number) => around * times
  unrolled_mod => around[at.index..], around[..<at.index]
  << (places: Number) => Loop(around, at: around[(at.index + places) % around.count])
  >> (places: Number) => this << (around.count - places % around.count)
  as (=== T) => [around[at.index..], around[..<at.index]].flatten as T
}

Node &+= {
  -> (step = 1) => Stepped(at: this, forward: step)
  right-to-left <- (base) => base is Stepped ? Stepped(at: base.at, forward: base.forward, backward: this) : Stepped(at: base, backward: this)
}
Stepped := class: Ray (at: *, forward: *?, backward: *?, behind: Stepped?, ahead: Stepped?) => {
  static stepped (step, from) => step is Number ? from + step : step(from)
  value => at
  next => ahead ?? (forward ? Stepped(at: stepped(forward, at), forward, backward, behind: this) : None)
  previous => behind ?? (backward ? Stepped(at: stepped(backward, at), forward, backward, ahead: this) : None)
  bounded => false
  == (other) => at == (other is Stepped ? other.at : other)
}

Filtered := class: Ray (from: Ray?, keeps: *) => {
  found => from ? (from.satisfies(keeps) ? this : Filtered(from: from.next, keeps).found) : None
  entry => found
  value => from.value ?? from
  next => from.next ? Filtered(from: from.next, keeps).found : None
  previous => None
  == (other) => value == (other is Filtered ? other.value : other)
}

...{of} ^punctuation => Spread(of: of)
Spread := class (of: *) => {
  spreads => true
  repeating => true
  repeats => of
}

{`{`}{ }{names}{ }{`}`} = {source} ^punctuation => (
  written := header_items((names**), `,`)
  inline (written.map**(. + " := source." + .).join("\n"))
)
Targets := String{.contains(",")}
({targets: Targets}) = {value} ^punctuation => (
  held := value
  written := header_items((targets**), `,`)
  inline (written.enumerate.map**(.value + " = held[" + (.index as String) + "]").join("\n"))
)

// `xs{p}` (QT6): a narrowing of a value is the Ray of its elements of which `p` holds, in order (a class's: its instances); it
// answers what that Ray answers (no comment inside the block: a narrowing's rule of one capture reads its statements)
Narrowing &+= {
  kept =>
    made := []
    narrowed := this.narrows
    holds := this.constraint
    narrowed.for(element => holds(element) ? made.append(element) : None)
    made
  head => this.kept.head
  tail => this.kept.tail
  count => this.kept.count
  first => this.kept.first
  last => this.kept.last
  empty => this.kept.empty
  nonempty => this.kept.nonempty
  map (mapping) => this.kept.map(mapping)
  every (predicate) => this.kept.every(predicate)
  some (predicate) => this.kept.some(predicate)
  contains (x) => this.kept.contains(x)
  join (separator) => this.kept.join(separator)
  flatten => this.kept.flatten
  for (body) => this.kept.for(body)
  reduce (step) => this.kept.reduce(step)
  enumerate => this.kept.enumerate
  sliced (slice_from, slice_to) => this.kept.sliced(slice_from, slice_to)
  chunk (size) => this.kept.chunk(size)
  sort_by (key) => this.kept.sort_by(key)
  unique => this.kept.unique
  rest => this.kept.rest
  sum => this.kept.sum
  max => this.kept.max
  min => this.kept.min
}
