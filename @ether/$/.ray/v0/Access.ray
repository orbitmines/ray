Access := class = who: *?, method: `=` | `()` | * = *, filter: Program? {
  static Reading := *{. != `=` && . != `()`}

  allows (called) => called ∈ method

  { }{target} ^punctuation => Permissions.current.grant(this, target)
}

{who}{{literal filter}}.read ^keyword => Access(who, method: Access.Reading, filter: Program(code: (external ** filter)))
{who}{{literal filter}}.write ^keyword => Access(who, method: `=`, filter: Program(code: (external ** filter)))
{who}{{literal filter}}.execute ^keyword => Access(who, method: `()`, filter: Program(code: (external ** filter)))

Accessor := Access{who is Accessor.Permission} {
  static Permission := enum local (at: @local) | localhost (at: @localhost) | managed (at: @private.managed) | private (at: @private) | confidential | protected | public (at: @public) {
    resolved => this == confidential ? Visibility.policy : this
    chainable < (other: Permission) => resolved.index < other.resolved.index
    reaches (who) => this == public || (this == confidential ? Visibility.policy.reaches(who) : at && who is at)
  }

  read => Accessor(who, method: Access.Reading)
  write => Accessor(who, method: `=`)
  execute => Accessor(who, method: `()`)

  allows (who: Character, called) => !(called ∈ method) || this.who.reaches(who) || who.permissions.contains(this.who)

  { }{target} ^punctuation => target ~~ .access = this
  block (values: *[]) => values ~~ #.access = this
  derived (from) => from.access ?? this

  static Consistency := class = replicas: *[] = [] {
    read (value) => replicas.every(.synced) ? value : Quest(name: "wait for the replicas", goal: value)
  }
}

Visibility := class {
  policy = Accessor.Permission.local

  of (item) => item ? item.access?.who ?? of(item.parent) : policy
  narrowest (levels: Accessor.Permission[]) => levels.min ?? policy
  derived (sources) => narrowest(sources.map(of(.)))

  mark (value, sources) => value ~~ .access = Accessor(derived(sources))
  may_leave (value) => of(value) != Accessor.Permission.local
}

Grant := class = access: Access, target: * {
  uses => Permissions.current.allowed.history{=== this}.count
  covers (who: Character, method, target) => (access.who == who || who is access.who) && access.allows(method) && this.target === target
    && (!access.filter || access.filter.entered(this, None))
}

Permissions := class = grants: Grant[] = [] {
  static current = Permissions()
  allowed: Grant?

  grant (access: Access, target) => grants.push Grant(access, target) -- target
  allows (who: Character, method, target) => grants{.covers(who, method, target)}.first ~~ (allowed = . if .)
}

Run := class = actor: Character?, origin: Character[] = [], settings: Settings? {
  static Mode := enum full | abstract | refused
  static current = Run()

  originating (character: Character) => Run(actor, origin: (origin, character), settings)
  hops | chain => origin.contains(actor) ? origin : (origin, actor)

  may (method, target) => hops.every(Permissions.current.allows(., method, target))
  ask (method, target) => may(method, target) ? true : Quest(name: prompt, goal: Grant(Access(origin.first, method), target))

  static called (character: Character) => character.PREFIX + character.name
  prompt => called(origin.first) + " wants to run this"
    + (origin.count > 1 ? ", originating from " + origin[1..].map(called(.)).join(" <- ") : "")

  mode (method) => (settings ?? Settings()).mode(method)

  static Settings := class = speculated: *[] = [], refused: *[] = [] {
    speculate (place): static => this ~~ speculated.push place
    refuse (place): static => this ~~ refused.push place
    mode (method) => refused.contains(method) ? Mode.refused
      : !(method** is Effecting) || speculated.contains(method) ? Mode.full
      : Mode.abstract
  }
}

&@ ^keyword => Run.current

Effects := class {
  static Source := enum io | os | random | time | network

  static Calls := class: Ray = at: Program {
    value => at
    continuations => at.calls{!.is_external}.map(Calls(at: .**))
  }

  static of (program: Program) => Calls(at: program).reachable
    .map(.at.calls{.is_external}.map(Source[.external_name])).flatten.compact.unique
}

Pure := Program{Effects.of(.).empty}
Deterministic := Program{!Effects.of(.).some(. is (Effects.Source.random | Effects.Source.time | Effects.Source.io))}
Nondeterministic := Program{!(. is Deterministic)}
Effecting := Program{Effects.of(.).some(. is (Effects.Source.io | Effects.Source.os | Effects.Source.network))}
Initializer := Program{.calls.every(.is_external && .external_name is ("declare" | "assign"))}

[pure: Pure, deterministic: Deterministic, nondeterministic: Nondeterministic].for (word, claim) => {
  right-to-left `word` {method} ^keyword => method -- (ERROR `this method is not what it is marked as` unless method** is claim)
}

Access &+= {
  reads => allows(`read`)
  writes => allows(`=`)
  executes => allows(`()`)

  static Enforcing := class = grants: Grant[] {
    target => grants.first?.target
    local => target is Location && !target.scheme
  }
  static Optimizations := {
    {enforcing: Enforcing{local && grants.every(.access.who is Accessor.Permission)}} => external os `chmod` (enforcing.target as String, enforcing.grants.access as POSIX)
    {enforcing: Enforcing{local}} => external os `setfacl` (enforcing.target as String, enforcing.grants.access as ACL)
    {enforcing: Enforcing{target is Device.Capability && OS().platform == "android"}} => external os `request_permissions` (enforcing.grants as Android)
    {enforcing: Enforcing{target is Device.Capability}} => external io `permissions` (enforcing.grants as Browser)
  }
  static enforced (grants: Grant[]) => Compiler.reduced(Enforcing(grants), Optimizations)
}

// File mode bits (https://pubs.opengroup.org/onlinepubs/9799919799/basedefs/sys_stat.h.html)
POSIX := class: Language {
  static extensions = ".mode"

  static Who := enum user | group | other
  static Triad := class (read: Binary¹ as boolean = false, write: Binary¹ as boolean = false, execute: Binary¹ as boolean = false) {
    static (access: Access) as (=== Triad) => Triad(access.reads, access.writes, access.executes)
  }
  static Mode := class (setuid: Binary¹ as boolean = false, setgid: Binary¹ as boolean = false, sticky: Binary¹ as boolean = false, user: Triad = Triad(), group: Triad = Triad(), other: Triad = Triad())
  // Absolute octal mode operand (https://pubs.opengroup.org/onlinepubs/9799919799/utilities/chmod.html)
  static Absolute := class (digits: Octal{< 8 ^ 4}) {
    mode => digits as Binary¹² as Mode
    static (mode: Mode) as (=== Absolute) => Absolute(digits: mode as Binary¹² as Octal)
  }
  // File mode string of ls -l (https://pubs.opengroup.org/onlinepubs/9799919799/utilities/ls.html)
  static Symbolic := class (
    type: "-" | "d" | "l" | "b" | "c" | "p" | "s" = "-",
    ur: "r" | "-", uw: "w" | "-", ux: "x" | "-" | "s" | "S",
    gr: "r" | "-", gw: "w" | "-", gx: "x" | "-" | "s" | "S",
    or: "r" | "-", ow: "w" | "-", ox: "x" | "-" | "t" | "T"
  ) {
    mode => Mode(setuid: ux is ("s" | "S"), setgid: gx is ("s" | "S"), sticky: ox is ("t" | "T"),
      user: Triad(ur == "r", uw == "w", ux is ("x" | "s")), group: Triad(gr == "r", gw == "w", gx is ("x" | "s")), other: Triad(or == "r", ow == "w", ox is ("x" | "t")))
    static (mode: Mode) as (=== Symbolic) => Symbolic(
      ur: mode.user.read ? "r" : "-", uw: mode.user.write ? "w" : "-", ux: mode.setuid ? (mode.user.execute ? "s" : "S") : mode.user.execute ? "x" : "-",
      gr: mode.group.read ? "r" : "-", gw: mode.group.write ? "w" : "-", gx: mode.setgid ? (mode.group.execute ? "s" : "S") : mode.group.execute ? "x" : "-",
      or: mode.other.read ? "r" : "-", ow: mode.other.write ? "w" : "-", ox: mode.sticky ? (mode.other.execute ? "t" : "T") : mode.other.execute ? "x" : "-")
  }

  static reaching (level: Accessor.Permission) => level.resolved -- (. == Accessor.Permission.public ? Who.(user, group, other)
    : . is (Accessor.Permission.protected | Accessor.Permission.managed) ? Who.(user, group) : [Who.user])
  static widest (mode: Mode, bit) => mode.other.`bit` ? Accessor.Permission.public
    : mode.group.`bit` ? Accessor.Permission.protected
    : mode.user.`bit` ? Accessor.Permission.private : None
  static triad (accessors: Access[], who: Who) => accessors{reaching(.who) ∋ who} -- (given => Triad(given.some(.reads), given.some(.writes), given.some(.executes)))
  static mode (accessors: Access[]) => Mode(user: triad(accessors, Who.user), group: triad(accessors, Who.group), other: triad(accessors, Who.other))

  level := {
    {absolute: Absolute} => absolute.mode
    {symbolic: Symbolic} => symbolic.mode
    {mode: Mode} => [Accessor(widest(mode, "read")).read, Accessor(widest(mode, "write")).write, Accessor(widest(mode, "execute")).execute]{.who}
  }
  written := {
    {writing: Language.Writing{value is Access[]}} => mode(writing.value) as Absolute
  }
}

// Access control lists, long text form (https://man7.org/linux/man-pages/man5/acl.5.html)
ACL := class: Language {
  static extensions = ".acl"

  static Entry := class (tag: "user" | "group" | "mask" | "other", ":", qualifier: (!":" && !\n)[], ":", read: "r" | "-", write: "w" | "-", execute: "x" | "-") {
    triad => POSIX.Triad(read == "r", write == "w", execute == "x")
    static (given: (tag: String, qualifier: String, triad: POSIX.Triad)) as (=== Entry) => Entry(given.tag, given.qualifier,
      read: given.triad.read ? "r" : "-", write: given.triad.write ? "w" : "-", execute: given.triad.execute ? "x" : "-")
  }
  static Wire := class ((("#", (!\n)[]) | entry: Entry)[].join(\n), \n?) {
    entries => this.entry{!= None}
    unnamed (tag: String) => entries{.tag == tag && .qualifier.empty}.first?.triad ?? POSIX.Triad()
    // Named entries and the group class are limited by the mask (https://man7.org/linux/man-pages/man5/acl.5.html)
    mask => entries{.tag == "mask"}.first?.triad
  }

  level := {
    {wire: Wire} => [
      Compiler.reduced(POSIX.Mode(user: wire.unnamed("user"), group: wire.unnamed("group"), other: wire.unnamed("other")), POSIX.level),
      wire.entries{.tag is ("user" | "group") && .qualifier.nonempty}.map(entry => Access(who: Character(name: entry.qualifier), method: [
        Access.Reading if entry.triad.read && (wire.mask?.read ?? true),
        `=` if entry.triad.write && (wire.mask?.write ?? true),
        `()` if entry.triad.execute && (wire.mask?.execute ?? true)
      ].compact))
    ].flatten
  }
  written := {
    {writing: Language.Writing{value is Access[]}} => writing.value -- (accessors => POSIX.mode(accessors{.who is Accessor.Permission}) -- (mode => Wire(entry: [
      (tag: "user", qualifier: "", triad: mode.user) as Entry,
      accessors{.who is Character}.map((tag: "user", qualifier: .who.name, triad: . as POSIX.Triad) as Entry),
      (tag: "group", qualifier: "", triad: mode.group) as Entry,
      (tag: "mask", qualifier: "", triad: Access(method: accessors{.who is Character}.method.flatten) as POSIX.Triad) as Entry if accessors.some(.who is Character),
      (tag: "other", qualifier: "", triad: mode.other) as Entry
    ].flatten)))
  }
}

// Permissions (https://w3c.github.io/permissions/) and Permissions Policy (https://w3c.github.io/webappsec-permissions-policy/)
Browser := class: Language {
  static extensions = ".permissions"

  // Powerful feature names (https://w3c.github.io/permissions-registry/)
  static Names = { storage: "persistent-storage", notifications: "notifications", camera: "camera", microphone: "microphone", geolocation: "geolocation", wake_lock: "screen-wake-lock" }
  static named (grant: Grant) => grant.target == Device.Capability.clipboard ? (grant.access.writes ? "clipboard-write" : "clipboard-read") : Names[grant.target.name]
  static capability (name: String) => name ~= ⊢"clipboard-" ? Device.Capability.clipboard : Device.Capability#{Names[.name] == name}.first
  // PermissionState (https://w3c.github.io/permissions/#dom-permissionstate)
  static State := enum granted | denied | prompt
  static state (grant: Grant) => Run.current.settings?.refused.contains(grant.target) ? State.denied
    : grant.access.who is Accessor.Permission && grant.access.who.reaches(Run.current.actor) ? State.granted
    : State.prompt

  // Permissions-Policy header: a feature and its allowlist (https://w3c.github.io/webappsec-permissions-policy/#structured-header-serialization)
  static Policy := class ((entries: (feature: HTTP.Token, "=", allowlist: "*" | ("(", origins: ("self" | ("\"", (!"\"")[], "\""))[].join(" "), ")")))[].join(", ")) {
    static allowed (level: Accessor.Permission) => level.resolved == Accessor.Permission.public ? "*"
      : level.resolved is (Accessor.Permission.protected | Accessor.Permission.managed) ? "(self " + level.at.map("\"" + . as String + "\"").join(" ") + ")"
      : "(self)"
  }

  level := {
    {policy: Policy} => policy.entries.map(entry => Grant(Access(who: entry.allowlist == "*" ? Accessor.Permission.public : entry.origins.count > 1 ? Accessor.Permission.protected : Accessor.Permission.localhost,
      method: entry.feature == "clipboard-write" ? `=` : Access.Reading), target: capability(entry.feature)))
  }
  written := {
    {writing: Language.Writing{value is Grant[]}} => Policy(entries: writing.value.map((feature: named(.), allowlist: Policy.allowed(.access.who))))
  }
}

// Android manifest permissions (https://developer.android.com/reference/android/Manifest.permission)
Android := class: Language {
  static extensions = ".manifest"

  static Names = { network: "INTERNET", notifications: "POST_NOTIFICATIONS", camera: "CAMERA", microphone: "RECORD_AUDIO", geolocation: "ACCESS_FINE_LOCATION", vibration: "VIBRATE", wake_lock: "WAKE_LOCK" }
  // <uses-permission> (https://developer.android.com/guide/topics/manifest/uses-permission-element)
  level := {
    {element: XML.Element{name == "uses-permission"}} => Grant(Access(who: Accessor.Permission.localhost), target: Device.Capability#{"android.permission." + Names[.name] == element["android:name"]}.first)
  }
  written := {
    {writing: Language.Writing{value is Grant[]}} => writing.value.map(grant => XML.Element(name: "uses-permission", attributes: [(name: "android:name", value: "android.permission." + Names[grant.target.name])]))
  }
}

Device &+= {
  granted: Grant[] = []

  permission (capability: Capability) => granted{.target == capability}.last -- (. ? Browser.state(.) : Browser.State.prompt)
  grant (capability: Capability, access: Access = Access(who: Accessor.Permission.localhost)): static => this ~~ granted.push Grant(access, target: capability) ~~ Access.enforced([granted.last])
  allows (capability: Capability) => permission(capability) == Browser.State.granted
}
