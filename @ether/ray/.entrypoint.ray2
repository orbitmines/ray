// `x ~~ …`: the same, answering `x`. Code read in a value, `.` that value (`x reading { … }`; `x with { … }`, below).
-- {{rest}} =>
  {rest}
// `--` continues on everything before it on the line; `~~` too, answering that line (A-C5)
// DD1 -- does not continue on the whole line before it
assert (1, 2 -- .map(+1)) == (2, 3)
// DD2 -- does not give what it continues with as .
assert (5 -- . + 1) == 6
// DD3 -- with a condition that holds does not continue
assert (5 -- . + 1 if . > 3) == 6
// DD4 -- with a condition that fails does not keep what is before it
assert (5 -- . + 1 if . > 9) == 5
assert {
