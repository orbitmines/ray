Store := class: Location {
  static Route := class = type: *, store: Store {
    takes (instance) => instance is type
  }
  static routes: Route[] = []
  static materialised: *?
  static default: Store = @local

  static route (type, store: Store) => routes.push Route(type, store) -- store
  static routed (instance) => routes{.takes(instance)}.first?.store ?? default
  static keep (instance) => routed(instance).add(instance)
  static constructed (instance) => instance -- keep(.) if instance is materialised

  static View (type) => (materialised |= type) -- (routes{.type === type || type is .type}.store, default).unique.children.flatten{is type}
}
