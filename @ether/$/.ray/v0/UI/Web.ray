Language.Web := class: Language {
  static extensions = ".web"
  HTML := class {
    Element := class = tag: String, attributes: (name: String, value: String)[] = [], children: (Element | Text | Raw | Comment)[] = [] {
      static made = 0
      id: String = attributes{.name == "id"}.first?.value ?? ("e" + ((Element.made += 1) as String))
      void => tag is ("img" | "input" | "br" | "meta" | "link" | "source")
    }
    Text := class = text: String
    Raw := class = text: String
    Comment := class = text: String
    Document := class = head: Element[], body: Element, language: String = "en"

    Page := class = shape: Geometry.Shape
    Head := class
    Meta := class = name: String, content: *
    Named := class = shape: Geometry.Shape
    Described := class = shape: Geometry.Shape
    Entry := class = input: UI.Input
    Inner := class = shape: Geometry.Shape
    Spans := class = shape: Geometry.Shape
    Span := class = text: String, from: Number, shape: Geometry.Shape
    Inline := class = face: *, shape: Geometry.Shape
    Path := class = segment: *

    Escapes = { "<": "&lt;", ">": "&gt;", "&": "&amp;", "\"": "&quot;" }
    escaped (text: String) => #text.map(Escapes[.] ?? .) as String

    Name = (Char.Letter, (Char.Word | "-" | ":" | ".")[])
    Entities = { "lt": "<", "gt": ">", "amp": "&", "quot": "\"", "apos": "'", "nbsp": U+00A0 }
    child (value) => value === None ? []
      : value is String ? (value.trimmed.empty && value.contains(\n) ? [] : [Text(value)])
      : value is Number ? [Text(value as String)]
      : value is (Element | Text | Raw | Comment) ? [value]
      : value is Iterable ? value.map(child).flatten(1)
      : [value]
    attributed (value) => value === None ? []
      : value is String ? [(value, "")]
      : value is Iterable && !(value.first is String) ? value.map(attributed).flatten(1)
      : [value]

    syntax := Compiler.default + {
      <!--{literal text}--> => Comment(text)
      <{tag: Name}{attributes}/> => Element(tag, attributed(attributes))
      <{tag: Name}{attributes}>{children}</{tag}> => Element(tag, attributed(attributes), child(children))
      {name: Name}="{value}" => (name, value)
      {name: Name}={value} => value === None || value == false ? None : value == true ? (name, "") : (name, value)
      &{name: Char.Letter[]}; => Entities[name] ?? ("&" + name + ";")
    }

    rules := CSS.values + {
      {page: HTML.Page} => Document(head: [Head()], body: @html <body>{page.shape}</body>)
      {head: Head} => @html {
        <title>{UI.Navigation.title}</title>
        <meta name="description" content={UI.Navigation.description} />
        {UI.Navigation.tags.map(Meta(.name, .content))}
        {Meta("theme-color", CSS.Paint(UI.Navigation.theme)) if UI.Navigation.theme}
        {[("canonical", UI.Navigation.canonical), ("icon", UI.Navigation.icon), ("apple-touch-icon", UI.Navigation.apple_icon), ("manifest", UI.Navigation.manifest)]{.1 != None}.map((rel, at) => @html <link rel={rel} href={at as String} />)}
        {UI.Navigation.structured.map(entry => @html <script type="application/ld+json">{Raw(JSON.write(JSON.Linked(entry, context: "https://schema.org")))}</script>)}
        <link rel="stylesheet" href="style.css" />
        <script src="app.js" defer />
      }
      {meta: Meta{name ~= ("og:" | "article:" | "fb:", *)}} => @html <meta property={meta.name} content={meta.content} />
      {meta: Meta} => @html <meta name={meta.name} content={meta.content} />

      {link: Geometry.Shape{location}} => @html <a {Named(link)} href={link.location as String} target={"_blank" if link.location.window == new} rel={"noopener noreferrer" if link.location.window == new}>{Inner(link)}</a>
      {text: Geometry.Shape{content is String && role == heading && font.size >= 2em}} => @html <h1 {Named(text)}>{Spans(text)}</h1>
      {text: Geometry.Shape{content is String && role == heading && font.size >= 1.5em}} => @html <h2 {Named(text)}>{Spans(text)}</h2>
      {text: Geometry.Shape{content is String && role == heading}} => @html <h3 {Named(text)}>{Spans(text)}</h3>
      {text: Geometry.Shape{content is String && wrap == none}} => @html <span {Named(text)} dir={text.direction == right-to-left ? "rtl" : "ltr"}>{Spans(text)}</span>
      {text: Geometry.Shape{content is String}} => @html <p {Named(text)} dir={text.direction == right-to-left ? "rtl" : "ltr"}>{Spans(text)}</p>
      {image: Geometry.Shape{content is Location && content.language === UI.Image && fill}} => @html <span {Named(image)} role="img" aria-label={image.label} />
      {image: Geometry.Shape{content is Location && content.language === UI.Image}} => @html <img {Named(image)} src={image.content as String} alt={image.label} loading="lazy" />
      {video: Geometry.Shape{content is Location && content.language === UI.Video}} => @html <video {Named(video)} src={video.content as String} controls={video.content.controls} muted={video.content.muted} loop={video.content.looping} />
      {audio: Geometry.Shape{content is Location && content.language === UI.Audio}} => @html <audio {Named(audio)} src={audio.content as String} controls />
      {frame: Geometry.Shape{content is Location && content.video_site}} => @html <iframe {Named(frame)} src={frame.content.embedded as String} title={frame.content.alt ?? ""} allow="fullscreen; picture-in-picture; encrypted-media" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" />
      {canvas: Geometry.Shape{content is Program}} => @html <canvas {Named(canvas)} width={canvas.size.x as px} height={canvas.size.y as px} />
      {ball: Geometry.Ball} => @html <svg {Named(ball)} viewBox="0 0 {ball.size.x as px} {ball.size.y as px}">
        <ellipse cx="50%" cy="50%" rx="50%" ry="50%" />
      </svg>
      {polygon: Geometry.Polygon} => @html <svg {Named(polygon)} viewBox="0 0 {polygon.size.x as px} {polygon.size.y as px}">
        <polygon points={polygon.points.map(.x as px, ",", .y as px).join(" ")} />
      </svg>
      {outline: Geometry.Outline} => @html <svg {Named(outline)} viewBox="0 0 {outline.size.x as px} {outline.size.y as px}">
        <path d="M{outline.from.x as px} {outline.from.y as px}{outline.segments.map(Path(.))}{" Z" if outline.closed}" />
      </svg>
      {path: Path{segment is Geometry.Quadratic}} => path.segment -- (" Q", .control.x, " ", .control.y, " ", .to.x, " ", .to.y)
      {path: Path{segment is Geometry.Cubic}} => path.segment -- (" C", .first.x, " ", .first.y, " ", .second.x, " ", .second.y, " ", .to.x, " ", .to.y)
      {path: Path{segment is Geometry.Arc}} => path.segment -- (" A", .radius.x, " ", .radius.y, " ", .rotation, " ", .large ? 1 : 0, " ", .sweep ? 1 : 0, " ", .to.x, " ", .to.y)
      {path: Path} => " L", path.segment.x, " ", path.segment.y

      {form: UI.Form} => @html <form {Named(form)}>{form.inputs}</form>
      {input: UI.TextField} => @html <input {Named(input)} type="text" {Entry(input)} />
      {input: UI.Secret} => @html <input {Named(input)} type="password" {Entry(input)} />
      {input: UI.NumberField} => @html <input {Named(input)} type="number" {Entry(input)} />
      {input: UI.DateField} => @html <input {Named(input)} type="datetime-local" {Entry(input)} />
      {input: UI.ColorField} => @html <input {Named(input)} type="color" {Entry(input)} />
      {input: UI.FileField} => @html <input {Named(input)} type="file" {Entry(input)} />
      {input: UI.Checkbox} => @html <input {Named(input)} type="checkbox" {Entry(input)} />
      {input: UI.Slider} => @html <input {Named(input)} type="range" {Entry(input)} min={input.chosen.type.least as String} max={input.chosen.type.most as String} />
      {input: UI.TextArea{language}} => @html <div id={input.id} class={["painted", input.styles].flatten.join(" ")}>
        <pre id="{input.id}-paint" aria-hidden="true">{Spans(input.face)}</pre>
        <textarea id="{input.id}-text" placeholder={input.placeholder} spellcheck="false">{input.empty ? "" : input.value as String}</textarea>
      </div>
      {input: UI.TextArea} => @html <textarea {Named(input)} placeholder={input.placeholder}>{input.empty ? "" : input.value as String}</textarea>
      {input: UI.Select} => @html <select {Named(input)}>{input.options.map(@html <option value={. as String}>{. as String}</option>)}</select>

      {box: Geometry.Shape{activate}} => @html <button {Named(box)} {Described(box)}>{box.children}</button>
      {box: Geometry.Shape{role == table}} => @html <table {Named(box)} {Described(box)}>{box.children}</table>
      {box: Geometry.Shape{role == list}} => @html <ul {Named(box)} {Described(box)}>{box.children}</ul>
      {box: Geometry.Shape{role == region}} => @html <section {Named(box)} {Described(box)}>{box.children}</section>
      {box: Geometry.Shape} => @html <div {Named(box)} {Described(box)}>{box.children}</div>

      {named: Named} => [("id", named.shape.id), ("class", named.shape.styles.join(" ")) if named.shape.styles.nonempty]
      {described: Described} => [("role", described.shape.role as String), ("aria-label", described.shape.label) if described.shape.label, ("popover", "manual") if described.shape.position.kind == anchored]
      {entry: Entry} => [("placeholder", entry.input.placeholder), ("disabled", "") if entry.input.disabled]
      {inner: Inner{shape.content is String}} => [Spans(inner.shape), inner.shape.children]
      {inner: Inner} => inner.shape.children
      {spans: Spans{shape.content.partial_marks.empty}} => Text(spans.shape.content)
      {spans: Spans} => spans.shape.content.pieces.map(Span(.text, .from, spans.shape))
      {span: Span} => span.shape.content.partial_marks{.from <= span.from < .to}.style -- (styles => styles.empty ? Text(span.text)
        : @html <span class={styles.join(" ")} style={Inline(UI.Theme.face(span.shape, span.from), span.shape)}>{span.text}</span>)
      {inline: Inline} => inline.face -- (face => [
        ("color:", CSS.Paint(face.color), ";") if face.color && face.color != inline.shape.color,
        ("background:", CSS.Paint(face.fill), ";") if face.fill && face.fill != inline.shape.fill,
        ("font-weight:", face.font.weight, ";") if face.font.weight != inline.shape.typeface.weight,
        ("font-style:", face.font.style as String, ";") if face.font.style != inline.shape.typeface.style
      ])
    }

    written := {
      {document: Document} => "<!doctype html><html lang=\"", document.language, "\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">", document.head, "</head>", document.body, "</html>"
      {element: Element{void}} => "<", element.tag, element.attributes.map(" ", .name, "=\"", escaped(.value as String), "\""), ">"
      {element: Element} => "<", element.tag, element.attributes.map(" ", .name, "=\"", escaped(.value as String), "\""), ">", element.children, "</", element.tag, ">"
      {text: Text} => escaped(text.text)
      {raw: Raw} => raw.text
      {comment: Comment} => "<!--", comment.text, "-->"
    }
    language = Language.register(Language(".html", level: syntax, writer: (node) => Compiler.reduced(node, written) as String))

    level := UI.Rendering + {
      {solved: Geometry.Solved} => Page(solved.shape)
    } + rules
  }

  CSS := class {
    Rule := class = selector: String, declarations: ((property: String, value: String) | Comment)[], within: String?
    Keyframes := class = name: String, frames: (at: Probability, declarations: ((property: String, value: String) | Comment)[])[]
    Comment := class = text: String
    Sheet := class = rules: (Rule | Keyframes | Comment)[] = []

    Page := class = shape: Geometry.Shape
    Styles := class = shape: Geometry.Shape
    Anchoring := class = shape: Geometry.Shape, scene: Geometry.Shape
    Layout := class = shape: Geometry.Shape
    Width := class = constraint: Geometry.Constraint
    Height := class = constraint: Geometry.Constraint
    Aligned := class = constraint: Geometry.Constraint
    Spaced := class = name: String, edges: Geometry.Edges
    Positioned := class = shape: Geometry.Shape
    Effected := class = effect: Geometry.Effect
    Specific := class = shape: Geometry.Shape
    Placeholder := class = shape: Geometry.Shape
    Switchable := class = shape: Geometry.Shape
    Styling := class = name: String
    Responsive := class = shape: Geometry.Shape, constraint: Geometry.Constraint
    Step := class = constraint: Geometry.Constraint, at: Geometry.Breakpoint, next: Geometry.Breakpoint?
    Chord := class = from: Geometry.Breakpoint, to: Geometry.Breakpoint
    Paint := class = value: Geometry.Paint
    Measure := class = length: Geometry.Length
    Typeface := class = font: Geometry.Font
    Timing := class = easing: Geometry.Easing
    Mask := class = shape: Geometry.Shape

    WhiteSpace = { normal: "normal", nowrap: "nowrap", pre: "pre", pre_wrap: "pre-wrap", pre_line: "pre-line" }
    Sides = { all: "", top: "-top", bottom: "-bottom", left: "-left", right: "-right", horizontal: "-inline", vertical: "-block" }
    Cases = { upper: "uppercase", lower: "lowercase", title: "capitalize" }

    syntax := Compiler.default + {
      /*{literal text}*/ => Comment(text)
      {property}:{value}; => (property as String, value) if value != None
      {selector}{`{`}{declarations: *[]}{`}`} => Rule((selector as String).trimmed, declarations{!= None})
      @keyframes {name}{`{`}{frames: *[]}{`}`} => Keyframes((name as String).trimmed, frames)
      from{`{`}{declarations: *[]}{`}`} => (at: 0, declarations: declarations{!= None})
      to{`{`}{declarations: *[]}{`}`} => (at: 1, declarations: declarations{!= None})
      {percent: Decimal}%{`{`}{declarations: *[]}{`}`} => (at: percent / 100, declarations: declarations{!= None})
      @{prelude}{`{`}{rules: *[]}{`}`} => rules{!= None}.map(. is Rule ? Rule(.selector, .declarations, within: "@" + (prelude as String).trimmed) : .)
        -- (.count == 1 ? .first : .)
    }

    values := {
      {paint: Paint{value is Geometry.Inherited}} => "currentColor"
      {paint: Paint{value is Geometry.Color}} => "rgba(", paint.value.red, ",", paint.value.green, ",", paint.value.blue, ",", paint.value.alpha, ")"
      {paint: Paint{value is Geometry.Gradient}} => paint.value.kind as String, "-gradient(", (paint.value.angle, "turn,") if paint.value.kind == linear, paint.value.stops.map(("," if .index > 0), Paint(.color), " ", .at * 100, "%"), ")"
      {paint: Paint{value is Geometry.Pattern}} => "url(#", paint.value.shape.id, ")"
      {measure: Measure{length is Number}} => measure.length, "px"
      {measure: Measure{length.quantities.count > 1}} => "calc(", measure.length.quantities.map(.quantity, .unit.symbol).join(" + "), ")"
      {measure: Measure} => measure.length.amount, measure.length.unit.symbol
    }

    rules := values + {
      {page: CSS.Page} => Sheet(@css {
        * { box-sizing: border-box; margin: 0; }
        body { font-family: sans-serif; line-height: 1.2; }
        .painted { display: grid; }
        .painted>pre,.painted>textarea { grid-area: 1/1; margin: 0; padding: 0; border: none; font: inherit; white-space: pre-wrap; overflow-wrap: anywhere; overflow: hidden; }
        .painted>textarea { color: transparent; caret-color: currentColor; background: transparent; resize: none; outline: none; }
        @media (prefers-reduced-motion:reduce) { * { animation: none; transition: none; } }
        html.locked { overflow: hidden; }
        {page.shape.expand.map(Styles(.))}
        {page.shape.expand{.position.kind == anchored}.map(Anchoring(., page.shape))}
      })
      {anchoring: Anchoring} => anchoring.shape.anchor_in(anchoring.scene) -- (anchor => @css {
        #{anchor.id} { anchor-name: --{anchor.id}; }
        #{anchoring.shape.id} { position: fixed; inset: auto; margin: 0; position-anchor: --{anchor.id}; position-area: {anchoring.shape.position.side as String}; }
      })
      {styles: Styles} => styles.shape -- (shape => [
        @css #{shape.id} {
          {Layout(shape)}
          gap: {Measure(shape.gap.y)} {Measure(shape.gap.x)};
          {shape.constraints{.dimension == "x"}.map(Width(.))}
          {shape.constraints{.dimension == "y"}.map(Height(.))}
          container-type: {"inline-size" if shape.children.some(.constraints.some(.responsive))};
          {Spaced("padding", shape.padding)}
          {Spaced("margin", shape.margin)}
          {Positioned(shape)}
          background: {Paint(shape.fill) if shape.fill};
          border{Sides[shape.stroke.sides]}: {(shape.stroke.width as px, "px ", shape.stroke.dash.empty ? "solid" : "dashed", " ", Paint(shape.stroke.paint)) if shape.stroke};
          border-radius: {shape.radius.map(. as px, "px").join(" ") if shape.radius != [0]};
          transform: {("matrix3d(", shape.transform.matrix.transposed.flatten.join(","), ")") if shape.transform != Geometry.Transform()};
          overflow: {shape.overflow == scroll ? "auto" : shape.overflow as String};
          z-index: {shape.layer if shape.layer != 0};
          mix-blend-mode: {(shape.blend as String) if shape.blend != normal};
          {shape.effects.map(Effected(.))}
          color: {Paint(shape.color) if shape.color};
          {Typeface(shape.font) if shape.font}
          text-align: {(shape.align as String) if shape.align};
          text-overflow: {(shape.truncate as String) if shape.truncate};
          white-space: {WhiteSpace[shape.white_space ?? pre_line] if shape.white_space || shape.content is String};
          overflow-wrap: {"anywhere" if shape.wrap == anywhere};
          {Specific(shape)}
          transition: {("all ", shape.transition.duration as ms, "ms ", Timing(shape.transition.easing)) if shape.transition};
          cursor: {(shape.cursor != default ? shape.cursor as String : "pointer") if shape.cursor != default || shape.activate};
          touch-action: {(shape.touch as String).replace("_", "-") if shape.touch != auto};
          scrollbar-width: {"none" if shape.scrollbar == hidden};
        },
        Placeholder(shape),
        Switchable(shape),
        @css #{shape.id}:focus-visible { outline: 2px solid currentColor; } if shape.focusable,
        shape.constraints{.responsive}.map(Responsive(shape, .)),
        shape.animations.map(animation => @css @keyframes {shape.id}-{animation.property} {
          from { {animation.property}: {animation.from as String}; }
          to { {animation.property}: {animation.to as String}; }
        })
      ])

      {layout: Layout{shape.flow == inline}} => @css { display: flex; flex-wrap: {layout.shape.constraints.wrap.last ? "wrap" : "nowrap"}; }
      {layout: Layout{shape.flow == grid}} => @css { display: grid; grid-template-columns: repeat({layout.shape.constraints.columns.last ?? 1},1fr); }
      {layout: Layout{shape.flow == layered}} => @css { display: grid; grid-template-areas: "layer"; }
      {layout: Layout} => @css { display: flex; flex-direction: column; }

      {width: Width} => width.constraint -- (constraint => @css {
        width: {(constraint.share * 100, "%") if constraint.share is Number};
        width: {(constraint.stops.first.share * 100, "%") if constraint.responsive};
        max-width: {Measure(constraint.most) if constraint.most != None};
        min-width: {Measure(constraint.least) if constraint.least != None};
        aspect-ratio: {constraint.aspect if constraint.aspect};
        {Aligned(constraint)}
      })
      {height: Height} => height.constraint -- (constraint => @css {
        max-height: {Measure(constraint.most) if constraint.most != None};
        min-height: {Measure(constraint.least) if constraint.least != None};
        align-items: {"center" if constraint.align == middle};
      })
      {aligned: Aligned{constraint.align == center}} => @css { margin-inline: auto; }
      {aligned: Aligned{constraint.align == end}} => @css { margin-inline-start: auto; }
      {aligned: Aligned{constraint.align == between}} => @css { justify-content: space-between; }
      {aligned: Aligned} => []

      {spaced: Spaced} => [("top", spaced.edges.top), ("right", spaced.edges.right), ("bottom", spaced.edges.bottom), ("left", spaced.edges.left)]{.1 != 0}.map((spaced.name + "-" + .0, Measure(.1)))

      {positioned: Positioned{shape.position.kind == anchored}} => []
      {positioned: Positioned} => positioned.shape -- (shape => @css {
        position: {(shape.position.kind as String) if shape.position.kind is (sticky | fixed | absolute)};
        position: {"relative" if shape.position.kind == flow && shape.children.some(.position.kind == absolute)};
        {[("top", shape.position.top), ("right", shape.position.right), ("bottom", shape.position.bottom), ("left", shape.position.left)]{.1 != None}.map((.0, Measure(.1)))}
      })

      {effected: Effected{effect is Geometry.Opacity}} => @css { opacity: {effected.effect.amount}; }
      {effected: Effected{effect is Geometry.Shadow}} => effected.effect -- (shadow => @css { box-shadow: {"inset " if shadow.inset}{shadow.offset.x as px}px {shadow.offset.y as px}px {shadow.blur as px}px {shadow.spread as px}px {Paint(shadow.color)}; })
      {effected: Effected{effect is Geometry.Blur}} => @css { filter: blur({effected.effect.radius as px}px); }
      {effected: Effected{effect is Geometry.Filter}} => @css { filter: {effected.effect.kind as String}({effected.effect.amount}); }
      {effected: Effected} => []

      {typeface: Typeface} => typeface.font -- (font => @css {
        font-family: {font.family.join(",") if font.family != Geometry.Font().family};
        font-size: {Measure(font.size) if font.size != Geometry.Font().size};
        font-weight: {font.weight if font.weight != Geometry.Font().weight};
        font-style: {(font.style as String) if font.style != normal};
        line-height: {font.line_height if font.line_height != Geometry.Font().line_height};
        text-transform: {Cases[font.case] if font.case != none};
        letter-spacing: {Measure(font.tracking) if font.tracking != 0};
      })

      {specific: Specific{shape.content is Location && shape.content.language === UI.Image && shape.fill}} => specific.shape -- (image => @css {
        object-fit: {image.content.fit as String}; display: inline-block; mask: {Mask(image)}; -webkit-mask: {Mask(image)};
      })
      {specific: Specific{shape.content is Location && shape.content.language === UI.Image}} => @css { object-fit: {specific.shape.content.fit as String}; }
      {specific: Specific{shape.content is Location && shape.content.video_site}} => @css { border: 0; aspect-ratio: 16/9; width: 100%; }
      {specific: Specific} => []

      {placeholder: Placeholder{shape is UI.Input && shape.placeholder_color}} => @css #{placeholder.shape.id}::placeholder { color: {Paint(placeholder.shape.placeholder_color)}; }
      {placeholder: Placeholder} => []

      {switchable: Switchable{shape.dynamics.some(.target == "class")}} => UI.Theme.styles.map(style => @css #{switchable.shape.id}.{style.name} { {Styling(style.name)} })
      {switchable: Switchable} => []
      {styling: Styling} => Compiler.reduced(Styles(Geometry.Box()), rules).first.declarations -- (plain => Compiler.reduced(Styles(Geometry.Box().styled(styling.name)), rules).first.declarations{!plain.contains(.)})

      {responsive: Responsive} => responsive.constraint.stops -- (stops => stops.zip([stops.rest, None]).map((at, next) => @css @container (min-width:{Compiler.reduced(Measure(at.width), values) as String}) {
        #{responsive.shape.id} { width: {Step(responsive.constraint, at, next)}; }
      }))
      {step: Step{constraint.share is Geometry.Interpolated && next}} => Chord(step.at, step.next)
      {step: Step} => step.at.share * 100, "%"
      {chord: Chord} => "calc(", chord.from.share * (chord.from.width as px), "px + (100cqw - ", chord.from.width as px, "px) * ", (chord.to.share * (chord.to.width as px) - chord.from.share * (chord.from.width as px)) / ((chord.to.width - chord.from.width) as px), ")"

      {timing: Timing{easing === Geometry.linear}} => "linear"
      {timing: Timing{easing === Geometry.ease_in}} => "ease-in"
      {timing: Timing{easing === Geometry.ease_out}} => "ease-out"
      {timing: Timing} => "ease"

      {mask: Mask{shape.content.fit == fill}} => "url(\"", mask.shape.content as String, "\") center/100% 100% no-repeat"
      {mask: Mask} => "url(\"", mask.shape.content as String, "\") center/", mask.shape.content.fit as String, " no-repeat"
    }

    written := {
      {sheet: Sheet} => sheet.rules
      {rule: Rule{within}} => rule.within, "{", Rule(rule.selector, rule.declarations), "}"
      {rule: Rule} => rule.selector, "{", rule.declarations.map(. is Comment ? . : (.0, ":", .[1..], ";")), "}"
      {keyframes: Keyframes} => "@keyframes ", keyframes.name, "{", keyframes.frames.map(.at * 100, "%{", .declarations.map(. is Comment ? . : (.0, ":", .[1..], ";")), "}"), "}"
      {comment: Comment} => "/*", comment.text, "*/"
    }
    language = Language.register(Language(".css", level: syntax, writer: (node) => Compiler.reduced(node, written) as String))

    level := UI.Rendering + {
      {solved: Geometry.Solved} => Page(solved.shape)
    } + rules
  }

  JSON := class {
    Object := class = entries: (name: String, value: *)[]
    Value := class = value: *
    Linked := class = value: *, context: String?

    Escapes = { "\"": "\\\"", "\\": "\\\\", "<": "\\u003c", \n: "\\n" }
    escaped (text: String) => #text.map(Escapes[.] ?? .) as String

    written := {
      {linked: Linked{value == None}} => Value(None)
      {linked: Linked{value is (String | Number | boolean | Location)}} => Value(linked.value)
      {linked: Linked{value is Iterable}} => Value(linked.value.map(Linked(.)))
      {linked: Linked} => Value(Object([("@context", linked.context) if linked.context, linked.value.fields{.value != None}.map((name: .name == "type" ? "@type" : .name, value: Linked(.value)))].flatten))
      {json: Value{value is Linked}} => json.value
      {json: Value{value == None}} => "null"
      {json: Value{value is boolean}} => json.value ? "true" : "false"
      {json: Value{value is Number}} => json.value as String
      {json: Value{value is String}} => "\"", escaped(json.value), "\""
      {json: Value{value is Location}} => Value(json.value as String)
      {json: Value{value is Object}} => "{", json.value.entries{.value != None}.map(("," if .index > 0), Value(.name), ":", Value(.value)), "}"
      {json: Value{value is Iterable}} => "[", json.value.map(("," if .index > 0), Value(.)), "]"
      {json: Value} => Value(Object(json.value.fields.map((name: .name, value: .value))))
    }
    write (value) => Compiler.reduced(Value(value), written) as String
  }

  JS := class {
    Module := class = statements: Statement[] = []
    Statement := Let | Assign | Effect | Listen | Call | Function | Return | If | Raw | Comment | String
    Let := class = name: String, value: Expression
    Assign := class = target: Expression, value: Expression
    Effect := class = reads: String[], body: Statement[]
    Listen := class = target: Expression, event: String, body: Statement[]
    Call := class = function: Expression, arguments: Expression[] = []
    Function := class = name: String?, parameters: String[], body: Statement[] {
      statements => body.count == 1 && body.first is Return ? [body.first.value] : body
    }
    Return := class = value: Expression
    If := class = condition: Expression, then: Statement[], otherwise: Statement[] = []
    Raw := class = code: String
    Comment := class = text: String
    Member := class = object: Expression, member: String
    Operation := class = left: Expression, operator: String, right: Expression
    Ternary := class = condition: Expression, then: Expression, otherwise: Expression
    Prefix := class = operator: String, operand: Expression
    Record := class = entries: (name: String, value: Expression)[]
    Listing := class = elements: Expression[]
    Literal := class = value: *
    ById := class = id: String
    Expression := String | Number | Call | Function | Raw | Member | Operation | Ternary | Prefix | Record | Listing | Literal | ById
    Built := Let | Assign | Effect | Listen | Call | Function | Return | If | Raw | Comment | Member | Operation | Ternary | Prefix | Record | Listing | Literal | ById

    spliced (value) => value is Built ? value : Literal(value)
    statements (value) => value === None ? []
      : value is Iterable && !(value is (String | Built)) ? value.map(statements).flatten(1)
      : [spliced(value)]
    named (parameters: String) => parameters.split(",").map(.trimmed){!.empty}
    called (callee, arguments) => callee is Member && callee.member == "addEventListener" && arguments.count == 2 && arguments.first is Literal && arguments.last is Function
        ? Listen(callee.object, arguments.first.value, arguments.last.statements)
      : callee is Raw && callee.code == "effect" && arguments.count == 2 && arguments.first is Literal && arguments.last is Function
        ? Effect(arguments.first.value, arguments.last.statements)
      : callee is Member && callee.object is Raw && callee.object.code == "document" && callee.member == "getElementById" && arguments.count == 1 && arguments.first is Literal
        ? ById(arguments.first.value)
      : Call(callee, arguments)

    Identifier = (Char.Letter | "_" | "$", (Char.Word | "$")[])

    syntax := Compiler.default + {
      //{literal text: (!\n)[]} => Comment(text)
      /*{literal text}*/ => Comment(text)
      {`{`}{lines}{`}`} => statements(lines)
      {binding: "const" | "let" | "var"} {name: Identifier} = {value} => Let(name, spliced(value))
      return {value} => Return(spliced(value))
      if ({condition}) {then} else {otherwise} => If(spliced(condition), statements(then), statements(otherwise))
      if ({condition}) {then} => If(spliced(condition), statements(then))
      function {name: Identifier}({parameters: Parameters}) {body} => Function(name, named(parameters), statements(body))
      ({parameters: Parameters}) => {body} => Function(None, named(parameters), body is Iterable && !(body is (String | Built)) ? statements(body) : [Return(spliced(body))])
      {target} = {value} => Assign(spliced(target), spliced(value))
      {condition} ? {then} : {otherwise} => Ternary(spliced(condition), spliced(then), spliced(otherwise))
      {left} ?? {right} => Operation(spliced(left), "??", spliced(right))
      {left} || {right} => Operation(spliced(left), "||", spliced(right))
      {left} && {right} => Operation(spliced(left), "&&", spliced(right))
      {left} === {right} => Operation(spliced(left), "===", spliced(right))
      {left} !== {right} => Operation(spliced(left), "!==", spliced(right))
      {left} == {right} => Operation(spliced(left), "==", spliced(right))
      {left} != {right} => Operation(spliced(left), "!=", spliced(right))
      {left} <= {right} => Operation(spliced(left), "<=", spliced(right))
      {left} >= {right} => Operation(spliced(left), ">=", spliced(right))
      {left} < {right} => Operation(spliced(left), "<", spliced(right))
      {left} > {right} => Operation(spliced(left), ">", spliced(right))
      {left} + {right} => Operation(spliced(left), "+", spliced(right))
      {left} - {right} => Operation(spliced(left), "-", spliced(right))
      {left} * {right} => Operation(spliced(left), "*", spliced(right))
      {left} / {right} => Operation(spliced(left), "/", spliced(right))
      {left} % {right} => Operation(spliced(left), "%", spliced(right))
      !{operand} => Prefix("!", spliced(operand))
      -{operand} => Prefix("-", spliced(operand))
      new {operand} => Prefix("new ", spliced(operand))
      typeof {operand} => Prefix("typeof ", spliced(operand))
      {function}(...{arguments}) => called(spliced(function), arguments.map(spliced))
      {function}({arguments: *[]}) => called(spliced(function), arguments.map(spliced))
      {object}.{member} => Member(spliced(object), member is Raw ? member.code : member)
      [{elements: *[]}] => elements.map(spliced) -- (.every(. is Literal) ? Literal(.map(.value)) : Listing(.))
      \{{entries: *[]}{`}`} => Record(entries)
      {name: Identifier}: {value} => (name: name, value: spliced(value))
      /{literal pattern}/{flags: Char.Letter[]} => Raw("/" + pattern + "/" + flags)
      null => Literal(None)
      {name: Identifier} => Raw(name)
    }

    Page := class = shape: Geometry.Shape
    Prelude := class
    Devices := class
    Updated := class = shape: Geometry.Shape, dynamic: Geometry.Dynamic
    Mirrored := class = shape: Geometry.Shape
    Typed := class = shape: Geometry.Shape
    Drawing := class = shape: Geometry.Shape
    Popping := class = shape: Geometry.Shape, scene: Geometry.Shape

    expressions := {
      {a} + {b} => @js {a} + {b}
      {a} - {b} => @js {a} - {b}
      {a} * {b} => @js {a} * {b}
      {a} / {b} => @js {a} / {b}
      {a} == {b} => @js {a} === {b}
      {a} < {b} => @js {a} < {b}
      {a} && {b} => @js {a} && {b}
      {a} || {b} => @js {a} || {b}
      {name} = {value} => @js ray.{name} = {value}
      {f}({arguments}) => @js {f}(...{arguments})
    }

    rules := {
      {page: JS.Page} => Module([
        Prelude(),
        Devices(),
        page.shape.expand.map(shape => shape.dynamics.map(Updated(shape, .))),
        UI.Watch.all.map(watch => @js ray.subscribe({watch.watched.program.reads}, () => { {watch.action{O: expressions}()} })),
        UI.Timer.all{!.fired}.map(timer => @js setTimeout(() => { {timer.action{O: expressions}()} }, {(timer.due - Time.now) as ms})),
        page.shape.expand.map(Mirrored(.)),
        page.shape.expand{.focusable}.map(shape => @js document.getElementById({shape.id}).addEventListener("click", (event) => ray.activate({shape.id}))),
        page.shape.expand.map(Typed(.)),
        page.shape.expand.map(Drawing(.)),
        page.shape.expand.map(Popping(., page.shape))
      ])
      {prelude: Prelude} => @js function effect(reads, body) { ray.subscribe(reads, body); body() }
      {devices: Devices} => @js {
        ray.set("UI.Platform.handheld", /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || matchMedia("(pointer:coarse)").matches && !matchMedia("(pointer:fine)").matches || navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent))
        {[("pointerdown", "down"), ("pointermove", "moved"), ("pointerup", "up"), ("pointercancel", "up")].map((name, method) => @js window.addEventListener({name}, (event) => ray.call("UI.Pointer.{method}", ray.pointer(event), event.timeStamp)))}
        window.addEventListener("wheel", (event) => ray.set("UI.Pointer.wheel", event.deltaY))
        {["keydown", "keyup"].map(name => @js window.addEventListener({name}, (event) => ray.key(event)))}
        window.addEventListener("focusin", (event) => ray.set("UI.Focus.current", event.target.id))
        window.addEventListener("resize", (event) => ray.set("UI.Viewport.size", ray.size()))
        window.addEventListener("popstate", (event) => ray.set("UI.Navigation.history", location.pathname))
        window.addEventListener("paste", (event) => ray.set("UI.Clipboard.content", event.clipboardData.getData("text")))
        window.addEventListener("drop", (event) => ray.set("UI.Drag.dropped", event.dataTransfer.files))
        window.addEventListener("compositionupdate", (event) => ray.set("UI.Composition.text", event.data))
        window.addEventListener("deviceorientation", (event) => ray.set("UI.Sensors.orientation", ray.orientation(event)))
        window.addEventListener("gamepadconnected", (event) => ray.poll_gamepads())
        window.matchMedia("(prefers-reduced-motion:reduce)").addEventListener("change", (event) => ray.set("UI.Viewport.preferences.reduced_motion", event.matches))
        effect(["UI.Navigation.history"], () => history.pushState(null, "", ray.get("UI.Navigation.at")))
        effect(["UI.Navigation.title"], () => document.title = ray.get("UI.Navigation.title"))
        window.addEventListener("scroll", (event) => ray.set("UI.Viewport.scrolled", window.scrollY))
        effect(["UI.Viewport.scrolled"], () => {
          const y = ray.get("UI.Viewport.scrolled")
          if (Math.abs(scrollY - y) > 1) scrollTo(0, y)
        })
        effect(["UI.Viewport.revealing"], () => {
          const r = ray.get("UI.Viewport.revealing")
          const e = r && document.getElementById(r.shape.id)
          if (e) {
            if (r.within || !r.offset) e.scrollIntoView(\{block: r.align, behavior: r.smooth ? "smooth" : "auto"})
            else scrollTo(\{top: e.getBoundingClientRect().top + scrollY + r.offset, behavior: r.smooth ? "smooth" : "auto"})
          }
        })
        effect(["UI.Selection.range"], () => {
          const r = ray.get("UI.Selection.range")
          const e = r && (document.getElementById(r.shape.id + "-text") || document.getElementById(r.shape.id))
          if (e) {
            if (e.setSelectionRange) {
              e.focus()
              e.setSelectionRange(r.from, r.to)
            } else {
              const g = document.createRange()
              g.selectNodeContents(e)
              getSelection().removeAllRanges()
              getSelection().addRange(g)
            }
          }
        })
        effect(["UI.Viewport.locking"], () => document.documentElement.classList.toggle("locked", ray.get("UI.Viewport.locking")))
        effect(["UI.Platform.notifications"], () => new Notification(ray.get("UI.Platform.notifications.last.title")))
        effect(["UI.Platform.fullscreen"], () => document.documentElement.requestFullscreen())
        effect(["UI.Platform.printing"], () => window.print())
        effect(["UI.Clipboard.content"], () => navigator.clipboard.writeText(ray.get("UI.Clipboard.content")))
      }
      {updated: Updated{dynamic.target == "class"}} => @js effect({updated.dynamic.reads}, () => document.getElementById({updated.shape.id}).className = {updated.dynamic.compiled{O: expressions}()})
      {updated: Updated} => @js effect({updated.dynamic.reads}, () => { {updated.dynamic.compiled{O: expressions}()} })
      {mirrored: Mirrored{shape is UI.TextArea && shape.language}} => @js document.getElementById("{mirrored.shape.id}-text").addEventListener("input", (event) => document.getElementById("{mirrored.shape.id}-paint").textContent = event.target.value)
      {mirrored: Mirrored} => []
      {typed: Typed{shape is UI.Input}} => @js document.getElementById({typed.shape.id}).addEventListener("input", (event) => ray.set({typed.shape.id}, event.target.value))
      {typed: Typed} => []
      {drawing: Drawing{shape.content is Program}} => @js effect({drawing.shape.content.reads}, () => ray.draw({drawing.shape.id}, {drawing.shape.content.rendered(Language.Direct.level)}))
      {drawing: Drawing} => []
      {popping: Popping{shape is UI.Popover && shape.trigger != always}} => popping.shape.anchor_in(popping.scene).id -- (anchor => [
        ["pointerenter", "focusin"].map(name => @js document.getElementById({anchor}).addEventListener({name}, (event) => document.getElementById({popping.shape.id}).showPopover())),
        ["pointerleave", "focusout"].map(name => @js document.getElementById({anchor}).addEventListener({name}, (event) => document.getElementById({popping.shape.id}).hidePopover()))
      ])
      {popping: Popping{shape.position.kind == anchored && shape.visible}} => @js document.getElementById({popping.shape.id}).showPopover()
      {popping: Popping} => []
    }

    written := JSON.written + {
      {module: Module} => module.statements.map(., ";")
      {binding: Let} => "let ", binding.name, "=", binding.value
      {assign: Assign} => assign.target, "=", assign.value
      {effect: Effect} => "effect(", JSON.Value(effect.reads), ",()=>{", effect.body.map(., ";"), "})"
      {listen: Listen} => listen.target, ".addEventListener(", JSON.Value(listen.event), ",(event)=>{", listen.body.map(., ";"), "})"
      {call: Call} => call.function, "(", call.arguments.map(("," if .index > 0), .), ")"
      {defined: Function} => "function ", defined.name ?? "", "(", defined.parameters.join(","), "){", defined.body.map(., ";"), "}"
      {returned: Return} => "return ", returned.value
      {branch: If} => "if(", branch.condition, "){", branch.then.map(., ";"), "}else{", branch.otherwise.map(., ";"), "}"
      {raw: Raw} => raw.code
      {comment: Comment} => "/*", comment.text, "*/"
      {member: Member} => member.object, ".", member.member
      {operation: Operation} => "(", operation.left, operation.operator, operation.right, ")"
      {choice: Ternary} => "(", choice.condition, "?", choice.then, ":", choice.otherwise, ")"
      {prefixed: Prefix} => "(", prefixed.operator, prefixed.operand, ")"
      {record: Record} => "{", record.entries.map(("," if .index > 0), .name, ":", .value), "}"
      {listing: Listing} => "[", listing.elements.map(("," if .index > 0), .), "]"
      {literal: Literal} => JSON.Value(literal.value)
      {found: ById} => "document.getElementById(", JSON.Value(found.id), ")"
    }
    language = Language.register(Language(".js", level: syntax, writer: (node) => Compiler.reduced(node, written) as String))

    level := UI.Rendering + {
      {solved: Geometry.Solved} => Page(solved.shape)
    } + rules
  }

  Package := class = files: (path: String, content: *)[] {
    write (to: Location) => files.for(IO.write(to / .path, .content))
    document => files{.path == "index.html"}.first?.content
    sheet => files{.path == "style.css"}.first?.content
  }
  packaged := {
    {solved: Geometry.Solved} => Package([
      (path: "index.html", content: HTML.Page(solved.shape)),
      (path: "style.css", content: CSS.Page(solved.shape)),
      (path: "app.js", content: JS.Page(solved.shape)),
      solved.shape.expand{.content is Location && .content.media}.map((path: .content.name, content: .content)),
      [UI.Navigation.icon, UI.Navigation.apple_icon, UI.Navigation.manifest]{!= None}.map((path: .name, content: .))
    ].flatten)
  }
  level := UI.Rendering + packaged + HTML.rules + CSS.rules + JS.rules

  DOM := class {
    send (message) => external io `dom` (message)
    received => external io `dom` None
    line (parts: String[]) => parts.join(" "), \n

    Mount := class = node: HTML.Element | HTML.Text | HTML.Raw | HTML.Comment, parent: String?
    Listening := class = element: HTML.Element
    protocol := {
      {mount: Mount{node is HTML.Element}} => mount.node -- (element => [
        line(["create", element.id, element.tag]),
        element.attributes.map(line(["attribute", element.id, .name, (.value as String).escaped_line])),
        Listening(element),
        element.children.map(Mount(., element.id)),
        line(["append", mount.parent, element.id]) if mount.parent
      ])
      {mount: Mount{node is HTML.Comment}} => []
      {mount: Mount} => line(["text", mount.parent, mount.node.text.escaped_line])
      {listening: Listening{element.tag is ("a" | "button")}} => [line(["listen", listening.element.id, "click"])]
      {listening: Listening{element.tag is ("input" | "select" | "textarea")}} => [line(["listen", listening.element.id, "input"]), line(["listen", listening.element.id, "focus"])]
      {listening: Listening} => []
    }
    mounted (element: HTML.Element) => Compiler.reduced(Mount(element), protocol) as String

    static Event := class = id: String, kind: String, value: String? {
      static parsed (line: String?) => line?.trimmed ~= (id: Char{!= " "}[], " ", kind: Char{!= " "}[], (" ", value: *)?) -- Event(id: .id, kind: .kind, value: .value) if .
      at => value ~= (x: Decimal, " ", y: Decimal, (" ", time: Decimal)?) -- (position: Geometry.Vector(.x * 1px, .y * 1px), time: .time ? .time * 1 ms : Time.now)
      shape => UI.scene?.expand{.id == id}.first
      apply => Compiler.reduced(this, DOM.applied)
    }
    applied := {
      {event: Event{kind == "click"}} => event.shape?.activate
      {event: Event{kind == "input"}} => event.shape?.set(event.value)
      {event: Event{kind == "focus"}} => UI.Focus.current = event.shape
      {event: Event{kind == "scroll"}} => UI.Viewport.scrolled = (event.value as Decimal) * 1px
      {event: Event{kind == "pointerdown"}} => UI.Pointer.down(event.at.position, time: event.at.time)
      {event: Event{kind == "pointermove"}} => UI.Pointer.moved(event.at.position, event.at.time)
      {event: Event{kind is ("pointerup" | "pointercancel")}} => UI.Pointer.up(event.at.position, event.at.time)
      {event: Event{kind == "keydown"}} => event.value.split(" ") -- UI.Keyboard.press(.first, shift: .contains("shift"), control: .contains("control"), alt: .contains("alt"), meta: .contains("meta"))
      {event: Event{kind == "keyup"}} => UI.Keyboard.release(event.value.split(" ").first)
      {event: Event{kind == "size"}} => event.shape && (event.value ~= (width: Decimal, " ", height: Decimal)) -- (event.shape.size = Geometry.Vector(.width * 1px, .height * 1px))
      {event: Event} => None
    }
    event => Event.parsed(received)

    render (page: Program) => write(page.rendered(Language.Web.level))
    start => send(line(["clear"])) -- ["pointerdown", "pointermove", "pointerup", "pointercancel", "keydown", "keyup", "scroll"].for(send(line(["listen", "window", .])))
    stop => None
    write (package: Package) => send(line(["clear"])) -- send(mounted(package.document.body)) -- (send(line(["style", package.sheet as CSS.language])) if package.sheet)
      -- send(line(["lock", UI.Viewport.locking as String]))
      -- UI.Viewport.revealing && send(line(["reveal", UI.Viewport.revealing.shape.id, UI.Viewport.revealing.align as String, UI.Viewport.revealing.smooth as String])) -- (UI.Viewport.revealing = None)
    read => event?.apply
    copy (text: String) => send(line(["clipboard", text.escaped_line]))
    open (to: Location) => send(line(["open", (to as String).escaped_line]))
  }

  Chromium := { }
  Firefox := { }
  Safari := {
    {rule: CSS.Rule{declarations.some(.0 == "backdrop-filter") && !declarations.some(.0 == "-webkit-backdrop-filter")}} => CSS.Rule(rule.selector, [rule.declarations, [("-webkit-backdrop-filter", rule.declarations{.0 == "backdrop-filter"}.first.[1..])]].flatten(1), rule.within)
  }
}
Language.register(Language.Web)
