// The MD5 Message-Digest Algorithm (https://www.rfc-editor.org/rfc/rfc1321)
MD5 := class: Encoding.Digest {
  static extensions = ".md5"

  // Padding: a 1 bit, zeros, and the length in bits as 64 bits, low-order word and byte first (https://www.rfc-editor.org/rfc/rfc1321#section-3.1, https://www.rfc-editor.org/rfc/rfc1321#section-3.2)
  static padded (message: Byte[]) => [message, 0x80, [0] * ((119 - message.count % 64) % 64), <-((message.count * 8 % 2 ^ 64) as Binary⁶⁴ as Byte[])].flatten
  // Words are read low-order byte first (https://www.rfc-editor.org/rfc/rfc1321#section-2)
  static words (bytes: Byte[]) => bytes.chunk(4).map(<-. as Binary as Number)
  // Initial buffer A, B, C, D (https://www.rfc-editor.org/rfc/rfc1321#section-3.3)
  static initial = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476]
  // T[i], the integer part of 4294967296 times abs(sin(i)) (https://www.rfc-editor.org/rfc/rfc1321#section-3.4)
  static T = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
  ]
  // Shift amounts of the four rounds (https://www.rfc-editor.org/rfc/rfc1321#section-3.4)
  static S = [[7, 12, 17, 22], [5, 9, 14, 20], [4, 11, 16, 23], [6, 10, 15, 21]]
  // F, G, H, I, and which word each step takes (https://www.rfc-editor.org/rfc/rfc1321#section-3.4)
  static not (x) => 2 ^ 32 - 1 - x
  static f (i, x, y, z) => i < 16 ? (x ~&& y) ~|| (not(x) ~&& z)
    : i < 32 ? (x ~&& z) ~|| (y ~&& not(z))
    : i < 48 ? x ~x|| y ~x|| z
    : y ~x|| (x ~|| not(z))
  static k (i) => [i, 5 * i + 1, 3 * i + 5, 7 * i][(i / 16).floor] % 16
  static rotl (x, n) => (x * 2 ^ n + (x / 2 ^ (32 - n)).floor) % 2 ^ 32
  // a = b + ((a + F(b, c, d) + X[k] + T[i]) <<< s), the four registers turning each step (https://www.rfc-editor.org/rfc/rfc1321#section-3.4)
  static compressed (h, X: Number[]) => (0..<64).reduce(v = h => [v[3], (v[1] + rotl((v[0] + f(., v[1], v[2], v[3]) + X[k(.)] + T[.]) % 2 ^ 32, S[(. / 16).floor][. % 4])) % 2 ^ 32, v[1], v[2]])
    .zip(h).map((a, b) => (a + b) % 2 ^ 32)

  // The digest is A, B, C, D, low-order byte first (https://www.rfc-editor.org/rfc/rfc1321#section-3.5)
  written := {
    {writing: Language.Writing} => padded(writing.value as Byte[]).chunk(64).map(words(.)).reduce(h = initial => compressed(h, .)).map(<-(. as Binary³² as Byte[])).flatten
  }
}
