Location &+= {
  normalised => segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  sandboxed => "instance/" + normalised
  system: FileSystem => Compiler.reduced(this, FileOptimizations)
  content => system.read(this) as String
  bytes => (system.read(this) ?? []) as Byte[]
  listing => system.listing(this)
  exists => system.exists(this)
  write (content): static => this ~~ system.write(., content)
  remove: static => this ~~ system.removed(.)
  origin => Location(scheme, host, port, path: "")
  .content = {value} ^punctuation => write(value)
}

FileSystem := class: Language {
  read (location: Location) => Program(name: "a reader for the location", goal: location)
  write (location: Location, content) => Program(name: "a writer for the location", goal: location)
  listing (location: Location) => []
  exists (location: Location) => read(location) != None
  removed (location: Location) => write(location, None)

  static Posix := class: FileSystem {
    read (location: Location) => external io location.sandboxed None
    write (location: Location, content) => external io location.sandboxed content
    listing (location: Location) => IO.host(location as String).lines{.nonempty}.map(location / .)
    removed (location: Location) => external os `remove` location.sandboxed
  }
  static Browser := class: FileSystem {
    key (location: Location) => "ray:" + location.normalised
    read (location: Location) => @me/device/storage[key(location)]
    write (location: Location, content) => @me/device/storage[key(location)] = (content as String if content !== None)
    listing (location: Location) => @me/device/storage.keys{~= ⊢(key(location) + "/")}
      .map(.after(key(location) + "/").before("/")).unique.map(location / .)
  }
  static Remote := class: FileSystem {
    remotely (location: Location) => Network.Remote(character: @me, location: location.scheme ? location.origin : @remote)
    inner (location: Location) => (location.scheme ? location.path : location.segments[1..].join("/")) as Location
    over_http (location: Location) => location.scheme ~= ⊢"http"
    sent (method: $.http.Method, location: Location, content = None, fields = $.http.Fields()) => $.http.send($.http.Request(method, target: location, fields, body: content === None ? [] : content as Byte[]))
    read (location: Location) => over_http(location)
      ? sent($.http.Method.get, location) -- (.ok ? .text : None)
      : remotely(location).run({ inner(location).content })
    write (location: Location, content) => over_http(location)
      ? sent(content === None ? $.http.Method.delete : $.http.Method.put, location, content).ok
      : remotely(location).run({ inner(location).write(content) })
    // WebDAV PROPFIND with Depth 1 answers a 207 multistatus naming the collection and its members (https://www.rfc-editor.org/rfc/rfc4918#section-9.1, https://www.rfc-editor.org/rfc/rfc4918#section-10.2)
    listing (location: Location) => over_http(location)
      ? (sent($.http.Method.propfind, location, fields: $.http.Fields().with("Depth", "1")).text ~= (*, "<", (Char.Word[], ":")?, "href>", href: (!"<")[], "</", (Char.Word[], ":")?, "href>")[]).href[1..]
        .map(href => href ~= ⊢"/" ? location.origin + href : href as Location)
      : remotely(location).run({ inner(location).listing })
  }
  static Mirrored := class: FileSystem {
    read (location: Location) => Program(name: "the content at a location of a project not held here, from a mirror (World W2.9) or a shard (World W2.7, Universal U7) of it, kept by a cache level (Language §9.1, §9.2)", goal: location)
  }
}

FileOptimizations := {
  {location: Location{scheme && scheme != "file"}} => FileSystem.Remote()
  {location: Location{segments.first == "remote"}} => FileSystem.Remote()
  {location: Location{OS().name == browser}} => FileSystem.Browser()
  {location: Location{Project.data(.) && !FileSystem.Posix().exists(.)}} => FileSystem.Mirrored()
  {location: Location} => FileSystem.Posix()
}

IO := class {
  read (location) => (location as Location).content
  write (location, content) => (location as Location).write(content)
  output (text: String) => external io `/dev/stdout` text
  host (location) => Run.current.ask(`size`, location) -- (. == true ? (external io location None) as String : .)
  field (name: String) => (name + (".ray" | "/" | ""))#.map(read(.)).first(.nonempty) ?? ""
  listing (location) => (location as Location).listing
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => (external random) ? 1 : 0
  bits (count: Number) => count.times.map(bit)
  number (width: Number) => Binary(integer: bits(width).map(Binary.digit))
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }

  static Seeded := class = state: Number {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    number (width: Number) => Binary(integer: width.times.map(bit).map(Binary.digit))
  }
}

choose {type} ^keyword => @me.choose(type)
choose {n: Number} {type} ^keyword => @me.choose(type, n)
choose? {type} ^keyword => Choice(type)
choose? {type} ?? {placeholder} ^keyword => Choice(type, placeholder)
Choice := class = type: *?, value: *?, placeholder: *?, count: Number = 1, reason: String? {
  static algorithm: *?

  choosing => value === None
  answer => value ?? placeholder
  told (given, weight: Number = 1/2): static => (given ~~ .weight = weight) -- (weighed => this ~~ .value = (value === None ? weighed : value | weighed))
}
Node &+= {
  choosing => false
}

Proof := class = proposition: *, argument: * {
  static Proposition := class = holds: boolean = true, fact: *?, verified = false {
    negated => Proposition(holds: !holds, fact)
    quest => Program(name: "verify the assumption", goal: fact)
    verify (actual) => verified = actual == fact
    rolled_back => !verified
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : Program(name: "prove", goal: proposition)
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
  static failed (error) => Program(name: "fix", goal: error)
}

! `+` `-`
! `*` `/`

Network := class {
  static fetch (from: Location, path: String, version: Version?) => (IO.read(from / path + (version as String)) if version) ?? IO.read(from / path)
}

OS := class {
  [property: String] => (external os property) as String
  platform => this["platform"]
  architecture => this["architecture"]
  zoneinfo: Location? => name is (linux | macos) ? (this["TZDIR"] ?? "/usr/share/zoneinfo") as Location : None

  static devices := {
    {os: OS{platform}} => os
    {os: OS} => ("@ether/OS" as Project.Dependency).project -- OS.Ether()
  }
  name: linux | macos | windows | browser | ether | unknown => platform ? { "linux": linux, "darwin": macos, "win32": windows, "browser": browser, "ether": ether }[platform] ?? unknown : ether

  static launch (location: Location) => external os `open` (location as String)

  env => Environment(os: this)
  static Environment := class = os: OS {
    .{literal name ^property} ^punctuation => os[name]
  }
}
