// BLAKE3 (https://github.com/BLAKE3-team/BLAKE3-specs/blob/master/blake3.pdf)
BLAKE3 := class: Encoding.Digest {
  static extensions = ".blake3"

  // IV, the same as SHA-256's (BLAKE3 §2.2)
  static IV = [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19]
  // Domain flags (BLAKE3 §2.1, Table 3)
  static chunk_start = 1
  static chunk_end = 2
  static parent = 4
  static root = 8
  // Message word permutation (BLAKE3 §2.2, Table 2)
  static permutation = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]

  static rotr (x, n) => ((x / 2 ^ n).floor + x * 2 ^ (32 - n)) % 2 ^ 32
  // G, the quarter-round (BLAKE3 §2.2)
  static G (v, (a, b, c, d), x, y) =>
    (v[a] + v[b] + x) % 2 ^ 32 -- (a1 => rotr(v[d] ~x|| a1, 16) -- (d1 => (v[c] + d1) % 2 ^ 32 -- (c1 => rotr(v[b] ~x|| c1, 12) -- (b1 =>
    (a1 + b1 + y) % 2 ^ 32 -- (a2 => rotr(d1 ~x|| a2, 8) -- (d2 => (c1 + d2) % 2 ^ 32 -- (c2 =>
    v ~~ (.[a] = a2) ~~ (.[b] = rotr(b1 ~x|| c2, 7)) ~~ (.[c] = c2) ~~ (.[d] = d2))))))))
  // A round: the columns, then the diagonals (BLAKE3 §2.2)
  static quarters = [(0, 4, 8, 12), (1, 5, 9, 13), (2, 6, 10, 14), (3, 7, 11, 15), (0, 5, 10, 15), (1, 6, 11, 12), (2, 7, 8, 13), (3, 4, 9, 14)]
  static round (v, m) => quarters.enumerate.reduce(s = v => G(s, .value, m[2 * .index], m[2 * .index + 1]))
  // The compression function: seven rounds, permuting the message between them (BLAKE3 §2.2)
  static compressed (cv, block: Byte[], counter, flags) =>
    (0..<7).reduce(held = (v: [cv, IV[..<4], counter % 2 ^ 32, (counter / 2 ^ 32).floor, block.count, flags].flatten, m: words(block)) =>
      (v: round(held.v, held.m), m: permutation.map(held.m[.]))).v -- (v => [(0..<8).map(v[.] ~x|| v[. + 8]), (0..<8).map(v[. + 8] ~x|| cv[.])].flatten)
  // Words are little-endian; a short block is padded with zeros (BLAKE3 §2.1)
  static words (block: Byte[]) => [block, [0] * (64 - block.count)].flatten.chunk(4).map(<-. as Binary as Number)

  // A chunk of at most 1024 bytes: its 64-byte blocks chained from the key (BLAKE3 §2.4)
  static chunk (bytes: Byte[], counter, last_flags) => (bytes.chunk(64) -- (.empty ? [[]] : .)) -- (blocks =>
    blocks.enumerate.reduce(cv = IV => compressed(cv, .value, counter,
      (.index == 0 ? chunk_start : 0) + (.index == blocks.count - 1 ? chunk_end + last_flags : 0))[..<8]))
  // The tree: a left subtree of the largest power of two chunks less than all of them (BLAKE3 §2.5)
  static node (chunks: Byte[][], offset, flags) => chunks.count == 1 ? chunk(chunks.first, offset, flags)
    : 2 ^ ((chunks.count - 1).digits(2).count - 1) -- (left =>
      compressed(IV, [node(chunks[..<left], offset, 0), node(chunks[left..], offset + left, 0)].map(.map(. as Binary³² as Byte[]).map(<-.)).flatten, 0, parent + flags)[..<8])

  // The root is compressed with ROOT; its first 32 bytes are the hash (BLAKE3 §2.6)
  written := {
    {writing: Language.Writing} => ((writing.value as Byte[]).chunk(1024) -- (.empty ? [[]] : .)) -- (chunks => node(chunks, 0, root)).map(<-(. as Binary³² as Byte[])).flatten
  }
}
