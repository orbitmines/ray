  static grouped (gs) => (gs.count == 1) ? High.expression(gs.first) : High.in_turn(gs)
  static in_turn (it) => {
    High.w("last(")
    High.listed_all(it)
    High.w(")")
  }
  static listed_all (la) => {
    la.for((part) => High.w("append("))
    High.w("list()")
    la.for((part) => High.appended_statement(part))
  }
  static appended_statement (as) => {
    High.w(", ")
    High.expression(as)
    High.closing(0)
  }
  static read_as (rv, rt) => {
    High.w("readtext(astype(")
    High.expression(rt)
    High.w(", scope), ")
    High.expression(rv)
    High.w(")")
  }
  static with_code (wa) => {
    High.w("with_code(")
    High.expression(wa)
    High.w(", 0)")
  }
  static name (nm) => {
    High.w("get(scope, ")
    High.symbol(nm)
    High.w(")")
  }
  static shape (sh, sk) => (sk == `level_request`) ? High.level_requested(sh.level_request) : ((sk == `list_code`) ? High.listed(High.parts(sh.list_code)) : ((sk == `static_of`) ? High.expression(sh.static_of) : ((sk == `ext_of`) ? High.extended_by(sh.ext_of, sh.ext_with) : ((sk == `member_of`) ? High.grammar_of(sh.member_of, sh.member_code) : High.shape_ops(sh, sk)))))
  static shape_ops (sh, sk) => (sk == `sub_left`) ? High.folded(() => High.expression(sh.sub_left), "minus", sh.sub_right) : ((sk == `mul_left`) ? High.folded(() => High.expression(sh.mul_left), "times", sh.mul_right) : ((sk == `div_left`) ? High.folded(() => High.expression(sh.div_left), "quotient", sh.div_right) : ((sk == `rem_left`) ? High.folded(() => High.expression(sh.rem_left), "remainder", sh.rem_right) : ((sk == `add_left`) ? High.folded(() => High.expression(sh.add_left), "plus", sh.add_right) : ((sk == `shl_left`) ? High.call2("shifted_left", sh.shl_left, sh.shl_right) : ((sk == `shr_left`) ? High.call2("shifted_right", sh.shr_left, sh.shr_right) : High.shape_compared(sh, sk)))))))
}
High &+= {
