Location &+= {
  normalised => segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  origin => Location(scheme, host, port, path: "")
}
assert {
  kept := Location(path: "kept")
  kept["ray:a/b"] = "x"
  // IO8 what is written to the device's storage is not read back
  assert kept["ray:a/b"] == "x"
  // IO9 the device's storage does not list the key written to it
  assert kept.fields.name == ["ray:a/b"]
  kept["ray:a/b"] = None
  // IO10 a key removed from the device's storage is still listed
  assert !(kept.fields{.value !== None}.nonempty)
}
// IO11 the device has no storage location
assert @me/device/storage is Location

// What holds the locations of a space: `holder[location]` is what is held there, `holder[location] = value` writes it.
// This one holds nothing: what a project holds it adds (@ether/filesystem the file space, @ether/network the URLs).
FileSystem := class: Language {
  [location: Location] => ERROR@FileSystem `nothing loaded holds the location (a file needs @ether/filesystem, a URL @ether/network)`
  { }[{location: Location}] = {value} ^punctuation => ERROR@FileSystem `nothing loaded holds the location to write it`
  ({location: Location}, {args}) => ERROR@FileSystem `nothing loaded holds the location to execute it`
}
// IO12 an http location is not reached over the network
assert ("https://example.org/a" as Held).holder is FileSystem.Remote

// What holds a location: the projects add theirs (@ether/filesystem the file space, @ether/network the URLs).
FileOptimizations := { }

IO := class {
  output (text: String) => @me/instance = text
  fetch (from: Location, path: String, version: Version?) => ((from / path + (version as String)).held as String if version) ?? (from / path).held as String
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => OS.Ether ? ERROR@OS `a source of random bits is not written in Ray yet` : @random ? 1 : 0
  bits (count: Number) => count.times.map(bit)
  // FE2 three bits are not three
  assert Random.bits(3).count == 3
  // RN2 four drawn bits are not four
  assert Random.bits(4).count == 4
  // Reading a location answers what is written there and leaves it as it was:
  // the file the library is declared in is read twice.
  assert {
    read_once := @ether/.project.ray as String
    read_twice := @ether/.project.ray as String
    // IO5 a read answers nothing
    assert read_once.nonempty
    // IO6 reading a file changed it
    assert read_once == read_twice
    // spec: writing a location is not claimed here — a test that writes a file
    // leaves one behind.
    // A location computed as a string reaches the machine as the bits it is
    // written with.
    read_by_bits := ("@ether/.project.ray".bits as Location).held as String
    // IO7 a location given as a string's bits is read as another place
    assert read_by_bits == read_once
  }
  number (width: Number) => Binary(integer: bits(width).map(Binary.digit))
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }
  // RN4 a number below five is not below five
  assert Random.below(5) < 5

  static Seeded := class (state: Number) => {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    // FE1 a bit from the machine is nothing
    assert Random.bit
    // The machine's own bit. It is handed over as presence, not as a written
    // digit, so it can be read at all; before that every bit was zero and every
    // uuid was the same one.
    // RN1 a drawn bit is neither one nor zero
    assert Random.bit == 1 || Random.bit == 0
    // Twenty draws are not all the same. They could be — about twice in a
    // million — but every bit being the same is what a machine that hands over
    // nothing readable looks like, which is what this is here to catch.
    assert {
      draws := 20.times.map(Random.bit)
      ones := draws{== 1}.count
      zeros := draws{== 0}.count
      // RN5 twenty draws are not twenty
      assert ones + zeros == 20
      // RN6 twenty draws were all nothing
      assert !(ones == 0)
      // RN7 twenty draws were all something
      assert !(zeros == 0)
    }
    number (width: Number) => Binary(integer: width.times.map(bit).map(Binary.digit))
    // RN3 three bits spell eight or more
    assert Random.number(3) < 8
  }
}

choose {type} ^keyword => Program(who: @me, name: "choose", goal: type)
// CN3 what is chosen from a type is not of it
assert choose boolean is boolean
// CN4 choosing three booleans does not choose three
assert (choose 3 boolean).count == 3
// CN6 a narrowing by a choice of five is not five
assert Number{choose 5}.count == 5
// CN7 a filtered map changes other than the one it chose
assert [1, 2, 3].map{choose 1}(*10).zip([1, 2, 3]).filter((a, b) => a != b).count == 1
// CQ4 choose 2 does not choose two
assert (choose 2 ("A" | "B" | "C")).count == 2
// The default of a choose is its placeholder; `choosing` while it is open.
assert {
  cq_open := choose? Number ?? 5
  // CQ5 an unanswered choice is not being chosen
  assert cq_open.choosing
  // CQ6 the default of a choose is not its placeholder
  assert cq_open.placeholder == 5
  // CQ7 an unanswered choice does not answer its placeholder
  assert cq_open.answer == 5
  cq_open.value = 7
  // CQ8 an answered choice is still being chosen
  assert !(cq_open.choosing)
  // CQ9 an answered choice answers its placeholder
  assert cq_open.answer == 7
  // CQ10 a plain value is being chosen
  assert !(5.choosing)
}
assert {
  chs := choose? Number ?? 5
  chs.told(3)
  // CHS2 a player's answer is taken as a certainty
  assert chs.value.weight == 1/2
  chs.told(4)
  // CHS3 a second answer replaced the first instead of joining it
  assert chs.value#.count == 2
}
choose {n: Number} {type} ^keyword => Program(who: @me, name: "choose", goal: n type)
choose? {type} ^keyword => Program(who: @me, name: "choose", goal: type?)
choose? {type} ?? {placeholder} ^keyword => Program(who: @me, name: "choose", goal: type?, tried: placeholder)
Choice := Program{name == "choose"}

Proof := class (proposition: *, argument: *) => {
  static Proposition := class: Program {
    holds => this() as boolean
    // A proposition holds or it does not, and what says so is a proof.
    assert {
      yes := Proof.Proposition(code: { true })
      no := Proof.Proposition(code: { false })
      // PF1 a proposition written as holding does not hold
      assert yes.holds
      // PF2 a proposition written as not holding holds
      assert !(no.holds)
      // PF3 the negation of one that holds holds
      assert !(yes.negated.holds)
      // PF4 the negation of one that does not hold does not hold
      assert no.negated.holds
      // PF5 a proposition is not proof of itself
      assert Proof.rfl(yes)
      // PF6 one that does not hold proves itself
      assert !(Proof.rfl(no))
      // PF7 what is assumed is not what was assumed
      assert (assume { yes }).holds
      // PF8 a proof of the negation failing does not prove it
      assert Proof.by_contradiction(yes, no)
      // PF9 a proof of the negation holding proves it anyway
      assert !(Proof.by_contradiction(no, yes))
      // PF10 a proof holds only if its argument does
      assert Proof(proposition: yes, argument: yes).holds
      // What is proved is true; what is not is what there is to do.
      // PF11 a theorem with a proof that holds is not true
      assert Proof.theorem(yes, yes)
      // PF12 a theorem without a proof does not err
      assert Proof.theorem(yes, no).erred
      // PF13 a proven theorem does not hold
      assert Proof.theorem(yes, yes) == true
    }
    negated => Proposition(code: { !holds })
    verify (actual) => attempt(actual)
    rolled_back => solution === None
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : ERROR@Proof `the proposition is not proven`
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
  // FE7 what holds is not proved by itself
  assert Proof.rfl(Proof.Proposition(code: { true }))
  // FE8 what does not hold is proved by itself
  assert !(Proof.rfl(Proof.Proposition(code: { false })))
}

! `+` `-`
! `*` `/`
// FE10 the inverse of minus is not plus
assert `-`⁻¹ as String == "+"
// FE9b the inverse of plus is not minus
assert `+`⁻¹ as String == "-"

// FE9a the inverses have no plus
assert `+`.reversible

// FE9 the inverses have no minus
assert `-`.reversible

// What the machine says about itself.
// IO1 the machine does not say what it is
assert @me/device/os/platform

// IO14 listing a remote collection is not safe
assert $.http.Method.propfind.safe


