Location &+= {
  normalised => segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  sandboxed => "instance/" + normalised
  system: FileSystem => Compiler.reduced(this, FileOptimizations)
  content => system.read(this) as String
  bytes => (system.read(this) ?? []) as Byte[]
  listing => system.listing(this)
  exists => system.exists(this)
  write (content): static => this ~~ system.write(., content)
  remove: static => this ~~ system.removed(.)
  origin => Location(scheme, host, port, path: "")
  .content = {value} ^punctuation => write(value)
}

FileSystem := class: Language {
  read (location: Location) => ERROR@FileSystem `no reader for the location`
  write (location: Location, content) => ERROR@FileSystem `no writer for the location`
  listing (location: Location) => []
  exists (location: Location) => read(location) != None
  removed (location: Location) => write(location, None)
}

FileOptimizations := {
  {location: Location} => @me/device/os
}

IO := class {
  output (text: String) => @me/device/os.sent("stdout", text)
  fetch (from: Location, path: String, version: Version?) => ((from / path + (version as String)).content if version) ?? (from / path).content
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => @me/device/os.bit
  bits (count: Number) => count.times.map(bit)
  number (width: Number) => Binary(integer: bits(width).map(Binary.digit))
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }

  static Seeded := class = state: Number {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    number (width: Number) => Binary(integer: width.times.map(bit).map(Binary.digit))
  }
}

choose {type} ^keyword => Program(who: @me, name: "choose", goal: type)
choose {n: Number} {type} ^keyword => Program(who: @me, name: "choose", goal: n type)
choose? {type} ^keyword => Program(who: @me, name: "choose", goal: type?)
choose? {type} ?? {placeholder} ^keyword => Program(who: @me, name: "choose", goal: type?, tried: placeholder)
Choice := Program{name == "choose"}

Proof := class = proposition: *, argument: * {
  static Proposition := class: Program {
    holds => this() as boolean
    negated => Proposition(code: { !holds })
    verify (actual) => attempt(actual)
    rolled_back => solution === None
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : Program(name: "prove", goal: proposition)
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
  static failed (error) => Program(name: "fix", goal: error)
}

! `+` `-`
! `*` `/`

OS := class: FileSystem {
  [property: String] => ERROR@OS `the operating system has no properties`
  platform => this["platform"]
  architecture => this["architecture"]
  env => Environment(os: this)
  static Environment := class = os: OS {
    .{literal name ^property} ^punctuation => os[name]
  }

  running => ERROR@OS `the operating system does not say whether the host runs it`
  static current: OS? => OS#.map(.()){running}.first

  sent (stream: String, content) => ERROR@OS `the operating system has no streams`
  received (stream: String) => ERROR@OS `the operating system has no streams`
  launch (location: Location) => ERROR@OS `the operating system opens no locations`
  bit => ERROR@OS `the operating system has no source of random bits`
  now: Time => ERROR@OS `the operating system has no clock`
  time_zones: TimeZone.Source => ERROR@OS `the operating system has no time-zone data`
  fonts: Location[] => ERROR@OS `the operating system has no fonts`
}
