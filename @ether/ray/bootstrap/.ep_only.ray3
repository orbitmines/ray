assert {
  kept_under := { }
  kept_under[5] = 3
  kept_under[6] = 4
  assert kept_under[5] == 3  // MP1 a value held under a key is not what was given
  assert kept_under.keyed.count == 2  // MP2 two keys hold other than two entries
}
assert {
  held := 0
  unless true { held += 1 }
  unless 1 == 1 { held += 1 }
  unless mark { held += 1 }
  assert held == 0  // HO2 unless takes the block when the condition holds
}
assert {
  {left} - {right} => (
    held := 2
    held + 1
  )
  assert 10 - 3 == 3  // RW1 a body that declares a name is not run
  assert 1 - 1 == 3  // RW2 it answers the same wherever it stands
}

// An enumeration: `enum A | B | C`, a node its names are read in: each a member, a place there (a name a node being made is
// given, it has), and `members` what they compose.
enum {names} ^keyword => {
  external .
  // (a member written with fields, `circle (radius: Number)`: one holding them)
  {member: Name} ({fields}) => {member} := ({ {fields} })
  members := (.({names}))#
  // (one after another, as written: each member a Ray of them)
  {
    at := (members).head
    while at {
      (at.value).previous := at.previous ? at.previous.value : None
      (at.value).next := at.next ? at.next.value : None
      at = at.next
    }
  }
  .
}
// (written with a block: each member reads it too, `ranked => rank` its own)
enum {names} {`{`}{block}{`}`} ^keyword => (enum {names}) ~~ (.members.for((member) => member &+= { {block} }))
assert {
  Shape := enum circle (radius: Number) | square (side: Number) | point
  assert Shape.circle.radius  // EM8 a member does not carry its field
  assert Shape.square.side  // EM9 the second member does not carry its field
  assert !(Shape.point.radius)  // EM10 a member carries another's field
  assert Shape.point  // EM11 a member without fields is not there
  assert Shape.circle is Shape  // EM16 a member is not one of its own enum
}
assert {
  Modifier := enum static | readonly | this
  assert Modifier.this  // EM12 a member named this is not there
}
assert {
  Level := enum low (rank: Number) | high (rank: Number) {
    ranked => rank
  }
  assert Level.low.ranked  // EM17 a block over lines lost what it declares
  assert Level.high.ranked  // EM18 the last member gained nothing from the block
  assert Level#.count == 2  // EM20 an enum of two written with a block has other than two members
  assert !(Level.low == Level.high)  // EM21 two members written with a block are the same
}

// `dynamically`: given again (run again) whenever what it reads is written from where it is read (the caller) or anything run
// from there: `dynamically x := v` (x is v again), `dynamically code` (the code runs again).
dynamically {code} ^keyword => {
  (external &).caller dynamic {
    {code}
  }
  {code}
}
dynamically {name} := {value} ^keyword => {
  {name} := {value}
  (external &).caller dynamic {
    {name} = {value}
  }
}
// (`dynamically assert c`: no test; what holds of the data, checked where there is some: an instance)
dynamically assert {condition} ^keyword => ensure {condition} if of
dynamics := None
{program} dynamic {code} => {
  program.dynamics := program.dynamics ?? {
    updating := false
    refreshing := []
    refresh (written) => {
      unless .updating {
        .updating := true
        .refreshing.for((one) => one.again())
        .updating := false
      }
    }
  }
  program &+= {
    {written} = {given} => {
      {written} := given
      dynamics.refresh(`{written}`)
