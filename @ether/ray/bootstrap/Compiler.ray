    turn_begun()
    q := textend
    se := Turns.closed_or(pos, statement_end(pos, white_after(at)), at)
    ob := word_of(3912)
    textend = se
    word_put(3984, free) if ob == 0
    word_put(3912, free)
    isolated_open()
    r := matched(item, at, cell(pattern(statement_ending, at, 1), 0))
    textend = q
