({{parameter}}) taking from {vertex} =>
  ({parameter}) gets {vertex}.value
nearest ({{parameter}}, {{parameters}}) taking from {vertex} =>
  (goto took) if (({parameter}) gets {vertex}.value) === true
  (({parameters}) taking from {vertex})
  goto done
  took\
  (({parameters}) taking from {vertex}.next)
  done\
