  static names (x, na, ne) => (x is Node) && Splices.key_is(member(x, Symbol.key), member(x, Symbol.value), na, ne)
  static key_is (k: Text, v: Text, na, ne) => (k is Text) && (v is Text) && ((k.to - k.from) == (ne - na)) && texteq(k.from, na, ne - na)
  static named_value (x, l, i, oa, ce) => Splices.aliased_or(Splices.alias_in(Splices.trimmed_of(member(x, Symbol.value)), l, i, oa, Splices.opening_end_at(oa, ce), ce), x)
  static alias_in (u: Text, l, i, oa, oe, ce) => ((at_text(u.from, u.to, oa, oe) != 0) && (at_text(u.to - (ce - (oe + 1)), u.to, oe + 1, ce) != 0)) ? Splices.take_named_from(u.from + (oe - oa), u.to - (ce - (oe + 1)), l, i + 1, oa, ce) : None
  static aliased_or (r, x) => (r != None) ? r : Splices.first_taken(x)
