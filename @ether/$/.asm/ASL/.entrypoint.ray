// What an encoding does: the goto program its pseudocode is translated into,
// the first time it is asked for.
Translated ^keyword := class {
  operation: Node
  encoding: Node
  program: Node
  translated => (
    held := .program
    unless (exists held) {
      held = asl.translate(.encoding, .operation)
      this.program = held
    }
    held
  )
  run (state) => (
    running := .translated
    running.run(state)
