// JS fragments read as Ray programs, and the JS language writing them.

mark ^keyword := global

who := "Ray"
js_listen := @js document.getElementById({who}).addEventListener("click", (event) => ray.activate({who}))
unless js_listen is Program && (js_listen as JS) == "document.getElementById(\"Ray\").addEventListener(\"click\",(event)=>(ray.activate(\"Ray\")))" { INFO@mark `JSW1 a js listener fragment is not the Ray program that writes it` }
unless (js_listen as JS) ~= ⊢"document.getElementById(\"Ray\")" { INFO@mark `JSW2 a js fragment does not find an element by a held id` }
unless ((@js f({who})) as JS) == "f(\"Ray\")" { INFO@mark `UI208 a string hole in js is not a string literal` }
unless ((@js ray.set("a", 1 + 2 * 3)) as JS) == "ray.set(\"a\",(1+(2*3)))" { INFO@mark `UI209 js operators do not keep their precedence` }
unless ((@js effect(["a"], () => { f() })) as JS) == "effect([\"a\"],()=>{f();})" { INFO@mark `JSW3 a lambda with a block is not written as an arrow function with its statements` }
unless [@js f(), 4].count == 2 { INFO@mark `UI211 a js fragment does not stop where its grammar stops` }
js_block := @js {
  f()
  g({who})
}
unless js_block.count == 2 && (js_block.last as JS) == "g(\"Ray\")" { INFO@mark `UI219 a js block is not its statements` }
unless ((@js {who} + 1) as JS) == "(\"Ray\"+1)" { INFO@mark `UI220 a hole right after @js is read as a block` }
js_commented := @js {
  // note
  f()
}
unless (js_commented as JS) == "/* note*/;f();" { INFO@mark `UI238 a js comment is not written into the js` }
anonymous := @js function (a) { return a }
unless (JS.read(anonymous as JS) as JS) == (anonymous as JS) { INFO@mark `UI292 a written anonymous function does not read back` }
// Ray's == is written as JS's strict equality (https://tc39.es/ecma262/#sec-isstrictlyequal)
unless ((@js a == {who}) as JS) == "(a===\"Ray\")" { INFO@mark `JSW4 Ray's equality is not written as ===` }
