    | atomic_rmw_cmpxchg (code: (0xFE, 72), takes: MemArg) | atomic_rmw8_cmpxchg_u (code: (0xFE, 74), takes: MemArg{align = 0})
    | atomic_rmw16_cmpxchg_u (code: (0xFE, 75), takes: MemArg{align = 1})
