
// Expression: a language read from its own text. Its first line says how a rule is written: `!language`, the brackets a
// hole is written in (`{ }`), then the rule that makes rules, written with them (`{LHS} => {RHS}`). Every statement after it
// is read in a node by the longest of that node's rules that reads it; the rule that makes rules adds one there, its head
// read the same way, its body read when it is applied, in a node of its own whose caller is what applied it. Only four
// things are given: `external .` (a node), `external &` (what applies), `external goto` and `external label` (where control
// goes). Read under a level, `Program{O: …}`, what it reads is a Program (statements as vertices, gotos as edges), and a
// back end is one more level: `Wasm` writes that Program as WebAssembly.
Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    // (a hole's brackets, a space where its name goes)
    CAPTURE: (String+, \s, String+),
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}(`LHS`) | RHS: CAPTURE.map{== \s}(`RHS`) | String)[],
    \n\n
  ),
  (
    // (the rule that makes rules: any space in it any amount of space, each hole anything, its left side a head of the same
    // shape again, `[LHS: [LHS, RHS], RHS]`; the first statement)
    Code := (BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Code) | String)[]
    Head := (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (inside: Code)) | String)[]
    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES.map{is \s}((space) => \s[])
    GRAMMAR_RULE_DEF.RHS = Code
    GRAMMAR_RULE_DEF.LHS = Code
    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF
    
    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,
    statements: (
      // A node: its rules by their heads; what it does not read, what it is in reads.
      Node := class (in?: Node) => {
        // (itself, as its rules' bodies name it: `this` there is what a statement calls them on)
        node := this
        rules := {
          [rule: GRAMMAR_RULE.LHS] := (caller) => {
            // (as the holes that wrote it took it, defined where they are used; each hole shown as its head says, `{x ^style}`)
            taken := takes(caller)
            rule_lhs := level spliced (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)
            rule_rhs := inside_of(level spliced (rule.RHS) (BOOTSTRAPPER.CAPTURE) (taken))
            rule_home := home_of(caller, level spliced_entry (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)) ?? (caller.in ?? node)
            sink = Array.new
            head := (rule_lhs as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => named_in(Program(in: node), hole.inside))
            rule_styled := sink.map((sp) => [level place_name (sp.rest.first), sp.first])
            // (its body read once, in a node of its own, run in a node in that one each time it is applied)
            rule_body := Node(in: node)
            rule_read := Array.new
            rule_style := Array.new
            rule_home.rules[[head]] := (caller) => {
              me := applied
              me.bound = holes
              me.caller = caller
              me.in = Node(in: rule_body)
              me.bound.for((hole) => me.in.rules[[hole.key | BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => held(hole, () => named_in(reader(c, caller), hole.value)))
              me.this = caller.this
              me.bound.for((hole) => rule_styled{.first == hole.key}#.for((sh) => painted.append([sh.last, hole.value, [[hole]]])))
              rule_style.append(painted{.rest.first === rule_own}#) if rule_style.empty
              rule_style.first.for((rs) => painted.append([rs.first, [rule_lhs, me.input], [me.bound]]))
              rule_read.append(body_of(me.bound, rule_body, rule_rhs, rule_own)) if rule_read.empty
              r := rule_read.first
              leaving(me, r(me))
            }
            rule_own := rule_home.rules.keys.last
            // (the pairs its head writes, `({x})`, known to what is read after it; one holding `=>`, a rule that defines)
            level paired (rule_lhs) (BOOTSTRAPPER.CAPTURE)
            definers.append(rule_own) if ((level holds_text (rule_lhs) (separator)) === true)
            rule_own
          }
          [{value: concurrently node.prefix(.)}: node.keys, rest: String] := (caller) => {
            v := value(caller)
            on := Node(in: caller.in)
            members(v).for((m) => on.rules[[m.key]] := (c) => m.value)
            ((v.rules === None) ? Array.new : v.rules.keys).for((k) => on.rules[[k]] := v.rules[[k]])
            r := (rs: Statements(on) = rest)
            me := Program(caller: caller, in: on, this: v)
            leaving(me, r(me))
          }
        }
        // (a name read inside its own reading is its place)
        named_as (text, by) => (naming{(.first == text) && (.last === node)}#.count > 0) ? Place(text, node) : named_now(text, by)
        named_now (text, by) => {
          naming = [[text, node]].joined(naming)
          v := (vs: Statements(node) = text)
          r := (v === None) ? Place(text, node) : v(by)
          naming = naming.rest
          r
        }
        split_key := rules.keys.last
        maker_key := rules.keys.first
        // (a definition, `=>` outside pairs: the latest rule that defines, else the rule that makes rules; none set aside)
        whole (tx) => made(tx, defines(tx)) ?? in?.whole(tx)
        made (tx, d) => (((rules.keys.first === maker_key) && d) && (tx ~= maker_key)) ? (defining(tx) ?? maker_key) : longest(tx, d)
        prefix (tx) => longest(tx, defines(tx)) ?? in?.prefix(tx)
        defining (tx) => rules.keys{!(among(aside, .)) && ((tx ~= .) && among(definers, .))}#.sort(.length).last
        longest (tx, d) => rules.keys{!((. === split_key) || among(aside, .)) && ((tx ~= .) && (d || !((. === maker_key) || among(definers, .))))}#.sort(.length).last
        // (and the split, `x.f`, when it reads more)
        reading (tx) => longer(tx, whole(tx))
        longer (tx, w) => ((w === maker_key) || !(tx ~= split_key)) ? w : (((w === None) || (split_key.length > w.length)) ? split_key : w)
        keys => (in === None) ? rules.keys : (rules.keys | in.keys)
      }
      // A program running: what applied it, where it is.
      Program := class (caller?: Program, at?: Statement, in?: Node, this?: Node) => { }
      Argument := class (\s+, word: String) => { }
      global := Node({
        rules[`external`, \s+, rule: String, args: Argument[]] := (caller) => {
          `.` => (caller.this = (caller.in = Node(in: caller.in)))
          `&` => caller
          `goto` (to) => (caller.at = to.first) if (to.rest.empty || to.rest.first)
          `label` (to) => to.first
          `style` (how) => painted_with(how, caller)
          `shown` (how) => how.first
        }[rule](args.map((argument) => given(caller, rule, argument, args.first)))
      })
      // Statements: each, after any space, read by the longest rule that reads it (all at once, where they can be); run in
      // order, each given what applies them.
      Statement := class (
        leading_whitespace?: (\s | \n)[]+,
        {statement: concurrently context.reading(.)}: context.keys
      ) => {}
      // (the statements as read kept on the node they are read in, `statements`: what each read, its rule and what that took)
      Statements (context: Node) => dynamically Statement[] & (caller: Program) => (
        context.statements = .
        run(caller, listed(.), listed(.), None)
      )
      listed (lr) => lr.map((s) => s.statement)
      // (in turn: after a jump, `external goto`, on after its label; none here, on in what applied them; `afterwards`, later)
      run (p, all, ss, v) => ((ss === None) || ss.empty) ? v : ran(p, all, ss.rest, answered(ss.first, v, ss.first(p)))
      // (a label or a jump answers nothing: the body answers what was answered before it)
      answered (as, av, an) => ((as.rule == `label`) || (as.rule == `goto`)) ? av : an
      ran (p, all, ss, v) => run(p, all, (p.at === None) ? ss : jumped(p, labelled(p, all), [all, ss, p]), v)
      labelled (p, ls) => ls.empty ? None : (((ls.first.rule == `label`) && (label_of(p, ls.first.args.first.word) == p.at)) ? ls.rest : labelled(p, ls.rest))
      jumped (p, to, k) => {
        later.append(k) if (to === None) && (p.at == afterwards)
        forget(p) if !(to === None)
        (p.at = None) if !(to === None) || (p.at == afterwards)
        to ?? Array.new
      }
      leaving (me, v) => {
        (me.caller.at = me.at) if !(me.at === None)
        v
      }
      // (what the host is given, `external <rule> <arguments…>`: each argument read where it is written, but a label (a jump's
      // first, a label's), its word, or, written in the brackets holes are written in, what that reads as)
      given (gc, gr, ga, gf) => (((gr == `goto`) || (gr == `label`)) && (ga === gf)) ? label_of(gc, ga.word) : named_in(gc, ga.word)
      label_of (lp, lw) => (lw ~= BOOTSTRAPPER.CAPTURE.map{== \s}(String+)) ? named_in(lp, lw) : Place(lw, global)
      later := Array.new
      afterwards := Place(`afterwards`, global)
      run_later (rl) => later.empty ? None : ran_later(later.first)
      ran_later (lf) => {
        later = later.rest
        run(lf.last, lf.first, lf.rest.first, None)
        run_later(0)
      }
      naming := Array.new
      // (what a name is read as: without the space around it, unless it is only space)
      trimmed_or (tt, to) => (tt.length == 0) ? to : tt
      // (a body read with its rule set aside, a rule never reading itself; a hole, what the nearest program that took it took)
      body_of (took, body, code, own) => {
        took.for((hole) => body.rules[[hole.key | BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => hole_in(c, c, hole.key))
        aside = [own].joined(aside)
        r := (rhs: Statements(body) = code)
        aside = aside.rest
        r
      }
      hole_in (hc, hr, hk) => (hc === None) ? None : hole_from(hc, hr, hk, (hc.bound ?? Array.new){.key === hk}#.first)
      hole_from (hf, hr, hk, he) => (he === None) ? hole_in(hf.caller, hr, hk) : named_in(reader(hr, hf.caller), he.value)
      // (a hole's value, read once in what applied it; a jump back in a body forgets what its holes answered, a loop asks again)
      held (hh, hf) => ((hh.answered === None) ? (hh.answered = [hf()]) : hh.answered).first
      forget (fp) => (fp.bound ?? Array.new).for((fh) => fh.answered = None)
      // (who reads a hole: the program reading it once it entered a block, else what applied the rule)
      reader (hr, hb) => ((hr.in === None) || !(hr.in === hr.this)) ? hb : hr
      named_in (np, nt) => np.in.named_as(trimmed_or(level cw_trimmed (nt), nt), np)
      aside := Array.new
      definers := Array.new
      among (xs, x) => xs{. === x}#.count > 0
      // (what a definition is written with, the header's `=>`, outside every pair; the header's brackets a pair)
      separator := level separator_of (BOOTSTRAPPER.CAPTURES.text) (BOOTSTRAPPER.CAPTURE)
      defines (dt) => (level holds_outside (dt) (separator)) === true
      bracketed := level closing (BOOTSTRAPPER.CAPTURE)
      // (what is painted, `external style`: each style, what it is shown on and what the holes took; the host reads them)
      painted := Array.new
      noted(painted)
      sink := Array.new
      painted_with (pa, pc) => {
        sink.append(painted.append([pa.first, pa.last, bound_along(pc)]).last)
        pa.last
      }
      bound_along (bc) => (bc === None) ? Array.new : [bc.bound].joined(bound_along(bc.caller))
      // (what the holes took where a program runs, the nearest first; where the rule is used whose holes took a head)
      takes (tc) => (tc === None) ? Array.new : (tc.bound ?? Array.new).joined(takes(tc.caller))
      home_of (hc, he) => ((he === None) || (hc === None)) ? None : (among(hc.bound ?? Array.new, he) ? hc.caller.in : home_of(hc.caller, he))
      // (a body written in the brackets holes are written in is the code inside them)
      inside_of (it) => {
        code := level cw_trimmed (it)
        ((code.first == BOOTSTRAPPER.CAPTURE.first) && ((level cw_enclosed (code)) === true)) ? level cw_trimmed (level cw_span_of (level cw_slice (code) (1) (2)) (level cw_chopped (code))) : code
      }

      // (the compiler's parser: a grammar's rules read in a node of their own, a word what nothing else there reads)
      parse_node_of (grammar_text) => {
        g := Node(in: global)
        (gs: Statements(g) = grammar_text)(Program(in: g))
        p := Node()
        level moved_keys (g) (p)
        leaf := Node(in: global)
        (ls: Statements(leaf) = `{name_word} => external &`)(Program(in: leaf))
        p.split_key = leaf.rules.keys.last
        p
      }
      parser (grammar, program_text) => {
        grammar.parse_node = grammar.parse_node ?? parse_node_of(grammar.text)
        level curried_value (ps: Statements(grammar.parse_node) = program_text)
      }
      level set_parser (parser)
      // (read in turn; everything read, what was kept for afterwards)
      (Statements(global)(Program(in: global)), (\s | \n)[], (⊣ & ((end) => run_later(0)))(0))
    )
  )
) => { }
ex := (level input_part 0) as Expression
assert "!language   { }   {LHS} => {RHS}\n\n" as Expression -- .(
  .BOOTSTRAPPER.CAPTURE == `{ }`
  & .BOOTSTRAPPER.CAPTURES.LHS == `{LHS}`
  & .BOOTSTRAPPER.CAPTURES.RHS == `{RHS}`
)
// (its parts, each in turn)
assert {
  Ranged2 := class low: Decimal, "-", high: Decimal { }
  ranged2: Ranged2 = 3-8
  assert ranged2.high == 8  // ZZ1
  assert (`2-7` as Ranged2).high == 7  // ZZ2
  Ranged3 := class (low: Decimal, "-", high: Decimal) => { }
  ranged3: Ranged3 = 3-8
  assert ranged3.high == 8  // ZZ3
  Ranged4 := class (low: String+, "-", high: String+) => { }
  ranged4: Ranged4 = 3-8
  assert ranged4.high == "8"  // ZZ4
  Ranged5 := class (low: String+, `-`, high: String+) => { }
  ranged5: Ranged5 = 3-8
  assert ranged5.high == `8`  // ZZ5
  assert (`3-8` as Ranged5).high == `8`  // ZZ6
  Ranged6 := class (low: String+, \s, high: String+) => { }
  assert (`3 8` as Ranged6).high == `8`  // ZZ7
}
assert `{ }` is (String+, \s, String+)  // EX1 a hole's brackets around a space are not a capture
assert {
  Headed := class (head: `!language`, \s[]+, rest: String) => { }
  assert (`!language  x` as Headed).rest == `x`  // EX2 a text read as a structure does not give its last field what follows the space
}
assert {
  Captured := class (left: String+, \s, right: String+) => { }
  assert (`{ }` as Captured).left == `{`  // EX3 a text read as a structure does not give its first field the text before the space
}
assert {
  Inner := class (left: String+, \s, right: String+) => { }
  Outer := class (inner: Inner, `;`) => { }
  assert (`{ };` as Outer).inner.left == `{`  // EX4 a field of a structure is not read as its own structure
}
assert {
  Nested := class (inner: (left: String+, \s, right: String+), `;`) => { }
  assert (`{ };` as Nested).inner.right == `}`  // EX5 a field written as a structure is not read as one
}
assert {
  Spanned := class (spanned: (String+, \s, String+), `;`) => { }
  assert (`{ };` as Spanned).spanned == `{ }`  // EX6 a field written as positions does not take their span
}
assert `{LHS}` is `{ }`.map{== \s}(`LHS`)  // EX7 a text's space mapped to LHS does not read {LHS}
assert !(`{ }` is `{ }`.map{== \s}(`LHS`))  // EX9 a text's space mapped to LHS still reads the space
assert {
  Dependent := class (open: String, \s, close: open) => { }
  assert (`a a` as Dependent).close == `a`  // EX8 a field's type does not see a field before it
}
assert {
  Scoped := class (
    (
      statements: (
        Seen := 46
        Node := class (marked?: Node) => { mark := 1 }
        Inner := class (in?: Inner) => {
          rules := { got := (x) => Seen }
          made => Node()
        }
        got_seen := Inner().rules.got(0)
        made_mark := Inner().made.mark
        String
      )
    )
  ) => { }
  scoped := "x" as Scoped
  assert (external member (scoped) (`got_seen`)) == 46  // EX10 a closure in a class written in a header's statements does not see the header's names
  assert (external member (scoped) (`made_mark`)) == 1  // EX11 a class's `Node` written in a header's statements is the language's
}
