    while i < (l.to - l.from) {
      return 0 if Indexes.none_after(g, word_of(x + ((257 + Indexes.pair_hash(l.from + i)) * 4)), word_of(x + ((257 + (Indexes.pair_hash(l.from + i) + 1)) * 4)), a + 1, e)
      i = i + 1
    }
    1
  }
  static based_found (g, l: Text, a, e, x) => Indexes.based_from(g, l, e, Indexes.first_from(g, word_of(x + ((257 + Indexes.pair_hash(l.from + 1)) * 4)), word_of(x + ((257 + (Indexes.pair_hash(l.from + 1) + 1)) * 4)), a + 1), word_of(x + ((257 + (Indexes.pair_hash(l.from + 1) + 1)) * 4)))
  static based_from (g, l: Text, e, j, k) => {
