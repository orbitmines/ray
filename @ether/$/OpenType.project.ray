@ether/geometry

// OpenType specification (https://learn.microsoft.com/en-us/typography/opentype/spec/)
// The table directory (https://learn.microsoft.com/en-us/typography/opentype/spec/otff#table-directory)
OpenType := class: Language (sfnt_version: U32, count: U16, U16, U16, U16, records: (tag: Char₄, checksum: U32, offset: U32, size: U32)[]{.length == count}, *) {
  static extensions := ".otf" | ".ttf" | ".opentype"
  static level := {
    {font: OpenType} => font
  }
  static Glyph := class outlines: Geometry.Curve[], advance: Number, units: Number, ascender: Number
  // Data types (https://learn.microsoft.com/en-us/typography/opentype/spec/otff#data-types)
  static U8 = Binary₈
  static U16 = Binary₁₆
  static U32 = Binary₃₂
  static I8 := class: Binary₈ {
    signed => this < 2 ^ 7 ? this : this - 2 ^ 8
  }
  static I16 := class: Binary₁₆ {
    signed => this < 2 ^ 15 ? this : this - 2 ^ 16
    // int16 and F2DOT14 (https://learn.microsoft.com/en-us/typography/opentype/spec/otff#data-types)
    assert (0xFFFF as OpenType.I16).signed == -1 && (0x4000 as OpenType.F2Dot14).value == 1 && (0xC000 as OpenType.F2Dot14).value == -1  // OTF2 a signed or 2.14 number is not read
  }
  static F2Dot14 := class: OpenType.I16 {
    value => signed / 2 ^ 14
  }

  // head (https://learn.microsoft.com/en-us/typography/opentype/spec/head)
  static Head := class (OpenType.U32, OpenType.U32, OpenType.U32, OpenType.U32{== 0x5F0F3CF5}, OpenType.U16, units: OpenType.U16, Binary₆₄, Binary₆₄, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.U16, OpenType.U16, OpenType.I16, long_offsets: OpenType.U16, OpenType.I16)
  // hhea (https://learn.microsoft.com/en-us/typography/opentype/spec/hhea)
  static Hhea := class (OpenType.U32, ascender: OpenType.I16, OpenType.I16, OpenType.I16, OpenType.U16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, metrics: OpenType.U16)
  // hmtx (https://learn.microsoft.com/en-us/typography/opentype/spec/hmtx)
  static Metrics<count> := class (advances: (advance: OpenType.U16, bearing: OpenType.I16)[]{length == count}, *) {
    [glyph: Number] => .advances[[glyph, .advances.count - 1].min].advance
  }
  // cmap (https://learn.microsoft.com/en-us/typography/opentype/spec/cmap)
  static Cmap := class (OpenType.U16, count: OpenType.U16, encodings: (platform: OpenType.U16, encoding: OpenType.U16, offset: OpenType.U32)[]{.length == count}, *)
  // Format 4, segment mapping to delta values
  static Format4 := class (OpenType.U16{== 4}, OpenType.U16, OpenType.U16, doubled: OpenType.U16, OpenType.U16, OpenType.U16, OpenType.U16, ends: OpenType.U16[]{.length == doubled / 2}, OpenType.U16, starts: OpenType.U16[]{.length == doubled / 2}, deltas: OpenType.U16[]{.length == doubled / 2}, ranges: OpenType.U16[]{.length == doubled / 2}, glyphs: OpenType.U16[]) {
    [code: Number] => (0..<ends.count){this.starts[.] <= code <= this.ends[.]}.first -- (segment => segment == None ? 0
      : this.ranges[segment] == 0 ? (code + this.deltas[segment]) % 2 ^ 16
      : this.glyphs[this.ranges[segment] / 2 + code - this.starts[segment] + segment - this.ends.count] -- (. == 0 ? 0 : (. + this.deltas[segment]) % 2 ^ 16))
  }
  // Format 12, segmented coverage
  static Format12 := class (OpenType.U16{== 12}, OpenType.U16, OpenType.U32, OpenType.U32, count: OpenType.U32, groups: (first: OpenType.U32, last: OpenType.U32, glyph: OpenType.U32)[]{.length == count}) {
    [code: Number] => .groups{.first <= code <= .last}.first -- (. ? .glyph + code - .first : 0)
  }

  // glyf, simple glyph descriptions (https://learn.microsoft.com/en-us/typography/opentype/spec/glyf#simple-glyph-description)
  static Flag := class (Binary₂, y_same: Binary₁, x_same: Binary₁, repeats: Binary₁, y_short: Binary₁, x_short: Binary₁, on_curve: Binary₁)
  static Coordinate<short, same> := class ((magnitude: OpenType.U8) if short, (value: OpenType.I16) if !(short || same)) {
    delta => short ? (same ? .magnitude : -magnitude) : same ? 0 : .value.signed
  }
  static Point := class at: Geometry.Vector, on: boolean
  // Consecutive points of a contour: two off-curve points imply an on-curve one between them, an off-curve point is a quadratic's control, and on-curve to on-curve is a line
  static Step := class from: OpenType.Point, to: OpenType.Point {
    segment => Geometry.Quadratic(this.from.at, (this.from.at + this.to.at) * (1 / 2))
    // Two off-curve points imply an on-curve point between them (https://learn.microsoft.com/en-us/typography/opentype/spec/glyf#simple-glyph-description)
    assert {
      off_a := OpenType.Point(Geometry.Vector(0, 0), false)
      off_b := OpenType.Point(Geometry.Vector(2, 2), false)
      on_c := OpenType.Point(Geometry.Vector(4, 0), true)
      assert OpenType.Step(off_a, off_b).segment == Geometry.Quadratic(Geometry.Vector(0, 0), Geometry.Vector(1, 1)) && OpenType.Step(on_c, on_c).segment == Geometry.Vector(4, 0) && OpenType.Step(on_c, off_a).segment == []  // OTF3 a step between contour points is not the segment glyf describes
    }
  }
  static Line := OpenType.Step{.from.on && .to.on} { segment => to.at }
  static Curving := OpenType.Step{.to.on && !.from.on} { segment => Geometry.Quadratic(from.at, to.at) }
  static Leaving := OpenType.Step{.from.on && !.to.on} { segment => [] }
  static Simple := class (
    contours: OpenType.U16{< 2 ^ 15}, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16,
    ends: OpenType.U16[]{length == contours},
    instructions: OpenType.U16, OpenType.U8[]{length == instructions},
    runs: (flag: OpenType.Flag, (times: OpenType.U8) if flag.repeats == 1)[]{map(1 + (.times ?? 0)).sum == ends.last + 1},
    xs: flags.map(flag => OpenType.Coordinate<flag.x_short == 1, flag.x_same == 1>),
    ys: flags.map(flag => OpenType.Coordinate<flag.y_short == 1, flag.y_same == 1>)
  ) {
    flags => .runs.map([.flag] * (1 + (.times ?? 0))).flatten
    absolute (deltas: Number[]) => deltas.reduce(acc = [] => [acc, (acc.last ?? 0) + .].flatten)
    contoured (font: OpenType) => .absolute(this.xs.delta) -- (across => this.absolute(this.ys.delta) -- (up =>
      this.flags.enumerate.map(OpenType.Point(Geometry.Vector(across[.index], up[.index]), .value.on_curve == 1)))) -- (points =>
      [-1, this.ends].flatten.zip(this.ends).map((from, to) => points[(from + 1)..to]))
  }
  // glyf, composite glyph descriptions (https://learn.microsoft.com/en-us/typography/opentype/spec/glyf#composite-glyph-description)
  static ComponentFlag := class (Binary₃, unscaled: Binary₁, scaled_offset: Binary₁, overlap: Binary₁, metrics: Binary₁, instructions: Binary₁,
    two_by_two: Binary₁, xy_scale: Binary₁, more: Binary₁, Binary₁, scale: Binary₁, round: Binary₁, xy_values: Binary₁, words: Binary₁)
  static Component := class (
    flag: OpenType.ComponentFlag, glyph: OpenType.U16,
    ((first: OpenType.I16, second: OpenType.I16) if flag.words == 1), ((first: OpenType.I8, second: OpenType.I8) if flag.words == 0),
    ((scale: OpenType.F2Dot14) if flag.scale == 1), ((x_scale: OpenType.F2Dot14, y_scale: OpenType.F2Dot14) if flag.xy_scale == 1),
    ((xx: OpenType.F2Dot14, xy: OpenType.F2Dot14, yx: OpenType.F2Dot14, yy: OpenType.F2Dot14) if flag.two_by_two == 1)
  ) {
    linear => .flag.two_by_two == 1 ? [[.xx.value, .yx.value], [.xy.value, .yy.value]]
      : .flag.xy_scale == 1 ? [[.x_scale.value, 0], [0, .y_scale.value]]
      : .flag.scale == 1 ? [[.scale.value, 0], [0, .scale.value]]
      : [[1, 0], [0, 1]]
    transformed (point: OpenType.Point, by: Geometry.Vector) => OpenType.Point(Geometry.Vector(this.linear[0][0] * point.at.x + this.linear[0][1] * point.at.y, this.linear[1][0] * point.at.x + this.linear[1][1] * point.at.y) + by, point.on)
    placed (font: OpenType, before: OpenType.Point[]) => font.contours(this.glyph) -- (contours => contours.map(.map(this.transformed(., Geometry.Vector()))) -- (scaled =>
      (this.flag.xy_values == 1 ? Geometry.Vector(this.first.signed, this.second.signed) : before[this.first].at - scaled.flatten[this.second].at) -- (by => scaled.map(.map(OpenType.Point(.at + by, .on))))))
  }
  static Composite := class (contours: OpenType.U16{>= 2 ^ 15}, OpenType.I16, OpenType.I16, OpenType.I16, OpenType.I16, components: OpenType.Component[]{.[..<-1].every(.flag.more == 1) && .last.flag.more == 0}, *) {
    contoured (font: OpenType) => .components.reduce(placed = [] => [placed, .placed(font, placed.flatten)].flatten(1))
  }

  bits => this as Binary
  table (tag: String) => .records{.tag == tag}.first -- (record => this.bits[record.offset * 8 ..< (record.offset + record.size) * 8])
  head => .table("head") as OpenType.Head
  hhea => .table("hhea") as OpenType.Hhea
  hmtx => .table("hmtx") as OpenType.Metrics<hhea.metrics>
  cmap => .table("cmap") -- (data => (data as OpenType.Cmap).encodings{.platform == 3 && .encoding is (1 | 10) || .platform == 0}.map(data[.offset * 8..] as (OpenType.Format12 | OpenType.Format4)){!= None}
    -- (.{. is OpenType.Format12}.first ?? .first))
  // loca (https://learn.microsoft.com/en-us/typography/opentype/spec/loca)
  located (glyph: Number) => .head.long_offsets == 1 ? (.table("loca") as OpenType.U32[])[glyph] : (.table("loca") as OpenType.U16[])[glyph] * 2
  contours (glyph: Number) => .located(glyph) == .located(glyph + 1) ? [] : (.table("glyf")[.located(glyph) * 8 ..< .located(glyph + 1) * 8] as (OpenType.Simple | OpenType.Composite)).contoured(this) ?? []
  outline (points: OpenType.Point[]) => (points.some(.on)
    ? points.index_of(points{.on}.first) -- (start => [points[start..], points[..start]].flatten)
    : OpenType.Point((points.first.at + points.last.at) * (1 / 2), true) -- (start => [start, points, start].flatten)
  ) -- (ring => Geometry.Curve([ring.first.at, ring.zip(ring.rest).map(OpenType.Step(.0, .1).segment)].flatten.loop))
  outlines (glyph: Number) => .contours(glyph).map(this.outline(.))
  [character: Char] => .cmap[character as Number] -- (glyph => OpenType.Glyph(this.outlines(glyph), this.hmtx[glyph], this.head.units, this.hhea.ascender.signed))
}
// A table directory with no tables: sfntVersion 0x00010000 for TrueType outlines, numTables 0 (https://learn.microsoft.com/en-us/typography/opentype/spec/otff#table-directory)
assert OpenType.read([0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]).sfnt_version == 0x00010000 && OpenType.read([0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]).records.empty  // OTF1 an empty table directory is not read
assert OpenType === OpenType && Language.named(".ttf") === OpenType  // OTF4 OpenType is not OpenType
