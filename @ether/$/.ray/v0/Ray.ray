// -> (): Ray => next: () => Ray(next: next())
// <- (): Ray => previous: () => Ray(previous: previous())
// <--> (): Ray => (<-) &+ (->)


// What the language reaches today. `Ray < Iterable & Ordered` becomes a single
// chain of bases until a class can name more than one, and the draft's unicode
// aliases (⊢ ⊣ ∙ ⊙ ∃ ∀) wait on a way to spell them.
Ordered := class {
  < (other: Ordered) => TODO
  // `.<(…)` rather than `<`: a juxtaposed call is dispatched on what the
  // parameter was declared to be, and here that is only `Ordered`, whose `<`
  // is the one being overridden.
  > (other: Ordered) => other.<(this)
  <= (other: Ordered) => other.<(this).not
  >= (other: Ordered) => .<(other).not

  min (other: Ordered) => if (.<(other)) { this } else { other }
  max (other: Ordered) => if (.<(other)) { other } else { this }
}

