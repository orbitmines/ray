class: {parent} ({fields}) {`=>`} {`{`}{block}{`}`} ^keyword => (() => {
  held := ((parent) &+ {
    superclass := parent
    super := parent
    {block}
  })
  made := (held &+ { })
  made reads ({fields}) as made
  (parent reads ({fields}) as made) unless parent === Node
  made &+= {
    of := .
    {this}({arguments: Arguments}) => (this &+ {
      ({{fields}}) taking {arguments}
    })
    {this}() => this(declared)
  }
  made
