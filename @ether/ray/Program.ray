Program &+= {
  who: * = @me
  assert Program(code: { 1 }).who == @me  // PG35 a program does not run as the character who made it by default
  name: String?
  goal: *?
  from: *?
  at: Program?
  started := false
  stopped := false
  results: *[] = []
  assert !Program(code: { 1 }).started  // PG36 a program that was never stepped has started
  assert !Program(code: { 1 }).stopped  // PG37 a program that was never stopped has stopped
  assert Program(code: { 1 }).results.count == 0  // PG38 a program that was never stepped has results
  tried: *?

  written => .code ? super.written : [Program(code: ((.name ?? "reach"), "(", .goal as String, ")") as String)]
  assert Program(code: { 5 }).written.count == 1  // PG11 a program of one statement counts other than one
  // A statement read back as what it is written as
  assert {
    jumping := Program(code: {
      goto past if 5
      5
     past\
      6
    })
    always := Program(code: {
      goto away
     away\
    })
    landed := jumping.written[2]
    assert jumping.written.first.is_jump  // PG16 a goto is not read as a jump
    assert !(jumping.written.last.is_jump)  // PG17 a value is read as a jump
    assert landed.is_label  // PG19 a label is not read as one
    assert !(jumping.written.first.is_label)  // PG20 a jump is read as a label
    assert jumping.written.first.is_conditional  // PG21 a jump with a condition is not conditional
    assert jumping.target_of(jumping.written.first) == landed  // PG22 a jump does not land on its label
    assert !(always.written.first.is_conditional)  // PG23 a jump without a condition is conditional
    assert !(jumping.target_of(always.written.first))  // PG24 a jump lands on a label it does not name
    assert !(jumping.jumps_backward)  // PG30 a jump forward is read as a jump back
    assert jumping is Terminating  // PG32 a program that only jumps forward does not terminate
    assert !(jumping.crosses(jumping.written.first))  // XB2 a goto within its own branch is read as crossing
    // As what it does: a jump is an edge to where it lands
    assert jumping.flow.first.jumps_to == landed  // PG25 a jump's edge does not reach its label
    assert jumping.flow.first.falls_through  // PG27 a conditional jump does not go on below it
    assert jumping.flow[1].falls_through  // PG28 a value does not go on below it
    assert !(always.flow.first.falls_through)  // PG29 a jump without a condition goes on below it
  }
  defined => global.declaring(.head.head)
  abstract => .written{!.defined}

  & => .results
  is_initial | waiting => !.started
  assert Program(code: { 1 }).is_initial  // PG39 a program that was never stepped is not initial
  assert !Program(code: { 1 }).is_terminal  // PG40 a program that was never stepped is terminal
  assert !Program(code: { 1 }).intermediate  // PG41 a program that was never stepped is intermediate
  is_terminal | final => .started && !.at
  intermediate => .started && !.is_terminal
  holds => !.is_terminal && !.stopped
  assert Program(code: { 1 }).holds  // PG42 a program that was never stepped does not hold
  inputs => .written.zip(.results){.0 is Nondeterministic}
  stepped => {
    .at = .started ? .at.next : .written.first
    .started = true
    .results.push (.at)() if .at
  } -- this
  assert {
    stepped := 0
    stepped = 1 ; stepped += 1
    assert stepped == 2  // CF17 two assignments on one line did not both run
  }
  next => .copy ~~ (.results = [this.results]) -- .stepped
  // stepping a program one statement at a time
  assert {
    program := Program(code: {
      1
      2
    })
    program.stepped
    assert program.started  // PG43 a stepped program has not started
    assert program.results.count == 1  // PG44 one step does not leave one result
    assert program.results.last == 1  // PG45 the first step does not run the first statement
    assert program.intermediate  // PG46 a program in the middle of its statements is not intermediate
    assert !program.is_initial  // PG47 a stepped program is still initial
    program.stepped
    assert program.results.last == 2  // PG48 the second step does not run the second statement
    program.stepped
    assert program.is_terminal  // PG49 a program stepped past its last statement is not terminal
    assert !program.holds  // PG50 a finished program still holds
    assert program.results.count == 2  // PG51 stepping past the end added a result
  }
  // the next step of a program, on a copy
  assert {
    program := Program(code: {
      1
      2
    })
    following := program.next
    assert following.started  // PG52 the program after a step has not started
    assert !program.started  // PG53 taking the next step started the program itself
  }
  finished => (.stepped while .holds) -- this
  assert Program(code: {
    1
    2
  }).finished.(
    .is_terminal  // PG54 a finished program is not terminal
    & .results.count == 2  // PG55 a finished program of two statements does not have two results
    & .results.last == 2  // PG56 a finished program's last result is not its last statement's
  )
  static round => Program#{.running}.map(.stepped)
  static until (condition) => (Program.round while !condition() && Program#.some(.running)) -- this

  reached (value) => .goal !== None && value is .goal
  assert Program(code: { 1 }, goal: Number).reached(5)  // PG57 a value of the goal's type does not reach the goal
  assert !Program(code: { 1 }, goal: Number).reached("five")  // PG58 a value not of the goal's type reaches the goal
  assert !Program(code: { 1 }).reached(5)  // PG59 a program with no goal is reached
  attempt (value): static => this ~~ (.tried = value) ~~ (.complete if this.reached(value))
  running => .started && !.done
  assert {
    program := Program(code: {
      1
      2
    })
    assert !program.running  // PG60 a program that never started is running
    program.stepped
    assert program.running  // PG61 a program in the middle of its statements is not running
    assert !program.done  // PG62 a program in the middle of its statements is done
    program.stop
    assert program.stopped  // PG63 a stopped program is not stopped
    assert program.done  // PG64 a stopped program is not done
    assert !program.running  // PG65 a stopped program is still running
  }
  done => .stopped || .is_terminal
  continuable => .done && !(.tried**.is_terminal ?? true)
  path => [.tried, .tried.previous**].flatten
  solution | best => .path{this.reached(.)}.first
  solved_by => .solution.who
  progress => .started ? .written.index_of(.at) ?? .written.count : 0
  difficulty => .written.count
  // PG66 the difficulty of a program is not its number of statements
  assert Program(code: {
    1
    2
    3
  }).difficulty == 3
  assert Program(code: { 1 }).progress == 0  // PG67 a program that never started has progress
  // PG68 a finished program has not made progress through all its statements
  assert Program(code: {
    1
    2
  }).finished.progress == 2

  stop | cancel | complete: static => this ~~ (.stopped = true)
  // (entered into a value: a closure of it, applied to it; `element`, what `.` is in it, not yet)
  entered (entered_into, entered_element) => entered_into -- this
}
assert Program(code: {
  1
  2
  3
}).(
  .  // PG1 a block handed to a rule is not read as a program
  & .written  // PG3 a program is not written as anything
  & .written.count == 3  // PG8 a program of three statements does not count three
  & .written.count == 3  // PG9 a program of three is not written as three
  & .written.first.written  // PG5 a statement is not a program in turn
  & .written.first.written.count == 1  // PG10 a statement is written as other than one thing
  & .O  // PG12 a program does not say which rules it is read with
  & !(.written.first.is_jump)  // PG18 a name is read as a jump
)
assert Program(code: {
 again\
  goto again
}).(
  .jumps_backward  // PG31 a jump back to a label above is not read as one
  & !(. is Terminating)  // PG33 a program that jumps back terminates
)
// A goto into another branch is a call at that place (P2.10)
assert Program(code: {
  goto there
  5
  if true {
   there\
    6
  }
}).(
  .crosses(.written.first)  // XB1 a goto into another branch is not read as crossing
  & .flow.first.falls_through  // XB3 a goto into another branch does not come back like a call
  & .called_at(.written.first) == 6  // XB4 a goto into another branch does not run at that place
)
// A variable's slice is the part of its program it was written from (P1.14); effects are inferred (P1.24)
assert Program(code: {
  a := 1
  b := 2
  c := a + 1
}).(
  .slice("c").count == 2  // FWP1 a variable's slice is not what it was written from
  & !(.slice("c").some(.code ~= ⊢"b"))  // FWP2 a slice holds what the variable does not depend on
)
assert Program(code: { 1 + 1 }).effects.empty  // FWP3 a program with no effects is said to have some

Program &+= {
  is_jump => .code ~= ⊢"goto "
  is_label => .code ~= "\\" ⊣
  jump => .code ~= (⊢"goto ", name: Char.Word[], (" ", condition: *)?)
  is_conditional => .is_jump && .jump.condition
  target_of (jump: Program) => .written{.is_label && .code == jump.jump.name + "\\"}.first
  holding (name: String) => .written.some(.is_label && .code == name + "\\") ? this : .written.map(.holding(name)){!= None}.first
  // PG69 a program with a label does not hold it
  assert Program(code: {
   there\
    1
  }).holding("there") != None
  assert Program(code: { 1 }).holding("nowhere") == None  // PG70 a program holds a label it does not have
  crosses (jump: Program) => !.target_of(jump) && .holding(jump.jump.name)
  called_at (jump: Program) => .holding(jump.jump.name) -- .copy ~~ (.at = .target_of(jump)) ~~ (.started = true) -- .finished.results.last

  flow => .written.map(step => (step, jumps_to: step.is_jump ? this.target_of(step) : None, falls_through: !step.is_jump || step.is_conditional || this.crosses(step)))
  jumps_backward => .written.some(step => step.is_jump && this.written.index_of(this.target_of(step)) <= this.written.index_of(step))
  terminating => !.jumps_backward
  assert Program(code: { 1 }).terminating  // PG71 a program that never jumps does not terminate
  // PG72 a program that jumps back to a label terminates
  assert !Program(code: {
   again\
    goto again
  }).terminating

  head => .code ~= (⊢ head: (!(" " | "(" | ":" | "?"))[], ending: (" " | "(" | ":" | "?")?)
  assert Program(code: { foo(1) }).written.first.head.(
    .head == "foo"  // PG73 the head of a call is not the name before the bracket
    & .ending == "("  // PG74 the head of a call does not end at its bracket
  )
  assert Program(code: { x := 1 }).written.first.head.head == "x"  // PG75 the head of a declaration is not its name
  required_heads => .written{(.head.ending == ":" && .head.head ~= ⊢Char.Word) || .code ~= (.head.head, " => TODO")}.head.head
  assert Program(code: { x: Number }).required_heads.contains("x")  // PG76 a name declared with only its type is not required
  assert !Program(code: { y := 1 }).required_heads.contains("y")  // PG77 a name declared with a value is required
  declares (head: String) => .written.some(.code ~= ⊢(head, " " | "(" | ":"))
  assert Program(code: { x := 1 }).declares("x")  // PG34 a program declaring x does not say so
  precedence (spelled: String) => .written.index_of(.written{.code ~= ⊢((Modifier.spellings, " ")?, spelled, " ")}.first)
  assert Program(code: {
    a x
    b y
  }).(
    .precedence("b") > .precedence("a")  // PG78 a statement written later does not have a later precedence
    & !(.precedence("a") > .precedence("b"))  // PG79 a statement written first has a later precedence
  )

  assigns => .code ~= ⊢((!" ")[], " "[], "=" | "&=" | "|=" | "+=" | "-=", " ")
  assert Program(code: { x = 1 }).written.first.assigns  // PG80 an assignment is not read as one
  assert Program(code: { x += 1 }).written.first.assigns  // PG81 an addition assignment is not read as one
  assert !Program(code: { x + 1 }).written.first.assigns  // PG82 a sum is read as an assignment
  writes (name: String) => .written{.code ~= ⊢(name, " "[], (":=" | "=" | "&=" | "|=" | "+=" | "-=" | ":"))}
  assert Program(code: {
    a := 1
    b := 2
    a = 3
  }).(
    .writes("a").count == 2  // PG83 the statements writing a name are not all found
    & .writes("b").count == 1  // PG84 a name written once is not found once
    & .writes("c").count == 0  // PG85 a name never written is found
  )
  // (the names its statements are headed by, each once; whether a statement's text has a name in it)
  variables => .written.map(.head.head).unique
  mentions (name: String) => .code ~= (*, name, *)
  // PG93 the variables of a program are not the names its statements are headed by
  assert Program(code: {
    a := 1
    b := a
  }).variables == ["a", "b"]
  assert Program(code: { b := a + 1 }).written.first.mentions("a")  // PG94 a statement does not mention a name written in it
  depends (name: String, seen: String[] = []) => [[name], .writes(name).map(statement => this.variables{. != name && !seen.contains(.) && statement.mentions(.)}).flatten.unique
    .map(this.depends(., [seen, [name]].flatten)).flatten].flatten.unique
  slice (name: String) => .depends(name) -- (names => this.written{statement => names.some(this.writes(.).contains(statement))})
  assert Program(code: {
    a := 1
    d := 2
    c := a + 1
  }).depends("c").(
    .contains("c")  // PG86 a variable does not depend on itself
    & .contains("a")  // PG87 a variable does not depend on what it is computed from
    & !.contains("d")  // PG88 a variable depends on what it is not computed from
  )
  // PG89 a variable does not depend on what the variables it is computed from depend on
  assert Program(code: {
    a := 1
    b := a + 1
    c := b + 1
  }).depends("c").contains("a")

  schedule (on = @me) => on.quests |= this

  right-to-left branch => .copy.stepped
  assert await (branch { 3 }) == 3  // CR3 awaiting a branch does not answer what it did
  right-to-left sync => .written -- (.{holds}.map(.stepped) while .some(.holds)) -- .results.last
  // CR1 sync does not answer every branch
  assert (sync {
    1
    2
  }) == [1, 2]
  right-to-left race => .written
    -- (.map(.stepped) while .every(.holds))
    -- .{holds}.map(.cancel)
    -- .{is_terminal}.first.results.last
  // CR2 race is not won by the first to finish
  assert (race {
    1
    2
  }) == 1
  right-to-left rush => .written
    -- (.map(.stepped) while .every(.holds))
    -- .{is_terminal}.first.results.last
  // PG90 rush is not won by the first to finish
  assert (rush {
    1
    2
  }) == 1
  right-to-left defer => .copy ~~ .from = &.caller
}

// `with settings { … }`, `with settings` (L§6.3): what the settings write is written `@ ->` (Almanac A3) for the block, or the
// rest of the context the `with` is in, and everything called from there. (settings that are a block: what it holds)
// (declared in the entrypoint, before `=`)

Terminating := Program{.terminating}
assert Program(code: { 1 }) is Terminating  // PG91 a program that only runs forward is not terminating

Keyed := class (key: *, ":", " "[], (*, " = ")?, value: *) => {
  as (=== String) => .value as String
  assert Keyed(key: "a", value: "b") as String == "b"  // PG92 a keyed value is not written as its value
}

// A block as a map (its `keys`, `x[key]`, `for` over them, T8.7) is the language's own: the entrypoint gives every program them.

// Operator sections are values (A1, A2)
assert [1, 2].map(+1) == [2, 3]  // OP1 +1 is not a function adding one

assert [1, 2].map(*10) == [10, 20]  // OP2 *10 is not a function multiplying by ten

assert [true, false].map(!) == [false, true]  // OP3 ! alone is not the negation

assert [1, 5, 20]{< 10}.count == 2  // OP5 a section in a narrowing is not applied to each

assert (if 3 { != 0 => "nonzero" } else { "zero" }) == "nonzero"  // IC3 if with cases is not a value where it is written


// `?` is unknown; `?=` sets only what has no value (T1.6)
assert (?)#.count != 1  // QM1 ? is one value

assert {
  given := None
  given ?= 4
  given ?= 5
  assert given == 4  // QM2 ?= does not set only what has no value
}


assert 3 is [1, 2, 3]#  // IS4 is does not find a member

assert !(5 is [1, 2, 3]#)  // IS5 is finds what is not there

assert 2 is [1, 2]#  // IS6 is does not find a member
// Labels in a class body are entries (L§4.2)
assert {
  Entered := class {
    steps := 0
   later\
    steps = 7
  }
  assert Entered~later().steps == 7  // EP1 ~label does not enter the class at that label
  assert Entered~default == Entered  // EP2 ~default is not the class itself
  // A class body runs like any function: labels are never skipped; a Component's labels are entered, not executed (F-D13, L§4.2.1)
  assert Entered().steps == 7  // CMP1 a label in a class body stops its construction
}
// A program run as a selection
assert Program(code: {
  1
  2
}).(
  .waiting  // RU1 a program nobody stepped is not waiting
  & .next.intermediate  // RU2 one step in is not intermediate
  & .waiting  // RU3 stepping a copy moved the original
  & .finished.final  // RU4 a program run to its end is not final
  & .finished.results.last == 2  // RU5 a program run to its end did not keep what its last step answered
)
assert {
  doubling := Program(code: { 2 })
  halving := Program(code: { 1 })
  ! doubling halving
  assert doubling⁻¹ === halving  // IV1 the declared inverse is not the inverse
  assert halving⁻¹ === doubling  // IV2 the inverse of the inverse is not the function
  assert doubling.reversible  // IV3 a function with an inverse is not reversible
}
// Operators declared each other's inverse
! `+` `-`
! `*` `/`
assert `-`⁻¹ as String == "+"  // FE10 the inverse of minus is not plus
assert `+`⁻¹ as String == "-"  // FE9b the inverse of plus is not minus
assert `+`.reversible  // FE9a the inverses have no plus
assert `-`.reversible  // FE9 the inverses have no minus
// A program is a quest (P4.8): its cursor says how far it is; sleeping waits on the time (P4.11); a dynamic `&=` keeps one contribution (P5.7)
assert Program(code: { 1 }).(
  !(.done)  // FWQ2 a program not yet stepped is done
  & .finished.done  // FWQ3 a finished program is not a done quest
)
assert Program(code: { 1 }).stop.done  // FWQ4 a stopped program is not done
assert {
  started := Program(code: "1")
  @me/quests |= started
  assert started is @me/quests  // JB1 a program given to @me/quests is not among them
  assert started.who === @me  // JB11 a started program is not run by whoever started it
  assert started.stop.done  // JB5 stopping a program does not end it
}
assert Program(code: "1", from: @public).(
  .serves(@public)  // JB8 a quest serving a location does not serve it
  & !(.serves(@private))  // JB9 a quest serves a location it was not given
)

// The running program: what called what is read here
&@ ^keyword => &.caller as Program

// What a program does is what its externals are (L§8.1): what it calls past itself, and what it reaches of the machine
Program &+= {
  continuations => .calls{!.is_external}.map(.**)
  effects => .reachable.map(.calls{.is_external}.external_name).flatten.unique
  assert Program(code: { @me/instance = "x" }).effects.contains("io")  // AC60 writing out is not an effect named io
  // What a run may do is the runner's setting (L§8.1): `with (Program.speculated |= x)`, `with (Program.refused |= x)`, or a `.cfg.ray`.
  static speculated: *[] = []
  static refused: *[] = []
  assert Program.speculated.count == 0  // AC58 nothing is speculated unless asked
  assert Program.refused.count == 0  // AC59 nothing is refused unless asked
}
// io and os are effects; the time is not deterministic
assert Program(code: { 1 + 1 }) is Pure  // EFF1 adding numbers is not pure
assert Program(code: { @me/instance = "x" }) is Effecting  // EFF2 writing out is not an effect
assert {
  with (Program.refused |= Program(code: { @me/instance = "x" })) {
    assert Program(code: { @me/instance = "x" }) is Refused  // EFF4 a refused program is not refused
  }
}
assert Program(code: { @me/instance = "x" }) is Abstracted  // EFF5 an effect nobody speculated runs in full

Pure := Program{.effects.empty}
assert Program(code: { 1 + 1 }) is Deterministic  // AC61 adding numbers is not deterministic
assert !(Program(code: { 1 + 1 }) is Effecting)  // AC62 adding numbers is an effect
assert !(Program(code: { 1 + 1 }) is Nondeterministic)  // AC64 adding numbers is nondeterministic
Deterministic := Program{!.effects.some(. is ("random" | "time" | "io"))}
Nondeterministic := Program{!(. is Deterministic)}
Effecting := Program{.effects.some(. is ("io" | "os"))}
Initializer := Program{.calls.every(.is_external && .external_name is ("declare" | "assign"))}
assert Program(code: { x := 1 }) is Initializer  // AC65 a program that only declares is not an initializer
assert !(Program(code: { @me/instance = "x" }) is Initializer)  // AC66 a program that writes out is an initializer
Refused := Program{. is Program.refused#}
Abstracted := Program{. is Effecting && !(. is Program.speculated#)}

[(`pure`, Pure), (`deterministic`, Deterministic), (`nondeterministic`, Nondeterministic)].for (word, claim) => {
  right-to-left `word` {method} ^keyword => method -- (ERROR `this method is not what it is marked as` unless method** is claim)
}
