assert {
  nothing_given := () => true
  assert nothing_given()  // CL11 a closure of no parameters given a name with `:=` is not called
}
assert {
  Members := class {
    member := true
  }
  assert Members.member  // CL12 a member a class's block declares is not read on the class
  assert Members().member  // CL13 a member a class's block declares is not read on an instance
  layered := (() => {
    inner := Node &+ {
      deep := true
    }
    inner
  })()
  assert layered.deep  // CL14 a node made in a closure (`x &+ { … }`) does not keep what its block declares
  spread_out := (() => {
    first := true
    first
