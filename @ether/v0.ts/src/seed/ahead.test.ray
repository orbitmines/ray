say {x} =>
  external io stdout x
// a class's block may name what it declares further on: each line says true (preceding)
G := class {
  Paint := Color | Gradient
  Color := class { }
  Gradient := class { }
  Late := Color
}
say (G.Paint.components.head.value === G.Color)
say (G.Paint.components.head.next.value === G.Gradient)
say (G.Late === G.Color)
