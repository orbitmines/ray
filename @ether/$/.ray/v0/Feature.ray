IO := class {
  root = "instance"
  permitted = false

  inside (path) => {
    parts = path.split("/"){!= "." && !.empty}.reduce([]) (kept, part) => part == ".." ? kept[..-1] : (kept, part)
    root + "/" + parts.join("/")
  }
  read (path) => (external io inside(path) None) as String
  write (path, content) => external io inside(path) content
  output (text: String) => external io `/dev/stdout` text
  host (path) => permitted ? (external io path None) as String : Quest(name: "ask for the host's files", goal: path)
  field (name: String) => (name + ".ray", name + "/", name).map(read(.)).first(.nonempty) ?? ""

  os (name) => (external os name) as String
  platform => os(`platform`)
  architecture => os(`architecture`)

  static File := class = path: String {
    content => IO.read(path)
    bytes => content.collected
  }
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => (external random) ? 1 : 0
  bits (count: Number) => count.times.map(bit)
  number (width: Number) => bits(width).reduce(0) (total, drawn) => total * 2 + drawn
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }

  static Seeded := class = state: Number {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    number (width: Number) => width.times.map(bit).reduce(0) (total, drawn) => total * 2 + drawn
  }
}

Counted := class = count: Number | Range, kind: * {
  least => count ==.instance_of Number ? count : count.first
  most => count ==.instance_of Number ? count : count.last
  choose => (least + Random.below(most - least + 1)).times.map(kind())
}

Choice := class {
  chosen: *[] = []

  choose (from) => from.random
  choose_count (from, count: Number) => count.times.map(from.random)
  coin => Random.bit
  unique (from) => {
    picked = choose(from)
    chosen.contains(picked) ? unique(from) : chosen.push picked
  }

  identities (values) => values.unique(===)
  subsets (values, count: Number) => {
    return [[]] if count == 0
    return [] if values.empty
    subsets(values[1..], count - 1).map([values.first, .]), subsets(values[1..], count)
  }
  orderings (values) => values.count < 2 ? [values] : values.flat_map(held => orderings(values{!== held}).map([held, .]))

  mapped (values, count: Number, step) => Distribution.uniform(
    subsets(identities(values), count).map(picked => values.map(held => picked.some(=== held) ? step(held) : held))
  )
  unordered (values) => Distribution.uniform(orderings(values)).realised
}

Distribution := class = outcomes: Outcome[] = [], optional = false {
  static Outcome := class = weight: Number, value: *

  static uniform (values) => values.reduce(Distribution()) (made, value) => made.weighted(1, value)
  static share (fraction, values) => uniform(values).realised_many(fraction)

  weighted (weight: Number, value): static => this ~~ outcomes.push Outcome(weight, value)
  total => outcomes.weight.sum

  realised => {
    drawn = Random.below(1000000) * total / 1000000
    outcomes.reduce(0) (reached, outcome) => {
      return outcome.value if drawn < reached + outcome.weight
      reached + outcome.weight
    }
    None
  }
  realised_many (fraction) => outcomes{Random.below(1000000) < fraction * 1000000}.value
}

Assumption := class = fact: *, verified = false {
  static assume (fact) => Assumption(fact)

  holds => true
  quest => Quest(name: "verify the assumption", goal: fact)
  verify (actual) => verified = actual == fact
  rolled_back => !verified
}

Proof := class = proposition: *, argument: * {
  static Proposition := class = holds: boolean {
    negated => Proposition(holds: !holds)
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : Quest(name: "prove", goal: proposition)
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
  static assume (fact) => fact
  static failed (error) => Quest(name: "fix", goal: error)
}

Transaction := class = forwards: *?, backwards: *?, applied = false, history: History?, branch: History? {
  static Inverse := enum plus (of: `+`, is: `-`) | minus (of: `-`, is: `+`) | times (of: `*`, is: `/`) | over (of: `/`, is: `*`)

  static begin (history: History) => Transaction(history, branch: history.fork)

  record (who, change, inverse): static => this ~~ branch.commits.push History.Commit(who, what: change, inverse)
  commit: static => this ~~ (
    history.merge(branch)
    .applied = true
  )
  abort: static => this ~~ .branch = None

  reversed => Transaction(forwards: backwards, backwards: forwards, applied)
  mark_applied: static => this ~~ .applied = true
}

Network := class {
  static DomainName := class (text: (Char.Letter | Char.Digit | "-" | ".")[]) => {
    valid => 0 < text.count < 2^8
  }

  static Proxy := class = character: Character {
    static through (character: Character) => Proxy(character)
  }

  static Protocol := class {
    static version => UUID.Namespace.DNS
    static handshake (offered) => offered
  }

  // What another instance serves at a path, at a version when one is asked for; kept locally once fetched (X3.3).
  static fetch (from: Location, path: String, version: Version?) => IO.read(from / path, version) ?? HTTP.get(from / path + (("%", version.number) if version))
}

HTTP := class {
  static Method := enum get | post | put | delete

  get (url) => IO.read(url)
}

OS := class {
  static Name := enum linux | macos | windows | ether | unknown

  name => { "linux": Name.linux, "darwin": Name.macos, "win32": Name.windows }[IO.platform] ?? Name.unknown
}

Keyboard := class = keys: Key[] = [] {
  static Key := class = name: * {
    pressed = false
    toggled = false
    presses = 0
    pressed_at: Time[] = []

    pulsed (max, delay) => pressed_at.nonempty && (pressed_at.count == 1 || Time.now - pressed_at.first >= delay)

    press: static => this ~~ (
      pressed_at.push Time.now
      .pressed = true
      .toggled = !toggled
      .presses += 1
    )
    release: static => this ~~ .pressed = false

    cycle (iterable) => iterable[presses % iterable.count]
    holds => pressed
    as (:== boolean) => pressed
  }

  add (key: Key): static => this ~~ keys.push key
}

Chat := class = messages: Message[] = [] {
  static Message := class = who: *, text: String

  say (who, text: String): static => this ~~ messages.push Message(who, text)
  count => messages.count
}
