Compiler := class {
  none := {
  }

  folding := {
    {a} + 0 => a
    0 + {a} => a
    {a} * 1 => a
    1 * {a} => a
  }

  specialised := {
    {v: Geometry.Vector{length == 2}}.map({f}) => Geometry.Vector(f(v.x), f(v.y))
    {v: Geometry.Vector{length == 3}}.map({f}) => Geometry.Vector(f(v.x), f(v.y), f(v.z))
    {a: Geometry.Vector{length == 2}} + {b: Geometry.Vector} => Geometry.Vector(a.x + b.x, a.y + b.y)
    {a: Geometry.Vector{length == 2}} - {b: Geometry.Vector} => Geometry.Vector(a.x - b.x, a.y - b.y)
    {a: Geometry.Vector{length == 2}} * {factor: Number} => Geometry.Vector(a.x * factor, a.y * factor)
    Geometry.euclidean({a: Geometry.Vector{length == 2 && !Geometry.Space.current.axes.some(.loop)}}, {b}) => √((b.x - a.x) ^ 2 + (b.y - a.y) ^ 2)
    Geometry.graph({a: Geometry.Vector{length == 2 && Geometry.Space.current.vertices == None && !Geometry.Space.current.axes.some(.loop)}}, {b}) => ((b.x - a.x) max (a.x - b.x)) + ((b.y - a.y) max (a.y - b.y))
    Geometry.Transform{Geometry.Space.current.dimension == 2}.identity => [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
    {t: Geometry.Transform{count == 3}}.applied({p}) => Geometry.Vector(t[0][0] * p.x + t[0][1] * p.y + t[0][2], t[1][0] * p.x + t[1][1] * p.y + t[1][2])
    {facet: Geometry.Facet{corners.count == 2}}.crossing({p}) => facet.corners -- ((a, b) =>
      (a.y <= p.y) != (b.y <= p.y) && p.x < a.x + (p.y - a.y) * (b.x - a.x) / (b.y - a.y) ? facet.orientation * (b.y > a.y ? 1 : -1) : 0)
    {shape: Geometry.Shape{space.dimension == 2 && !space.discrete && rectangular}}.contains({p}) => shape.transform.inverse.applied(p) -- (q =>
      0 <= q.x < shape.size.x && 0 <= q.y < shape.size.y)
    {shape: Geometry.Shape{space.dimension == 2 && space.discrete && space.vertices == None}}.contains({p}) => shape.transform.inverse.applied(p) -- (q =>
      shape.origin.x <= q.x < shape.origin.x + shape.size.x && shape.origin.y <= q.y < shape.origin.y + shape.size.y)
    {edges: Geometry.Edges}[{side: Geometry.Side{label}}] => edges.`side.label`
    {edges: Geometry.Edges{Geometry.Space.current.dimension == 2}}.total => Geometry.Vector(edges.left + edges.right, edges.top + edges.bottom)
    {edges: Geometry.Edges{Geometry.Space.current.dimension == 2}}.start => Geometry.Vector(edges.left, edges.top)
    {side: Geometry.Side}.vector(2) => side.axis == 0 ? Geometry.Vector(side.toward, 0) : Geometry.Vector(0, side.toward)
  }

  default := folding + specialised + {
    {a} - 0 => a
    {a} * 0 => 0
    0 * {a} => 0
    {a} / 1 => a
    {a}.unique.unique => a.unique
    {a}.reverse.reverse => a
    {a}.compact.compact => a.compact
    {a}.flatten.flatten => a.flatten
    {a}.sort.sort => a.sort
  }

  logic := {
    !!{a} => a as boolean
    {a} && {a} => a
    {a} || {a} => a
  }

  memoised := {
    {f: Pure}({arguments}) => f.remembered(arguments)
  }

  formats := {
    ({kept: Language{fidelity == Language.Fidelity.lossless}} | {other: Language}).read({source}) => kept.read(source)
    {history: History{location && stored.some(.fidelity == Language.Fidelity.snapshot)}}.checkout({label}) => history.pinned(label) -- (pinned =>
      history.stored.find(.fidelity == Language.Fidelity.snapshot).tree_at(history.location, pinned) -- (tree => tree
        ? history.at(pinned).definitions.map(d => (d.id, History.read_file(tree.at(d.path_in(history.at(pinned))))))#
        : history.at(pinned).value))
  }

  per_object := {
    {written: History.Written{file.content.count > 2^20 && history.definitions.count > 1}}.stored_file => written.referenced
    {written: History.Written{file.content.count > 2^20 && history.definitions.count > 1}}.object_files => written.objects
  }

  cached := {
    {written: History.Written}.cache_files => written.caches
    {history: History{cache}}.checkout({label}) => history.pinned(label) -- (pinned => history.cache.nearest(history, pinned) -- (hit => hit
      ? history.at(pinned).ordered{c => !hit.ancestry.some(=== c)}.reduce(held = history.cache[hit.id] => .applied(held))
      : history.at(pinned).value))
  }

  delta := {
    {body: History.Body{operation.kind == Operation.Kind.change && operation.before != None && History.edit(operation.before, operation.after).count < Language.ray.write(operation.after).count}} => History.edit(body.operation.before, body.operation.after)
  }

  stored := formats + per_object + cached + delta

  levels => [none, default, folding, logic, memoised, formats, per_object, cached, delta, stored]

  static reduced (value, level) => Program(code: { value }){O: level}()
}

Program &+= {
  O | optimizations := Compiler.none
  compounds + (other: Program) => Program(code: (code, other.code))
  results: (arguments: *, value: *)[] = []
  remembered (arguments) => (results{.arguments == arguments}.first ?? (results.push (arguments: arguments, value: this(arguments)) -- results.last)).value
}
