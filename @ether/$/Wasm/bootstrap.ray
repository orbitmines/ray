}
// A local: its name, from here on in its function, its value; given one, the get it writes made a set
var {x} {i} => {
  {x} => {
    external emit 0x20
    external leb {i}
  }
}
{x} = {v} => {
  v
  external mark
  {x}
  external patch 0x21
}
// Statements
return {v} => {
  v
  external emit 0x0F
}
trap => external emit 0x00
drop {v} => {
  v
