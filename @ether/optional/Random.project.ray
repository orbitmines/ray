@ether/os

// Random bits: the machine's own (`@random`), or a seeded sequence. What draws from a type or a collection draws with them.
Random := class {
  secure => Random
  seeded (seed: Number) => Random.Seeded(state: seed)

  bit => OS.Ether ? ERROR@OS `a source of random bits is not written in Ray yet` : @random ? 1 : 0
  assert Random.bit  // FE1 a bit from the machine is nothing
  // The machine's own bit. It is handed over as presence, not as a written digit, so it can be read at all; before that
  // every bit was zero and every uuid was the same one.
  assert Random.bit == 1 || Random.bit == 0  // RN1 a drawn bit is neither one nor zero
  // Twenty draws are not all the same. They could be — about twice in a million — but every bit being the same is what a
  // machine that hands over nothing readable looks like, which is what this is here to catch.
  assert {
    draws := 20.times.map((drawn) => Random.bit)
    ones := draws{== 1}.count
    zeros := draws{== 0}.count
    assert ones + zeros == 20  // RN5 twenty draws are not twenty
    assert !(ones == 0)  // RN6 twenty draws were all nothing
    assert !(zeros == 0)  // RN7 twenty draws were all something
  }
  bits (count: Number) => count.times.map((drawn) => this.bit)
  assert Random.bits(3).count == 3  // FE2 three bits are not three
  assert Random.bits(4).count == 4  // RN2 four drawn bits are not four
  number (width: Number) => Binary(integer: .bits(width).map(Binary.digit))
  assert Random.number(3) < 8  // RN3 three bits spell eight or more
  below (limit: Number) => {
    drawn := .number((limit as Binary).length)
    drawn < limit ? drawn : .below(limit)
  }
  assert Random.below(5) < 5  // RN4 a number below five is not below five

  // (a linear congruential sequence from a seed: the same seed, the same bits)
  static Seeded := class (state: Number) => {
    next => .state = (.state * 1664525 + 1013904223) % 2^32
    bit => .next / 2^31 == 1 ? 1 : 0
    number (width: Number) => Binary(integer: width.times.map((drawn) => this.bit).map(Binary.digit))
  }
  // the same seed draws the same bits
  assert {
    first_seeded := Random.seeded(7)
    second_seeded := Random.seeded(7)
    assert first_seeded.number(8) == second_seeded.number(8)  // RN13 two sequences from one seed draw different numbers
    assert Random.seeded(7).number(8) < 256  // RN14 eight seeded bits spell 256 or more
  }
}

// (what the bootstrap leaves to random: drawing from what a value may be)
Number &+= {
  chosen_within (width: Number) => Random.number(width)
}
Iterable &+= {
  random => .drawn(Random.below(.map(.weight ?? 1).sum))
  shuffled => .orderings.random
}
Set &+= {
  normalizer => .shuffled.unique
}
assert (1 | 2)#.contains((1 | 2)#.random)  // HS4 a random possible value is not one of them
assert boolean#.random is boolean  // FE3 a coin comes up with nothing
assert [1, 2, 3].shuffled.count == 3  // RN15 a shuffled list of three is not three
