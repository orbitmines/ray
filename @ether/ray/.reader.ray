{pattern} => {body} =>
  external rule pattern body
{name} := {value} =>
  external declare name value
//{comment} =>
  external label comment

// ---------------------------------------------------------------- the vocabulary the reader is written in
// Until the reader defines the language's own (below, on `Node`), these are rules; each is spelled and means what the
// language's does (spec/Language.md L§2), so the reader is written in Ray. What is declared first binds loosest.

// A member set (`x.m = v`) and a name written (`x = v`: the binding it was declared in, the nearest frame that has it).
{x}.{member} = {value} =>
  external set x member value
{name} = {value} =>
  external assign name value
// `condition ? yes : no`: `yes` when the condition holds, else `no` (only the one taken is read).
{condition} ? {yes} : {no} =>
  external goto taken condition
  no
  external goto done
  external label taken
  yes
  external label done
// `a && b`: `b` when `a` holds, else nothing (`b` read only then).
{a} && {b} =>
  external goto both a
  external goto done
  external label both
  b
  external label done
{a} === {b} =>
  external same a b
{x}.{member} =>
  external get x member
true := external node
// Nothing: what a node does not have.
empty := external node
None := empty.nothing

// Control flow (spec/Grammar.md G2.19): what is indented under `if`, `unless` and `while` is their block.
if {condition} {block} =>
  external goto taken condition
  external goto done
  external label taken
  block
  external label done
unless {condition} {block} =>
  external goto done condition
  block
  external label done
while {condition} {block} =>
  external label again
  external goto body condition
  external goto done
  external label body
  block
  external goto again
  external label done

// ---------------------------------------------------------------- the reader (spec/Reader.md R1, R2), handed reading at the end
learned := external learned
end := learned.end
space := learned.space
indent := learned.indent
access := learned.access
defining := learned.definer

// The place after `chain` spelled from `at`, or nothing. A space in it also reads a line end and the indentation that
// continues a statement (R0.1, as the first statement wrote its definer's space).
{at}.spelled({chain}) =>
  at.spells(chain, None)

// The same, for a chain that ends at `chain_end` (a literal written in a head).
{at}.spells({chain}, {chain_end}) =>
  here := at
  wanted := chain
  result := external node
  if wanted === chain_end
    wanted = None
  while wanted
    unless here
      result = None
      wanted = None
    if here
      c := here.character
      w := wanted.character
      matches := c === w
      continued := None
      unless matches
        if w === space && c === end
          continued = here.continuation
      if continued
        here = continued
        wanted = wanted.next
        matches = None
      if matches
        here = here.next
        wanted = wanted.next
      if wanted === chain_end
        wanted = None
      unless matches
        unless continued
          result = None
          wanted = None
  if result
    result.end = here
  result

// The place after a line end and one or more indentations, or nothing.
{at}.continuation =>
  here := at.next
  more := here.spelled(indent)
  found := None
  while more
    found = more.end
    more = found.spelled(indent)
  found

// Characters the reader names are taken from where they are written here.
written := external span "/()[]{}:.,`\n?^|
mark := written.from
// the text the reader is written in (code written in it reads with the reader's own rules)
reader_text := mark.text
// code written here, to read other code like it
reader_written := external ** None
reader_like := reader_written.code
quote := mark.character
mark = mark.next
slash := mark.character
mark = mark.next
opening := mark.character
mark = mark.next
closing := mark.character
mark = mark.next
opening_list := mark.character
mark = mark.next
closing_list := mark.character
mark = mark.next
opening_block := mark.character
mark = mark.next
closing_block := mark.character
mark = mark.next
colon := mark.character
mark = mark.next
dot := mark.character
mark = mark.next
comma := mark.character
mark = mark.next
backtick := mark.character
mark = mark.next
backslash := mark.character
mark = mark.next
letter_n := mark.character
mark = mark.next
question := mark.character
mark = mark.next
caret := mark.character
mark = mark.next
pipe := mark.character

// The bracket that closes `c`, or nothing when `c` opens none.
{c}.closer =>
  found := c === opening ? closing : None
  if c === opening_list
    found = closing_list
  if c === opening_block
    found = closing_block
  found

// Whether `c` closes a bracket.
{c}.closes =>
  found := c === closing ? true : None
  if c === closing_list
    found = true
  if c === closing_block
    found = true
  found

// Where the statement starting at `at` ends: the first line end not followed by a line deeper than `base` (R0.1), or `to`.
{at}.statement_end({to}, {base}) =>
  here := at
  found := to
  open_ones := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      // a statement goes on while a bracket it opened is open (quoted text holds none)
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if open_ones
          expected := open_ones.shut
          if c === expected
            open_ones = open_ones.next
        if c === quote
          skipping := here.next
          while skipping
            if skipping === to
              skipping = None
            if skipping
              d := skipping.character
              if d === end
                skipping = None
            if skipping
              if d === quote
                here = skipping
                skipping = None
              if skipping
                skipping = skipping.next
      ending := None
      unless open_ones
        if c === end
          ending = true
      if ending
        deeper := None
        next := here.next
        inside := next
        if base
          inside = None
          based := next.spelled(base)
          if based
            inside = based.end
        if inside
          deeper = inside.spelled(indent)
          // G2.13: a line the language's rules continue (`{\n}else …`) goes on with the statement above it
          unless deeper
            deeper = inside.continues_statement
        unless deeper
          found = here
          here = None
      if here
        here = here.next
  found

// Whether a line starting at `at` continues the statement above it (G2.13): it starts with what follows a line end in a rule's
// head (`{\n}else …`).
{at}.continues_statement =>
  found := None
  continuation := registry.continuations
  while continuation
    lit_from := continuation.from
    lit_to := continuation.to
    if at.spells(lit_from, lit_to)
      found = true
      continuation = None
    if continuation
      continuation = continuation.next
  found

// Whether `far` is reached walking from `at` without passing `limit` (what was read from `at` stays inside the statement).
{at}.reaches({far}, {limit}) =>
  here := at
  found := None
  going := true
  while going
    if here === far
      found = true
      going = None
    if going
      if here === limit
        going = None
      unless here
        going = None
    if going
      here = here.next
  found

// A reading of `pieces` from `at` that ends at `limit`: its `captures` (a chain of `name`, `from`, `to`), or nothing. A capture
// reads one or more characters, the longest first; one that crosses a line end runs to `limit`.
// The same, in a `mode`: nothing reads up to `limit`; a prefix reading (on a receiver, R2.1) may end anywhere before it,
// its last capture reading one operand.
{at}.readings({pieces}, {limit}, {mode}) =>
  found := None
  unless pieces
    ends_here := at === limit
    if mode
      ends_here = true
    if ends_here
      found = external node
      found.end = at
  if pieces
    literal := pieces.literal
    gap := pieces.gap
    line_end := pieces.line_end
    fixed := literal
    far := None
    if literal
      spelt := at.spells(pieces.from, pieces.to)
      if spelt
        far = spelt.end
    if gap
      fixed = true
      far = at.spaces_after
    if line_end
      fixed = true
      if at
        c := at.character
        if c === end
          // (and the indentation of the line after it)
          far = at.next
          indented := far.spaces_after
          if indented
            far = indented
    if far
      within := at.reaches(far, limit)
      if within
        found = far.readings(pieces.next, limit, mode)
    unless fixed
      found = at.captured(pieces, limit, mode)
  found

// The place after one or more spaces from `at`, or nothing when no space is there.
{at}.spaces_after =>
  here := at
  found := None
  while here
    c := here.character
    if c === space
      here = here.next
      found = here
      unless here
        here = None
    unless c === space
      here = None
  found

// The places a capture from `at` can end at, up to `limit`, as a chain of `place`s: where `wanted` is (the first character of
// the literal that follows it, or a line end for a space), anywhere when nothing is wanted; past a line end only `limit`.
// The longest first when `longest` (a leading capture), else the shortest, a line end before a space (G2.19: what is
// indented under a line is that line's argument).
{at}.ends({limit}, {wanted}, {longest}) =>
  first := None
  last := None
  here := at.next
  crossed := None
  going := true
  while going
    at_limit := here === limit
    keep := at_limit
    unless crossed
      keep = true
    c := here ? here.character : None
    if keep && wanted
      keep = None
      if c === wanted
        keep = true
      if wanted === space && c === end
        keep = true
    if keep
      link := external node
      link.place = here
      if longest
        link.next = first
        first = link
      unless longest
        if c === end
          link.next = first
          first = link
          unless last
            last = link
        unless c === end
          if last
            last.next = link
          unless last
            first = link
          last = link
    if at_limit
      going = None
    unless here
      going = None
    if going
      here = here.next
      // past a line end only `limit`
      if c === end
        crossed = true
        here = limit
  first

// The statement from `at` to `limit` indexed (R2.5, so a capture need not walk it for each rule): up to the first line end
// (a capture ends past it only at `limit`, where no literal after it can start) every character keeps the places it is at,
// latest first, and every place the next place of its character (`next_same`). Answers the index's stamp; what the
// characters and places keep is this statement's while their `stamp` is it. Made again when another statement was indexed
// since.
{at}.indexed({limit}) =>
  stamp := at.index
  fresh := None
  if stamp && stamp.to === limit
    if registry.indexed === stamp
      fresh = true
  unless fresh
    stamp = external node
    stamp.to = limit
    at.index = stamp
    registry.indexed = stamp
    // the pairs of characters in it (a node whose members are named by them)
    pairs := external node
    stamp.pairs = pairs
    here := at.next
    while here
      if here === limit
        here = None
      if here
        pair_end := here.next
        if pair_end
          pair_end = pair_end.next
          written_pair := external code here pair_end reader_like
          pair := written_pair.code
          external set pairs pair stamp
        c := here.character
        here.stamp = stamp
        here.next_same = None
        unless c.stamp === stamp
          c.stamp = stamp
          c.places = None
          c.last_at = None
        link := external node
        link.place = here
        link.next = c.places
        c.places = link
        previous := c.last_at
        if previous
          previous.next_same = here
        c.last_at = here
        here = here.next
        if c === end
          here = None
  stamp

// Whether the character at `this` follows `c` somewhere in the statement indexed with `stamp` (on its first line).
{this}.after({c}, {stamp}) =>
  found := None
  if c.stamp === stamp
    wanted := this.character
    places := c.places
    while places
      p := places.place
      n := p.next
      if n && n.character === wanted
        found = true
        places = None
      if places
        places = places.next
  found

// The first place from `this` on, on its line and before `limit`, holding the character `c`, or nothing.
{this}.first_of({c}, {limit}) =>
  // every character's first place from `this` on, found in one walk and kept on the characters until another place asks
  scan := registry.scan
  fresh := None
  if scan && scan.at === this
    if scan.limit === limit
      fresh = true
  unless fresh
    scan = external node
    scan.at = this
    scan.limit = limit
    registry.scan = scan
    here := this
    while here
      if here === limit
        here = None
      if here
        d := here.character
        unless d.scanned === scan
          d.scanned = scan
          d.first_from = here
        if d === end
          here = None
      if here
        here = here.next
  found := c.scanned === scan ? c.first_from : None
  found

// The last place from `this` before `limit` holding the character `c`, when it is past a line end; else nothing. Walked back from
// `limit` (a text is a ray both ways), then the first line from `this` checked not to hold it.
{this}.last_of({c}, {limit}) =>
  // from a place on the first line of the statement indexed last, the same for every such place: found once per character
  stamp := registry.indexed
  on_first_line := None
  if stamp.to === limit && this.stamp === stamp
    on_first_line = true
  if on_first_line
    unless c.late_stamp === stamp
      c.late_stamp = stamp
      c.late = None
      line_end := None
      if end.stamp === stamp
        ends := end.places
        line_end = ends.place
      going := None
      if line_end
        going = limit ? limit.previous : this.text.last
      while going
        if going === line_end
          going = None
        if going
          if going.character === c
            c.late = going
            going = None
          if going
            going = going.previous
  late_found := c.late
  back := limit ? limit.previous : this.text.last
  found := None
  here := this
  if on_first_line
    back = None
    here = None
    found = late_found
  while back
    if back === this
      back = None
    if back
      if back.character === c
        found = back
        back = None
      if back
        back = back.previous
  if found
    while here
      if here === found
        found = None
        here = None
      if here && here.character === end
        here = None
      if here
        here = here.next
  found

// Whether the places from `at` to `limit` close every bracket they open, in order, and none they did not (quoted text skipped).
{at}.balanced_to({limit}) =>
  // its two ends see the same open brackets (counted once over the whole text)
  known := None
  if limit
    text := at.text
    unless text.stacked
      text.stacked = true
      first_of_text := text.first
      first_of_text.bracket_stacks
    if at.stack && limit.stack
      known = true
  found := known ? at.stack === limit.stack : at.balanced_walk(limit)
  found

// The brackets open before each place from `this` on, as a chain (one opened: a new link; one closed: the link before it), so a
// span is balanced when its two ends see the same link (a bracket closing what it did not open: a link of its own).
{this}.bracket_stacks =>
  open_ones := external node
  here := this
  while here
    here.stack = open_ones
    c := here.character
    shut := c.closer
    if shut
      pushed := external node
      pushed.shut = shut
      pushed.next = open_ones
      open_ones = pushed
    unless shut
      if c.closes
        expected := open_ones.shut
        open_ones = c === expected ? open_ones.next : external node
      if c === quote
        skipping := here.next
        while skipping
          skipping.stack = open_ones
          d := skipping.character
          if d === quote
            here = skipping
            skipping = None
          if d === end
            here = skipping
            skipping = None
          if skipping
            skipping = skipping.next
    if here
      here = here.next
  this

// The same, walked.
{at}.balanced_walk({limit}) =>
  open_ones := None
  here := at
  ok := true
  while here
    if here === limit
      here = None
    if here
      c := here.character
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if c.closes
          was_open := open_ones
          if was_open
            expected := open_ones.shut
            if c === expected
              open_ones = open_ones.next
            unless c === expected
              ok = None
              here = None
          unless was_open
            ok = None
            here = None
        if c === quote
          skipping := here.next
          while skipping
            if skipping === limit
              skipping = None
            if skipping
              d := skipping.character
              if d === quote
                here = skipping
                skipping = None
              if skipping
                skipping = skipping.next
      if here
        here = here.next
  if open_ones
    ok = None
  ok

// The places from `this` to `limit` marked as the language's text.
{this}.stamped_language({limit}) =>
  here := this
  while here
    if here === limit
      here = None
    if here
      here.language = true
      here = here.next
  this

// Whether a capture can end at `here` when `wanted` follows it (as `ends` keeps them).
{here}.can_end({wanted}) =>
  found := true
  if wanted
    found = None
    if here
      c := here.character
      if c === wanted
        found = true
      if wanted === space && c === end
        found = true
  found

// Whether `type` holds the places from `from` to `to`: its check, when it has one, else its own rules reading them whole.
{kind}.holds({from}, {to}) =>
  check := kind.check
  found := None
  if check
    // the captures, given as values in the order the check's head names them
    to_given := external node
    to_given.value = to
    from_given := external node
    from_given.value = from
    from_given.next = to_given
    given := external node
    given.value = kind
    given.next = from_given
    here := external .
    found = external apply check given here
  unless check
    own := kind.rules
    found = from.reading(to, own)
  found

{at}.captured({pieces}, {limit}, {mode}) =>
  name := pieces.capture
  rest_pieces := pieces.next
  // a capture holds something unless it may hold nothing
  nothing_left := at === limit
  if nothing_left && pieces.optional
    nothing_left = None
  // a type written that was not defined then: read again now (nothing read: the capture holds nothing)
  // (not while another type is being read: reading one does not read types again)
  // (tried once per text read: in one where it was not defined, it stays undefined)
  unless pieces.type
    if pieces.type_from
      read_type := None
      tried_in := at.text
      if pieces.type_tried === tried_in
        registry.reading_type_skipped = true
      unless pieces.type_tried === tried_in
        registry.reading_type_skipped = None
      if registry.reading_type
        registry.reading_type_skipped = true
      unless registry.reading_type_skipped
        pieces.type_tried = tried_in
        registry.reading_type = true
        written_type_from := pieces.type_from
        written_type_to := pieces.type_to
        written_type_like := pieces.type_like
        read_type = external read written_type_from written_type_to written_type_like
        registry.reading_type = None
      if read_type
        pieces.type = read_type
      unless read_type
        nothing_left = true
  // a capture followed by a literal ends only where that literal starts
  wanted := None
  if rest_pieces && rest_pieces.literal
    wanted = rest_pieces.from.character
  ends := None
  same := None
  indexed := None
  // a leading capture with a literal after it: the places that literal can start at, from the statement's index
  if pieces.leading && wanted
    unless pieces.optional
      stamp := at.indexed(limit)
      if wanted.stamp === stamp
        ends = wanted.places
      if wanted === space && end.stamp === stamp
        line_end := end.places
        at_line_end := external node
        at_line_end.place = line_end.place
        at_line_end.next = ends
        ends = at_line_end
      indexed = true
  // any other with a literal after it: the places from `at` where that literal starts, the shortest first (a line end first,
  // G2.19), on the line `at` is on in the statement indexed last (when it was indexed up to the same `limit`)
  unless indexed
    if wanted
      unless pieces.leading
        unless pieces.optional
          stamp := registry.indexed
          first_place := stamp.to === limit ? at.next : None
          if first_place && first_place.stamp === stamp
            indexed = true
            same = first_place.first_of(wanted, limit)
            if wanted === space && end.stamp === stamp
              line_end := end.places
              at_line_end := external node
              at_line_end.place = line_end.place
              ends = at_line_end
  // the last piece of a head read whole ends where the statement does
  unless rest_pieces
    unless mode
      unless at === limit
        ends = external node
        ends.place = limit
        indexed = true
  // a typed capture ending a head read on a receiver reads as far as its type allows: the longest first
  longest := pieces.leading
  if mode
    unless rest_pieces
      if pieces.type
        longest = true
  unless indexed
    ends = at.ends(limit, wanted, longest)
  // read on a receiver, a capture that ends the head reads one operand (from where it starts, after spaces)
  capture_from := at
  operand_only := None
  if mode
    unless rest_pieces
      unless pieces.type
        operand_only = true
      // (after spaces)
      spaced_from := at.spaces_after
      if spaced_from
        capture_from = spaced_from
  if operand_only
    unless rest_pieces
      ends = None
      operand_at := at.spaces_after
      unless operand_at
        operand_at = at
      capture_from = operand_at
      operand := operand_at.operand_end(limit)
      if operand
        ends = external node
        ends.place = operand
  // an optional capture may hold nothing: tried after every other end
  optional := pieces.optional ? at.can_end(wanted) : None
  if optional
    empty := external node
    empty.place = at
    tail := ends
    unless tail
      ends = empty
    while tail
      following := tail.next
      unless following
        tail.next = empty
      tail = following
  // past a line end, the last place the literal after it starts at before `limit` too (a bracket closing on a later line)
  late := None
  if wanted
    unless pieces.leading
      late = true
  piece_type := pieces.type
  found := None
  going := true
  if nothing_left
    going = None
  while going
    // the next end: from the chain `ends`, then the places of the wanted character (`same`), then `late`
    e := None
    worth := None
    if ends
      e = ends.place
      worth = true
      ends = ends.next
    unless worth
      if same
        e = same
        worth = true
        same = same.next_same
    unless worth
      if late
        late = None
        e = at.last_of(wanted, limit)
        if e
          worth = true
    unless worth
      going = None
    if worth
      if piece_type
        unless at === e
          worth = piece_type.holds(at, e)
      // what a capture holds is balanced: it closes every bracket it opens, and none it did not (the last piece runs to the
      // statement's end, which is)
      unless piece_type
        if rest_pieces
          worth = at.balanced_to(e)
    // a capture taken as written takes one word when what follows it is no literal (it ends the head, or another capture does)
    if worth && pieces.raw
      bounded := rest_pieces ? rest_pieces.literal : None
      unless bounded
        if at.spaced(e)
          worth = None
    rest := worth ? e.readings(rest_pieces, limit, mode) : None
    if rest
      cap := external node
      cap.name = name
      cap.piece = pieces
      if piece_type
        cap.type = piece_type
      raw := pieces.raw
      if raw
        cap.raw = true
      cap.from = capture_from
      cap.to = e
      earlier := rest.captures
      cap.next = earlier
      rest.captures = cap
      found = rest
      going = None
  found

// Where the reader keeps what it knows of its rules: the `latest` defined, and the `definer` (the first statement's rule).
registry := external node

// The scope the reader is read in: the top.
top := external .

// The rules in reach of `scope`: each scope's `rules`, nearest scope first (its parents through `parent`), latest first;
// stopping before the scope `outside` (a value's own rules and its classes', not the top scope's).
// Code written in the reader's text (`internal`) reads with the reader's own rules, other code with the language's (R4.2b); a
// rule of both is `shared`.
{scope}.rules_in_reach({outside}, {internal}) =>
  first := None
  last := None
  here := scope
  if here === outside
    here = None
  while here
    links := here.rules
    while links
      r := links.rule
      keep := true
      if internal
        if r.language
          keep = None
      unless internal
        if r.internal
          unless r.shared
            keep = None
      if keep
        link := external node
        link.rule = r
        if last
          last.next = link
        unless last
          first = link
        last = link
      links = links.next
    // past the value, only the classes it is in: not the scopes they were written in
    here = here.outer
    if here === outside
      here = None
    if here
      unless here.class
        here = None
  first

// Whether one of `pieces` is a literal spelling the definer (learned from the first statement).
{pieces}.spells_the_definer =>
  piece := pieces
  found := None
  while piece
    if piece.literal
      lit_from := piece.from
      lit_to := piece.to
      if lit_from.spells_chain(lit_to, defining)
        found = true
        piece = None
    if piece
      piece = piece.next
  found

// Whether the places from `from` to `to` spell the chain `chain` (which ends by itself).
{from}.spells_chain({to}, {chain}) =>
  here := from
  wanted := chain
  result := true
  going := true
  while going
    here_done := here === to
    unless wanted
      going = None
      unless here_done
        result = None
    if going && here_done
      going = None
      result = None
    if going
      c := here.character
      w := wanted.character
      unless c === w
        result = None
        going = None
      if going
        here = here.next
        wanted = wanted.next
  result

// Whether the chain `a` has more pieces than the chain `b` (walked side by side: there are no integers).
{a}.longer_than({b}) =>
  x := a
  y := b
  going := true
  while going
    unless x
      going = None
    unless y
      going = None
    if going
      x = x.next
      y = y.next
  result := None
  if x
    unless y
      result = true
  result

// Whether two rules are written with the same head (their heads spell the same).
{a}.alike({b}) =>
  x := a.head_from
  x_end := a.head_to
  y := b.head_from
  y_end := b.head_to
  result := true
  going := true
  while going
    x_done := x === x_end
    y_done := y === y_end
    if x_done
      going = None
      unless y_done
        result = None
    if going && y_done
      going = None
      result = None
    if going
      c := x.character
      d := y.character
      unless c === d
        result = None
        going = None
      if going
        x = x.next
        y = y.next
  result

// Whether the head `pieces` is more particular than the head `other` (R2.5): walked side by side, character by character, at
// the first place where one has a literal and the other a capture, the one with the literal.
{pieces}.more_particular({other}) =>
  x := pieces
  y := other
  x_at := None
  y_at := None
  found := None
  going := true
  while going
    unless x
      going = None
    unless y
      going = None
    if going
      x_open := x.capture
      y_open := y.capture
      if x_open
        if y_open
          x = x.next
          y = y.next
        unless y_open
          going = None
      unless x_open
        if y_open
          found = true
          going = None
        unless y_open
          x_literal := x.literal
          y_literal := y.literal
          unless x_literal
            going = None
          unless y_literal
            going = None
          if going
            unless x_at
              x_at = x.from
            unless y_at
              y_at = y.from
            c := x_at.character
            d := y_at.character
            unless c === d
              going = None
          if going
            x_at = x_at.next
            y_at = y_at.next
            x_to := x.to
            y_to := y.to
            if x_at === x_to
              x = x.next
              x_at = None
            if y_at === y_to
              y = y.next
              y_at = None
  found

// Whether a reading by the head `pieces` is taken over one by the head `other` that reads as much (R2.5): the more particular;
// between two led by a literal, the one with more pieces; otherwise as `taken` says (by the order they were declared in).
{pieces}.chosen_over({other}, {taken}) =>
  chosen := taken
  more := pieces.more_particular(other)
  less := other.more_particular(pieces)
  if more
    chosen = true
  if less
    chosen = None
  unless more
    unless less
      if pieces.literal && other.literal
        if pieces.longer_than(other)
          chosen = true
        if other.longer_than(pieces)
          chosen = None
  chosen

// What reads the statement from `at` to `limit` with the rules in reach of `scope` (R2.5): every rule that reads it whole;
// between them, one led by a literal over one led by a capture; then one written with the same head as a later one gives way
// to it (`=>`), otherwise the one declared first reads it (G3.1). The rules come nearest scope first, latest first. Answers
// a node with the `rule` and its `captures`, or nothing.
{at}.reading_in({limit}, {scope}) =>
  written_here := at.text === reader_text
  // the entrypoint's text after the reader is the language's (read with its rules)
  if at.language
    written_here = None
  // the statement indexed once: the rules led by a literal starting with its first character, and those led by a capture whose
  // literal after it is in it, scope by scope (R2.5)
  stamp := at.indexed(limit)
  at_next := at.next
  written_key := external code at at_next reader_like
  key := written_key.code
  state := external node
  here := scope
  while here
    led := here.led
    candidates := led ? external get led key : None
    while candidates
      rule := candidates.rule
      if rule.visible(written_here)
        at.considered(rule, limit, state)
      candidates = candidates.next
    capture_led := here.capture_led
    while capture_led
      rule := capture_led.rule
      keep := true
      if written_here
        if rule.language
          keep = None
      unless written_here
        if rule.internal
          unless rule.shared
            keep = None
      if keep
        unless registry.indexed === stamp
          stamp = at.indexed(limit)
        w := rule.key_character
        if w
          unless w.stamp === stamp
            keep = None
            if w === space && end.stamp === stamp
              keep = true
          // and its first two characters together in it
          if keep
            written_pair := rule.key_pair
            if written_pair
              pair := written_pair.code
              pairs := stamp.pairs
              seen := external get pairs pair
              unless seen === stamp
                keep = None
                if w === space && end.stamp === stamp
                  keep = true
      if keep
        at.considered(rule, limit, state)
      capture_led = capture_led.next
    here = here.outer
  best := state.best
  if best
    best.rule = state.rule
  best

// Whether a rule is read with by code written in the reader's text (`written_here`), or by other code (R4.2b).
{rule}.visible({written_here}) =>
  found := true
  if written_here
    if rule.language
      found = None
  unless written_here
    if rule.internal
      unless rule.shared
        found = None
  found

{at}.reading({limit}, {rules}) =>
  state := external node
  while rules
    rule := rules.rule
    at.considered(rule, limit, state)
    rules = rules.next
  best := state.best
  if best
    best.rule = state.rule
  best

// A rule's reading of the statement from `at` to `limit`, taken into `state` (its `best` reading and that reading's `rule`) when it
// reads the statement whole and is chosen over the best so far (R2.5).
{at}.considered({rule}, {limit}, {state}) =>
  pieces := rule.pieces
  r := at.readings(pieces, limit, None)
  if r
    take := true
    best := state.best
    if best
      best_rule := state.rule
      best_pieces := best_rule.pieces
      if rule.alike(best_rule)
        take = None
      take = pieces.chosen_over(best_pieces, take)
      // the rule that defines rules reads a definition whole, unless the other spells the definer itself (2026-10-06: a
      // method head with parameters is read by the rule written with the definer in it, not as a rule of that name)
      rule_defines := rule.defines
      best_defines := best_rule.defines
      if rule_defines
        unless best_defines
          take = true
          if best_pieces.spells_the_definer
            take = None
      if best_defines
        unless rule_defines
          take = None
          if pieces.spells_the_definer
            take = true
    if take
      state.best = r
      state.rule = rule
  state

// What reads the most of the text from `at` before `limit` among `rules`, read on a receiver (R2.1): its `rule`, `captures` and
// `end`. Between readings that end at the same place, as `reading from … among` chooses.
{at}.prefix_reading({limit}, {rules}) =>
  best := None
  best_rule := None
  while rules
    rule := rules.rule
    pieces := rule.pieces
    r := at.readings(pieces, limit, true)
    if r
      take := true
      if best
        far := r.end
        best_far := best.end
        take = None
        unless far === best_far
          if best_far.reaches(far, limit)
            take = true
        if far === best_far
          take = true
          best_pieces := best_rule.pieces
          if rule.alike(best_rule)
            take = None
          take = pieces.chosen_over(best_pieces, take)
      if take
        best = r
        best_rule = rule
    rules = rules.next
  if best
    best.rule = best_rule
  best

// Whether the places from `at` to `limit` hold a space.
{at}.spaced({limit}) =>
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === space
        found = true
        here = None
      if here
        here = here.next
  found

// One statement of a body, as a step (R0.4): a call of an external (`access name arguments…`), a rule with its captures, one
// word, or what nothing reads.
{at}.step({limit}, {scope}) =>
  made := external node
  made.from = at
  made.to = limit
  led := at.spelled(access)
  called := None
  if led
    after := led.end
    c := after.character
    if c === space
      called = after.next
  if called
    made.external = true
    words := called.words(limit)
    first := words.from
    made.name_from = first
    made.name_to = words.to
    rest := words.next
    made.arguments = rest
  unless called
    // a statement led by a word naming a class: the class's own rules read what follows first (class-rule dispatch)
    dispatched := at.class_dispatch(limit, scope)
    r := None
    unless dispatched
      r = at.reading_in(limit, scope)
    if r
      rule := r.rule
      made.rule = rule
      caps := r.captures
      made.captures = caps
    unless r
      // what no rule in reach reads whole: its first operand, read when it runs, and the rest read by that value's rules
      split := at.operand_end(limit)
      // (a word naming nothing: the longest start of it that names something, the rest read by that (`Colour#`))
      if split === limit
        split = at.held_prefix(limit, scope)
      sending := None
      if split
        unless split === limit
          sending = registry.sender
      if sending
        sender := registry.sender
        made.rule = sender
        pieces := sender.pieces
        receiver_piece := pieces
        rest_piece := receiver_piece.next
        rest_piece = rest_piece.next
        rest_cap := external node
        rest_cap.piece = rest_piece
        rest_cap.from = split
        rest_cap.to = limit
        rest_cap.raw = true
        receiver_cap := external node
        receiver_cap.piece = receiver_piece
        receiver_cap.from = at
        receiver_cap.to = split
        receiver_cap.next = rest_cap
        made.captures = receiver_cap
      unless sending
        unless at.spaced(limit)
          made.word = true
          // (in the language's code, a name is read by the rule that also asks the `this` it is read for)
          bare := registry.bare_rule
          if at.text === reader_text
            bare = at.language ? bare : None
          if registry.bare_reporting
            bare = None
          if bare
            made.word = None
            made.rule = bare
            bare_cap := external node
            bare_cap.piece = bare.pieces
            bare_cap.from = at
            bare_cap.to = limit
            bare_cap.raw = true
            made.captures = bare_cap
  made

// Whether the statement from `at` to `limit` starts with a word naming a class (a value with rules of its own) whose own rules read
// what follows it: then they read it, before any rule reads the statement whole.
{at}.class_dispatch({limit}, {scope}) =>
  found := None
  // (the reader's own text is read by its rules alone: no class's)
  split := None
  written_here := at.text === reader_text
  if at.language
    written_here = None
  unless written_here
    split = at.operand_end(limit)
  if split
    unless split === limit
      written_name := external code at split reader_like
      leading_name := written_name.code
      here := scope
      value := None
      while here
        if external own here leading_name
          value = external get here leading_name
          here = None
        if here
          here = here.outer
      // (code held by a frame, read only when it is used, is no class)
      held_code := external span value
      if held_code
        value = None
      if value && value.class
        own_rules := value.rules
        if own_rules
          rest_at := split
          r := rest_at.prefix_reading(limit, own_rules)
          unless r
            spaced := rest_at.spaces_after
            if spaced
              r = spaced.prefix_reading(limit, own_rules)
          // (only a reading of all of the rest: `X := …` is the declaration's, not X's)
          if r && r.end === limit
            found = true
  found

// Where the first operand from `at` ends: after a bracketed group, quoted text, or a word (up to a space, a bracket or a
// dot). Nothing when there is none.
{at}.operand_end({limit}) =>
  c := at.character
  found := None
  shut := c.closer
  if shut
    found = at.balanced_end(limit)
  unless shut
    if c === quote
      here := at.next
      while here
        if here === limit
          here = None
        if here
          d := here.character
          if d === quote
            found = here.next
            here = None
          if here
            here = here.next
  unless found
    unless shut
      unless c === quote
        here = at
        while here
          stop := here === limit
          unless stop
            d = here.character
            if d === space
              stop = true
            if d.closer
              stop = true
            if d === dot
              stop = true
          unless stop
            unless here === at
              stop = here.starts_a_base_rule
          if stop
            unless here === at
              found = here
            here = None
          if here
            here = here.next
  found

// Whether one of the base's rules (what every value has: `Node`'s operators) starts with a literal spelled at `at`: an
// operand ends there (the operators the language defines decide where a word ends).
{at}.starts_a_base_rule =>
  base := registry.base
  found := None
  if base
    links := base.rules
    while links
      rule := links.rule
      pieces := rule.pieces
      if pieces.literal && at.spells(pieces.from, pieces.to)
        found = true
        links = None
      if links
        links = links.next
  found

// The place after the bracket that closes the one at `at`.
{at}.balanced_end({limit}) =>
  open_ones := None
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if open_ones
          expected := open_ones.shut
          if c === expected
            open_ones = open_ones.next
            unless open_ones
              found = here.next
              here = None
      if here
        here = here.next
  found

// The words from `at` to `limit`, separated by spaces: a chain of `from`, `to`.
{at}.words({limit}) =>
  first := None
  last := None
  here := at
  start := at
  while here
    stop := here === limit
    unless stop
      c := here.character
      if c === space
        stop = true
    if stop
      unless start === here
        word := external node
        word.from = start
        word.to = here
        if last
          last.next = word
        unless last
          first = word
        last = word
      if here === limit
        here = None
      if here
        here = here.next
        start = here
    // (what brackets hold is one word: `(external span x).from`)
    unless stop
      shut := c.closer
      here = shut ? here.balanced_end(limit) : here.next
  first

// The first place from `at` that is not a space, a line end or a comment (`//` to the line's end, skipped before any rule
// reads it: comments say anything, definitions included), or nothing before `to`.
{at}.skip_blank({to}) =>
  here := at
  found := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      skip := c === space ? true : None
      if c === end
        skip = true
      if c === slash
        following := here.next
        if following
          f := following.character
          if f === slash
            skip = true
            going := true
            while going
              following = here.next
              unless following
                going = None
              if following === to
                going = None
              if going
                d := following.character
                if d === end
                  going = None
              if going
                here = following
      unless skip
        found = here
        here = None
      if here
        here = here.next
  found

// The statements of a body from `from` to `to`, each at the body's indentation `base`: a chain of steps.
{from}.plan({to}, {base}, {scope}) =>
  first := None
  last := None
  at := from
  while at
    if at === to
      at = None
    if at
      at = at.skip_blank(to)
    if at
      limit := at.statement_end(to, base)
      // the last statement of a body ends where its last word does (`{ a }`)
      read_to := limit
      if limit === to
        read_to = at.trimmed(to)
      made := at.step(read_to, scope)
      if last
        last.next = made
      unless last
        first = made
      last = made
      at = None
      if limit
        unless limit === to
          at = limit.next
          if base
            based := at.spelled(base)
            if based
              at = based.end
      // after a definition, the rest is read once it has run (what it defines may read it)
      if at
        read_by := made.rule
        if read_by && read_by.defines
          made.rest = at
          at = None
  first

// Bodies are planned by the rule defined last (R0.6), once the seed's rules are the reader's.
planned_by := external rules top
plan_rule := planned_by.rule

// ---------------------------------------------------------------- heads read in Ray (R2.2)
open := learned.open
close := learned.close

// The place of the bracket that closes one opened just before `at`, or nothing when another opens first or none closes.
{at}.closing({limit}) =>
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === open
        here = None
      if here && c === close
        found = here
        here = None
      if here
        here = here.next
  found

// A piece of a head, added to the chain `into` (a node with `first` and `last`).
{into}.add({kind}, {piece_from}, {piece_to}) =>
  made := external node
  made.from = piece_from
  made.to = piece_to
  external set made kind true
  last := into.last
  if last
    last.next = made
  unless last
    into.first = made
  into.last = made

// The pieces of a head: a capture is the brackets around a name (its first word), brackets around brackets are literal,
// the rest is literal. A chain of `literal`/`capture`, each with `from` and `to`.
{head_from}.pieces({head_to}, {like}) =>
  into := external node
  at := head_from
  start := head_from
  while at
    if at === head_to
      at = None
    if at
      c := at.character
      captured := None
      if c === open
        inner := at.next
        shut := inner.closing(head_to)
        if shut
          unless inner === shut
            captured = true
      // brackets holding no capture, ending the head: its parameters (one argument, bound as `(parameters) := arguments`)
      parameters := None
      if c === opening
        group_end := at.balanced_end(head_to)
        if group_end === head_to
          parameters = at.unbraced(head_to)
          inner_parameters := at.next
          close_parameters := inner_parameters.last_place(head_to)
          // `()`: none
          if inner_parameters === close_parameters
            inner_parameters = None
      if captured
        unless start === at
          into.add(literal, start, at)
        inner.held(shut, into, like)
        at = shut.next
        start = at
      if parameters
        // the literal before them ends where its last word does
        literal_end := start.trimmed(at)
        unless start === literal_end
          into.add(literal, start, literal_end)
        into.add(capture, arguments_from, arguments_to)
        made := into.last
        made.optional = true
        made.arguments = true
        // its arguments are one argument (what brackets hold, or an operand with what accesses it)
        made.type = Argument
        if inner_parameters
          made.parameters = external code inner_parameters close_parameters like
        at = None
        start = head_to
      unless captured
        if at
          at = at.next
  unless start === head_to
    into.add(literal, start, head_to)
  into.first

// The place after the last place from `from` before `to` that is not a space (`to` itself when none is).
{from}.trimmed({to}) =>
  here := from
  found := from
  while here
    if here === to
      here = None
    if here
      c := here.character
      here = here.next
      unless c === space
        found = here
  found

// The piece of a head that is its parameters, or nothing.
{pieces}.parameters_piece =>
  piece := pieces
  found := None
  while piece
    if piece.arguments
      found = piece
    piece = piece.next
  found

// Whether the places from `at` to `limit` hold no capture's bracket.
{at}.unbraced({limit}) =>
  here := at
  found := true
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === open
        found = None
        here = None
      if here
        here = here.next
  found

// What a capture's brackets hold (R2.2): spaces only, a gap; `\n`, a line end; text in backticks, a literal; `literal`
// and a name, a capture taken as written; a name ending in `?`, a capture that may hold nothing; a name ending in `:` and a
// type, a typed capture (the type read once, here). Anything after the name (`^style`) is the highlighting's.
{inner}.held({shut}, {into}, {like}) =>
  c := inner.character
  done := None
  if c === space
    rest := inner.spaces_after
    if rest === shut
      into.add(gap, inner, shut)
      done = true
  unless done
    if c === backtick
      lit_from := inner.next
      lit_to := lit_from.closing_backtick(shut)
      if lit_to
        into.add(literal, lit_from, lit_to)
        done = true
  unless done
    if c === backslash
      n := inner.next
      d := n.character
      if d === letter_n
        after_n := n.next
        if after_n === shut
          into.add(line_end, inner, shut)
          done = true
  unless done
    name_from := inner
    name_end := inner.word_end(shut)
    raw := None
    if name_from.spells_word(raw_word, name_end)
      unless name_end === shut
        raw = true
        name_from = name_end.next
        name_end = name_from.word_end(shut)
    last_char := name_from.last_place(name_end)
    l := last_char.character
    optional := l === question ? true : None
    typed := name_from.typed_name(name_end)
    bare := name_end
    if optional
      bare = last_char
    if typed
      bare = typed.name_end
    leading := None
    unless into.first
      leading = true
    into.add(capture, name_from, bare)
    made := into.last
    if raw
      made.raw = true
    if optional
      made.optional = true
    if leading
      made.leading = true
    if typed
      type_from := name_end.next
      capture_type := external read type_from shut like
      made.type = capture_type
      // (a type not defined yet is read again when the capture is tried; until it is, the capture holds nothing)
      unless capture_type
        made.type_from = type_from
        made.type_to = shut
        external keep made type_like like

// The place of the backtick that closes one, from `at`, before `limit`.
{at}.closing_backtick({limit}) =>
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === backtick
        found = here
        here = None
      if here
        here = here.next
  found

// The last place from `at` before `limit`.
{at}.last_place({limit}) =>
  here := at
  found := at
  while here
    if here === limit
      here = None
    if here
      found = here
      here = here.next
  found

// Whether the places from `at` to `limit` spell the word written from `word . from` to `word . to`.
{at}.spells_word({word}, {limit}) =>
  x := word.from
  x_end := word.to
  y := at
  result := true
  going := true
  while going
    x_done := x === x_end
    y_done := y === limit
    if x_done
      going = None
      unless y_done
        result = None
    if going && y_done
      going = None
      result = None
    if going
      c := x.character
      d := y.character
      unless c === d
        result = None
        going = None
      if going
        x = x.next
        y = y.next
  result

// Where the word from `at` ends: at a space, or at `limit`.
{at}.word_end({limit}) =>
  here := at
  found := limit
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === space
        found = here
        here = None
      if here
        here = here.next
  found

// A capture's name written with its type (`{d: Digit}`): the name ends before the colon. Answers a node with `name_end`, or nothing.
raw_word := external span literal
{at}.typed_name({limit}) =>
  here := at
  before := None
  while here
    if here === limit
      here = None
    if here
      before = here
      here = here.next
  found := None
  if before
    c := before.character
    if c === colon
      found = external node
      found.name_end = before
  found

// A rule kept where it reads rules: on its scope's `rules`, latest first; the registry's `latest`.
{made}.keep =>
  scope := made.scope
  link := external node
  link.rule = made
  earlier := scope.rules
  link.next = earlier
  scope.rules = link
  registry.latest = made
  if registry.language
    made.language = true
  made.dispatched
  // a head starting with a line end continues the statement above (G2.13): what follows it, kept
  pieces := made.pieces
  if pieces.line_end
    following := pieces.next
    if following && following.literal
      continuation := external node
      continuation.from = following.from
      continuation.to = following.to
      continuation.next = registry.continuations
      registry.continuations = continuation
  made

// A rule kept where reading looks it up (R2.5): one led by a literal under its first character in its scope's `led` (a node whose
// members are named by characters), one led by a capture on its scope's `capture_led`; latest first in each.
{made}.dispatched =>
  scope := made.scope
  pieces := made.pieces
  if pieces.literal
    lit_from := pieces.from
    lit_next := lit_from.next
    written_key := external code lit_from lit_next reader_like
    key := written_key.code
    led := scope.led
    unless led
      led = external node
      scope.led = led
    entry := external node
    entry.rule = made
    earlier := external get led key
    entry.next = earlier
    external set led key entry
  unless pieces.literal
    link := external node
    link.rule = made
    link.next = scope.capture_led
    scope.capture_led = link
    // the literal after the capture: its first character, and its first two
    second := pieces.next
    if second && second.literal
      second_from := second.from
      made.key_character = second_from.character
      second_next := second_from.next
      unless second_next === second.to
        if second_next
          pair_end := second_next.next
          written_pair := external code second_from pair_end reader_like
          made.key_pair = written_pair
  made

// The seed's rules, taken over once: the top scope's, latest first; the earliest is the first statement's.
take_over_the_seeds_rules =>
  imported := external rules top
  top.rules = imported
  registry.top = top
  last := imported
  while last
    first_statement := last.rule
    last = last.next
  registry.definer = first_statement
  registry.latest = imported.rule
  // dispatched earliest first, so each scope's lists are latest first
  reversed := None
  link := imported
  while link
    back := external node
    back.rule = link.rule
    back.next = reversed
    reversed = back
    link = link.next
  while reversed
    taken := reversed.rule
    taken.dispatched
    reversed = reversed.next

// A type: a scope of the rules its block defines (R2.3).
type {block} =>
  made := external node
  external apply block None made
  made

// The last link of a chain.
{pieces}.last_piece =>
  piece := pieces
  while piece.next
    piece = piece.next
  piece

// The class a value is an instance of (or the class itself) that extends another: what it extends, or nothing.
{value}.extended_class =>
  here := value
  found := None
  while here
    if here.extends
      found = here.extends
      here = None
    if here
      here = here.outer
  found

// The rules a value is read by (R2.1): its own and its classes' (not the top scope's), then what every value has.
{value}.reading_rules =>
  top := registry.top
  rules := value.rules_in_reach(top, None)
  // a class's parent's rules after its own
  ancestor := value.extended_class
  while ancestor
    more := ancestor.rules_in_reach(top, None)
    if more
      if rules
        last := rules.last_piece
        last.next = more
      unless rules
        rules = more
    ancestor = ancestor.extends
  base := registry.base
  base_rules := base.rules
  if rules
    last := rules
    while last
      following := last.next
      unless following
        last.next = base_rules
      last = following
  unless rules
    rules = base_rules
  rules

// The place the longest start of the word from `at` to `limit` that names something held where it is read ends at; or nothing.
{at}.held_prefix({limit}, {scope}) =>
  found := None
  here := at.next
  // (none when the whole word names something)
  written_whole := external code at limit reader_like
  whole := written_whole.code
  frame_whole := scope
  while frame_whole
    if external own frame_whole whole
      here = None
      frame_whole = None
    if frame_whole
      frame_whole = frame_whole.outer
  while here
    if here === limit
      here = None
    if here
      written_name := external code at here reader_like
      name := written_name.code
      frame := scope
      while frame
        if external own frame name
          // (only where what it names reads the rest by its own rules)
          held := external get frame name
          held_code := external span held
          unless held_code
            if held
              held_rules := held.reading_rules
              r := here.prefix_reading(limit, held_rules)
              if r && r.end === limit
                found = here
          frame = None
        if frame
          frame = frame.outer
      here = here.next
  found

// Rules defined from here on are read by their heads in Ray.
{pattern} => {body} =>
  where := external span pattern
  pieces := where.from.pieces(where.to, pattern)
  made := external define pattern pieces body
  made.keep

take_over_the_seeds_rules
external planner plan_rule
// (what a definition is read by: a body's statements after one are read once it has run, with what it defined in reach)
reader_definer := registry.latest
reader_definer.defines = true
seed_definer := registry.definer
seed_definer.defines = true

// One statement read at the top: applied in place, or reported. Answers the place after it.
{given}.read_statement =>
  here := external .
  // (no construction is under way at the top: one that failed left its arguments behind)
  registry.given = None
  registry.naming = None
  // the scope read in applies the reader; the language's text and a project's files are read inside the language's scope
  scope := here.caller_frame
  if registry.language_text
    if scope === top
      scope = registry.language_scope
    // (a scope directly in the top; one inside another project's scope sees the language through it)
    unless scope === registry.language_scope
      if scope.outer === top
        scope.outer = registry.language_scope
  at := given.skip_blank(None)
  limit := at ? at.statement_end(None, None) : None
  // past the reader, the entrypoint's own statements are the language's: their places say so
  if registry.language_text && at
    at.stamped_language(limit)
  if at
    made := at.step(limit, scope)
    rule := made.rule
    if rule
      caps := made.captures
      external apply rule caps scope
    unless rule
      // a call of an external (`external name arguments`): run as code, in the scope read in
      if made.external
        statement := external code at limit reader_like
        statement_code := statement.code
        external apply statement_code None scope
      unless made.external
        external report at limit
  // a class made or added to: the programs waiting run again (P5.1), once the statement has run
  if registry.classes_changed
    registry.classes_changed = None
    registry.rerun_waiting
  after := limit ? limit.next : None
  after

reader := registry.latest
external reader reader

// ---------------------------------------------------------------- values with rules of their own (R2.1: a rule is a method)
// What a statement's first operand is read as, when no rule in reach reads it whole: the rest is read by that value's rules,
// applied with `this` bound to it.
{this}.sent({rest}) =>
  where := external span rest
  at := where.from
  rest_to := where.to
  within := where.frame
  sender := registry.sender
  sender_pieces := sender.pieces
  this_piece := sender_pieces
  // the first receiver is a place (its code, unread, given as a capture is): what it holds is read for its rules only when it
  // holds something; the receivers after it are values
  current := None
  first := true
  value := None
  receiver_at := external span this
  frame := receiver_at.frame
  frame_written := frame
  held := None
  while frame
    held = external get frame this
    if held
      frame = None
    if frame
      frame = frame.outer
  if held
    value = held
  unless held
    // not a name a frame holds: a group, quoted text, a word a rule reads (`enum`), or a name nothing holds yet (a place)
    first_place := receiver_at.from
    c := first_place.character
    if c.closer
      value = this
    if c === quote
      value = this
    unless value
      read_receiver := first_place.reading_in(receiver_at.to, frame_written)
      if read_receiver
        value = this
  result := current
  going := true
  // a rest that is only spaces: nothing more to read on it
  blank := at.spaces_after
  if blank === rest_to
    going = None
    result = this
  while going
    rules := value.reading_rules
    r := at.prefix_reading(rest_to, rules)
    // read after the spaces too: what reads farther (a method `== x` over a juxtaposed value `{ }{value}`), else that
    spaced := at.spaces_after
    r_spaced := spaced ? spaced.prefix_reading(rest_to, rules) : None
    if r_spaced
      better := true
      if r
        better = r_spaced.end === r.end ? None : r.end.reaches(r_spaced.end, rest_to)
      if better
        at = spaced
        r = r_spaced
    unless r
      external report (spaced ? spaced : at) rest_to
      going = None
    if r
      rule := r.rule
      caps := r.captures
      bound := external node
      bound.piece = this_piece
      if first
        // a name a frame holds: its value; anything else: as written
        if held
          bound.value = held
        unless held
          bound.from = receiver_at.from
          bound.to = receiver_at.to
      unless first
        bound.value = current
      first = None
      bound.next = caps
      result = external apply rule bound within
      at = r.end
      if at === rest_to
        going = None
      current = result
      value = result
  result

sent_rule := registry.latest
registry.sender = sent_rule

// ---------------------------------------------------------------- what the language is defined with (the reader's own)
// Whether `x` has a member `name` of its own (one set there, even to nothing).
{x}.has({name}) =>
  external own x name

// Whether `code` is one name as written: a place (what it names is read only when it is wanted, R2.1).
{code}.is_place =>
  where := external span code
  found := None
  if where
    from := where.from
    to := where.to
    spaced := from.spaces_after
    if spaced
      from = spaced
    c := from.character
    unless c.closer
      unless c === quote
        ends := from.operand_end(to)
        if ends === to
          found = true
  found

// Whether `x` is `scope` or inside it (its parents reach it, or the classes they extend).
{x}.inside({scope}) =>
  here := x
  found := None
  while here
    if here === scope
      found = true
      here = None
    if here
      ancestor := here.extends
      while ancestor
        if ancestor === scope
          found = true
          ancestor = None
          here = None
        if ancestor
          ancestor = ancestor.extends
    if here
      here = here.outer
  found

// The `this` a frame sees: its own, or the nearest frame around it that has one.
{frame}.this_seen =>
  here := frame
  found := None
  while here
    if here.has(this)
      found = here.this
      here = None
    if here
      here = here.outer
  found

// What `arguments` give, in order (code, read here): a chain of `value`s, or of `item`s (code as written, `,`).
{arguments}.listed =>
  written := arguments
  given := written
  found := None
  if given
    if given.listing
      found = given.head
    unless given.listing
      found = external node
      found.listed = true
      found.value = given
  found

// The value of a link of such a chain.
{link}.argument =>
  found := link.has(value) ? link.value : None
  if link.listed
    found = external get link value
  found

// Whether arguments are given by name (`x: 1, …`): the first is a name followed by `: `.
{code}.named =>
  where := external span code
  found := None
  if where
    from := where.from
    to := where.to
    at := from.spaces_after
    unless at
      at = from
    // inside the brackets they are given in
    if at.character === opening
      at = at.next
    e := at.operand_end(to)
    if e
      c := e.character
      if c === colon
        n := e.next
        if n
          d := n.character
          if d === space
            found = true
  found

// The place a head written from `from` to `to` ends at without its highlighting: a last word `^style` is a mark (R5.2).
{from}.unstyled({to}) =>
  here := from
  found := to
  last_space := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      if c === space
        last_space = here
      here = here.next
  if last_space
    mark := last_space.next
    m := mark.character
    if m === caret
      after := mark.next
      unless after === to
        a := after.character
        unless a === space
          found = last_space
  found

// ---------------------------------------------------------------- methods (R2.1)
// What every method runs: `this` (the receiver given, or the `this` its caller sees), its frame inside it when it is an
// instance of where the method was written; its parameters bound to its arguments (`(parameters) := arguments`: a name
// declared with a type takes the next argument given, a bare name the next one left); then the body it was written with, in a
// frame of its own. A `return` in it ends it.
// (The frame a method runs in holds its captures: what runs it keeps its own names in a frame of its own.)
{frame}.method_run =>
  method := frame.applied_rule
  receiver := None
  if frame.has(this)
    receiver = frame.this
  unless frame.has(this)
    caller := frame.caller_frame
    receiver = caller.this_seen
  frame.this = receiver
  scope := method.scope
  if receiver && receiver.inside(scope)
    frame.outer = receiver
  inner := external node
  inner.outer = frame
  parameters := method.parameters
  if parameters
    given := frame.has(arguments) ? frame.arguments.listed : None
    inner.bound(parameters, given)
  written := method.written
  body := written.code
  result := external apply body None inner
  // a body that is one block runs it
  if body.starts_block && result.program
    result = result.run_in(inner)
  result

running a method =>
  (external .).method_run

runner := registry.latest

// Parameters bound in `frame` to what `given` (a chain of arguments) gives, in order: `(parameters) := arguments` (a name
// declared with a type takes the next argument given, a bare name the next one left).
{frame}.bound({parameters}, {given}) =>
  saved_given := registry.given
  registry.given = given
  written_parameters := parameters.code
  if written_parameters.is_place
    first_given := registry.given
    external set frame written_parameters first_given.argument
  unless written_parameters.is_place
    bound := external apply written_parameters None frame
    // the bare names left in a list of them take what is left, in order
    if bound.listing
      item := bound.head
      while item
        if item.listed
          code := external get item value
          if code.is_place
            left := registry.given
            if left
              external set frame code left.argument
              registry.given = left.next
        item = item.next
  registry.given = saved_given
  frame

// Whether code starts with a block's bracket.
{code}.starts_block =>
  where := external span code
  found := None
  if where
    from := where.from
    spaced := from.spaces_after
    if spaced
      from = spaced
    found = from.character === opening_block
  found

// A program (a block as a value) run in `frame`: what it answers.
{program}.run_in({frame}) =>
  p := program
  written := p.written
  code := written.code
  external apply code None frame

// Whether a value holds (T1.7): nothing does not; a value saying whether it `holds` as that says; any other does.
{value}.holds_true =>
  v := value
  found := v
  if v && v.has(holds)
    found = v.holds
  found
method_body := runner.body
this_written := external span this
arguments_written := external span arguments
arguments_from := arguments_written.from
arguments_to := arguments_written.to

// ---------------------------------------------------------------- types with a check: characters, repetition (R2.2)
{check}.checked =>
  made := external node
  made.check = check
  made

// One character, any.
{kind}.one_character({from}, {to}) =>
  following := from.next
  following === to
Char := registry.latest.checked

// One character, not `excluded`.
{kind}.one_character_except({from}, {to}) =>
  following := from.next
  found := None
  if following === to
    c := from.character
    excluded := kind.excluded
    unless c === excluded
      found = true
  found
except_rule := registry.latest
{c}.anything_but =>
  made := except_rule.checked
  made.excluded = c
  made

// One or more of `item`, one after another.
{kind}.one_or_more({from}, {to}) =>
  item := kind.item
  e := from.next
  found := None
  going := true
  while going
    if item.holds(from, e)
      if e === to
        found = true
      unless found
        unless e === to
          found = kind.one_or_more(e, to)
    if found
      going = None
    if e === to
      going = None
    if going
      e = e.next
  found
many_rule := registry.latest
// Text that is tight: balanced, with no space outside its brackets (what a member is read on: `a.b(1, 2).c`).
{kind}.tight({from}, {to}) =>
  found := from.balanced_to(to)
  if found
    depth := None
    here := from
    while here
      if here === to
        here = None
      if here
        c := here.character
        shut := c.closer
        if shut
          pushed := external node
          pushed.next = depth
          depth = pushed
        unless shut
          if c.closes
            depth = depth.next
          unless depth
            if c === space
              found = None
              here = None
        if here
          here = here.next
  found
Tight := registry.latest.checked

// One operand: from where it starts (after spaces), a group, quoted text or a word, and nothing after it.
{kind}.one_operand({from}, {to}) =>
  start := from.spaces_after
  unless start
    start = from
  e := start.operand_end(to)
  e === to
Operand := registry.latest.checked

// A method's argument: what brackets hold (the group, nothing after it), or one operand with what accesses it (`a.b`, `f(x)`):
// nothing outside brackets is a space.
{kind}.one_argument({from}, {to}) =>
  start := from.spaces_after
  unless start
    start = from
  found := None
  if start.character === opening
    e := start.balanced_end(to)
    found = e === to
  unless start.character === opening
    found = kind.tight(start, to)
  found
Argument := registry.latest.checked

// A word: one operand that is not in brackets or quotes.
{kind}.word_text({from}, {to}) =>
  found := None
  c := from.character
  unless c.closer
    unless c === quote
      e := from.operand_end(to)
      found = e === to
  found
Word := registry.latest.checked
{item: Operand}[] =>
  made := many_rule.checked
  made.item = item
  made
repeated_rule := registry.latest

// ---------------------------------------------------------------- text written in quotes
Unquoted := quote.anything_but
Quoted := Unquoted[]
"{text: Quoted}" =>
  external span text
quoted_rule := registry.latest
// Text in backticks, taken as written.
Unticked := backtick.anything_but
Ticked := Unticked[]
`{text: Ticked}` =>
  external span text
ticked_rule := registry.latest
// what is said when there is nothing to add to
nothing_extended := `nothing to add to (it is not defined yet)`

// ---------------------------------------------------------------- brackets: what they hold is balanced
// Balanced text: every bracket it opens it closes, in order, and it closes none it did not open; quoted text is skipped.
{kind}.balanced({from}, {to}) =>
  open_ones := None
  here := from
  ok := true
  while here
    if here === to
      here = None
    if here
      c := here.character
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if c.closes
          unless open_ones
            ok = None
            here = None
          if open_ones
            expected := open_ones.shut
            unless c === expected
              ok = None
              here = None
            if here
              open_ones = open_ones.next
        if c === quote
          here = here.next
          skipping := here
          while skipping
            if skipping === to
              ok = None
              skipping = None
              here = None
            if skipping
              d := skipping.character
              if d === quote
                here = skipping
                skipping = None
              if skipping
                skipping = skipping.next
      if here
        here = here.next
  if open_ones
    ok = None
  ok
Balanced := registry.latest.checked

// A group: what is in brackets is read as itself.
({inside: Balanced}) =>
  inside
group_rule := registry.latest
// Nothing in brackets.
{`()`} =>
  None
empty_group_rule := registry.latest

// Text in round brackets, whole: it opens with one and the bracket closing that one ends it.
{kind}.bracketed({from}, {to}) =>
  found := None
  c := from.character
  if c === opening
    shut := from.balanced_end(to)
    if shut === to
      found = true
  found
Bracketed := registry.latest.checked

// The rest of a line: no line end in it.
{kind}.on_one_line({from}, {to}) =>
  found := true
  here := from
  while here
    if here === to
      here = None
    if here
      c := here.character
      if c === end
        found = None
        here = None
      if here
        here = here.next
  found
Line := registry.latest.checked

// One item of a list: balanced, with no `,` outside the brackets in it (G2.21: `,` composes before `=>` reads a definition).
{kind}.item_text({from}, {to}) =>
  found := from.balanced_to(to)
  if found
    depth := None
    here := from
    while here
      if here === to
        here = None
      if here
        c := here.character
        shut := c.closer
        if shut
          pushed := external node
          pushed.next = depth
          depth = pushed
        unless shut
          if c.closes
            depth = depth.next
          unless depth
            if c === comma
              found = None
              here = None
        if here
          here = here.next
  found
Item := registry.latest.checked


// Parameters as written: no braces in them (a rule's head has some).
Unbraced := opening_block.anything_but[]

// ---------------------------------------------------------------- what the language's rules do (the reader's own)
// A rule of the head `pieces` defined (R2.1): one in a class, or with parameters, runs what every method runs with the body written
// here; a head of parameters only names nothing (a closure: the rule is a value, not kept where rules are read).
{pieces}.defined({written_pattern}, {written_body}, {scope}, {modifiers}) =>
  head := written_pattern.code
  b := written_body.code
  parameters := pieces.parameters_piece
  method := scope.class
  if parameters
    method = true
  made := None
  if method
    made = external define head pieces method_body
    made.method = true
    made.written = written_body
    if parameters && parameters.has(parameters)
      made.parameters = parameters.parameters
  unless method
    made = external define head pieces b
  made.modifiers = modifiers
  named := true
  if parameters && parameters === pieces
    named = None
  if named
    made.keep
  made

// The value a name written (code, in a node) names where it was written, or nothing.
{word}.named_value =>
  code := word.code
  holder := external declaring code
  external get holder code

// Where an alternative of a head from `at` ends: at a ` | ` outside brackets, before which no capture is written; else `to`.
{at}.alternative_end({to}) =>
  here := at
  found := to
  depth := None
  captures := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      if c === open
        captures = true
      shut := c.closer
      if shut
        pushed := external node
        pushed.next = depth
        depth = pushed
      unless shut
        if c.closes && depth
          depth = depth.next
        unless depth
          if c === space
            unless captures
              bar := here.next
              if bar && bar.character === pipe
                after := bar.next
                if after && after.character === space
                  found = here
                  here = None
      if here
        here = here.next
  found

// The place of the `{` opening a block that ends the places from `at` to `to`, or nothing.
{at}.trailing_block({to}) =>
  here := at
  found := None
  while here
    if here === to
      here = None
    if here
      if here.character === opening_block
        shut := here.balanced_end(to)
        if shut === to
          found = here
          here = None
        if here
          here = shut ? shut : here.next
      unless here.character === opening_block
        here = here.next
  found

// The place before `limit` from `at` (`limit`'s previous place among them).
{limit}.before_place({at}) =>
  here := at
  found := at
  while here
    following := here.next
    if following === limit
      found = here
      here = None
    if here
      here = following
  found

// Where a name from `at` ends: at a space or an opening bracket, or `to`.
{at}.name_end({to}) =>
  here := at
  found := to
  while here
    if here === to
      here = None
    if here
      c := here.character
      stop := c === space
      if c === opening
        stop = true
      if stop
        found = here
        here = None
      if here
        here = here.next
  found

// The place after ` | `, from the space before it.
{at}.after_alternative =>
  bar := at.next
  after := bar.next
  after.next

// The last of a chain of pieces.
// `x.name`: the receiver's own member `name` (T8.7: own key wins), else its method of that name applied to it with
// `arguments` (code, or nothing).
{this}.member({name}, {arguments}) =>
  value := this
  key := name
  found := None
  if external own value key
    found = external get value key
  unless external own value key
    method := value.method_named(key)
    if method
      found = method.applied_to(value, arguments)
  found

// The method of a value named as `key` (raw code: its text): a method rule read by the value whose head is that name, and
// its arguments if any.
{value}.method_named({key}) =>
  k := key
  where := external span k
  from := where.from
  to := where.to
  rules := value.reading_rules
  found := None
  while rules
    r := rules.rule
    if r.method
      pieces := r.pieces
      if pieces.literal && from.spells_word(pieces, to)
        following := pieces.next
        fits := true
        if following
          unless following.capture
            fits = None
        if fits
          found = r
          rules = None
    if rules
      rules = rules.next
  found

// A method applied to `receiver` with `arguments` (their value, given as the method's capture).
{method}.applied_to({receiver}, {arguments}) =>
  m := method
  r := receiver
  given := arguments
  caps := external node
  caps.piece = this_written
  caps.value = r
  pieces := method.pieces
  argument_piece := pieces.parameters_piece
  if argument_piece && given
    given_cap := external node
    given_cap.piece = argument_piece
    given_cap.value = given
    caps.next = given_cap
  here := external .
  external apply m caps here

// `x := value`: a place declared where it was written; a list of places, each declared with the value in its place.
{this}.declared({value}) =>
  found := None
  if this.is_place
    written := external ** this
    place := written.code
    found = external declare place value
  unless this.is_place
    places := this
    given := value.listed
    found = places
    if places.listing
      item := places.head
      while item
        code := external get item value
        if given
          external declare code given.argument
          given = given.next
        item = item.next
  found

// `x &= value`: the list `x` holds with `value` at its end; a new one when it holds nothing (and `x` written with it).
{this}.appended({value}) =>
  list := this
  given := value
  if list
    unless list.listing
      list = None.listed_with_value(list)
  found := list.listed_with_value(given)
  if this.is_place
    written := external ** this
    place := written.code
    holder := external declaring place
    external set holder place found
  found

// `x = value`: written where the place was declared.
{this}.assigned({value}) =>
  found := value
  if this.is_place
    written := external ** this
    place := written.code
    holder := external declaring place
    external set holder place found
  found

// `x: T`, `x: T = default`: a name declared with a type. What is being constructed or called gives it its value: by name (its
// own member already), or the next given in order; else `default`, else nothing.
{this}.declared_as({type}, {default}) =>
  where := external span this
  frame := where.frame
  written := external ** this
  place := written.code
  naming := registry.naming
  value := None
  if naming
    value = type
    external set naming place value
  unless naming
    given := external own frame place
    if given
      value = external get frame place
    unless given
      next := registry.given
      if next
        value = next.argument
        registry.given = next.next
      unless next
        value = default
    external declare place value
  value

// `a && b`: `b` when `a` holds, else `a`; `a || b`: `a` when it holds, else `b`.
{this}.and({other}) =>
  found := this
  if found.holds_true
    found = other
  found
{this}.or({other}) =>
  found := this
  unless found.holds_true
    found = other
  found

// A class made from a header (code), a block (code, or nothing) and the class it extends (or nothing).
{source}.header_class({parent}) =>
  where := external span source
  made := external node
  made.outer = where.frame
  made.class = true
  if parent
    made.extends = parent
  made.header = external ** source
  made.read_header_into(made)
  made

// A class given its block: read in it, and kept to be read again in each instance.
{made}.with_block({block}) =>
  static := made
  static.written = external ** block
  static.read_as_class(block)
  registry.classes_changed = true
  static

// A class's header read into `frame`: each of its items (separated by `,` outside brackets), as a statement; a header in brackets,
// what they hold.
{static}.read_header_into({frame}) =>
  written := static.header
  if written
    written.read_items_into(frame)
  static

// The items of written code (a node with its `code`), separated by `,` outside brackets (in a bracketed one, what the brackets
// hold), each read as a statement in `frame`.
{written}.read_items_into({frame}) =>
  code := written.code
  where := external span code
  from := where.from
  to := where.to
  spaced_from := from.spaces_after
  if spaced_from
    from = spaced_from
  if from.character === opening
    from = from.next
    to = to.before_place(from)
  item_from := from
  while item_from
    item_end := item_from.item_end(to)
    item_written := external code item_from item_end code
    item_code := item_written.code
    external apply item_code None frame
    item_from = None
    unless item_end === to
      item_from = item_end.next
      spaced := item_from.spaces_after
      if spaced
        item_from = spaced
  frame

// Where an item from `at` ends: at a `,` outside brackets, or `to`.
{at}.item_end({to}) =>
  here := at
  found := to
  depth := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      shut := c.closer
      if shut
        pushed := external node
        pushed.next = depth
        depth = pushed
      unless shut
        if c.closes && depth
          depth = depth.next
        unless depth
          if c === comma
            found = here
            here = None
      if here
        here = here.next
  found

// A class's block read again in an instance being made, after the blocks of the classes it extends.
{static}.read_into({instance}) =>
  class_read := static
  ancestor := class_read.extends
  if ancestor
    ancestor.read_into(instance)
  class_read.read_header_into(instance)
  block := class_read.written
  if block
    code := block.code
    external apply code None instance

// `a, b`: a list (a chain: `head`, `tail`, links with `value` and `next`), each item as written, read when its value is read;
// a list given another item is that list with it at the end.
{this}.listed_with({other}) =>
  list := None
  known := external span this
  unless known
    list = this
    unless list.listing
      list = None
    // a value given, not as written: a list of it
    unless list
      list = None.listed_with_value(this)
  unless list
    list = external node
    list.listing = true
    first := external node
    first.listed = true
    written_this := external ** this
    this_code := written_this.code
    external keep first value this_code
    list.head = first
    list.tail = first
  added := external node
  added.listed = true
  written_other := external ** other
  other_code := written_other.code
  external keep added value other_code
  last := list.tail
  last.next = added
  added.previous = last
  list.tail = added
  list

// A list with a value added at its end (a new list when `list` is nothing).
{list}.listed_with_value({value}) =>
  found := list
  unless found
    found = external node
    found.listing = true
  added := external node
  added.listed = true
  added.value = value
  last := found.tail
  if last
    last.next = added
    added.previous = last
  unless last
    found.head = added
  found.tail = added
  found

// `x -- call`, `x ~~ call`: `call` read in a frame where `this` is `x`; a closure it answers is called with `x`; `keep`: `x`.
{this}.continued({call}, {keep}) =>
  value := this
  written := external ** call
  code := written.code
  where := external span code
  frame := external node
  frame.outer = where.frame
  frame.this = value
  result := external apply code None frame
  if result.method
    result = result.applied_to(None, value)
  if keep
    result = value
  result

// A superposition of `this` and `other` (one more component when `this` is one).
{this}.superposed_with({other}) =>
  value := this
  given := other
  found := None
  if value.superposes
    found = external node
    found.superposes = true
    found.components = value.components.copied_list.listed_with_value(given)
  unless value.superposes
    found = external node
    found.superposes = true
    first := None.listed_with_value(value)
    found.components = first.listed_with_value(given)
  found

// A list with the same values (a new chain).
{list}.copied_list =>
  found := None
  link := list.head
  while link
    found = found.listed_with_value(link.value)
    link = link.next
  found

// A type narrowed by a constraint (code read with `this` being a candidate).
{this}.narrowed({constraint}) =>
  made := external node
  made.narrows = this
  made.constraint = external ** constraint
  made

// Whether `type` admits `this` (T4.10): a narrowing, what it narrows that satisfies its constraint; a superposition, what one of its
// components admits; a class, its instances (and those of the classes extending it); any other value, itself.
{this}.admitted_by({type}) =>
  value := this
  t := type
  found := None
  decided := None
  if t.narrows
    decided = true
    narrowed_type := t.narrows
    if value.admitted_by(narrowed_type)
      written := t.constraint
      code := written.code
      where := external span code
      frame := external node
      frame.outer = where.frame
      frame.this = value
      found = external apply code None frame
      found = found.holds_true
  unless decided
    if t.superposes
      decided = true
      component := t.components.head
      while component
        if value.admitted_by(component.value)
          found = true
          component = None
        if component
          component = component.next
  unless decided
    if t.class
      decided = true
      if value
        found = value.inside(t)
  unless decided
    found = value === t
  found

// Calling a value: a class makes an instance of itself; a closure runs.
{this}.called({arguments}) =>
  value := this
  found := value.class ? value.constructed(arguments) : None
  // a rule as a value (a closure: `(x) => …`): applied to them
  if value.method
    found = value.applied_to(None, arguments)
  // a program: entered where it was written, the arguments bound to its parameters
  program_class := registry.program_class
  if program_class && value.instance
    if value.outer === program_class
      given := arguments ? arguments.listed : None
      found = value.entered_in(value.context, given)
  found

// An instance of a class (R4.4): a frame inside it, with the class's block read again there, where a definition is the class's
// and a field takes what the arguments give it (by name, or in order).
{static}.constructed({arguments}) =>
  instance := external node
  instance.outer = static
  instance.instance = true
  instance.this = instance
  outer_given := registry.given
  outer_naming := registry.naming
  registry.given = None
  registry.naming = None
  // the arguments as written (code passed on is followed to where it was written)
  given_node := external ** arguments
  written := given_node.code
  given_value := given_node.value
  if given_value
    registry.given = given_value.listed
  // (code held in a name is read where the name is: whether there is any is asked of where it is written)
  written_at := external span written
  if written_at
    if written.named
      where := external span written
      naming_frame := external node
      naming_frame.outer = where.frame
      registry.naming = instance
      given_node.read_items_into(naming_frame)
      registry.naming = None
    unless written.named
      registry.given = written.listed
  // the parents' blocks first, then its own
  static.read_into(instance)
  registry.given = outer_given
  registry.naming = outer_naming
  instance

// ---------------------------------------------------------------- programs (P1): code, read where it was written or entered on a value
// A program entered on `element`: its code read in a frame of its own inside `element`, `this` being `element`; the values
// `given` (a list's first link, or nothing) bound to its parameters. What its code answers.
{program}.entered_in({element}, {given}) =>
  p := program
  frame := external node
  frame.outer = element
  frame.this = element
  parameters := p.parameters
  if parameters
    frame.bound(parameters, given)
  written := p.code
  code := written.code
  external apply code None frame

// A program run now and kept to run again when a class is made or added to while it answers nothing (P5.1); entered on a frame
// of its own inside where it was written.
{program}.watched_run =>
  p := program
  code := p.code.code
  where := external span code
  fresh := external node
  fresh.outer = where.frame
  answer := p.entered_in(fresh, None)
  registry.classes_changed = None
  unless answer
    waiting := external node
    waiting.program = p
    waiting.next = registry.waiting
    registry.waiting = waiting
  p

// The programs waiting, run again (P5.1); what they make or add to while they run does not run them again (P5.2).
{this}.rerun_waiting =>
  unless registry.rerunning
    waiting := registry.waiting
    if waiting
      registry.rerunning = true
      registry.waiting = None
      while waiting
        p := waiting.program
        p.watched_run
        waiting = waiting.next
      registry.rerunning = None
  // (what they made does not run them again, P5.2)
  registry.classes_changed = None
  None

// A class's block read for the class itself: what a construction under way was given is not its (its fields take no arguments).
{static}.read_as_class({block}) =>
  saved_given := registry.given
  saved_naming := registry.naming
  registry.given = None
  registry.naming = None
  written_block := external ** block
  block_code := written_block.code
  external apply block_code None static
  registry.given = saved_given
  registry.naming = saved_naming
  static

// A name read on its own in the language's code: what the frames around it hold; else the member of the `this` it is read for
// (nothing when it has none: `next` of the last); else it is said to be unresolved.
{word}.bare_name =>
  name := (external ** word).code
  // (the frame it is read in is the one applying this: the name taken as written, not followed)
  read_in := (external .).caller_frame
  frame := read_in
  found := None
  held := None
  while frame
    if external own frame name
      held = true
      found = external get frame name
      frame = None
    if frame
      frame = frame.outer
  unless held
    receiver := read_in.this_seen
    if receiver
      found = external get receiver name
    // (none: read as a plain name, which says it is unresolved)
    unless receiver
      unless registry.bare_reporting
        registry.bare_reporting = true
        external read (external span word).from (external span word).to reader_like
        registry.bare_reporting = None
  found
registry.bare_rule = registry.latest

// ================================================================ the language
// The rules so far are the reader's own vocabulary: from here on they are out of reach of a project's files (R4.2b), which are
// read with the language defined below.
internal_rules := top.rules
while internal_rules
  internal_rule := internal_rules.rule
  internal_rule.internal = true
  internal_rules = internal_rules.next
// what both read with: quoted text, groups, repetition
quoted_rule.shared = true
ticked_rule.shared = true
group_rule.shared = true
empty_group_rule.shared = true
repeated_rule.shared = true
registry.language = true

// Rules defined from here on (R2.1: a rule is a method). One written in a class, or with parameters (`name (a, b: T) => …`), runs
// what every method runs with the body written here; one written while an instance is made is the class's already. A head that
// is only parameters (`(x) => …`) names nothing: the rule is a value (a closure), not kept where rules are read.
{pattern: Item} => {body} =>
  where := external span pattern
  scope := where.frame
  made := None
  written_pattern := external ** pattern
  written_body := external ** body
  unless scope.instance
    head_from := where.from
    head_to := head_from.unstyled(where.to)
    // modifiers before the head (`static`, `chainable`, …): the values its first words name, kept on the rule
    modifiers := None
    going := true
    while going
      going = None
      word_end := head_from.word_end(head_to)
      unless word_end === head_to
        word := external code head_from word_end pattern
        modifier := word.named_value
        if modifier && modifier.modifier
          link := external node
          link.modifier = modifier
          link.next = modifiers
          modifiers = link
          head_from = word_end.spaces_after
          going = true
    // alternatives (`a | b => …`, names only): one rule each; the parameters of the last are all of theirs
    last_from := head_from
    alternative_end := head_from.alternative_end(head_to)
    while alternative_end
      unless alternative_end === head_to
        last_from = alternative_end.after_alternative
        alternative_end = last_from.alternative_end(head_to)
      if alternative_end === head_to
        alternative_end = None
    last_pieces := last_from.pieces(head_to, pattern)
    shared := last_pieces.parameters_piece
    alternative := head_from
    while alternative
      ending := alternative.alternative_end(head_to)
      pieces := last_pieces
      unless alternative === last_from
        pieces = alternative.pieces(ending, pattern)
        unless pieces.parameters_piece
          if shared
            tail := pieces.last_piece
            tail.next = shared
      made = pieces.defined(written_pattern, written_body, scope, modifiers)
      alternative = None
      unless ending === head_to
        alternative = ending.after_alternative
  made
language_definer := registry.latest
language_definer.defines = true

// ---------------------------------------------------------------- statements read whole (L§2): what is declared first binds loosest
// `(x => body)`: a closure of one parameter, written in brackets (the original's form; `x => body` alone defines `x`).
({parameter: Word} {`=>`} {body}) =>
  into := external node
  into.add(capture, arguments_from, arguments_to)
  piece := into.last
  piece.optional = true
  piece.arguments = true
  piece.type = Operand
  piece.parameters = external ** parameter
  written_pattern := external ** parameter
  written_body := external ** body
  where := external span parameter
  pieces := into.first
  pieces.defined(written_pattern, written_body, where.frame, None)
// `[items]`: a list of them; `[]`: an empty one.
[{inside: Balanced}] =>
  given := inside
  found := given
  unless given.listing
    found = external node
    found.listing = true
    only := external node
    only.listed = true
    only.value = given
    found.head = only
    found.tail = only
  found
{`[]`} =>
  found := external node
  found.listing = true
  found
// A block as a value: a program (`{ … }`), run where something runs it.
{{inside: Balanced}} =>
  made := external node
  made.program = true
  made.written = external ** inside
  made.code = made.written
  where := external span inside
  made.context = where.frame
  // (an instance of the language's `Program`, once there is one)
  program_class := registry.program_class
  if program_class
    made.outer = program_class
    made.instance = true
    made.this = made
  made
// `name := value`: the value declared where the name was written; a list of names, each with the value in its place.
{name: Tight} := {value} =>
  name.declared(value)
// `condition ? yes : no`: `yes` when the condition holds, else `no`.
{condition} ? {yes} : {no} =>
  answer := None
  taken := condition
  answer = taken.holds_true ? yes : no
  answer
// `name: Type = default`, `name: Type`: a name declared with a type, given its value by what is constructed or called.
{name}: {type} = {default} =>
  name.declared_as(type, default)
{name}: {type} =>
  name.declared_as(type, None)
// `name ^style := value`: the mark is the highlighting's (R5.2).
{name: Tight} ^{literal style} := {value} =>
  name.declared(value)
// `x.member = value`: the member set.
{x: Tight}.{literal member} = {value} =>
  external set x member value
// `x &= value`: `value` added at the end of the list `x` holds (a list of it when `x` holds nothing).
{target: Tight} &= {value} =>
  target.appended(value)
// `name = value`: written where the name was declared.
{target: Tight} = {value} =>
  target.assigned(value)
// `a === b`: whether they are the same value (identity).
{a} === {b} =>
  external same a b
// `x.member`, `x.member(arguments)`: its own member, else its method (T8.7).
{x: Tight}.{literal member}{arguments: Bracketed} =>
  x.member(member, arguments)
{x: Tight}.{literal member} =>
  x.member(member, None)
// `.member`, `.member = value`, `.member(arguments)`: of `this` (what the statement's frame sees as `this`).
.{literal member} = {value} =>
  receiver := (external .).caller_frame.this_seen
  external set receiver member value
.{literal member}{arguments: Bracketed} =>
  receiver := (external .).caller_frame.this_seen
  receiver.member(member, arguments)
.{literal member} =>
  receiver := (external .).caller_frame.this_seen
  receiver.member(member, None)

// ---------------------------------------------------------------- what every value has (the base)
Node := type
  .{literal property} =>
    this.member(property, None)
  .{literal property}{arguments: Bracketed} =>
    this.member(property, arguments)
  .{literal property} = {value} =>
    external set this property value
  // `,` composes one value, a list (no split, 2026-09-27): `a, b, c` is the list of `a`, `b` and `c`, each as written (a
  // place or a value, read when it is used).
  ,{other: Item} =>
    this.listed_with(other)
  :={value} =>
    this.declared(value)
  ={value} =>
    this.assigned(value)
  :{type} =>
    this.declared_as(type, None)
  :{type} = {default} =>
    this.declared_as(type, default)
  {arguments: Bracketed} =>
    this.called(arguments)
  // a comment after a value: the value
  {`//`}{comment: Line} =>
    this
  // `x &+= { … }`: what the block defines, added to `x` (R4.3)
  &+={ }{{members: Balanced}} =>
    extended := this
    if extended
      external apply members None extended
    unless extended
      where := external span members
      at := where.from
      limit := where.to
      external report at limit nothing_extended
    registry.classes_changed = true
    extended
  // `x -- f`: `f` read with `this` being `x` (a closure it answers called with `x`): what it answers; `x ~~ f`: the same, for
  // what it does, answering `x`
  --{call: Line} =>
    this.continued(call, None)
  ~~{call: Line} =>
    this.continued(call, true)
  // `a | b`: both, superposed (U1); `T?`: `None | T`
  |{other: Operand} =>
    this.superposed_with(other)
  ? =>
    None.superposed_with(this)
  // `T{p}`: what `T` admits that satisfies `p` (read with `this` being the candidate)
  {{constraint: Balanced}} =>
    this.narrowed(constraint)
  // `x is T`: whether `T` admits `x` (T4.10)
  { }is {type: Operand} =>
    this.admitted_by(type)
  &&{other} =>
    this.and(other)
  ||{other} =>
    this.or(other)
registry.base = Node

// ---------------------------------------------------------------- modifiers: words before a definition's head, kept on its rule
static := external node
static.modifier = true
chainable := external node
chainable.modifier = true
compounds := external node
compounds.modifier = true
right-to-left := external node
right-to-left.modifier = true
left-to-right := external node
left-to-right.modifier = true

// ---------------------------------------------------------------- classes (R4.4)

// A class: the frame its block is read in, inside the frame it was written in; its statics, its fields' defaults and its methods
// are that frame's. Calling it makes an instance.
class {{block: Balanced}} =>
  where := external span block
  made := external node
  made.outer = where.frame
  made.class = true
  made.written = external ** block
  made.read_as_class(block)
  registry.classes_changed = true
  made
// `class: Parent { … }`: a class whose instances are also its parent's (its rules and fields too).
class: {parent} {{block: Balanced}} =>
  where := external span block
  made := external node
  made.outer = where.frame
  made.class = true
  made.extends = parent
  made.written = external ** block
  made.read_as_class(block)
  registry.classes_changed = true
  made
// `enum a | b (field: v) | c { block }`: a class of exactly these members, each an instance of it named on it (`X.a`), in
// `members` in order; a block after them is the class's own.
enum {written: Item} =>
  where := external span written
  made := external node
  made.outer = where.frame
  made.class = true
  made.enum = true
  // (every enum is the language's `Enum`, once there is one)
  enum_class := registry.enum_class
  if enum_class
    made.extends = enum_class
  from := where.from
  to := where.to
  members_to := to
  block_at := from.trailing_block(to)
  if block_at
    members_to = from.trimmed(block_at)
    inside_from := block_at.next
    inside_to := to.before_place(block_at)
    block := external code inside_from inside_to written
    made.written = block
    block_code := block.code
    external apply block_code None made
  member_from := from
  while member_from
    member_end := member_from.alternative_end(members_to)
    name_end := member_from.name_end(member_end)
    named_written := external code member_from name_end written
    name := named_written.code
    fields := None
    fields_from := None
    unless name_end === member_end
      fields_from = name_end.spaces_after
    if fields_from
      unless fields_from === member_end
        fields_written := external code fields_from member_end written
        fields = fields_written.code
    entry := made.constructed(fields)
    external set made name entry
    // each member knows the ones beside it
    last_entry := made.last_member
    if last_entry
      last_entry.following = entry
      entry.preceding = last_entry
    made.last_member = entry
    made.members = made.members.listed_with_value(entry)
    member_from = None
    unless member_end === members_to
      member_from = member_end.after_alternative
  made

// A class written with a header (`class = values: Iterable { … }`, `class (x: T, y) { … }`): its items (separated by `,` outside
// brackets) are read as the class's block is, before it (a typed one a field, given in order when an instance is made).
class = {header: Balanced} {{block: Balanced}} =>
  made := header.header_class(None)
  made.with_block(block)
class = {header: Balanced} =>
  header.header_class(None)
class: {parent: Tight} = {header: Balanced} {{block: Balanced}} =>
  made := header.header_class(parent)
  made.with_block(block)
class: {parent: Tight} = {header: Balanced} =>
  header.header_class(parent)
class {header: Bracketed} {{block: Balanced}} =>
  made := header.header_class(None)
  made.with_block(block)
class: {parent: Tight} {header: Bracketed} {{block: Balanced}} =>
  made := header.header_class(parent)
  made.with_block(block)

// `static name = value` in a class: a member of the class (declared there, as `:=` does), read once.
static {name: Tight} = {value} =>
  where := external span name
  found := None
  unless where.frame.instance
    found = name.declared(value)
  found
// `static statement` in a class: read once, for the class, not again for each instance.
static {statement} =>
  where := external span statement
  found := None
  unless where.frame.instance
    found = statement
  found

// `program.entered(element, given)`: its code read with `this` being `element` (P1); `watched(program)`: run now, and again while
// it answers nothing when a class is made or added to (P5.1).
{program: Tight}.entered{arguments: Bracketed} =>
  p := program
  given_values := arguments
  first := given_values.head
  element := first.argument
  second := first.next
  given := second.argument
  given_list := given ? given.listed : None
  p.entered_in(element, given_list)
watched({program: Balanced}) =>
  p := program
  p.watched_run

// ================================================================ the language, in its own terms
// From here the entrypoint is read as any file of the language is (with the language's rules, not the reader's).
language_scope := external node
language_scope.outer = top
registry.language_scope = language_scope
registry.language_text = true

// A program (P1): code, read where it was written (`context`) or entered on a value; with `parameters`, a closure of them. A
// block (`{ … }`) is one.
Program := class {
  code: Node?
  parameters: Node?
  context: Node?
}
registry.program_class = Program

// `a; b`: both read, the value of the second.
Node &+= {
  ; (x) => x
}

// A value kept only if a condition holds (`x if c`), or unless it does (`x unless c`).
{guarded} if {condition} => condition ? guarded : None
{guarded} unless {condition} => condition ? None : guarded

// What every enum is: its members are themselves only (`==` is identity), `#` is its members in order, and a member's `next` and
// `previous` are the members beside it (nothing past the ends).
Enum := class {
  == (other) => this === other ? true : false
  # => this.members ?? this.outer.members
  next => this.following
  previous => this.preceding
}
registry.enum_class = Enum

boolean := enum false (holds: None) | true (holds: true) {
  nand (b) => (holds && b.holds) ? false : true
  not => nand(this)
  and (b) => nand(b).not
  or (b) => not.nand(b.not)
  nor (b) => or(b).not
  xor (b) => or(b).and(nand(b))
  xnor (b) => xor(b).not
  next => not
  previous => not
  && (b) => and(b)
  || (b) => or(b)
  !&& (b) => nand(b)
  !|| (b) => nor(b)
  x|| (b) => xor(b)
  x!|| (b) => xnor(b)
  == (other) => this === other ? true : false
}
true := boolean.true
false := boolean.false

// `a ?? b`: `a`, or `b` when `a` is nothing.
Node &+= {
  ?? (other) => this === None ? other : this
}

// `!x`: whether `x` does not hold.
!{x} => x ? false : true

// A block comment is nothing: on its own, and between operands (what it follows is what the whole is). Nested ones are read
// whole: the comment ends at the `*/` the statement ends with.
/*{comment?}*/ => None
Node &+= {
  /*{comment?}*/ => this
}

// ---------------------------------------------------------------- jumps (R3.1): a program's edges
goto {literal target} => external goto target
goto {literal target} if {condition} => (
  taken := condition ? true : None
  external goto target taken
)
{literal label}\ => external label label

// ---------------------------------------------------------------- control flow (P2.8: an `if` answers what its taken block answers)
// What `if` answers: whether a block was taken and what it answered; `else` and `elsif` on it, on the same line or the next,
// choose what the whole answers.
Branch := class {
  taken: Node
  answer: Node
  else {{otherwise: Balanced}} => taken ? answer : otherwise
  {\n}else {{otherwise: Balanced}} => taken ? answer : otherwise
  elsif {condition} {{yes: Balanced}} => taken ? this : (condition ? Branch(true, yes) : Branch(None, None))
  {\n}elsif {condition} {{yes: Balanced}} => taken ? this : (condition ? Branch(true, yes) : Branch(None, None))
}
if := class {
  { }{condition} {{yes: Balanced}} => condition ? Branch(true, yes) : Branch(None, None)
}
unless := class {
  { }{condition} {{yes: Balanced}} => condition ? Branch(None, None) : Branch(true, yes)
}
while := class {
  { }{condition} {{body: Balanced}} => (
   loop_continue\
    goto loop_break if !condition
    body
    goto loop_continue
   loop_break\
    None
  )
}
loop := class {
  { }{{body: Balanced}} => (
   loop_continue\
    body
    goto loop_continue
   loop_break\
    None
  )
}
// `break`, `continue`: to the end, or the start again, of the loop they are in; `return x`: `x`, from the method it is in.
break => external goto loop_break
continue => external goto loop_continue
return {value} =>
  value
  external goto return

// ---------------------------------------------------------------- diagnostics (R5.1): values, each with the place it is about
Diagnostic := class {
  message: Node
  type: Node
  fatal: Node
}
ERROR{`@`}{type} {message} =>
  external report (external span message).from (external span message).to message
  Diagnostic(message: message, type: type)
ERROR {message} =>
  external report (external span message).from (external span message).to message
  Diagnostic(message: message)
FATAL{`@`}{type} {message} =>
  external report (external span message).from (external span message).to message
  Diagnostic(message: message, type: type, fatal: true)
FATAL {message} =>
  external report (external span message).from (external span message).to message
  Diagnostic(message: message, fatal: true)
TODO {message} => None
WARN{`@`}{type} {message} =>
  external report (external span message).from (external span message).to message
INFO{`@`}{type} {message} =>
  external report (external span message).from (external span message).to message
DEBUG{`@`}{type} {message} =>
  external report (external span message).from (external span message).to message
WARN {message} =>
  external report (external span message).from (external span message).to message
INFO {message} =>
  external report (external span message).from (external span message).to message
TODO => None

// `assert (condition)`: an error when it does not hold; the condition.
assert (condition) => (
  unless condition { ERROR `assertion failed` }
  condition
)
