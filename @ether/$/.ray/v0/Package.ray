Package := class: Language = ecosystem: String, kinds: String[] = ["dependencies"], bare: String = "=", native = false, versioned: *, ranges: *?,
  available: (name: String) => String[], fetched: (name: String, version: String, into: Location) => Process {
  locations => [ecosystem, (OS().name as String, OS().architecture) if native].flatten
  resolved (name: String, requirement) => available(name).map(. as versioned).compact{!requirement || requirement.admits(.)}.max
  location (name: String, version) => Layout().path(name, locations, version)
  installed (name: String, requirement) => resolved(name, requirement is String && ranges ? ranges.parsed(requirement, bare) : requirement) -- (version => !version
    ? Quest(name: "a version that satisfies the requirement", goal: (name: name, requirement: requirement))
    : location(name, version) -- (into => into.exists || fetched(name, version as String, into).succeeded
      ? Project(path: into.path, name: name, version: version, manager: this)
      : Quest(name: "install the package", goal: (name: name, version: version, into: into))))

  depending (name: String, spec, kind: String, bare: String = this.bare) => spec is Document
    ? (spec.path ? Project.Dependency(location: spec.path, kind) : spec.git ? Project.Dependency(location: spec.git, kind) : depending(spec.package ?? name, spec.version ?? "*", kind, bare))
    : spec ~= ⊢("file:" | "link:") ? Project.Dependency(location: spec.after(":"), kind)
    : spec ~= "://" || spec ~= ⊢("git+" | "github:") ? Project.Dependency(location: spec, kind)
    : Project.Dependency(location: ecosystem + "/" + name, version: ranges.parsed(spec as String, bare), kind)
  required (project: Project, kind: String) => Document(entries: project.dependencies{.kind == kind}.map((name: .name, value: .version ? .version as String : "*")))
  described (project: Project) => [(name: "name", value: project.name), (name: "version", value: project.version as String) if project.version, (name: "description", value: project.description) if project.description]
}
