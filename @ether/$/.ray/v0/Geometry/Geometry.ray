Point := Ray
Path | Curve | Line := Array.Unbounded

Geometry := namespace {
  Vector := class = x: Number = 0, y: Number = 0, z: Number = 0 {
    + (other: Vector) => Vector(x + other.x, y + other.y, z + other.z)
    - (other: Vector) => Vector(x - other.x, y - other.y, z - other.z)
  }

  // Padding is a hierarchical object around a shape: a ball with padding is still a ball.
  Shape := class: Ray = position: Vector = Vector(), size: Vector = Vector(), spacing: Spacing[] = [], constraints: Constraint[] = [], children: Shape[] = [], flow: Flow = vertical {
    + (component: Spacing | Constraint) => (component ==.instance_of Spacing ? spacing : constraints).push component -- this
    holding (child: Shape) => children.push child -- this
    outer => size + spacing{.from == border}.amount.reduce(acc = Vector() => acc + . + .)
  }
  Box := class: Shape
  Ball := class: Shape {
    radius => size.x / 2
  }
  Circle := class: Ball = centre: Point {
    outline (count: Number) => (0..<count).map(Polar(centre, radius, turn: ., of: count)).loop
  }
  Polar := class = centre: Point, radius: Number, turn: Number, of: Number

  Flow := enum vertical | inline
  Side := enum all | top | bottom | left | right | horizontal | vertical
  Align := enum start | center | end | between | middle
  Relation := enum against | next_to | above | below | inside

  Spacing := class = amount: Vector = Vector(), from: From = border, sides: Side = all {
    static From := enum border | shape
  }
  Constraint := class = dimension: String, least: Number?, most: Number?, share: (Number | Interpolated)?, align: Align? {
    admits (length: Number) => (!least || least <= length) && (!most || length <= most)
  }

  // `md 6 -> lg 4`: a share interpolated between breakpoints.
  Breakpoint := class = width: Number, share: Number {
    -> (other: Breakpoint) => Interpolated(from: this, to: other)
  }
  Interpolated := class = from: Breakpoint, to: Breakpoint {
    at (width: Number) => width < from.width ? from.share
      : to.width < width ? to.share
      : from.share + (to.share - from.share) * (width - from.width) / (to.width - from.width)
  }

  Placed := class = item: Shape, relation: Relation, other: Shape
  related (item, relation, other) => Placed(item, relation, other)

  Solver := class = available: Number {
    length (shape: Shape, width: Number) => shape.constraints{.dimension == "x"}.reduce(acc = width => (
      .share ? (.share ==.instance_of Interpolated ? .share.at(width) : .share) * width : acc
    ) max (.least ?? 0) min (.most ?? ∞))

    solve (shape: Shape) => place(shape, Vector(), available)
    place (shape: Shape, origin: Vector, width: Number) => shape -- {
      own = length(shape, width)
      size = Vector(own, size.y)
      position = origin
      children.reduce(acc = origin => {
        child_width = length(., own)
        offset = .constraints.align.last == center ? (own - child_width) / 2 : .constraints.align.last == end ? own - child_width : 0
        flow == inline
          ? place(., Vector(acc.x + offset, acc.y), child_width) -- Vector(acc.x + child_width, acc.y)
          : place(., Vector(origin.x + offset, acc.y), child_width) -- Vector(origin.x, acc.y + .size.y)
      })
    }
  }
}

// Alignment words keep their block.
[center: Align.center, right: Align.end, left: Align.start, between: Align.between].for (word, align) => {
  `word` ^keyword {block} => (Geometry.Box() + Geometry.Constraint(dimension: "x", align)).holding(inline block)
}
middle ^keyword {block} => (Geometry.Box() + Geometry.Constraint(dimension: "y", align: Align.middle)).holding(inline block)

// The spacing shorthands: p/m with a side, from the border or from the shape.
[p: all, px: horizontal, py: vertical, pt: top, pb: bottom, pl: left, pr: right].for (word, side) => {
  `word` {amount: Number} ^keyword => Geometry.Spacing(amount: Vector(amount if side != vertical, amount if side != horizontal), sides: side)
  `word.replace("p", "m")` {amount: Number} ^keyword => Geometry.Spacing(amount: Vector(amount if side != vertical, amount if side != horizontal), sides: side, from: shape)
}

// Breakpoints
[xs: 0, sm: 576, md: 768, lg: 992, xl: 1200].for (word, width) => {
  `word` {share} ^keyword => Geometry.Breakpoint(width, share)
}
