
// Expression: a language read from its own text. Its first line says how a rule is written: `!language`, the brackets a
// hole is written in (`{ }`), then the rule that makes rules, written with them (`{LHS} => {RHS}`). Every statement after it
// is read in a node by the longest of that node's rules that reads it; the rule that makes rules adds one there, its head
// read the same way, its body read when it is applied, in a node of its own whose caller is what applied it. Only four
// things are given: `external .` (a node), `external &` (what applies), `external goto` and `external label` (where control
// goes). Read under a level, `Program{O: …}`, what it reads is a Program (statements as vertices, gotos as edges), and a
// back end is one more level: `Wasm` writes that Program as WebAssembly.
NodeX := None
ProgramX := None
StatementsX := None
globalX := None
Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    // (a hole's brackets, a space where its name goes)
    CAPTURE: (String+, \s, String+),
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}(`LHS`) | RHS: CAPTURE.map{== \s}(`RHS`) | String)[],
    \n\n
  ),
  (
    // (the rule that makes rules: any space in it any amount of space, each hole anything, its left side a head of the same
    // shape again, `[LHS: [LHS, RHS], RHS]`; the first statement)
    Code := (BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Code) | String)[]
    Head := (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (inside: Code)) | String)[]
    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES.map{is \s}((space) => \s[])
    GRAMMAR_RULE_DEF.RHS = Code
    GRAMMAR_RULE_DEF.LHS = Code
    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF
    
    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,
    statements: (
      // A node: its rules by their heads; what it does not read, what it is in reads.
      Node := class (in?: Node) => {
        // (itself, as its rules' bodies name it: `this` there is what a statement calls them on)
        node := this
        rules := {
          [rule: GRAMMAR_RULE.LHS] := (caller) => {
            // (the node its body is read in, kept with it: what it reads there, its statements, is its body)
            body := Node(in: node)
            head := (rule.LHS as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => node.named(hole.inside))
            rules[[head]] := (caller) => {
              at := Node(in: body)
              holes.for((hole) => {
                at.rules[[hole.key]] := (c) => caller.in.named_by(hole.value, caller)
                at.rules[[BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => caller.in.named_by(hole.value, caller)
              })
              me := applied
              me.caller = caller
              me.in = at
              me.this = caller.this
              r := (rhs: Statements(at) = rule.RHS)
              r(me)
            }
            rules[[head]].body = body
          }
          [{value: concurrently node.prefix(.)}: node.keys, rest: String] := (caller) => {
            v := value(caller)
            on := Node(in: caller.in)
            members(v).for((m) => on.rules[[m.key]] := (c) => m.value)
            r := (rs: Statements(on) = rest)
            me := applied
            me.caller = caller
            me.in = on
            me.this = v
            r(me)
          }
        }
        named (text) => named_by(text, Program(in: node))
        named_by (text, by) => {
          v := (vs: Statements(node) = text)
          (v === None) ? Place(text, node) : v(by)
        }
        split_key := rules.keys.last
        maker_key := rules.keys.first
        whole (tx) => (((rules.keys.first === maker_key) ? (tx ~= maker_key) : false) ? maker_key : rules.keys{(. === split_key) ? false : (tx ~= .)}#.sort(.length).last) ?? in?.whole(tx)
        prefix (tx) => rules.keys{(. === split_key) ? false : (tx ~= .)}#.sort(.length).last ?? in?.prefix(tx)
        longer (lw, ls) => (lw === None) ? ls : ((ls === None) ? lw : ((ls.length > lw.length) ? ls : lw))
        reading (tx) => {
          w := whole(tx)
          (w === maker_key) ? w : longer(w, (split_key === None) ? None : ((tx ~= split_key) ? split_key : None))
        }
        keys => (in === None) ? rules.keys : ((rules.keys === None) ? in.keys : (rules.keys | in.keys))
      }
      // A program running: what applied it, where it is.
      Program := class (caller?: Program, at?: Statement, in?: Node, this?: Node) => { }
      Argument := class (\s+, word: String) => { }
      global := Node({
        rules[`external`, \s+, rule: String, args: Argument[]] := (caller) => {
          `.` => Node(in: caller.at.node)
          `&` => caller
          `goto` (label: Node, condition?: Node) => caller.at = label if condition ?? true
          `label` (label: Node) => label
          `style` (style_args) => style_args.last
          `shown` (shown_args) => shown_args.first
        }[rule](args.map((argument) => caller.in.named(argument.word)))
      })
      // Statements: each, after any space, read by the longest rule that reads it (all at once, where they can be); run in
      // order, each given what applies them.
      Statement := class (
        leading_whitespace?: (\s | \n)[]+,
        {statement: concurrently context.reading(.)}: context.keys
      ) => {}
      // (the statements as read kept on the node they are read in, `statements`: what each read, its rule and what that took)
      Statements (context: Node) => dynamically Statement[] & (caller: Program) => (
        context.statements = .
        .statement#.map((s) => s(caller)).last
      )

      NodeX = Node
      ProgramX = Program
      StatementsX = Statements
      globalX = global
      Statements(global)(Program(in: global))
    ),
    (\s | \n)[]
  )
) => {

}
ex := (level input_part 0) as Expression
parse_node_of (grammar_text) => {
  g := NodeX(in: globalX)
  (gs: StatementsX(g) = grammar_text)(ProgramX(in: g))
  p := NodeX()
  level moved_keys (g) (p)
  leaf := NodeX(in: globalX)
  (ls: StatementsX(leaf) = "{name_word} => external &")(ProgramX(in: leaf))
  p.split_key = leaf.rules.keys.last
  p
}
parser (grammar, program_text) => {
  grammar.parse_node = grammar.parse_node ?? parse_node_of(grammar.text)
  level curried_value (ps: StatementsX(grammar.parse_node) = program_text)
}
level set_parser (parser)
assert "!language   { }   {LHS} => {RHS}\n\n" as Expression -- .(
  .BOOTSTRAPPER.CAPTURE == `{ }`
  & .BOOTSTRAPPER.CAPTURES.LHS == `{LHS}`
  & .BOOTSTRAPPER.CAPTURES.RHS == `{RHS}`
)
// (its parts, each in turn)
assert {
  Ranged2 := class low: Decimal, "-", high: Decimal { }
  ranged2: Ranged2 = 3-8
  assert ranged2.high == 8  // ZZ1
  assert (`2-7` as Ranged2).high == 7  // ZZ2
  Ranged3 := class (low: Decimal, "-", high: Decimal) => { }
  ranged3: Ranged3 = 3-8
  assert ranged3.high == 8  // ZZ3
  Ranged4 := class (low: String+, "-", high: String+) => { }
  ranged4: Ranged4 = 3-8
  assert ranged4.high == "8"  // ZZ4
  Ranged5 := class (low: String+, `-`, high: String+) => { }
  ranged5: Ranged5 = 3-8
  assert ranged5.high == `8`  // ZZ5
  assert (`3-8` as Ranged5).high == `8`  // ZZ6
  Ranged6 := class (low: String+, \s, high: String+) => { }
  assert (`3 8` as Ranged6).high == `8`  // ZZ7
}
assert `{ }` is (String+, \s, String+)  // EX1 a hole's brackets around a space are not a capture
assert {
  Headed := class (head: `!language`, \s[]+, rest: String) => { }
  assert (`!language  x` as Headed).rest == `x`  // EX2 a text read as a structure does not give its last field what follows the space
}
assert {
  Captured := class (left: String+, \s, right: String+) => { }
  assert (`{ }` as Captured).left == `{`  // EX3 a text read as a structure does not give its first field the text before the space
}
assert {
  Inner := class (left: String+, \s, right: String+) => { }
  Outer := class (inner: Inner, `;`) => { }
  assert (`{ };` as Outer).inner.left == `{`  // EX4 a field of a structure is not read as its own structure
}
assert {
  Nested := class (inner: (left: String+, \s, right: String+), `;`) => { }
  assert (`{ };` as Nested).inner.right == `}`  // EX5 a field written as a structure is not read as one
}
assert {
  Spanned := class (spanned: (String+, \s, String+), `;`) => { }
  assert (`{ };` as Spanned).spanned == `{ }`  // EX6 a field written as positions does not take their span
}
assert `{LHS}` is `{ }`.map{== \s}(`LHS`)  // EX7 a text's space mapped to LHS does not read {LHS}
assert !(`{ }` is `{ }`.map{== \s}(`LHS`))  // EX9 a text's space mapped to LHS still reads the space
assert {
  Dependent := class (open: String, \s, close: open) => { }
  assert (`a a` as Dependent).close == `a`  // EX8 a field's type does not see a field before it
}
assert {
  Scoped := class (
    (
      statements: (
        Seen := 46
        Node := class (marked?: Node) => { mark := 1 }
        Inner := class (in?: Inner) => {
          rules := { got := (x) => Seen }
          made => Node()
        }
        got_seen := Inner().rules.got(0)
        made_mark := Inner().made.mark
        String
      )
    )
  ) => { }
  scoped := "x" as Scoped
  assert (external member (scoped) (`got_seen`)) == 46  // EX10 a closure in a class written in a header's statements does not see the header's names
  assert (external member (scoped) (`made_mark`)) == 1  // EX11 a class's `Node` written in a header's statements is the language's
}
