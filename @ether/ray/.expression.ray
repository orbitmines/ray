{pattern} => {functionality} =>
  Expression |= pattern => functionality
{expression dynamically Expression} => expression
//{comment} => None
{statement} //{comment} => statement
//{comment} => {functionality} =>
  None

// Brackets: what is between them, read as one; a block, a context of what it declares.
({inside}) => inside
{{inside}} =>
  made := @made None
  @block made inside
  made &+= { inside }

// `static statement` in a class: the statement (before the modifiers below, which read `static` off a definition).
static {statement} => (@has & given) ? None : statement

// Text written in quotes: a String (its characters).
"{text}" => @text text

// `x &+= { … }`: the block read into `x` (what it defines is `x`'s).
{target Expression} &+= {{block target}} => target

// `name := (a, b) => body`: the name is a closure.
{name} := ({parameters}) => {functionality} =>
  name => ((parameters) => functionality)

// ---------------------------------------------------------------- names, brackets, blocks, members
// `x -- call`: `call` read with `this` being `x` (a closure it answers, applied to `x`); `x ~~ call`: the same, answering `x`. They
// go on from everything before them (A-C5): declared first, they bind loosest.
Node &+= {
  -- {call} =>
    answer := this with { call }
    (@applies answer) ? answer(this) : answer
  ~~ {call} =>
    answer := this with { call }
    (@applies answer) ? answer(this) : answer
    this
  // `x := v`: `v` at the place `x` was read at, from here on; `x = v`: where `x` is declared; `x &= v`: `v` at the end of the Ray `x`
  // holds (a Ray of it, when it holds nothing).
  := {value Expression} => @declare value
  = {value Expression} => @assign value
  &= {value Expression} => @assign ((this ?? []).append(value))
}
// `x with { … }`: the block read with `x` as what it is read in, answering what the block answers.
{target Expression} with {{block target}} => block
// `x.rest`: the rest read by `x` (its own, then its class's, then the base's): `x.m`, `x.m(a)`. `f(a, b)`: the arguments read by
// `f` (a closure: its parameters; a class: its construction); `f()`: `f` itself.
Node &+= {
  .{rest this} => rest
  ({arguments this}) => arguments
  () => this
}

// ---------------------------------------------------------------- what holds (T1.7): every value but nothing and false
true := @made Node
false := @made Node
Node &+= {
  ? {yes} : {no} => yes
  || {other} => this
  && {other} => other
  ?? {other} => this
}
None &+= {
  ? {yes} : {no} => no
  || {other} => other
  && {other} => this
  ?? {other} => other
}
false &+= {
  ? {yes} : {no} => no
  && {other} => this
  || {other} => other
}
!{x} => x ? false : true
{a} === {b} => @same a b
{a} !== {b} => (@same a b) ? false : true
@me/instance = {x} => @show x

// ---------------------------------------------------------------- heads: what a definition's head says (R0.1 on)
// A head is read where only what reads heads reads (`@context`, a context of its own): as written, or what is said of one:
// `p | q` (both), `p ^style` (how it is shown), `static p`, `chainable p`, `right-to-left p` (applied with what is on its right),
// `p (parameters)` (a method), `p: T` (what it gives). What is inside a capture, and a method's parameters: a name, `x: T` (what
// reads it), `x = d` (what it is, not given), `a, b` (one after the other), `x ^style`, `literal x`, `=== T` (given a `T`),
// `` `text` `` (text as written), `"x"?` (text that may be written). Each is said of a Pattern (below), which writes the forms the
// head is defined as.
Defaulted := @outside ", " None
// (a type is not led by a capture: `class: {parent} …` is written as it is)
Opened => @js $.reader(s => s.startsWith($.learned.open) ? s : undefined)
Unspaced := @outside " " None
Typed := @outside " ^" (@outside " = " Defaulted)
Captured := @context None
Captured &+= {
  {first Captured}, {rest Captured} => first.then(rest)
  {parameter Captured} = {default Defaulted} => parameter.defaulting(@text default)
  {parameter Captured} ^{style Word} => parameter
  {name Word}: {type Typed} => (Pattern.of(@text name)).typed(@text type)
  {name Word} => Pattern.of(@text name)
  literal {parameter Captured} => parameter
  === {type Typed} => (Pattern.of("given")).typed(@text type)
  `{text}` => Pattern.literally(@text text)
  {written Typed}? => (Pattern.of("optional")).typed(@joined (@text written) "?")
}
Head := @context None
Head &+= {
  {pattern} ^{style Word} => Pattern.head(@text pattern)
  {pattern} | {alias} => (Pattern.head(@text pattern)).or(Pattern.head(@text alias))
  static {pattern} => (Pattern.head(@text pattern)).restated
  chainable {pattern} => (Pattern.head(@text pattern)).restated
  right-to-left {pattern} => (Pattern.head(@text pattern)).leftward
  {pattern} ({parameters Captured}) => (Pattern.head(@text pattern)).taking(parameters)
  {pattern}({parameters Captured}) => (Pattern.head(@text pattern)).taking(parameters)
  {pattern} () => (Pattern.head(@text pattern)).taking(None)
  {pattern}() => (Pattern.head(@text pattern)).taking(None)
  ({parameters Captured}) => Pattern.unnamed.taking(parameters)
  {pattern} ({parameters Captured}): {type Typed} => (@read Opened (@text type)) ? None : (Pattern.head(@text pattern)).taking(parameters)
  {pattern}({parameters Captured}): {type Typed} => (@read Opened (@text type)) ? None : (Pattern.head(@text pattern)).taking(parameters)
  {name Word}: {type Typed} => (@read Opened (@text type)) ? None : Pattern.of(@text name)
}

// ---------------------------------------------------------------- what a head says: a Pattern, and the forms it is defined as
Pattern := @made Node
Pattern &+= {
  // a head as written (a capture, `{x}`, named so); a symbol hugs what it is given; a name: one word, not a capture
  of({text}) =>
    made := @made Pattern
    made.written := text
    made
  hugs => this.nameless ? this : (@read Symbolic this.written)
  named => (@read Opened this.written) ? None : (@read Unspaced this.written)
  // a method without a name (a closure's parameters)
  unnamed =>
    made := Pattern.of("")
    made.nameless := made
    made
  // text written as it is
  literally({text}) =>
    made := Pattern.of(text)
    made.literal := made
    made
  // what `Head` reads a text as, else the text as written
  head({text}) =>
    written := text
    (@read Head written) ?? Pattern.raw(written)
  raw({text}) =>
    made := Pattern.of(text)
    made.unread := made
    made
  // what a word said of it leaves: as written, the definition read again with it
  restated =>
    (this.takes || this.alias || this.receiving) ? None : (this.unread ? (this.again := this) : None)
    this
  // each form a head is defined as (none: as written); what is inside a capture, written as captures are (none: as written)
  heading({text}) =>
    read := @read Head text
    read ? read.formed : None
  capture({text}) =>
    read := @read Captured text
    read ? read.listed : None
  // `p | q`: both names
  or({other}) =>
    alias := other
    // (a name beside a method takes what it takes: `min | min_by (key)`)
    (alias.takes && !this.takes) ? this.took(alias.parameters) : None
    (this.named && alias.named) ? this.aliased(alias) : None
  aliased({other}) =>
    alias := other
    this.alias := this.alias ? alias.aliased(this.alias) : alias
    this
  typed({type}) =>
    this.type := type
    this
  defaulting({value}) =>
    this.default := value
    this
  then({rest}) =>
    more := rest
    this.next := this.next ? this.next.then(more) : more
    this
  // a method (named), given its parameters
  taking({parameters}) =>
    given := parameters
    this.named ? this.took(given) : None
  took({parameters}) =>
    this.parameters := parameters
    this.takes := this
    this
  leftward =>
    this.receiving := this
    this.alias ? this.alias.leftward : None
    this
  // as a capture, `{name reader}` (or the text it is); all of them, one after the other (text joined by the interpreter: what
  // reads a head is read before any class, `String` too)
  captured => this.literal ? this.written : @joined (@joined @open (this.type ? (@joined (@joined this.written " ") this.type) : this.written)) @close
  listed => this.next ? (@joined (@joined this.captured ", ") this.next.listed) : this.captured
  // each form it is defined as: a method as called, `m(a, b)`, and given what follows it, `m a, b` (a symbol hugging it, `+b`; one
  // without a name, only that); one applied right to left, with what is on its right (`this`); else as written
  formed =>
    this.alias ? this.alias.formed : None
    this.again ? (@again this.written) : this.form
  form =>
    this.takes ? this.called : (this.receiving ? (@applied (@joined (@joined this.written (this.hugs ? "" : " ")) (@joined (@joined @open "receiver") @close)) "receiver") : (@form this.written ""))
  called =>
    after := this.hugs ? "" : " "
    this.nameless ? None : (this.parameters ? this.parameters.forms((@joined this.written "("), "", ")", "") : (@form (@joined this.written "()") ""))
    this.parameters ? this.parameters.forms((@joined this.written after), "", "", "") : None
  // the forms of the parameters from this one on, after `before` (each after `between`), then `after`; one not given: declared
  forms({before}, {between}, {after}, {given}) =>
    start := before
    sep := between
    closing := after
    declared := given
    full := @joined (@joined start sep) this.captured
    this.next ? this.next.forms(full, ", ", closing, declared) : (@form (@joined full closing) declared)
    this.default ? (this.next ? this.next.forms(start, sep, closing, (this.declared(declared))) : (@form (@joined start closing) (this.declared(declared)))) : None
  declared({given}) => @joined (@joined (@joined (@joined given this.written) " := ") this.default) @end
}
@captures Captured (written => Pattern.capture(written))
@heads Head (written => Pattern.heading(written))

// `X<K = D, V> := class …`: the class, each parameter a name of it (its default, or nothing).
{name Word}<{parameters}> := {value: Expression} =>
  made := value
  reading := @made None
  reading &+= {
    {parameter Word} => made &+= { parameter := None }
    {parameter Word} = {default} => made &+= { parameter := default }
    {parameter Word}, {rest: reading} => made &+= { parameter := None }
    {parameter Word} = {default}, {rest: reading} => made &+= { parameter := default }
  }
  reading with { parameters }
  & &+= { name := made }


// ---------------------------------------------------------------- control flow (P2.8: an `if` answers what its taken block answers)
Branch := @made Node
Branch &+= {
  of (taken, answer) =>
    made := @made Branch
    made.taken := taken
    made.answer := answer
    made
  else {{otherwise}} => this.taken ? this.answer : otherwise
  elsif {condition} {{yes}} => this.taken ? this : (condition ? Branch.of(true, yes) : this)
}
if {condition} {{yes}} => condition ? Branch.of(true, yes) : Branch.of(None, None)
unless {condition} {{yes}} => condition ? Branch.of(None, None) : Branch.of(true, yes)
// (`while c { body }`: the body again while `c` holds; iterating is the interpreter's (`js.ray`))

// ---------------------------------------------------------------- Rays (`a, b`): vertices in order (`head`, `tail`; each `value`, `next`, `previous`)
Ray := @made Node
Vertex := @made Node
Ray &+= {
  append (value) =>
    link := @made Vertex
    link.value := value
    if this.tail {
      this.tail.next := link
      link.previous := this.tail
    } else {
      this.head := link
    }
    this.tail := link
    this
  take =>
    first := this.head
    this.head := first ? first.next : None
    first ? first.value : None
  prepend (value) =>
    vertex := @made Vertex
    vertex.value := value
    if this.head {
      this.head.previous := vertex
      vertex.next := this.head
    } else {
      this.tail := vertex
    }
    this.head := vertex
    this
  some (predicate) =>
    found := None
    at_vertex := this.head
    while at_vertex {
      if predicate(at_vertex.value) { found = true }
      at_vertex = found ? None : at_vertex.next
    }
    found ?? false
  , {other: Expression} => this.append(other)
  first => this.head ? this.head.value : None
  last => this.tail ? this.tail.value : None
  empty => this.head === None
  without (x) =>
    made := []
    at_link := this.head
    while at_link {
      unless at_link.value === x { made.append(at_link.value) }
      at_link = at_link.next
    }
    made
  rest =>
    made := []
    at_link := this.head ? this.head.next : None
    while at_link {
      made.append(at_link.value)
      at_link = at_link.next
    }
    made
  map (mapping) =>
    made := []
    at_link := this.head
    while at_link {
      made.append(mapping(at_link.value))
      at_link = at_link.next
    }
    made
  for (body) =>
    at_link := this.head
    while at_link {
      body(at_link.value)
      at_link = at_link.next
    }
    this
}
Node &+= {
  , {other: Expression} => (@made Ray).append(this).append(other)
}
[] => @made Ray
[{inside: Expression}] => inside === None ? (@made Ray) : ((@of inside) === Ray ? inside : (@made Ray).append(inside))
// `(x, y) := a, b`: each name, the value in its place.
({first Word}, {rest}) := {value: Expression} =>
  first := value.first
  (rest) := value.rest
({name Word}) := {value: Expression} => name := ((@of value) === Ray ? value.first : value)

// ---------------------------------------------------------------- classes (A7): the block is the constructor; what it defines, the class's too
Node &+= {
  read_into (instance) => instance
}
Class := @made Node
Class &+= {
  // an instance: given its arguments (by name, then in order), the blocks of what it is made of read into it
  // (its arguments read into it while it names: `name: value` gives it that field, answering it; what it is given in order, the
  // rest)
  instance_of (made, arguments) =>
    instance := @made made
    instance &+= { naming := true }
    in_order := [@given instance arguments].without(instance)
    instance &+= { given := in_order }
    instance &+= { naming := None }
    made.read_into(instance)
    instance
  made_of (parent, header, block) =>
    made := @made (parent ?? Node)
    made &+= {
      read_into (instance) =>
        (@of made).read_into(instance)
        instance &+= { header }
        instance &+= { block }
        instance
      ({arguments}) => Class.instance_of(made, arguments)
      () => Class.instance_of(made, None)
      // what it is made of: its hierarchy, the classes it is one of
      components := (@made Node) &+= { hierarchy := [] }
    }
    made &+= { header }
    made &+= { block }
    made
}
// `T + { … }`: a class made of `T` with what the block declares (both its components)
Node &+= {
  + {{block}} =>
    added := Class.made_of(None, None, block)
    made := Class.made_of(this, None, block)
    made.components.hierarchy := [this, added]
    made
}
// `X := class (header) => { block }`: read as a definition is read (its `=>` is the class's)
{name Unspaced} := class {header} => {{block}} =>
  name := Class.made_of(None, header, block)
{name Unspaced} := class: {parent} {header} => {{block}} =>
  name := Class.made_of(parent, header, block)
class {{block}} => Class.made_of(None, None, block)
class: {parent} {{block}} => Class.made_of(parent, None, block)
class {header} {{block}} => Class.made_of(None, header, block)
class: {parent} {header} {{block}} => Class.made_of(parent, header, block)
class: {parent} {header} => Class.made_of(parent, header, None)
class {header} => Class.made_of(None, header, None)
class: {parent} => Class.made_of(parent, None, None)
// `name: T`, `name: T = default`: a field, given by name, else in order, else its default.
{name Word}: {type} => &.naming ? (& &+= { name := type }) : ((@has & given) ? ((@has & name) ? None : (& &+= { name := &.given.take })) : None)
{name Word}: {type} = {default} => (@has & given) ? ((@has & name) ? None : (& &+= { name := &.given.take ?? default })) : ((@has & components) ? None : (& &+= { name := default }))

// ---------------------------------------------------------------- guards: `x if c`, `x unless c` (declared after `,`: `x if c, y` is `(x if c), y`)
{guarded} if {condition} => condition ? guarded : None
{guarded} unless {condition} => condition ? None : guarded

// ---------------------------------------------------------------- superposition (U1): `a | b`, both; `T?`, `None | T`
Superposition := @made Node
Node &+= {
  | {other: Expression} =>
    made := @made Superposition
    made.superposes := true
    made.components := [this, other]
    made
}
{value}? => None | value
Superposition &+= {
  | {other: Expression} =>
    this.components.append(other)
    this
}

// ---------------------------------------------------------------- enums: `enum a | b (field: v) | c { block }`, a class of exactly these members
// The members are read by rules of their own (R2.3: not the enum's members), each member, then the rest.
Enum := @made Node
Enum &+= {
  first_member (name, fields) =>
    member := @made this
    member &+= { naming := true }
    member &+= { fields }
    member &+= { naming := None }
    this &+= { name := member }
    this.members := (this.members ?? []).prepend(member)
    this
}
enum {members} =>
  made := @made Enum
  reading := @made None
  reading &+= {
    {name Word} => made.first_member(name, None)
    {name Word} ({fields}) => made.first_member(name, fields)
    {name Word} | {rest: reading} => made.first_member(name, None)
    {name Word} ({fields}) | {rest: reading} => made.first_member(name, fields)
  }
  reading with { members }
  made
enum {members} {{block}} => (enum members) &+= { block }
boolean := enum false (holds: None) | true (holds: true) {
  not => this.holds ? false : true
  and (b) => this.holds ? b : this
  or (b) => this.holds ? this : b
}
true := boolean.true
false := boolean.false
false &+= {
  ? {yes} : {no} => no
  && {other} => this
  || {other} => other
}

// ---------------------------------------------------------------- types (T4.10): `x is T`; `T{p}`, what `T` holds of which `p` holds
Narrowing := @made Node
Node &+= {
  {{constraint}} =>
    made := @made Narrowing
    made.narrows := this
    made.constraint := (it => it with { constraint })
    made
  is {type: Expression} => (@inside this type) || (type.superposes && type.components.some((component) => this is component)) || (type.narrows && (this is type.narrows) && type.constraint(this)) || (@same this type)
}

// `T[]`: one `T` after another, a type of text read as a run of what `T` reads
Listing := @made Node
Node &+= {
  [] =>
    made := @made Listing
    made.of := this
    made
}

// ---------------------------------------------------------------- the core the library extends: an Iterable of `Vertex`, an Array, text, numbers
Iterable<Vertex> := class { }
Array := class: Iterable { }
// text (String.ray adds the rest): an Array of its characters
String := class: Array { }
Number := class { }
Char := class: Number { }
// a program (P1): code, read where it was written (`context`); with `parameters`, a closure of them
Program := class {
  code: Node?
  parameters: Node?
  context: Node?
  O: Node?
  // `p{O: level}`: the program, given what the block names
  {{given}} =>
    this &+= { naming := true }
    this &+= { given }
    this &+= { naming := None }
    this
  // run: its code read again, with the rules of its level in scope (a block's code: what the block was made of)
  () => @run this
}
// a diagnostic (R5.1)
Diagnostic := class {
  message: Node
  type: Node
  fatal: Node
}
