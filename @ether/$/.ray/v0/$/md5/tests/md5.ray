// MD5 digests of RFC 1321's test suite (https://www.rfc-editor.org/rfc/rfc1321#appendix-A.5).

mark ^keyword := external global

// MD5 ("") (RFC 1321 §A.5)
unless MD5.write([]) as Byte¹⁶ as Hexadecimal³² == "d41d8cd98f00b204e9800998ecf8427e" { INFO@mark `MD1 the empty string does not digest as in RFC 1321's test suite` }
// MD5 ("a") (RFC 1321 §A.5)
unless MD5.write("a".bytes) as Byte¹⁶ as Hexadecimal³² == "0cc175b9c0f1b6a831c399e269772661" { INFO@mark `MD2 a does not digest as in RFC 1321's test suite` }
// MD5 ("abc") (RFC 1321 §A.5)
unless MD5.write("abc".bytes) as Byte¹⁶ as Hexadecimal³² == "900150983cd24fb0d6963f7d28e17f72" { INFO@mark `MD3 abc does not digest as in RFC 1321's test suite` }
// MD5 ("message digest") (RFC 1321 §A.5)
unless MD5.write("message digest".bytes) as Byte¹⁶ as Hexadecimal³² == "f96b697d7cb7938d525a2f31aaf161d0" { INFO@mark `MD4 message digest does not digest as in RFC 1321's test suite` }
// MD5 ("abcdefghijklmnopqrstuvwxyz") (RFC 1321 §A.5)
unless MD5.write("abcdefghijklmnopqrstuvwxyz".bytes) as Byte¹⁶ as Hexadecimal³² == "c3fcd3d76192e4007dfb496cca67e13b" { INFO@mark `MD5 the alphabet does not digest as in RFC 1321's test suite` }
// MD5 ("A…Za…z0…9"), 62 bytes, its length spilling into a second block (RFC 1321 §A.5)
unless MD5.write("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".bytes) as Byte¹⁶ as Hexadecimal³² == "d174ab98d277d9f5a5611c2c9f419d9f" { INFO@mark `MD6 the 62 letters and digits do not digest as in RFC 1321's test suite` }
// MD5 ("1234567890" eight times), 80 bytes (RFC 1321 §A.5)
unless MD5.write(("1234567890" * 8).bytes) as Byte¹⁶ as Hexadecimal³² == "57edf4a22be3c955ac49da2e2107b67a" { INFO@mark `MD7 eighty digits do not digest as in RFC 1321's test suite` }
// T[1] and T[64], 4294967296 times abs(sin(i)) (RFC 1321 §3.4)
unless MD5.T.first == 0xd76aa478 && MD5.T.last == 0xeb86d391 && MD5.T.count == 64 { INFO@mark `MD8 the sine table is not that of RFC 1321 §3.4` }
