// Equality: the same node, or one alike in structure: two lists, their first alike and the rest of them alike.
chainable == (other) => (. === other) || (((.listing === true) && ((other).listing === true)) ? (.empty ? other.empty : ((!other.empty) && (.first == other.first) && (.rest == other.rest))) : false)
chainable != (other) => !(. == other)
assert true == true  // RE1 a value is not equal to itself
assert 1 != 2  // RE11 one is two
assert !(1 != 1)  // RE12 one is not one
assert !(true == false)  // RE2 two values are equal
assert [1, 2] == [1, 2]  // RE3 two lists of the same are not equal
assert !([1, 2] == [1, 3])  // RE4 two lists that differ are equal
assert !([1, 2] == [1])  // RE5 a list is equal to a shorter one
assert [] == []  // RE6 two empty lists are not equal
assert {
  A := class { }
  a := A()
  assert a == a  // RE7 an instance is not equal to itself
}
assert [1, 2].count == 2  // RE8 a list of two does not count two
assert [1, 2, 3].rest.count == 2  // RE9 the rest of three is not two
assert {
  Counting := class {
    counted => {
      n := 0
      n = n + 1
      n
    }
  }
  assert Counting().counted == 1  // RE10 `=` in a method of a class written without fields did not change its local (the class's own field was named as a hole of the rule constructing it)
}
// Sorted: what is before the first, sorted, the first, and what is not before it, sorted; by a key, `.sort(.length)`, what
// the key answers for each.
Ray &+= {
  sort => .sort_by((x) => x)
  sort_by (key) => {
    pivot := .first
    smaller := .rest.select((x) => key(x) < key(pivot))
    larger := .rest.select((x) => !(key(x) < key(pivot)))
    .empty ? [] : smaller.sort_by(key).joined([pivot]).joined(larger.sort_by(key))
  }
  // (where a value is among them, from 0; not among them, nothing)
  index_of (wanted) => .index_from(wanted, 0)
  index_from (wanted, at) => .empty ? None : ((.first == wanted) ? at : .rest.index_from(wanted, at.succ))
  // (what a predicate holds of, in order)
  select (predicate) => {
    kept := Ray.new
    .for((x) => (kept.append(x) if predicate(x)))
    kept
  }
}
assert [2, 1].sort.first == 1  // RS1 two and one sorted do not begin with one
assert [3, 1, 2].sort == [1, 2, 3]  // RS2 three, one and two sorted are not one, two and three
assert [].sort.empty  // RS3 nothing sorted is something
assert [5, 6, 7].index_of(6) == 1  // RX1 six is not second among five, six and seven
assert !([5, 6].index_of(7))  // RX2 seven is among five and six
assert ["bb", "a"].sort_by((x) => x.count).first == "a"  // RS4 sorted by their counts the shortest is not first
// (the original Iterable's, staged: what a list answers)
Ray &+= {
  // (the rest of it turned around, then its first: `,` binds loosest, so the branch is in brackets)
  reverse => empty ? [] : (rest.reverse, first)
  assert [1, 2].reverse.reverse == [1, 2]  // CO27 turned around twice is not as it was
  assert ([1, 2, 3]).reverse == [3, 2, 1]  // IT5 turned around, one, two and three are not three, two and one
  assert ([1, 2, 3]).reverse.count == 3  // IT7 turning a list around loses something
}
// What is ordered: given what is below what (`<`, its own), what is above, at most, at least, the smaller, the larger, and
// a range, from this to the last, one after another (`succ`, or `pred` going down), both ends in it (`..<`: without the last).
Ordered := class (T = static) => {
  chainable > (b: T) => b < this
  chainable <= (b: T) => this == b || this < b
  chainable >= (b: T) => this == b || this > b
  min (b: T) => this <= b ? this : b
  max (b: T) => this >= b ? this : b
  .. (last: T) => this == last ? [this] : ((this < last ? succ : pred)..last).prepend(this)
  ..< (last: T) => this == last ? [] : ((this < last ? succ : pred)..<last).prepend(this)
}
Number &+= Ordered
assert 3 > 2 > 1  // PR16 three above two above one does not hold
assert !(1 > 2 > 3)  // PR17 one above two above three holds
assert 3 >= 2 >= 1  // PR20 a chain of at-leasts does not hold
assert 5.min(3) == 3  // RM8 the smaller of five and three is not three
assert 2.min(5) == 2  // N67 the smaller of two and five is not two
assert 5.max(3) == 5  // RM9 the larger of five and three is not five
assert 2.max(5) == 5  // N13 max failed
assert (1..3).last == 3  // OR6 a range of numbers does not end at its last
assert (1..3).count == 3  // OR7 one to three is not three numbers
assert (3..1).first == 3  // OR8 a range going down does not begin where it is written to
assert (1..<3).count == 2  // OR9 one up to three holds other than two
// (repeated, `[0] * 3`: it, as many times as given, one after another)
Ray &+= {
  * (times: Number) => {
    made := Ray.new
    left := times
    while !left.is_zero {
      made = made.joined(this)
      left = left.pred
    }
    made
  }
  assert [0] * 3 == [0, 0, 0]  // RP2 a list three times is not it three times
  assert [1, 2] * 2 == [1, 2, 1, 2]  // RP3 a list twice does not keep its order each time
  assert ([1] * 0).empty  // RP4 a list no times is something
}
