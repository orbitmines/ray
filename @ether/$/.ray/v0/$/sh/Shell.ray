// Shell Command Language, POSIX.1-2024 XCU chapter 2 (https://pubs.opengroup.org/onlinepubs/9799919799/utilities/V3_chap02.html)
Shell := class (Blank, steps: ((comment: Comment) | (pipeline: Pipeline, (Blank, connective: "&&" | "||" | ";" | "&" | \n, Blank)?))[], Blank) => {
  static Blank := (" " | \t | ("\\", \n))[]
  // 2.2 Quoting: the characters that must be quoted to stand for themselves
  static Special := " " | \t | \n | "'" | "\"" | "\\" | "|" | "&" | ";" | "<" | ">" | "(" | ")" | "$" | "`" | "{" | "}"
  static Safe := Char.Word | "-" | "." | "/" | ":" | "=" | "@" | "%" | "+" | "," | "^"

  // 2.3 Token Recognition, rule 9: a comment runs to the end of the line
  static Comment := class ("#", text: (!\n)[])
  // 2.2.1 Escape Character (Backslash)
  static Escaped := class ("\\", character: Char)
  // 2.2.2 Single-Quotes
  static Single := class ("'", text: (!"'")[], "'") => {
    value => text as String
  }
  // 2.2.3 Double-Quotes
  static Double := class ("\"", characters: (Escaped | Expansion | Char{!= "\"" && != "\\" && != "$"})[], "\"") => {
    value => characters.map(. is Escaped ? .character : . is Expansion ? .value : .).join("") as String
  }
  // 2.6.2 Parameter Expansion
  static Expansion := class ("$", (name: (Char.Letter | "_", Char.Word[])) | ("{", name: (!"}")[], "}")) => {
    value => (external os `environment` (name as String)) as String ?? ""
  }
  static Hole := class ("{", code: Balanced, "}") => {
    value => (inline (external ** code)) as String
    as (=== String) => Shell.quoted(value)
  }
  static Bare := class (characters: (Escaped | Char{!Special})[]{length > 0}) => {
    value => characters.map(. is Escaped ? .character : .).join("") as String
  }
  // 2.3 Token Recognition: a word is its quoted, expanded and plain parts run together
  static Word := class (parts: (Single | Double | Expansion | Hole | Bare)[]{length > 0}) => {
    value => parts.map(.value).join("") as String
  }
  // 2.9.1 Simple Commands: assignments, redirections and words
  static Assignment := class (name: (Char.Letter | "_", Char.Word[]), "=", value: Word?)
  // 2.7 Redirection
  static Redirect := class (descriptor: Char.Digit?, operator: ">>" | ">&" | ">" | "<", Blank, target: Word)
  static Command := class ((assignments: Assignment[]).join(Blank), Blank, (items: (Redirect | Word)[]).join(Blank)) => {
    words => items{is Word}.map(.value)
    process => Process(command: words.first, arguments: words.rest, environment: assignments.map((name: .name as String, value: .value?.value ?? "")))
  }
  // 2.9.2 Pipelines
  static Pipeline := class ((commands: Command[]).join((Blank, "|", Blank))) => {
    process => commands.map(.process).reduce(held => held.into(.))
  }

  commands => steps{.pipeline}
  simple => commands.count == 1 && !commands.first.connective && commands.first.pipeline.commands.every(.items.every(. is Word))
  process => simple ? commands.first.pipeline.process : Process(command: "sh", arguments: ["-c", this as String])

  static quoted (word: String) => word.nonempty && word ~= ⊢ Safe[] ⊣ ? word : "'" + word.replace("'", "'\\''") + "'"
  static written := {
    {writing: Language.Writing{value is Process{piped}}} => writing.value -- (held => Language.Writing(held.piped), " | ", Language.Writing(Process(held.command, held.arguments, held.environment, held.directory)))
    {writing: Language.Writing{value is Process{directory}}} => writing.value -- (held => "cd ", quoted(held.directory.sandboxed), " && ", Language.Writing(Process(held.command, held.arguments, held.environment)))
    {writing: Language.Writing{value is Process{command is Program}}} => writing.value -- (held => Language.Writing(Process(command: "ray", arguments: ["/dev/stdin", held.arguments].flatten, environment: held.environment)))
    {writing: Language.Writing{value is Process}} => writing.value.environment.map(.name, "=", quoted(.value), " "), quoted(writing.value.command), writing.value.arguments.map(" ", quoted(.))
    {writing: Language.Writing{value is Shell}} => writing.value as String
    {writing: Language.Writing{value is String}} => quoted(writing.value)
  }
  static level := {
    {script: Shell} => script.process
    {text: String} => (text as Shell).process
  }
  static language = Language(".sh" | ".bash", level: level, written: written)
}
