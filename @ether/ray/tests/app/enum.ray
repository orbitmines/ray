// An enum is a class whose `|` adds a member; a member may carry fields of its own.

mark ^keyword := global

Colour := enum red | green | blue
Shape := enum circle (radius: Number) | square (side: Number) | point
Modifier := enum static | readonly | this
Level := enum low (rank: Number) | high (rank: Number) {
  ranked => rank
}
Holder := class {
  Side := enum left | right {
  }
  side => Side.left
}

unless Colour.red { INFO@mark `EM1 the member an enum is written with is not there` }
unless Colour.blue { INFO@mark `EM2 the last member is not there` }
unless Colour.red == Colour.red { INFO@mark `EM4 a member is not itself` }
if Colour.red == Colour.blue { INFO@mark `EM5 two members of one enum are the same` }
unless Colour.red is Colour { INFO@mark `EM6 a member is not one of its enum` }
unless Colour#.count == 3 { INFO@mark `EM7 an enum of three has other than three members` }
unless Colour# == [Colour.red, Colour.green, Colour.blue] { INFO@mark `EM14 an enum's members are not its three, in order` }
unless Colour.red.next == Colour.green { INFO@mark `EM25 the member after red is not green` }

unless Shape.circle.radius { INFO@mark `EM8 a member does not carry its field` }
unless Shape.square.side { INFO@mark `EM9 the second member does not carry its field` }
if Shape.point.radius { INFO@mark `EM10 a member carries another's field` }
unless Shape.point { INFO@mark `EM11 a member without fields is not there` }
if Shape.circle is Colour { INFO@mark `EM15 a member is one of another enum` }
unless Shape.circle is Shape { INFO@mark `EM16 a member is not one of its own enum` }

unless Modifier.this { INFO@mark `EM12 a member named this is not there` }

unless Level.low.ranked { INFO@mark `EM17 a block over lines lost what it declares` }
unless Level.high.ranked { INFO@mark `EM18 the last member gained nothing from the block` }
unless Level#.count == 2 { INFO@mark `EM20 an enum of two written with a block has other than two members` }
if Level.low == Level.high { INFO@mark `EM21 two members written with a block are the same` }

unless Holder.Side.left { INFO@mark `EM22 an enum inside a class has no members` }
unless Holder.Side#.count == 2 { INFO@mark `EM23 an enum inside a class lost a member` }
unless Holder().side == Holder.Side.left { INFO@mark `EM24 an instance does not reach the enum its class writes` }
