  static same_place (a: Place, b: Place) => (a is Place) && (b is Place) && (a.name == b.name)
  static reads_whole (a: Text, b) => ((a is Text) && (reads(b, a) == a.to)) ? true : false
  static readtext (p, t) => Readings.read_from(p, (t is Node) ? member(t, Symbol.text) : t)
  static read_from (p, t: Text) => (t is Text) ? Readings.read_in(p, t, textend, boundn) : Readings.not_whole()
  static not_whole => {
    wholly = false
    None
  }
  static read_in (p, t: Text, te, bn) => {
    textend = t.to
    r := matched(sequence(append(append(list(), topattern(p)), ending())), t.from, 0)
    textend = te
    (r < 0) ? Readings.read_failed(bn) : Readings.curried_if(p, Readings.bound_read(t, bn))
  }
  static read_failed (bn) => {
    boundn = bn
    None
  }
  static bound_read (t, bn) => {
    v := (Runtime.unnamed_count(bn) != 0) ? valued_from(bn) : ((boundn > bn) ? Runtime.defined_as(named_from(bn), Symbol.text, t) : t)
    boundn = bn
    v
  }
  static curried_if (p: Pattern, v) => ((p is Pattern) && (p.kind == with_function)) ? curried(p.b, v) : v
  static mapped_text (t: Text, f, g) => ((g is Closure) || (g is Pattern)) ? Readings.mapped_pattern(t, f, g) : Readings.mapped_bytes(t, f, g, alloc_bytes(((t.to - t.from) * 16) + 16))
  static mapped_pattern (t: Text, f, g) => {
    l := list()
    q := t.from
    s := q
