// WebAssembly Core 2.0, binary format (https://webassembly.github.io/spec/core/binary/), with threads' shared memory
// (https://webassembly.github.io/threads/core/binary/). The header reads and writes a module. `none` and `default` are its
// levels: rules from a Program to instructions, each right side the ops and their values as a module writes them, read
// again by the level until only ops are left.
Wasm := class (0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00, sections: Section[]) {
  static extensions := lazily ".wasm"
  // (in the order `Order` gives their ids, a custom one anywhere (5.5); function i typed by the function section's i, coded by the code section's)
  static Order := lazily [1, 2, 3, 4, 5, 13, 6, 7, 8, 9, 12, 10, 11]
  dynamically assert sections.id{!= 0}.map(Order.index_of(.)).sorted

  // Integers (5.2.2): LEB128, seven bits a byte from the least significant, the high bit set while more follow (`more`, each
  // 128 or above), the last below it; signed, the last group's second bit (64) its sign
  // (was, before 2026-10-22, read by its bits: LEB and Signed as headers of bit groups, their values and conversions by
  // chunks of 7 bits; the text is in commit 5c50a9d3, this file, lines 11 to 24. The way back, once subscript numerals read in
  // a header and a header writes by being read backwards: those lines again, and the `Continued` and `Final` types,
  // `weight`, `power`, `groups`, `top` and `encoded` below gone; WA1 and WA2 as noted at the end of the file)
  // (a class written with `=>` before its block: without it, the block is the class, its methods see no field)
  static Continued := Byte{. >= 128}
  static Final := Byte{. < 128}
  static LEB := class (more: Continued[], last: Final) => {
    // (what the groups before the last weigh, least significant first, each without its high bit; 128 to the n)
    static weight (groups) => groups.empty ? 0 : (groups.first - 128) + 128 * Wasm.LEB.weight(groups.rest)
    static power (n) => n == 0 ? 1 : 128 * Wasm.LEB.power(n - 1)
    value => {
      value_more := .more
      value_last := .last
      Wasm.LEB.weight(value_more) + value_last * Wasm.LEB.power(value_more.count)
    }
    // (the bytes it is written as)
    bytes => .written.flatten
    // (a number's groups: seven bits each but the last, least significant first, the high bit set; the last what is left)
    static groups (v) => (v < 128) ? [] : [v % 128 + 128].joined(Wasm.LEB.groups(v / 128))
    static top (v) => v < 128 ? v : Wasm.LEB.top(v / 128)
    // TODO(explicit): goes when a header writes by solving itself for its fields (`value` given, the groups that read as it)
    static encoded (v) => {
      enc_more := Wasm.LEB.groups(v)
      enc_last := Wasm.LEB.top(v)
      Wasm.LEB(more: enc_more, last: enc_last)
    }
  }
  static Signed := class (more: Continued[], last: Final) => {
    value => {
      value_more := .more
      value_last := .last
      Wasm.LEB.weight(value_more) + value_last * Wasm.LEB.power(value_more.count)
    }
    bytes => .written.flatten
    // (the last group below 64: its sign bit clear) TODO(explicit): a value below zero, its groups until what is left is the
    // sign alone
    static groups (v) => (v < 64) ? [] : [v % 128 + 128].joined(Wasm.Signed.groups(v / 128))
    static top (v) => v < 64 ? v : Wasm.Signed.top(v / 128)
    // (minus m: k groups, the fewest whose sign bit holds it, of 128 to the k less m) TODO(explicit): `-m` itself, once a
    // number below zero reads as one here (its `negative`, its `integer`)
    static width (m, k) => m <= 64 * Wasm.LEB.power(k - 1) ? k : Wasm.Signed.width(m, k + 1)
    static low_groups (u, k) => k == 1 ? [] : [u % 128 + 128].joined(Wasm.Signed.low_groups(u / 128, k - 1))
    static low_top (u, k) => k == 1 ? u : Wasm.Signed.low_top(u / 128, k - 1)
    static below_zero (m) => {
      below_k := Wasm.Signed.width(m, 1)
      below_u := Wasm.LEB.power(below_k) - m
      below_more := Wasm.Signed.low_groups(below_u, below_k)
      below_last := Wasm.Signed.low_top(below_u, below_k)
      Wasm.Signed(more: below_more, last: below_last)
    }
    static encoded (v) => {
      enc_more := Wasm.Signed.groups(v)
      enc_last := Wasm.Signed.top(v)
      Wasm.Signed(more: enc_more, last: enc_last)
    }
  }
  // (and written plainly, as numbers: what a module writer takes, its groups and then the last, no instance made)
  static leb (v) => (v < 128) ? [v] : [v % 128 + 128].joined(Wasm.leb(v / 128))
  static sleb (v) => (v < 64) ? [v] : [v % 128 + 128].joined(Wasm.sleb(v / 128))
  static U32 := lazily LEB{value < 2 ^ 32}
  static S32 := lazily Signed{-(2 ^ 31) <= value < 2 ^ 31}
  // (each at most ceil(N / 7) bytes; a byte's bits past N 0, or the sign's)
  static U64 := lazily LEB{value < 2 ^ 64}
  static S33 := lazily Signed{-(2 ^ 32) <= value < 2 ^ 32}
  static S64 := lazily Signed{-(2 ^ 63) <= value < 2 ^ 63}
  // (an uninterpreted integer, `i32.const`'s, `i64.const`'s, is written as its signed one: S32, S64)
  // Floating-point (5.2.3): the IEEE 754 bits, little endian
  static F32 := lazily (bytes: Byte[]{length == 4})
  static F64 := lazily (bytes: Byte[]{length == 8})
  // Vectors (5.1.3), names (5.2.4)
  static vec (T) => (count: U32 = elements.count, elements: T[]{length == count})
  // (one written: its count, then each element as it is written) TODO(explicit): goes when `vec(T)` writes as it reads
  static Vec := class (elements: Node) => {
    bytes => {
      vec_elements := .elements
      Wasm.leb(vec_elements.count).joined(Wasm.bytes_all(vec_elements))
    }
  }
  // (what anything is written as: a number a byte; a list each of it, in turn; an op its code; anything else, its own bytes)
  // (an op, its code: one byte, or a prefix and a number)
  static bytes_of (x) => (x is Number) ? [x] : (((x).listing === true) ? Wasm.bytes_all(x) : (((x).code !== None) ? Wasm.bytes_of((x).code) : x.bytes))
  static bytes_all (xs) => xs.map((x) => Wasm.bytes_of(x)).flatten
  // (bytes after how many they are)
  static sized (sized_bytes) => Wasm.leb(sized_bytes.count).joined(sized_bytes)
  // (was, before 2026-10-22: `static Name := lazily (size: U32 = text.bytes.count, text: Unicode.UTF-8{bytes.count == size})`;
  // the way back once a text written `as Byte[]` is its UTF-8 bytes and a header writes itself; then `codes` and `bytes` go
  // and WA3 goes back to its form noted at the end of the file)
  static Name := class (size: U32 = text.count, text: String) => {
    // (the codes of its characters, in order) TODO(explicit): above 127, their UTF-8 bytes
    static codes (t) => t.empty ? [] : [t[0]].joined(Wasm.Name.codes(t.rest))
    bytes => {
      name_text := .text
      Wasm.sized(Wasm.Name.codes(name_text))
    }
  }

  // Sections (5.5): an id, a size, the contents as that id's reads them
  static Section := lazily class (id: Byte, size: U32 = data.bytes.count, data: Byte[]{length == size} as Data[id])
  // (one written: its id, its size, its contents) TODO(explicit): goes when `Section` writes as it reads
  static Written_section := class (id: Node, data: Node) => {
    bytes => {
      section_id := .id
      section_held := .data
      [section_id].joined(Wasm.sized(Wasm.bytes_of(section_held)))
    }
  }
  // (the contents of the section of each id: 0 custom, 1 type, 2 import, 3 function, 4 table, 5 memory, 6 global, 7 export,
  // 8 start, 9 element, 10 code, 11 data, 12 data count, 13 tag)
  static Data := lazily [
    (name: Name, Byte[]), vec(RecursiveType), vec(Import), vec(U32), vec(Table), vec(MemoryType), vec(Global),
    vec(Export), U32, vec(Element), vec(Code), vec(DataSegment), U32, vec(TagType)
  ]
  // (the custom section `name` (Appendix, custom sections), so a trace says where it was: subsections in the order of their
  // ids, each an id, a size, its contents; a name map index/name pairs by increasing index, an indirect one a name map an index)
  static Names := lazily (name: Name{text == "name"}, subsections: NameSubsection[])
  static NameMap := lazily vec((index: U32, name: Name))
  static IndirectNameMap := lazily vec((index: U32, names: NameMap))
  static NameSubsection := lazily (0x00, size: U32 = module.bytes.count, module: Name)
    | (0x01, size: U32 = functions.bytes.count, functions: NameMap)
    | (0x02, size: U32 = locals.bytes.count, locals: IndirectNameMap)
    | (0x04, size: U32 = types.bytes.count, types: NameMap)
    | (0x0A, size: U32 = fields.bytes.count, fields: IndirectNameMap)
    | (0x0B, size: U32 = tags.bytes.count, tags: NameMap)

  // Types (5.3): a type constructor is the single byte of a small negative S33, so it can stand where a type index does
  static NumberType := lazily enum i32 (code: 0x7F) | i64 (code: 0x7E) | f32 (code: 0x7D) | f64 (code: 0x7C)
  static VectorType := lazily enum v128 (code: 0x7B)
  static AbsoluteHeapType := lazily enum exn (code: 0x69) | array (code: 0x6A) | struct (code: 0x6B) | i31 (code: 0x6C) | eq (code: 0x6D) | any (code: 0x6E)
    | extern (code: 0x6F) | func (code: 0x70) | none (code: 0x71) | noextern (code: 0x72) | nofunc (code: 0x73) | noexn (code: 0x74)
  static HeapType := lazily AbsoluteHeapType | (index: S33{value >= 0})
  // (0x63 `ref null ht`, 0x64 `ref ht`, an absolute heap type alone `ref null` of it: `funcref` 0x70, `externref` 0x6F)
  static ReferenceType := lazily (0x63, heap: HeapType) | (0x64, heap: HeapType) | (heap: AbsoluteHeapType)
  static ValueType := lazily NumberType | VectorType | ReferenceType
  static ResultType := lazily vec(ValueType)
  // (composite types: an array of a field, a struct of fields, a function; a field a value or a packed type, mutable 0x01)
  static PackedType := lazily enum i16 (code: 0x77) | i8 (code: 0x78)
  static StorageType := lazily ValueType | PackedType
  static FieldType := lazily (storage: StorageType, mutable: 0x00 | 0x01)
  static ArrayType := lazily (0x5E, field: FieldType)
  static StructType := lazily (0x5F, fields: vec(FieldType))
  static FunctionType := lazily (0x60, parameters: ResultType, results: ResultType)
  static CompositeType := lazily ArrayType | StructType | FunctionType
  // (0x4F `sub final`, 0x50 `sub` (open to subtypes), the supertypes type indices; a composite type alone `sub final` of none)
  static SubType := lazily (0x4F, supertypes: vec(U32), composite: CompositeType) | (0x50, supertypes: vec(U32), composite: CompositeType) | (composite: CompositeType)
  // (0x4E a group of mutually recursive types, a sub type alone a group of one)
  static RecursiveType := lazily (0x4E, types: vec(SubType)) | (sub: SubType)
  // (the flags' bit 0: a maximum follows; bit 1: shared (threads; only with a maximum); bit 2: 64-bit addresses (i64), else
  // i32 and both below 2 ^ 32)
  static Limits := lazily (flags: 0x00 | 0x04, min: U64) | (flags: 0x01 | 0x03 | 0x05 | 0x07, min: U64, max: U64)
  static MemoryType := lazily Limits
  static TableType := lazily (element: ReferenceType, limits: Limits)
  static GlobalType := lazily (value: ValueType, mutable: 0x00 | 0x01)
  // (a tag: the index of its function type)
  static TagType := lazily (0x00, index: U32)
  static ExternalType := lazily (0x00, function: U32) | (0x01, table: TableType) | (0x02, memory: MemoryType) | (0x03, global: GlobalType) | (0x04, tag: TagType)
  static ExternalIndex := lazily (0x00, function: U32) | (0x01, table: U32) | (0x02, memory: U32) | (0x03, global: U32) | (0x04, tag: U32)

  // Modules (5.5)
  static Import := lazily (module: Name, name: Name, ExternalType)
  static Export := lazily (name: Name, ExternalIndex)
  // (a table of a type's null references, or 0x40 0x00 and the expression of its initial value)
  static Table := lazily (table: TableType) | (0x40, 0x00, table: TableType, value: Expression)
  static Global := lazily (global: GlobalType, value: Expression)
  // (an element segment, its leading U32 a bit field: bit 0 passive or declarative, else active; bit 1 a table index (active),
  // else declarative (not active); bit 2 a reference type and expressions, else an element kind (0x00, `ref func`) and function
  // indices. Active ones without a table index: table 0, `ref func` (0) or `ref null func` (4))
  static Element := lazily (0x00, at: Expression, functions: vec(U32))
    | (0x01, kind: 0x00, functions: vec(U32))
    | (0x02, table: U32, at: Expression, kind: 0x00, functions: vec(U32))
    | (0x03, kind: 0x00, functions: vec(U32))
    | (0x04, at: Expression, values: vec(Expression))
    | (0x05, reference: ReferenceType, values: vec(Expression))
    | (0x06, table: U32, at: Expression, reference: ReferenceType, values: vec(Expression))
    | (0x07, reference: ReferenceType, values: vec(Expression))
  // (a data segment, its leading U32 bit 0 passive, bit 1 a memory index; active without one: memory 0)
  static DataSegment := lazily (0x00, at: Expression, bytes: vec(Byte)) | (0x01, bytes: vec(Byte)) | (0x02, memory: U32, at: Expression, bytes: vec(Byte))
  static Code := lazily (size: U32 = function.bytes.count, function: (locals: vec((count: U32, value: ValueType)), body: Expression))
  // (one written: its size, then the function) TODO(explicit): goes when `Code` writes as it reads
  static Written_code := class (function: Node) => {
    bytes => {
      code_held := .function
      Wasm.sized(Wasm.bytes_of(code_held))
    }
  }
  // (a module written: the header, then its sections)
  static module_bytes (sections) => [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00].joined(Wasm.bytes_all(sections))
  // (where a key is among a node's: by identity, the key itself, not what equals it)
  static key_index (keys, key, at) => keys.empty ? None : ((keys.first === key) ? at : Wasm.key_index(keys: keys.rest, key: key, at: at + 1))
  static zeros (n) => (n == 0) ? [] : [0].joined(Wasm.zeros(n - 1))
  // (a module of functions, each its body's statements dispatched (`dispatched`), what applies it local 0: the first the
  // program's, exported as `main`; the memory it runs in imported (`m.memory`, shared, of `pages` pages), where the next node
  // is made global 0 (from `free`))
  static module_of (pages, free, bodies) => Wasm.module_bytes([
    Wasm.Written_section(1, Wasm.Vec(elements: [[0x60, Wasm.Vec(elements: [0x7F]), Wasm.Vec(elements: [0x7F])]])),
    Wasm.Written_section(2, Wasm.memory_import(pages)),
    Wasm.Written_section(3, Wasm.Vec(Wasm.zeros(bodies.count))),
    Wasm.Written_section(6, Wasm.global_of(Wasm.sleb(free))),
    Wasm.Written_section(7, Wasm.Vec(elements: [[Wasm.Name(text: "main"), 0x00, 0]])),
    Wasm.Written_section(10, Wasm.Vec(Wasm.codes_of(bodies)))
  ])
  // (its parts, given what they are made of: a class given by name a value that calls on its caller's parameter does not end)
  static memory_import (pages) => Wasm.Vec(elements: [[Wasm.Name(text: "m"), Wasm.Name(text: "memory"), 0x02, 0x03, pages, pages]])
  // (a list of bytes joined in, not held in a list written out, and given positionally: either way it is not opened)
  static global_of (start) => Wasm.Vec(Array.new.append([0x7F, 0x01, 0x41].joined(start).joined([0x0B])))
  static codes_of (bodies) => bodies.empty ? [] : [Wasm.Written_code([Wasm.Vec(elements: [[2, 0x7F]]), Wasm.dispatched(bodies.first), 0x20, 2, 0x0B])].joined(Wasm.codes_of(bodies.rest))
  // An Expression's node as Expression reads it (`none` on it): its statements the first function, each of its rules the
  // next, in order, a rule its body's statements; a statement read by one of the given things (`external .`, `&`, its
  // reading's `rule`), what `none` writes for it; any other a call of the rule its key is
  static expressed (read_node, pages, free) => Wasm.module_of(pages: pages, free: free, bodies: Wasm.bodies_of(held_rules: read_node.rules.keyed, statement_lists: Array.new.append(read_node.statements).joined(read_node.rules.keyed.map((entry) => Wasm.body_of(entry)))))
  // (a rule's body as Expression keeps it, on what it keeps (`kept`): the node it is read in, its statements once it is
  // applied; none yet, none. Read in two steps: the one read inside the other answers another node)
  static body_of (entry) => (Wasm.body_node(entry).statements) ?? Array.new
  static body_node (entry) => Wasm.kept_body(external member (entry) (`kept`))
  static kept_body (kept) => external member (kept) (`body`)
  static bodies_of (held_rules, statement_lists) => statement_lists.empty ? Array.new : Array.new.append(Wasm.statement_ops_of(held_rules: held_rules, statements: statement_lists.first)).joined(Wasm.bodies_of(held_rules: held_rules, statement_lists: statement_lists.rest))
  static statement_ops_of (held_rules, statements) => statements.empty ? Array.new : Array.new.append(Wasm.statement_op(held_rules: held_rules, statement: statements.first)).joined(Wasm.statement_ops_of(held_rules: held_rules, statements: statements.rest))
  static statement_op (held_rules, statement) => Wasm.entry_op(held_rules: held_rules, statement: statement, at: Wasm.key_index(keys: held_rules.map((entry) => entry.key), key: (statement.statement).matched_key, at: 0))
  // (by what the rule its key is keeps: the first of a node's rules the one that makes rules, its statement a definition,
  // written when the module is (nothing at run time); one with a body a call of its function; one without, a given thing)
  static entry_op (held_rules, statement, at) => (at == 0) ? [] : ((Wasm.body_node(held_rules[at]) === None) ? Wasm.external_ops(Wasm.given_of(statement)) : [0x20, 0, 0x10, at + 1, 0x21, 2])
  // (what a statement's reading names of the given things: its `rule`, on it or on the key's reading it is)
  static given_of (given_statement) => ((given_statement).rule) ?? (((given_statement).statement).rule)
  // (a rule's statements, Expression's: each a case of a `br_table` in a loop, the innermost first, where it is (local 1)
  // choosing the first; each statement where its block ends, falling to the next; a jump given where it goes then, the loop
  // again)
  static dispatched (statement_ops) => Wasm.dispatch_head(statement_ops.count).joined(Wasm.case_ends(statement_ops)).joined([0x0B, 0x0B])
  static dispatch_head (n) => [0x03, 0x40, 0x02, 0x40].joined(Wasm.blocks(n)).joined([0x20, 1, 0x0E, Wasm.Vec(Wasm.upto(n)), n])
  static blocks (n) => (n == 0) ? [] : [0x02, 0x40].joined(Wasm.blocks(n - 1))
  static upto (n) => (n == 0) ? [] : Wasm.upto(n - 1).joined([n - 1])
  static case_ends (ends_of) => ends_of.empty ? [] : [0x0B].joined(ends_of.first).joined(Wasm.case_ends(ends_of.rest))
  // (a jump, `external goto`, from the statement at `index` of `count` to the one at `target`: there, then the loop again)
  static goto_ops (target, index, count) => [0x41, target, 0x21, 1, 0x0C, count - index]
  // (and one given a condition, `goto (label, condition)`: its ops first, the jump only when it holds, one block further in)
  static goto_if_ops (condition, target, index, count) => condition.joined([0x04, 0x40, 0x41, target, 0x21, 1, 0x0C, count - index + 1, 0x0B])
  // (a statement of one of the given things, Expression's `external .` and `external &`: what `none` writes for it (a node
  // made where global 0 says, what applies it stored in it, global 0 past it; what applies it, the value))
  static external_ops (given) => (given == `.`) ? [0x23, 0, 0x22, 2, 0x20, 0, 0x36, 2, 0, 0x23, 0, 0x41, Wasm.node, 0x6A, 0x24, 0] : ((given == `&`) ? [0x20, 0, 0x21, 2] : [])

  // Texts as byte spans: a node's keys, what its `reading` compares, laid out from `at`, a table first, where each starts
  // and how long it is (two words each), then their bytes, in order
  static spans_of (texts, at) => Wasm.span_table(texts: texts, from: at + 8 * texts.count).joined(Wasm.span_bytes(texts))
  static span_table (texts, from) => texts.empty ? [] : Wasm.word(from).joined(Wasm.word(texts.first.count)).joined(Wasm.span_table(texts: texts.rest, from: from + texts.first.count))
  static span_bytes (texts) => texts.empty ? [] : Wasm.Name.codes(texts.first).joined(Wasm.span_bytes(texts.rest))
  // (a word as it is in memory, least significant byte first)
  static word (v) => [v % 256, (v / 256) % 256, (v / 65536) % 256, v / 16777216]
  // (`reading` natively, Node's `rules.keys{text ~= .}#.sort(.length).last`: given where a text is (local 0) and how long
  // (1), which of `count` spans at `at` it starts with, the longest, the last of those as long; none, -1. Locals: the span
  // (2), the one found (3), its length (4), this one's length (5) and where it is (6), how far it is compared (7))
  static longest_ops (count, at) => [
    0x41, 0x7F, 0x21, 3, 0x41, 0, 0x21, 4, 0x41, 0, 0x21, 2,
    0x02, 0x40, 0x03, 0x40,
    0x20, 2, 0x41
  ].joined(Wasm.sleb(count)).joined([
    0x4F, 0x0D, 1,
    0x20, 2, 0x41, 8, 0x6C, 0x22, 6, 0x28, 2
  ]).joined(Wasm.leb(at + 4)).joined([
    0x21, 5,
    0x20, 6, 0x28, 2
  ]).joined(Wasm.leb(at)).joined([
    0x21, 6,
    0x02, 0x40,
    0x20, 5, 0x20, 1, 0x4B, 0x0D, 0,
    0x20, 5, 0x20, 4, 0x49, 0x0D, 0,
    0x41, 0, 0x21, 7,
    0x02, 0x40, 0x03, 0x40,
    0x20, 7, 0x20, 5, 0x4F, 0x0D, 1,
    0x20, 0, 0x20, 7, 0x6A, 0x2D, 0, 0,
    0x20, 6, 0x20, 7, 0x6A, 0x2D, 0, 0,
    0x47, 0x0D, 2,
    0x20, 7, 0x41, 1, 0x6A, 0x21, 7, 0x0C, 0,
    0x0B, 0x0B,
    0x20, 2, 0x21, 3, 0x20, 5, 0x21, 4,
    0x0B,
    0x20, 2, 0x41, 1, 0x6A, 0x21, 2, 0x0C, 0,
    0x0B, 0x0B,
    0x20, 3, 0x0B
  ])
  // (a module of it: `reading` exported, given where a text is and how long, the spans of `texts` its data at `at`)
  static reading_module (texts, pages, at) => Wasm.module_bytes([
    Wasm.Written_section(1, Wasm.Vec(elements: [[0x60, Wasm.Vec(elements: [0x7F, 0x7F]), Wasm.Vec(elements: [0x7F])]])),
    Wasm.Written_section(2, Wasm.memory_import(pages)),
    Wasm.Written_section(3, Wasm.Vec(elements: [0])),
    Wasm.Written_section(7, Wasm.Vec(elements: [[Wasm.Name(text: "reading"), 0x00, 0]])),
    Wasm.Written_section(10, Wasm.reading_code(Wasm.longest_ops(count: texts.count, at: at))),
    Wasm.Written_section(11, Wasm.data_of(start: Wasm.sleb(at), spans: Wasm.Vec(Wasm.spans_of(texts: texts, at: at))))
  ])
  static reading_code (ops) => Wasm.Vec(Array.new.append(Wasm.Written_code([Wasm.Vec(elements: [[6, 0x7F]]), ops])))
  static data_of (start, spans) => Wasm.Vec(Array.new.append([0x00, 0x41].joined(start).joined([0x0B, spans])))

  // Instructions (5.4): an op, then what it takes. An expression is instructions until `end`.
  // (each op named as WAT writes it: `prefix.name` the enum `prefix`'s member `name`, the dots after the first `_`
  // (`i32.atomic.rmw8.add_u` i32's `atomic_rmw8_add_u`); without a prefix, Op's. Two ops of one WAT name: `select` with types
  // `select_t`, `ref.test`/`ref.cast` of `(ref null ht)` `test_null`/`cast_null`. A prefixed op's code: the prefix, its U32)
  static Expression := lazily (Instruction[], end)
  static Instruction := lazily (op: Op | local | global | table | elem | memory | data | ref | struct | array | i31 | any | extern
    | i32 | i64 | f32 | f64 | v128 | i8x16 | i16x8 | i32x4 | i64x2 | f32x4 | f64x2 | atomic, op.takes)
  static BlockType := lazily 0x40 | ValueType | S33{value >= 0}
  // (try_table's catches: a tag and a label; `catch_ref` also the exception's reference; `catch_all` any exception)
  static Catch := lazily (0x00, tag: U32, label: U32) | (0x01, tag: U32, label: U32) | (0x02, label: U32) | (0x03, label: U32)
  // (br_on_cast's: bit 0 the first type nullable, bit 1 the second)
  static CastOp := lazily 0x00 | 0x01 | 0x02 | 0x03
  // (alignment as an exponent of 2, its default the access's natural one; bit 6 of it set: a memory index follows (multi-memory),
  // the alignment the rest; else memory 0)
  static MemArg := lazily (align: U32{value < 2 ^ 6} = 2, offset: U64 = 0) | (align: U32{2 ^ 6 <= value < 2 ^ 7} = 2 + 2 ^ 6, memory: U32, offset: U64 = 0)
  static Lane := lazily Byte
  // Control (5.4.1) and parametric (5.4.2) instructions, the ones WAT writes without a prefix
  static Op := lazily enum unreachable (code: 0x00) | nop (code: 0x01) | block (code: 0x02, takes: BlockType = 0x40)
    | `loop` (code: 0x03, takes: BlockType = 0x40) | `if` (code: 0x04, takes: BlockType = 0x40) | `else` (code: 0x05) | throw (code: 0x08, takes: U32)
    | throw_ref (code: 0x0A) | end (code: 0x0B) | br (code: 0x0C, takes: U32) | br_if (code: 0x0D, takes: U32)
    | br_table (code: 0x0E, takes: (vec(U32), U32)) | `return` (code: 0x0F) | call (code: 0x10, takes: U32)
    | call_indirect (code: 0x11, takes: (index: U32, table: U32)) | return_call (code: 0x12, takes: U32)
    | return_call_indirect (code: 0x13, takes: (index: U32, table: U32)) | call_ref (code: 0x14, takes: U32) | return_call_ref (code: 0x15, takes: U32)
    | drop (code: 0x1A) | select (code: 0x1B) | select_t (code: 0x1C, takes: vec(ValueType)) | try_table (code: 0x1F, takes: (BlockType, vec(Catch)))
    | br_on_null (code: 0xD5, takes: U32) | br_on_non_null (code: 0xD6, takes: U32)
    | br_on_cast (code: (0xFB, 24), takes: (CastOp, label: U32, from: HeapType, to: HeapType))
    | br_on_cast_fail (code: (0xFB, 25), takes: (CastOp, label: U32, from: HeapType, to: HeapType))
  // Variable instructions (5.4.3)
  static local := lazily enum get (code: 0x20, takes: U32) | set (code: 0x21, takes: U32) | tee (code: 0x22, takes: U32)
  static global := lazily enum get (code: 0x23, takes: U32) | set (code: 0x24, takes: U32)
  // Table instructions (5.4.4)
  static table := lazily enum get (code: 0x25, takes: U32) | set (code: 0x26, takes: U32) | init (code: (0xFC, 12), takes: (elem: U32, table: U32))
    | copy (code: (0xFC, 14), takes: (to: U32, from: U32)) | grow (code: (0xFC, 15), takes: U32) | size (code: (0xFC, 16), takes: U32)
    | fill (code: (0xFC, 17), takes: U32)
  static elem := lazily enum drop (code: (0xFC, 13), takes: U32)
  // Memory instructions (5.4.5): `memory.size`/`grow` take a memory index (a 0x00 byte before multi-memory); the atomic ones are threads'
  static memory := lazily enum size (code: 0x3F, takes: U32) | grow (code: 0x40, takes: U32) | init (code: (0xFC, 8), takes: (data: U32, memory: U32))
    | copy (code: (0xFC, 10), takes: (to: U32, from: U32)) | fill (code: (0xFC, 11), takes: U32) | atomic_notify (code: (0xFE, 0), takes: MemArg)
    | atomic_wait32 (code: (0xFE, 1), takes: MemArg) | atomic_wait64 (code: (0xFE, 2), takes: MemArg{align = 3})
  static data := lazily enum drop (code: (0xFC, 9), takes: U32)
  // Reference instructions (5.4.6); `test_null`/`cast_null`: of `(ref null ht)`
  static ref := lazily enum null (code: 0xD0, takes: HeapType) | is_null (code: 0xD1) | func (code: 0xD2, takes: U32) | eq (code: 0xD3)
    | as_non_null (code: 0xD4) | test (code: (0xFB, 20), takes: HeapType) | test_null (code: (0xFB, 21), takes: HeapType)
    | cast (code: (0xFB, 22), takes: HeapType) | cast_null (code: (0xFB, 23), takes: HeapType) | i31 (code: (0xFB, 28))
  // Aggregate instructions (5.4.7), 0xFB
  static struct := lazily enum new (code: (0xFB, 0), takes: U32) | new_default (code: (0xFB, 1), takes: U32)
    | get (code: (0xFB, 2), takes: (index: U32, field: U32)) | get_s (code: (0xFB, 3), takes: (index: U32, field: U32))
    | get_u (code: (0xFB, 4), takes: (index: U32, field: U32)) | set (code: (0xFB, 5), takes: (index: U32, field: U32))
  static array := lazily enum new (code: (0xFB, 6), takes: U32) | new_default (code: (0xFB, 7), takes: U32)
    | new_fixed (code: (0xFB, 8), takes: (index: U32, count: U32)) | new_data (code: (0xFB, 9), takes: (index: U32, data: U32))
    | new_elem (code: (0xFB, 10), takes: (index: U32, elem: U32)) | get (code: (0xFB, 11), takes: U32) | get_s (code: (0xFB, 12), takes: U32)
    | get_u (code: (0xFB, 13), takes: U32) | set (code: (0xFB, 14), takes: U32) | len (code: (0xFB, 15)) | fill (code: (0xFB, 16), takes: U32)
    | copy (code: (0xFB, 17), takes: (to: U32, from: U32)) | init_data (code: (0xFB, 18), takes: (index: U32, data: U32))
    | init_elem (code: (0xFB, 19), takes: (index: U32, elem: U32))
  static i31 := lazily enum get_s (code: (0xFB, 29)) | get_u (code: (0xFB, 30))
  static any := lazily enum convert_extern (code: (0xFB, 26))
  static extern := lazily enum convert_any (code: (0xFB, 27))
