Unicode := class {

  scalar (codepoint: Number) => (codepoint < 1114112).and(Unicode.surrogate(codepoint).not)
  surrogate (codepoint: Number) => (55295 < codepoint).and(codepoint < 57344)

  fits (codepoint: Number, width: Number) => codepoint < (2).pow(width)
  surrogate_first => 55296

  GeneralCategory := enum letter | number | punctuation | symbol | separator | other
  category (character: Character) => (
    if character.letter { Unicode.GeneralCategory.letter }
    elsif character.digit { Unicode.GeneralCategory.number }
    elsif character.blank { Unicode.GeneralCategory.separator }
    elsif (character < 32) { Unicode.GeneralCategory.other }
    elsif character.is_ascii { Unicode.GeneralCategory.punctuation }
    else { Unicode.GeneralCategory.symbol }
  )

  TF := class: Array { }

  UTF8 := class: Unicode.TF {

    as_code_points => code_points(this)
    encode (codepoint: Number) => (
      units := chain None
      if (codepoint < 128) { units &= codepoint }
      elsif (codepoint < 2048) {
        units &= 192 + (codepoint / 64)
        units &= 128 + (codepoint % 64)
      } elsif (codepoint < 65536) {
        units &= 224 + (codepoint / 4096)
        units &= 128 + ((codepoint / 64) % 64)
        units &= 128 + (codepoint % 64)
      } else {
        units &= 240 + (codepoint / 262144)
        units &= 128 + ((codepoint / 4096) % 64)
        units &= 128 + ((codepoint / 64) % 64)
        units &= 128 + (codepoint % 64)
      }
      written := chain None
      units for { bits_of(it.value, 8) for { written &= it.value } }
      written
    )
    decode (bits) => code_points(bits).head.value
  }

  UTF16 := class: Unicode.TF {
    unit => 65536
    encode (codepoint: Number) => if (Unicode.fits(codepoint, 16)) { bits_of(codepoint, 16) } else {
      shifted := codepoint - .unit
      pair := bits_of(surrogate_first + (shifted / 1024), 16)
      bits_of(surrogate_first + 1024 + (shifted % 1024), 16) for { pair &= it.value }
      pair
    }
    decode (bits) => (
      high := number_of(bits.slice_bits(0, 16))
      if (Unicode.surrogate(high)) {
        low := number_of(bits.slice_bits(16, 32))
        this.unit + ((high - surrogate_first) * 1024) + (low - (surrogate_first + 1024))
      } else { high }
    )
  }

  UTF32 := class: Unicode.TF {
    encode (codepoint: Number) => bits_of(codepoint, 32)
    decode (bits) => number_of(bits)
  }

  tables_at => "https://www.unicode.org/Public/UCD/latest/ucd/"
  table (name) => external io (.tables_at + name).bits
}

code_points (source) => (
  points := chain None
  point := 0
  ones := 0
  counting := true
  leading := true
  skip := 0
  position := 0
  following := 0
  take (b) => (
    bit := inline b
    if counting {
      if bit { ones = ones.succ } else { counting = false }
    } elsif skip.nonzero { skip = skip.pred } else {
      point = point + point
      if bit { point = point.succ }
    }
    position = position.succ
    if (position == 8) {
      position = 0
      if leading {
        following = if ones.is_zero { 0 } else { ones.pred }
      } else { following = following.pred }
      if following.is_zero {
        points &= point
        point = 0
        ones = 0
        counting = true
        leading = true
      } else {
        leading = false
        counting = false
        skip = 2
      }
    }
    points
  )
  if (source.head) { source for { take(it.value) } } else { external bits source take }
  points
)

Unicode.CodePoint = Hexadecimal{. < 16777216}

Unicode.Scalar = Unicode.CodePoint{Unicode.scalar(this)}

U+{codepoint: Hexadecimal.String ^number} ^number => Hexadecimal(integer: codepoint).as_character

Chain.components.hierarchy &= class {
  slice_bits (from, to) => (
    out := chain None
    walker ^keyword := .at(from)
    left ^keyword := to - from
    while (left.nonzero.and(walker)) {
      out &= walker.value
      walker = walker.next
      left = left.pred
    }
    out
  )
}
