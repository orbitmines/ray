// -> (): Ray => next: () => Ray(next: next())
// <- (): Ray => previous: () => Ray(previous: previous())
// <--> (): Ray => (<-) &+ (->)


// What the language reaches today. `Ray < Iterable & Ordered` becomes a single
// chain of bases until a class can name more than one, and the draft's unicode
// aliases (⊢ ⊣ ∙ ⊙ ∃ ∀) wait on a way to spell them.
Ordered := class {
  chainable < (other: Ordered) => TODO
  // `.<(…)` rather than `<`: a juxtaposed call is dispatched on what the
  // parameter was declared to be, and here that is only `Ordered`, whose `<`
  // is the one being overridden.
  chainable > (other: Ordered) => other.<(this)
  chainable <= (other: Ordered) => other.<(this).not
  chainable >= (other: Ordered) => .<(other).not

  // The answer is bound before it is handed back, rather than being the
  // branch that chose it: two rays are the same only when they are the same
  // one, and a branch holding a ray is not the ray it holds.
  min (other: Ordered) => (
    smaller := other
    if (.<(other)) { smaller = this }
    smaller
  )
  max (other: Ordered) => (
    larger := this
    if (.<(other)) { larger = other }
    larger
  )
}

