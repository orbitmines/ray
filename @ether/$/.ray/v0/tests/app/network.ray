// Requests, responses and messages are values; each protocol's wire format reads them and writes them.

mark ^keyword := external global

asked := HTTP.Request(target: @https://example.com/a?b=1)
unless asked.method == HTTP.Method.get { INFO@mark `HT1 a request without a method is not a GET` }
unless asked as HTTP.v1_1 == "GET /a?b=1 HTTP/1.1\r\nHost: example.com\r\n\r\n" { INFO@mark `HT2 a request is not written as its request line and Host` }
posted := HTTP.Request(method: HTTP.Method.post, target: @http://example.com/, body: "hi" as Byte[])
unless posted as HTTP.v1_1 == "POST / HTTP/1.1\r\nHost: example.com\r\nContent-Length: 2\r\n\r\nhi" { INFO@mark `HT3 a body is not framed by its length` }
answered := HTTP.v1_1.read("HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\ncontent-type: text/plain\r\n\r\nnope")
unless answered.status.code == 404 { INFO@mark `HT4 a status line does not give its code` }
unless answered.status.kind == HTTP.Status.Kind.client_error { INFO@mark `HT5 404 is not a client error` }
unless answered.fields["Content-Type"] == "text/plain" { INFO@mark `HT6 a field name is read case-sensitively` }
unless answered.text == "nope" { INFO@mark `HT7 a body of a given length is not read` }
chunked := HTTP.v1_1.read("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhi\r\n1;x=y\r\n!\r\n0\r\n\r\n")
unless chunked.text == "hi!" { INFO@mark `HT8 chunks are not joined into the body` }
read_back := HTTP.v1_1.read(asked as HTTP.v1_1)
unless read_back.target.host == "example.com" && read_back.target.origin_form == "/a?b=1" { INFO@mark `HT9 a written request does not read back to its target` }
unless HTTP.Fields(entries: [(name: "A", value: "1"), (name: "a", value: "2")])["A"] == "1, 2" { INFO@mark `HT10 repeated fields do not combine` }
unless HTTP.Method.get.safe && !HTTP.Method.post.safe { INFO@mark `HT11 GET is not safe or POST is` }
unless HTTP.Status(200).reason == "OK" { INFO@mark `HT12 200 has no reason phrase OK` }
unless HTTP.v1_1.read("HTTP/1.1 204 No Content\r\n\r\n").body.empty { INFO@mark `HT13 a 204 response is read with a body` }
unless Compiler.reduced(HTTP.Exchange(posted), HTTP.Optimizations).format === HTTP.v1_1 { INFO@mark `HT14 a plain http exchange left HTTP/1.1` }
unless HTTP.Response(status: HTTP.Status(200), body: "ok" as Byte[]) as HTTP.v1_1 == "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok" { INFO@mark `HT15 a response is not written as its status line` }

question := Network.DNS.query("example.com")
unless question.questions.count == 1 { INFO@mark `DN1 a query does not ask one question` }
unless question.qdcount == 1 { INFO@mark `DN2 the header does not count its question` }
unless question.recursion_desired { INFO@mark `DN3 a query does not ask for recursion` }
asked_bytes := question as Byte[]
unless asked_bytes.count == 29 { INFO@mark `DN4 a query for example.com is not 29 bytes` }
unless asked_bytes[12] == 7 { INFO@mark `DN5 a label does not start with its length` }
unless (asked_bytes as Network.DNS.Message).named(question.questions.first.name) as String == "example.com" { INFO@mark `DN6 a name does not read back` }
unless question.named(Network.DNS.Name(labels: [], pointer: 12)) as String == "example.com" { INFO@mark `DN7 a pointer does not name what it points at` }
replied := question.answer([Network.DNS.Record(name: Network.DomainName(text: "example.com") as Network.DNS.Name, type: Network.DNS.Type.A, data: "93.184.215.14" as IPv4)])
unless replied.response { INFO@mark `DN8 an answer is not a response` }
unless replied.id == question.id { INFO@mark `DN9 an answer does not carry the query's id` }
unless replied.addresses.first as String == "93.184.215.14" { INFO@mark `DN10 an answer does not give its address` }
unless (replied as Byte[] as Network.DNS.Message).answers.first.data as String == "93.184.215.14" { INFO@mark `DN11 an answer does not read back` }
unless Network.DNS.Type.AAAA.code == 28 { INFO@mark `DN12 AAAA is not type 28` }
large := Network.DNS.Message(questions: (1..40).map(Network.DNS.Question(name: Network.DomainName(text: "a-name-long-enough-to-matter.example.com") as Network.DNS.Name)))
unless Compiler.reduced(Network.DNS.Lookup(large), Network.DNS.Optimizations).transport == Network.DNS.Transport.tcp { INFO@mark `DN13 a message over 512 bytes is not sent over TCP` }
unless Compiler.reduced(Network.DNS.Lookup(question, server: @https://dns.example/dns-query), Network.DNS.Optimizations).transport == Network.DNS.Transport.https { INFO@mark `DN14 an https resolver is not asked over HTTPS` }

hello := WebSocket.Frame(opcode: WebSocket.Opcode.text, payload: "Hello" as Byte[])
unless hello as Byte[] == [0x81, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f] { INFO@mark `WS1 an unmasked text frame is not written as in RFC 6455 section 5.7` }
unless ([0x81, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58] as WebSocket.Frame).payload as String == "Hello" { INFO@mark `WS2 a masked frame does not unmask` }
unless WebSocket.accept("dGhlIHNhbXBsZSBub25jZQ==") == "s3pPLMBiTxaQ9kYGJXdfdmW3w4M=" { INFO@mark `WS3 the accept key is not the one in RFC 6455 section 1.3` }
long := WebSocket.Frame(opcode: WebSocket.Opcode.binary, payload: [0] * 256)
unless long.short == 126 && long.medium == 256 { INFO@mark `WS4 a 256 byte payload does not take the 16 bit length` }
pieces := WebSocket.Stream(frames: [
  WebSocket.Frame(fin: false, opcode: WebSocket.Opcode.text, payload: "Hel" as Byte[]),
  WebSocket.Frame(opcode: WebSocket.Opcode.ping),
  WebSocket.Frame(opcode: WebSocket.Opcode.continuation, payload: "lo" as Byte[])
])
unless pieces.messages.first.data == "Hello" { INFO@mark `WS5 fragments are not joined into one message` }
unless pieces.controls.count == 1 { INFO@mark `WS6 a control frame between fragments is lost` }
unless Compiler.reduced(WebSocket.Writing(WebSocket.Message("hi")), WebSocket.Framing).masked { INFO@mark `WS7 a client's frame is not masked` }
if Compiler.reduced(WebSocket.Writing(WebSocket.Message("hi"), from: WebSocket.Side.server), WebSocket.Framing).masked { INFO@mark `WS8 a server's frame is masked` }
opening := WebSocket.opening(@wss://example.com/chat)
unless opening.fields["Upgrade"] == "websocket" && opening.fields["Sec-WebSocket-Version"] == "13" { INFO@mark `WS9 the opening request does not ask to upgrade` }
unless WebSocket.opened(opening, WebSocket.accepting(opening)) { INFO@mark `WS10 an accepted opening is not open` }
unless WebSocket.Opcode.close.control && !WebSocket.Opcode.text.control { INFO@mark `WS11 close is not a control frame or text is` }
