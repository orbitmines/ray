// The Base 32 Encoding (https://www.rfc-editor.org/rfc/rfc4648#section-6)
Base32 := class (quintets: (Binary⁵ as Alphabet)[], "="[]{length == (8 - quintets.count % 8) % 8}) {
  // Table 3: The Base 32 Alphabet
  static Alphabet = ("A".."Z", "2".."7") as String

  bytes: Byte[] => quintets.map(.integer).flatten.chunk(8){.count == 8}.map(Binary(integer: .))
  static (bytes: Byte[]) as (=== Base32) => Base32(quintets: bytes.map(.integer).flatten.chunk(5).map(Binary(integer: (., ["0"] * (5 - .count)))))

  static language = Language(".base32",
    level: { {text: String} => (text as Base32).bytes },
    written: { {writing: Language.Writing} => writing.value as Byte[] as Base32 })
}
