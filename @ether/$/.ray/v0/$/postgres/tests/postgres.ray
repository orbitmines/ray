// Postgres: SQL sent to psql.

mark ^keyword := external global

schema := "public"
unless (@postgres SELECT table_name FROM information_schema.tables WHERE table_schema = {schema}).from == "information_schema.tables" { INFO@mark `DB27 a single-line postgres fragment does not read a qualified table` }
postgres_block := @postgres {
  /* the tables in a schema */
  SELECT table_name AS name FROM information_schema.tables WHERE table_schema = {schema} ORDER BY name LIMIT 10
}
unless postgres_block.count == 2 && postgres_block.first is SQL.Comment && postgres_block.last.limit.value == 10 && postgres_block.last.where.right.value == "public" { INFO@mark `DB28 a postgres block is not its comment and query with the hole's value` }
