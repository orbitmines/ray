// (Char is made in the entrypoint, its core; what follows is the rest of it)
Char &+= {
  static Letter: Char = "a".."z" | "A".."Z"
  static Digit: Char = "0".."9"
  static Blank: Char = " " | "\t".."\r"
  static Word: Char = Letter | Digit | "_"
  static Symbol: Char = Unicode.GeneralCategory.(Punctuation | Symbol)

  is_ascii => this < 128
  bytes => ([this] as String).bytes

  special_casing => Unicode.SpecialCasing.rows{.range.in(this) && !.condition}.first
  upper_case | uppercase => special_casing?.upper ?? Unicode.UpperCase[this] ?? this
  lower_case | lowercase => special_casing?.lower ?? Unicode.LowerCase[this] ?? this
  title_case | titlecase => special_casing?.title ?? Unicode.TitleCase[this] ?? upper_case
  is_upper => lower_case != this
  is_lower => upper_case != this
  mirrored => Unicode.BidiMirroring[this]?.value ?? this
  swap_case | swapcase => is_lower ? upper_case : lower_case
  fold_case | foldcase => Unicode.CaseFolding.rows{.range.in(this) && .status is ("C" | "F")}.first?.value ?? this

  // Unicode §3.7: the full canonical decomposition, a mapping without a <tag> applied until nothing decomposes (https://www.unicode.org/versions/latest/core-spec/chapter-3/#G733)
  decomposed => Unicode.Data[this]?.decomposition_mapping -- (. && !(. ~= ⊢"<") ? (. as Unicode.Scalar[].join(" ")).map(.decomposed).flatten : [this])
  combining_class => (Unicode.Data[this]?.canonical_combining_class ?? "0") as Decimal

  decimal_digit_value => Unicode.DecimalDigitValue[this]
  digit_value => Unicode.DigitValue[this]
  numeric_value => Unicode.NumericValue[this]
  baseline => Unicode.Superscript[this] ?? Unicode.Subscript[this] ?? this
  superscript => Unicode.Superscript⁻¹[this]
  subscript => Unicode.Subscript⁻¹[this]
  as (=== Decimal) => digit_value ?? lower_case - "a" + 10
  static digit (value: Decimal): Char => value < 10 ? "0" + value : "a" + value - 10
  static (codepoint: Unicode.Scalar) as (=== Char) => codepoint

  east_asian_width => Unicode.EastAsianWidth[this]?.value ?? "N"
  columns => east_asian_width is ("W" | "F") ? 2 : 1
  script => Unicode.Scripts[this]?.value ?? "Unknown"
  block => Unicode.Blocks[this]?.value ?? "No_Block"
  age => Unicode.Age[this] -- . ? Version(number: .number, revision: .revision) : None
  assigned => age && age <= Unicode.version
}
Char.components.hierarchy &= Unicode.Scalar

Escape := {
  \0 => U+0000
  \a => U+0007
  \b => U+0008
  \t => U+0009
  \n => U+000A
  \f => U+000C
  \r => U+000D
  \e => U+001B
  \\ => U+005C
  \" => U+0022
  \{ => U+007B
}
dynamically Escape.for spelling => global[spelling] := Compiler.reduced(spelling, Escape)

\s = Unicode.GeneralCategory.Space_Separator | \t
\S = !\s
\R = Unicode.GeneralCategory.Line_Separator
\{prefix: "x" | "u" | "U"}{codepoint: Hexadecimal{length == (x: 2, u: 4, U: 6)[prefix]} | ("{", codepoint: Hexadecimal{length == 1..6}, "}")}: Char => codepoint
\d = Unicode.GeneralCategory.Decimal_Number
\D = !\d
\w = Char.Word
\W = !\w

Balanced := (Char{!= "{" && != "}" && != "\""} | ("{", Balanced, "}"))[]
Interpolation := class ("{", code: Balanced, "}")
"{literal: (\{escape} | Interpolation | Char{!= "\""})[]}": String => literal.map(. is Interpolation ? (inline (.code**)) as String : .).join("").literal_dedented

LanguageName := String{Language.named("." + .) != None}
@{extension: LanguageName}`{literal code ^string}` ^string.punctuation => Language.named("." + extension).read(code)
@{extension: LanguageName} {code} => Compiler.reduced(code, Language.named("." + extension).level)

// (String is made in the entrypoint, its core; what follows is the rest of it)
String &+= {
  () => &caller[this]()

  upper_case | uppercase => #.upper_case as String
  lower_case | lowercase => #.lower_case as String
  is_upper => some(.is_upper) && !some(.is_lower)
  is_lower => some(.is_lower) && !some(.is_upper)
  swap_case | swapcase => #.swap_case as String
  ignore_case | ignorecase => this.copy ~~ .normalizer = (text) => text.fold_case
  fold_case | foldcase => #.fold_case as String
  title_case | titlecase => words.map(.[0].title_case, .[1..].lower_case).join(" ")
  baseline => #.baseline as String
  superscript => #.superscript as String
  subscript => #.subscript as String

  words => split(Char.Blank | "_")
  snake_case | snakecase => words.lower_case.join("_")
  camel_case | camelcase | camelCase => words[0].lower_case, words[1..].title_case
  pascal_case | pascalcase | PascalCase => words.title_case as String

  //TODO Uncide support
  plural => ends_with("s") ? this : this + "s"
  singular => ends_with("s") ? this[..<-1] : this

  mirrored => <-#.mirrored as String
  compounds * (count: Number) => count == 0 ? "" : this, this * (count - 1)

  trimmed => this[{!(⊢ Char.Blank[] | Char.Blank[] ⊣)}]
  trimmed_end => this[{!(Char.Blank[] ⊣)}]
  trimmed (characters: Char[]) => this[{!(⊢ characters[] | characters[] ⊣)}]
  before (other: String) => this ~= (before: *, other, *) -- .before ?? this
  after (other: String) => this ~= (*, other, after: *) -- .after ?? ""

  starts_with (other: String) => this ~= ⊢ other
  ends_with (other: String) => this ~= other ⊣
  contains (other: String) => this ~= other
  index_of (other: String) => (this ~= other)?.index

  lines => split(\n)
  indentation => (this ~= ⊢ " "[]).length
  common_indentation => lines{!.trimmed.empty}.map(.indentation).min ?? 0
  dedented => lines.map(.trimmed.empty ? "" : .[common_indentation..]).join(\n)
  literal_dedented => lines.count == 1 || !lines.first.trimmed.empty ? this
    : (lines[1..] -- (.last.trimmed.empty ? .[..<-1] : .)).join(\n).dedented

  replace (old: String, new: String) => split(old).join(new)

  // UAX #15 §1.2: NFD is the full canonical decomposition, each run of non-starters then put in order of Canonical_Combining_Class (https://www.unicode.org/reports/tr15/#Norm_Forms, https://www.unicode.org/versions/latest/core-spec/chapter-3/#G49537)
  nfd => (#.decomposed.flatten as String).ordered
  ordered => empty ? "" : first.combining_class == 0 ? first, rest.ordered : marks.sort_by(.combining_class), this[marks.count..].ordered
  marks => empty || first.combining_class == 0 ? [] : first, rest.marks
  // UTS #39 §4: skeleton(X) is NFD(X) with each character replaced by its prototype, then NFD again; X and Y are confusable when their skeletons are equal (https://www.unicode.org/reports/tr39/#def-skeleton)
  skeleton => (nfd#.map(Unicode.confusables[.]?.prototype ?? [.]).flatten as String).nfd
  confusable (other: String) => skeleton == other.skeleton
  // UTS #39 §5.1: Common and Inherited characters go with any script, so a string of one other script is single-script (https://www.unicode.org/reports/tr39/#Mixed_Script_Detection)
  mixed_script => #.script{!= "Common" && != "Inherited"}.unique.count > 1
  escaped_line => #.map(Compiler.reduced(., Escape⁻¹)) as String

  as (base: Number.Base) => Number.numeral(base)(integer: this)
  as (=== Decimal) => Decimal(integer: this)

  bytes => (this as Unicode.UTF-8).bytes
  find_all (pattern: String) => (this ~= pattern)#.index
}
String.components.hierarchy &= Char[]

String[] &+= {
  as (=== String) => this.reduce(,)
}

String{length == 1} as Char => first

Placement := class nth_class: Number, written_at: Number {
  chainable <= (other: Placement) => nth_class < other.nth_class || (nth_class == other.nth_class && written_at >= other.written_at)
}
Node &+= {
  placed (spelled) => classes.enumerate{.value.written_as.precedence(spelled) != None}.first
    -- . ? Placement(nth_class: .index, written_at: .value.written_as.precedence(spelled)) : None
}
{a} [x] {b} [y] {c} => a.placed(x) && a.placed(y)
  ? (a.placed(x) <= a.placed(y) ? (a [x] b) [y] c : a [x] (b [y] c))
  : None

ParameterList := String{!.contains("{")}
({parameters: ParameterList}) => {block} =>
  Program(code: (block**), parameters: (parameters**), context: this)
