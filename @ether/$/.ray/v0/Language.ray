// A language is a reader and a writer, possibly over another language: `FILE.ext.ray` is `.ext` read over Ray (P7, P8.9).
Language := class = extensions: String | String[], location: Location[] = [], level: Compiler?, reader: Function?, writer: Function?, of: Language?, version: Version?, versions: Language[] = [], implementations: Implementation[] = [], targets: Language[] = [] {
  static known: Language[] = []
  static register (language: Language) => known.push language -- language
  static named (extension: String) => known{.names(extension)}.first
  static over (outer: Language, base: Language) => outer -- .of = base

  // The language a file is written in, by its extension (`$.ext` names one, P7.1); `as String` prints in it (X1.7).
  static for_file (file_name: String) => file_name ~= (*, ".", inner: Char.Word[], ".ray") ⊣
    ? over(named("." + inner), ray)
    : named("." + (file_name ~= (*, ".", last: Char.Word[]) ⊣).last)
  static ray => named(".ray")

  names (extension: String) => extensions == extension
  // The projects a language ships with: its own .ray files, `@ether/UI` for Ray (P8.8).
  bundled (path: String) => location.map(. / path){IO.read(. / ".project.ray")}.first as Project

  read (text) => reader?((of?.read(text)) ?? text) ?? Quest(name: "a reader for the language", goal: this)
  write (value) => writer ? (of?.write(writer(value)) ?? writer(value)) : Quest(name: "a writer for the language", goal: this)

  target (language: Language) => targets.push language -- this
  targeting (language: Language) => targets.contains(language)
  implement (implementation: Implementation) => implementations.push implementation -- this
  versioned (language: Language) => versions.push language -- this
  backwards_compatible => versions{.version < version}.every(.targeting(this))
  forwards_compatible => versions{.version > version}.every(.targeting(this))

  // Implementations are read as languages: the Library setup (X2, X4.1).
  static Implementation := class = language: Language, written_in: Language, location: Location {
    source => IO.read(location)
    reader => written_in.read(source)
    setup => language.implement(this) -- language.reader ??= reader -- language
  }

  // A sublanguage leaves effects out, and may require termination: the cfg language (P7.4).
  static Sublanguage := class: Language = excluded: Effects.Source[] = [], terminating: boolean = true {
    admits (program: Program) => !Effects.of(program).some(excluded.contains(.)) && (!terminating || program ==.instance_of Terminating)
    read (text) => of.read(text) -- admits(.) ? . : ERROR@text `this file is written in a sublanguage that does not permit what it does`
  }
}

Library := class: Language
Tool := class = location: Location[] = []

Language.register(Language(".ray", level: Compiler.default))
Language.cfg = Language.register(Language.Sublanguage(extensions: ".cfg", of: Language.ray, excluded: [io, os, random, time, network] as Effects.Source[]))
Language.regex = Language.register(Language(".regex"))

Regex := class (pattern: String) => {
  language => Language.regex
  compiled => language.read(pattern)
  matches (text: String) => text ~= compiled
  find (text: String) => (text ~= compiled)?.index
  ignoring_case => Regex(pattern.fold_case)
}
