-> (): Ray => next: () => Ray(next: next())
<- (): Ray => previous: () => Ray(previous: previous())
<--> (): Ray => (<-) &+ (->)

Ordered<T = static> := class {
  < (b: T) => TODO
  > (b: T) => b < this
  <= (b: T) => this == b || this < b
  >= (b: T) => this == b || this > b
  min (b: T) => this <= b ? this : b
  max (b: T) => this >= b ? this : b
}

Iterable<Vertex: Ray = Ray> := class: Ordered {
  entry: Vertex? => TODO

  dynamically assert count < ∞ if bounded: boolean = true

  empty => count == 0
  nonempty => !empty
  unbounded => !bounded
  orderless => false

  connected => all.every(a => all.every(b => a.to(b)))
  consistent => all.every(.next?.previous == . && .previous?.next == .)
  acyclic => !all.some(.next** contains .)
  undirected => all.every(.initial === .terminal)
  unidirectional => all.every(!.previous)

  compact => this{!=.instance_of None}

  static boundary := class {
    () => boundary.initial | boundary.terminal
    initial: Boundary => (⊢all{is_initial}){⊙.is_initial}
    terminal: Boundary => (all{is_terminal}⊣){⊙.is_terminal}
  }

  first => all{is_first}
  last => all{is_last}

  for <traverse: Traverser = Traverser.default>(yield: (x: Vertex): *) => traverse<.yield: yield<local: &caller, break: return>>(entry) if entry

  every (predicate: (x: Vertex): boolean) => map(predicate){== false}.empty
  some (predicate: (x: Vertex): boolean) => this{predicate}.nonempty
  filter (predicate: (x: Vertex): boolean) => this{predicate}

  // `reduce((acc) => …)` seeds with the first element, `reduce(acc = 0 => …)` with what it is given; `.` is the element (R2.4).
  reduce (step: Program) => rest.reduced(first, step)
  .reduce({accumulator ^parameter}{ }{`=`}{ }{initial}{ }{`=>`}{ }{step}) ^punctuation => reduced(initial, Program(code: (external ** step), parameters: (external ** accumulator)))
  .reduce({literal operator ^operator}) ^punctuation => .reduce((acc) => acc[operator] .)
  reduce_right | fold_right | foldr => reverse.reduce
  reduced (seed, step: Program) => empty ? seed : rest.reduced(step.entered(first, seed), step)

  all => reduce(|)
  right-to-left Σ | sum => reduce(total = 0 => total + .)
  right-to-left ∑ => sum
  right-to-left ∏ | product => reduce(total = 1 => total * .)
  min => reduce((acc) => acc < . ? acc : .)
  max => reduce((acc) => acc > . ? acc : .)
  count => ∃length trivially == ∞ ? ∞ : reduce(acc = 0 => acc + 1)
  length => paths.length
  paths: Path{.bounded: bounded} => [this]

  rest => entry?.next ?? []
  map (mapping: (x: Vertex): *) => empty ? [] : mapping(first), rest.map(mapping)
  reverse => empty ? [] : rest.reverse, first
  sort => empty ? [] : rest{< first}.sort, first, rest{>= first}.sort
  sorted (key) => sort_by(key)
  sort_by (key) => empty ? [] : rest{key(.) < key(first)}.sort_by(key), first, rest{key(.) >= key(first)}.sort_by(key)
  unique => empty ? [] : first, rest{!= first}.unique
  unordered => choose Iterable{.every(this.contains(.)) && .count == count}

  contains | includes <operator: (x: Vertex): (b: Vertex): boolean = ==>(x: Vertex) => some(operator(.)(x))
  partition (predicate) => [this{predicate}], [this{!predicate(.)}]
  batch | chunk (size: Number) => empty ? [] : [this[..size]], this[size..].chunk(size)
  flatten => reduce(acc = [] => acc, .)
  flatten (levels: Number) => levels == 0 ? this : map(. ==.instance_of Iterable ? .flatten(levels - 1) : [.]).flatten
  intersection (other: Iterable) => this{other.contains(.)}
  disjoint (other: Iterable) => intersection(other).empty
  xor | symmetric_difference (other: Iterable) => this{!other.contains(.)}, other{!this.contains(.)}
  split (delimiter) => this ~= (*, delimiter)[] -- #.join(*)
  enumerate => map((x) => (index: x.index, value: x))
  zip (other: Iterable) => empty || other.empty ? [] : [(first, other.first)], rest.zip(other.rest)
  join (separator) => reduce((acc) => acc, separator, .)
  random => this[Random.below(count)]
  fill (x) => all = x
  take (count: Number) => this[..count]
  find (predicate) => this{predicate}.first
  find_all (predicate) => this{predicate}
  shuffled => empty ? [] : (picked = random), this{!== picked}.shuffled
  squeeze => this{. != .previous}

  // `Binary₈[]₄`: compose the structure `count` times.
  * (count: Number) => count == 0 ? [] : this, this * (count - 1)
  ^ (count: Number) => this{.count == .count ? .count * count : count}

  + (at: Integer) => this[at]
  - (at: Integer) => this[-at]
  ± | +- | -+ (at: Integer) => this[at] | this[-at]
  [at: Integer] => at == 0 ? entry : at > 0 ? rest[at - 1] : reverse[-at - 1]
  [range: Range] => range.map(this[.])

  // `x: String[] = "String", Object, "String", Object`
  as (: Iterable<R: ?>) => this{==.instance_of R}

  == (other: Iterable) => orderless || other.orderless
    ? count == other.count && every(other.contains(.))
    : empty ? other.empty : other.nonempty && first == other.first && rest == other.rest
}

Ray := class: Iterable & Ordered {
  initial | (internal right-to-left ⊢) : Boundary = Boundary.Initial(∙: this)
  terminal | (internal ⊣) : Boundary = Boundary.Terminal(∙: this)

  is_initial => !previous
  is_terminal => !next
  is_first => is_initial
  is_last => is_terminal
  is_boundary => is_initial || is_terminal

  entry => this
  first => is_initial ? this : previous.first
  last => is_terminal ? this : next.last
  index => is_initial ? 0 : previous.index + 1
  count => is_terminal ? 1 : next.count + 1

  .. (last: Ray) => this === last ? [this] : next ? this, next..last : None

  expand => first..last
  // The whole context except this value: the complement with the context as the universal set (R3.7).
  complement => expand{!== this}

  continuations => [next]{!= None}
  reachable => this, continuations.map(.reachable).flatten -- .unique

  // All paths, or a quest when there is none (R3.4).
  path_to | between (target, trail = []) => this === target ? [[trail, this]]
    : continuations{!trail.contains(.)}.map(.path_to(target, [trail, this])).flatten(1)
    -- . ?? Quest(name: "find a path", goal: target)
  shortest_path_to (target) => path_to(target).min(.count)

  complement (selection) => reachable{!selection.contains(.)}

  // Removing a vertex: preserving joins its neighbours, severing leaves them apart (R3.1, R3.11).
  remove_preserving => {
    previous?.next = next
    next?.previous = previous
    next, previous = None
  } -- this
  sever => {
    previous?.next = None
    next?.previous = None
    next, previous = None
  } -- this
  move_after (other) => remove_preserving -- {
    (next, previous) = (other.next, other)
    other.next?.previous = this
    other.next = this
  }
}

Boundary := class: Ray {
  vertex | (internal bidirectional ∙) : Ray
  edge | (internal bidirectional ⊙) : Edge

  is_initial => !edge
  is_terminal => !edge

  static Initial := class: Boundary {
    ⊙ = Edge(x.terminal: this)
    is_initial => !∙.previous
    is_terminal => false
  }
  static Terminal := class: Boundary {
    ⊙ = Edge(x.initial: this)
    is_initial => false
    is_terminal => !∙.next
  }
}

Edge := class: Ray {
  value | (internal x) : {
    initial | (internal right-to-left ⊣) : Boundary?
    terminal | (internal ⊢) : Boundary?
  }

  is_initial => x.initial == None
  is_terminal => x.terminal == None
}

// `with (Traverser.default = BreadthFirst)`
Traverser := class: <yield: (x: Ray): None>(entry: Ray): None {
  static default = DepthFirst

  static DepthFirst: Traverser = (entry: Ray) => {
    yield entry
    entry.next?.for<DepthFirst>(yield)
  }
  static BreadthFirst: Traverser = (entry: Ray) => {
    level = [entry]
    while level.nonempty {
      level.for yield
      level = level.map(.next){!= None}
    }
  }
}

Structure := class: Iterable<Ray{
  initial & terminal : (1 unless HyperContinuations) Vertex.Boundary
}> {
  Vertex.Boundary = Boundary{
    ∙: (1 unless HyperEdges) Vertex
    ⊙: (1 unless HyperEdges) Edge{
      initial & terminal : (1 unless HyperEdges) Vertex.Boundary
    }
  }
  static HyperContinuations: boolean
  static HyperEdges: boolean = false
}

Hypergraph := class: Structure {
  HyperEdges = true
}
Graph := class: Structure {
  HyperContinuations = true

  static Simple := class: Graph = vertices: *[] = [], edges: Edge[] = [] {
    static Edge := class = from: *, to: *

    vertex (value) => vertices.contains(value) ? value : vertices.push(value)
    connect (from, to) => { vertex(from); vertex(to); edges.push Edge(from, to) } -- this
    connected (from, to) => edges.some(.from == from && .to == to)
    outgoing (vertex) => edges{.from == vertex}.to

    // Products and unions (R4.3)
    cartesian (other: Simple) => Simple(
      vertices: vertices * other.vertices,
      edges: (edges * other.vertices).map((e, v) => Edge((e.from, v), (e.to, v))), (vertices * other.edges).map((v, e) => Edge((v, e.from), (v, e.to)))
    )
    tensor (other: Simple) => Simple(vertices: vertices * other.vertices, edges: (edges * other.edges).map((a, b) => Edge((a.from, b.from), (a.to, b.to))))
    union (other: Simple) => Simple(vertices: (vertices, other.vertices).unique, edges: (edges, other.edges).unique)
    disjoint_union (other: Simple) => Simple(
      vertices: vertices.map((0, .)), other.vertices.map((1, .)),
      edges: edges.map(Edge((0, .from), (0, .to))), other.edges.map(Edge((1, .from), (1, .to)))
    )

    without (vertex) => Simple(vertices: vertices{!= vertex}, edges: edges{.from != vertex && .to != vertex})
    dangling (vertex, kept) => edges.some((.from == vertex || .to == vertex) && !(kept.contains(.from) && kept.contains(.to)))

    // Double- and single-pushout rewriting (R3.11)
    static Rule := class = left: Simple, interface: Simple, right: Simple, single_pushout: boolean = false {
      deleted => left.vertices{!interface.vertices.contains(.)}
      added => right.vertices{!interface.vertices.contains(.)}

      applies (host: Simple) => left.vertices.every(host.vertices.contains(.))
        && (single_pushout || !deleted.some(host.dangling(., host.vertices{!deleted.contains(.)}, left.vertices)))
      apply (host: Simple) => applies(host)
        ? deleted.reduce(acc = host => acc.without(.)) -- added.for(.vertex) -- right.edges{!.connected(.from, .to)}.for(.connect(.from, .to))
        : Quest(name: "rewrite", goal: host)
    }
  }
}
Forest := class: Structure{acyclic & consistent} {
  Vertex = Ray{terminal: Vertex.Boundary, initial: 1 Vertex.Boundary}
  HyperContinuations = true
}
Tree := class: Forest{connected}
Path := class: Structure{consistent & connected} {
  HyperContinuations = false

  paths => this
  length => acyclic ? count : ∞
}
Array := class: Path{acyclic}
Set := class: Structure {
  orderless => true
  normalizer = .unordered.unique
}

Hierarchy := class: Ray {
  parent | previous : static? <- hierarchy -> children | next : static?

  holds (child) => children.some(== child || .holds(child))
  depth => parent ? parent.depth + 1 : 0
}

// A loop goes around what it is made of: `Array.unbounded.orbit` (R5.1).
Loop := Array.Unbounded.orbit
Iterable &+= {
  orbit | loop => Loop(around: this, at: first)
}
Loop &+= {
  next => Loop(around, at: at.next ?? around.first)
  previous => Loop(around, at: at.previous ?? around.last)
  is_initial => false
  is_terminal => false
  bounded => false
  acyclic => false

  unrolled => around
  instances (times: Number) => around * times
  unrolled_mod => around[at.index..], around[..at.index]
  disallow_loops => around
}

Array &+= {
  push_back | push (x) => this, x
  push_front (x) => x, this
  pop_front => remove(first)
  pop_back => remove(last)
  remove (x) => this{!= x}
  push_after (at, x) => this[..at.index + 1], x, this[at.index + 1..]
  push_before (at, x) => this[..at.index], x, this[at.index..]
  move_after (x, target) => remove(x).push_after(target, x)
  move_before (x, target) => remove(x).push_before(target, x)
}
