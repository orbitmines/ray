{hh: Decimal.String}:{mm: Decimal.String{length == 2}}: Quantity.Temporal => hh hours mm minutes
assert 12:00 == 12 hours  // TI82 12:00 is not twelve hours
{hh_mm: Quantity.Temporal{.quantities.last.unit == minute}}:{ss: Decimal.String{length == 2}}: Quantity.Temporal => hh_mm ss seconds
assert 12:00:30 == 12 hours 30 seconds  // TI83 12:00:30 is not twelve hours and thirty seconds

Calendar := class {
  static Segment := class: Unit (length: *) => {
    static (unit: Unit, length): Calendar.Segment => unit.copy ~~ .length = length

    static EPOCH: (period: #, elapsed: Node{0 <= . < period}?)? | Number = 1

    is_recurring => this is Ray && this.length#.some(== ∞)

    dynamically assert #.every(. is Quantity.Temporal)
  }

  static segments := static*{. is Segment}
  internal static TimeDefinition = Time{(-> .epoch).every(.calendar == calendar)}
  static equivalence (from: TimeDefinition) -> (to: TimeDefinition{calendar == this}) => {
    within_same_calendar_system = from.calendar.static == to.calendar.static

    Time{calendar == from.calendar} &+= {
      as (=== to.calendar) => {
        if epoch != 0 {
          Time(to.calendar, epoch: epoch as to.calendar) = this (as <= Unit.Temporal if !within_same_calendar_system)
        } else {
          Time(to.calendar) = to + (this - from) (as <= Unit.Temporal if !within_same_calendar_system)
        }
      }
    }
    assert {
      (
        with Time.YEAR = 2024
        assert 1 month as days == 31 days  // TI26 january in a leap year is not thirty-one days
        (
          with Time.MONTH = February
          assert 1 month as days == 29 days  // TI23 february in a leap year is other than twenty-nine days
        )
      )
    }
    assert {
      (
        with { Time.YEAR = 2023, Time.MONTH = February }
        assert 1 month as days == 28 days  // TI24 february in a plain year is other than twenty-eight days
      )
    }
    assert ("2024-02-07T12:00:00Z" as ISO_8601 as Time).(
      9:00 <= . <= 17:00  // TI90 noon on any day is not between 9:00 and 17:00
      & !(13:00 <= .)  // TI91 noon is after 13:00
    )
    assert {
      summer := "2024-07-01T12:00:00Z" as ISO_8601 as Time
    }
    assert {
      winter := "2024-01-15T12:00:00Z" as ISO_8601 as Time
    }
    assert {
      with (Time.YEAR = 4, Time.MONTH = February) {
        assert 1 month as days == 29 days  // TM6 February of year 4 has other than 29 days
      }
    }
    assert (Time(calendar: Gregorian) = 15 seconds) - (Time(calendar: Gregorian) = 10 seconds) == 5 seconds  // TM12 time difference is not five seconds
  }
}

Weekday := enum Monday | Tuesday | Wednesday | Thursday | Friday | Saturday | Sunday
assert Weekday#.first == Monday  // TI28 a week does not begin on monday
assert Weekday#.last == Sunday  // TI29 a week does not end on sunday
assert !(Monday == Tuesday)  // TI30 two weekdays are the same day
assert Sunday as String == "Sunday"  // TM13 sunday has no name
Month := enum January | February | March | April | May | June | July | August | September | October | November | December
assert Month#.count == 12  // TI12 a year has other than twelve months
Month &+= {
  days_in (year: Julian) => year.days_in(this)
  assert February.days_in(Gregorian(year: 2024)) == 29  // TI92 February 2024 does not have twenty-nine days
}

Julian := class: Calendar {
  static year := Calendar.Segment(global.year, day -> 365 | 366 if is_leap_year)
  assert Julian(year: 4).is_leap_year  // TI8 the fourth year is not a leap year
  assert !(Julian(year: 5).is_leap_year)  // TI9 the fifth year is a leap year
  assert Julian(year: 100).is_leap_year  // TI18 a hundred is not a leap year in the Julian
  assert "2024-02-07" as ISO_8601 .year == 2024  // TI66 the year written first is not read
  assert Gregorian(year: 2023).days_in_year == 365  // TI73 an ordinary year is not three hundred and sixty-five days
  assert Gregorian(year: 2024).days_in_year == 366  // TI74 a leap year is not a day longer
  assert Gregorian(year: 2023).weeks_in_year == 52  // TI75 a year is not fifty-two weeks
  assert Gregorian(year: 2024).weekday_of(1) == Monday  // TI93 the first of January 2024 is not a Monday
  assert Gregorian(year: 2026).weeks_in_year == 53  // WD5 a year beginning on a Thursday does not have 53 weeks
  assert Gregorian(year: 2020).weeks_in_year == 53  // WD6 a leap year beginning on a Wednesday does not have 53 weeks
  assert Julian(year: 100).is_leap_year  // TM4 year 100 is not a Julian leap year
  static month := Calendar.Segment(global.month, Month#[
    31, 28 | 29 if is_leap_year, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31
  ] days)
  assert "2024-02-07" as ISO_8601 .month == February  // TI67 the second month written is not February
  assert Julian.month.EPOCH == 1 && "2024-01-01" as ISO_8601 .month == January && January.index + 1 == 1  // TI59 a segment does not start at one: January is not month 1
  assert "0004-03-01" as ISO_8601 .month == March  // TM7 the ISO month is not March
  static week := Calendar.Segment(global.week, Weekday#.length days)
  assert 1 week == 7 days  // TI13 a week has other than seven days
  assert Julian.week.is_recurring  // TI57 the weekdays do not recur
  static day := Calendar.Segment(global.day, 24 hours)
  assert 1 day == 24 hours  // TI5 a day is not twenty-four hours
  assert "1582-10-04" as Julian + 1 day as Gregorian == "1582-10-15" as Gregorian  // TI52 the day after the last Julian day is not the first Gregorian one
  static hour := Calendar.Segment(global.hour, 60 minutes)
  assert 1 hour as seconds == 3600 s  // TI3 an hour is not counted in seconds
  assert 1 hour == 60 minutes  // TI6 an hour is not sixty minutes
  assert !(Julian.hour.is_recurring)  // TI58 an hour of sixty minutes recurs
  static minute := Calendar.Segment(global.minute, 60 seconds)
  assert 1 minute == 60 seconds  // TI7 a minute is not sixty seconds

  is_leap_year => year % 4 == 0

  days_in (month: Month) => static.month.length[month.index] in day
  days_in_year => is_leap_year ? 366 : 365
  // ISO 8601-1:2019, week-numbering year: a year has 53 weeks when it begins on a Thursday, or is a leap year that begins on a Wednesday
  weeks_in_year => weekday_of(1) == Thursday || is_leap_year && weekday_of(1) == Wednesday ? 53 : 52
  days_before (month: Month) => Month#[..<Month#.index_of(month)].map(days_in).sum
  days_before_year => 365 * (year - 1) + (year - 1) / 4
  weekday_of (day_of_year: Number) => Weekday#.loop + (days_before_year + day_of_year - 1)
}

Gregorian := class: Julian {
  is_leap_year => year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
  assert Gregorian(year: 4).is_leap_year  // TI10 the fourth year is not a leap year in the Gregorian
  assert !(Gregorian(year: 100).is_leap_year)  // TI17 a hundred is a leap year in the Gregorian
  assert Gregorian(year: 400).is_leap_year  // TI38 four hundred is not a leap year in the Gregorian
  assert Gregorian(year: 4).is_leap_year  // TM2 year 4 is not a leap year
  assert !(Gregorian(year: 100).is_leap_year)  // TM3 year 100 is a Gregorian leap year
  assert Gregorian(year: 400).is_leap_year  // TM5 year 400 is not a leap year
  days_before_year => 365 * (year - 1) + (year - 1) / 4 - (year - 1) / 100 + (year - 1) / 400

  // Julian Thursday 4 October 1582 was followed by Gregorian Friday 15 October 1582: the same day is Julian 5 October and Gregorian 15 October
  equivalence "1582-10-05" as Julian -> "1582-10-15"
}

// whether a minute had a leap second is IANA's data (@ether/timezone adds it); without it every minute is 60 seconds
UTC := class: Gregorian (offset: Quantity.Temporal 0, leap_seconds: boolean = false) => {
  equivalence 0 -> offset
}
assert UTC().offset == 0  // TI19 UTC is at some offset
assert UTC() is GMT  // TI40 UTC without leap seconds is not GMT
assert !(UTC().leap_seconds)  // TI41 UTC counts leap seconds
assert !(UTC(leap_seconds: true) is GMT)  // GML1 UTC counting leap seconds is GMT
assert UTC(leap_seconds: true).leap_seconds  // GML2 UTC asked to count leap seconds does not
assert (UTC(offset: 3 seconds) = 0) - (UTC() = 0) == 3 seconds  // TI79 three seconds past the agreed point is not three seconds past the other
GMT := UTC{leap_seconds == false}
assert !(GMT().leap_seconds)  // TI78 the zone without leap seconds has them

Time := class: Quantity.Temporal (calendar: Calendar? UTC) => {
  epoch: Time{== calendar} = 0
  assert {
    five := Time(calendar: Julian) = 5 seconds
    eight := Time(calendar: Julian) = 8 seconds
    assert five == five  // TI46 a time is not itself
    assert !(five == eight)  // TI47 two times are the same
    assert five < eight  // TI48 five seconds in is not before eight
    assert eight - five == 3 seconds  // TI50 the three seconds between them are not three
    assert five + 3 seconds == eight  // TI51 five seconds on plus three is not eight
    assert (Time(calendar: Julian, epoch: five) = 2 seconds).since_calendar_epoch == 7 seconds  // TI55 two seconds after five is not seven since the start
    eighty := (Time(calendar: Julian, epoch: five) = 80 seconds).round(minute)
    assert eighty == (Time(calendar: Julian, epoch: five) = 60 seconds)  // TRO1 eighty seconds do not round down to a minute
    assert eighty.calendar == Julian  // TRO3 rounding lost the calendar
    assert eighty.unit == second  // TRO4 rounding changed the unit it counts in
    assert eighty.epoch == five  // TRO7 rounding lost the epoch
  }
  assert (Time(epoch: "2000-01-01") = "2025-01-01").years == 25  // TI84 twenty-five years after 2000 are not 25 years
  = (x) => {
    this -= x
    super(x)
  }
  dynamically assert (this -> .epoch).length != ∞

  since_calendar_epoch: Time => (this -> .epoch as calendar if .epoch != 0).sum

  as (=== calendar) => this

  chainable == (other: Time) => since_calendar_epoch in second == other.since_calendar_epoch in second
  chainable < (other: Time) => since_calendar_epoch in second < other.since_calendar_epoch in second
  time_of_day: Quantity.Temporal => ((since_calendar_epoch in second) % (Quantity(quantities: [(1, day)]) in second)) seconds
  chainable == (other: Quantity.Temporal) => time_of_day == other
  chainable < (other: Quantity.Temporal) => time_of_day < other
  chainable > (other: Quantity.Temporal) => other < time_of_day

  calendar.segments.for segment => dynamically Time.`segment.name.upper_case` = since_calendar_epoch.`segment.name`
  calendar.segments.for segment => `segment.name` => segment.is_recurring ? recur(epoch) : since_calendar_epoch as segment

  round (unit: Unit.Temporal) => Time(calendar, epoch: epoch) = (((this as unit).amount.round unit) as finer(Quantity(quantities: [(1, unit)])))
  assert (Time(calendar: Julian) = 120 seconds).round(minute) == 2 minutes  // TI85 two minutes rounded to minutes moved
  assert (Time(calendar: Julian) = 95 seconds).round(minute) == (Time(calendar: Julian) = 120 seconds)  // TRO2 ninety-five seconds do not round up to two minutes
  assert (Time(calendar: Julian) = 120 seconds).round(minute) == (Time(calendar: Julian) = 120 seconds)  // TRO5 a whole multiple moved when rounded
  assert (Time(calendar: Julian) = 90 seconds).round(minute) == (Time(calendar: Julian) = 120 seconds)  // TRO6 half a minute does not round up
  assert ((Time(calendar: Julian) = 2 minutes).round(second)).(
    .unit == second  // TRO8 rounding to a finer unit did not convert to it
    & . == (Time(calendar: Julian) = 120 seconds)  // TRO9 two minutes rounded to seconds are not 120 seconds
  )

  uncertainty: Quantity.Temporal?
  corrected (by: Quantity.Temporal, within: Quantity.Temporal) => Time(calendar, epoch: epoch, uncertainty: within) = this + by
  // the host's clock (with its resolution as the uncertainty); on ether the clock kept by NTP, not written yet
  static now => if OS.Ether { ERROR@OS `the clock kept by NTP is not written in Ray yet` } else { nondeterministic @time ns ± @time_resolution ns }
  assert Time.now >= Time.now + 1 ms  // FWQ5 sleeping did not wait
  assert Time.now <= Time.now  // TI86 the clock went back
  assert now <= Time.now  // TI89 now read bare is after the clock read again
  assert (Time.now.corrected(1 second, within: 1 ns)).uncertainty == 1 ns  // TI95 a corrected time does not keep how certain the correction is
  assert Time.now.instance_of(Time)  // TM10 the clock is not a time
  dynamically {
    .calendar.segments.for segment => `segment.name.upper_case` = `segment.name`
  } = now
}
now => Time.now
Quantity.Temporal &+= {
  chainable == (other: Time) => this == other.time_of_day
  chainable < (other: Time) => this < other.time_of_day
  chainable > (other: Time) => other.time_of_day < this
}

Unit(name: "month" ("s" + plural: true)?, symbol: "mo")
  .convert(((x: Number) => x * (Time.YEAR || Time.MONTH ? (Time.MONTH ?? January).days_in(Gregorian(year: Time.YEAR ?? 1)) : 30)), day)

ISO_8601 := class: Time{calendar is UTC.static} (
  date: (
    year: Decimal,
    semicolons: "-"?,
    (
      month = Month#[1 - month_of_year: Decimal{length == 2}{1 <= . <= Month#.count}],
      semicolons: "-"?,
      day_of_month: Decimal{length == 2}{1 <= . <= (month ~= (days_in_month: *) days).days_in_month},
      day_of_year = in_year.days_before(month) + day_of_month
    ) | (
      day_of_year: Decimal{1 <= . <= (year as days ~= (days_in_year: *) days).days_in_year}
    ) | (
      // ISO 8601-1:2019 §5.2.4: a week date, YYYY-Www-D or YYYYWwwD; week 01 is the week holding the year's first Thursday (4 January), so its days may fall in the year before or after
      "W",
      week_of_year: Decimal{length == 2}{1 <= . <= in_year.weeks_in_year},
      (
        semicolons: "-"?,
        weekday: Weekday#[1 - day_of_week: Decimal{length == 1}{1 <= . <= Weekday#.count}]
      )?,
      day_of_year = week_of_year * 7 + Weekday#.index_of(weekday ?? Monday) + 1 - (Weekday#.index_of(in_year.weekday_of(4)) + 4)
    )
  )?,
  time: (
    "T" if date || !semicolons,
    hour_of_day: Decimal{length == 2}{< calendar.day.hours},
    semicolons: ":"?,
    minute_of_hour: Decimal{length == 2}{< calendar.hour.minutes},
    semicolons: ":"?,
    second_of_minute: Decimal{length == 2}{< calendar.minute.seconds},
    "Z" | offset: (
      offset_operator: "+" | "-",
      offset_hours: Decimal,
      ":",
      offset_minutes: Decimal
    ),
    // RFC 9557 §4.1 (IXDTF): a suffix of an optional time-zone name and tagged annotations, each critical when flagged "!" (https://www.rfc-editor.org/rfc/rfc9557#section-4.1)
    (
      "[",
      zone_critical: "!"?,
      zone_name: ((Char.Letter | "." | "_", (Char.Letter | "." | "_" | Char.Digit | "-" | "+")[]){!= "." && != ".."})[].join("/"),
      "]"
    )?,
    tags: (
      "[",
      critical: "!"?,
      key: ("a".."z" | "_", ("a".."z" | "_" | Char.Digit | "-")[]),
      "=",
      value: (Char.Letter | Char.Digit)[]{length > 0}[].join("-"),
      "]"
    )[]
  )?
) => {
  calendar += offset_operator offset_hours:offset_minutes
  static Long := class: ISO_8601 (month: Month, " ", day_of_month: Decimal, ", ", year: Decimal) => { }
  long: String => this as Long as String

  in_year => Gregorian(year: year)
  // RFC 9557 §3: an elective annotation that is not understood is ignored, and a critical one must be acted on or the timestamp refused; of the registered keys only the calendar (u-ca, BCP 47) is read (https://www.rfc-editor.org/rfc/rfc9557#section-3)
  understood => !tags.some(.critical && !(.key == "u-ca" && .value is ("gregory" | "iso8601")))
  date_known => date != ?
  of_day: Quantity.Temporal => (hour_of_day ?? 0) hours + (minute_of_hour ?? 0) minutes + (second_of_minute ?? 0) seconds
  as (=== Time) => Time(calendar) = (in_year.days_before_year + day_of_year - 1) days + of_day
  chainable == (other: ISO_8601) => date_known && other.date_known ? this as Time == other as Time : of_day == other.of_day
  chainable < (other: ISO_8601) => date_known && other.date_known ? this as Time < other as Time : of_day < other.of_day

  dynamically assert semicolons if offset
  dynamically assert date | time
  dynamically assert understood
  date ?= ?
}
assert "2024-01-01" as ISO_8601 .day_of_year == 1  // TI42 the first of january is not the first day of the year
assert "2024-02-01" as ISO_8601 .day_of_year == 32  // TI43 the first of february is not the thirty-second day
assert "2024-03-01" as ISO_8601 .day_of_year == 61  // TI44 the first of march in a leap year is not the sixty-first day
assert "2023-03-01" as ISO_8601 .day_of_year == 60  // TI45 the first of march in a plain year is not the sixtieth day
assert "2024-02-07" as ISO_8601 .day_of_month == 7  // TI68 the day written last is not read
assert !("2024-02-07" as ISO_8601 == "2024-02-08" as ISO_8601)  // TI70 two dates a day apart are the same
assert "2024-W06-3" as ISO_8601 == "2024-02-07" as ISO_8601  // TI80 a week date is not the calendar date it names
assert "12:00" as ISO_8601 as String == "12:00"  // TI81 a time of day does not print without its date
assert ("2024-02-07" as ISO_8601) < ("2024-02-08" as ISO_8601)  // TI94 a date is not before the day after it
// ISO 8601 week dates: week 01 holds the year's first Thursday, so a week date may name a day of the year before or after.
assert "2026-W41-2" as ISO_8601 == "2026-10-06" as ISO_8601  // WD1 the Tuesday of week 41 of 2026 is not the sixth of October
assert "2026W412" as ISO_8601 == "2026-10-06" as ISO_8601  // WD2 a week date written without its dashes is another day
assert "2025-W01-1" as ISO_8601 == "2024-12-30" as ISO_8601  // WD3 the first week of 2025 does not begin in 2024
assert "2026-W53-7" as ISO_8601 == "2027-01-03" as ISO_8601  // WD4 the last day of week 53 of 2026 is not in 2027
assert !("2027-W53-1" is ISO_8601)  // WD7 a year of 52 weeks has a week 53
assert !("2026-W41-8" is ISO_8601)  // WD8 a week has an eighth day
assert "2026-W41" as ISO_8601 == "2026-10-05" as ISO_8601  // WD9 a week without its day is not its Monday
// RFC 9557: a time-zone name and tagged annotations after the offset.
assert ("2026-10-06T12:00:00+02:00[Europe/Paris]" as ISO_8601).(
  .zone_name == "Europe/Paris"  // WD10 the zone named in brackets is not read
  & . == "2026-10-06T10:00:00Z" as ISO_8601  // WD11 a zone name moved the instant its offset gives
)
assert "2026-10-06T12:00:00+02:00[!Europe/Paris][u-ca=gregory]" is ISO_8601  // WD12 a critical zone and a calendar tag are not read
assert "2026-10-06T12:00:00Z[foo=bar]" is ISO_8601  // WD13 an elective tag nobody understands is refused
assert !("2026-10-06T12:00:00Z[!foo=bar]" is ISO_8601)  // WD14 a critical tag nobody understands is ignored
assert !("2026-10-06T12:00:00Z[Foo=bar]" is ISO_8601)  // WD15 a tag key in capitals is read
assert "0004-03-01" as ISO_8601 .day_of_year == 61  // TM8 4-03-01 is not day 61
assert "00:01:05" as ISO_8601 == 65 seconds  // TM9 00:01:05 is not 65 seconds

Stamp := class (wall: Decimal, ".", logical: Decimal = 0, "@", node: *) => {
  chainable < (other: Stamp) => (wall, logical, node as String) < (other.wall, other.logical, other.node as String)
  when: Time => ((wall * 100) ns) as Time
  static at (time: Time, node) => Stamp(wall: (time as ns / 100).floor, node)
}

HybridClock := class (node: *, wall: Decimal = 0, logical: Decimal = 0) => {
  measured => (Time.now as ns / 100).floor

  now: Stamp => {
    at = measured
    logical = wall < at ? 0 : logical + 1
    wall = wall max at
    Stamp(wall, logical, node)
  }

  receive (remote: Stamp): Stamp => {
    highest = measured max wall max remote.wall
    logical = if highest == wall == remote.wall { (logical max remote.logical) + 1 }
      elsif highest == wall { logical + 1 }
      elsif highest == remote.wall { remote.logical + 1 }
      else { 0 }
    wall = highest
    Stamp(wall, logical, node)
  }
}






