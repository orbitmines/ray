{pattern} => {functionality} =>
  Expression |= pattern => functionality
{expression dynamically Expression} => expression
//{comment} => None
{statement} //{comment} => statement
//{comment} => {functionality} =>
  None

// Brackets: what is between them, read as one; a block, a context of what it declares.
({grouped}) => grouped
// `(a: 1, b: 2)`: a value of its own, holding what is given by name (`.a`, `.b`)
Fielded => @js $.reader(s => /^[\p{L}\p{N}_]+: /u.test(s) ? s : undefined)
({fields Fielded}) =>
  record := @made Node
  record &+= { naming := record }
  @given record fields
  record &+= { naming := None }
  record
{{block_inside}} =>
  made := @made Node
  @block made block_inside
  made &+= { block_inside }

// What reads a word, a span without spaces, one capture (the host's readers, `js.ray`'s kind of reader)
Unled => @js $.reader(s => s.startsWith($.learned.open) ? undefined : s)
Unspaced => @js $.reader(s => s.includes($.learned.space) || [...$.pairs.keys()].some(o => s.includes(o)) || $.leads(s, 0) ? undefined : s)
// (a name given a default, `total = 0`: a closure's one parameter, written without a pair: `reduce(total = 0 => total + .)`)
Defaulted => @js $.reader(s => /^[\p{L}_][\p{L}\p{N}_]* = /u.test(s) && !s.includes(" => ") ? s : undefined)
// one capture, `{align: start | center}`
Captured => @js $.reader(s => { const { open, close } = $.learned; if (!s.startsWith(open) || !s.endsWith(close)) return undefined; let d = 0; for (let i = 0; i < s.length; i++) { if (s[i] === open) d++; else if (s[i] === close && --d === 0 && i < s.length - 1) return undefined; } return s; })
// a word: letters, digits, `_`
Word => @js $.reader(s => /^[\p{L}\p{N}_]+$/u.test(s) ? s : undefined)
// (text in quotes holding an escape, `\x`)
Escaping => @js $.reader(s => s.includes("\\") ? s : undefined)

// `(.m)`, `(. + 1)`: a closure of one value, what the rest is read on (`x ~~ (.s = 5)`, `xs.map((. + 1))`); a statement led by `.`
// elsewhere reads on from what it is read in (`this`)
(. {dot_rest}) => (dot_it => dot_it dot_rest)
(.{dot_rest}) => (dot_it => dot_it.dot_rest)
// `x := v`: `x` is `v` where the statement is read, from here on (defined through the definer, as a value); `x = v`: where `x` is
// declared; `x &= v`: `v` at the end of the Ray `x` holds (a Ray of it, when it holds nothing).
{declared_name Unspaced} := {declared_value Expression} =>
  & &+= { declared_name => declared_value }
  declared_value
// (`a.b := v`, `a` holding nothing yet: `a` a value of its own, declared where the statement is)
{member_on Expression}.{member_name Word} := {member_value Expression} =>
  member_on ? None : (member_made := @made Node)
  member_on ? None : (& &+= { member_on => member_made })
  (member_on ?? member_made) &+= { member_name => member_value }
  member_value
// `X<K = D, V> := class …`: the class, each parameter a name of it (its default, or nothing).
{name Word}<{parameters}> := {value Expression} =>
  made := value
  reading := @made None
  reading &+= {
    {parameter Word} => made &+= { parameter := None }
    {parameter Word} = {default} => made &+= { parameter := default }
    {parameter Word}, {rest: reading} => made &+= { parameter := None }
    {parameter Word} = {default}, {rest: reading} => made &+= { parameter := default }
  }
  reading with { parameters }
  @here &+= { name := made }
// `static statement` in a class: the statement (before the modifiers below, which read `static` off a definition).
static {statement} => (@has @here given) ? None : (@statically statement)
// `static` alone, in a class's block: the class (read into an instance, the class it is made of)
static => (@has @here given) ? (@of @here) : @here
// `static name = value`, `static name := value`: the class's own member (not written where `name` is declared further out), read
// when it is first read (`static default = Store()` in `Store`'s own block); written by its name, not read where the class's
// own names are (`static name = …` beside a field `name`)
static {name Unspaced} = {value} => (@has @here given) ? None : (@field @here (@text name) (@later value))
static {name Unspaced} := {value} => (@has @here given) ? None : (@field @here (@text name) (@later value))

// `dynamically …`: a statement read again each time (P5.1, Control.ray's `Dynamic`); declared before the operations it is
// written with (`dynamically assert x != None`)
// `dynamically name = value`: `name` read as `value` is each time it is read (P5.1)
dynamically {name} = {value} =>
  name => (value)
dynamically {name} := {value} =>
  name => (value)
dynamically if{ }{cond}{ }{block} => Dynamic(program: () => if cond block)
// Run now, and again when what it reads is written (P5.1, P5.1a: by what runs it again, a runner, the TUI's loop)
dynamically {value} => Dynamic(program: value**, source: value**)
// `dynamically assert c`: checked by what runs dynamic values again (a runner), not as it is written
dynamically assert {conditions} => Dynamic(program: (Program(code: conditions**).written{!.()} -- .for(ERROR `assertion failed`) -- .empty)**)

// Text written in quotes: a String (its characters); in backticks, the same (a message, `` `assertion failed` ``).
"{text}" => @text text
// (text with an escape in it, `"\e[0m"`: each escape what it stands for (`String.unescaped`, String.ray's `Escape` table))
"{escaping_text Escaping}" => (@text escaping_text).unescaped
`{text}` => @text text

// `&caller`: where the method it is read in was called from (the context its arguments were written in)
&caller => @caller

// `x &+= { … }`: the block read into `x` (what it defines is `x`'s).
{target Expression} &+= {{block target}} => target
// (inside quotes, a character before a capture between them takes what follows it as written: `"\""`)
(@context None) &+= {
  "\{escaped}" => escaped
}

// `name := (a, b) => body`: the name is a closure.
{name} := ({parameters}) => {functionality} =>
  name => ((parameters) => functionality)

// `class header { block }`, `class: parent …`: a class made of what is written (declared before the operations on values, which
// the header is written with: `class value: Node`)
class {{block}} => Class.made_of(None, None, block)
class: {parent} {{block}} => Class.made_of(parent, None, block)
class {header} {{block}} => Class.made_of(None, header, block)
class: {parent} {header} {{block}} => Class.made_of(parent, header, block)
class: {parent} {header} => Class.made_of(parent, header, None)
class {header} => Class.made_of(None, header, None)
class: {parent} => Class.made_of(parent, None, None)
class => Class.made_of(None, None, None)

// `(x, y) := a, b`: each name, the value in its place, as a method's parameters are given what it is given in order (declared
// before `:=`: what it reads first). (each declared where the statement is read)
// (an enum, its members in order: `(start, end) := Alignment`)
({names}) := {value Expression} =>
  given := (@owns value "members") ? value.members : value
  listed := (@of given) === Ray
  read := @parameters (@named "") names
  index := 0
  name := @param read index
  while name {
    @field @here name (listed ? given[index] : given)
    index = index + 1
    name = @param read index
  }
  given
// ---------------------------------------------------------------- names, brackets, blocks, members
// `x -- call`: `call` read with `this` being `x` (a closure it answers, applied to `x`); `x ~~ call`: the same, answering `x`. They
// go on from everything before them (A-C5): declared first, they bind loosest.
Node &+= {
  -- {dash_call} =>
    dash_answer := dash_call
    dash_on := this
    (@applies dash_answer) ? dash_answer(dash_on) : dash_answer
  ~~ {tilde_call} =>
    tilde_answer := tilde_call
    tilde_on := this
    (@applies tilde_answer) ? tilde_answer(tilde_on) : tilde_answer
    tilde_on
  // (`x -- .m`, `x ~~ .m = v`: `.` is `x`, a closure of it; names and `this` read where the statement is written)
  -- .{dot_rest} => this -- (dot_it => dot_it.dot_rest)
  ~~ .{dot_rest} => this ~~ (dot_it => dot_it.dot_rest)
  // `a, b`: declared after `:=` (`x := 1, 2` holds both), before `=`, `&=`, `:` (they bind tighter: `f(x = g(), y)`, `f(a: 1, b: 2)`
  // give two); what it does, below
  , {other Expression} => ((@of this) === Ray ? this.listed : (@made Ray).append(this)).joined(other)
}
// `with settings { … }`, `with settings` (L§6.3): what the settings write is written for the block (put back after it), or the rest
// of the context the `with` is in, and everything called from there (declared before `=`: the settings are any code, `with x = v`)
with {settings} {{body}} =>
  written := @writing settings
  answer := @run (Program(code: body))
  @unwritten written
  answer
with {settings} => @writing settings
// `x = v`: where `x` is declared (the first statement writes a name held further out there); `x.m = v`: on `x`
{assigned_name Unspaced} = {assigned_value} =>
  assigned_name => assigned_value
Node &+= {
  = {value} => @assign value
  &= {value Expression} => @assign ((this ?? []).append(value))
  // `x: T`: `x` is a `T` (holding `T` until something is written to it); given by name, `x: v` gives it `v`; in what is being given
  // its fields in order, the next of them (one given by name keeps it)
  : {colon_type} =>
    // (what is being given, read as held: not through the value's own `.`, which a class may read otherwise)
    // (the place it is applied on, taken first: what is read after has places of its own; its own names (`colon_…`), none a value
    // holds, which would be read in their place)
    @keep_place colon_place
    colon_word := @place_word colon_place
    colon_head := @typed colon_type
    colon_had := @owns @here colon_word
    colon_naming := @member @here "naming"
    colon_given := @member @here "given"
    colon_taken := (!colon_head) && (!colon_naming) && (!colon_had) && colon_given && (!(colon_given.empty))
    // (given by name, `x: v`: the field `x` of what is being given, whatever `x` names where it is read)
    colon_head ? None : (colon_naming ? (@field_at @here colon_place colon_type) : (colon_had ? None : (colon_taken ? (@declare_at colon_place colon_given.take) : (@holding_at colon_place colon_type))))
    // (a field given is what `= default` does not write; one of a class, what its instances are given unless given otherwise)
    colon_shared := (!colon_naming) && (!colon_head) && (!colon_had) && (!colon_taken) && (@has @here components)
    colon_field := colon_shared ? (@made ClassField) : None
    colon_shared ? (@field colon_field "owner" @here) : None
    colon_shared ? (@field colon_field "word" colon_word) : None
    // (what it declares, read into what declares it: its name and its type as written, after what was declared before it (`fields`, T26))
    colon_declared := (colon_head || colon_shared) ? (@made Node) : None
    colon_declared ? (@field colon_declared "name" colon_word) : None
    colon_declared ? (@field colon_declared "type" (@later colon_type)) : None
    colon_declared ? (@field colon_declared "before" ((@owns @here "declared") ? (@member @here "declared") : None)) : None
    colon_declared ? (@field @here "declared" colon_declared) : None
    colon_naming ? @here : ((!colon_head) && (colon_had || colon_taken)) ? Field : colon_shared ? colon_field : this
}
// `{*}: T`: a field named by its pattern as written, after what was declared before it (what no other field reads, F-A4)
{{field_pattern}}: {pattern_type} =>
  pattern_word := "{" + (@text field_pattern) + "}"
  pattern_declared := @made Node
  @field pattern_declared "name" pattern_word
  @field pattern_declared "type" (@later pattern_type)
  @field pattern_declared "before" ((@owns @here "declared") ? (@member @here "declared") : None)
  @field @here "declared" pattern_declared
  @field @here pattern_word (@later pattern_type)
  pattern_declared
// `x.m = v`: `v` written on `x` (declared after `:`, which its receiver stops at: `x: T.U = d` is a field)
{assigned_on Expression}.{assigned_name Word} = {assigned_value Expression} =>
  assigned_on &+= { assigned_name => assigned_value }
  assigned_value
// `x[key]`, `x[key] = v`, `x[key] := v` (T8.7): what a value holds under a name, by its name
Node &+= {
  [{key Expression}] => @member this key
  [{key Expression}] = {value} => @field this key value
  [{key Expression}] := {value} => @field this key value
}
// what `x: T = default` writes nothing to (a field given, or the class's own)
Field := @made Node
Field &+= {
  = {value} => this
}
// a field declared on a class: `= default` is what each instance holds until something is written to it, read when it is first read
ClassField := @made Node
ClassField &+= {
  = {value} =>
    word := @member this "word"
    owner := @member this "owner"
    // (the class's too, read when it is first read (its block is read into it); unless it is the class's own, `static x: T = v`,
    // what each instance is given)
    @field owner word (@later value)
    (@static) ? None : (@field owner "field_defaults" (((@owns owner "field_defaults") ? (@member owner "field_defaults") : []).append((instance) => (@owns instance word) ? None : (@field instance word (@later value)))))
    this
}
// `x with { … }`: the block read with `x` as what it is read in, answering what the block answers.
{target Expression} with {{block target}} => block
// `x.rest`: the rest read by `x` (its own, then its class's, then the base's): `x.m`, `x.m(a)`. `f(a, b)`: the arguments read by
// `f` (a closure: its parameters; a class: its construction); `f()`: `f` itself.
Node &+= {
  // (`.[i]`: `this[i]`, read on from a value as `x[i]` is: `xs.map(.[1])`)
  .[{index_at Expression}] => this[index_at]
  .{rest this} => rest
  ({arguments this}) => arguments
  () => this
}

// ---------------------------------------------------------------- control flow (P2.8: an `if` answers what its taken block answers)
// (declared before the operations a condition is written with: `if a && b { … }`, `unless x === y { … }`)
Branch := @made Node
Branch &+= {
  else {{otherwise}} => this.taken ? this.answer : otherwise
  elsif {condition} {{yes}} => this.taken ? this : (condition ? Branch.of(true, yes) : this)
}
if {condition} {{yes}} => condition ? Branch.of(true, yes) : Branch.of(None, None)
unless {condition} {{yes}} => condition ? Branch.of(None, None) : Branch.of(true, yes)
// loops, written with labels: `while c { body }` (again while `c` holds), `do { body } while c`, `loop { body }`; the body is
// called with where the loop ends and where it starts again, what `break` and `continue` go to
while {condition} {{body}} =>
  loop_body := ((loop_break, loop_continue) => body)
  loop_again\
  condition ? None : (goto loop_done)
  loop_body(loop_done, loop_again)
  goto loop_again
  loop_done\
do {{body}} while {condition} =>
  loop_body := ((loop_break, loop_continue) => body)
  loop_again\
  loop_body(loop_done, loop_next)
  loop_next\
  condition ? (goto loop_again) : None
  loop_done\
loop {{body}} =>
  loop_body := ((loop_break, loop_continue) => body)
  loop_again\
  loop_body(loop_done, loop_again)
  goto loop_again
  loop_done\

// ---------------------------------------------------------------- what holds (T1.7): every value but nothing and false
true := @made Node
false := @made Node
Node &+= {
  ? {yes} : {no} => yes
  || {other} => this
  && {other} => other
  ?? {other} => this
}
None &+= {
  ? {yes} : {no} => no
  || {other} => other
  && {other} => this
  ?? {other} => other
}
false &+= {
  ? {yes} : {no} => no
  && {other} => this
  || {other} => other
}
!{x} => x ? false : true
// `-x`: `x` the other way (`x * -1`: a number, a quantity)
-{minus_operand Unspaced} => (0 - 1) * minus_operand
{a} === {b} => @same a b
{a} !== {b} => (@same a b) ? false : true
// (also read on from a value: `xs{!== x}`)
Node &+= {
  === {b} => @same this b
  !== {b} => (@same this b) ? false : true
}
@me/instance = {x} => @show x

// ---------------------------------------------------------------- definitions: what a head says
// A definition's head is read as what it says, a node: its name as written (any text), what it is given (its parameters, each read
// into it: `x: T` the `:` of Node, `= d` its `=`), the names it is also (`a | b`, a Superposition), how it is applied (`static p`,
// `right-to-left p`). Defining it makes its name, and what is given to it, read as it says (R2.1: a method is a rule).
// What is inside a capture is read the same way: a capture is a parameter.
Parameters := @context None
Parameters &+= {
  {first Parameters}, {rest Parameters} => ((@of first) === Ray ? first : [first]).append(rest)
  ({grouped_parameters Parameters}) => grouped_parameters
  // (a group of pieces, optional or repeated: its own piece, read as such)
  ({group Parameters})? => None | ((@of group) === Ray ? group : [group])
  ({group Parameters})[] => group[]
  literal {target Parameters} => target
  {target Parameters} ^{style Text} => target
  === {type Text} => @parameter given: type
  {target Text} => @parameter target
  // (text written as it is: `` {`=`} ``)
  `{text Text}` => @literally text
}
@captures Parameters
Method := @context None
Method &+= {
  {parameters Defaulted} => @parameters @unnamed parameters
  {name Unled} => @named name
  {head Method} ({parameters Unled}) => @parameters head parameters
  {head Method}({parameters Unled}) => @parameters head parameters
  {head Method} () => @takes head
  {head Method}() => @takes head
  ({parameters Unled}) => @parameters @unnamed parameters
  [{parameters Unled}] => @between "[" "]" parameters
  // (`a | b | c`: one superposition of the three names, not one of `a` and `b | c`)
  {a Method} | {b Method} => (a | b) -- ((aliased) => aliased ~~ ((flat) => flat.components = []) ~~ ((flat) => a.superposes ? a.components.for((component) => flat.components.append(component)) : flat.components.append(a)) ~~ ((flat) => b.superposes ? b.components.for((component) => flat.components.append(component)) : flat.components.append(b)))
  // (names written together take what is written after them: `min | min_by (key)`)
  {a Method} | {b Method} ({parameters Unled}) => (@parameters a parameters) | (@parameters b parameters)
  static {head Method} => @own head
  // (a class's own method without a name: how the class is called, `C(1, 2)`)
  static ({parameters Unled}) => @own (@between "(" ")" parameters)
  chainable {head Method} => head
  // (`compounds op (x)`: also what `x op= y` writes, T4.21)
  compounds {head Method} => head
  right-to-left {head Method} => @leftward head
  // (a pattern applied on what is written after it: `right-to-left {align: start | center}`, `center x`)
  right-to-left {name Captured} => @leftward (@named name)
  {head Method}: {type Unled} => head
  // (a name declared, `X := …`: the definition read again as it is written, without what was said of it)
  {name Unspaced} := {value Text} => @again name value
}
// (a head as a whole: what a method says, else as written; either shown as it says)
Head := @context None
Head &+= {
  {method Method} => method
  {name Text} => @named name
  {head Head} ^{style Unspaced} => head
}
{head Head} => {functionality} =>
  head.superposes ? head.components.for((alias) => @define alias "receiver" ", ") : (@define head "receiver" ", ")



// ---------------------------------------------------------------- Rays (`a, b`): vertices in order (`head`, `tail`; each `value`, `next`, `previous`)
// (a Ray is an Array, which is an Iterable: what the library adds to them is a Ray's too)
Iterable := @made Node
Array := @made Iterable
Ray := @made Array
Vertex := @made Node
Ray &+= {
  append (value) =>
    link := @made Vertex
    link.value := value
    this.tail ? (link.previous := this.tail) : (this.head := link)
    this.tail ? (this.tail.next := link) : None
    this.tail := link
    this
  take =>
    first := this.head
    this.head := first ? first.next : None
    first ? first.value : None
  prepend (value) =>
    vertex := @made Vertex
    vertex.value := value
    if this.head {
      this.head.previous := vertex
      vertex.next := this.head
    } else {
      this.tail := vertex
    }
    this.head := vertex
    this
  every (predicate) => !(this.some((element) => !(predicate(element))))
  some (predicate) =>
    found := None
    at_vertex := this.head
    while at_vertex {
      if predicate(at_vertex.value) { found = true }
      at_vertex = found ? None : at_vertex.next
    }
    found ?? false
  // (what follows: each of its values when it is itself written with `,`, else it)
  joined (other) =>
    given := other
    made := this
    @field made "commas" true
    (@owns given "commas") ? given.for(x => made.append(x)) : made.append(given)
    made
  entry => this.head
  // (a new list of the same values, not written with `,`)
  listed =>
    made := @made Ray
    this.for(x => made.append(x))
    made
  // the value at a place (0 the first; below 0 from the last)
  [at: Number] =>
    at_vertex := at < 0 ? this.tail : this.head
    left := at < 0 ? (0 - at) - 1 : at
    while at_vertex && left > 0 {
      at_vertex = at < 0 ? at_vertex.previous : at_vertex.next
      left = left - 1
    }
    at_vertex ? at_vertex.value : None
  // (`xs[i] = v`: the value at that place written)
  [{written_at Expression}] = {written_value} =>
    write_at := written_at
    write_vertex := write_at < 0 ? this.tail : this.head
    write_left := write_at < 0 ? (0 - write_at) - 1 : write_at
    while write_vertex && write_left > 0 {
      write_vertex = write_at < 0 ? write_vertex.previous : write_vertex.next
      write_left = write_left - 1
    }
    write_vertex ? (write_vertex.value = written_value) : None
    written_value
  first => this.head ? this.head.value : None
  count =>
    counted := 0
    at_vertex := this.head
    while at_vertex {
      counted = counted + 1
      at_vertex = at_vertex.next
    }
    counted
  last => this.tail ? this.tail.value : None
  empty => this.head === None
  without (x) =>
    made := []
    at_link := this.head
    while at_link {
      unless at_link.value === x { made.append(at_link.value) }
      at_link = at_link.next
    }
    made
  rest =>
    made := []
    at_link := this.head ? this.head.next : None
    while at_link {
      made.append(at_link.value)
      at_link = at_link.next
    }
    made
  map (mapping) =>
    made := []
    at_link := this.head
    while at_link {
      made.append(@entered mapping at_link.value at_link.value)
      at_link = at_link.next
    }
    made
  for (body) =>
    at_link := this.head
    while at_link {
      body(at_link.value)
      at_link = at_link.next
    }
    this
}
// ---------------------------------------------------------------- control flow: what a Branch is made of (`of`)
Branch &+= {
  of (taken, answer) =>
    made := @made Branch
    made.taken := taken
    made.answer := answer
    made
}
// (`while c { body }`: the body again while `c` holds; iterating is the interpreter's (`js.ray`))

[] => @made Ray
// (`[x]` is a new list holding `x`, a list included; `[a, b]` the list written there, L§1.2)
[{listed_inside: Expression}] => listed_inside === None ? (@made Ray) : ((@owns listed_inside "commas") ? listed_inside.listed : (@made Ray).append(listed_inside))

// ---------------------------------------------------------------- classes (A7): the block is the constructor; what it defines, the class's too
Node &+= {
  read_into (instance) => instance
}
// what a class is made of besides what it continues into (`components.hierarchy`): adding to it makes the class also made of what is
// added, as `A + B` (read as it is: what that comes to hold later, the class holds too)
Composition := @made Ray
Composition &+= {
  &= {value Expression} =>
    @also (@member this "owner") value
    @assign (this.append(value))
}
Class := @made Node
Class &+= {
  // an instance: given its arguments (by name: `name: value`, read into it), the rest in order to its fields (its header, a
  // parameter list: what is not given is what the field says), the blocks of what it is made of read into it
  instance_of (made, arguments) =>
    instance := @made made
    instance &+= { naming := instance }
    in_order := [@given instance arguments].without(instance)
    instance &+= { naming := None }
    instance &+= { given := in_order }
    made.read_into(instance)
    instance
  // (in order, to the fields not given by name: what is not given is what the field says)
  fields_given (instance, fields) =>
    in_order := @member instance "given"
    index := 0
    name := @param fields index
    while name {
      (@owns instance name) ? None : (@field instance name (in_order.empty ? (@default instance fields name) : in_order.take))
      index = index + 1
      name = @param fields index
    }
    instance
  made_of (parent, header, block) =>
    made := @made (parent ?? Node)
    // (its header read into it: its fields, and its `header`, the pieces in order (a text as it is written, a field its node))
    fields := ((@text header) === "None") ? None : (@parameters made header)
    made with {
      read_into (instance) =>
        (@of made).read_into(instance)
        fields ? Class.fields_given(instance, fields) : None
        // (the block was read for the class: what it defines is the class's, what an instance holds until written; read again in an
        // instance only to give the fields it declares what is given in order)
        instance with { block }
        // (and the defaults of the fields declared on the class, its own or added since (`T &+= { x: T = d }`), not written yet)
        ((@owns made "field_defaults") ? (@member made "field_defaults") : []).for((default) => default(instance))
        instance
      // (made with what it is given, unless its block says otherwise: `static () => …`, the class's own; `() => …`, what is made of it)
      static ({arguments}) => Class.instance_of(made, arguments)
      static () => Class.instance_of(made, None)
      // what it is made of: its hierarchy, the classes it is one of (adding one makes it made of that too)
      components := (@made Node) &+= { hierarchy := (@made Composition) ~~ (list => @field list "owner" made) }
    }
    made with { block }
    made
}
// ---------------------------------------------------------------- guards: `x if c`, `x unless c` (declared after `,`: `x if c, y` is `(x if c), y`; before the operators on values: `x if a < b`, `x while a < b`)
{guarded} if {condition} => condition ? guarded : None
{guarded} unless {condition} => condition ? None : guarded
// `x while c`: `x` again while `c` holds
{body} while {condition} =>
  loop_again\
  condition ? None : (goto loop_done)
  body
  goto loop_again
  loop_done\
// The precedence of the operators on values: a head binds tighter the later it is first declared. `is`, ranges and comparisons
// are declared here, before `|` and `+` (below) and the arithmetic (`js.kinds.ray`, Number.ray): `x is A | B`, `0..<2 * n`, `a + 1 > b`
Operators := @made Node
Operators &+= {
  is {type} => None
  ..{last} => None
  ..<{last} => None
  .. {last} => None
  ..< {last} => None
  == {other} => None
  != {other} => None
  < {other} => None
  <= {other} => None
  > {other} => None
  >= {other} => None
}
// `T + { … }`: a class made of `T` with what the block declares (both its components)
Node &+= {
  + {{block}} =>
    added := Class.made_of(None, None, block)
    made := Class.made_of(this, None, block)
    made.components.hierarchy := [this, added]
    made
  // `A + B`: a class made of both (both its components): an instance is what each makes of it
  + {other} =>
    made := Class.made_of(this, None, None)
    @also made other
    made.components.hierarchy := [this, other]
    made
}
// `X := class (header) => { block }`: read as a definition is read (its `=>` is the class's)
{name Unspaced} := class {header} => {{block}} =>
  name := Class.made_of(None, header, block)
{name Unspaced} := class: {parent} {header} => {{block}} =>
  name := Class.made_of(parent, header, block)
// `break`, `continue`: to the end, or the start again, of the loop they are in; `return x`: `x`, from the method it is in;
// `recur`, `recur(arguments)`: the method it is in, again (from its start); `goto name`: on from the statement `name\`
break => goto (&.caller).loop_break
continue => goto (&.caller).loop_continue
return {value} => @return value
return => @return None
recur({given}) => @recur given
recur => @recur
goto {target} => @goto target
{name Unspaced}\ => @label name

// ---------------------------------------------------------------- enums: `enum a | b (field: v) | c { block }`, a class of exactly these members
// (declared before `|`: `enum a | b` reads `a | b`)
// The members are read by rules of their own (R2.3: not the enum's members), each member, then the rest.
Enum := @made Node
Enum &+= {
  first_member (name, fields) =>
    member := @made this
    member &+= { naming := true }
    member &+= { fields }
    member &+= { naming := None }
    this &+= { name := member }
    this.members := (this.members ?? []).prepend(member)
    this
}
enum {members} =>
  made := @made Enum
  reading := @made None
  reading &+= {
    {name Word} => made.first_member(name, None)
    {name Word} ({fields}) => made.first_member(name, fields)
    {name Word} | {rest: reading} => made.first_member(name, None)
    {name Word} ({fields}) | {rest: reading} => made.first_member(name, fields)
  }
  reading with { members }
  made
enum {members} {{block}} => (enum members) &+= { block }

// ---------------------------------------------------------------- superposition (U1): `a | b`, both; `T?`, `None | T`
Superposition := @made Node
Node &+= {
  | {other: Expression} =>
    made := @made Superposition
    made.superposes := true
    made.components := [this, other]
    made
}
{value}? => None | value
Superposition &+= {
  static held (x, at) => at ? ((@same x at.value) || Superposition.held(x, at.next)) : false
  // (one more component: a superposition of it and the component; this one stays as it is)
  | {other: Expression} =>
    made := @made Superposition
    made.superposes := true
    made.components := [this, other]
    made
}
Superposition &+= {
  // (what a superposition admits: what any of its components admits, is, or (a list of values) holds)
  {superposed} => this.components.some((component) => (@same superposed component) || (@inside superposed component) || ((@of component) === Ray && Superposition.held(superposed, component.head)))
}

boolean := enum false (holds: None) | true (holds: true) {
  not => this.holds ? false : true
  and (b) => this.holds ? b : this
  or (b) => this.holds ? this : b
}
true := boolean.true
false := boolean.false
false &+= {
  ? {yes} : {no} => no
  && {other} => this
  || {other} => other
}

// ---------------------------------------------------------------- types (T4.10): `x is T`; `T{p}`, what `T` holds of which `p` holds
Narrowing := @made Node
Node &+= {
  {{constraint}} =>
    made := @made Narrowing
    made.narrows := this
    made.constraint := (narrowed_it => (narrowed_it with { (constraint) }) -- (said => (@applies said) ? said(narrowed_it) : said))
    made
  // `x is T` (T4.10): whether `T` admits `x`: an instance of it (or of what is made of it); one of a superposition's components; what
  // a narrowing narrows, satisfying its constraint; a list of `T`s for `T[]`; else `T` itself
  is {type} => this.admitted_by(type)
  // (what the type holds, its own: not what its values hold, `("(", T, ")")`)
  admitted_by (type) => (@inside this type) || ((@member type "superposes") && (@member type "components").some((component) => this is component)) || ((@member type "narrows") && (this is (@member type "narrows")) && type.constraint(this)) || ((@inside type Listing) && this.every((element) => element is (@member type "of"))) || (@same this type)
  // `x as T`: `x` converted to a `T` (a class's own `as (=== T) => …`, or the `T`'s own `static (x: X) as (=== T) => …`, read in
  // the `T`); where none converts it, `x` when it is a `T`, else nothing
  as {as_type} =>
    as_value := this
    as_was := @member as_type "as_converting"
    as_held := (as_value === None) || (as_value is as_type) || (@same as_was as_value)
    @field as_type "as_converting" as_value
    as_answer := as_held ? ((as_value is as_type) ? as_value : None) : (as_type with { (as_value) as as_type })
    @field as_type "as_converting" as_was
    as_answer
  // `x/name`: what `x` holds under `name`, read as `x.name` is (a path step, `@me/device/terminal`)
  /{rest this} => rest
}
// `T{p}(arguments)`: a `T` made of them (what `p` says of it is what it is made to be)
Narrowing &+= {
  // (what a narrowing admits: what it narrows admits, and its constraint holds of)
  {narrowed} => (@inside narrowed this.narrows) && this.constraint(narrowed)
  ({arguments}) => Class.instance_of(this.narrows, arguments)
  () => Class.instance_of(this.narrows, None)
}

// `T[]`: one `T` after another, a type of text read as a run of what `T` reads
Listing := @made Node
Node &+= {
  [] =>
    made := @made Listing
    made.of := this
    made
}

// ---------------------------------------------------------------- the core the library extends: an Iterable of `Vertex`, an Array, text, numbers
Iterable &+= {
  components := (@made Node) &+= { hierarchy := [] }
}
Array &+= {
  components := (@made Node) &+= { hierarchy := [Iterable] }
}
// text (String.ray adds the rest): an Array of its characters
String := class: Array {
  // (text as written in quotes: each escape `\x` what the `Escape` table says it stands for, the rest as written; the code points
  // are written in decimal while `U+…` and hexadecimal numerals do not read)
  unescaped =>
    unescaping := ""
    escaping_next := false
    this.for(unescaped_char => escaping_next ? ((unescaping = unescaping + String.escape_of(unescaped_char)) -- (escaping_next = false)) : ((unescaped_char.codepoint == 92) ? (escaping_next = true) : (unescaping = unescaping + unescaped_char)))
    unescaping
  static escape_of (escape_char) => escape_char.codepoint -- (escape_code => @character ((escape_code == 48) ? 0 : ((escape_code == 97) ? 7 : ((escape_code == 98) ? 8 : ((escape_code == 116) ? 9 : ((escape_code == 110) ? 10 : ((escape_code == 102) ? 12 : ((escape_code == 114) ? 13 : ((escape_code == 101) ? 27 : escape_code)))))))))
}
Number := class { }
Char := class: Number { }
// a program (P1): code, read where it was written (`context`); with `parameters`, a closure of them
Program := class {
  code: Node?
  parameters: Node?
  context: Node?
  O: Node?
  // `p{O: level}`: the program, given what the block names (`settled`: not a name a program holds, which would be read in its place)
  {{settled}} =>
    this &+= { naming := true }
    this &+= { settled }
    this &+= { naming := None }
    this
  // run: its code read again, with the rules of its level in scope (a block's code: what the block was made of)
  () => @run this
  // `p(arguments)`: what it is given matched against its parameters (as a method's are), its code run with them
  ({called}) => @call this code parameters called
}
// a diagnostic (R5.1)
Diagnostic := class {
  message: Node
  type: Node
  fatal: Node
}
// `ERROR@T message`, `ERROR message`, `FATAL …`: said where the message is written, and a Diagnostic (errors are values); `WARN`, `INFO`,
// `DEBUG`, `TRACE`: said; `TODO`: nothing.
ERROR{`@`}{type} {message} ^error =>
  @report message
  Diagnostic(message: message, type: type)
ERROR {message} ^error =>
  @report message
  Diagnostic(message: message)
FATAL{`@`}{type} {message} ^fatal =>
  @report message
  Diagnostic(message: message, type: type, fatal: true)
FATAL {message} ^fatal =>
  @report message
  Diagnostic(message: message, fatal: true)
WARN{`@`}{type} {message} ^warn => @report message
INFO{`@`}{type} {message} ^info => @report message
DEBUG{`@`}{type} {message} ^debug => @report message
TRACE{`@`}{type} {message} ^trace => @report message
WARN {message} ^warn => @report message
INFO {message} ^info => @report message
DEBUG {message} ^debug => @report message
TRACE {message} ^trace => @report message
TODO {message} ^debug => None
TODO ^debug => None
Diagnostic &+= {
  cause: Node?
  trace: Node?
  caught_by (catching) => this.type ? ((this.type === catching) || (this.type is catching)) : false
}
// `assert (condition)`: an error when it does not hold; the condition.
assert (condition) =>
  unless condition { ERROR `assertion failed` }
  condition

// a value read again each time it is read (`dynamically …`, P5.1): its program, and the code it was written as
Dynamic := class program: Program, source: Program? {
  dirty: Node?
  .{literal property ^property} ^punctuation => @member (program()) (@text property)
  as (=== boolean) => program() as boolean
  // `dynamic` read again, now that what it depends on changed
  static refreshed (dynamic) => dynamic.program()
}
watch (dynamic) => dynamic
// `x**`: what is written, as a program (R4.1: a captured argument is code; `**` gives it), not read (declared last: it takes
// the operand closest to it)
{written}** => Program(code: @code written)
