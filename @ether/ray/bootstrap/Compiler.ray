  static last_with (l: List, kv, v) => (((l is List) == 0) || stopped()) ? 0 : Indexes.last_scanned(l, untag(kv), v)
  static last_scanned (l: List, k, v) => {
    i := l.count - 1
    while i >= 0 {
      return at(l, i) if column_of(at(l, i), k) == v
      i = i - 1
    }
    0
  }
}
// Members (`level members …`): what applies a rule, around a node (`applied_of`); a node's members, or what a rule's
// holes hold, as entries of a name and a value (but its key and input); whether a pattern catches all (a field, or a
// sequence of one); a member set, in a node (itself, copied) and in a pattern's fields of that name; an entry; a key
// added to a node's rules (the rules' epoch moved on where it is read from).
Members := class {
  static applied_of (x) => {
    a := x
    while (a != None) && ((a is Applied) == 0) {
      a = Members.parent_of(a)
    }
    a
  }
  static parent_of (n: Node) => n.in
  static members_of (x: Node) => ((x is Node) || (x is Applied)) ? Members.fields_listed(list(), x.fields) : list()
  static holes_of (x) => Members.holes_in(Members.applied_of(x))
  static holes_in (a: Node) => (a == None) ? list() : Members.fields_listed(list(), a.fields)
  static fields_listed (l, fields) => {
    f := fields
    while f != None {
      f = Members.listed_next(l, f)
    }
    l
  }
  static listed_next (l, f: Field) => {
    append(l, entry(name_text(f.name), f.value)) if (f.name != Symbol.key) && (f.name != Symbol.input)
    f.next
  }
  static catches_all (p: Pattern) => (p is Pattern) && ((p.kind == named_field) || ((p.kind == in_sequence) && Members.one_field(p.a)))
  static one_field (l: List) => (l.count == 1) && Members.is_field(at(l, 0))
  static is_field (p: Pattern) => p.kind == named_field
  static set_parser (f) => {
    parserhook = f
    kept()
    0
  }
  static grammar_of (t) => Runtime.defined_as(node(0), Symbol.text, t)
  static setmember (x, sym, v) => Members.pattern_set(x, sym, (((x is Node) || (x is Applied)) ? Members.defined_to(x, sym, (v == x) ? copied(x) : v) : v))
  static defined_to (x, sym, v) => {
    define(x, sym, v)
    v
  }
  static pattern_set (x: Pattern, sym, v) => ((x is Pattern) && (x.kind == in_sequence)) ? Members.fields_set(x.a, sym, v) : v
  static fields_set (l: List, sym, v) => {
    i := 0
    while i < l.count {
      Members.field_set(at(l, i), sym, v)
      i = i + 1
    }
    v
  }
  static field_set (p: Pattern, sym, v) => {
    Members.hole_given(p, v) if (p is Pattern) && (p.kind == named_field) && (p.a == sym)
    0
  }
  static hole_given (p: Pattern, v) => {
    p.b = v
    0
  }
  static maybe (x, sym) => (x == None) ? None : member(x, sym)
  static orelse (a, b) => truthy(a) ? a : b
  static entry (p, v) => Runtime.defined_as(Runtime.defined_as(node(0), Symbol.key, p), Symbol.value, v)
  static keyed (n, p, v) => {
    keys_touched(n)
    Members.appended_key(n, entry(p, v))
  }
  static appended_key (n, e) => {
    append(keys(n), e)
    e
  }
}
// Calls (`level calls …`): a function called with none, one or two arguments (in the arguments shared for that, when
// it is the language's own: a closure, curried or applied), a member called so (its own closure, else what it is);
// those of a list a function picks; a member mapped (`map`, of a text or a structure); a place of a name; what a key
// reads of a text (its length and whether it is wholly noted on it); a name's number and its text; an argument.
Calls := class {
  static direct (c) => (c is Closure) || (c is Curried) || (c is Applied)
  static items_of (l: List) => l.items
  static args1 (a) => Calls.args_put(shared_args(3928, 1), a, 0, 1)
  static args2 (a, b) => Calls.args_put(shared_args(3928, 2), a, b, 2)
  static args_put (l, a, b, n) => {
    word_put(Calls.items_of(l), a)
    word_put(Calls.items_of(l) + 4, b) if n == 2
    l
  }
  static invoke0 (c) => Calls.direct(c) ? call(c, shared_args(3928, 0), 0) : invoke(c, list(), 0)
  static invoke1 (c, a) => Calls.direct(c) ? call(c, Calls.args1(a), 0) : invoke(c, append(list(), a), 0)
  static invoke2 (c, a, b) => Calls.direct(c) ? call(c, Calls.args2(a, b), 0) : invoke(c, append(append(list(), a), b), 0)
  static call1 (f, x) => Calls.direct(f) ? call(f, Calls.args1(x), 0) : call(f, append(list(), x), 0)
  static call_member0 (x, sym) => Calls.closure_call0(x, sym, own_closure(x, sym))
  static closure_call0 (x, sym, c: Closure) => (c != None) ? indirect(c.env, shared_args(3928, 0), 0, c.function) : invoke0(member2(x, sym))
  static call_member1 (x, sym, a) => Calls.closure_call1(x, sym, a, own_closure(x, sym))
  static closure_call1 (x, sym, a, c: Closure) => (c != None) ? indirect(c.env, Calls.args1(a), 0, c.function) : invoke1(member2(x, sym), a)
  static call_member2 (x, sym, a, b) => Calls.closure_call2(x, sym, a, b, own_closure(x, sym))
  static closure_call2 (x, sym, a, b, c: Closure) => (c != None) ? indirect(c.env, Calls.args2(a, b), 0, c.function) : invoke2(member2(x, sym), a, b)
  static select (l: List, f) => {
    o := list()
    i := 0
    while i < l.count {
      append(o, at(l, i)) if truthy(call1(f, at(l, i)))
      i = i + 1
    }
    o
  }
  static selmethod (x, sym, f, args) => (sym == Symbol.map) ? Calls.mapped_by(x, f, arg(args, 0)) : 0
  static mapped_by (x, f, g) => (x is Text) ? mapped_text(x, f, g) : (((x is Node) && (member(x, Symbol.text) != None)) ? mapped_structure(x, f, g) : x)
  static place (t, ctx) => Place(name: intern(((t is Node) ? member(t, Symbol.text) : t)), kind: 0, given: ctx)
  static readsv (p, t) => (p is Node) ? Calls.read_keyed(p, t, member(p, Symbol.key)) : reads(topattern(p), t)
  static read_keyed (p, t, k) => (k == None) ? reads(topattern(p), t) : Calls.read_measured(p, t, k, reads(topattern(k), t))
  static read_measured (p, t: Text, k, r) => {
    Calls.read_put(p, t, k, r) if r != 0
    r
  }
  static read_put (p, t: Text, k, r) => {
    define(p, Symbol.length, int(((r - t.from) * 2) + Keys.led_by_text(topattern(k))))
    define(p, Symbol.whole, wholly)
  }
  static name_text (sym) => (sym >= 1000000) ? at(names, sym - 1000000) : at(csyms, sym - 16)
  static intern (t: Text) => Calls.intern_from(t, Calls.text_index(csyms, t))
  static intern_from (t, i) => (i >= 0) ? (16 + i) : Calls.name_found(t, Calls.text_index(names, t))
  static name_found (t, i) => (i >= 0) ? (1000000 + i) : Calls.name_added(t, Texts.count_of(names))
  static name_added (t, i) => (logging() && (lasting_name(t) != 0)) ? (1000000 + i) : Calls.name_kept(t, i)
  static name_kept (t, i) => {
    kept() if logging()
    append(names, t)
    1000000 + i
  }
  static text_index (l: List, t: Text) => {
    i := 0
    while i < l.count {
      return i if Texts.same_text(at(l, i), t)
      i = i + 1
    }
    0 - 1
  }
  static with (n, sym, v) => Runtime.defined_as(n, sym, v)
  static argn (args: List, named, i, sym) => (i < args.count) ? at(args, i) : ((named == None) ? None : value_of(own(named, sym)))
  static arg (args: List, i) => (i < args.count) ? at(args, i) : None
}
// Matching (`level reads …`): how far a pattern reads a text (wholly, to a statement's end, else as far as it does;
// none when a literal of it is not in the text); holes bound; a span; a text read as a type; what a node's keys read a
// text wholly as; the last of a list; what a node reads with (`with`); whether a closure reads at a place now; what the
// rules around a context led by the text at a place read there (the rules' lead bytes first), and the two caches of it.
Matching := class {
  static reads (p, t) => Matching.reads_text(p, (t is Node) ? member(t, Symbol.text) : t)
  static reads_text (p, t: Text) => ((t is Text) && (literals_in(p, t.from, t.to) != 0)) ? Matching.reads_in(p, t, textend, boundn) : Readings.not_whole()
  static reads_in (p, t: Text, te, bn) => {
