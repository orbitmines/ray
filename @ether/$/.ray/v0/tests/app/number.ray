mark ^keyword := external global

unless (zero.is_zero) { INFO@mark `N1 zero is not zero` }

if (one.is_zero) { INFO@mark `N2 one reports zero` }

unless ((one + two) == three) { INFO@mark `N3 1 + 2 is not 3` }

unless ((three - one) == two) { INFO@mark `N4 3 - 1 is not 2` }

unless ((one - three) == zero) { INFO@mark `N5 1 - 3 does not floor at zero` }

unless ((two * three) == six) { INFO@mark `N6 2 * 3 is not 6` }

unless (one < two) { INFO@mark `N7 1 < 2 is false` }

if (two < one) { INFO@mark `N8 2 < 1 is true` }

unless ((six / two) == three) { INFO@mark `N9 6 / 2 is not 3` }

unless ((seven % three) == one) { INFO@mark `N10 7 % 3 is not 1` }

unless (four.even) { INFO@mark `N11 4 is not even` }

unless (five.odd) { INFO@mark `N12 5 is not odd` }

unless ((two.max(five)) == five) { INFO@mark `N13 max failed` }

// `pow` and `factorial` are asserted below, for small numbers: a number is a
// walk, so what they answer has to be walked too.

if (three.even) { INFO@mark `NN1 3 is even` }

counter ^keyword := zero
three times { counter = counter.succ }
unless (counter == three) { INFO@mark `NN2 times did not run three times` }

unless (Hexadecimal.radix == (ten + six)) { INFO@mark `N20 hexadecimal radix is not sixteen` }

minus_two := two.as_integer.negated
unless (minus_two.negative) { INFO@mark `N21 negation is not negative` }

unless ((minus_two + five.as_integer) == three.as_integer) { INFO@mark `N22 -2 + 5 is not 3` }

unless ((minus_two * minus_two) == four.as_integer) { INFO@mark `N23 -2 * -2 is not 4` }

unless (minus_two < one.as_integer) { INFO@mark `N24 -2 < 1 is false` }

rounds_seen ^keyword := zero
three times { rounds_seen = rounds_seen + it }
unless (rounds_seen == three) { INFO@mark `N30 times does not hand its round as it` }
unless five.positive { INFO@mark `N31 a natural number is not positive` }
if (exists five.sign) { INFO@mark `N32 a natural number has a sign` }
unless (five.negated.negative) { INFO@mark `N33 a negated natural number is not negative` }
unless (five.abs == five) { INFO@mark `N34 a natural number is not its own absolute value` }
unless (42 == ((four * ten) + two)) { INFO@mark `N40 42 is not forty-two` }
unless ((3 + 4) == seven) { INFO@mark `N41 3 + 4 is not seven` }
unless (7.succ == eight) { INFO@mark `N42 7.succ is not eight` }
unless (0x1F == ((three * ten) + one)) { INFO@mark `N43 0x1F is not thirty-one` }
unless (0b101 == five) { INFO@mark `N44 0b101 is not five` }
if (exists Decimal.accepts(`4a`)) { INFO@mark `N45 4a is read as a decimal number` }
unless (exists Hexadecimal.accepts(`4a`)) { INFO@mark `N46 4a is not read as a hexadecimal number` }

// Signed numbers: what a sign does to size, order and arithmetic.
unless (five.signed.negated.negative) { INFO@mark `N47 minus five is not negative` }
unless (five.signed.negated.abs == five.signed) { INFO@mark `N48 the size of minus five is not five` }
unless ((five.signed.negated + five.signed).is_zero) { INFO@mark `N49 minus five and five do not make nothing` }
unless ((two.signed.negated * three.signed).negative) { INFO@mark `N50 minus two times three is not negative` }
unless (three.signed.negated < two.signed.negated) { INFO@mark `N51 minus three is not less than minus two` }
unless (two.signed < three.signed) { INFO@mark `N52 two is not less than three` }
if (three.signed < two.signed) { INFO@mark `N53 three is less than two` }
unless ((three.signed - five.signed).negative) { INFO@mark `N54 three less five is not negative` }

// What two numbers have in common, and what they make together.
unless ((six.gcd(four)) == two) { INFO@mark `N55 the greatest common divisor of six and four is not two` }
unless ((four.gcd(six)) == two) { INFO@mark `N56 asking the other way round answers otherwise` }
unless ((five.gcd(three)) == one) { INFO@mark `N57 five and three share more than one` }
unless ((two.lcm(three)) == six) { INFO@mark `N58 the least common multiple of two and three is not six` }
unless (two.coprime(three)) { INFO@mark `N59 two and three are not coprime` }
if (two.coprime(four)) { INFO@mark `N60 two and four are coprime` }
unless (two.divides(six)) { INFO@mark `N61 two does not divide six` }
if (four.divides(six)) { INFO@mark `N62 four divides six` }
unless (one.divides(five)) { INFO@mark `N63 one does not divide five` }

// Halving, the smaller of two, and a number multiplied by itself.
unless (six.half == three) { INFO@mark `N64 half of six is not three` }
unless (seven.half == three) { INFO@mark `N65 half of seven is not three` }
unless (zero.half.is_zero) { INFO@mark `N66 half of nothing is not nothing` }
unless ((two.min(five)) == two) { INFO@mark `N67 the smaller of two and five is not two` }
unless ((five.min(two)) == two) { INFO@mark `N68 asking the smaller the other way round answers otherwise` }
unless (three.squared == nine) { INFO@mark `N69 three by itself is not nine` }
unless (one.squared == one) { INFO@mark `N70 one by itself is not one` }

// Raising and the product of everything below.
unless ((two.pow(three)) == eight) { INFO@mark `N71 two raised to three is not eight` }
unless ((five.pow(one)) == five) { INFO@mark `N72 five raised to one is not five` }
unless ((five.pow(zero)) == one) { INFO@mark `N73 five raised to nothing is not one` }
unless (three.factorial == six) { INFO@mark `N74 three factorial is not six` }
unless (one.factorial == one) { INFO@mark `N75 one factorial is not one` }
unless (zero.factorial == one) { INFO@mark `N76 nothing factorial is not one` }

// The digits a number is spelled with, in a base.
unless (six.digits_in(ten).count == one) { INFO@mark `N77 six is spelled with other than one digit in ten` }
unless (six.digits_in(two).count == three) { INFO@mark `N78 six is spelled with other than three digits in two` }
unless (one.digits_in(two).count == one) { INFO@mark `N79 one is spelled with other than one digit in two` }

// What a chain of numbers adds to, and what it multiplies to.
counted ^keyword := chain None
counted &= one
counted &= two
counted &= three
unless (counted.sum == six) { INFO@mark `N80 one, two and three do not add to six` }
unless (counted.product == six) { INFO@mark `N81 one, two and three do not multiply to six` }
only_one ^keyword := chain None
only_one &= five
unless (only_one.sum == five) { INFO@mark `N82 one thing does not add to itself` }
unless (only_one.product == five) { INFO@mark `N83 one thing does not multiply to itself` }

// The digits a number is spelled with, read back as the number.
unless (Number.from_digits(ten, counted) == ((hundred + (two * ten)) + three)) { INFO@mark `N84 one, two and three in ten do not spell a hundred and twenty-three` }
unless (Number.from_digits(two, counted) == (ten + one)) { INFO@mark `N85 one, two and three in two do not spell eleven` }

// What a number says about itself.
unless (five.is_natural) { INFO@mark `N86 five is not a natural number` }
unless (five.positive) { INFO@mark `N87 five is not positive` }
if (five.negative) { INFO@mark `N88 five is negative` }
unless (five.abs == five) { INFO@mark `N89 the size of five is not five` }
if (exists five.sign) { INFO@mark `N90 a natural number has a sign` }

// A block read once for each of them, told which round it is on.
rounds_run ^keyword := zero
rounds_seen ^keyword := zero
three.rounds({ rounds_run = rounds_run.succ }, zero)
unless (rounds_run == three) { INFO@mark `N91 three rounds are not three` }
