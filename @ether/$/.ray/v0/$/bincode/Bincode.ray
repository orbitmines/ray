// Bincode's wire format (https://github.com/bincode-org/bincode/blob/trunk/docs/spec.md)
// The configuration is part of the type, chosen per use: Bincode<T> reads and writes the standard one, Bincode<T, Bincode.legacy> bincode 1.x's (https://github.com/bincode-org/bincode/blob/trunk/docs/spec.md#configuration)
Bincode<T, configuration: Configuration = Configuration.standard> := class (value: Schema<T>) {
  // Configuration: integer encoding, byte order and a limit on the bytes read (https://docs.rs/bincode/latest/bincode/config/struct.Configuration.html)
  static Configuration := class = varint = true, endianness: Unicode.Endianness = Unicode.Endianness.LE, limit: Decimal? = None {
    // config::standard(): little endian, variable integer encoding, no limit (https://docs.rs/bincode/latest/bincode/config/fn.standard.html)
    static standard = Configuration()
    // config::legacy(): little endian, fixed integer encoding, no limit; bincode 1.x's format, which Pijul's change files use (https://docs.rs/bincode/latest/bincode/config/fn.legacy.html)
    static legacy = Configuration(varint: false)
    // with_fixed_int_encoding, with_variable_int_encoding, with_big_endian, with_little_endian, with_limit (https://docs.rs/bincode/latest/bincode/config/struct.Configuration.html)
    fixint => Configuration(varint: false, endianness, limit)
    varint_encoded => Configuration(varint: true, endianness, limit)
    big_endian => Configuration(varint, endianness: Unicode.Endianness.BE, limit)
    little_endian => Configuration(varint, endianness: Unicode.Endianness.LE, limit)
    limited (bytes: Decimal) => Configuration(varint, endianness, limit: bytes)
  }
  static standard = Configuration.standard
  static legacy = Configuration.legacy

  // Decoding more bytes than the limit is an error (https://docs.rs/bincode/latest/bincode/config/struct.Configuration.html#method.with_limit)
  dynamically assert configuration.limit === None || (this as Byte[]).count <= configuration.limit

  // Fixint encoding: the integer in its width, in the configured byte order
  static Fixed<width> := class (bytes: Byte[]{count == width / 8}) {
    value => (configuration.endianness == Unicode.Endianness.LE ? <-bytes : bytes) as Binary
    static (n: Integer) as (=== Fixed<width>) => Fixed<width>(bytes: (n as Binary{length == width}) as Byte[] -- (configuration.endianness == Unicode.Endianness.LE ? <-. : .))
  }
  // Varint encoding: below 251 in one byte, else 251, 252, 253 or 254 and the integer in 2, 4, 8 or 16 bytes
  static Varint := class ((small: Byte{< 251}) | (251, wide: Fixed<16>) | (252, wide: Fixed<32>) | (253, wide: Fixed<64>) | (254, wide: Fixed<128>)) {
    value => small ?? wide.value
    static (n: Integer) as (=== Varint) => n < 251 ? Varint(small: n) : [(16, 251), (32, 252), (64, 253), (128, 254)].find(n < 2 ^ .0) -- (fit => Varint(wide: n as Fixed<fit.0>))
  }
  static Unsigned<width> := configuration.varint ? Varint : Fixed<width>
  // Signed integers are zigzag encoded under varint
  static Signed<width> := class (encoded: Unsigned<width>) {
    value => configuration.varint ? (encoded.value.even ? encoded.value / 2 : -(encoded.value + 1) / 2) : encoded.value as Binary{length == width}.Signed
    static (n: Integer) as (=== Signed<width>) => Signed<width>(encoded: configuration.varint ? (n >= 0 ? 2 * n : -2 * n - 1) : n)
  }
  // Collections and strings: a u64 length, then the elements
  static Length := Unsigned<64>
  static Listed<E> := class (length: Length, elements: Schema<E>[]{count == length.value})
  static Text := class (length: Length, bytes: Byte[]{count == length.value}) {
    value => bytes as Unicode.UTF-8 as String
  }
  // Option: a tag byte, then the value when it is 1
  static Tagged<E> := class ((0 as None) | (1, value: Schema<E>))
  // Enums: the variant's index as a u32, then its fields
  static Variant<E> := class (index: Unsigned<32>, value: Schema<E.variants[index.value]>)

  // Basic types, collections, Option, enums and structs, each by the type it encodes
  static schema := {
    {type: (=== boolean)} => Byte{<= 1} as (. == 1)
    {type: (=== Byte)} => Byte
    {type: (=== Integer{>= 0})} => Unsigned<64>
    {type: (=== Integer)} => Signed<64>
    {type: (=== Decimal)} => Fixed<64>
    {type: (=== String)} => Text
    {type: Optional} => Tagged<type.inner>
    {type: Iterable} => Listed<type.element>
    {type: Enum} => Variant<type>
    {type: Class} => type.fields.map(Schema<.type>)
  }
  static Schema<E> := Compiler.reduced(E, schema)

  static language = Language(".bincode",
    level: { {encoded: Bincode<*, configuration>} => encoded.value },
    written: { {writing: Language.Writing} => Bincode<writing.value.static, configuration>(value: writing.value) as Byte[] })
}
