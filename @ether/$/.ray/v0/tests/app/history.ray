// Version control: one history that every language reads into and writes out of; Ray's own is the .% form.

mark ^keyword := external global

ada := Instance.local.login(Character(name: "ada"))

// Operations over definitions: a rename keeps who it is.
vh := History(repository: Repository())
vd := Definition(name: "greet")
vh.operate(ada, Operation.Kind.define, vd, "hello")
unless vh.code_of(vd) == "hello" { INFO@mark `VC1 a defined definition has no code` }
vh.operate(ada, Operation.Kind.rename, vd, "welcome")
unless vh.name_of(vd) == "welcome" { INFO@mark `VC2 a renamed definition is not called its new name` }
unless vh.named("welcome") == vd { INFO@mark `VC3 a rename made another definition` }
unless vh.code_of(vd) == "hello" { INFO@mark `VC4 a rename changed the code` }
unless vh.head.previous.stamp < vh.head.stamp { INFO@mark `VC5 a later commit is not stamped later` }

// Running as a character.
unless (@ada { @me }) == ada { INFO@mark `VC6 a block run as a character does not run as it` }

// `.%`: a line per commit, the program that produces the next version.
vl := History.line(vh.head, above: vh.head.previous)
unless vl ~= ⊢(vh.head.id as String + "\\ ") { INFO@mark `VC7 a line does not begin with its label` }
unless vl ~= " @ada { " { INFO@mark `VC8 a line does not run as who made the commit` }
unless vl ~= ". named \"welcome\"" { INFO@mark `VC9 a rename is not written as naming the value` }
vt := Language.ray.write(vh)
vf := vt.at(vh.id as String + ".ray").content as String
unless vf.lines{.nonempty}.count == 2 { INFO@mark `VC10 two commits are other than two lines` }
unless vt.at("index.ray").content as String ~= ("welcome: ", vd.id as String) { INFO@mark `VC11 the index does not map the name to the definition` }
vb := History().read(vf as History.File)
unless vb.head.id == vh.head.id { INFO@mark `VC12 a history read back has other labels` }
unless vb.count == 2 { INFO@mark `VC13 a history read back has other than its two commits` }
unless vb.name_of(vb.definitions.first) == "welcome" { INFO@mark `VC14 a history read back forgot the rename` }
unless vb.head.previous.stamp < vb.head.stamp { INFO@mark `VC15 a history read back lost its order` }

// A labelled program is a history of its labels.
vp := Program(code: {
  first\
  1
  second\
  2
})
unless (vp as History).count == 2 { INFO@mark `VC16 a labelled program is not a history of its labels` }

// What the Ray language keeps.
unless Language.ray.fidelity == Language.Fidelity.lossless { INFO@mark `VC17 the .% history is not lossless` }
unless $.ray === Language.ray { INFO@mark `VC43 $.ray is not the Ray language` }

// A foreign snapshot: operations inferred from successive trees.
text := "x := 1\ny := 2\nz := 3" as Byte[]
vs1 := History.Revision(id: 1, tree: Language.Entry.of([(path: "a.ray", content: text)]), who: "someone", when: Time.now)
vs2 := History.Revision(id: 2, parents: [1], tree: Language.Entry.of([(path: "b.ray", content: text)]), who: "someone", when: Time.now)
vi := History.read_revisions([vs1, vs2])
unless vi.head.operations.first.kind == Operation.Kind.rename { INFO@mark `VC29 a moved file is not read as a rename` }
unless vi.definitions.count == 1 { INFO@mark `VC30 a rename made a second definition` }
vt1 := History.Revision(id: 1, tree: Language.Entry.of([(path: "a.ray", content: text), (path: "c.ray", content: text)]), who: "someone", when: Time.now)
vt2 := History.Revision(id: 2, parents: [1], tree: Language.Entry.of([(path: "b.ray", content: text)]), who: "someone", when: Time.now)
unless History.read_revisions([vt1, vt2]).head.operations{.definition is Quest}.nonempty { INFO@mark `VC31 a rename two files could have made is not a quest` }

// Merging: concurrent changes to one definition are a quest; to two are not.
vm := History(repository: Repository())
vx := Definition(name: "x")
vy := Definition(name: "y")
vm.operate(ada, Operation.Kind.define, vx, 1)
vbranch := vm.fork
vm.operate(ada, Operation.Kind.change, vx, 2)
vbranch.operate(ada, Operation.Kind.change, vx, 3)
unless vm.merge(vbranch) is Quest { INFO@mark `VC32 two changes to one definition merged without asking` }
vn := History(repository: Repository())
vn.operate(ada, Operation.Kind.define, vx, 1)
vother := vn.fork
vn.operate(ada, Operation.Kind.change, vx, 2)
vother.operate(ada, Operation.Kind.define, vy, 5)
vn.merge(vother)
unless vn.head.merged { INFO@mark `VC33 a merge of two branches does not have both as parents` }
unless vn.code_of(vx) == 2 && vn.code_of(vy) == 5 { INFO@mark `VC34 a merge lost a change from one side` }

// Pins, and a fix that substitutes a version.
vstd := History(repository: Repository())
vf1 := Definition(name: "f")
vstd.operate(ada, Operation.Kind.define, vf1, 1)
vbug := vstd.head.id
vstd.operate(ada, Operation.Kind.change, vf1, 2, substitutes: vbug)
unless vstd.checkout(vbug)[vf1.id] == 2 { INFO@mark `VC35 a pin to a fixed version does not get the fix` }
unless vstd.checkout(vbug, as_of: vstd.head.previous.stamp)[vf1.id] == 1 { INFO@mark `VC36 what was written before the fix does not replay as recorded` }

// One global order over separate histories.
vglobal := History.global([vstd, vn])
unless vglobal.ordered.zip(vglobal.ordered.rest).every((a, b) => !(b.stamp < a.stamp)) { INFO@mark `VC37 the global order is not by stamp` }
unless vglobal.head.parents.count == 2 { INFO@mark `VC38 the global history does not join every history` }

// Storage choices are optimisation levels.
unless Compiler.levels.contains(Compiler.stored) { INFO@mark `VC39 storage is not a compiler level` }
unless History.Written(history: vh).caches.first.content as String ~= ⊢(vh.head.id as String + "\\ ") { INFO@mark `VC40 the cache does not hold the value at the head` }
unless History.edit("abcdef", "abXdef") == ". edited(3, 4, \"X\")" { INFO@mark `VC41 a small change is not written as an edit` }
unless "abcdef".edited(3, 4, "X") == "abXdef" { INFO@mark `VC42 an edit does not produce the changed value` }
