// DNS messages are values; the wire format reads them and writes them.

mark ^keyword := external global

question := Network.DNS.query("example.com")
unless question.questions.count == 1 { INFO@mark `DN1 a query does not ask one question` }
unless question.qdcount == 1 { INFO@mark `DN2 the header does not count its question` }
unless question.recursion_desired { INFO@mark `DN3 a query does not ask for recursion` }
asked_bytes := question as Byte[]
unless asked_bytes.count == 29 { INFO@mark `DN4 a query for example.com is not 29 bytes` }
unless asked_bytes[12] == 7 { INFO@mark `DN5 a label does not start with its length` }
unless (asked_bytes as Network.DNS.Message).named(question.questions.first.name) as String == "example.com" { INFO@mark `DN6 a name does not read back` }
unless question.named(Network.DNS.Name(labels: [], pointer: 12)) as String == "example.com" { INFO@mark `DN7 a pointer does not name what it points at` }
replied := question.answer([Network.DNS.Record(name: Network.DomainName(text: "example.com") as Network.DNS.Name, type: Network.DNS.Type.A, data: "93.184.215.14" as IPv4)])
unless replied.response { INFO@mark `DN8 an answer is not a response` }
unless replied.id == question.id { INFO@mark `DN9 an answer does not carry the query's id` }
unless replied.addresses.first as String == "93.184.215.14" { INFO@mark `DN10 an answer does not give its address` }
unless (replied as Byte[] as Network.DNS.Message).answers.first.data as String == "93.184.215.14" { INFO@mark `DN11 an answer does not read back` }
unless Network.DNS.Type.AAAA.code == 28 { INFO@mark `DN12 AAAA is not type 28` }
large := Network.DNS.Message(questions: (1..40).map(Network.DNS.Question(name: Network.DomainName(text: "a-name-long-enough-to-matter.example.com") as Network.DNS.Name)))
unless Compiler.reduced(Network.DNS.Lookup(large), Network.DNS.Optimizations).transport == Network.DNS.Transport.tcp { INFO@mark `DN13 a message over 512 bytes is not sent over TCP` }
unless Compiler.reduced(Network.DNS.Lookup(question, server: @https://dns.example/dns-query), Network.DNS.Optimizations).transport == Network.DNS.Transport.https { INFO@mark `DN14 an https resolver is not asked over HTTPS` }
