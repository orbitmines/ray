// Who a character is, by what only the runtime can make: keys under a root policy, handshakes, signed history, delegation, recovery (World W2.1).

mark ^keyword := external global

// Verified and claimed: verified characters compare by root, a claimed one is only itself, and never a verified one.
ver_a := Instance.local.login(Character(name: "ver-a"))
ver_b := Instance.local.login(Character(name: "ver-b"))
unless ver_a.acting is Verified { INFO@mark `VER1 a character logged in here does not act as verified` }
unless ver_a.acting == ver_a.acting { INFO@mark `VER2 one character verified twice is two characters` }
if ver_a == ver_a.acting || ver_a.acting == ver_a { INFO@mark `VER3 a claimed character equals a verified one` }
unless ver_a == ver_a { INFO@mark `VER4 a claimed character is not itself` }
if Character(name: "ver-a") == ver_a || Character(name: "ver-a") == ver_a.acting { INFO@mark `VER5 a character built from a name is the character of that name` }
if ver_a.acting == ver_b.acting { INFO@mark `VER6 two roots compare equal` }
unless Character(name: "nowhere").acting is Diagnostic { INFO@mark `VER7 a character nobody holds here acts` }
if (with (@me = ver_a) { Character(name: "forged", proof: ver_a.acting.proof) == ver_a.acting }) { INFO@mark `VER8 code running as a character made a verified one` }
if (Character(name: "a") == Character(name: "a")) is Diagnostic { INFO@mark `VER9 comparing characters errs with @ether/security imported` }

// A character used as a condition is whether it is @me.
cw := Instance.local.login(Character(name: "viewer"))
cw_other := Instance.local.login(Character(name: "other"))
unless (with (@me = cw) { cw ? true : false }) { INFO@mark `CW1 a character as a condition is false to itself` }
if (with (@me = cw_other) { cw ? true : false }) { INFO@mark `CW2 a character as a condition is true to someone else` }
unless (with (@me = cw) { cw.acting ? true : false }) { INFO@mark `COND1 a verified character as a condition is false to itself` }

// A program runs as its who; its runs are logged for replay, as recorded.
hg_giver := Instance.local.login(Character(name: "giver"))
hg := Program(code: { @me }, who: hg_giver)
unless hg.run == hg_giver.acting { INFO@mark `HG1 handed-over code does not run as the character that handed it over` }
unless Program.runs.head.who === hg_giver { INFO@mark `HG2 a run of handed-over code is not logged as its giver` }
unless Program.replay(Program.runs.head) == hg_giver.acting { INFO@mark `HG3 a logged run does not replay as its character` }
if Program.replay(Program.runs.head) is Live { INFO@mark `VER10 a replay is given the live permissions of who it replays` }
with Program.kept = 0 seconds {
  if Program.recent.some(=== Program.runs.head) { INFO@mark `HG5 a run older than the configured window is kept for replay` }
}

// The root policy: the first commit of the key log, keys naming their algorithm, and short-lived certificates for instance keys.
idy := Instance.local.login(Character(name: "rooted"))
idy_policy := idy.policy()
unless idy.identity.history.since(None).count >= 2 { INFO@mark `IDY1 a character logged in has no key log` }
unless idy_policy.keys.count == 1 && idy_policy.keys.first.algorithm === idy_policy.signing { INFO@mark `IDY2 the root key does not name the policy's algorithm` }
unless idy.key.algorithm === idy_policy.signing { INFO@mark `IDY3 the instance key is not of the algorithm the policy names` }
unless idy_policy.certifies(idy.key.published, World.ether.clock.now) { INFO@mark `IDY4 the instance key held here is not certified` }
if idy_policy.certifies(idy.key.published, World.ether.clock.now, world: World(name: "elsewhere")) { INFO@mark `IDY5 a certificate for no world speaks in a world` }
if idy_policy.certificates.first.until > Time.now + 30 days { INFO@mark `IDY6 an instance certificate lasts beyond thirty days` }
unless idy_policy.revoke.count == 1 && idy_policy.recover.wait == 7 days && idy_policy.recover.veto { INFO@mark `IDY7 the default thresholds are not revoke 1, recover after 7 days with a veto` }
unless idy_policy.threshold(idy_policy.copy ~~ .certificates = []) === idy_policy.revoke { INFO@mark `IDY8 removing a certificate is not a revocation` }
unless idy_policy.threshold(idy_policy.copy ~~ .signing = $.x25519) === idy_policy.rotate { INFO@mark `IDY9 changing the algorithm is not a rotation` }
unless (2 of [1, 2] after 7 days vetoable by 1 of [3]).veto.signers == [3] { INFO@mark `IDY10 a threshold does not read its wait and veto` }

// Pre-rotation: the next keys are known by their digests only, and count for a rotation once revealed.
idy_next := $.ed25519.pair()
idy_pre := Identity(keys: [$.ed25519.pair().published], next: [$.sha256.write(idy_next.public).bytes])
unless idy_pre.counts(idy_next.published, idy_pre.rotate.signers, World.ether.clock.now) { INFO@mark `IDY11 a revealed next key does not count for a rotation` }
if idy_pre.counts($.ed25519.pair().published, idy_pre.rotate.signers, World.ether.clock.now) { INFO@mark `IDY12 a key nobody committed to counts for a rotation` }

// Revoking the key of a lost device takes one root key, and locks it out.
Instance.local.revoked(idy, idy.key.published)
if idy.policy().certifies(idy.key.published, World.ether.clock.now) { INFO@mark `IDY13 a revoked instance key is still certified` }
if Instance.local.verified(idy) { INFO@mark `IDY14 a character whose key was revoked is verified` }

// Per-world instance keys, each certified by the root, for unlinkability.
idy_world := World(name: "unlinked")
Instance.local.certified(idy, idy_world)
unless idy.key_in(idy_world) && idy.key_in(idy_world) != idy.key { INFO@mark `IDY15 a world is not given a key of its own` }
unless idy.policy().certifies(idy.key_in(idy_world).published, World.ether.clock.now, world: idy_world) { INFO@mark `IDY16 a world's key is not certified for that world` }

// Logging out zeroises the key.
vz := Instance.local.login(Character(name: "leaving-keys"))
Instance.local.logout(vz)
if vz.key || Instance.local.verified(vz) { INFO@mark `IDY17 a character logged out keeps its key` }
lgo := Instance.local.login(Character(name: "leaving-inbox"))
Instance.local.certified(lgo, World(name: "lgo-world"))
lgo_inbox := lgo.inbox
lgo_world_key := lgo.world_keys.first.key
Instance.local.logout(lgo)
if lgo_inbox.agreed($.x25519.pair().public) is Byte[] { INFO@mark `LGO1 an agreement key outlives logging out` }
if lgo_world_key.signed([1]).valid == true { INFO@mark `LGO2 a per-world key outlives logging out` }
if (with (@me = ver_a) { ver_a.key.secret }) is Byte[] { INFO@mark `IDY18 a private key is read by the character's own code` }

// Signed history: one instance key signs every commit, over a hash that chains the parents and the key-log event relied on.
sgn := Instance.local.login(Character(name: "signer"))
sgn_h := History(repository: Repository())
sgn_h.commit(sgn, 1)
sgn_h.commit(sgn, 2)
unless sgn_h.head.signature && sgn_h.head.covers(sgn_h.head.signature) { INFO@mark `SGN1 a commit is not signed over its hash` }
unless sgn_h.head.authentic { INFO@mark `SGN2 a signed commit does not check against the key log at its stamp` }
unless sgn_h.head.relies == sgn.identity.history.head.hash { INFO@mark `SGN3 a commit does not name the key-log event it relies on` }
unless sgn_h.head.signature.by == sgn_h.head.previous.signature.by { INFO@mark `SGN4 one instance signs its commits with other keys` }
if sgn_h.head.rewritten(Program(code: { 3 })).authentic { INFO@mark `SGN5 a commit whose change was replaced is still authentic` }
if History(repository: Repository()).commit(Character(name: "keyless"), 1).head.authentic { INFO@mark `SGN6 a commit by a claimed character is authentic` }
sgn_back := sgn.sealed(History.Commit(who: sgn, stamp: Stamp(wall: sgn_h.head.previous.stamp.wall, logical: sgn_h.head.previous.stamp.logical + 1, node: "back"),
  change: Program(code: { 9 }), from: [sgn_h.head.previous.id]))
unless sgn_h.accepted(sgn_back).erred { INFO@mark `SGN7 a backdated commit is taken without a merge` }
sgn_next := sgn.sealed(History.Commit(who: sgn, stamp: sgn_h.clock.now, change: Program(code: { 4 }), from: [sgn_h.head.id]))
unless sgn_h.accepted(sgn_next).head.value == 4 { INFO@mark `SGN8 a commit that follows the head is refused` }

// The handshake: Noise XX between two instances, then each introduces itself signing the handshake hash with its instance key.
hsk_a := Instance.local.login(Character(name: "hsk-a"))
hsk_peer := Instance(host: "hsk-peer")
hsk_b := hsk_peer.login(Character(name: "hsk-b"))
hsk_i := Instance.local.greeted(hsk_a, true)
hsk_r := hsk_peer.greeted(hsk_b, false)
hsk_r.read(hsk_i.written())
hsk_i.read(hsk_r.written())
hsk_r.read(hsk_i.written())
hsk_si := hsk_i.session
hsk_sr := hsk_r.session
hsk_seen := hsk_peer.introduced(hsk_sr, Instance.local.introduction(hsk_a, hsk_si))
unless hsk_seen is Verified && hsk_seen.proof.session === hsk_sr { INFO@mark `HSK1 a completed handshake does not give a verified principal for the session` }
unless hsk_seen == hsk_a.acting { INFO@mark `HSK2 who was verified over the wire is not who was verified here` }
if hsk_seen == hsk_b.acting { INFO@mark `HSK3 the other side is verified as oneself` }

// An introduction is checked against its key log, and the character is made from that log: an identity told beside it is never taken.
intro_forged := hsk_si.sent(Language.ray.write((name: "hsk-a", identity: ver_b.identity, log: hsk_a.identity.history,
  by: hsk_a.key.published, signature: hsk_a.key.signed(hsk_si.binding))) as Byte[])
intro_seen := hsk_peer.introduced(hsk_sr, intro_forged)
if intro_seen.root == ver_b.root || intro_seen.policy().keys == ver_b.policy().keys { INFO@mark `INTRO1 an introduction keeps the identity it was told` }
unless intro_seen.root == hsk_a.root && intro_seen.policy().certifies(hsk_a.key.published, World.ether.clock.now) { INFO@mark `INTRO2 an introduced character's identity is not the key log that was checked` }

// Delegation: signed, scoped and expiring; the effective permission is the intersection.
dlg_from := Instance.local.login(Character(name: "lender"))
dlg := dlg_from.delegate(@me, Access(method: `()`), until: Time.now + 1 hour)
unless dlg.valid() { INFO@mark `DLG1 a signed delegation is not valid` }
unless dlg.covers(`()`, "x") { INFO@mark `DLG2 a delegation does not cover what it names` }
if dlg.covers(`=`, "x") { INFO@mark `DLG3 a delegation to run covers writing` }
if dlg_from.delegate(@me, until: Time.now - 1 second).valid() { INFO@mark `DLG4 an expired delegation is valid` }
if Delegation(from: dlg_from, to: @me, until: Time.now + 1 day, signature: dlg.signature).valid() { INFO@mark `DLG5 a signature over another delegation makes one valid` }
unless Instance.local.delegated(dlg) == dlg_from.acting { INFO@mark `DLG6 a delegated principal is not the one who delegated` }
unless Instance.local.delegated(dlg_from.delegate(@me, until: Time.now - 1 second)) is Diagnostic { INFO@mark `DLG7 an expired delegation is acted on` }
unless Program(code: { @me }, who: dlg_from, delegation: dlg).run.proof.delegation === dlg { INFO@mark `DLG8 handed-over code does not run under its delegation` }

// A delegation is bound to its holder: only the one it was given to, verified, acts on it; renaming the holder breaks its signature.
hold_from := Instance.local.login(Character(name: "hold-from"))
hold_to := Instance.local.login(Character(name: "hold-to"))
hold_other := Instance.local.login(Character(name: "hold-other"))
hold := hold_from.delegate(hold_to, Access(method: `()`), until: Time.now + 1 hour)
unless Instance.local.delegated(hold, by: hold_to) == hold_from.acting { INFO@mark `HOLD1 the one a delegation was given to does not act on it` }
unless Instance.local.delegated(hold) is Diagnostic { INFO@mark `HOLD2 a delegation given to someone else is acted on by whoever presents it` }
unless Instance.local.delegated(hold, by: hold_other) is Diagnostic { INFO@mark `HOLD3 a delegation is acted on by someone it was not given to` }
unless Instance.local.delegated(hold, by: Character(name: "hold-to")) is Diagnostic { INFO@mark `HOLD4 a character built from the holder's name acts on a delegation` }
if Delegation(from: hold_from, to: hold_other, scope: hold.scope, until: hold.until, signature: hold.signature).valid() { INFO@mark `HOLD5 a delegation renamed to another holder keeps its signature` }
unless Instance.local.host_for(hold_other, hold) is Diagnostic { INFO@mark `HOLD6 a guest is hosted under a delegation given to someone else` }
unless Program(code: { @me }, who: hold_from, delegation: hold).run is Diagnostic { INFO@mark `HOLD7 handed-over code runs under a delegation its runner was not given` }

// Recovery: the recovering machine writes the rotation itself; guardians get only its hash and sign it bound to their session.
rcv_c := Instance.local.login(Character(name: "recovering"))
rcv_log := rcv_c.identity.history
rcv := rcv_c.recovery()
if rcv_log.find(rcv.goal.id) { INFO@mark `RCV1 a recovery is in the key log before its guardians signed it` }
rcv_g := Instance.local.login(Character(name: "guardian"))
rcv_i := Noise.handshake(true, $.x25519.pair())
rcv_r := Noise.handshake(false, $.x25519.pair())
rcv_r.read(rcv_i.written())
rcv_i.read(rcv_r.written())
rcv_r.read(rcv_i.written())
rcv_mine := rcv_i.session
rcv_theirs := rcv_r.session
rcv := rcv_c.recovery([rcv_mine])
rcv_message := rcv_mine.sent(rcv.goal.hash)
unless rcv_g.vouching(rcv_theirs, rcv_message) is Program { INFO@mark `RCV2 a guardian signs before verifying the person` }
rcv_signed := rcv_g.key.signed([rcv.goal.hash, rcv_theirs.binding].flatten)
rcv.countersigned(rcv_signed)
unless rcv.goal.signature#.some(=== rcv_signed) { INFO@mark `RCV3 a guardian's signature over the hash, bound to the session, is not taken` }
rcv.countersigned(rcv_g.key.signed([rcv.goal.hash, [0] * 32].flatten))
unless rcv.goal.signature#.count == 1 { INFO@mark `RCV4 a signature bound to no session of this recovery is taken` }
if rcv_log.find(rcv.goal.id) { INFO@mark `RCV5 one guardian meets a threshold of two` }
unless rcv_c.roots.every(.algorithm === rcv_c.policy().signing) { INFO@mark `RCV6 the new root keys are not of the policy's algorithm` }
unless rcv is Program && rcv.who === rcv_c { INFO@mark `RCV7 a recovery is not a program run as the character recovering` }

// Content keys: one per history, wrapped with HPKE for each reader's instance key, found through the reader's key log; readers are whoever its access lets read.
wrp_owner := Instance.local.login(Character(name: "wrp-owner"))
wrp_reader := Instance.local.login(Character(name: "wrp-reader"))
wrp := none.read History(repository: Repository())
wrp.commit(wrp_owner, 1)
wrp_first := wrp.current_key
unless wrp_owner.inbox && wrp_owner.inbox.algorithm === wrp_owner.policy().agreement { INFO@mark `WRAP1 an instance's agreement key is not of the policy's algorithm` }
unless wrp_owner.inboxes().contains(wrp_owner.inbox.published) { INFO@mark `WRAP2 an instance's agreement key is not certified in the key log` }
if wrp_owner.policy().certifies(wrp_owner.inbox.published, World.ether.clock.now) { INFO@mark `WRAP3 an agreement key is certified to sign` }
unless wrp.wraps_of(wrp_first).every(.by is HPKE && .by.kem === wrp_owner.policy().agreement && .cipher === wrp_owner.policy().cipher) { INFO@mark `WRAP4 a content key is not wrapped with the algorithms the keys and policy name` }
unless wrp.content_key(wrp_first, [wrp_owner]) is Encoding.Key { INFO@mark `WRAP5 the writer does not hold the content key` }
unless wrp.content_key(wrp_first, [wrp_reader]).erred { INFO@mark `WRAP6 someone not let read holds the content key` }
wrp.shared(wrp_reader, wrp_owner)
unless wrp.readers.some(=== wrp_reader) { INFO@mark `WRAP7 a character given read is not a reader` }
unless wrp.current_key == wrp_first { INFO@mark `WRAP8 adding a reader rotated the key` }
unless wrp.head.wraps.some(w => w.by.recognised(wrp_reader.inbox, (wrp_first as String).bytes, w.tag, w.sealed)) && wrp.head.wraps.every(.key == wrp_first) { INFO@mark `WRAP9 adding a reader is not a commit wrapping the current key for them` }
unless wrp.content_key(wrp_first, [wrp_reader]) is Encoding.Key { INFO@mark `WRAP10 an added reader does not hold the current key` }
wrp.unshared(wrp_reader, wrp_owner)
unless wrp.current_key != wrp_first && wrp.current_key == wrp.head.id { INFO@mark `WRAP11 removing a reader does not rotate to a new key` }
unless wrp.content_key(wrp.current_key, [wrp_reader]).erred { INFO@mark `WRAP12 a removed reader holds the new key` }
unless wrp.content_key(wrp_first, [wrp_reader]) is Encoding.Key { INFO@mark `WRAP13 a removed reader lost what they already saw` }
unless wrp.content_key(wrp.current_key, [wrp_owner]) is Encoding.Key { INFO@mark `WRAP14 the rest do not hold the new key` }
wrp.commit(wrp_owner, 2)
unless wrp.head.key == wrp.current_key && wrp.value == 2 { INFO@mark `WRAP15 a commit after a rotation does not use the new key` }

// Sealed sender: a who narrower than the history moves who and the signature into the ciphertext; the line shows a per-history pseudonymous key.
sel_writer := Instance.local.login(Character(name: "sel-writer"))
sel := History(repository: Repository()) ~~ (.sender = none)
sel.commit(sel_writer, 1)
sel.commit(sel_writer, 2)
sel_line := sel.head.written(above: sel.head.previous)
unless sel.sealed_sender { INFO@mark `SEAL1 a who narrower than its history does not seal the sender` }
if History(repository: Repository()).sealed_sender { INFO@mark `SEAL2 a who whose visibility is inherited is sealed` }
unless sel.head.who is Encoding.Key && sel.head.who == sel.head.previous.who { INFO@mark `SEAL3 a sealed history's lines do not show one pseudonymous key` }
if sel_line ~= "@sel-writer" || sel.head.relies { INFO@mark `SEAL4 a sealed sender is named in plaintext` }
unless sel.head.authentic { INFO@mark `SEAL5 a line is not signed by the pseudonymous key it shows` }
unless sel.head.opened.who.name == "sel-writer" && sel.head.opened.signature { INFO@mark `SEAL6 a reader does not find who wrote the line and their signature` }
unless sel.value == 2 { INFO@mark `SEAL7 a history with a sealed sender does not read` }
sel_other := History(repository: Repository()) ~~ (.sender = none)
sel_other.commit(sel_writer, 1)
if sel_other.head.who == sel.head.who { INFO@mark `SEAL8 two histories show one pseudonym` }

// A fork and an earlier version are copies: the sealed sender and the content keys come along.
frk := sel.fork
unless frk.sealed_sender && frk.current_key == sel.current_key && sel[sel.head.previous].sealed_sender { INFO@mark `FRK1 a copy of a sealed history loses its sender or its key` }
frk.commit(sel_writer, 3)
unless frk.head.who is Encoding.Key && frk.value == 3 { INFO@mark `FRK2 a commit on a fork of a sealed history names its sender` }

// What a new reader can decrypt is what their read grant covers: the whole history by default, or any narrowing of it; a rotation follows the grants that reach the head.
grk_owner := Instance.local.login(Character(name: "grk-owner"))
grk_all := Instance.local.login(Character(name: "grk-all"))
grk_now := Instance.local.login(Character(name: "grk-now"))
grk_from := Instance.local.login(Character(name: "grk-from"))
grk_past := Instance.local.login(Character(name: "grk-past"))
grk := none.read History(repository: Repository())
grk.commit(grk_owner, 1)
grk_first := grk.current_key
grk.rekeyed(grk_owner)
grk_second := grk.current_key
grk.commit(grk_owner, 2)
grk_label := grk.head.id
grk.rekeyed(grk_owner)
grk_third := grk.current_key
grk.commit(grk_owner, 3)
grk_now.read grk{from Time.now}
grk_from.read grk{from grk_label}
grk_past.read grk{from value == 1 to value == 2}
grk.shared(grk_all, grk_owner)
unless [grk_first, grk_second, grk_third].every(grk.content_key(., [grk_all]) is Encoding.Key) { INFO@mark `GRK1 a reader of the whole history does not hold every key` }
grk.shared(grk_now, grk_owner)
unless grk.head.wraps.every(.key == grk_third) { INFO@mark `GRK2 sharing from now wraps a key from before now` }
unless grk.content_key(grk_third, [grk_now]) is Encoding.Key && [grk_first, grk_second].every(grk.content_key(., [grk_now]).erred) { INFO@mark `GRK3 a reader from now does not hold exactly the current key` }
grk.shared(grk_from, grk_owner)
unless [grk_second, grk_third].every(grk.content_key(., [grk_from]) is Encoding.Key) && grk.content_key(grk_first, [grk_from]).erred { INFO@mark `GRK4 a reader from a label does not hold exactly the keys from that commit on` }
grk.shared(grk_past, grk_owner)
unless [grk_first, grk_second].every(grk.content_key(., [grk_past]) is Encoding.Key) && grk.content_key(grk_third, [grk_past]).erred { INFO@mark `GRK5 a reader of a closed stretch does not hold exactly its keys` }
unless grk.readers.some(=== grk_past) && !grk.following.some(=== grk_past) { INFO@mark `GRK6 a reader of a closed stretch follows the head` }
grk.rekeyed(grk_owner)
unless [grk_owner, grk_all, grk_now, grk_from].every(grk.content_key(grk.current_key, [.]) is Encoding.Key) { INFO@mark `GRK7 a rotation is not wrapped for a reader whose grant reaches the head` }
unless grk.content_key(grk.current_key, [grk_past]).erred { INFO@mark `GRK8 a rotation is wrapped for a reader whose grant ended` }

// Wraps are anonymous: no recipient key in plaintext, a tag only the recipient recomputes, the writer's own wrap like any other.
anw := grk.head.wraps
anw_info := (grk.current_key as String).bytes
if Language.ray.write(anw) ~= Language.ray.write(grk_all.inbox.published.public) || anw.some(.reader) { INFO@mark `ANW1 a wrap names its recipient` }
unless anw{w => w.by.recognised(grk_all.inbox, anw_info, w.tag, w.sealed)}.count == 1 { INFO@mark `ANW2 a reader does not find exactly one wrap by its tag` }
if anw.some(w => w.by.recognised(grk_past.inbox, anw_info, w.tag, w.sealed)) { INFO@mark `ANW3 someone not a reader recognises a wrap` }
unless anw.every(.tag.count == anw.first.tag.count && .sealed.count == anw.first.sealed.count) { INFO@mark `ANW4 the writer's wrap differs in shape from a reader's` }
if Language.ray.write(sel.since(None).map(.wraps)) ~= Language.ray.write(sel_writer.inbox.published.public) { INFO@mark `ANW5 a sealed history's wraps name its writer` }

// End-to-end encryption: a history that is not public is stored as ciphertext for its readers; its lines keep label, parents, stamp, key and signature in plaintext (L§9.2).
ada := Instance.local.login(Character(name: "ada"))
crypt := History(repository: Repository())
crypt.commit(ada, Program(code: { .secret = "kept" }))
crypt.commit(ada, Program(code: { .secret = "kept twice" }))
crypt_first := crypt.since(None).first
crypt_line := crypt.head.written(above: crypt.head.previous)
crypt_text := Language.ray.write(crypt).at(crypt.id as String + ".ray").content as String
if crypt.public { INFO@mark `CRYPT1 a history is public by default` }
unless crypt_first.wraps.some(.key == crypt_first.id) && crypt_first.key == crypt_first.id { INFO@mark `CRYPT2 the first commit does not bring a content key of its own` }
unless crypt.head.key == crypt_first.id { INFO@mark `CRYPT3 a line does not name the content key it uses` }
if crypt_text ~= "kept" { INFO@mark `CRYPT4 a change is written in plaintext` }
unless crypt_line ~= ⊢(crypt.head.id as String + "\\ with (@me = @ada; now = ") { INFO@mark `CRYPT5 a line's label, who and stamp are not in plaintext` }
unless crypt_line ~= "; key = " && crypt_line ~= "; signature = " { INFO@mark `CRYPT6 a line's key and signature are not in plaintext` }
unless crypt.value.secret == "kept twice" { INFO@mark `CRYPT7 a reader does not read an encrypted history` }
crypt_back := (crypt_text as Program) as History
unless crypt_back.head.sealed && crypt_back.head.change == None { INFO@mark `CRYPT8 a line read back holds its change other than as ciphertext` }
unless crypt_back.value.secret == "kept twice" { INFO@mark `CRYPT9 a reader does not read an encrypted history back from its lines` }
unless crypt.head.covers(crypt.head.signature) && crypt.head.authentic { INFO@mark `CRYPT10 the signature does not cover the line with its ciphertext` }
if (crypt.head.rewritten(None) ~~ (.sealed = crypt_first.sealed)).authentic { INFO@mark `CRYPT11 a line whose ciphertext was replaced is authentic` }
unless (crypt_first.rewritten(None) ~~ (.sealed = crypt.head.sealed)).opened is Diagnostic { INFO@mark `CRYPT12 a ciphertext moved to another line opens there` }
unless crypt.content_key(crypt.current_key, []).erred { INFO@mark `CRYPT13 the content key opens for nobody's instance key` }
if Compiler.reduced(crypt, Compiler.cached).cache_files.first.content as String ~= "kept" { INFO@mark `CRYPT14 a cache of an encrypted history is in plaintext` }
unless crypt.tree.at(crypt.id as String + ".ray") { INFO@mark `CRYPT15 a backend is given the values of an encrypted history instead of its lines` }
unless Compiler.levels.contains(Compiler.encrypted) { INFO@mark `CRYPT16 encryption is not a storage level` }

// A public history stays plaintext and has no content key.
crypt_open := History(repository: Repository()).publish
crypt_open.commit(ada, Program(code: { .open = 1 }))
unless crypt_open.head.written() ~= ".open = 1" { INFO@mark `CRYPT17 a public history is encrypted` }
if crypt_open.head.key || crypt_open.head.wraps.nonempty { INFO@mark `CRYPT18 a public history has a content key` }

// Merging happens where the history is read: two branches under one key merge as any other.
crypt_branch := crypt.fork
crypt.commit(ada, Program(code: { .x = 1 }))
crypt_branch.commit(ada, Program(code: { .y = 2 }))
unless crypt_branch.head.key == crypt.head.key { INFO@mark `CRYPT19 a fork does not keep the content key` }
crypt.merge(crypt_branch)
unless crypt.head.merged && crypt.value.x == 1 && crypt.value.y == 2 { INFO@mark `CRYPT20 a reader does not merge two branches of an encrypted history` }

// Every private key is a secret (`none.read`): stores skip it whatever it is called, and logging out zeroises and drops all of them, so the next login makes fresh ones.
sct := Instance.local.login(Character(name: "secret-keeper"))
Instance.local.certified(sct, World(name: "sct-world"))
unless ["key", "inbox", "roots", "world_keys"].every(name => sct.fields{.name == name}.every(.unreadable)) { INFO@mark `SECRET1 a private key is held in a field someone may read` }
if (sct as Store.Row).fields.some(.name is ("key" | "inbox" | "roots" | "world_keys")) { INFO@mark `SECRET3 a store writes a private key` }
sct_root := sct.roots.first
Instance.local.logout(sct)
if sct.key || sct.inbox || sct.roots || sct.world_keys { INFO@mark `SECRET4 a secret field holds a value after logging out` }
if sct_root.signed([1]).valid == true { INFO@mark `SECRET5 a root key outlives logging out` }
Instance.local.login(sct)
unless sct.key && sct.inbox { INFO@mark `SECRET6 logging in again does not make fresh keys` }
if sct.policy().certifies(sct.key.published, World.ether.clock.now) { INFO@mark `SECRET7 a key made after logging out is certified without the root keys` }

// Revoking and logging out compare principals by root: a verified copy revokes the grant made to the character, and logs it out.
revk_owner := Instance.local.login(Character(name: "revk-owner"))
revk_reader := Instance.local.login(Character(name: "revk-reader"))
revk := none.read History(repository: Repository())
revk.commit(revk_owner, 1)
revk.shared(revk_reader, revk_owner)
revk.unshared(revk_reader.acting, revk_owner)
if revk.access#.some(.who === revk_reader) { INFO@mark `REVK1 a reader revoked by a verified copy keeps the grant` }
unless revk.content_key(revk.current_key, [revk_reader]).erred { INFO@mark `REVK2 a reader revoked by a verified copy holds the new key` }
revk_leaving := Instance.local.login(Character(name: "revk-leaving"))
Instance.local.logout(revk_leaving.acting)
if Instance.local.logged_in(revk_leaving) { INFO@mark `REVK3 a verified copy logging out leaves the character logged in` }
if revk_reader.answers_for(revk_reader) || Character(name: "revk-reader").answers_for(revk_reader) { INFO@mark `REVK4 a claimed character answers for a principal` }
unless revk_reader.acting.answers_for(revk_reader) { INFO@mark `REVK5 a verified character does not answer for itself` }
if revk_reader.acting.answers_for(revk_owner) { INFO@mark `REVK6 a verified character answers for another` }

// A line runs as its who only when the runtime verified who signed it, and never with their live permissions.
auth_ran := History.Commit(who: hg_giver, stamp: World.ether.clock.now, change: Program(code: { @me })).applied(None)
if auth_ran is Verified && auth_ran.same(hg_giver) { INFO@mark `AUTH4 an unsigned line replays as the character it names` }
if auth_ran is Live { INFO@mark `AUTH5 a replayed line is given live permissions` }
