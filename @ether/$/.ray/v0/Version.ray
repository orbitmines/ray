Version := class: Ray ("%", number: Decimal, ("'", revision: Decimal)?) => {
  latest => !revision
  breaks_freely => number == 0

  chainable == (other: Version) => number == other.number && revision == other.revision
  chainable < (other: Version) => number < other.number || number == other.number && revision? < other.revision ?? ∞

  next => %(number + 1)
  previous => %(number - 1)
  continuations => Migration.leaving(this).to

  resolved (revisions: Version[]) => latest ? revisions{number == this.number}.max(.revision) ?? this : this

  static Range := class ("%[", first: Decimal, "..", last: Decimal, "]") => {
    includes (version: Version) => first <= version.number <= last
    versions => (first..last).map(%.)
  }
}

Versioned<T> := class = value: T, range: Version.Range? {
  at (version: Version) => value if !range || range.includes(version)
  selected (range: Version.Range) => range.versions.map(at(.)){!= None}
}

Migration := class (from: Version, " -> ", to: Version, " ", body: Function) => {
  static declared: Migration[] = []
  (static.declared ??= []).push this

  backward: Migration => Migration(from: to, to: from, body: body⁻¹ ?? Quest(name: "derive the inverse of a migration", goal: this))

  static leaving (version: Version) => declared{.from == version}, declared{.to == version}.backward
  static migrate (old, from: Version, to: Version) => from.shortest_path_to(to) -- (path => path is Quest
    ? Quest(name: "migrate", goal: (value: old, from: from, to: to))
    : path.zip(path.rest).map((a, b) => leaving(a){.to == b}.first).reduce(held = old => .body(held)))
}

Stamp := class = wall: Decimal, ".", logical: Decimal = 0, "@", node: * {
  chainable < (other: Stamp) => (wall, logical, node as String) < (other.wall, other.logical, other.node as String)
}

HybridClock := class = node: *, wall: Decimal = 0, logical: Decimal = 0 {
  measured => (Time.now as ns / 100).floor

  now: Stamp => {
    at = measured
    logical = wall < at ? 0 : logical + 1
    wall = wall max at
    Stamp(wall, logical, node)
  }

  receive (remote: Stamp): Stamp => {
    highest = measured max wall max remote.wall
    logical = if highest == wall == remote.wall { (logical max remote.logical) + 1 }
      elsif highest == wall { logical + 1 }
      elsif highest == remote.wall { remote.logical + 1 }
      else { 0 }
    wall = highest
    Stamp(wall, logical, node)
  }
}

Definition := class = id: UUID = choose UUID.v1{unique}, name: String, holder: *? {
  chainable == (other: Definition) => id == other.id
}

Operation := class = kind: Kind, definition: Definition, stamp: Stamp, who: *, before: *?, after: *? {
  static Kind := enum define | change | rename | remove {
    inverse => this == define ? remove : this == remove ? define : this
  }

  inverse => Operation(kind.inverse, definition, stamp, who, before: after, after: before)
  matches (current) => !before || before == current
}

Git := class = commits: Commit[] {
  static Commit := class = "commit ", id: *, "\nAuthor: ", author: *, "\nDate: ", date: *, "\n\n    ", message: String, "\n\n" {
    change: *
    parent => <-
  }

  as (=== String) => commits as String[]
  as (=== History) => git_of⁻¹(this)
}

git_of := (history: History): Git => Git(commits: history.commits.map(Git.Commit(id: .id, author: .who, date: .when, message: .value.definition?.name ?? .value as String, change: .value)))
history_of := (git: Git): History => git.commits.reduce(held = History() => held.commit(.author, .change, id: .id, when: .date))
! git_of history_of

History &+= {
  as (=== Git) => git_of(this)
}
