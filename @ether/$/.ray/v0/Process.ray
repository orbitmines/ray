Process := class = command: String | Program, arguments: String[] = [], environment: (name: String, value: String)[] = [], directory: Location?, input: String?, piped: Process?, host: Instance = Instance.local {
  job: Job?

  runner => Compiler.reduced(this, ProcessOptimizations)
  script => $.sh.write(this)
  stdin => command is Program ? command.code as String : input
  started: static => this ~~ (.job ??= runner.submitted(this))
  finished => started.job.await
  stdout | output => finished.stdout
  stderr | errors => finished.stderr
  exit => finished.exit
  succeeded => exit == 0
  stop: static => this ~~ job?.stop
  as (=== String) => stdout
  as (=== boolean) => succeeded

  into (next: Process) => next ~~ (.piped = this)
  setting (name: String, value: String): static => this ~~ environment.push (name: name, value: value)
  within (location: Location): static => this ~~ .directory = location
}

Job := class = id: String, runner: Jobs {
  static Status := enum queued | running | finished | failed | stopped
  static State := class = status: Status, stdout: String = "", stderr: String = "", exit: Integer?

  state: State => runner.state(this)
  done => state.status is (Status.finished | Status.failed | Status.stopped)
  await => Running.until(() => done) -- state
  attach => runner.attached(this)
  stop: static => this ~~ runner.stopped(this)
  remove => runner.removed(this)
}

Jobs := class: Language = name: String, evaluated = false {
  submitted (process: Process) => Job(id: (evaluated ? external os `evaluate` (process.command as String) : external os `job` (name, process.script, process.stdin ?? "")) as String, runner: this)
  state (job: Job) => (external os `job_state` (name, job.id)) as Job.State
  attached (job: Job) => (external os `job_attach` (name, job.id)) as String
  stopped (job: Job) => external os `job_stop` (name, job.id)
  removed (job: Job) => external os `job_rm` (name, job.id)
  listed => (external os `job_list` name).map(Job(id: . as String, runner: this))

  static daemon = Jobs(".jobs", name: "daemon")
  static direct = Jobs(".spawn", name: "direct")
  static running => (external os `daemon`) as boolean
  static browser = Jobs(".browser", name: "browser", evaluated: true)
  static remote (instance: Instance) => Jobs(".remote", name: instance.address as String)
}

ProcessOptimizations := {
  {process: Process{host !== Instance.local}} => Jobs.remote(process.host)
  {process: Process{OS().name == browser}} => Jobs.browser
  {process: Process{Jobs.running}} => Jobs.daemon
  {process: Process} => Jobs.direct
}

Program &+= {
  process (arguments: String[] = []) => Process(command: this, arguments)
}
