      q = q + 1
    }
    append(l, literal(text(s, q))) if q > s
    sequence(l)
  }
  static pattern_part (l, f, g, s, q) => truthy(call1(f, text(q, q + 1))) ? Readings.part_put(l, g, s, q) : s
  static part_put (l, g, s, q) => {
    append(l, literal(text(s, q))) if q > s
    append(l, (g is Closure) ? Pattern(kind: typed_with, a: g, b: text(q, q + 1)) : g)
    q + 1
  }
  static mapped_bytes (t: Text, f, g, o) => {
