// CSS Snapshot (https://www.w3.org/TR/css-2023/)
CSS := class: Language {
  static extensions = ".css"

  Rule := class = selector: String, declarations: ((property: String, value: String) | Comment)[], within: String?
  Keyframes := class = name: String, frames: (at: Probability, declarations: ((property: String, value: String) | Comment)[])[]
  Comment := class = text: String
  Sheet := class = rules: (Rule | Keyframes | Comment)[] = []

  syntax := Compiler.default + {
    // Comments (https://www.w3.org/TR/css-syntax-3/#consume-comment)
    /*{literal text}*/ => Comment(text)
    // Declarations (https://www.w3.org/TR/css-syntax-3/#declaration)
    {property}:{value}; => (property as String, value) if value != None
    // Style rules (https://www.w3.org/TR/css-syntax-3/#style-rules)
    {selector}{`{`}{declarations: *[]}{`}`} => Rule((selector as String).trimmed, declarations{!= None})
    // @keyframes (https://www.w3.org/TR/css-animations-1/#keyframes)
    @keyframes {name}{`{`}{frames: *[]}{`}`} => Keyframes((name as String).trimmed, frames)
    from{`{`}{declarations: *[]}{`}`} => (at: 0, declarations: declarations{!= None})
    to{`{`}{declarations: *[]}{`}`} => (at: 1, declarations: declarations{!= None})
    {percent: Decimal}%{`{`}{declarations: *[]}{`}`} => (at: percent / 100, declarations: declarations{!= None})
    // At-rules holding declarations: @font-face (https://www.w3.org/TR/css-fonts-4/#font-face-rule), @page (https://www.w3.org/TR/css-page-3/#at-page-rule)
    @{name: "font-face" | "page"}{`{`}{declarations: *[]}{`}`} => Rule("@" + name, declarations{!= None})
    // Conditional group rules: @media, @supports, @container (https://www.w3.org/TR/css-conditional-3/#contents-of, https://www.w3.org/TR/css-contain-3/#container-rule)
    @{prelude}{`{`}{rules: *[]}{`}`} => rules{!= None}.map(. is Rule ? Rule(.selector, .declarations, within: "@" + (prelude as String).trimmed) : .)
      -- (.count == 1 ? .first : .)
  }

  written := {
    {sheet: Sheet} => sheet.rules
    {rule: Rule{within}} => rule.within, "{", Rule(rule.selector, rule.declarations), "}"
    {rule: Rule} => rule.selector, "{", rule.declarations.map(. is Comment ? . : (.0, ":", .[1..], ";")), "}"
    {keyframes: Keyframes} => "@keyframes ", keyframes.name, "{", keyframes.frames.map(.at * 100, "%{", .declarations.map(. is Comment ? . : (.0, ":", .[1..], ";")), "}"), "}"
    {comment: Comment} => "/*", comment.text, "*/"
  }
  level := syntax
}
