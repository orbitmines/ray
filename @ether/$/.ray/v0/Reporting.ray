Location &+= {
  from: (line: Decimal, column: Decimal)?
  to: (line: Decimal, column: Decimal)? = from
  file => this ~~ (.from = None) ~~ (.to = None)
}

Diagnostic &+= {
  static Severity := enum trace | debug | info | warn | error | fatal

  severity: Severity = fatal ? Severity.fatal : Severity.error
  at: Location? = origin ? origin.location{from == (origin.start.line, origin.start.column), to == (origin.end.line, origin.end.column)} : None
  code => type && type !== * ? type.name : None
  related => causes[1..]
}


// Language Server Protocol 3.17 (https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/)
LSP &+= {
  extensions = ".lsp"

  // Base protocol header part (https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#headerPart)
  Wire := class (
    "Content-Length: ", size: Decimal = content.count, "\r\n",
    ("Content-Type: ", type: (!"\r")[], "\r\n")?,
    "\r\n",
    content: Byte[]{length == size}
  )
  // DiagnosticSeverity (https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#diagnosticSeverity)
  Severities = { fatal: 1, error: 1, warn: 2, info: 3, debug: 4, trace: 4 }
  // Positions are zero-based; columns count code points under the utf-32 position encoding (https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#positionEncodingKind)
  position (at: (line: Decimal, column: Decimal)?) => (line: (at?.line ?? 1) - 1, character: (at?.column ?? 1) - 1)
  range (at: Location?) => (start: position(at?.from), end: position(at?.to))

  Published := class = file: Location?, diagnostics: Diagnostic[]
  written := {
    {writing: Language.Writing{value is Diagnostic}} => Published(writing.value.at?.file, [writing.value])
    {writing: Language.Writing{value is Diagnostic[]}} => writing.value.map(.at?.file).unique.map(file => Published(file, writing.value{.at?.file == file}))
    // textDocument/publishDiagnostics (https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#textDocument_publishDiagnostics)
    {published: Published} => Wire(content: JSON.write((jsonrpc: "2.0", method: "textDocument/publishDiagnostics", params: (
      uri: published.file as String,
      // Diagnostic (https://microsoft.github.io/language-server-protocol/specifications/lsp/3.17/specification/#diagnostic)
      diagnostics: published.diagnostics.map(diagnostic => (
        range: range(diagnostic.at),
        severity: Severities[diagnostic.severity.name],
        code: diagnostic.code,
        source: "ray",
        message: diagnostic.message as String,
        relatedInformation: diagnostic.related.map(cause => (location: (uri: cause.at?.file as String, range: range(cause.at)), message: cause.message as String)) -- (. if .nonempty)
      ))
    ))) as Unicode.UTF-8 as Byte[])
  }
}
LSP.components.hierarchy &= Language

// Static Analysis Results Interchange Format 2.1.0 (https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html)
SARIF := class: Language {
  static extensions = ".sarif"

  // result.level (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317648)
  static Levels = { fatal: "error", error: "error", warn: "warning", info: "note", debug: "none", trace: "none" }
  // physicalLocation and region, one-based lines and columns (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317685)
  static location (at: Location?) => at ? (physicalLocation: (artifactLocation: (uri: at.file as String),
    region: (startLine: at.from?.line ?? 1, startColumn: at.from?.column ?? 1, endLine: at.to?.line ?? 1, endColumn: at.to?.column ?? 1))) : None

  written := {
    {writing: Language.Writing{value is Diagnostic}} => Language.Writing([writing.value])
    // sarifLog (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317478)
    {writing: Language.Writing{value is Diagnostic[]}} => JSON.write(Document(entries: [
      (name: "$schema", value: "https://json.schemastore.org/sarif-2.1.0.json"),
      (name: "version", value: "2.1.0"),
      // run, tool.driver and columnKind (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317484)
      (name: "runs", value: [(
        tool: (driver: (name: "ray", informationUri: "https://orbitmines.com", rules: writing.value.map(.code).compact.unique.map((id: .)))),
        columnKind: "unicodeCodePoints",
        // result (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317638)
        results: writing.value.map(diagnostic => (
          ruleId: diagnostic.code,
          level: Levels[diagnostic.severity.name],
          message: (text: diagnostic.message as String),
          locations: [location(diagnostic.at)].compact,
          relatedLocations: diagnostic.related.enumerate.map(cause => (id: cause.index, message: (text: cause.value.message as String), physicalLocation: location(cause.value.at)?.physicalLocation)) -- (. if .nonempty)
        ))
      )])
    ]))
  }
}

Report := class = name: String = "ray", claims: Claim[] = [] {
  static Claim := class = id: String, message: String, passed = true, at: Location?, duration: Quantity.Temporal?

  passed => claims.every(.passed)
  failures => claims{!.passed}

  static Written = ("INFO@mark `", id: (Char.Letter | Char.Digit)[]{length > 0}, " ", message: (!"`")[], "`")
  static (file: Location) as (=== Report) => file.content as String -- (text => Program(code: text)().reports -- (reports => Report(name: file as String,
    claims: text.split(\n).enumerate.map(line => (line.value ~= (*, Written, *)) -- (found => Claim(found.id, found.message,
      passed: !reports.some(.level == INFO && .comment ~= ⊢(found.id + " ")),
      at: file{from == (line.index + 1, 1)}) if found)).compact)))
}

// Test Anything Protocol version 14 (https://testanything.org/tap-version-14-specification.html)
TAP := class: Language {
  static extensions = ".tap"

  // Description: "#" and "\" are escaped with "\" (https://testanything.org/tap-version-14-specification.html#escaping)
  static Description := class: String (((!"#" && !"\\" && !\n) | ("\\", "#" | "\\"))[]) {
    static (text: String) as (=== Description) => #text.map(. is ("#" | "\\") ? "\\" + . : .) as String
  }
  // YAML diagnostics, indented two spaces between "---" and "..." (https://testanything.org/tap-version-14-specification.html#yaml-diagnostics)
  static YAML := class ("  ---", \n, lines: ("  ", (name: Char.Word[], ": ", value: (!\n)[]), \n)[], "  ...", \n)
  // Test points (https://testanything.org/tap-version-14-specification.html#test-points)
  static Point := class ((failed: "not ")?, "ok ", number: Decimal, " - ", description: Description, \n, (yaml: YAML) if failed)
  // Version, plan and test points (https://testanything.org/tap-version-14-specification.html#version, https://testanything.org/tap-version-14-specification.html#plan)
  static Wire := class ("TAP version 14", \n, "1..", plan: Decimal = points.count, \n, points: Point[]{length == plan}, ("# ", name: (!\n)[], \n)?)

  level := {
    {wire: Wire} => Report(name: wire.name ?? "ray", claims: wire.points.map(point => (point.description as String ~= (id: Char.Word[], " ", message: *)) -- (named => Report.Claim(named.id, named.message,
      passed: !point.failed,
      at: point.yaml ? (point.yaml.lines{.name == "file"}.first?.value as Location){from == (point.yaml.lines{.name == "line"}.first?.value as Decimal ?? 1, 1)} : None))))
  }
  written := {
    {writing: Language.Writing{value is Report}} => Wire(name: writing.value.name, points: writing.value.claims.enumerate.map(claim => Point(
      failed: "not " if !claim.value.passed,
      number: claim.index + 1,
      description: (claim.value.id + " " + claim.value.message) as Description,
      yaml: YAML(lines: [(name: "message", value: JSON.write(claim.value.message)), (name: "file", value: JSON.write(claim.value.at?.file as String)) if claim.value.at, (name: "line", value: (claim.value.at.from?.line ?? 1) as String) if claim.value.at]) if !claim.value.passed
    )))
  }
}

// JUnit XML as read by CI tools (https://github.com/testmoapp/junitxml, https://llg.cubic.org/docs/junit/)
JUnit := class: Language {
  static extensions = ".junit.xml"

  static attribute (name: String, value) => (name: name, value: value as String as XML.Escaped) if value != None
  static testcase (claim: Report.Claim, suite: String) => XML.Element(name: "testcase", attributes: [
    attribute("name", claim.id + " " + claim.message), attribute("classname", suite),
    attribute("file", claim.at?.file as String if claim.at), attribute("line", claim.at?.from?.line), attribute("time", claim.duration / 1 seconds if claim.duration)
  ].compact, children: claim.passed ? [] : [XML.Element(name: "failure", attributes: [attribute("message", claim.message), attribute("type", claim.id)], children: [XML.Text(claim.message as XML.Escaped)])])

  level := {
    {document: XML.Document{root.name == "testsuites"}} => document.root.children{. is XML.Element}.map(Compiler.reduced(., level)).flatten
    {suite: XML.Element{name == "testsuite"}} => Report(name: suite["name"] ?? "ray", claims: suite.children{. is XML.Element && .name == "testcase"}.map(case => (case["name"] ~= (id: Char.Word[], " ", message: *)) -- (named => Report.Claim(named.id, named.message,
      passed: !case.children.some(. is XML.Element && .name is ("failure" | "error")),
      at: case["file"] ? (case["file"] as Location){from == (case["line"] as Decimal ?? 1, 1)} : None,
      duration: case["time"] ? (case["time"] as Decimal) seconds : None))))
  }
  written := {
    {writing: Language.Writing{value is Report}} => writing.value -- (report => XML.Document(root: XML.Element(name: "testsuites",
      attributes: [attribute("name", report.name), attribute("tests", report.claims.count), attribute("failures", report.failures.count)],
      children: [XML.Element(name: "testsuite",
        attributes: [attribute("name", report.name), attribute("tests", report.claims.count), attribute("failures", report.failures.count), attribute("errors", 0), attribute("skipped", 0)],
        children: report.claims.map(testcase(., report.name)))])))
  }
}
