  static cw_symbol_text (x) => at(syms, untag(x))
  // (the name of a node's first field the program gave it, not one every node has)
  static cw_first_member (x: Node) => ((x is Node) || (x is Applied)) ? Texts.first_named(x.fields) : None
  static first_named (from: Field) => {
    f := from
    named := None
