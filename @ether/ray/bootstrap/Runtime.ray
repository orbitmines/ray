  // (the end of a statement: where a line ends, unless the statement goes on past it; noted to be read after what
  // follows, there)
  static statement_ended (p: Pattern) => (p.b == 2) ? Runtime.statement_marked(rk) : (((rpos == textend) || ((byte(rpos) == 10) && (open_before(rstart, rpos) == 0) && Runtime.line_ends(p, rpos))) ? Runtime.read_to(rpos) : None)
  static line_ends (p: Pattern, at) => (continued_from((p.b == 1) ? p.a : rstart, at) == 0) || (continued_from(at, at) == 0)
  static statement_marked (k: Cell) => {
