Project := class: Location {
  static Dependency := class ("@", path: (!" ")[]) => {
    name => .path.split("/").last as String
    // PRJ2 a dependency's name is not the last segment of its path
    assert ("@ether/Time" as Project.Dependency).(
      .name == "Time"  // PRJ3 the name of `@ether/Time` is not "Time"
      & .path == "ether/Time"  // PRJ4 the path of a dependency keeps the "@" or leaves out a segment
      & !(.name == "ether")  // PRJ5 the name of a dependency is its first segment
    )

    // (where it is: bundled with the language, at a URL, a language's own project, or a path; at a version, `@x %v0.1.4-E2027.0A.4`, only
    // with @ether/version-control)
    project: Project? => (Program(code: ("@", .path)){O: {
      @ether/{bundled_path: Path} => Project.known(Project.bundled(bundled_path) ?? (@ether / bundled_path) as Project)
      @{scheme: Char.Word[]}://{remainder: Path} => Project.known(((scheme + "://" + remainder) as Location) as Project)
      @{name: (Char.Word | "-" | "+")[]{Project.named(.) != None}} => Project.named(name)
      @{local_path: Path} => Project.known((local_path as Location) as Project)
    }}()).load
  }

  static known (found: Project?) => found && (Project#{. == found}.first ?? (found ~~ (static.# ??= []).push .))
  assert Project.known(None) == None  // PRJ1 nothing found is a project
  static declared => Project#{.loaded || .loading}.map(.dependencies).flatten
  static declares (name: String) => Project.declared.find(.name == name)
  static holding (location: Location) => Project#{(location.@ as Path) ~= ⊢(.@ as Path + "/")}.max((.@ as Path).count)
  // a project bundled with the language (`@ether/ui`), and one named by a language's own (`@web`)
  static bundled (path: String) => (("ether/ray" as Location) | ("ether" as Location))#.map(. / path){(. / ".project.ray") as boolean}.first as Project
  static named (name: String) => Project#{.name == name}.first
    ?? Project.known(Project.bundled("$/" + name)) -- (found => found ~~ (.name = name) ~~ .load if found)
  assert Project.named("web").loaded  // PJ2 a language in a mutual dependency is not loaded
  // A project and a language it bundles may depend on each other; each is loaded once
  assert (Project.known(Project.bundled("ui")).load).(
    .loaded && !.loading  // PJ1 a project bundling a language that depends back on it does not finish loading
    & Project.named("web").installed.some(=== .)  // PJ3 a mutual dependency loads a second copy of the project it comes back to
  )
  static data (location: Location) => Project.holding(location) -- (held => held && !(held is (("ether/ray" as Location) | ("ether" as Location))#) && !((location.@ as Path) ~= ".ray" ⊣))

  name: String?
  description: String?
  dependencies: Dependency[] = []
  loading := false
  loaded := false

  shadowing => (.parent, .dependencies.project)#
  sources => .children**{!(. is Directory) && .name ~= ".ray" ⊣ && .name != ".project.ray" && (.parent == this || !((.parent / ".project.ray") as boolean))}
  load: static => .loaded || .loading ? this : this ~~ (.loading = true) ~~ .sources.for(Program(code: . as String)()) ~~ (.loaded = true) ~~ .loading = false
}

@{name: (Char.Word | "-" | "+")[]{Project.declares(.)}} ^string => Project.declares(name).project
@{name: (Char.Word | "-" | "+")[]{Project.declares(.)}}/{path: Path} ^string => Project.declares(name).project / path
