say {x} =>
  @me/instance = x
a := @made Node
b := @made Node
s := a | b
say s.superposes
say ((s.components.head.value) === a)
A := class { v: Node }
B := class: A { }
x := A(a)
y := B(a)
say (x is A)
say (y is A)
say (x is B)
Small := A{.v === a}
say (x is Small)
z := A(b)
say (z is Small)
o := A?
say (None is o)
say (x is o)
