}
// Keys (`level keys …`): a key's pattern (its `key`, else it), whether it is led by text (begins with a literal) and by
// what byte, whether a pattern's literals all occur in a text; the rules moved from one node to another (all but the
// first two, and those catching all, `moved_keys`); how many rules there are around a context (`keys_version`).
Keys := class {
  static led_by_text (p: Pattern) => (p is Pattern) && ((p.kind == literally) || ((p.kind == in_sequence) && Keys.sequence_led(p.a)))
  static sequence_led (l: List) => (l.count != 0) && Keys.led_by_text(at(l, 0))
  static lead_byte (p: Pattern) => (p.kind == literally) ? Keys.text_lead(p.a) : ((p.kind == in_sequence) ? Keys.sequence_lead(p.a) : (0 - 1))
  static text_lead (t: Text) => (t.to == t.from) ? (0 - 1) : byte(t.from)
  static sequence_lead (l: List) => (l.count == 0) ? (0 - 1) : Keys.lead_byte(at(l, 0))
  static literals_in (p: Pattern, a, e) => (p is Pattern) ? ((p.kind == literally) ? occurs(p.a, a, e) : ((p.kind == in_sequence) ? Keys.sequence_in(p.a, a, e) : 1)) : 1
  static sequence_in (l: List, a, e) => {
    i := 0
    while i < l.count {
      return 0 if Keys.literal_missing(at(l, i), a, e)
      i = i + 1
    }
    1
  }
  static literal_missing (c: Pattern, a, e) => (c is Pattern) && (c.kind == literally) && (occurs(c.a, a, e) == 0)
  static moved_keys (g, p) => Keys.keys_moved_into(keys(member(g, Symbol.rules)), Keys.emptied(keys(member(p, Symbol.rules))), member(g, Symbol.rules))
  static emptied (l: List) => {
    touched(l)
    l.count = 0
    l
  }
  static keys_moved_into (lg: List, lp, rules) => {
    lv := list()
    i := 0
    while i < lg.count {
      Keys.key_moved(lv, lp, at(lg, i), i)
      i = i + 1
    }
    define(rules, Symbol.keys, lv)
    keys_moved()
    int(Texts.count_of(lp))
  }
  static key_moved (lv, lp, x, i) => (i < 2) ? append(lv, x) : ((Members.catches_all(topattern(member(x, Symbol.key))) == 0) ? append(lp, x) : 0)
}
// Caches (`level cached …`, removable: each what it caches, again): of a node's rules, the keys that can read a text
// (`keys_reading`: those led by its first byte or by a hole, whose literals all occur in it), by the node's own index of
// its keys by what leads each (`leads`, kept on the node as its keys grow).
Caches := class {
}
// Pairs (`level paired …`): which bytes pair, learned from a capture's uses (`open close`, the bytes just around each,
// neither white nor of a word: the same both a quote, else an opening and a closing bracket);
// whether a pair is open before a place; where a block,
// opened at the end of a line, is closed by a line beginning with a closing.
Pairs := class {
  static paired (t: Text, cap: Text, home) => ((t is Text) && (cap is Text)) ? Pairs.paired_by(t, cap, Splices.opening_end_at(cap.from, cap.to)) : None
  static paired_by (t: Text, cap: Text, oe) => ((oe == cap.from) || ((oe + 1) >= cap.to)) ? None : Pairs.paired_in(t, cap, oe)
  static paired_in (t: Text, cap: Text, oe) => {
    q := t.from
    while q < t.to {
      q = (at_text(q, t.to, cap.from, oe) != 0) ? Pairs.pair_at(t, cap, oe, q, Splices.found_from(q + (oe - cap.from), t.to, oe + 1, cap.to)) : (q + 1)
    }
    None
  }
  static pair_at (t: Text, cap: Text, oe, q, r) => (r >= t.to) ? t.to : Pairs.pair_after(t, cap, q, r + (cap.to - (oe + 1)))
  static pair_after (t: Text, cap: Text, q, r) => {
    Pairs.pair_between(cap, (((byte(q - 1) == byte(cap.to - 1)) && ((q - 4) >= t.from)) ? Pairs.quoted_in(q - 4, byte(q - 1)) : byte(q - 1)), (((byte(r) == byte(cap.from)) && ((r + 4) <= t.to)) ? Pairs.quoted_in(r, byte(r)) : byte(r))) if (q > t.from) && (r < t.to)
    r
  }
  // (a quoted byte, `'x'`, around a capture: the byte quoted)
  static quoted_in (h, c) => ((byte(h + 1) == byte(h + 3)) && (char_class(byte(h + 1)) == 2)) ? byte(h + 2) : c
  static pair_between (cap: Text, b, c) => {
    ((b == c) ? Pairs.pair_set(b, 2) : (((char_class(b) == 0) && (char_class(c) == 0)) ? Pairs.both_set(b, c) : 0)) if (white(b) == 0) && (white(c) == 0) && (word_byte(b) == 0) && (word_byte(c) == 0) && (b != byte(cap.to - 1)) && (c != byte(cap.from))
    0
  }
  static both_set (b, c) => {
    Pairs.pair_set(b, 1)
    Pairs.pair_set(c, 3)
  }
  static pair_set (c, k) => {
    class_put(c, k)
  }
  // (a capture's opening an opening bracket, unless it is of a class already, and its closing's last byte a closing)
  static closing (cap: Text) => (cap is Text) ? Pairs.closing_by(cap, Splices.opening_end_at(cap.from, cap.to)) : 0
  static closing_by (cap: Text, oe) => {
    Pairs.closing_set(cap) if (oe > cap.from) && ((oe + 1) < cap.to)
    0
  }
  static closing_set (cap: Text) => {
    class_put(byte(cap.from), 1) if char_class(byte(cap.from)) == 0
    class_put(byte(cap.to - 1), 3)
  }
  static opener (c) => (c == 40) || (c == 91) || (c == 123)
  static closer (c) => (c == 41) || (c == 93) || (c == 125)
  static open_before (a, n) => {
    q := a
    while q < n {
      q = Pairs.past_pair(q, n, Runtime.class_at(q))
    }
    (q > n) ? 1 : 0
  }
  static past_pair (q, n, k) => ((k == 1) || (k == 2)) ? Pairs.pair_within(pair_end(q), n) : (q + 1)
  static pair_within (r, n) => ((r == 0) || (r > n)) ? (n + 1) : r
  static block_closed (a, n) => {
    d := 0
    q := a
    while q < textend {
      return 0 if (q >= n) && (d <= 0)
      return Pairs.spaces_past(q) + 1 if Pairs.closed_here(Pairs.spaces_past(q), d, n)
      d = Pairs.opened_after(q, Runtime.line_end(Pairs.spaces_past(q)), Pairs.closed_at(Pairs.spaces_past(q), d))
      q = Runtime.line_end(Pairs.spaces_past(q)) + 1
    }
    0
  }
  static closed_at (f, d) => ((f < textend) && (char_class(byte(f)) == 3)) ? (d - 1) : d
  static closed_here (f, d, n) => (f >= n) && (f < textend) && (char_class(byte(f)) == 3) && ((d - 1) == 0)
  static opened_after (q, l, d) => ((Pairs.spaces_back(q, l) > q) && (pair_class(Pairs.spaces_back(q, l) - 1) == 1)) ? (d + 1) : d
  static spaces_past (q) => {
    f := q
    while (f < textend) && ((byte(f) == 32) || (byte(f) == 9)) {
      f = f + 1
    }
    f
  }
  static spaces_back (q, l) => {
    f := l
    while (f > q) && ((byte(f - 1) == 32) || (byte(f - 1) == 9)) {
      f = f - 1
    }
    f
