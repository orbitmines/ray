mark ^keyword := external global

goto z_ok if zero.is_zero.holds
INFO@mark `N1 zero is not zero`
z_ok\

goto o_bad if one.is_zero.holds
goto o_ok
o_bad\
INFO@mark `N2 one reports zero`
o_ok\

goto e1_ok if (one + two) == three
INFO@mark `N3 1 + 2 is not 3`
e1_ok\

goto e2_ok if (three - one) == two
INFO@mark `N4 3 - 1 is not 2`
e2_ok\

goto e3_ok if (one - three) == zero
INFO@mark `N5 1 - 3 does not floor at zero`
e3_ok\

goto e4_ok if (two * three) == six
INFO@mark `N6 2 * 3 is not 6`
e4_ok\

goto e5_ok if (one < two).holds
INFO@mark `N7 1 < 2 is false`
e5_ok\

goto e6_bad if (two < one).holds
goto e6_ok
e6_bad\
INFO@mark `N8 2 < 1 is true`
e6_ok\

goto e7_ok if (six / two) == three
INFO@mark `N9 6 / 2 is not 3`
e7_ok\

goto e8_ok if (seven % three) == one
INFO@mark `N10 7 % 3 is not 1`
e8_ok\

goto e9_ok if four.even.holds
INFO@mark `N11 4 is not even`
e9_ok\

goto e10_ok if five.odd.holds
INFO@mark `N12 5 is not odd`
e10_ok\

goto e11_ok if (two.max(five)) == five
INFO@mark `N13 max failed`
e11_ok\

// `pow` and `factorial` are defined but not asserted yet: a recursive call
// used as an argument does not resolve.

goto p4_bad if three.even.holds
goto p4_ok
p4_bad\
INFO@mark `3 is even`
p4_ok\

counter ^keyword := zero
three times { counter = counter.succ }
goto p5_ok if counter == three
INFO@mark `times did not run three times`
p5_ok\

goto q7_ok if Base.Hexadecimal.radix == (ten + six)
INFO@mark `N20 hexadecimal radix is not sixteen`
q7_ok\

minus_two := two.as_integer.negated
goto q8_ok if minus_two.negative.holds
INFO@mark `N21 negation is not negative`
q8_ok\

goto q9_ok if (minus_two + five.as_integer) == three.as_integer
INFO@mark `N22 -2 + 5 is not 3`
q9_ok\

goto q10_ok if (minus_two * minus_two) == four.as_integer
INFO@mark `N23 -2 * -2 is not 4`
q10_ok\

goto q11_ok if (minus_two < one.as_integer).holds
INFO@mark `N24 -2 < 1 is false`
q11_ok\
