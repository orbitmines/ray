// Fossil's artifacts and its repository database (https://fossil-scm.org/home/doc/trunk/www/fileformat.wiki, https://fossil-scm.org/home/doc/trunk/www/delta_format.wiki)
Fossil := class: Language {
  static extensions = ".fossil"
  static fidelity = Language.Fidelity.snapshot

  Hash := Hexadecimal⁴⁰ | Hexadecimal⁶⁴
  hashed (bytes: Byte[]): Hash => SHA3.write(bytes) as Byte³² as Hexadecimal⁶⁴
  digest (text: String) => MD5.write(text as Byte[]) as Byte¹⁶ as Hexadecimal³²

  Escaped := class: String (((!" " && !\n && !"\\") | ("\\s" as " ") | ("\\n" as \n) | ("\\\\" as "\\"))[])
  Date := class (year: Decimal⁴, "-", month: Decimal², "-", day: Decimal², "T", hour: Decimal², ":", minute: Decimal², ":", second: Decimal², (".", fraction: Decimal³)?) {
    when: Time => (year + "-" + month + "-" + day + "T" + hour + ":" + minute + ":" + second) as Time
    static (time: Time) as (=== Date) => Date(year: time.year, month: time.month, day: time.day, hour: time.hour, minute: time.minute, second: time.second, fraction: time.millisecond)
  }

  Manifest := class (
    ("B ", baseline: Hash, \n)?,
    "C ", comment: Escaped, \n,
    "D ", date: Date, \n,
    files: ("F ", name: Escaped, (" ", hash: Hash, (" ", permissions: ("x" | "l" | "w"))?, (" ", old: Escaped)?)?, \n)[],
    ("N ", mimetype: Escaped, \n)?,
    ("P ", parents: (Hash, (" ", Hash)[]), \n)?,
    cherrypicks: ("Q ", ("+" | "-"), picked: Hash, (" ", Hash)?, \n)[],
    ("R ", sum: Hexadecimal³², \n)?,
    tags: Tag[],
    "U ", user: Escaped, \n,
    "Z ", checksum: Hexadecimal³², \n
  ) {
    static permissions = { executable: "x", link: "l" }
    valid => checksum == digest((this as String)[..<-35])
    branch => tags.find(.kind == "*" && .name ~= ⊢"sym-")?.name[4..]
  }

  Tag := class ("T ", kind: ("+" | "-" | "*"), name: Escaped, " ", target: (Hash | "*"), (" ", value: Escaped)?, \n)
  Control := class ("D ", date: Date, \n, tags: Tag[], "U ", user: Escaped, \n, "Z ", checksum: Hexadecimal³², \n)

  Delta := class (target: Count, \n, instructions: (Copy | Insert)[], checksum: Count, ";") {
    static Copy := class (length: Count, "@", from: Count, ",")
    static Insert := class (length: Count, ":", bytes: Byte[]{count == length})
    applied (base: Byte[]) => instructions.map(. is Copy ? base[.from..<.from + .length] : .bytes).flatten
    static between (base: Byte[], target: Byte[]) => Delta(target: target.count, instructions: Encoding.runs(base, target).map(run => run.bytes ? Insert(length: run.bytes.count, bytes: run.bytes) : Copy(length: run.count, from: run.from)), checksum: Fossil.checksum(target))
  }
  static checksum (bytes: Byte[]) => bytes.chunk(4).map(word => (word, [0] * (4 - word.count)) as Binary³²).sum % 2^32

  Count := class: Number (digits: ("0".."9" | "A".."Z" | "_" | "a".."z" | "~")[]) {
    static alphabet = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz~"
  }

  Stored := class (size: Binary³², deflated: Byte[]) {
    bytes => deflated as Zlib -- .inflated
    static (bytes: Byte[]) as (=== Stored) => Stored(size: bytes.count, deflated: bytes as Zlib as Byte[])
  }

  Store := class = root: Location {
    database => SQLite.read(root)
    blobs => database.blob
    deltas => database.delta
    content (row) => (row.content as Stored).bytes -- (bytes => deltas.find(.rid == row.rid) -- (delta => delta ? (bytes as Delta).applied(content(blobs.find(.rid == delta.srcid))) : bytes))
    artifact (hash: Hash) => blobs.find(.uuid == hash) -- (row => row ? content(row) : None)
    manifests => blobs.map(row => content(row) as Manifest -- (manifest => (hash: row.uuid, manifest) if manifest?.valid))#
    controls => blobs.map(row => content(row) as Control)#{. != None}
    recorded (hash: Hash) => controls.tags.flatten.find(.name == "ray" && .target == hash)?.value

    tree (manifest: Manifest) => Language.Entry.of(manifest.files{.hash}.map(file => (path: file.name, content: artifact(file.hash), mode: Manifest.permissions.find(.value == file.permissions)?.key ?? Language.Entry.Mode.file)))
    revisions => manifests.sort_by(.manifest.date.when).map(found => History.Revision(
      id: found.hash, tree: tree(found.manifest), parents: found.manifest.parents ?? [],
      who: Character.local(found.manifest.user) ?? found.manifest.user, when: found.manifest.date.when, message: found.manifest.comment,
      recorded: recorded(found.hash), renames: found.manifest.files{.old}.map((from: .old, to: .name))))

    history => History.reading(revisions) -- (reading => Repository(location: root) -- (repository => repository
      ~~ (.histories = manifests.group(.manifest.branch ?? "trunk").map((name, tips) => History(repository, head: reading.commits[tips.last.hash], name)))
      -- History(repository, head: reading.commits[revisions.last.id], name: "trunk")))
  }

  Written := class = history: History, revisions: History.Revision[] {
    manifest (revision: History.Revision, parents: Hash[]) => (
      "C ", revision.message as Escaped, \n,
      "D ", revision.when as Date, \n,
      revision.tree.files.sort_by(.path).map(file => ("F ", file.path as Escaped, " ", hashed(file.content), (" " + Manifest.permissions[file.mode]) if Manifest.permissions[file.mode],
        (" " + (revision.renames.find(.to == file.path).from as Escaped)) if revision.renames.some(.to == file.path), \n)),
      ("P ", parents.join(" "), \n) if parents.nonempty,
      ("T *branch * " + ((history.name ?? "trunk") as Escaped) + \n, "T *sym-" + ((history.name ?? "trunk") as Escaped) + " *" + \n) if parents.empty,
      "U ", (revision.who?.name ?? revision.who as String) as Escaped, \n
    ) as String -- (text => text + "Z " + digest(text) + \n)
    manifests => revisions.reduce(made = {} => made, {(.id): manifest(., .parents.map(parent => hashed(made[parent] as Byte[])))})
    notes => revisions{.recorded}.map(revision => ("D ", revision.when as Date, \n, "T +ray ", hashed(manifests[revision.id] as Byte[]), " ", revision.recorded as Escaped, \n, "U ", (revision.who?.name ?? revision.who as String) as Escaped, \n) as String -- (text => text + "Z " + digest(text) + \n))
    artifacts => (revisions.tree.files.content, manifests.values.map(. as Byte[]), notes.map(. as Byte[])).flatten.unique(hashed(.))
    bases: (Byte[]?)[] => artifacts.map(None)
    stored (artifact: Byte[], base: Byte[]?) => (base ? Delta.between(base, artifact) as Byte[] : artifact) as Stored as Byte[]
    database => SQL.Database(tables: {
      blob: artifacts.map(artifact => (rid: artifact.index + 1, rcvid: 1, size: artifact.count, uuid: hashed(artifact), content: stored(artifact, bases[artifact.index]))),
      delta: bases.map(base => (rid: base.index + 1, srcid: artifacts.index_of(base) + 1) if base)#
    })
    files => [(path: "", content: database as Byte[])]
  }

  static level := {
    {at: Location} => Store(root: at)
    {store: Store} => store.history
  }

  static written := {
    {writing: Language.Writing{value is History}} => Written(history: writing.value, revisions: History.revisions(writing.value))
    {written: Written} => Language.Entry.of(written.files)
  }

  static stored := {
    {written: Written}.bases => written.artifacts.map(artifact => written.artifacts[artifact.index - 1] -- (base => base if artifact.index > 0 && (Delta.between(base, artifact) as Byte[]).count < artifact.count))
  }
}
