@x25519
@sha512

// Edwards-Curve Digital Signature Algorithm, Ed25519 (https://www.rfc-editor.org/rfc/rfc8032)
Ed25519 := class: Encoding.Signing {
  static extensions := ".ed25519"

  // The field GF(2^255 - 19) is X25519's (RFC 7748 §4.1); the curve constant d = -121665/121666 and the order L of the base point (RFC 8032 §5.1)
  static d := (X25519.p - 121665) * X25519.inverse(121666) % X25519.p
  static L := 2 ^ 252 + 27742317777372353535851937790883648493
  static I := X25519.power(2, (X25519.p - 1) / 4)

  // A point of -x^2 + y^2 = 1 + d x^2 y^2, added by the complete twisted Edwards formula (RFC 8032 §5.1.4)
  static Point := class x: Number, y: Number {
    static neutral := Point(x: 0, y: 1)
    assert Ed25519.B * Ed25519.L == Ed25519.Point.neutral  // EDS7 the base point times its order is not the neutral point
    + (other: Point) => d * x * other.x * y * other.y % X25519.p -- (t => Point(
      x: (x * other.y + other.x * y) * X25519.inverse(1 + t) % X25519.p,
      y: (y * other.y + x * other.x) * X25519.inverse(X25519.p + 1 - t) % X25519.p))
    * (n: Number) => n.digits(2).reduce(held = neutral => held + held + (. == 1 ? this : neutral))
    == (other: Point) => x == other.x && y == other.y

    // Encoding: y in 255 bits little-endian, the low bit of x in the top bit (RFC 8032 §5.1.2)
    as (=== Byte[]) => Encoding.little(y + x % 2 * 2 ^ 255, 32)
    // Decoding: y, then x from x^2 = (y^2 - 1) / (d y^2 + 1) by the square root of §5.1.1, its sign from the top bit (RFC 8032 §5.1.3)
    static (bytes: Byte₃₂) as (=== Point) => {
      y = Encoding.little_number(bytes) % 2 ^ 255
      sign = (Encoding.little_number(bytes) / 2 ^ 255).floor
      u = (y * y + X25519.p - 1) * X25519.inverse(d * y * y + 1) % X25519.p
      root = X25519.power(u, (X25519.p + 3) / 8) -- (. * . % X25519.p == u ? . : . * I % X25519.p)
      return ERROR `the bytes are not a point of Ed25519` if y >= X25519.p || root * root % X25519.p != u || root == 0 && sign == 1
      Point(x: root % 2 == sign ? root : (X25519.p - root) % X25519.p, y)
    }
  }

  // The base point: y = 4/5 and x even (RFC 8032 §5.1)
  static B := Encoding.little(4 * X25519.inverse(5) % X25519.p, 32) as Point
  // The base point decodes to y = 4/5 and encodes back; L B is the neutral point (RFC 8032 §5.1)
  assert (Ed25519.B as Byte[]) as Ed25519.Point == Ed25519.B  // EDS6 the base point does not read back as itself

  // The secret's SHA-512, its first half pruned as X25519's scalar (RFC 8032 §5.1.5, RFC 7748 §5)
  static expanded (secret: Byte₃₂) => SHA512.write(secret).bytes -- (h => (scalar: X25519.clamped(h[..<32]), prefix: h[32..]))
  static reduced (bytes: Byte[]) => Encoding.little_number(SHA512.write(bytes).bytes) % L

  // The public key: the base point times the pruned scalar (RFC 8032 §5.1.5)
  static public (secret: Byte₃₂) => (B * expanded(secret).scalar) as Byte[]
  // TEST 1: the secret key, its public key, and the signature of the empty message (RFC 8032 §7.1)
  assert {
    ed_secret := "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60" as Hexadecimal₆₄ as Byte₃₂
    ed_public := "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a" as Hexadecimal₆₄ as Byte₃₂
    ed_signature := "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b" as Hexadecimal₁₂₈ as Byte₆₄
    assert Ed25519.public(ed_secret) == ed_public  // EDS1 the public key of RFC 8032's test 1 is not d75a9801…
    assert Ed25519.sign(ed_secret, []) == ed_signature  // EDS2 the empty message does not sign as e5564300… in RFC 8032's test 1
    assert Ed25519.verify(ed_public, [], ed_signature)  // EDS3 the signature of RFC 8032's test 1 does not verify
    assert !(Ed25519.verify(ed_public, [0x72], ed_signature))  // EDS4 a signature verifies for another message
    assert !(Ed25519.verify(ed_public, [], [ed_signature[..<63], ed_signature[63] ~x|| 0x01].flatten))  // EDS5 a changed signature verifies
    // A key pair names its algorithm, and what it signs is read back only where the signature holds
    ed_pair := Ed25519.pair(ed_secret)
    assert ed_pair.algorithm === Ed25519 && ed_pair.public == ed_public  // EDS8 a key pair forgot its algorithm or its public half
    assert Ed25519.read(ed_pair.signed("abc".bytes)) == "abc".bytes  // EDS9 what a key signed does not read back
    assert Ed25519.read(ed_pair.signed("abc".bytes) ~~ .value = "abd".bytes) is Diagnostic  // EDS10 a signed value that was changed reads back
    assert Ed25519.public(ed_secret_2) as Hexadecimal₆₄ == "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"  // EDS11 the public key of RFC 8032's test 2 is not 3d4017c3…
    assert Ed25519.sign(ed_secret_2, ed_message_2) as Hexadecimal₁₂₈ == "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"  // EDS12 the message of RFC 8032's test 2 does not sign as 92a009a9…
    assert Ed25519.verify("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c" as Hexadecimal₆₄ as Byte₃₂, ed_message_2, "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00" as Hexadecimal₁₂₈ as Byte₆₄) && !Ed25519.verify("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c" as Hexadecimal₆₄ as Byte₃₂, [ed_message_2, [0]].flatten, "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00" as Hexadecimal₁₂₈ as Byte₆₄)  // EDS13 the signature of RFC 8032's test 2 does not verify, or verifies a longer message
    assert Ed25519.public(ed_secret_3) as Hexadecimal₆₄ == "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"  // EDS14 the public key of RFC 8032's test 3 is not fc51cd8e…
    assert Ed25519.sign(ed_secret_3, ed_message_3) as Hexadecimal₁₂₈ == "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"  // EDS15 the message of RFC 8032's test 3 does not sign as 6291d657…
    assert Ed25519.verify("fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025" as Hexadecimal₆₄ as Byte₃₂, ed_message_3, "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a" as Hexadecimal₁₂₈ as Byte₆₄) && !Ed25519.verify("fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025" as Hexadecimal₆₄ as Byte₃₂, [ed_message_3, [0]].flatten, "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a" as Hexadecimal₁₂₈ as Byte₆₄)  // EDS16 the signature of RFC 8032's test 3 does not verify, or verifies a longer message
    assert Ed25519.public(ed_secret_abc) as Hexadecimal₆₄ == "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf"  // EDS17 the public key of RFC 8032's test SHA(abc) is not ec172b93…
    assert Ed25519.sign(ed_secret_abc, ed_message_abc) as Hexadecimal₁₂₈ == "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704"  // EDS18 the message of RFC 8032's test SHA(abc) does not sign as dc2a4459…
    assert Ed25519.verify("ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf" as Hexadecimal₆₄ as Byte₃₂, ed_message_abc, "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704" as Hexadecimal₁₂₈ as Byte₆₄) && !Ed25519.verify("ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf" as Hexadecimal₆₄ as Byte₃₂, [ed_message_abc, [0]].flatten, "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704" as Hexadecimal₁₂₈ as Byte₆₄)  // EDS19 the signature of RFC 8032's test SHA(abc) does not verify, or verifies a longer message
  }

  // Signing: r from the prefix and the message, R = rB, S = r + H(R, A, M) s mod L (RFC 8032 §5.1.6)
  static sign (secret: Byte₃₂, message: Byte[]) => expanded(secret) -- (key => reduced([key.prefix, message].flatten) -- (r => (B * r) as Byte[] -- (R =>
    [R, Encoding.little((r + reduced([R, public(secret), message].flatten) * key.scalar) % L, 32)].flatten)))

  // Verifying: S < L and SB = R + H(R, A, M) A, the equation without the cofactor, which §5.1.7 allows
  static verify (public: Byte₃₂, message: Byte[], signature: Byte₆₄) => Encoding.little_number(signature[32..]) -- (s =>
    s < L && B * s == (signature[..<32] as Point) + (public as Point) * reduced([signature[..<32], public, message].flatten))
}
