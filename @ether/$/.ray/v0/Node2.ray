^keyword external external
^keyword external global
// Optimistically unordered: If there's a non-circular dependency chain, it will remain ordered.
^keyword external unordered
^keyword external inline
^keyword external literal

namespace LSP {
  class SemanticToken {
    enum Type < namespace | type | class | enum | interface | struct | typeParameter | parameter | variable | property | enumMember | event | function | method | macro | keyword | modifier | comment | string | number | regexp | operator | decorator
    enum Modifier < declaration | definition | readonly | static | deprecated | abstract | async | modification | documentation | defaultLibrary  
  }
}

^keyword external theme
external ^ : {
  {literal} => 
  {: LSP.SemanticToken.Type} =>
  #{: RGB.Hexadecimal} =>
}

DARK = theme `Ether.ray - Dark` {
  // Based off https://github.com/simurai/duotone-dark-syntax
  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^namespace = ^type = ^class = ^enum = ^interface = ^struct = ^event = ^U2
  ^typeParameter = ^parameter = ^U0
  ^variable = ^property = ^enumMember = ^U1
  ^function = ^method = ^decorator = ^U4 
  ^macro = ^U2
  ^keyword = ^modifier = ^comment = ^U3
  ^string = ^number = ^regexp = ^D2
  ^operator = ^U4

  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CC0000
  ^warning = ^ #CCCC00
  ^info = ^ #0000CC
  ^debug = ^ #00CC00
  ^trace = ^comment
}
inline DARK

^keyword external report

base class Diagnostic {
  
}

// Wrapping of errors with additional information? 
// Non-allowed variables within errors are traced. And dont get sent over pipelines which arent allowed to view them.
// Autoreturn if failed?
// &:= for errors and things to say stack all the errors together if that is used.
// Errors like OOM What to do/
// Access function context of the error?

^fatal   FATAL{^punctuation `@`}{var} (^comment comment: String) report FATAL var comment 
^error   ERROR{^punctuation `@`}{var} (^comment comment: String) report ERROR var comment 
^warning  WARN{^punctuation `@`}{var} (^comment comment: String) report WARN var comment 
^info     INFO{^punctuation `@`}{var} (^comment comment: String) report INFO var comment 
^debug   DEBUG{^punctuation `@`}{var} (^comment comment: String) report DEBUG var comment 
^trace   TRACE{^punctuation `@`}{var} (^comment comment: String) report TRACE var comment 

// Mark String type with literal.
^string.punctuation `{^string literal string}` => string
^comment //{literal comment} => TODO

^punctuation {`{`}{expr}{`}`} => TODO
^punctuation ({expr}) => expr
^punctuation [{expr}] => expr

unordered ^keyword base{ }class{ }{literal ^class name}{ }{block} => (
  ^class (external get global name) = external .
  ^keyword static = external .
  ({inline args}) => (
    ^keyword this = external .
    ^keyword staic = external get global name
    inline block
    
    this
  )
  inline block
  
  static
)

class Program {
  // `func(args)`
  ({inline args}) => (
    local = external .
    inline this
  )
  // `func args`
  { }{expr} => this(expr)
}

base class Node {
  static DEFINE_METHOD = `=`

  external unordered ^punctuation {(^function \w | `{`, ^parameter expr, `}`)[]}{ }=>{body}

  external =

  ^punctuation .{literal ^property property} => this[property]
  ^punctuation {\n}.{literal ^property property} => this[property]

  // Function definition
  unordered ^punctuation { }({^parameter args}){block} => (^function this) [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def
  )

  ^punctuation [{^property property}] => external get this property

  test () TODO
  test2 (parameter) TODO2
}

// Set the actual method used for function definitions.
Node.DEFINE_METHOD = `&=`