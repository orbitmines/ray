assert {
  missing_file := () => {
    ERROR `not 0`
    7
  }
  // ER14 a non-fatal error replaced the value the function answers
  assert missing_file() == 7
  // ER15 an error does not know the function it came from
  assert missing_file().diagnostics.last.origin == missing_file
  stopping := () => {
    FATAL `cannot go on`
    7
  }
  // ER16 a fatal error is not what the function answers
  assert stopping() is Diagnostic
  // ER17 a handler for errors from one function did not take them
  assert (missing_file()
    $missing_file 8) == 8
  // ER18 a handler for another function's errors took them
  assert (missing_file()
    $stopping 8) == 7
  NotFound := class
  looking := () => {
    ERROR@NotFound `no such page`
    3
  }
  // ER19 an error of a type is not caught by that type
  assert (looking()
