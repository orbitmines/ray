  assert indexed_at(true).index  // NA9 a named argument's value was not read where it was written (a test failed, nothing said)
  Paired_named := class (left, right) => { }
  paired_of (a, b) => Paired_named(left: a, right: b)
  assert paired_of(true, false).left  // NA10 named arguments given a function's parameters do not give the fields
  assert Paired_named(left: true, right: false).left  // NA11 named arguments given values do not give the fields
  Defaulting := class (first, second = false) => { }
  assert Defaulting(first: true, second: true).second  // NA13 a field's default replaced what was given it by name
  assert Defaulting(second: true, first: false).second  // NA14 fields given by name in another order kept their defaults
  defaulting_of (given) => Defaulting(first: true, second: given)
