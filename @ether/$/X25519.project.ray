// Elliptic Curves for Security, X25519 (https://www.rfc-editor.org/rfc/rfc7748)
X25519 := class: Encoding.Agreement {
  static extensions := ".x25519"
  // The field GF(2^255 - 19), its inverses by Fermat's little theorem (RFC 7748 §4.1, §5)
  static p := 2 ^ 255 - 19
  static power (base, exponent, modulus = p) => exponent.digits(2).reduce(held = 1 => held * held * (. == 1 ? base : 1) % modulus)
  static inverse (x) => power(x, p - 2)
  // decodeScalar25519: the low three bits and the top bit cleared, the next highest set (RFC 7748 §5)
  static clamped (bytes: Byte₃₂) => (Encoding.little_number(bytes) ~&& (2 ^ 254 - 8)) + 2 ^ 254

  // One rung of the Montgomery ladder: (x2, z2) doubled, (x3, z3) added to it, with a24 = 121665 (RFC 7748 §5)
  static stepped (x2, z2, x3, z3, x1) => {
    a = x2 + z2
    b = x2 + p - z2
    da = (x3 + p - z3) * a % p
    cb = (x3 + z3) * b % p
    aa = a * a % p
    bb = b * b % p
    (aa * bb % p, (aa + p - bb) * (aa + 121665 * (aa + p - bb)) % p, (da + cb) ^ 2 % p, x1 * (da + p - cb) ^ 2 % p)
  }
  // The ladder from bit 254 down, the pairs swapped where k has a 1, and x2 / z2 at the end (RFC 7748 §5)
  static ladder (k: Number, u: Number) => (254..0).reduce(held = (1, 0, u, 1) => (k / 2 ^ .).floor % 2 == 1
    ? stepped(held[2], held[3], held[0], held[1], u) -- (.[2], .[3], .[0], .[1])
    : stepped(held[0], held[1], held[2], held[3], u)
  ) -- (.[0] * inverse(.[1]) % p)

  // The scalar clamped, the u-coordinate without its top bit (decodeUCoordinate) (RFC 7748 §5)
  static x25519 (k: Byte₃₂, u: Byte₃₂) => Encoding.little(ladder(clamped(k), Encoding.little_number(u) % 2 ^ 255), 32)
  // One scalar times one u-coordinate (RFC 7748 §5.2, the first vector)
  assert X25519.x25519("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4" as Hexadecimal₆₄ as Byte₃₂, "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c" as Hexadecimal₆₄ as Byte₃₂) as Hexadecimal₆₄ == "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552"  // XDH1 the first scalar of RFC 7748 §5.2 does not multiply to c3da5537…

  // The public key is the scalar times u = 9; the shared secret is one's scalar times the other's public key, refused when it is all zeros (RFC 7748 §6.1)
  static public (secret: Byte₃₂) => x25519(secret, Encoding.little(9, 32))
  // Alice and Bob: their public keys, and the secret they share (RFC 7748 §6.1)
  assert {
    xa := "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a" as Hexadecimal₆₄ as Byte₃₂
    xb := "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb" as Hexadecimal₆₄ as Byte₃₂
    assert X25519.public(xa) as Hexadecimal₆₄ == "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"  // XDH2 Alice's public key is not that of RFC 7748 §6.1
    assert X25519.public(xb) as Hexadecimal₆₄ == "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"  // XDH3 Bob's public key is not that of RFC 7748 §6.1
    assert X25519.agreed(xa, X25519.public(xb)) as Hexadecimal₆₄ == "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"  // XDH4 Alice does not derive the shared secret of RFC 7748 §6.1
    assert X25519.agreed(xb, X25519.public(xa)) == X25519.agreed(xa, X25519.public(xb))  // XDH5 Bob and Alice derive different secrets
    assert X25519.agreed(xa, [0] * 32) is Diagnostic  // XDH6 a public key of zeros gives a shared secret
    // A key pair names its algorithm and agrees with another pair's public half
    xpa := X25519.pair(xa)
    xpb := X25519.pair(xb)
    assert xpa.algorithm === X25519 && xpa.agreed(xpb.public) == xpb.agreed(xpa.public)  // XDH7 two key pairs do not agree on one secret
  }
  static agreed (secret: Byte₃₂, other: Byte₃₂) => x25519(secret, other) -- (. == [0] * 32 ? ERROR `the other public key gives an all-zero shared secret` : .)
}
