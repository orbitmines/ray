IO := class {
  read (path) => (external io path None).as_string
  write (path, content) => external io path content
  os (name) => (external os name).as_string
  platform => IO.os(`platform`)
  architecture => IO.os(`architecture`)
  File := class {
    path: Node

    content => IO.read(.path)
    bytes => .content.collected
  }
}

Random := class {

  bit => if ((external random)) { 1 } else { 0 }
  bits (count: Number) => (
    drawn := chain None
    left ^keyword := count
    while left {
      drawn &= Random.bit
      left = left.pred
    }
    drawn
  )

  below (limit: Number) => (
    width ^keyword := 0
    rest ^keyword := limit
    while rest {
      rest = rest.half
      width = width.succ
    }
    drawn ^keyword := Random.number(width)
    while (drawn < limit).not { drawn = Random.number(width) }
    drawn
  )

  number (width: Number) => (
    total ^keyword := 0
    left ^keyword := width
    while left {
      total = total + total
      if Random.bit { total = total.succ }
      left = left.pred
    }
    total
  )
}

Choice := class {
  choose (from) => from.random
  choose_count (from, count: Number) => (
    picked := chain None
    left ^keyword := count
    while left {
      picked &= from.random
      left = left.pred
    }
    picked
  )
  coin => Random.bit
}

Proof := class {
  Proposition := class {
    holds: Node

    negated => Proof.Proposition(holds: .holds.not)
  }
  proposition: Node
  argument: Node

  holds => .argument.holds

  theorem (proposition, proof) => if proof.holds { true } else { Quest(name: "prove", goal: proposition) }
  by_contradiction (proposition, proof_of_negation) => proof_of_negation.holds.not
  rfl (proposition) => proposition.holds
  assume (fact) => fact
}

Transaction := class {
  forwards: Node
  backwards: Node
  applied: false

  reversed => Transaction(forwards: .backwards, backwards: .forwards, applied: .applied)
  mark_applied => (
    .applied = true
    this
  )
  Inverse := enum plus (of: `+`, is: `-`) | minus (of: `-`, is: `+`) | times (of: `*`, is: `/`) | over (of: `/`, is: `*`)
}

Network := class {
  DomainName := class {
    text: String

    valid => .text.count.nonzero.and(.text.count < 256)
  }
  Proxy := class {
    through (persona) => Network.Proxy(persona: persona)
  }
  Protocol := class {
    version => UUID.Namespace.dns
    handshake (offered) => offered
  }
}

HTTP := class {
  get (url) => IO.read(url)
  Method := enum get | post | put | delete
}

Keyboard := class {
  Key := class {
    name: Node
    pressed: false
    toggled: false
    presses: 0

    press => (
      .pressed = true
      this.toggled = .toggled.not
      this.presses = .presses.succ
      this
    )
    release => (
      .pressed = false
      this
    )
    cycle (iterable) => iterable.at(.presses % iterable.count)
    holds => .pressed
    as (=== boolean) => .pressed
  }
  keys: (chain None)

  add (key) => (
    .keys &= key
    this
  )
}

Chat := class {
  messages: (chain None)

  Message := class { }
  say (who, text: String) => (
    .messages &= Chat.Message(who: who, text: text)
    this
  )
  count => .messages.count
}
