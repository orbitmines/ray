^keyword external external
^keyword external global
// Optimistically unordered: If there's a non-circular dependency chain, it will remain ordered.
^keyword external unordered
^keyword external inline
^keyword external literal

external ^namespace
external ^type
external ^class
external ^enum
external ^interface
external ^struct
external ^typeParameter
external ^parameter
external ^variable
external ^property
external ^enumMember
external ^event
external ^function
external ^method
external ^macro
external ^keyword
external ^modifier
external ^comment
external ^string
external ^number
external ^regexp
external ^operator
external ^decorator

^punctuation = ^comment

^string `{literal string}` => string
^comment //{literal comment} => TODO

^punctuation {`{`}{expr}{`}`} => TODO
^punctuation ({expr}) => expr
^punctuation [{expr}] => expr

unordered ^keyword base{ }class{ }{literal ^class name}{ }{block} => (
  ^keyword static = ^class (external get global name) = external .
  ({inline args}) => (
    ^keyword this = external .
    ^keyword static = external get global name
    inline block
    
    this
  )
  inline block
  
  static
)

class Program {
  // `func(args)`
  ({inline args}) => (
    local = external .
    inline this
  )
  // `func args`
  { }{expr} => this(expr)
}

base class Node {
  static DEFINE_METHOD = `=`

  external unordered ^punctuation {(^function \w | `{`, ^parameter expr, `}`)[]}{ }=>{body}

  external =

  ^punctuation .{^property property} => this[property]
  ^punctuation {\n}.{^property property} => this[property]

  // Function definition
  unordered ^punctuation { }({^parameter args}){block} => (^function this) [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def
  )

  ^punctuation [{^property property}] => external get this property

  test () TODO
  test2 (parameter) TODO2
}

// Set the actual method used for function definitions.
Node.DEFINE_METHOD = `&=`