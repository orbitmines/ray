// Secure Hash Standard, the SHA-2 family (https://csrc.nist.gov/pubs/fips/180-4/upd1/final)
SHA2 := class: Encoding.Digest width: 32 | 64, rounds: Number, sums: Number[][], sigmas: Number[][] {
  word => 2 ^ width
  // A block is sixteen words, the digest eight, in bytes (FIPS 180-4 §1)
  block => 2 * width
  size => width

  // Constants: the first bits of the fractional parts of the cube roots of the first primes (FIPS 180-4 §4.2.2, §4.2.3)
  static primes := (2 -> +1){n => (2..<n).every(n % . != 0)}
  K => primes[..<rounds].map(p => (p * 2 ^ (3 * width)).root(3) % word)
  // The first constant and initial word (FIPS 180-4 §4.2.2, §5.3.3)
  assert SHA256.K.first == 0x428a2f98 && SHA256.K.last == 0xc67178f2 && SHA256.K.count == 64  // SHT4 the constants are not the 64 of FIPS 180-4 §4.2.2
  // Initial hash value: the same of the square roots of the first eight primes (FIPS 180-4 §5.3.3, §5.3.5)
  initial => primes[..<8].map(p => (p * 2 ^ (2 * width)).root(2) % word)
  assert SHA256.initial == [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]  // SHT5 the initial hash value is not that of FIPS 180-4 §5.3.3

  // Padding: the message, a 1 bit, zeros, and its length in bits in two words (FIPS 180-4 §5.1.1, §5.1.2)
  padded (message: Byte[]) => [message, 0x80, [0] * ((2 * block - width / 4 - 1 - message.count % block) % block), (message.count * 8) as Binary{length == 2 * width} as Byte[]].flatten

  // ROTR, SHR, Ch, Maj, Σ and σ (FIPS 180-4 §3.2, §4.1.2, §4.1.3)
  rotr (x, n) => ((x as Binary{length == width}).loop >> n) as Number
  Σ (x, (a, b, c)) => rotr(x, a) ~x|| rotr(x, b) ~x|| rotr(x, c)
  σ (x, (a, b, c)) => rotr(x, a) ~x|| rotr(x, b) ~x|| (x / 2 ^ c).floor
  Ch (x, y, z) => (x ~&& y) ~x|| ((word - 1 - x) ~&& z)
  Maj (x, y, z) => (x ~&& y) ~x|| (x ~&& z) ~x|| (y ~&& z)

  // Message schedule (FIPS 180-4 §6.2.2 and §6.4.2, step 1)
  schedule (words: Number[]) => (16..<rounds).reduce(w = words => [w, (σ(w[-2], sigmas[1]) + w[-7] + σ(w[-15], sigmas[0]) + w[-16]) % word])
  // Rounds over a..h, then added to the hash (FIPS 180-4 §6.2.2 and §6.4.2, steps 2–4)
  compressed (h, words: Number[]) => schedule(words).enumerate.reduce(v = h =>
    (v[7] + Σ(v[4], sums[1]) + Ch(v[4], v[5], v[6]) + K[.index] + .value) % word -- (t1 => (Σ(v[0], sums[0]) + Maj(v[0], v[1], v[2])) % word -- (t2 =>
      [(t1 + t2) % word, v[0], v[1], v[2], (v[3] + t1) % word, v[4], v[5], v[6]]))
  ).zip(h).map((a, b) => (a + b) % word)

  written := {
    {writing: Language.Writing} => padded(writing.value as Byte[]).chunk(block).map(.chunk(width / 8).map(. as Binary))
      .reduce(h = initial => compressed(h, .)).map(. as Binary{length == width} as Byte[]).flatten
  }
}

// SHA-256 (FIPS 180-4 §4.1.2, §6.2)
SHA256 := SHA2(extensions: ".sha256", width: 32, rounds: 64, sums: [[2, 13, 22], [6, 11, 25]], sigmas: [[7, 18, 3], [17, 19, 10]])
// One-block message "abc" (FIPS 180-4 example SHA256.pdf, and FIPS 180-2 Appendix B.1)
assert SHA256.write("abc".bytes) as Byte₃₂ as Hexadecimal₆₄ == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"  // SHT1 abc does not digest as in FIPS 180's one-block example
// Two-block message, the 448 bits "abcdbcde…nopq" (FIPS 180-4 example SHA256.pdf, and FIPS 180-2 Appendix B.2)
assert SHA256.write("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes) as Byte₃₂ as Hexadecimal₆₄ == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"  // SHT2 the 448-bit message does not digest as in FIPS 180's two-block example
// The empty message (NIST CAVP SHAVS, SHA256ShortMsg.rsp, Len = 0)
assert SHA256.write([]) as Byte₃₂ as Hexadecimal₆₄ == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"  // SHT3 the empty message does not digest as e3b0c442…
