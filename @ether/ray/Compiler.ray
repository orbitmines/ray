Compiler := class {
  none := {
  }

  folding := {
    {a} + 0 => a
    0 + {a} => a
    {a} * 1 => a
    1 * {a} => a
  }

  default := folding + {
    {a} - 0 => a
    {a} * 0 => 0
    0 * {a} => 0
    {a} / 1 => a
    {a}.unique.unique => a.unique
    {a}.reverse.reverse => a
    {a}.compact.compact => a.compact
    {a}.flatten.flatten => a.flatten
    {a}.sort.sort => a.sort
  }

  logic := {
    !!{a} => a as boolean
    {a} && {a} => a
    {a} || {a} => a
  }

  memoised := {
    remembered := {}
    {f: Pure}({arguments}) => remembered[(f, arguments)] ??= f(arguments)
  }

  minimising := default + logic

  levels => [none, default, folding, logic, minimising, memoised]

  // (a level made of two, `A + B`: reduced by the first, then what that gives by the second)
  static reduced (value, level) => Compiler.composed(level) ? Compiler.reduced(Compiler.reduced(value, level.components.hierarchy.first), level.components.hierarchy.last) : Program(code: { value }){O: level}()
  static composed (level) => (@owns level "components") && (@owns level.components.hierarchy "head")
}

Program &+= {
  O | optimizations := Compiler.none
  compounds + (other: Program) => Program(code: (code, other.code))
}
