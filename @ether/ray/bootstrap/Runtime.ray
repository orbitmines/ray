  static gathered (name, a, e, mark, inner) => Runtime.gathered_as(name, a, e, mark, (Runtime.unnamed_count(mark) < (boundn - mark)) ? Runtime.defined_as(Runtime.defined_as(named_from(mark), 32, text(a, e)), 15, inner) : ((Runtime.unnamed_count(mark) == 0) ? text(a, e) : valued_from(mark)))
  static gathered_as (name, a, e, mark, v) => {
