// What this interpreter's own kinds of value are, for now: a number (a JS number) and text (a JS string), their operations
// the host's (`goto js`: the next statement is JS, `self` the value read on, each hole its value, `$(text)` text read here).
// A port of `js.kinds.ray` to test with until the library reads numbers and text itself; read after the language.

// Numbers, as written: a digit (`Digit`'s own rules), digits, digits with a fraction (`Number`'s own rules: a typed hole
// `{n: Number}` takes what they read; what it took is read in `Number`). Read anywhere through the rule after them.
Digit := class { }
Digit &+= {
  0 =>
    goto js
    0
  1 =>
    goto js
    1
  2 =>
    goto js
    2
  3 =>
    goto js
    3
  4 =>
    goto js
    4
  5 =>
    goto js
    5
  6 =>
    goto js
    6
  7 =>
    goto js
    7
  8 =>
    goto js
    8
  9 =>
    goto js
    9
}
// (digits after one another: what a number is written as, its own (the library adds to `Number`, not to it))
Digits := class { }
Digits &+= {
  {digit: Digit} =>
    digit
  {digit: Digit}{rest: Digits} =>
    goto js
    Number($.text('digit') + $.text('rest'))
}
Number &+= {
  {digits: Digits} =>
    digits
  {whole: Digits}.{fraction: Digits} =>
    goto js
    Number($.text('whole') + '.' + $.text('fraction'))
}
{number: Number} =>
  number

// What both answer: `true`/`false`, read here.
== {other} =>
  goto js
  $(self === other ? 'true' : 'false')
!= {other} =>
  goto js
  $(self !== other ? 'true' : 'false')
< {other} =>
  goto js
  $(self < other ? 'true' : 'false')
<= {other} =>
  goto js
  $(self <= other ? 'true' : 'false')
> {other} =>
  goto js
  $(self > other ? 'true' : 'false')
>= {other} =>
  goto js
  $(self >= other ? 'true' : 'false')

// Numbers (text added to: joined; anything else, composed).
+ {other} =>
  goto js
  typeof self === 'string' ? self + String(other) : typeof self === 'number' ? self + other : undefined
  .composed({other})
- {other} =>
  goto js
  self - other
* {other} =>
  goto js
  self * other
/ {other} =>
  goto js
  self / other
% {other} =>
  goto js
  ((self % other) + other) % other

// Text (`""`: none).
"" =>
  goto js
  ''
contains {other} =>
  goto js
  $(String(self).includes(String(other)) ? 'true' : 'false')
split({separator}) =>
  goto js
  typeof self === 'string' ? $('[' + self.split(String(separator)).map(part => JSON.stringify(part)).join(', ') + ']') : undefined
count =>
  goto js
  typeof self === 'string' ? [...self].length : undefined
reads_text {text} =>
  goto js
  typeof text === 'string' && $.whole(text, self) ? $(text) : $('None')
headed {{header}} =>
  goto js
  (function (header) { const open = String.fromCharCode(123), close = String.fromCharCode(125), quote = String.fromCharCode(34), pieces = [], fields = []; let depth = 0, quoted = 0, start = 0; for (let i = 0; i <= header.length; i++) { const c = header.charCodeAt(i); if (quoted) { if (c === quoted) quoted = 0; continue; } if (c === 34 || c === 96) { quoted = c; continue; } if (c === 40 || c === 91 || c === 123) depth++; else if (c === 41 || c === 93 || c === 125) depth--; else if (i === header.length || (c === 44 && depth === 0)) { pieces.push(header.slice(start, i).trim()); start = i + 1; } } let head = '', literal = false; for (const piece of pieces) { const q = piece.charCodeAt(0); if ((q === 34 || q === 96) && piece.length > 1 && piece.charCodeAt(piece.length - 1) === q) { for (const ch of piece.slice(1, -1)) head += ch === open || ch === close ? open + String.fromCharCode(96) + ch + String.fromCharCode(96) + close : ch; literal = true; continue; } if (!/^[\p{Ll}_][\p{L}\p{N}_]*$/u.test(piece)) return undefined; head += open + piece + close; fields.push(quote + open + piece + close + quote); } return literal ? $(head + ' ' + String.fromCharCode(61, 62) + String.fromCharCode(10) + '  ' + String.fromCharCode(91) + fields.join(', ') + String.fromCharCode(93)) : undefined; })($.text('header').trim().replace(/^[(]|[)]$/g, ''))

// What a number or text is made of: Number, String (a node's own `of` is read before this).
of =>
  goto js
  typeof self === 'number' ? $('Number') : typeof self === 'string' ? $('String') : undefined
  None

// Ranges of numbers: `a..<b` (up to b, not it), `a..b` (with it), going down when b is below a (of anything else, none).
..{last} =>
  goto js
  typeof self === 'number' && typeof last === 'number' ? $('[' + Array.from({ length: Math.abs(last - self) + 1 }, (_, i) => self + (last >= self ? i : -i)).join(', ') + ']') : $('None')
..<{last} =>
  goto js
  typeof self === 'number' && typeof last === 'number' ? $('[' + Array.from({ length: Math.abs(last - self) }, (_, i) => self + (last >= self ? i : -i)).join(', ') + ']') : $('None')
..<{ }{last} =>
  . ..<({last})
..{ }{last} =>
  . ..({last})
