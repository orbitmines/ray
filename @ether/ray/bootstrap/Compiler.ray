  static put_aside (at, se) => {
    append(Turns.aside_list(), text(at, se))
    se
  }
  static aside_list => (aside_or_none() == None) ? Turns.aside_made() : aside_or_none()
  static aside_made => {
    l := statements_aside()
    frames_kept()
    l
