{name} := class: {parent} ({fields}) {`=>`} {`{`}{block}{`}`} ^class => {name} := (class: {parent} ({fields}) => { {block} })
// (a member of an instance, then an operator: the operator read on the member's value, not on the instance)
assert {
  Carrying := class (carried) => {
    again => .carried
  }
  assert Carrying(true).carried === true  // CI1 a field given true is not true
  assert Carrying(`a`).carried == `a`  // CI6 a field given a text is not that text (an argument read only as a word)
  assert Carrying(Carrying(false)).carried.carried === false  // CI2 a field's field is not what it was given
  carrier := Carrying(true)
  assert carrier.again === true  // CI3 a method of an instance held in a name does not answer its field
  Holding_class := class (held) => {
    static Inner := class (inner) => {
      own => .inner
    }
  }
  assert Holding_class.Inner(true).own  // CI7 a class called as a member of another made one of that other (`this` the class it is a member of)
