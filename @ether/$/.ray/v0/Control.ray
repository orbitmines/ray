Running := class = program: Program, at: Program?, started: boolean = false, results: *[] = [] {
  static branches: Running[] = []
  static deferred: Running[] = []

  & => results
  steps | expand => program.written
  is_initial | waiting => !started
  is_terminal | final => started && !at
  intermediate => started && !is_terminal
  holds => !is_terminal

  stepped => {
    at = started ? at.next : steps.first
    started = true
    results.push at() if at
  } -- this
  next => Running(program, at, started, results: [results]).stepped
  finished => (stepped while holds) -- this
  cancel => (at, started = None, true) -- this

  static round => branches{holds}.map(.stepped)
  static until (condition) => (round while !condition() && branches.some(.holds)) -- this
}

dynamically {name} = {value} ^keyword => external rule name value
dynamically {name} := {value} ^keyword => external rule name value
dynamically if{ }{cond}{ }{block} ^keyword => Dynamic(program: () => if cond block)
dynamically{ }{value} ^keyword => Dynamic(program: Program(code: external ** value))
Dynamic := class = program: Program {
  .{literal property ^property} ^punctuation => .declaring(property) ? external get this property : external get program() property
  as (=== boolean) => program() as boolean
}
dynamically assert {conditions} ^keyword => Program(code: external ** conditions).written{!.()} -- .for(ERROR@. `assertion failed`) -- .empty

Never := Node{false}
never return ^keyword => Never
