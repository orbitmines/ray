forward :=
forward unordered
forward ^{literal word ^ word}{ }

external  ^external := external external
global    ^keyword := external global

unordered ^keyword := external unordered
inline    ^keyword := external inline
literal   ^keyword := external literal
theme     ^keyword := external theme
report    ^keyword := external report
forward   ^keyword := external forward
None      ^keyword := external none

`{literal string ^string}` ^string.punctuation => string
//{literal comment?} ^comment => None

{`{`}{expr ^block}{`}`} ^punctuation => (
  held := external ** expr
  external extend held Program
  held
)
({expr}) ^punctuation => expr
[{expr}] ^punctuation => (
  listed ^keyword := expr
  unless (exists expr.listing) {
    listed = chain None
    external extend listed Listed
    listed &= expr
  }
  listed
)
[[{inner}]] ^punctuation => (
  nested ^keyword := chain None
  external extend nested Listed
  nested &= [inner]
  nested
)

goto{ }{literal target ^label} ^class => external goto target global
goto{ }{literal target ^label}{ }if{ }{condition} ^class => external goto target condition
unordered {literal label ^label}\ ^punctuation => external label label

return{ }{value} ^keyword => (
  value
  goto return\
)

RGB := class {
  Hexadecimal := class { }
}

^: {
  {literal}: () => A
  {: LSP.SemanticToken.Type}: () => A
  #{: RGB.Hexadecimal}: () => A
} ^punctuation := external ^
^{ }{literal color: RGB.Hexadecimal ^ color} => external ^ color

chain (holder) => (
  links ^keyword := external .
  instance := global
  owner := holder
  head := None
  tail := None
  external extend links Chain

  links ^namespace
)

link (holds, before) => (
  entry ^keyword := external .
  instance := global
  value := holds
  previous := before
  next := None
  external extend entry Link

  entry ^namespace
)

unordered class:{ }{header}{`{`}{members?}{`}`} ^keyword => (
  written_header ^keyword := external ** header
  shape ^keyword := header
  goto structured if shape.listing
  made ^keyword := (class { inline members }): header
  goto shaped
 structured\
  made = class {
    positions := (inline (external ** header))
    written_structure := written_header
    structure => .written_structure
    inline members
  }
 shaped\
  made.written_body = external ** members
  made
)

unordered class{ }{block} ^keyword => (
  static ^keyword := external .
  static.instance = None
  static.components = chain None
  static.components.hierarchy = chain static
  static.written_body = external ** block
  static.classes_read = None
  static.requirements_read = None
  written_as ^keyword => static.written_body**
  super ^keyword => (
    parent := static.components.hierarchy.tail.value
    instance := this
    view ^keyword := external .
    external extend view parent
    external extend view instance

    view
  )
  inline block

  ({inline args}) => (
    static ^keyword := this
    this ^keyword := external .
    this.components = chain None
    this.components.hierarchy = chain this
    this.components.hierarchy &= static
    this.instance = global
    inline block

    this ^variable
  )

  static ^class
)

unordered base{ }class{ }{body} ^keyword => (
  static := class { inline body }

  external base static
  
  static
)

Node := base class {

  {(String ^function | `{`, expr ^parameter, `}` | `[`, operator ^operator, `]`)[] head}{ }=>{body} ^punctuation => (
    rest := head.head
   leading\
    goto named if rest.next
    goto defining
   named\
    goto asked if rest.value.named
    goto defining
   asked\
    goto kind if rest.value.named.modify
    goto defining
   kind\
    rest = rest.next
    goto leading
   defining\
    definition := external GRAMMAR_RULE rest body
    rest = head.head
   modifying\
    goto more if rest.next
    goto defined
   more\
    goto again if rest.value.named
    goto defined
   again\
    goto modify if rest.value.named.modify
    goto defined
   modify\
    rest.value.named.modify(definition)
    rest = rest.next
    goto modifying
   defined\

    definition
  )

  , ^punctuation ^separator => this

  ; ^punctuation (x) => inline x
  listing => None

  static DEFINE_METHOD = `=`

  ({args ^parameter}){ }=>{ }{block} ^punctuation => (this ^function) [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def
  )

  , ^punctuation (other) => (
    listed ^keyword := chain None
    external extend listed Listed
    listed &= this
    listed &= other
    listed
  )
  -- ^punctuation (call) => call(this)
  
  = ^punctuation (x) => (
    external assign this x

    this
  )
  := ^punctuation (x) => (
    external declare this x

    this
  )
  : ^punctuation ^annotation (type) => (
    goto typed if (external own this)
    goto absent if (None.instance_of(type))
    external declare this type
    goto done
   absent\
    external declare this None
    goto done
   typed\

    goto done if type.instance

    goto holding if this
    goto done
   holding\

    goto held if this.instance
    this.components.hierarchy &= type
    goto done if this.written_body
   held\
    type.verify(this)
   done\

    this
  )

  ?? ^punctuation (other) => (
    chosen ^keyword := this
    unless (exists chosen) { chosen = other }
    chosen
  )
  ? ^punctuation => this | None
  ?: ^punctuation (type) => this: (type?)

  instance_of (type) => (
    found ^keyword := None
    goto mine if this
    goto no if type.instance
    goto scan if type.components
    goto no
   scan\
    walker ^keyword := type.components.head
   step\
    goto present if walker
    goto no
   present\
    goto skip if walker.value
    goto yes
   skip\
    walker = walker.next
    goto step
   mine\
    found = structurally(this, type)
    goto admitted if found
    goto alternatives if type.components
    goto no
   alternatives\

    other ^keyword := type.components.head
   alternative\
    goto try_alternative if other
    goto no
   try_alternative\
    found = structurally(this, other.value)
    goto admitted if found
    other = other.next
    goto alternative
   admitted\
    found = type.admits(this).holds
    goto no
   yes\
    found = global
   no\

    found
  )

  accepts ^reader (text) => text
  structure ^structure => None

  satisfies (predicate) => (inline predicate)

  verify (candidate) => candidate

  admits (candidate) => true

  {this}{`{`}{literal narrowing}{`}`} ^punctuation => (
    narrowed ^keyword := this
    selected ^keyword := None
    if (exists narrowed.instance) {
      selected = chain None
      narrowed for {
        held := it.value
        if (held.satisfies({ inline narrowing })) { selected &= held }
      }
    } else {
      selected = class: narrowed {

        accepts (text) => (
          candidate := narrowed.accepts(text)
          if (exists candidate) { if (candidate.satisfies({ inline narrowing })) { candidate } else { None } } else { None }
        )
        verify (candidate) => (
          narrowed.verify(candidate)
          unless (candidate.satisfies({ inline narrowing })) { ERROR@candidate `does not satisfy a constraint of its type` }

          candidate
        )
        admits (candidate) => if (narrowed.admits(candidate)) { candidate.satisfies({ inline narrowing }) } else { false }
        if (exists this.instance) { selected.verify(this) }
      }
    }

    selected
  )

  {this}<{literal partial ^parameter}> ^punctuation => (
    narrowed ^keyword := this

    class: narrowed { inline partial }
  )

  ~~ ^punctuation (x) => (
    inline x

    this
  )

  ** ^punctuation => (
    held ^keyword := external ** this
    external extend held Program

    held
  )

  &= ^punctuation (x) => (
    value := x
    previous := this.tail
    added := link value previous
    goto more if previous
    this.head = added
    goto linked
   more\
    previous.next = added
   linked\
    this.tail = added
    goto owned if this.owner
    goto done
   owned\
    holder := this.owner
    external extend holder value
   done\

    this
  )

  | ^punctuation (other) => (
    superposed ^keyword := external .
    superposed.instance = None
    superposed.components = chain None
    external extend superposed this
    goto superpose_each if this.components.head
    superposed.components &= this
    goto superpose_other
   superpose_each\
    alternative ^keyword := this.components.head
   superpose_step\
    goto superpose_copy if alternative
    goto superpose_other
   superpose_copy\
    superposed.components &= alternative.value
    alternative = alternative.next
    goto superpose_step
   superpose_other\
    superposed.components &= other

    superposed
  )

  . ^punctuation => this
  .{literal property ^property} ^punctuation => this[property]
  {\n}.{literal property ^property} ^punctuation => this[property]

  [{property ^property}] ^punctuation => external get this property

 
  test5 => TODO
  test4 a => TODO
  test (a) => {
    TODO
  }
  test2 test: () => ReturnType, ReturnType -- = DEFAULT_FUNC => ActualReturnType => {

  }
  test3 (paramater2) => TODO
}

Node.DEFINE_METHOD = `&=`

Modifier := class {
  kind => TODO
  modify (definition) => (
    unless (exists definition.components) {
      definition.components = chain None
      definition.components.hierarchy = chain None
    }
    definition.components.hierarchy &= this
    definition
  )
}
chainable ^keyword := class: Modifier {
  chains => TODO
}
compounds ^keyword := class: Modifier {
  compounds => TODO
}

Chain := class {
  entry => .head
}

Listed := class {
  listing => global
  , ^punctuation (other) => (
    this &= other
    this
  )
}
Link := class { }

if := class {
  { }{cond}{ }{yes} ^class => (
    branch ^keyword := external .
    inline static
    taken := None

    goto enter if cond.holds
    goto skip
   enter\
    taken = global
    result := inline (external ** yes)
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )

  elsif{ }{cond}{ }{block} ^class => (
    branch ^keyword := external .
    inline this
    taken := .taken

    goto skip if taken
    goto enter if cond.holds
    goto skip
   enter\
    taken = global
    result := inline (external ** block)
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )

  {\n}elsif{ }{cond}{ }{block} ^class => this elsif cond block
  {\n}else{ }{block} ^class => this else block

  else{ }{block} ^class => (
    branch ^keyword := external .
    inline this
    taken := .taken

    goto skip if taken
    taken = global
    result := inline (external ** block)
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )
}

unless{ }{cond}{ }{block} ^class => (
  asked ^keyword := if cond { }
  held ^keyword := asked.taken
  answered ^keyword := asked else block
  goto open if held
  goto done
 open\
  answered.taken = None
 done\

  answered
)

while := class {
  { }{cond}{ }{block} ^class => (
    loop ^keyword := external .
    inline static
    written_block := external ** block

   again\
    goto more if cond.holds
    goto done
   more\
    inline written_block
    goto again
   done\

    loop ^variable
  )

  { }{block}{ }while{ }{cond} ^class => (
    written_block := external ** block
    inline written_block

    this cond block
  )
}

do ^keyword := while

{condition} ? {yes} : {no} => (
  chosen ^keyword := no
  if condition { chosen = yes }
  chosen
)

dynamically ^keyword (x) => (inline x)

assert ^keyword (condition) => (
  unless condition { ERROR@condition `assertion failed` }

  condition
)

unordered enum ^keyword => (

  static := class {
    {literal member ^enumMember} ^punctuation => (
      entry := this(name: member)
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    {literal member ^enumMember}{ }{fields ^property} ^punctuation => (
      entry := this(
        name: member
        inline fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember} ^punctuation => (
      entry := this(name: member)
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember}{ }{fields ^property} ^punctuation => (
      entry := this(
        name: member
        inline fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )

    chainable == (other) => (
      same ^keyword := false
      if ((exists .name).and(exists other.name)) {
        same = same_text(.name, other.name)
      } else {
        same = same_text((external where this), (external where other))
      }
      same
    )
  }

  static ^enum
)

unordered enum{ }{literal member ^enumMember}{ }{fields? ^property}{ }{literal rest?}{ }{`{`}{block?}{`}`} ^keyword => (
  static ^keyword := external .
  inline enum
  inline block

  entry := static(
    name: member
    inline fields
  )
  entry.name = member
  static[member] = entry ^enumMember
  static.components &= entry
  inline rest

  static ^enum
)

Program := class: Iterable {

  optimizations => global.O
  O => .optimizations
  {this}{`{`}{literal setting}{`}`} ^punctuation => class: this { inline setting }

  written => (
    out := chain None
    left ^keyword := this
    one ^keyword := external first left
    while (exists one) {
      external extend one Program
      out &= one
      left = external rest left
      one = external first left
    }
    out
  )
  entry => .written.entry
  first => .written.first
  last => .written.last
  count => .written.count
  empty => .count.is_zero
  for (body) => (
    .written for body
    this
  )

  compounds + (addend) => (
    augend ^keyword := this
    {
      inline augend
      inline addend
    }
  )

  ({inline args}) => (
    local ^keyword = external .
    inline this
  )

  { }{expr} => this(expr)
}

LSP := {
  SemanticToken := class {
    Type := enum namespace | type | class | enum | interface | struct | typeParameter | parameter | variable | property | enumMember | event | function | method | macro | keyword | modifier | comment | string | number | regexp | operator | decorator
    Modifier := enum declaration | definition | readonly | static | deprecated | abstract | async | modification | documentation | defaultLibrary
  }
}

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^type = ^class = ^enum = ^interface = ^struct = ^event = ^enumMember = ^U2
  ^typeParameter = ^parameter = ^U0
  ^variable = ^property = ^U1
  ^function = ^method = ^decorator = ^U4 
  ^macro = ^U2
  ^keyword = ^modifier = ^comment = ^U3
  ^string = ^number = ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment
}
inline DARK

Diagnostic := class {
  
}

FATAL{`@` ^punctuation}{var} ^fatal (comment: String ^comment) => report FATAL var comment 
ERROR{`@` ^punctuation}{var} ^error (comment: String ^comment) => report ERROR var comment 
 WARN{`@` ^punctuation}{var} ^warn  (comment: String ^comment) => report WARN var comment 
 INFO{`@` ^punctuation}{var} ^info  (comment: String ^comment) => report INFO var comment 
DEBUG{`@` ^punctuation}{var} ^debug (comment: String ^comment) => report DEBUG var comment 
TRACE{`@` ^punctuation}{var} ^trace (comment: String ^comment) => report TRACE var comment 

TODO ^debug (comment: String ^comment) => DEBUG@. comment 

{l} [x: right-to-left] {m} [y: left-to-right] {r} => l [x] m & m [y] r

{a} [x: chainable] {b} [y: chainable] {c} => (a [x] b) & (b [y] c)

{a} [x: compounds]{`=`} {b} => a = (a [x] b)
