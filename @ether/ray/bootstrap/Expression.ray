      return 0 if Indexes.none_after(x + ((257 + 4097) * 4), word_of(x + (byte(l.from + i) * 4)), word_of(x + ((byte(l.from + i) + 1) * 4)), a, e)
      i = i + 1
    }
    1
  }
  static none_after (p, lo, hi, a, e) => Indexes.none_from(p, Indexes.first_from(p, lo, hi, a), hi, e)
  static none_from (p, j, hi, e) => (j >= hi) || (word_of(p + (j * 4)) >= e)
  static based_pairs (x, g, l: Text, a, e) => {
