  static byte_out (o, q) => {
    byte_put(o, byte(q))
    copied_from(o, q, 1)
  }
  // (a text that is one capture whole: its name taken, trimmed)
  static spliced_whole (t: Text, cap: Text, oe, l) => ((at_text(t.from, t.to, cap.from, oe) != 0) && ((t.to - (cap.to - (oe + 1))) >= (t.from + (oe - cap.from))) && (at_text(t.to - (cap.to - (oe + 1)), t.to, oe + 1, cap.to) != 0)) ? Splices.whole_taken(Splices.whole_or_single(Splices.whole_doubled(t, cap, oe, l), t, cap, oe, l)) : None
  static whole_doubled (t: Text, cap: Text, oe, l) => ((at_text(t.from + (oe - cap.from), t.to, cap.from, oe) != 0) && ((t.to - ((cap.to - (oe + 1)) * 2)) >= (t.from + ((oe - cap.from) * 2))) && (at_text(t.to - ((cap.to - (oe + 1)) * 2), t.to, oe + 1, cap.to) != 0)) ? take_named(t.from + ((oe - cap.from) * 2), t.to - ((cap.to - (oe + 1)) * 2), l, cap.from, oe, cap.to) : 0
  static whole_or_single (x, t: Text, cap: Text, oe, l) => (x != 0) ? x : take_named(t.from + (oe - cap.from), t.to - (cap.to - (oe + 1)), l, cap.from, oe, cap.to)
