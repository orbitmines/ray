mark ^keyword := global

// A location is what is held there: mentioned and used as anything else it is read, `@x = value` writes it,
// `@x = None` removes it, `@new = @x` copies it, and a directory's children are what is under it.
with @me/device/os = OS.Ether {
  @./ethertest/a = "x"
  unless @./ethertest/a as String == "x" { INFO@mark `ETH1 what is written on ether is not read back` }
  unless (@./ethertest).children.map(.@) == [(@./ethertest/a).@] { INFO@mark `ETH2 a location on ether does not list what was written under it` }
  @./ethertest/b = @./ethertest/a
  unless @./ethertest/b as String == "x" { INFO@mark `FS3 a location assigned another is not a copy of what is held there` }
  @./ethertest/a = None
  if @./ethertest/a { INFO@mark `ETH3 a location removed on ether is still there` }
  unless (@./ethertest/a).@ as String == "./ethertest/a" { INFO@mark `FS4 a location's own location is not where it was written` }
}

// A Windows drive is a file location, not a URL with the scheme "C".
unless (@C:/Windows/Fonts).@ as String == "C:/Windows/Fonts" { INFO@mark `FS1 a Windows drive path is not read as written` }
unless (@C:/Windows/Fonts).holder === (@/usr/share).holder { INFO@mark `FS2 a Windows drive is not held like any other file path` }
