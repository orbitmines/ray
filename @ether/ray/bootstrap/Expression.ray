// Indexes (`level indexed …`, removable: each a cache of what it answers): whether a text occurs in another (by the
// bytes and byte pairs in it, and over the program's text or the text taken, an index of where each byte and pair is,
// sorted, searched by halves); where a pair that opens at a place ends (`pair_end`, by place, the classes' version);
// whether a part is held outside brackets (`holds_outside`).
Indexes := class {
  static occurs (l: Text, a, e) => ((l.to - l.from) == 0) ? 1 : ((((e - a) > 64) && in_program(a, e)) ? Indexes.occurs_based(Indexes.based_index(program_from(), program_from() + program_length(), 3960), program_length(), l, a, e) : ((((e - a) > 64) && Indexes.in_taken(a, e, takent)) ? Indexes.occurs_taken(l, a, e, takent) : Indexes.found_at(l, a, e)))
  static in_taken (a, e, t: Text) => (t != 0) && (a >= t.from) && (e <= t.to)
  static occurs_taken (l, a, e, t: Text) => Indexes.occurs_based(Indexes.based_index(t.from, t.to, 3952), t.to - t.from, l, a, e)
  static pair_hash (q) => ((byte(q - 1) * 31) + byte(q)) & 4095
  static found_at (l: Text, a, e) => {
