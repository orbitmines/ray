Network.components.hierarchy &= class {
  Port := Number{. < 65536}

  Protocol := class {
    name: String
    port: Node

    ether => Network.Protocol(name: "ether", port: 37839)
    https => Network.Protocol(name: "https", port: 443)
    http => Network.Protocol(name: "http", port: 80)
    ssh => Network.Protocol(name: "ssh", port: 22)
    known => (
      all := chain None
      all &= Network.Protocol.ether
      all &= Network.Protocol.https
      all &= Network.Protocol.http
      all &= Network.Protocol.ssh
      all
    )
    named (written: String) => (
      found ^keyword := None
      Network.Protocol.known for { if (it.value.name == written) { found = it.value } }
      found
    )
    version => Network.Handshake.version
  }

  URL := class {
    protocol: Node
    host: Node
    port: Node
    path: ""
    query: ""

    parse (text: String) => (
      scheme := text.before("://")
      rest ^keyword := text.after("://")
      if rest.empty { rest = text }
      found_protocol := Network.Protocol.named(scheme)
      authority := rest.before("/")
      path_written := rest.after("/")
      host_written := authority.before(":")
      port_written := authority.after(":")
      chosen_port ^keyword := None
      if port_written.nonempty { chosen_port = port_written.as_number } elsif (found_protocol === None) { chosen_port = None } else { chosen_port = found_protocol.port }
      Network.URL(protocol: found_protocol, host: Network.Hosts.resolved(host_written), port: chosen_port, path: path_written.before("?"), query: path_written.after("?"))
    )
    as_string => .protocol.name + ("://" + (.host.text + (":" + (.port.as_string + ("/" + .path)))))
  }

  Socket := class {
    Address := class {
      host: Node
      port: Node
    }
  }

  Hosts := class {
    equivalences: (chain None)

    equate (name: String, host: String) => (
      Network.Hosts.equivalences &= Network.Hosts.Equivalence(name: name.fold_case, host: host)
      host
    )
    resolved (name: String) => (
      found ^keyword := None
      Network.Hosts.equivalences for { if (it.value.name == name.fold_case) { found = it.value.host } }
      if (found === None) { Network.DomainName(text: name) } else { Network.DomainName(text: found) }
    )
    Equivalence := class {
      name: String
      host: String
    }
  }

  DNS := class {
    history: (chain None)

    record (name: String, address, key) => (
      Network.DNS.history &= Network.DNS.Record(name: name, address: address, key: key, when: Time.now)
      address
    )
    trusted (name: String, address, key) => (
      known ^keyword := None
      Network.DNS.history for { if (it.value.name == name) { known = it.value } }
      if (known === None) { true } else { known.key == key }
    )
    Record := class {
      name: String
      address: Node
      key: Node
      when: Node
    }
  }

  Proxied := class {
    proxy: Node
    everything: true
    who: None
    block: None

    carries (traffic, character) => if .everything { true } elsif (.who === None) { .block.contains(traffic) } else { .who == character }
  }

  Handshake := class {
    version => 0
    offer (versions) => (
      agreed ^keyword := None
      versions for { if (it.value == Network.Handshake.version) { agreed = it.value } }
      if (agreed === None) { Quest(name: "agree on a version", goal: versions) } else { agreed }
    )
  }

  Remote := class {
    location: Node
    character: Node

    run (code) => if (.character.key === None) { Quest(name: "authorise", goal: code) } else { Network.Remote.Execution(code: code, as: .character, at: .location) }
    fresh (code) => Network.Remote(location: .location, character: Character(name: "unauthorised")).run(code)
    Execution := class {
      code: Node
      as: Node
      at: Node
    }
  }

  Challenge := class {
    message: Node
    due: Node
    answered: false

    answer (response) => (
      if (Time.now < .due) { .answered = response == .message }
      .answered
    )
  }

  Stream := class {
    player: Node
    location: Node
    watchers: (chain None)

    watch (character) => (
      .watchers &= character
      character.presence = .location
      this
    )
    moved (location) => (
      .location = location
      .watchers for { it.value.presence = location }
      this
    )
  }

  Update := class {
    from: Node
    into: Node

    apply => (
      conflicts := .into.merge(.from)
      if conflicts.empty { .into } else { conflicts }
    )
  }

  Shard := class {
    character: Node
    locations: (chain None)

    store (part, location) => (
      .locations &= Network.Shard.Part(part: part, location: location)
      this
    )
    Part := class {
      part: Node
      location: Node
    }
  }
}

Instance.components.hierarchy &= class {
  address: None
  localhost => "localhost"
  seen_from (other) => if (other === this) { .localhost } else { .address }
  mac_address => (
    written := external os `mac_address`
    if written { written } else {
      octets := Random.number(48)
      multicast := (octets / 1099511627776) % 2
      octets + ((1 - multicast) * 1099511627776)
    }
  )
}

Network.Hosts.equivalences = chain None
Network.DNS.history = chain None
Network.Hosts.equate("ether", "ether.orbitmines.com")
