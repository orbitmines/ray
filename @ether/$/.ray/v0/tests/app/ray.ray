mark ^keyword := external global

a := Ray()
b := Ray(previous: a)

unless (a.is_initial) { INFO@mark `RR1 a lone ray is not initial` }

unless (a.nonempty) { INFO@mark `RR2 a lone ray counts as empty` }

if (b.is_initial) { INFO@mark `RR3 a linked ray reports initial` }

unless (b.initial == a) { INFO@mark `RR4 the initial walk failed` }

unless (a.count == 1) { INFO@mark `RR5 a lone ray does not count one` }

unless (a.terminal == a) { INFO@mark `RR6 a lone ray is not its own terminal` }

// The smaller of a ray and itself is that ray. `min` binds its answer before
// handing it back: two rays are the same only when they are the same one, and
// a branch holding a ray is not the ray it holds.
unless ((b.min(b)) == b) { INFO@mark `RR7 the smaller of a ray and itself is not that ray` }
unless ((b.max(b)) == b) { INFO@mark `RR8 the larger of a ray and itself is not that ray` }
if ((if false { b } else { b }) == b) { INFO@mark `RR9 a branch holding a ray is that ray` }

c := Ray(previous: b)
// A ray's previous and next are its own: linking one way does not link back.
a.next = b
b.next = c
unless ((a.at(2)) == c) { INFO@mark `R8 at(2) did not reach the third ray` }

seen ^keyword := 0
a for { seen = seen.succ }
unless (seen == 3) { INFO@mark `R9 for did not visit three rays` }

unless (a every { it.nonempty }) { INFO@mark `R10 every failed` }

unless (a some { it.is_terminal }) { INFO@mark `R11 some failed` }

unless (a.initial_boundary.is_initial) { INFO@mark `R12 initial boundary is not initial` }

unless (a.terminal_boundary.edge.is_terminal) { INFO@mark `R13 the edge of a terminal boundary is not terminal` }

unless (a.acyclic) { INFO@mark `R14 a chain is not acyclic` }

// Boundaries and edges: which end a boundary is, and which ends an edge has.
start := Boundary.Initial()
finish := Boundary.Terminal()
unless (start.is_initial) { INFO@mark `R15 an initial boundary is not initial` }
if (start.is_terminal) { INFO@mark `R16 an initial boundary is terminal` }
unless (finish.is_terminal) { INFO@mark `R17 a terminal boundary is not terminal` }
if (finish.is_initial) { INFO@mark `R18 a terminal boundary is initial` }
span := Edge(from: start, to: finish)
unless (exists span.from) { INFO@mark `R19 an edge forgot where it starts` }
unless (exists span.to) { INFO@mark `R20 an edge forgot where it ends` }
if (span.is_initial) { INFO@mark `R21 an edge that starts somewhere is initial` }
if (span.is_terminal) { INFO@mark `R22 an edge that ends somewhere is terminal` }

// What a structure allows.
unless (Structure().is_valid) { INFO@mark `R23 a structure is not valid` }
if (Structure().hyper_edges) { INFO@mark `R24 a plain structure has hyper edges` }
unless (Hypergraph().hyper_edges) { INFO@mark `R25 a hypergraph has no hyper edges` }

// A chain: what it holds, in the order it was given, and how it is walked.
kept ^keyword := chain None
unless (kept.count.is_zero) { INFO@mark `R26 a fresh chain counts other than zero` }
unless (kept.empty) { INFO@mark `R27 a fresh chain is not empty` }
if (exists kept.head) { INFO@mark `R28 a fresh chain has a head` }
kept &= 1
unless (kept.count == 1) { INFO@mark `R29 one thing kept does not count one` }
unless (kept.nonempty) { INFO@mark `R30 a chain holding something is empty` }
unless (kept.head.value == 1) { INFO@mark `R31 the head does not hold what was given` }
unless (kept.tail.value == 1) { INFO@mark `R32 the tail does not hold the only thing` }
kept &= 2
kept &= 3
unless (kept.count == 3) { INFO@mark `R33 three things kept do not count three` }
unless (kept.head.value == 1) { INFO@mark `R34 the head is not the first thing given` }
unless (kept.tail.value == 3) { INFO@mark `R35 the tail is not the last thing given` }
unless (kept.first.value == 1) { INFO@mark `R36 the first is not the first thing given` }
unless (kept.last.value == 3) { INFO@mark `R37 the last is not the last thing given` }
unless (kept.at(1).value == 2) { INFO@mark `R38 the one after the first is not the second thing given` }

walked ^keyword := 0
total ^keyword := 0
kept for {
  walked = walked.succ
  total = total + it.value
}
unless (walked == 3) { INFO@mark `R39 walking a chain of three does not visit three` }
unless (total == (3 + 3)) { INFO@mark `R40 walking a chain of one, two and three does not add to six` }

// A chain of nothing holds nothing, and what holds nothing is dropped.
mixed ^keyword := chain None
mixed &= 1
mixed &= None
mixed &= 2
unless (mixed.count == 3) { INFO@mark `R41 a chain does not keep what holds nothing` }

// A walk reaches the end of a long chain. It is walked rather than asked to
// walk the rest of itself, because a statement is only allowed so many nested
// applications, and forty is past what the asking afforded.
long_chain ^keyword := chain None
to_add ^keyword := 40
while to_add {
  long_chain &= 1
  to_add = to_add.pred
}
unless (long_chain.count == 40) { INFO@mark `RR42 forty things kept do not count forty` }
stepped ^keyword := 0
long_chain for { stepped = stepped.succ }
unless (stepped == 40) { INFO@mark `RR43 walking forty things does not reach forty` }

// What holds for every element, and what holds for some.
threes ^keyword := chain None
threes &= 1
threes &= 2
threes &= 3
unless (threes every { it.value.nonzero }) { INFO@mark `RR44 not every one of one, two and three is something` }
if (threes every { it.value == 1 }) { INFO@mark `RR45 every one of them is one` }
unless (threes some { it.value == 2 }) { INFO@mark `RR46 none of them is two` }
if (threes some { it.value == (3 + 3) }) { INFO@mark `RR47 one of them is six` }
unless (threes.at(0).value == 1) { INFO@mark `RR48 the one at the start is not the first` }
unless (threes.at(2).value == 3) { INFO@mark `RR49 the one two along is not the third` }
unless (threes.count == 3) { INFO@mark `RR50 three things do not count three` }

// What a chain says about itself.
unless (threes.bounded) { INFO@mark `RR51 a chain of three is not bounded` }
if (threes.unbounded) { INFO@mark `RR52 a chain of three is unbounded` }
unless (threes.connected) { INFO@mark `RR53 a chain is not connected` }
unless (threes.consistent) { INFO@mark `RR54 a chain is not consistent` }
unless (threes.acyclic) { INFO@mark `RR55 a chain of three comes back around` }
unless (threes.length == 3) { INFO@mark `RR56 a chain is not as long as it counts` }
if (threes.undirected) { INFO@mark `RR57 a chain is undirected` }
unless (threes.first.value == 1) { INFO@mark `RR58 the first of a chain is not what was given first` }
unless (threes.entry.value == 1) { INFO@mark `RR59 what a chain is entered at is not its first` }

// What a chain adds to and multiplies out to, written where `Iterable` is
// written so that a chain of numbers actually has them.
unless (threes.sum == 6) { INFO@mark `RR60 one, two and three do not add to six` }
unless (threes.product == 6) { INFO@mark `RR61 one, two and three do not multiply to six` }
unless (Σ threes == 6) { INFO@mark `RR62 the sum sign does not add them` }
unless (∏ threes == 6) { INFO@mark `RR63 the product sign does not multiply them` }

// The elements that hold something. A chain written with nothing in it holds
// nothing, so nothing is what is left.
sparse ^keyword := chain None
sparse &= 1
sparse &= None
sparse &= 2
unless (sparse.compact.count == 2) { INFO@mark `RR65 what is left of a chain with a gap is other than two` }
unless (threes.compact.count == 3) { INFO@mark `RR66 a chain with no gaps loses something` }

// A chain is its own path, so the paths through it are the chain.
unless (threes.paths.count == 3) { INFO@mark `RR67 the paths through a chain are not the chain` }

// Everything a chain holds at once: the first, with each next pushed onto it.
unless (exists threes.all) { INFO@mark `RR68 all of a chain is nothing` }

// A chain filled with one thing holds that thing everywhere.
filled ^keyword := chain None
filled &= 1
filled &= 2
filled.fill(3)
unless (filled every { it.value == 3 }) { INFO@mark `RR69 a filled chain does not hold what it was filled with` }

// Which structures allow a ray to continue into more than one, and which
// hold what a hyper edge needs.
if (Structure().hyper_continuations) { INFO@mark `RR70 a plain structure branches` }
unless (Graph().hyper_continuations) { INFO@mark `RR71 a graph does not branch` }
unless (Forest().hyper_continuations) { INFO@mark `RR72 a forest does not branch` }
if (Path().hyper_continuations) { INFO@mark `RR73 a path branches` }
unless (Array().acyclic) { INFO@mark `RR74 an array comes back around` }

// A ray at either end of what it is in.
edges ^keyword := chain None
edges &= 1
edges &= 2
unless (edges.head.is_first) { INFO@mark `RR75 the first of a chain is not first` }
if (edges.head.is_last) { INFO@mark `RR76 the first of a chain of two is last` }
unless (edges.tail.is_last) { INFO@mark `RR77 the last of a chain is not last` }

// One way through a chain, so the two ways of walking it meet; depth-first
// is the one taken unless another is asked for.
unless (Traverser.default == Traverser.Order.depth_first) { INFO@mark `RR78 what a walk does by default is not depth-first` }
if (Traverser.default == Traverser.Order.breadth_first) { INFO@mark `RR79 what a walk does by default is breadth-first` }
walked ^keyword := 0
Traverser.walk(threes, { walked = walked.succ })
unless (walked == 3) { INFO@mark `RR80 walking three things does not reach three` }

// A chain points one way, and goes both ways along itself.
if (threes.unidirectional) { INFO@mark `RR81 a chain points only one way` }

bracketed_one := [1]
unless (bracketed_one.count == 1) { INFO@mark `BR1 a bracketed one does not hold one element` }
unless (bracketed_one.head.value == 1) { INFO@mark `BR2 a bracketed one does not hold it` }
bracketed_pair := [1, 2]
unless (bracketed_pair.count == 2) { INFO@mark `BR3 a bracketed pair does not hold two` }
grouped_one := 1
unless (grouped_one == 1) { INFO@mark `BR4 a grouped one is not one` }
bracketed_twice := [[1, 2]]
unless (bracketed_twice.count == 1) { INFO@mark `BR5 a bracketed pair in brackets does not nest` }
unless (bracketed_twice.head.value.count == 2) { INFO@mark `BR6 the nested pair does not hold two` }
bracketed_ones := [[1], [2]]
unless (bracketed_ones.count == 2) { INFO@mark `BR7 two bracketed ones in brackets are not two` }
handed_pair := (1, 2)
unless ([handed_pair].count == 2) { INFO@mark `BR8 a list handed to brackets is not itself` }
unless (((1, 2)).count == 2) { INFO@mark `BR9 a grouped pair in parentheses nests` }

// What a chain answers as a whole (the draft's Iterable): each element mapped,
// the order turned, what it holds, each thing once, split in two or in runs,
// and what two chains have in common.
counted ^keyword := chain None
counted &= 1
counted &= 2
counted &= 3
doubled ^keyword := counted.map { it.value + it.value }
unless (doubled.count == 3) { INFO@mark `IT2 mapping three things does not give three` }
unless (doubled.head.value == 2) { INFO@mark `IT3 the first doubled is not two` }
unless (doubled.tail.value == 6) { INFO@mark `IT4 the last doubled is not six` }
turned ^keyword := counted.reverse
unless (turned.head.value == 3) { INFO@mark `IT5 turned around, the first is not the last` }
unless (turned.tail.value == 1) { INFO@mark `IT6 turned around, the last is not the first` }
unless (turned.count == 3) { INFO@mark `IT7 turning a chain around loses something` }
unless (counted.contains(2)) { INFO@mark `IT8 a chain does not contain what it was given` }
if (counted.contains(5)) { INFO@mark `IT9 a chain contains what it was never given` }
unless (counted.includes(3)) { INFO@mark `IT10 includes is not contains` }
repeated ^keyword := chain None
repeated &= 1
repeated &= 2
repeated &= 1
unless (repeated.unique.count == 2) { INFO@mark `IT11 each thing once is not two` }
unless (repeated.unique.tail.value == 2) { INFO@mark `IT12 each thing once is not in the order first seen` }
halves ^keyword := counted.partition { it.value < 2 }
unless (halves.count == 2) { INFO@mark `IT13 a partition is not in two` }
unless (halves.head.value.count == 1) { INFO@mark `IT14 what holds is not only the one` }
unless (halves.tail.value.count == 2) { INFO@mark `IT15 what is left is not the other two` }
runs ^keyword := counted.chunk(2)
unless (runs.count == 2) { INFO@mark `IT16 three in runs of two are not two runs` }
unless (runs.head.value.count == 2) { INFO@mark `IT17 the first run is not two long` }
unless (runs.tail.value.count == 1) { INFO@mark `IT18 the last run does not hold what is left` }
unless (counted.batch(3).count == 1) { INFO@mark `IT19 a batch of all of it is not one` }
flat ^keyword := runs.flatten
unless (flat.count == 3) { INFO@mark `IT20 the runs flattened are not the three` }
unless (flat.tail.value == 3) { INFO@mark `IT21 the runs flattened are out of order` }
unless (counted.flatten.count == 3) { INFO@mark `IT22 flattening numbers splices what they are made of` }
common ^keyword := counted.intersection(repeated)
unless (common.count == 2) { INFO@mark `IT23 what both hold is not one and two` }
if (counted.disjoint(repeated)) { INFO@mark `IT24 two chains with one in common are disjoint` }
unless (doubled.disjoint(repeated).not) { INFO@mark `IT25 chains sharing a two are disjoint` }
unless ((counted.symmetric_difference(repeated)).count == 1) { INFO@mark `IT26 what only one of them holds is not three alone` }

// What a thing is an instance of: a chain is an array, and a number is not.
unless (exists counted.instance_of(Chain)) { INFO@mark `IT27 a chain is not a chain` }
unless (exists counted.instance_of(Array)) { INFO@mark `IT28 a chain is not an array` }
unless (exists counted.instance_of(Iterable)) { INFO@mark `IT29 a chain is not iterable` }
unless (exists counted.head.instance_of(Ray)) { INFO@mark `IT30 a link is not a ray` }
unless (exists 1.instance_of(Ray)) { INFO@mark `IT33 a number is not a ray` }

// A chain gains and loses its ends, and is put in order.
ends ^keyword := chain None
ends &= 2
ends.push_back(3)
ends.push_front(1)
unless (ends.count == 3) { INFO@mark `IT35 pushing onto both ends does not hold three` }
unless (ends.head.value == 1) { INFO@mark `IT36 what was pushed in front is not first` }
unless (ends.tail.value == 3) { INFO@mark `IT37 what was pushed at the back is not last` }
unless (ends.pop_front == 1) { INFO@mark `IT38 popping the front does not give the first` }
unless (ends.pop_back == 3) { INFO@mark `IT39 popping the back does not give the last` }
unless (ends.count == 1) { INFO@mark `IT40 two popped off three do not leave one` }
unless (ends.head.value == 2) { INFO@mark `IT41 what is left is not the middle` }
unless (exists ends.head) { INFO@mark `IT42 the one left is not the head` }
shuffled ^keyword := chain None
shuffled &= 3
shuffled &= 1
shuffled &= 2
put_in_order ^keyword := shuffled.sort
unless (put_in_order.head.value == 1) { INFO@mark `IT43 sorted, the first is not the smallest` }
unless (put_in_order.tail.value == 3) { INFO@mark `IT44 sorted, the last is not the largest` }
unless (shuffled.count == 3) { INFO@mark `IT45 sorting took from what was sorted` }

// A set holds each thing once, and two sets are the same when they hold the
// same things, whatever order they were given in.
held_once ^keyword := Set()
held_once.add(1)
held_once.add(2)
held_once.add(1)
unless (held_once.count == 2) { INFO@mark `IT46 a set holds one thing twice` }
unless (held_once.contains(2)) { INFO@mark `IT47 a set does not hold what was added` }
other_way ^keyword := Set()
other_way.add(2)
other_way.add(1)
unless (held_once == other_way) { INFO@mark `IT48 two sets holding the same differ by order` }
fewer ^keyword := Set()
fewer.add(1)
if (held_once == fewer) { INFO@mark `IT49 a set is the same as one holding less` }

// What holds and what is held.
root_place ^keyword := Hierarchy()
inner_place ^keyword := Hierarchy()
root_place.holds(inner_place)
unless (inner_place.parent == root_place) { INFO@mark `IT50 what is held does not know what holds it` }
unless (root_place.children.count == 1) { INFO@mark `IT51 what holds does not hold one` }
unless (inner_place.depth == 1) { INFO@mark `IT52 what is held once is not one deep` }
unless (root_place.depth.is_zero) { INFO@mark `IT53 what holds everything is deeper than nothing` }

