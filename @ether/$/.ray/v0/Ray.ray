// class Ordered

Iterable := class: Ordered {
  entry => None

  empty => .count.is_zero
  nonempty => .empty.not

  bounded => true
  unbounded => .bounded.not

  count => if (exists .entry) { .entry.count } else { zero }

  first => .entry.first
  last => .entry.last

  // `reduce` is the draft's one traversal primitive: `count`, `all`, `every`
  // and `some` are folds over it, once a block can be handed to another rule.
  reduce (step) => TODO
  for (yield) => TODO

  every (predicate: Ordered) => TODO
  some (predicate) => TODO
  all => TODO
  fill (x) => TODO

  connected => TODO
  consistent => TODO
  acyclic => TODO
  undirected => TODO
  unidirectional => TODO

  compact => TODO
  paths => TODO
  length => .paths.length
}

Ray := class: Iterable {
  entry => this

  is_initial => (exists .previous).not
  is_terminal => (exists .next).not

  is_first => .is_initial
  is_last => .is_terminal

  initial => if .is_initial { this } else { .previous.initial }
  terminal => if .is_terminal { this } else { .next.terminal }

  first => .initial
  last => .terminal

  count => if .is_terminal { one } else { .next.count.succ }

  == (other: Ray) => if .is_terminal { other.is_terminal } elsif other.is_terminal { false } else { .next == other.next }
  != (other: Ray) => (this == other).not
}

// A boundary is the ray a vertex shows to the edge it sits on; an edge is the
// ray between two boundaries. Both are rays themselves, which is what makes
// the structure self-similar. `Boundary.Initial` / `Boundary.Terminal` wait on
// a class being able to nest another that extends it.
Boundary := class: Ray {
  vertex => None
  edge => None
}

Edge := class: Ray {
  from => None
  to => None

  is_initial => (exists .from).not
  is_terminal => (exists .to).not
}



