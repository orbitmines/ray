// Worlds, personas, quests, histories and the features: built by their
// constructors from the fields their classes declare.

mark ^keyword := external global

wg := World(name: String.of(`genesis`))
wp := wg.spawn(Player(name: String.of(`alice`)))
goto wo1_ok if wp.name == String.of(`alice`)
INFO@mark `WO1 spawned player lost its name`
wo1_ok\
goto wo2_ok if wg.personas.count == one
INFO@mark `WO2 world has other than one persona`
wo2_ok\
wq := Quest(name: String.of(`find`), goal: None)
goto wo3_ok if wq.done.not.holds
INFO@mark `WO3 a new quest is done`
wo3_ok\
wh := History(repository: wg)
goto wo4_ok if wh.commit(wp, String.of(`hello`)).count == one
INFO@mark `WO4 a commit did not add to the history`
wo4_ok\
goto wo7_ok if Network.DomainName(text: String.of(`a.b`)).valid.holds
INFO@mark `WO7 the domain name a.b is not valid`
wo7_ok\
goto wo9_ok if Keyboard.Key(name: String.of(`a`)).press.pressed.holds
INFO@mark `WO9 a pressed key is not pressed`
wo9_ok\
goto wo10_ok if Chat().say(wp, String.of(`hi`)).count == one
INFO@mark `WO10 a said message is not in the chat`
wo10_ok\
goto wo11_ok if Proof.theorem(Proof.Proposition(holds: true), Proof(proposition: None, argument: Proof.Proposition(holds: true))).holds
INFO@mark `WO11 the theorem does not hold`
wo11_ok\
