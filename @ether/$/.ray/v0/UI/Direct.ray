Language.Direct := class: Language {
  static extensions = ".direct"

  Drawing := class = raster: Geometry.Raster, ops: *[]
  Draw := class = shape: Geometry.Shape, outer: Geometry.Transform {
    placed => outer * Geometry.Transform.translate(shape.origin) * shape.shown_transform
    inner => placed * Geometry.Transform.translate(shape.origin * -1)
    area => (0..<shape.size.y as px).map(y => (0..<shape.size.x as px).map(x => (x, y))).flatten
    inside => area{shape.contains(Geometry.Vector(.0, .1))}
    opacity => shape.effects{. is Geometry.Opacity}.amount.product ?? 1
  }
  Painted := class = points: (at: Geometry.Vector, sample: Geometry.Vector)[], paint: Geometry.Paint?, alpha: Probability = 1
  Outlined := class = outlines: Geometry.Outline[], transform: Geometry.Transform, paint: Geometry.Paint?
  Stroked := class = outline: Geometry.Outline, transform: Geometry.Transform, stroke: Geometry.Stroke
  Shown := class = draw: Draw

  rules := {
    {solved: Geometry.Solved} => Drawing(Geometry.Raster(UI.Viewport.size.x as px, UI.Viewport.size.y as px), [solved.shape, solved.shape.lifted].flatten.map(Draw(., Geometry.Transform.translate(Geometry.Vector(0, -solved.scrolled)))))
    {drawing: Drawing{ops.flatten.every(. is Program)}} => drawing.raster ~~ drawing.ops.flatten

    {draw: Draw{shape.content is Choice}} => [
      Draw(Geometry.Box(origin: draw.shape.origin, size: draw.shape.size, fill: draw.shape.fill, stroke: draw.shape.stroke, radius: draw.shape.radius, effects: draw.shape.effects), draw.outer),
      Draw(draw.shape.face, draw.outer)
    ]
    {draw: Draw} => [
      Painted(draw.inside.map((x, y) => (at: draw.placed.applied(Geometry.Vector(x, y)), sample: Geometry.Vector(x, y))), draw.shape.fill, draw.opacity) if draw.shape.fill && !(draw.shape.content is Location),
      Stroked(draw.shape.boundary, draw.placed, draw.shape.stroke) if draw.shape.stroke,
      Shown(draw) if draw.shape.content,
      draw.shape.in_place.sort_by(.layer).map(Draw(., draw.inner)) if draw.shape.visible,
      draw.shape.effects{. is Geometry.Blur}.map(blur => { .blurred(draw.inside, blur.radius as px) })
    ]

    {shown: Shown{draw.shape.content is String}} => {
      draw = shown.draw
      text = draw.shape
      lines = text.lines(text.size.x)
      starts = text.starts(text.size.x)
      (0..<lines.count).map(row => (0..<lines[row].length).reduce(placed = (pen: 0, ops: []) => {
        look = UI.Theme.face(text, starts[row] + .)
        typeface = look.font
        height = typeface.size * typeface.line_height
        glyph = Font(typeface).glyph(lines[row][.])
        (pen: placed.pen + glyph.advance * typeface.size / glyph.units, ops: [placed.ops,
          Draw(Geometry.Box(origin: Geometry.Vector(placed.pen, row * height), size: Geometry.Vector(typeface.size * 0.6, height), fill: Geometry.Color(51, 144, 255, 0.4)), draw.placed) if UI.Selection.selects(text, starts[row] + .),
          Outlined(glyph.outlines, draw.placed * Geometry.Transform.translate(Geometry.Vector(placed.pen, row * height)) * Geometry.Transform.scale(Geometry.Vector(typeface.size / glyph.units, typeface.size / glyph.units)), look.color ?? Geometry.Color(0, 0, 0))
        ].flatten)
      }).ops).flatten
    }
    {shown: Shown{draw.shape.content is Location && draw.shape.content.language === Language.Image && draw.shape.fill}} => shown.draw -- (draw => draw.shape.content.pixels -- (raster => draw.area.map((x, y) =>
      draw.placed.applied(Geometry.Vector(x, y)) -- (at => { .put(at.x, at.y, ((draw.shape.fill as Geometry.Color) ?? Geometry.Color(0, 0, 0)).faded(raster.at(x * raster.width / draw.shape.size.x, y * raster.height / draw.shape.size.y).alpha)) })
    )))
    {shown: Shown{draw.shape.content is Location && draw.shape.content.language === Language.Image}} => shown.draw -- (draw => draw.shape.content.pixels -- (raster => draw.area.map((x, y) =>
      draw.placed.applied(Geometry.Vector(x, y)) -- (at => { .put(at.x, at.y, raster.at(x * raster.width / draw.shape.size.x, y * raster.height / draw.shape.size.y)) })
    )))
    {shown: Shown{draw.shape.content is Location && draw.shape.content.video_site}} => shown.draw -- (draw => Draw(Geometry.Box(origin: draw.shape.origin, size: draw.shape.size, fill: Geometry.Color(17, 20, 24), stroke: Geometry.Stroke(Geometry.Color(128, 128, 128)), children: [
      Geometry.Box(content: "▶ " + (draw.shape.content.alt ?? draw.shape.content as String), origin: draw.shape.origin + draw.shape.size * (1 / 2) - Geometry.Vector(0, 8px), size: draw.shape.size * (1 / 2), align: center, color: Geometry.Color(246, 247, 249))
    ]), draw.outer))
    {shown: Shown{draw.shape.content is Program}} => shown.draw -- (draw => draw.shape.content().map(Draw(., draw.placed)))
    {shown: Shown} => []

    {painted: Painted{paint is Geometry.Color}} => painted.paint.faded(painted.alpha) -- (color => painted.points.map(point => { .put(point.at.x, point.at.y, color) }))
    {painted: Painted{paint is Geometry.Gradient}} => painted.points.map(point => { .put(point.at.x, point.at.y, painted.paint.at(point.sample.x).faded(painted.alpha)) })
    {painted: Painted{paint is Geometry.Pattern}} => painted.paint -- (pattern => Compiler.reduced(Drawing(Geometry.Raster(pattern.repeat.x as px, pattern.repeat.y as px), [Draw(pattern.shape, Geometry.Transform())]), rules) -- (tile =>
      painted.points.map(point => { .put(point.at.x, point.at.y, tile.at(point.sample.x % pattern.repeat.x, point.sample.y % pattern.repeat.y).faded(painted.alpha)) })
    ))
    {painted: Painted} => []
    {outlined: Outlined} => outlined.outlines.map(.points.map(outlined.transform.applied(.))) -- (contours => contours.map(corners => corners.zip([corners.rest, corners.first])).flatten(1) -- (edges => Painted((contours.flatten.y.min..<contours.flatten.y.max).map(y =>
      edges{(.0.y <= y) != (.1.y <= y)}.map(.0.x + (y - .0.y) * (.1.x - .0.x) / (.1.y - .0.y)).sort.chunk(2).map((a, b) => (a..<b).map(x => (at: Geometry.Vector(x, y), sample: Geometry.Vector(x, y))))
    ).flatten, outlined.paint)))
    {stroked: Stroked} => stroked.outline.points.map(stroked.transform.applied(.)) -- (corners => Painted(corners.zip(corners.rest).map((a, b) =>
      (0..<(b - a).length as px).map(step => a + (b - a) * (step / (b - a).length) -- (point => (-(stroked.stroke.width / 2)..stroked.stroke.width / 2).map(w => (at: Geometry.Vector(point.x + w, point.y), sample: point))))
    ).flatten, stroked.stroke.paint))
  }
  level := Geometry.Solving + rules

  Font := class = font: Geometry.Font {
    file => font.family.map(Fonts.located(.)).first
    glyph (character: Char) => (IO.host(file.path) as OpenType)[character]
  }
  Fonts := class {
    located (family: String) => ["/usr/share/fonts", "/System/Library/Fonts", "C:/Windows/Fonts"].map(IO.listing(.)).flatten{.name.fold_case ~= family.fold_case}.first
  }
  Glyph := class = outlines: Geometry.Outline[], advance: Number, units: Number

  OpenType := class = (version: U32, count: U16, U16, U16, U16, records: (tag: Char⁴, checksum: U32, offset: U32, size: U32)[]{length == count}, *) {
    static language = Language.register(Language(".otf" | ".ttf", level: { {font: OpenType} => font }))
    static U8 = Binary⁸
    static U16 = Binary¹⁶
    static U32 = Binary³²
    static I16 := class: Binary¹⁶ {
      signed => this < 2 ^ 15 ? this : this - 2 ^ 16
    }

    static Head := class = (U32, U32, U32, U32{== 0x5F0F3CF5}, U16, units: U16, Binary⁶⁴, Binary⁶⁴, I16, I16, I16, I16, U16, U16, I16, long_offsets: U16, I16)
    static Hhea := class = (U32, ascender: I16, I16, I16, U16, I16, I16, I16, I16, I16, I16, I16, I16, I16, I16, I16, metrics: U16)
    static Metrics<count> := class = (advances: (advance: U16, bearing: I16)[]{length == count}, *) {
      [glyph: Number] => advances[[glyph, advances.count - 1].min].advance
    }
    static Cmap := class = (U16, count: U16, encodings: (platform: U16, encoding: U16, offset: U32)[]{length == count}, *)
    static Format4 := class = (U16{== 4}, U16, U16, doubled: U16, U16, U16, U16, ends: U16[]{length == doubled / 2}, U16, starts: U16[]{length == doubled / 2}, deltas: U16[]{length == doubled / 2}, ranges: U16[]{length == doubled / 2}, glyphs: U16[]) {
      [code: Number] => (0..<ends.count){starts[.] <= code <= ends[.]}.first -- (segment => segment == None ? 0
        : ranges[segment] == 0 ? (code + deltas[segment]) % 2 ^ 16
        : glyphs[ranges[segment] / 2 + code - starts[segment] + segment - ends.count] -- (. == 0 ? 0 : (. + deltas[segment]) % 2 ^ 16))
    }

    static Flag := class = (Binary², y_same: Binary¹, x_same: Binary¹, repeats: Binary¹, y_short: Binary¹, x_short: Binary¹, on_curve: Binary¹)
    static Coordinate<short, same> := class = ((magnitude: U8) if short, (value: I16) if !(short || same)) {
      delta => short ? (same ? magnitude : -magnitude) : same ? 0 : value.signed
    }
    static Point := class = at: Geometry.Vector, on: boolean
    static Step := class = from: Point, to: Point
    static contoured := {
      {step: Step{from.on && to.on}} => step.to.at
      {step: Step{to.on}} => Geometry.Quadratic(step.from.at, step.to.at)
      {step: Step{from.on}} => []
      {step: Step} => Geometry.Quadratic(step.from.at, (step.from.at + step.to.at) * (1 / 2))
    }
    static Simple := class = (
      contours: U16{< 2 ^ 15}, I16, I16, I16, I16,
      ends: U16[]{length == contours},
      instructions: U16, U8[]{length == instructions},
      runs: (flag: Flag, (times: U8) if flag.repeats == 1)[]{map(1 + (.times ?? 0)).sum == ends.last + 1},
      xs: flags.map(flag => Coordinate<flag.x_short == 1, flag.x_same == 1>),
      ys: flags.map(flag => Coordinate<flag.y_short == 1, flag.y_same == 1>)
    ) {
      flags => runs.map([.flag] * (1 + (.times ?? 0))).flatten
      absolute (deltas: Number[]) => deltas.reduce(acc = [] => [acc, (acc.last ?? 0) + .].flatten)
      outlines (ascender: Number) => absolute(xs.delta) -- (across => absolute(ys.delta) -- (up =>
        flags.enumerate.map(Point(Geometry.Vector(across[.index], ascender - up[.index]), .value.on_curve == 1)))) -- (points =>
        [-1, ends].flatten.zip(ends).map((from, to) => outline(points[(from + 1)..to])))
      outline (points: Point[]) => (points.some(.on)
        ? points.index_of(points{.on}.first) -- (start => [points[start..], points[..start]].flatten)
        : Point((points.first.at + points.last.at) * (1 / 2), true) -- (start => [start, points, start].flatten)
      ) -- (ring => Geometry.Outline(ring.first.at, Compiler.reduced(ring.zip(ring.rest).map(Step(.0, .1)), contoured).flatten, closed: true))
    }

    bits => this as Binary
    table (tag: String) => records{.tag == tag}.first -- (record => bits[record.offset * 8 ..< (record.offset + record.size) * 8])
    head => table("head") as Head
    hhea => table("hhea") as Hhea
    hmtx => table("hmtx") as Metrics<hhea.metrics>
    cmap => table("cmap") -- (data => (data as Cmap).encodings{.platform == 3 && .encoding == 1 || .platform == 0}.map(data[.offset * 8..] as Format4){!= None}.first)
    located (glyph: Number) => head.long_offsets == 1 ? (table("loca") as U32[])[glyph] : (table("loca") as U16[])[glyph] * 2
    outlines (glyph: Number) => (table("glyf")[located(glyph) * 8 ..< located(glyph + 1) * 8] as Simple)?.outlines(hhea.ascender.signed) ?? []
    [character: Char] => cmap[character as Number] -- (glyph => Glyph(outlines(glyph), hmtx[glyph], head.units))
  }

  Display := class = target: Location, title: String = "" {
    write (raster: Geometry.Raster) => (title = UI.Navigation.title) -- IO.write(target, raster)
    open (to: Location) => UI.Platform.launch(to)
    read => Language.Web.DOM.dispatched(external io `window` None)
  }
}

Language.register(Language.Direct)
