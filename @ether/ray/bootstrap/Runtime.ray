    bind(name, a, e)
    Runtime.held_as(bound_at(boundn - 1), v)
  }
  static held_as (b: Bound, v) => {
    b.held = v
  }
  // (whether another way of an either reads further from there)
  static read_by_another (l: List, i, pos) => {
    j := 0
    m := boundn
    while j < l.count {
      return 1 if (j != i) && Runtime.read_further(l.items[j], pos, m)
      j = j + 1
