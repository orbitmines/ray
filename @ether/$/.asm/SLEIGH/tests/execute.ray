// A 6502 program run from memory, purely through goto programs translated
// from Ghidra's description: a call to a copying loop, which returns.
//
//   0600  20 00 07   JSR $0700
//   0700  a2 fc      LDX #$fc
//   0702  bd 00 02   LDA $0200,X
//   0705  9d 00 03   STA $0300,X
//   0708  e8         INX
//   0709  d0 f7      BNE $0702
//   070b  60         RTS
//
// The loop of `disassemble.ray`, counting from fc rather than 00 so that it
// copies four bytes, not 256. Nineteen instructions run until the machine
// is back at 0603.
//
// run: PROJECT=SLEIGH SPECS=.ether/external/ghidra/Ghidra/Processors/6502/data/languages/6502.slaspec T=1500 M=9000 .ether/asm/asm.sh sleigh-execute @ether/$/.asm/SLEIGH/tests/execute.ray boolean.ray -- Bits.ray ISA.ray Goto.ray

if (Bits.hex(`01`) == Bits.hex(`02`)) { INFO@mark `E0 equality control: 01 is read as 02` }
unless (exists None) { INFO@mark `E1 control: this always fires` }
asked ^keyword := chain None
asked &= `JSR`
asked &= `LDX`
asked &= `LDA`
asked &= `STA`
asked &= `INX`
asked &= `BNE`
asked &= `RTS`
isa ^keyword := Sleigh.isa(sleigh.spelled(asked))
cpu ^keyword := State(registers: chain None, memory: chain None)
// (What is handed to a method is named first: an argument is read where it
// is used, inside the method.)
placed (placing_start, placing_text) => (
  placing_at := placing_start
  placing_step := Bits.hex(`0001`)
  placing_link := Bits.hex_bytes(placing_text).head
  while (exists placing_link) {
    placing_byte := placing_link.value
    cpu.store(placing_at, placing_byte)
    placing_at = placing_at + placing_step
    placing_link = placing_link.next
  }
  true
)
placed(Bits.hex(`0600`), `200007`)
placed(Bits.hex(`0700`), `a2fc bd0002 9d0003 e8 d0f7 60`)
placed(Bits.hex(`02fc`), `11223344`)
cpu.put(`SP`, Bits.hex(`01ff`))
entry_point ^keyword := Bits.hex(`0600`)
return_point ^keyword := Bits.hex(`0603`)
longest_bytes ^keyword := Sleigh.counted(`3`)
most_steps ^keyword := Sleigh.counted(`30`)
ran ^keyword := Sleigh.executed(isa, cpu, entry_point, return_point, longest_bytes, most_steps)

unless (cpu.load(Bits.hex(`03fc`)) == Bits.hex(`11`)) { INFO@mark `E2 03fc is not 11` }
unless (cpu.load(Bits.hex(`03fd`)) == Bits.hex(`22`)) { INFO@mark `E3 03fd is not 22` }
unless (cpu.load(Bits.hex(`03fe`)) == Bits.hex(`33`)) { INFO@mark `E4 03fe is not 33` }
unless (cpu.load(Bits.hex(`03ff`)) == Bits.hex(`44`)) { INFO@mark `E5 03ff is not 44` }
unless (cpu.get(`X`) == Bits.hex(`00`)) { INFO@mark `E6 X is not 00` }
unless (cpu.get(`A`) == Bits.hex(`44`)) { INFO@mark `E7 A is not 44` }
unless (cpu.get(`SP`) == Bits.hex(`01ff`)) { INFO@mark `E8 SP is not back at 01ff` }
unless (exists (external alike (ran.head.value.mnemonic) (`JSR`))) { INFO@mark `E9 the first run is not JSR` }
unless (exists (external alike (ran.tail.value.mnemonic) (`RTS`))) { INFO@mark `E10 the last run is not RTS` }
unless (exists ran.head.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next) { INFO@mark `E11 fewer than nineteen run` }
if (exists ran.head.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next.next) { INFO@mark `E12 more than nineteen run` }
