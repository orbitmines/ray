  static holders (hl, hn) => hl.empty ? Array.new : ((Lowered.field_named(hl.first.last, hn) === None) ? Lowered.holders(hl.rest, hn) : Lowered.holders(hl.rest, hn).append(hl.first))
  static only_holder (oh) => (oh.count == 1) ? oh.first : None
