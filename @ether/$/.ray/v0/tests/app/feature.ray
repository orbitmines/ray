// Features: what the machine hands over, what is chosen, what is proved, and
// what a transaction remembers.

mark ^keyword := external global

unless (Random.bit) { INFO@mark `FE1 a bit from the machine is nothing` }
unless (Random.bits(3).count == 3) { INFO@mark `FE2 three bits are not three` }
unless (Choice.coin) { INFO@mark `FE3 a coin comes up with nothing` }

t := Transaction(forwards: 1, backwards: 2)
unless (t.forwards == 1) { INFO@mark `FE4 a transaction forgot the step it takes` }
unless (t.reversed.forwards == 2) { INFO@mark `FE5 a reversed transaction does not swap what it holds` }
unless (t.mark_applied.applied) { INFO@mark `FE6 a transaction does not remember being applied` }

unless (Proof.rfl(Proof.Proposition(holds: true))) { INFO@mark `FE7 what holds is not proved by itself` }
if (Proof.rfl(Proof.Proposition(holds: false))) { INFO@mark `FE8 what does not hold is proved by itself` }

unless (Transaction.Inverse.plus) { INFO@mark `FE9a the inverses have no plus` }
unless (Transaction.Inverse.plus.is.as(String) == "-") { INFO@mark `FE9b the inverse of plus is not minus` }
unless (Transaction.Inverse.minus) { INFO@mark `FE9 the inverses have no minus` }
unless (Transaction.Inverse.minus.is.as(String) == "+") { INFO@mark `FE10 the inverse of minus is not plus` }

// Keys: what a press and a release leave behind.
fresh_key := Keyboard.Key(name: "a")
if (fresh_key.pressed) { INFO@mark `FE11 an untouched key is pressed` }
if (fresh_key.toggled) { INFO@mark `FE12 an untouched key is toggled` }
pushed_key := Keyboard.Key(name: "b").press
unless (pushed_key.pressed) { INFO@mark `FE13 a pressed key is not pressed` }
unless (pushed_key.toggled) { INFO@mark `FE14 a pressed key is not toggled` }
if (pushed_key.release.pressed) { INFO@mark `FE15 a released key is still pressed` }
unless (Keyboard(keys: (chain None)).add(fresh_key).keys.count == 1) { INFO@mark `FE16 a keyboard given one key does not hold one` }

// The machine's own bit. It is handed over as presence, not as a written
// digit, so it can be read at all; before that every bit was zero and every
// uuid was the same one.
drawn_bit := Random.bit
unless ((drawn_bit == 1).or(drawn_bit.is_zero)) { INFO@mark `RN1 a drawn bit is neither one nor zero` }
unless (Random.bits(4).count == 4) { INFO@mark `RN2 four drawn bits are not four` }
unless (Random.number(3) < 8) { INFO@mark `RN3 three bits spell eight or more` }
unless (Random.below(5) < 5) { INFO@mark `RN4 a number below five is not below five` }

// Twenty draws are not all the same. They could be — about twice in a
// million — but every bit being the same is what a machine that hands over
// nothing readable looks like, which is what this is here to catch.
ones ^keyword := 0
zeros ^keyword := 0
to_draw ^keyword := 20
while to_draw {
  if ((external random)) { ones = ones.succ } else { zeros = zeros.succ }
  to_draw = to_draw.pred
}
unless ((ones + zeros) == 20) { INFO@mark `RN5 twenty draws are not twenty` }
if (ones.is_zero) { INFO@mark `RN6 twenty draws were all nothing` }
if (zeros.is_zero) { INFO@mark `RN7 twenty draws were all something` }

// A proposition holds or it does not, and what says so is a proof.
yes := Proof.Proposition(holds: true)
no := Proof.Proposition(holds: false)
unless (yes.holds) { INFO@mark `PF1 a proposition written as holding does not hold` }
if (no.holds) { INFO@mark `PF2 a proposition written as not holding holds` }
unless (yes.negated.holds.not) { INFO@mark `PF3 the negation of one that holds holds` }
unless (no.negated.holds) { INFO@mark `PF4 the negation of one that does not hold does not hold` }
unless (Proof.rfl(yes)) { INFO@mark `PF5 a proposition is not proof of itself` }
if (Proof.rfl(no)) { INFO@mark `PF6 one that does not hold proves itself` }
unless (Proof.assume(yes).holds) { INFO@mark `PF7 what is assumed is not what was assumed` }
unless (Proof.by_contradiction(yes, no)) { INFO@mark `PF8 a proof of the negation failing does not prove it` }
if (Proof.by_contradiction(no, yes)) { INFO@mark `PF9 a proof of the negation holding proves it anyway` }
unless (Proof(proposition: yes, argument: yes).holds) { INFO@mark `PF10 a proof holds only if its argument does` }
// What is proved is true; what is not is what there is to do.
unless (Proof.theorem(yes, yes)) { INFO@mark `PF11 a theorem with a proof that holds is not true` }
unless (Proof.theorem(yes, no).goal) { INFO@mark `PF12 a theorem without a proof is not something to do` }
unless (Proof.theorem(yes, no).goal == yes) { INFO@mark `PF13 what there is to do is not proving the proposition` }
if (Proof.theorem(yes, no).completed) { INFO@mark `PF14 what there is to do is already done` }

// A step each way, and swapping them.
step := Transaction(forwards: 1, backwards: 2)
unless (step.forwards == 1) { INFO@mark `TR1 a transaction forgot which way it goes` }
unless (step.reversed.forwards == 2) { INFO@mark `TR2 reversing does not swap the two ways` }
unless (step.reversed.backwards == 1) { INFO@mark `TR3 reversing does not swap the other way` }
if (step.applied) { INFO@mark `TR4 a new transaction is already applied` }
unless (step.mark_applied.applied) { INFO@mark `TR5 marking it applied does not` }
unless (step.reversed.reversed.forwards == 1) { INFO@mark `TR6 reversing twice does not come back` }

// A key is pressed and released; what it toggles stays.
key := Keyboard.Key(name: 1)
if (key.pressed) { INFO@mark `KB1 a new key is already pressed` }
if (key.toggled) { INFO@mark `KB2 a new key is already toggled` }
unless (key.press.pressed) { INFO@mark `KB3 pressing a key does not press it` }
unless (key.toggled) { INFO@mark `KB4 pressing a key does not toggle it` }
unless (key.release.pressed.not) { INFO@mark `KB5 releasing a key does not release it` }
unless (key.toggled) { INFO@mark `KB6 releasing a key untoggled it` }
unless (key.press.toggled.not) { INFO@mark `KB7 pressing again does not toggle back` }
board := Keyboard(keys: (chain None))
unless (board.add(key).keys.count == 1) { INFO@mark `KB8 a board with one key added does not hold one` }

// A chat is a chain of messages, each from someone.
room := Chat(messages: (chain None))
unless (room.count.is_zero) { INFO@mark `CH1 a new chat already holds messages` }
room.say(1, "hi")
unless (room.count == 1) { INFO@mark `CH2 saying something does not keep it` }
room.say(2, "ho")
unless (room.count == 2) { INFO@mark `CH3 saying twice keeps other than two` }
unless (room.messages.head.value.who == 1) { INFO@mark `CH4 a message forgot who said it` }
unless (room.messages.tail.value.text == "ho") { INFO@mark `CH5 a message forgot what was said` }

// What the machine says about itself.
unless (IO.platform) { INFO@mark `IO1 the machine does not say what it is` }
unless (IO.architecture) { INFO@mark `IO2 the machine does not say what it is built on` }

// One of a collection, and several. Which one is the machine's to say; that
// there is one, and that it is one of them, is not.
bag := chain None
bag &= 1
bag &= 2
bag &= 3
unless (bag.random) { INFO@mark `RN8 a collection does not answer one of itself` }
unless (Choice.choose(bag)) { INFO@mark `RN9 choosing from a collection answers nothing` }
unless (Choice.choose_count(bag, 2).count == 2) { INFO@mark `RN10 choosing two does not answer two` }
// What `at`, `first` and `random` answer is the link, as everywhere else; what
// it holds is its value.
picked_one := bag.random.value
unless ((picked_one == 1).or((picked_one == 2).or(picked_one == 3))) { INFO@mark `RN11 what was chosen is not one of them` }
unless (Choice.coin) { INFO@mark `RN12 a coin lands on neither side` }

// What the machine says about itself, asked by name.
unless (IO.os(`platform`).nonempty) { INFO@mark `IO3 the machine does not name its platform` }
unless (IO.os(`architecture`) == IO.architecture) { INFO@mark `IO4 asking by name is not asking the other way` }
// Reading a location answers what is written there and leaves it as it was:
// the file the library is declared in is read twice.
read_once := IO.read(`@ether/$/.ray/v0/.project.ray`)
read_twice := IO.read(`@ether/$/.ray/v0/.project.ray`)
unless (read_once.nonempty) { INFO@mark `IO5 a read answers nothing` }
unless (read_once == read_twice) { INFO@mark `IO6 reading a file changed it` }
// spec: writing a location is not claimed here — a test that writes a file
// leaves one behind.

// A location computed as a string reaches the machine as the bits it is
// written with.
read_by_bits := IO.read("@ether/$/.ray/v0/.project.ray".bits)
unless (read_by_bits == read_once) { INFO@mark `IO7 a location given as a string's bits is read as another place` }

tapped := Keyboard.Key(name: 2)
unless (tapped.presses.is_zero) { INFO@mark `KB9 an untouched key has been pressed` }
tapped.press
unless (tapped.presses == 1) { INFO@mark `KB10 a press is not counted` }
tapped.release
tapped.press
unless (tapped.presses == 2) { INFO@mark `KB11 two presses are not counted two` }
options := (chain None)
options &= 10
options &= 20
options &= 30
unless (Keyboard.Key(name: 3).cycle(options).value == 10) { INFO@mark `KB12 a key never pressed does not answer the first entry` }
unless (Keyboard.Key(name: 4).press.cycle(options).value == 20) { INFO@mark `KB13 one press does not answer the second entry` }
unless (tapped.cycle(options).value == 30) { INFO@mark `KB14 two presses do not answer the third entry` }
unless (tapped.press.cycle(options).value == 10) { INFO@mark `KB15 three presses do not come back to the first entry` }
held_key := Keyboard.Key(name: 5).press
unless (held_key) { INFO@mark `KB16 a pressed key does not hold as a condition` }
if (held_key.release) { INFO@mark `KB17 a released key holds as a condition` }
if (Keyboard.Key(name: 6)) { INFO@mark `KB18 a key nobody pressed holds as a condition` }

// Calling a narrowed type chooses a value of it.
chosen_above := Number{. > 5}()
unless (chosen_above > 5) { INFO@mark `CN1 a value chosen from a narrowing does not satisfy it` }
unless (boolean{. == true}() == true) { INFO@mark `CN2 the only member a narrowing admits is not the one chosen` }
