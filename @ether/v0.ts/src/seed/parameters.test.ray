say {x} =>
  external io stdout x
// typed parameters, a class's parameters with defaults and bound: each line says true (preceding)
g (a: Node, b: Node) => say b
g(false, true)
k (a, b: Node) => say b
k(false, true)
Length := class { }
Other := class { }
Stop<K = Length, V = Node> := class at: Node, value: Node {
  kind => K
}
say (Stop(at: true, value: true).kind === Length)
say ((Stop<Other, Node>)(at: true, value: true).kind === Other)
Stops<K = Length, V = Node> := class stops: Stop<K, V> { }
say (Stops === Stops)
