// A rule that asks for an operator runs a body of statements with a name of its own.

mark ^keyword := external global

{left} - {right} => (
  held := 2
  held + 1
)
unless 10 - 3 == 3 { INFO@mark `RW1 a body that declares a name is not run` }
unless 1 - 1 == 3 { INFO@mark `RW2 it answers the same wherever it stands` }
