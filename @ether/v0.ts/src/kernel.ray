  {a: K_band} & {b: K_eq} => Kjs_node &+ { kind := `bin` ; op := `&` ; l := a ; r := b }
  {a: K_bxor} ^ {b: K_band} => Kjs_node &+ { kind := `bin` ; op := `^` ; l := a ; r := b }
  {a: K_bor} | {b: K_bxor} => Kjs_node &+ { kind := `bin` ; op := `|` ; l := a ; r := b }
  {a: K_and} && {b: K_bor} => Kjs_node &+ { kind := `logic` ; op := `&&` ; l := a ; r := b }
  {a: K_or} || {b: K_and} => Kjs_node &+ { kind := `logic` ; op := `||` ; l := a ; r := b }
  {c_: K_or} ? {y_: K_assign} : {n_: K_assign} => Kjs_node &+ { kind := `cond` ; c := c_ ; y := y_ ; n := n_ }
}
K_assign &+= {
  {x: K_word} => x
  {`(`}{g: K_assign}{`)`} => g
  {f: K_word}({a: K_args}) => Kjs_node &+ { kind := `call` ; called := f ; args := a }
  {f: K_word}() => Kjs_node &+ { kind := `call` ; called := f ; args := None }
  {w: K_word}++ => Kjs_node &+ { kind := `post` ; op := `+` ; name := w }
  {w: K_word}-- => Kjs_node &+ { kind := `post` ; op := `-` ; name := w }
  {o: `!`}{p: K_u} => Kjs_node &+ { kind := `unary` ; op := `!` ; operand := p }
  {o: `-`}{p: K_u} => Kjs_node &+ { kind := `unary` ; op := `-` ; operand := p }
  {o: `~`}{p: K_u} => Kjs_node &+ { kind := `unary` ; op := `~` ; operand := p }
  {o: `+`}{p: K_u} => Kjs_node &+ { kind := `unary` ; op := `+` ; operand := p }
  {o: `++`}{w: K_word} => Kjs_node &+ { kind := `pre` ; op := `+` ; name := w }
  {o: `--`}{w: K_word} => Kjs_node &+ { kind := `pre` ; op := `-` ; name := w }
  {a: K_mul} * {b: K_u} => Kjs_node &+ { kind := `bin` ; op := `*` ; l := a ; r := b }
  {a: K_mul} / {b: K_u} => Kjs_node &+ { kind := `bin` ; op := `/` ; l := a ; r := b }
  {a: K_mul} % {b: K_u} => Kjs_node &+ { kind := `bin` ; op := `%` ; l := a ; r := b }
  {a: K_add} + {b: K_mul} => Kjs_node &+ { kind := `bin` ; op := `+` ; l := a ; r := b }
  {a: K_add} - {b: K_mul} => Kjs_node &+ { kind := `bin` ; op := `-` ; l := a ; r := b }
  {a: K_shift} << {b: K_add} => Kjs_node &+ { kind := `bin` ; op := `<<` ; l := a ; r := b }
  {a: K_shift} >> {b: K_add} => Kjs_node &+ { kind := `bin` ; op := `>>` ; l := a ; r := b }
  {a: K_shift} >>> {b: K_add} => Kjs_node &+ { kind := `bin` ; op := `>>>` ; l := a ; r := b }
  {a: K_rel} < {b: K_shift} => Kjs_node &+ { kind := `bin` ; op := `<` ; l := a ; r := b }
  {a: K_rel} > {b: K_shift} => Kjs_node &+ { kind := `bin` ; op := `>` ; l := a ; r := b }
  {a: K_rel} <= {b: K_shift} => Kjs_node &+ { kind := `bin` ; op := `<=` ; l := a ; r := b }
  {a: K_rel} >= {b: K_shift} => Kjs_node &+ { kind := `bin` ; op := `>=` ; l := a ; r := b }
  {a: K_eq} == {b: K_rel} => Kjs_node &+ { kind := `bin` ; op := `==` ; l := a ; r := b }
  {a: K_eq} != {b: K_rel} => Kjs_node &+ { kind := `bin` ; op := `!=` ; l := a ; r := b }
  {a: K_eq} === {b: K_rel} => Kjs_node &+ { kind := `bin` ; op := `==` ; l := a ; r := b }
  {a: K_eq} !== {b: K_rel} => Kjs_node &+ { kind := `bin` ; op := `!=` ; l := a ; r := b }
  {a: K_band} & {b: K_eq} => Kjs_node &+ { kind := `bin` ; op := `&` ; l := a ; r := b }
  {a: K_bxor} ^ {b: K_band} => Kjs_node &+ { kind := `bin` ; op := `^` ; l := a ; r := b }
  {a: K_bor} | {b: K_bxor} => Kjs_node &+ { kind := `bin` ; op := `|` ; l := a ; r := b }
  {a: K_and} && {b: K_bor} => Kjs_node &+ { kind := `logic` ; op := `&&` ; l := a ; r := b }
  {a: K_or} || {b: K_and} => Kjs_node &+ { kind := `logic` ; op := `||` ; l := a ; r := b }
  {c_: K_or} ? {y_: K_assign} : {n_: K_assign} => Kjs_node &+ { kind := `cond` ; c := c_ ; y := y_ ; n := n_ }
  {w: K_word} = {v_: K_assign} => Kjs_node &+ { kind := `assign` ; name := w ; v := v_ }
  {w: K_word} += {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `+` ; name := w ; v := v_ }
  {w: K_word} -= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `-` ; name := w ; v := v_ }
  {w: K_word} *= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `*` ; name := w ; v := v_ }
  {w: K_word} /= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `/` ; name := w ; v := v_ }
  {w: K_word} %= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `%` ; name := w ; v := v_ }
  {w: K_word} &= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `&` ; name := w ; v := v_ }
  {w: K_word} |= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `|` ; name := w ; v := v_ }
  {w: K_word} ^= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `^` ; name := w ; v := v_ }
  {w: K_word} <<= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `<<` ; name := w ; v := v_ }
  {w: K_word} >>= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `>>` ; name := w ; v := v_ }
  {w: K_word} >>>= {v_: K_assign} => Kjs_node &+ { kind := `compound` ; op := `>>>` ; name := w ; v := v_ }
}
// (a choice among them, not the last: a rule of its own, a `,` after a choice in a list read as Ray reads one, the rest
// the choice's, unless the list is in brackets right before it)
// (a `for`'s step, values written one after another, `n++, h = h + 1`: each in turn)
K_seq &+= {
  {a__sq: K_assign} => a__sq
  {a__sq: K_assign}, {b__sq: K_seq} => Kjs_node &+ { kind := `seq` ; l := a__sq ; r := b__sq }
}
K_args &+= {
  {x__ag: K_assign} => Kjs_node &+ { kind := `list` ; car := x__ag ; cdr := None }
  {x__ag: K_assign}, {rest_ag: K_args} => Kjs_node &+ { kind := `list` ; car := x__ag ; cdr := rest_ag }
  {c__al: K_or} ? {y__al: K_assign} : {n__al: K_assign}, {rest_al: K_args} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `cond` ; c := c__al ; y := y__al ; n := n__al }) ; cdr := rest_al }
  {c__a2: K_or} ? {y__a2: K_assign} : {d__a2: K_or} ? {z__a2: K_assign} : {n__a2: K_assign}, {rest_a2: K_args} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `cond` ; c := c__a2 ; y := y__a2 ; n := (Kjs_node &+ { kind := `cond` ; c := d__a2 ; y := z__a2 ; n := n__a2 }) }) ; cdr := rest_a2 }
}
// (a name declared: given a value, or nothing given, `0`; any other value, as an arrow, is no constant and no statement of a
// function's, nothing)
K_decl &+= {
  {w_dc: K_word} => Kjs_node &+ { kind := `decl` ; name := w_dc ; v := None }
  {w_dc: K_word} = {v_dc} => Kjs_node &+ { kind := `decl` ; name := w_dc ; v := None }
  {w_dc: K_word} = {v__dc: K_assign} => Kjs_node &+ { kind := `decl` ; name := w_dc ; v := v__dc }
  {w_dc: K_word}: {t_dc} = {v__dc: K_assign} => Kjs_node &+ { kind := `decl` ; name := w_dc ; v := v__dc }
  {w_dc: K_word}: {t_dc: K_word} => Kjs_node &+ { kind := `decl` ; name := w_dc ; v := None }
}
K_decls &+= {
  {x__dcs: K_decl} => Kjs_node &+ { kind := `list` ; car := x__dcs ; cdr := None }
  {x__dcs: K_decl}, {rest_dcs: K_decls} => Kjs_node &+ { kind := `list` ; car := x__dcs ; cdr := rest_dcs }
  {w__dl: K_word} = {c__dl: K_or} ? {y__dl: K_assign} : {n__dl: K_assign}, {rest_dl: K_decls} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `decl` ; name := w__dl ; v := (Kjs_node &+ { kind := `cond` ; c := c__dl ; y := y__dl ; n := n__dl }) }) ; cdr := rest_dl }
  {w__d2: K_word} = {c__d2: K_or} ? {y__d2: K_assign} : {e__d2: K_or} ? {z__d2: K_assign} : {n__d2: K_assign}, {rest_d2: K_decls} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `decl` ; name := w__d2 ; v := (Kjs_node &+ { kind := `cond` ; c := c__d2 ; y := y__d2 ; n := (Kjs_node &+ { kind := `cond` ; c := e__d2 ; y := z__d2 ; n := n__d2 }) }) }) ; cdr := rest_d2 }
}
// (one given a default, `lo = 0`: its name, `=` and the default, each a parameter, as `jmp_of` takes each of its words)
K_params &+= {
  {w_pm: K_word} => Kjs_node &+ { car := w_pm ; cdr := None }
  {w_pm: K_word}, {rest_pm: K_params} => Kjs_node &+ { car := w_pm ; cdr := rest_pm }
  {w_pm: K_word} = {d_pm: K_word} => Kjs_node &+ { car := w_pm ; cdr := (Kjs_node &+ { car := `=` ; cdr := (Kjs_node &+ { car := d_pm ; cdr := None }) }) }
  {w_pm: K_word} = {d_pm: K_word}, {rest_pm: K_params} => Kjs_node &+ { car := w_pm ; cdr := (Kjs_node &+ { car := `=` ; cdr := (Kjs_node &+ { car := d_pm ; cdr := rest_pm }) }) }
  {w_pm: K_word}: {t_pm: K_word}, {rest_pm: K_params} => Kjs_node &+ { car := w_pm ; cdr := rest_pm }
  {w_pm: K_word}: {t_pm: K_word} => Kjs_node &+ { car := w_pm ; cdr := None }
}
// (statements: whole, `K_stmt`; without the `;` that ends them, `K_simple`; a head whose body is the block after it on the
// line, `K_head` (its body to be given, `s` none); a block on one line read here, one on more left to the line's rule)
K_stmt &+= {
  {e__st: K_seq}; => Kjs_node &+ { kind := `expr` ; e := e__st }
  return {e__st: K_assign}; => Kjs_node &+ { kind := `return` ; e := e__st }
  return{k_st: `;`} => Kjs_node &+ { kind := `return` ; e := None }
  break{k_st: `;`} => Kjs_node &+ { kind := `break` }
  continue{k_st: `;`} => Kjs_node &+ { kind := `continue` }
  const {d_st: K_decls}; => Kjs_node &+ { kind := `decls` ; list := d_st }
  let {d_st: K_decls}; => Kjs_node &+ { kind := `decls` ; list := d_st }
  {`{`} {`}`} => Kjs_node &+ { kind := `block` ; list := None }
  {`{`} {b_st: K_stmts} {`}`} => Kjs_node &+ { kind := `block` ; list := b_st }
  if ({c__st: K_assign}) {s__st: K_stmt} => Kjs_node &+ { kind := `if` ; c := c__st ; s := s__st ; o := None }
  if ({c__st: K_assign}) {s__st: K_stmt} else {o__st: K_stmt} => Kjs_node &+ { kind := `if` ; c := c__st ; s := s__st ; o := o__st }
  else {s__st: K_stmt} => Kjs_node &+ { kind := `else` ; s := s__st }
  while ({c__st: K_assign}) {s__st: K_stmt} => Kjs_node &+ { kind := `while` ; c := c__st ; s := s__st }
  do {s__st: K_stmt} while ({c__st: K_assign}); => Kjs_node &+ { kind := `do` ; s := s__st ; c := c__st }
  for {`(`} {i__st: K_simple}; {c__st: K_assign}; {u__st: K_seq} {`)`} {s__st: K_stmt} => Kjs_node &+ { kind := `for` ; i := i__st ; c := c__st ; u := u__st ; s := s__st }
  for {`(`} {i__st: K_simple}; {c__st: K_assign};{`)`} {s__st: K_stmt} => Kjs_node &+ { kind := `for` ; i := i__st ; c := c__st ; u := None ; s := s__st }
  for {`(`}; {c__st: K_assign}; {u__st: K_seq} {`)`} {s__st: K_stmt} => Kjs_node &+ { kind := `for` ; i := None ; c := c__st ; u := u__st ; s := s__st }
  for {`(`}{k_st: `;;`}{`)`} {s__st: K_stmt} => Kjs_node &+ { kind := `for` ; i := None ; c := None ; u := None ; s := s__st }
}
K_stmts &+= {
  {s__sts: K_stmt} => Kjs_node &+ { kind := `list` ; car := s__sts ; cdr := None }
  {s__sts: K_stmt} {rest_sts: K_stmts} => Kjs_node &+ { kind := `list` ; car := s__sts ; cdr := rest_sts }
}
K_simple &+= {
  {e__sm: K_seq} => Kjs_node &+ { kind := `expr` ; e := e__sm }
  return {e__sm: K_assign} => Kjs_node &+ { kind := `return` ; e := e__sm }
  {k_sm: `return`} => Kjs_node &+ { kind := `return` ; e := None }
  {k_sm: `break`} => Kjs_node &+ { kind := `break` }
  {k_sm: `continue`} => Kjs_node &+ { kind := `continue` }
  void {x__sm: K_word} => Kjs_node &+ { kind := `void` }
  const {d_sm: K_decls} => Kjs_node &+ { kind := `decls` ; list := d_sm }
  let {d_sm: K_decls} => Kjs_node &+ { kind := `decls` ; list := d_sm }
  if ({c__sm: K_assign}) {s__sm: K_simple} => Kjs_node &+ { kind := `if` ; c := c__sm ; s := s__sm ; o := None }
  if ({c__sm: K_assign}) {s__sm: K_stmt} else {o__sm: K_simple} => Kjs_node &+ { kind := `if` ; c := c__sm ; s := s__sm ; o := o__sm }
  else {s__sm: K_simple} => Kjs_node &+ { kind := `else` ; s := s__sm }
  while ({c__sm: K_assign}) {s__sm: K_simple} => Kjs_node &+ { kind := `while` ; c := c__sm ; s := s__sm }
  do {s__sm: K_stmt} while ({c__sm: K_assign}) => Kjs_node &+ { kind := `do` ; s := s__sm ; c := c__sm }
  for {`(`} {i__sm: K_simple}; {c__sm: K_assign}; {u__sm: K_seq} {`)`} {s__sm: K_simple} => Kjs_node &+ { kind := `for` ; i := i__sm ; c := c__sm ; u := u__sm ; s := s__sm }
  for {`(`} {i__sm: K_simple}; {c__sm: K_assign};{`)`} {s__sm: K_simple} => Kjs_node &+ { kind := `for` ; i := i__sm ; c := c__sm ; u := None ; s := s__sm }
  for {`(`}; {c__sm: K_assign}; {u__sm: K_seq} {`)`} {s__sm: K_simple} => Kjs_node &+ { kind := `for` ; i := None ; c := c__sm ; u := u__sm ; s := s__sm }
  for {`(`}{k_sm: `;;`}{`)`} {s__sm: K_simple} => Kjs_node &+ { kind := `for` ; i := None ; c := None ; u := None ; s := s__sm }
}
K_head &+= {
  if ({c__hd: K_assign}) => Kjs_node &+ { head := true ; kind := `if` ; c := c__hd ; s := None ; o := None }
  if ({c__hd: K_assign}) {h_hd: K_head} => Kjs_node &+ { head := true ; kind := `if` ; c := c__hd ; s := h_hd ; o := None }
  if ({c__hd: K_assign}) {s__hd: K_stmt} else => Kjs_node &+ { head := true ; kind := `if` ; c := c__hd ; s := s__hd ; o := (Kjs_node &+ { kind := `body` ; s := None }) }
  {k_hd: `else`} => Kjs_node &+ { head := true ; kind := `else` ; s := None }
  else {h_hd: K_head} => Kjs_node &+ { head := true ; kind := `else` ; s := h_hd }
  while ({c__hd: K_assign}) => Kjs_node &+ { head := true ; kind := `while` ; c := c__hd ; s := None }
  for {`(`} {i__hd: K_simple}; {c__hd: K_assign}; {u__hd: K_seq} {`)`} => Kjs_node &+ { head := true ; kind := `for` ; i := i__hd ; c := c__hd ; u := u__hd ; s := None }
  for {`(`} {i__hd: K_simple}; {c__hd: K_assign};{`)`} => Kjs_node &+ { head := true ; kind := `for` ; i := i__hd ; c := c__hd ; u := None ; s := None }
  for {`(`}; {c__hd: K_assign}; {u__hd: K_seq} {`)`} => Kjs_node &+ { head := true ; kind := `for` ; i := None ; c := c__hd ; u := u__hd ; s := None }
  for {`(`}{k_hd: `;;`}{`)`} => Kjs_node &+ { head := true ; kind := `for` ; i := None ; c := None ; u := None ; s := None }
  for {`(`} {i__hd: K_simple}; {c__hd: K_assign}; {u__hd: K_seq} {`)`} {h_hd: K_head} => Kjs_node &+ { head := true ; kind := `for` ; i := i__hd ; c := c__hd ; u := u__hd ; s := h_hd }
  while ({c__hd: K_assign}) {h_hd: K_head} => Kjs_node &+ { head := true ; kind := `while` ; c := c__hd ; s := h_hd }
}
// (a line that ends with a block on lines of its own: statements, then a head whose body that block is)
K_line_head &+= {
  {h_lh: K_head} => Kjs_node &+ { kind := `list` ; car := h_lh ; cdr := None }
  {s__lh: K_stmt} {rest_lh: K_line_head} => Kjs_node &+ { kind := `list` ; car := s__lh ; cdr := rest_lh }
}
// (a line led by a word the language's own rules are led by too, `if`, `return`: what follows the word, to the end of the
// line, read by these; the line's rule led by the word as theirs are, read before them. Its last hole takes what is left of
// the line: one before text ends where that text first is)
K_if_line &+= {
  {`(`}{c__il: K_assign}{`)`} {s__il: K_stmt} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `if` ; c := c__il ; s := s__il ; o := None }) ; cdr := None }
  {`(`}{c__il: K_assign}{`)`} {s__il: K_stmt} else {o__il: K_stmt} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `if` ; c := c__il ; s := s__il ; o := o__il }) ; cdr := None }
  {`(`}{c__il: K_assign}{`)`} {s__il: K_stmt} {rest_il: K_stmts} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `if` ; c := c__il ; s := s__il ; o := None }) ; cdr := rest_il }
  {`(`}{c__il: K_assign}{`)`} {s__il: K_stmt} else {o__il: K_stmt} {rest_il: K_stmts} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `if` ; c := c__il ; s := s__il ; o := o__il }) ; cdr := rest_il }
}
K_while_line &+= {
  {`(`}{c__wl: K_assign}{`)`} {s__wl: K_stmt} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `while` ; c := c__wl ; s := s__wl }) ; cdr := None }
  {`(`}{c__wl: K_assign}{`)`} {s__wl: K_stmt} {rest_wl: K_stmts} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `while` ; c := c__wl ; s := s__wl }) ; cdr := rest_wl }
}
K_else_line &+= {
  {s__el: K_stmt} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `else` ; s := s__el }) ; cdr := None }
  {s__el: K_stmt} {rest_el: K_stmts} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `else` ; s := s__el }) ; cdr := rest_el }
}
K_do_line &+= {
  {s__dl: K_stmt} while ({c__dl: K_assign}); => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `do` ; s := s__dl ; c := c__dl }) ; cdr := None }
  {s__dl: K_stmt} while ({c__dl: K_assign}); {rest_dl: K_stmts} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `do` ; s := s__dl ; c := c__dl }) ; cdr := rest_dl }
}
K_return_line &+= {
  {e__rl: K_assign}; => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { kind := `return` ; e := e__rl }) ; cdr := None }
}
K_if_head &+= {
  {`(`}{c__ih: K_assign}{`)`} {h_ih: K_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `if` ; c := c__ih ; s := h_ih ; o := None }) ; cdr := None }
  {`(`}{c__ih: K_assign}{`)`} {s__ih: K_stmt} else => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `if` ; c := c__ih ; s := s__ih ; o := (Kjs_node &+ { kind := `body` ; s := None }) }) ; cdr := None }
  {`(`}{c__ih: K_assign}{`)`} {s__ih: K_stmt} else {h_ih: K_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `if` ; c := c__ih ; s := s__ih ; o := h_ih }) ; cdr := None }
  {`(`}{c__ih: K_assign}{`)`} {s__ih: K_stmt} {rest_ih: K_line_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `if` ; c := c__ih ; s := s__ih ; o := None }) ; cdr := rest_ih }
}
K_else_head &+= {
  {h_eh: K_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `else` ; s := h_eh }) ; cdr := None }
  {s__eh: K_stmt} {rest_eh: K_line_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `else` ; s := s__eh }) ; cdr := rest_eh }
}
K_while_head &+= {
  {`(`}{c__wh: K_assign}{`)`} {h_wh: K_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `while` ; c := c__wh ; s := h_wh }) ; cdr := None }
  {`(`}{c__wh: K_assign}{`)`} {s__wh: K_stmt} {rest_wh: K_line_head} => Kjs_node &+ { kind := `list` ; car := (Kjs_node &+ { head := true ; kind := `while` ; c := c__wh ; s := s__wh }) ; cdr := rest_wh }
}

