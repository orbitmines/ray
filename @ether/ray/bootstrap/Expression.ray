  static called (c, args, named) => (c is Pattern) ? Runtime.pattern_called(c, args) : ((c is Curried) ? Runtime.curried_called(c, Runtime.curried_function(c), args, named) : ((c is Applied) ? Runtime.applied_called(c, Runtime.applied_rule(c), args, named) : ((c is Builtin) ? Runtime.builtin_called(c, args) : ((c is Class) ? construct(c, args, named) : ((c is Closure) ? Runtime.closure_called(c, args, named) : None)))))
  static pattern_called (p: Pattern, args) => (p.kind == with_function) ? Pattern(kind: functioned, a: p, b: args) : None
  static curried_function (c: Curried) => c.function
  static curried_called (c: Curried, f: Closure, args, named) => indirect(Runtime.defined_as(node(f.env), Symbol.this, c.value), args, named, f.function)
  static applied_rule (c: Applied) => c.rule
  static applied_called (c, f: Closure, args, named) => indirect(applied_again(c), args, named, f.function)
  static builtin_called (b: Builtin, args) => ((b.id == Symbol.sort) ? sorted(b.self, arg(args, 0)) : ((b.id == Symbol.for) ? each(b.self, arg(args, 0)) : ((b.id == Symbol.map) ? each_value(b.self, arg(args, 0)) : ((b.id == placed) ? place(arg(args, 0), arg(args, 1)) : ((b.id == members_listed) ? members_of(arg(args, 0)) : None)))))
