// JSON: read into a document and written back.

mark ^keyword := global

json := JSON.read("{\"name\": \"x\", \"list\": [1, true, null], \"inner\": {\"a\": \"b\\n\"}}")
unless json.name == "x" { INFO@mark `JN1 a JSON member is not read` }
unless json.list.count == 3 { INFO@mark `JN2 a JSON array is not three` }
unless json.list[1] == true { INFO@mark `JN3 JSON true is not true` }
unless json.inner.a == "b" + \n { INFO@mark `JN4 a JSON escape is not read` }
unless $.json.write([1, "a"]) == "[1, \"a\"]" { INFO@mark `JN5 a list is not written as JSON` }
unless JSON.read($.json.write(json)).inner.a == json.inner.a { INFO@mark `JN6 written JSON does not read back` }
unless $.json === JSON { INFO@mark `JN7 $.json is not the JSON language` }

who := "Ray"
inline_json := @json {"name": {who}, "tags": ["a", {who}], "none": null}
unless inline_json.name == "Ray" && inline_json.tags.last == "Ray" && inline_json.none === None { INFO@mark `JN8 a single-line json fragment is not its document with the holes' values` }
json_block := @json {
  {"name": {who}, "list": [1, true, null], "inner": {"a": {who}}}
}
unless json_block.name == "Ray" && json_block.list.count == 3 && json_block.inner.a == "Ray" && JSON.read($.json.write(json_block)).inner.a == "Ray" { INFO@mark `JN9 a json block is not its document with the holes' values` }
// One grammar: what the header reads, written inline, is the same document (ECMA-404 §5–§8)
unless (@json {"list": [1, {who}]}).list == JSON.read("{\"list\": [1, \"Ray\"]}").list { INFO@mark `JN10 an inline json fragment and the same text read are other documents` }

// The examples of RFC 8259 §13, each written on one line (https://www.rfc-editor.org/rfc/rfc8259#section-13)
rfc_image := JSON.read("{\"Image\": {\"Width\": 800, \"Height\": 600, \"Title\": \"View from 15th Floor\", \"Thumbnail\": {\"Url\": \"http://www.example.com/image/481989943\", \"Height\": 125, \"Width\": 100}, \"Animated\": false, \"IDs\": [116, 943, 234, 38793]}}")
unless rfc_image.Image.Width == 800 && rfc_image.Image.Thumbnail.Url == "http://www.example.com/image/481989943" && rfc_image.Image.Animated == false && rfc_image.Image.IDs[3] == 38793 { INFO@mark `JN11 the object of RFC 8259 §13 does not read its members` }
rfc_places := JSON.read("[{\"precision\": \"zip\", \"Latitude\": 37.7668, \"Longitude\": -122.3959, \"Address\": \"\", \"City\": \"SAN FRANCISCO\", \"State\": \"CA\", \"Zip\": \"94107\", \"Country\": \"US\"}, {\"precision\": \"zip\", \"Latitude\": 37.371991, \"Longitude\": -122.026020, \"Address\": \"\", \"City\": \"SUNNYVALE\", \"State\": \"CA\", \"Zip\": \"94085\", \"Country\": \"US\"}]")
unless rfc_places.count == 2 && rfc_places[0].Longitude == -122.3959 && rfc_places[1].City == "SUNNYVALE" && rfc_places[1].Address == "" { INFO@mark `JN12 the array of two objects of RFC 8259 §13 does not read its members` }
unless JSON.read("\"Hello world!\"") == "Hello world!" && JSON.read("42") == 42 && JSON.read("true") == true { INFO@mark `JN13 the three small texts of RFC 8259 §13 do not read as their values` }
