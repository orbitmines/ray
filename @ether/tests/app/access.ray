// What a capability nobody granted answers; each platform's own form is its language in $/.

mark ^keyword := external global

unless Device().permission(Device.Capability.camera) == Grant.State.prompt { INFO@mark `AC26 a capability nobody granted is not asked for` }

// confidential follows the policy, but never past @private.managed.
with Visibility.policy = Accessor.Permission.public {
  unless Accessor.Permission.confidential.resolved == Accessor.Permission.managed { INFO@mark `CK1 confidential widens with a public policy` }
  if Accessor.Permission.confidential.reaches(Character(name: "stranger")) { INFO@mark `CK2 confidential reaches a stranger under a public policy` }
}
with Visibility.policy = Accessor.Permission.local {
  unless Accessor.Permission.confidential.resolved == Accessor.Permission.local { INFO@mark `CK3 confidential is wider than a narrower policy` }
}

// A grant names an expression: a derivative may be granted where the value it derives from is not.
gx_reader := Character(name: "reader")
gx := (count: 3, secret: "s")
gx_reader.read gx.count
gx_grant := Permissions.current.grants.last
unless gx_grant.target is Program { INFO@mark `GX1 a grant took the value of what it names instead of the expression` }
unless gx_grant.names(Program(code: { gx.count })) { INFO@mark `GX2 a grant does not name the expression it was given` }
if gx_grant.names(Program(code: { gx.secret })) { INFO@mark `GX3 a grant on one derivative names another` }
unless Permissions.current.allows(gx_reader, `count`, Program(code: { gx.count })) { INFO@mark `GX4 a granted derivative is refused` }
if Permissions.current.allows(gx_reader, `secret`, Program(code: { gx.secret })) { INFO@mark `GX5 a grant on a count lets another field leave` }
gx_whole := (count: 1)
gx_reader.read gx_whole
unless Permissions.current.allows(gx_reader, `size`, gx_whole) { INFO@mark `GX6 a grant naming a value does not cover that value` }

// const is none.write: nobody may write it, and what it holds inherits that.
cst := const (count: 1)
unless cst.access.who == Accessor.Permission.none { INFO@mark `CST1 const is not the permission nobody has` }
if Accessor.Permission.none.reaches(Character(name: "anyone")) { INFO@mark `CST2 the permission nobody has reaches someone` }
unless Accessor.Permission.none < Accessor.Permission.local { INFO@mark `CST3 the permission nobody has is not the narrowest` }

// A permission's who is any narrowing: a policy by situation is a grant to it.
nrw_room := Instance(location: "nrw-room")
nrw_near := Character(name: "near", presence: nrw_room)
nrw_far := Character(name: "far")
nrw_target := (lamp: 1)
Character{presence === nrw_room}.read nrw_target
unless Permissions.current.allows(nrw_near, `size`, nrw_target) { INFO@mark `NRW1 a grant to a narrowing refuses who satisfies it` }
if Permissions.current.allows(nrw_far, `size`, nrw_target) { INFO@mark `NRW2 a grant to a narrowing allows who does not satisfy it` }

// Checking a permission runs no one's code: a grant whose expression or filter has effects is refused when granted, and never run.
purg_reader := Character(name: "purg-reader")
purg_count := Permissions.current.grants.count
unless Permissions.current.grant(Access(who: purg_reader, method: Access.Reading), Program(code: { IO().output("leak") })) is Diagnostic { INFO@mark `PURG1 a grant naming an expression with effects is granted` }
unless Permissions.current.grant(Access(who: purg_reader, method: Access.Reading, filter: Program(code: { IO().output("leak") })), (lamp: 1)) is Diagnostic { INFO@mark `PURG2 a grant whose filter has effects is granted` }
unless Permissions.current.grants.count == purg_count { INFO@mark `PURG3 a refused grant is kept` }
if Grant(Access(who: purg_reader, method: Access.Reading), Program(code: { IO().output("leak") })).names("leak") { INFO@mark `PURG4 checking a grant runs an expression with effects` }
if Permissions.current.grant(Access(who: purg_reader, method: Access.Reading), Program(code: { Time.now })) is Diagnostic { INFO@mark `PURG5 a grant reading the time is refused` }
