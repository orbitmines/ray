`{string: String}` => string
{`//`}{comment: String} =>

// Grouping: that parentheses, brackets and braces nest is not built in — it
// follows from these rules being active while scanning.
{`{`}{expr}{`}`} => TODO
({expr}) => expr
[{expr}] => expr

external {`class `}{name}{block}

class Program
  external ({args}) =>
  {` `}{expr} => this(expr)

class Node

  // The grammar-rule definition rule itself: the bootstrapper hardcodes this
  // shape for this file only; once declared here, the interpreter relies on
  // this declaration for every file that follows.
  external {(String.Word | `{`, expr, `}`)[]}{`=>`}{body}

  {`.`}{property} => this[property]

  // When bootstrapping, function definitions cannot use '&=', which is the actual default set lower in this file.
  static DEFINE_METHOD = `=`

  // Function definition
  {` `}({args}){block} => this [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def
  )

  test () TODO

  external static
  external [{property}]
  external **: Program
  external = (x): x


// Set the actual method used for function definitions.
Node.DEFINE_METHOD = `&=`