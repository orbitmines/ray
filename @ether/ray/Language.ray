Language := class: Ray extensions: String, level: Compiler?, written: Compiler?, stored: Compiler?, of: Language?, version: Version?, implementations: Implementation[] = [], targets: Language[] = [] {
  static loaded_named (extension: String) => Language#{.names(extension)} -- (all => all{!.of}.first ?? all.first)
  static named (extension: String) => loaded_named(extension) ?? (Project.declared.find(.project && loaded_named(extension)) && loaded_named(extension))
  static over (outer: Language, base: Language) => Language(outer.extensions, level: base.level + outer.level, written: base.written + outer.written, of: base, version: outer.version) @ outer.location

  static for_file (file_name: String) => file_name ~= (*, ".", inner: Char.Word[], ".ray") ⊣
    ? (named("." + inner) ? over(named("." + inner), ray) : ray)
    : named("." + (file_name ~= (*, ".", last: Char.Word[]) ⊣)?.last) ?? ray

  static detected (content: String) => Language#{.level && !.read(content).erred}

  static project (name: String) => Project#{.name == name}.first
    ?? Project.known(ray.bundled("$/" + name)) -- (found => found ~~ (.name = name) ~~ .load if found)
  static found (name: String) => name.lower_case -- (lowered => lowered == "ray" ? ray
    : (project(lowered) ? Language#{.names("." + lowered)}.last : named("." + lowered)) ?? ERROR@Language `no language by that name`)

  static Lossless := Language{forall value is *#: read(write(value)) == value}

  static Writing := class value: *, language: Language?
  static unwrapped := {
    {writing: Writing} => writing.value
  }
  static ray_written := {
    {writing: Writing{value === None}} => "None"
    {writing: Writing{value is String}} => "\"", writing.value.escaped_line, "\""
    {writing: Writing{value is Number}} => writing.value as 10 as String
    {writing: Writing{value is Iterable}} => "[", writing.value.map((", " if .index > 0), Writing(.)), "]"
    {writing: Writing} => "(", writing.value.fields.map((", " if .index > 0), .name, ": ", Writing(.value)), ")"
  }

  names (extension: String) => extension is extensions#
  bundled (path: String) => location#.map(. / path){(. / ".project.ray").held as boolean}.first.held as Project

  admits (program) => true
  read (source) => level
    ? (Compiler.reduced(source, level + (stored ?? Compiler.none)) -- (admits(.) ? . : ERROR `this file is written in a sublanguage that does not permit what it does`))
    : ERROR@Language `the language has no reader`
  write (value) => written
    ? (Compiler.reduced(Writing(value, language: this), unwrapped + written + (stored ?? Compiler.none)) -- (. is Location ? . : . as String))
    : ERROR@Language `the language has no writer`
  written_to (value, location: Location) => write(value) -- (. is Location ? .files.for(file => (location / file.path).held = file.content) : location.held = .) -- location
  converted (location, from: Language) => write(from.read(location))
  tree_at (location: Location, label) => read(location).at(label).tree

  targeting (language: Language) => language is targets#
  backwards_compatible => previous**.every(.targeting(this))
  forwards_compatible => next**.every(.targeting(this))

  static Implementation := class language: Language, written_in: Language {
    level => written_in.read(location.held as String)
    setup => language ~~ .implementations.push this ~~ .level ??= level
  }

  static ray: Lossless = (Language(".ray", level: Compiler.default, written: ray_written) @ (@ether/ray | @ether))
  static cfg := Language(".cfg", level: ray.level, written: ray.written, of: ray){admits Program{Pure & Terminating}}
  static regex := Language(".regex")
}

$.{name: (Char.Word | "+" | "#" | "-")[]} ^keyword => Language.found(name as String)

Node &+= {
  as (language: Language) => language.write(this)
}
