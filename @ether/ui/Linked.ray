// JSON-LD 1.1: a Ray value as linked data, written with $.json (https://www.w3.org/TR/json-ld11/)
// Its fields are properties and its type is @type (https://www.w3.org/TR/json-ld11/#specifying-the-type), under the vocabulary its @context names (https://www.w3.org/TR/json-ld11/#the-context)
UI.Linked := class (value: *, context: String?) => {
  document => value === None || value is (String | Number | boolean | Location) ? value
    : value is Iterable ? value.map(UI.Linked(.).document)
    : Document(entries: [(name: "@context", value: context) if context, value.fields{.value != None}.map((name: .name == "type" ? "@type" : .name, value: UI.Linked(.value).document))].flatten)
}
