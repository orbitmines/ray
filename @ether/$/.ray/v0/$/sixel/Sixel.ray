// Sixel graphics, VT330/VT340 Programmer Reference Manual chapter 14 (https://vt100.net/docs/vt3xx-gp/chapter14.html)
Sixel := class: Language {
  static extensions = ".sixel" | ".six"
  written := {
    {writing: Language.Writing{value is Geometry.Raster}} => "\eP0;0;0q", encoded(writing.value), "\e\\"
  }
  static encoded (raster: Geometry.Raster) => raster.flatten.unique.enumerate -- (palette => (
    palette.map("#", .index, ";2;", .value.red * 100 / 255, ";", .value.green * 100 / 255, ";", .value.blue * 100 / 255),
    (0..<(raster.height + 5) / 6).map(band => palette.map(
      "#", .index, (0..<raster.width).map(x => ((0..<6).map(row => raster.at(x, band * 6 + row) == .value ? 2 ^ row : 0).sum + 63) as Char), "$"
    ), "-")
  ))
}
