Skill := class: Nameable = quests: *, baseline = 0 {
  solved: Program?

  covers (quest: Program) => quest is quests
  solve (quest: Program): static => this ~~ .solved = quest
  recent (within: Quantity.Temporal) => solved.history{Time.now - .when < within}
  proficiency (within: Quantity.Temporal) => {
    counted = recent(within).count
    counted < baseline ? baseline + (counted - baseline) / 2 : counted
  }
  settle: static => this ~~ .baseline = solved.history.count
}

Mana := class = resource: String, capacity: *, held: Spell? {
  static measured (resource: String) => Mana(resource, capacity: @me/device/os[resource])

  cast (spell: Spell) => held = spell
  free: static => this ~~ .held = None
  concentrating => held != None
}

Spell := class = operation: *, cost: *, progress = 0, interrupt_level = 0 {
  interrupted_by (level) => interrupt_level < level
}

Presence := @me/device/memory | @me/device/disk | @remote

Room := class: Location = value: * {
  items => value.fields
  enter (item) => (this / item.name) ~~ (.value = item.value)
}

Onboarding := class {
  language: Language?
  purpose: everything | tools_only = everything
  network: Accessor.Permission = Accessor.Permission.public
  look: realistic | voxel = realistic

  dialogue => purpose == everything
}
