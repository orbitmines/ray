// Static Analysis Results Interchange Format 2.1.0 (https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html)
SARIF := class: Language {
  static extensions = ".sarif"

  // result.level (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317648)
  static Levels = { fatal: "error", error: "error", warn: "warning", info: "note", debug: "none", trace: "none" }
  // physicalLocation and region, one-based lines and columns (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317685)
  static location (at: Location?) => at ? (physicalLocation: (artifactLocation: (uri: at.file as String),
    region: (startLine: at.from?.line ?? 1, startColumn: at.from?.column ?? 1, endLine: at.to?.line ?? 1, endColumn: at.to?.column ?? 1))) : None

  written := {
    {writing: Language.Writing{value is Diagnostic}} => Language.Writing([writing.value])
    // sarifLog (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317478)
    {writing: Language.Writing{value is Diagnostic[]}} => JSON.write(Document(entries: [
      (name: "$schema", value: "https://json.schemastore.org/sarif-2.1.0.json"),
      (name: "version", value: "2.1.0"),
      // run, tool.driver and columnKind (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317484)
      (name: "runs", value: [(
        tool: (driver: (name: "ray", informationUri: "https://orbitmines.com", rules: writing.value.map(.code).compact.unique.map((id: .)))),
        columnKind: "unicodeCodePoints",
        // result (https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/sarif-v2.1.0-os.html#_Toc34317638)
        results: writing.value.map(diagnostic => (
          ruleId: diagnostic.code,
          level: Levels[diagnostic.severity.name],
          message: (text: diagnostic.message as String),
          locations: [location(diagnostic.at)].compact,
          relatedLocations: diagnostic.related.enumerate.map(cause => (id: cause.index, message: (text: cause.value.message as String), physicalLocation: location(cause.value.at)?.physicalLocation)) -- (. if .nonempty)
        ))
      )])
    ]))
  }
}
