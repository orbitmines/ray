Entity := class {
  key: *?

  chainable == (other) => key ? key == other.key : this === other
}

Nameable := class {
  static PREFIX: String?
  name: String?

  named (name: String): static => this ~~ .name = name
}

Location := class: Hierarchy (
  (scheme: Char.Word[], "://", host: Char{!= ":" && != "/" && != "?" && != "#"}[], (":", port: Decimal)?)?,
  path: Char{!= "?" && != "#"}[],
  ("?", query: Query{pairs.nonempty} = Query())?,
  ("#", fragment: Char[])?
) => {
  static Query := class ((pairs: (name: Encoded, ("=", value: Encoded)?)[]).join("&")) {
    static Encoded := class: String ((Char.Letter | Char.Digit | "-" | "_" | "." | "~" | ("+" as " ") | ("%", Hexadecimal²)[]{length > 0} as Unicode.UTF-8)[])
    merged (changes) => Query(pairs: [pairs{!changes.fields.name.contains(.name)}, changes.fields{.value != None}.map((name: .name, value: .value as String))].flatten)
    .{literal name ^property} ^punctuation => .declaring(name) ? external get this name : pairs{.name == name && .value?.nonempty}.last?.value
  }

  segments => path.split("/"){.nonempty}
  with (changes) => Location(scheme, host, port, path, query: query.merged(changes), fragment)

  + (suffix) => ((this as String) + (suffix as String)) as Location
  / (segment: String) => this + "/" + segment
  /{segment: Written} ^string => this + "/" + segment
  { }/{segment: Written} ^string => this + "/" + segment
  { }{value} => this + value if this as String ~= ("/" | "@" | "=" | "?" | "&" | "#") ⊣
  { }.{piece: Written} ^string => this + "." + piece
  == (other) => this as String == other as String

  shadowing: Location?
  [name: String] => fields{.name == name}.last?.value ?? (shadowing ?? parent ?? (World.ether unless this === World.ether))?[name]
}

Written := (Char{!= " " && != "(" && != ")" && != "," && != "{" && != "}" && != \n} | ("(", Written, ")"))[]
@{scheme: Char.Word[]}://{rest: Written} ^string => (scheme + "://" + rest) as Location
@"{text: (!"\"")[]}" ^string => text as Location
@{start: ("." | "..")?}/{path: Written} ^string => (start + "/" + path) as Location
@me ^string => &caller as Character ?? Instance.local
@me/{path: Written} ^string => path.split("/" | ".").reduce(acc = @me => acc.`.`)
@{name: Char.Word[]}/{path: Written} ^string => (name + "/" + path) as Location
@{who: (Char.Word | "-")[] | UUID} {{block}} ^keyword => Program(code: external ** block).run_as(Character.local(who) ?? ERROR `a block runs as a character only when that character is here`)

Program &+= {
  run_as (who: Character) => {
    with { &caller = who }
    this()
  }
}

Node &+= {
  history: History = History(repository: this)
}

History := class: Iterable = repository: *?, base: Commit?, head: Commit? {
  static Label := UUID | Char.Word[]

  static Commit := class: Ray (
    id: Label = UUID.v4(), "\\",
    (" ", from: Label[].join(" & "))?,
    (" ", stamp: Stamp)?,
    (" @", who: Character | UUID = &caller)?,
    ((" { ", program: Program, " }") | ((" " | \n), program: Program)),
    (\n | ⊣)
  ) => {
    when: Time = stamp?.when ?? Time.now
    visibility: Accessor.Permission = Accessor.Permission.private
    message: String?
    previous: Commit?
    line: History?

    parents => previous#
    next => line?.since(None){.parents.first === this}.first
    ancestry => (previous#.map(.ancestry).flatten, this).unique(===)
    merged => parents.count > 1
    staged => visibility == Accessor.Permission.private
    publish: static => this ~~ .visibility = Accessor.Permission.public
    applied (held) => held -- program
    rewritten (program: Program) => Commit(id, stamp, who, program, when, message, previous, line)
    value => line?.at(this).value ?? applied(None)
    written (above: Commit? = None) => (this ~~ .from = (parents.id unless parents.empty || parents == [above])) as String
    substitutes => program.written.map(.code ~= (⊢"{value}%[", label: Label, "] => ")).find(.)?.label

    .{literal name ^property} ^punctuation => .declaring(name) ? external get this name : external get value name
  }

  name: String?
  id => since(None).first?.id
  location => repository?.location
  clock => repository?.clock ?? World.ether.clock
  written_last: Commit?
  caches: History[] = []

  since (commit: Commit?) => head ? head.ancestry.filter(c => !(commit?.ancestry ?? []).some(=== c)) : []
  commits => since(base)
  entry => commits.entry
  last | latest => head
  find (label) => since(None).find(.id == label)
  at (commit) => History(repository, head: commit is Commit ? commit : find(commit), caches)

  commit (who, change, id: Label = UUID.v4(), when: Time = Time.now, message: String? = None): static => this ~~ .head = Commit(id, stamp: clock.now, who,
    program: change is Program ? change : Program(code: { change }), when, message, previous: head, line: this)
  extended (commit: Commit): static => this ~~ .head = commit ~~ (.previous = commit.from ? commit.from.map(find(.))# : head) ~~ .line = this
  published => commits{!.staged}
  publish: static => this ~~ commits#.publish

  ordered => since(None).sort_by(.stamp)
  stretches (start: Program, end: Program) => ordered.reduce(acc = (closed: [], open: None) => acc.open
    ? (end.entered(., None) ? (closed: [acc.closed, [[acc.open, [.]].flatten(1)]].flatten(1), open: None) : (closed: acc.closed, open: [acc.open, [.]].flatten(1)))
    : start.entered(., None) ? (closed: acc.closed, open: [.]) : acc
  ) -- [.closed, [.open] if .open].flatten(1)
  {this}{from {literal start} to {literal end}} ^punctuation => stretches(Program(code: external ** start), Program(code: external ** end))
  {this}{from {literal start}} ^punctuation => Program(code: external ** start) -- (holds => stretches(holds, Program(code: { !holds.entered(this, None) })))
  value => ordered.reduce(held = None => .applied(held))
  pinned (label, as_of: Stamp? = None) => since(None).find(c => c.substitutes == label && (as_of === None || c.stamp < as_of))?.id ?? label
  checkout (label, as_of: Stamp? = None) => at(pinned(label, as_of)).value
  fix (who, label: Label, change) => UUID.v4() -- (made => commit(who, ("{value}%[" + label + "] => value%[" + made + "]\n" + Language.ray.write(change)) as Program, id: made))
  tree => value -- (held => Language.Entry.of(held.fields{.value != None}.map((path: .name, content: Language.ray.write(.value) as Byte[]))))

  fork => History(repository, base: head, head)
  drop: static => reset(base)
  reset (to: Commit?): static => this ~~ .head = to
  back: static => reset(head?.previous ?? head)
  run (program: Program) => Program(code: program.code, history: this)()

  common (other: History) => since(None).filter(c => other.since(None).some(=== c)).last
  static clashes (base, ours, theirs) => ours == theirs || ours == base || theirs == base ? []
    : ours.fields.nonempty && theirs.fields.nonempty ? (ours.fields.name, theirs.fields.name).flatten.unique.map(name => clashes(base?[name], ours[name], theirs[name])).flatten
    : [(ours, theirs)]
  merge (other: History, who = &caller) => common(other) -- (base => {
    return Quest(name: "merge", goal: other) if clashes(at(base).value, value, other.value).nonempty
    this.head = since(base).empty ? other.head : other.since(base).empty ? head : Commit(stamp: clock.now, who, program: Program(code: { . }), previous: head | other.head, line: this)
    this
  })
  static global (histories: History[]) => History(head: History.Commit(who: None, program: Program(code: { . }), stamp: histories.head#.stamp.max, previous: histories.head#))
  squash (who) => History(repository, base, head: Commit(stamp: clock.now, who, program: commits.sort_by(.stamp).reduce(held = Program() => held + .program), previous: base))
  cherry_pick (change: Commit): static => commit(change.who, change.program, message: change.message)
  revert (change: Commit) => change.program⁻¹ ? commit(change.who, change.program⁻¹) : Quest(name: "revert", goal: change)

  received (stamp: Stamp) => clock.receive(stamp)
}

Repository := class = world: World?, histories: History[] = [], location: Location? {
  id: UUID = UUID.v4()
  clock: HybridClock = HybridClock(node: id)

  branch (name: String) => histories.find(.name == name)
  global => History.global(histories)
}

World := class: Location + Nameable {
  static PREFIX = "#"
  static ether = World(name: "ether", path: "ether")

  clock: HybridClock = HybridClock(node: this)
  dynamics: Program?
  tick: static => this ~~ dynamics?(this)
  population => characters#.count

  class{>.instance_of Nameable}#.for class => {
    `class.name.plural`: class[] => children{is class}
    {class.PREFIX}{name: reservable_names} => children**{is class && .name.ignore_case == name.ignore_case}.first
      ?? (shadowing ?? parent ?? World.ether)[class.PREFIX, name] if class.PREFIX
  }

  static Reservation := class = name: reservable_names, issuer: World, holder: *?
  reservations: Reservation[] = []

  reserved (name: String) => reservations{.name.fold_case == name.fold_case}.first
  issue (name: reservable_names) => Reservation(name, issuer: this) ~~ reservations.push(.)
  reserve (name: reservable_names) => reserved(name) ?? issue(name)
  allocate (name: reservable_names, holder) => reserve(name) ~~ .holder = holder
  allocated (name: String) => reserved(name)?.holder
}
Region := World

Quest := class: Nameable {
  goal: *
  from: *?
  steps: *[] = []
  tried: *?
  done = false

  reached (value) => value is goal
  attempt (value): static => this ~~ (.tried = value) ~~ (.done = true if reached(value))
  path => tried.history
  solution => path{reached(.value)}.first
  solved_by => solution?.who
  best => solution?.value

  step (description): static => this ~~ steps.push description
  refined => steps.every(. is Quest)
  progress => steps{. is Quest && .done}.count
  difficulty => steps.count

  complete: static => this ~~ .done = true
}

Task := class: Quest {
  interrupted = false

  interrupt: static => this ~~ .interrupted = true
}

Item := class: Nameable {
  issuer: World
  location: Location?
  obtained_by: Quest?
  certificate: Certificate?

  trail => location.history
}

Certificate := class = issuer: World, secret: *, issued_on: Time = Time.now

Platform := class: Location + Nameable {
  icon: *?

  avatar (handle: String, character: Character) => Avatar(character, platform: this, handle)
}

Reference := class {
  title: String
  subtitle: String?
  date: Time = Time.now
  organizations: Organization[] = []
  authors: Character[] = []
  published: *[] = []
  location: Location?
  journal: *?
  volume: *?
  pages: *?
  publisher: *?
  note: String?
  visibility: Accessor.Permission = Accessor.Permission.private

  year => date.year
  notes => note.history
  draft => visibility == Accessor.Permission.private
  publish: static => this ~~ .visibility = Accessor.Permission.public
}

Instance := class: Location + Entity {
  static local = Instance(location: "localhost")

  location: *
  device: Device = Device()
  status: Status = Status.online
  registry: Character?
  hosted: Character?
  deletions: Deletion[] = []

  login (character: Character) => (registry |= character) -- character
  logged_in (character: Character) => registry ∋ character
  logout (character: Character, delete_all = false) => {
    registry = registry#{!== character}
    if delete_all {
      character.key = None
      deletions.push Deletion(character, due: Time.now + 30 days)
    }
    character
  }
  swap (from: Character, to: Character) => {
    logout(from)
    login(to)
  }

  host_for (character: Character) => character ~~ (hosted |= .) ~~ .presence = this
  mirror (value, depth = 1) => Mirror(value, location: this, depth)
  .{literal name ^property} ^punctuation => .declaring(name) ? external get this name : external get device name

  static Deletion := class: Quest (character: Character, due: Time) {
    name = "delete"
    goal => character
    cancelled = false

    cancel: static => this ~~ .cancelled = true
    pending => !cancelled && !done
  }

  static Mirror := class = value: *, location: Instance, depth = 1 {
    synced => location.registry#.nonempty
  }
}

Status := enum online | offline | hosted | broadcast | proxy | invisible | idle | do_not_disturb | busy

Character := class: Hierarchy + Entity + Nameable {
  static PREFIX = "@"
  static local (who) => who == "me" ? @me : (Instance.local.registry, Instance.local.hosted)#.find(.id == who || .name?.fold_case == (who as String).fold_case)

  id: UUID = UUID.v4()

  presence: Instance?
  status: Status = Status.offline
  permissions: Accessor.Permission?

  first_name: String?
  last_name: String?
  email: String?
  profile_picture: *?
  profile: *?

  avatars => children{is Avatar}
  full_name => first_name ? first_name + " " + last_name : name
  device => (presence ?? Instance.local).device
  jobs => device.jobs
  status_now => presence?.status ?? status

  choose (s) => Choice(type: s)

  read => Access(this)
  write => on(`=`)
  execute => on(`()`)
  on (method) => Access(this, method)
}

Avatar := class: Character {
  character: Character
  platform: Platform?
  handle: String?
  location: Location? = (platform / handle if platform && handle)
  skills: Skill[] = []

  traversed => location.history
  unlock (skill: Skill): static => this ~~ skills.push skill
  copied => Avatar(character, platform)
  compounds + (other: Avatar): static => this ~~ (.skills = (skills, other.skills).unique) ~~ .location.history.merge(other.location.history)
}

Player := class: Character

NPC := class: Character {
  static Mode := enum until_resolved | waiting | stopping

  status = Status.hosted
  mode: Mode = Mode.until_resolved

  open_quests => children{is Quest && !.done}
  running => mode == Mode.waiting || mode == Mode.until_resolved && open_quests.nonempty
}

Organization := class: Player {
  logo: *?
  website: *?

  members => children{is Character}
}
