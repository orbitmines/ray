  // where the value's kind holds it)
  static member (mf, mn, me) => Lowered.is_section(Compiled.trimmed(mf)) ? Lowered.leaf(mn, Array.new) : ((Compiled.trimmed(mf) == `Symbol`) ? High.number(level cw_symbol_of (mn)) : Lowered.field_read(mf, mn, me))
  static field_read (rf, rn, re) => {
    Lowered.w("(load ")
    Lowered.field_at(rf, rn, re)
    Lowered.w(")")
  }
  static indexed (xf, xi, xe) => {
    Lowered.w("(load ")
    Lowered.word_at(xf, xi, xe)
    Lowered.w(")")
  }
  static field_at (ff, fn, fe) => {
    Lowered.w("(")
    Lowered.expression(ff, fe)
    Lowered.w(" + ")
    High.number(Lowered.offset(Lowered.field_holder(Lowered.type_of(ff, fe), fn), fn))
    Lowered.w(")")
  }
  static word_at (xf, xi, xe) => {
    Lowered.w("(")
    Lowered.expression(xf, xe)
    Lowered.w(" + (")
    Lowered.expression(xi, xe)
    Lowered.w(" * 4))")
  }
  // (a field or a word given: written where it is held; a local given, given. In memory a run manages (`managed`, a
  // level), what is written goes by the back end's `written`, told what holds the word, where it is, and what)
  static managed := true
  static set (sp, sv, se) => (Lowered.kind(sp) == `member_from`) ? Lowered.word_set(Lowered.parsed(sp).member_from, sp, sv, se) : ((Lowered.kind(sp) == `indexed_of`) ? Lowered.word_set(Lowered.parsed(sp).indexed_of, sp, sv, se) : Lowered.local_set(sp, sv, se))
  static word_set (wh, wp, wv, we) => {
    Lowered.place(wp, we)
    Lowered.w(" <- ")
    (Lowered.managed && Lowered.managed_kind(Lowered.type_of(wh, we))) ? Lowered.written(wh, wp, wv, we) : Lowered.expression(wv, we)
  }
  static local_set (lp, lv, le) => {
    Lowered.expression(lp, le)
    Lowered.w(" = ")
    Lowered.expression(lv, le)
  }
  static written (wh, wp, wv, we) => {
    Lowered.w("written(")
    Lowered.expression(wh, we)
    Lowered.w(", ")
    Lowered.place(wp, we)
    Lowered.w(", ")
    Lowered.expression(wv, we)
    Lowered.w(")")
  }
  static place (pp, pe) => (Lowered.kind(pp) == `member_from`) ? Lowered.field_at(Lowered.parsed(pp).member_from, Compiled.trimmed(Lowered.parsed(pp).member_name), pe) : Lowered.word_at(Lowered.parsed(pp).indexed_of, Lowered.parsed(pp).index_at, pe)
  // (a call: a kind made, its fields given by name, the rest none; a function of the runtime, given what it is given)
  static call (cn, ca, ce) => Lowered.call_named(((Lowered.kind(cn) == `member_from`) && Lowered.is_section(Compiled.trimmed(Lowered.parsed(cn).member_from))) ? Compiled.trimmed(Lowered.parsed(cn).member_name) : cn, ((Compiled.trimmed(ca)).count == 0) ? Array.new : Compiled.parts(ca), ce)
  static call_named (cn, cp, ce) => (cn == `Words`) ? Lowered.room_for(cp.first, ce) : ((Lowered.named(cn) === None) ? Lowered.applied(cn, cp, ce) : Lowered.made(Lowered.named(cn), cp, ce))
  // (`Words(n)`: room for n words, of the memory a run manages)
  static room_for (wn, we) => {
    Lowered.w("alloc((")
    Lowered.expression(wn, we)
    Lowered.w(" * 4))")
  }
  static applied (an, ap, ae) => {
    Lowered.w(an)
    Lowered.w("(")
    Lowered.arguments(ap, ae)
    Lowered.w(")")
  }
  static arguments (aa, ae) => aa.empty ? None : Lowered.argument(aa.first, aa.rest, ae)
  static argument (af, ar, ae) => {
    Lowered.expression(af, ae)
    Lowered.w(", ") if !ar.empty
    Lowered.arguments(ar, ae)
  }
  static made (mk, mp, me) => {
    Lowered.w(mk.first)
    Lowered.w("_made(")
    Lowered.given_fields(mk.last, mp, me)
    Lowered.w(")")
  }
  static given_fields (gf, gp, ge) => gf.empty ? None : Lowered.given_field(gf.first.first, gf.rest, gp, ge)
  static given_field (gn, gr, gp, ge) => {
    Lowered.given_value(Lowered.given_named(gp, gn), ge)
    Lowered.w(", ") if !gr.empty
    Lowered.given_fields(gr, gp, ge)
  }
  static given_named (gp, gn) => gp.empty ? None : (((Lowered.kind(gp.first) == `field_name`) && (Compiled.trimmed(Lowered.parsed(gp.first).field_name) == gn)) ? gp.first : Lowered.given_named(gp.rest, gn))
  static given_value (gv, ge) => (gv === None) ? Lowered.w("0") : Lowered.expression(Lowered.parsed(gv).field_type, ge)
  static is (iv, ik, ie) => {
    Lowered.w("(tag(")
    Lowered.expression(iv, ie)
    Lowered.w(") == ")
    Lowered.w(Lowered.named(ik).rest.first)
    Lowered.w(")")
  }
  static op (ol, oo, orr, oe) => {
    Lowered.w("(")
    Lowered.expression(ol, oe)
    Lowered.w(" ")
    Lowered.w(oo)
    Lowered.w(" ")
    Lowered.expression(orr, oe)
    Lowered.w(")")
  }
  static grouped (gc, ge) => (Compiled.statements_of(gc).count == 1) ? Lowered.expression(gc, ge) : Lowered.body(Compiled.trimmed(gc), ge)
  static choice (ci, cy, cn, ce) => {
    Lowered.w("if (")
    Lowered.expression(ci, ce)
    Lowered.w(") {\n  ")
    Lowered.expression(cy, ce)
    Lowered.w("\n  } else {\n  ")
    Lowered.expression(cn, ce)
    Lowered.w("\n  }")
  }
  static when (wc, wv, we) => {
    Lowered.w("if (")
    Lowered.expression(wc, we)
    Lowered.w(") {\n  ")
    Lowered.expression(wv, we)
    Lowered.w("\n  }")
  }
  static looped (lc, lb, le) => {
    Lowered.w("while (")
    Lowered.expression(lc, le)
    Lowered.w(") {\n  ")
    Lowered.statements(Compiled.statements_of(lb), le)
    Lowered.w("\n  }")
  }
  // (`return v if c`: returned only if c)
  static returned (rv, re) => (Lowered.kind(rv) == `if_value`) ? Lowered.returned_if(Lowered.parsed(rv).if_condition, Lowered.parsed(rv).if_value, re) : Lowered.prefixed("return ", rv, re)
  static returned_if (rc, rv, re) => {
    Lowered.w("if (")
    Lowered.expression(rc, re)
    Lowered.w(") {\n  return ")
    Lowered.expression(rv, re)
    Lowered.w("\n  }")
  }
  static loaded (lw, lv, le) => {
    Lowered.w("(")
    Lowered.w(lw)
    Lowered.w(" ")
    Lowered.expression(lv, le)
    Lowered.w(")")
  }
  static prefixed (pw, pv, pe) => {
    Lowered.w(pw)
    Lowered.expression(pv, pe)
  }
}
