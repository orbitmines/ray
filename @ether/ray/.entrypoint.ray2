!language
{
  }
=>

// The rule creator: a rule written `{head} => {body}` from here on goes on to the next reading while there is one (`goto .`),
// any rule's, so the text is rewritten by the latest rule's reading that goes furthest; and so does the creator (a head goes up
// to the last definer).
{head} => {body} =>
  goto .
  {head} =>
    goto .
    {body}
// One written `nearest {head} => {body}` does not go on: it is rewritten by its first reading (its holes ending nearest).
nearest {head} => {body} =>
  {head} =>
    {body}

// A typed hole, `{x: T}` in a head: it takes what `T`'s own rules read whole (matched as a head is, nothing read), and what it
// took is read in `T`. This rule, a head that is one hole written as the two its right side has, says how one is written. (In
// a rule's right side, a hole's name is what it took.)
{name: type} =>
  {name}: {type}
// The same way, a hole in a style, `{name ^style}`, is the hole `name` (`^` is a method answering what it is on: it is for
// highlighting and nothing else), and one taken as written, `{literal name}`, the hole `name` (a hole is code already).
{name ^style} =>
  {name} ^{style}
{literal name} =>
  {name}

// A name with a type and no value: declared here, its value the type (read, both its type and its value are of that kind),
// the type read where it is written (in a call's arguments, `f(x: x)`, the caller's `x`); it answers `declared`. (Written
// `{ }` after `:`, which means the same space, so the rule below does not read this as a name with a type.)
{name}:{ }{type} =>
  {type}
  {name}: {type} =>
    {type}
  declared
// (several at once: `a: 1, b: 2`)
{name}:{ }{type}, {{rest}} =>
  {name}: {type}
  {rest}
// A name with a type, in a definition's head (whatever wrote it: `:=`, `=`, destructuring, a closure's parameters, a class's
// fields, a declaration): the rule is the name's, what it reads checked against the type (`checked`, below), the type kept
// with it. (Defined after a declaration, it binds looser: `f: T => v` is a rule.)
{name}: {type} => {body} =>
  {name} =>
    ({body}) checked {type}
  {name}.type =>
    {type}

// Which way a statement is read is the order the rules are defined in: of the rules reading all of it, the latest is read
// first (its operator binds loosest). So the operators that bind tightest come first.

// Text: what is written between quotes (`.text`, a capture read as a value, is its text as written).
"{text}" =>
  .text
`{text}` =>
  .text
// One written `{this}…`: a method, `…` read on a value (`{this}{{narrowing}} =>`: `x{ … }`).
{`{`}this{`}`}{head} => {body} =>
  {head} =>
    goto .
    {body}
// (given code, a block on one line, `f(code: { … })`: that code, unread, run when it is called)
{name}:{ }{`{`}{ }{code}{ }{`}`} =>
  {name} := (() => ({code}))
  declared
{name}:{ }{`{`}{code}{`}`} =>
  {name} := (() => ({code}))
  declared

// A name given a value again: the value read, then the name a rule reading it. A definition whose right side is a value
// rewrites the rule of the nearest node that has the name (here, when none does).
{name} = {value} =>
  {value}
  {name} =>
    {value}
// A name declared here, given a value: a rule here first (not a value: any other definition is made where it is read), then
// given it (that rule, the nearest: not a write through `=`).
{name} := {value} =>
  {value}
  {name} =>
    None
  {name} =>
    {value}

// Node: the outermost node (`.`, here, is the node being read in). Every node sees its rules, so they are what any value
// read on reads: its methods.
Node := .
// (`global`: the same outermost node, named for what is defined everywhere: `global[name] := …`, `global.None`)
global := Node
// (what a declaration, `x: T`, answers: nothing but that it declared)
declared := { }
// A field named by its pattern as written, `{*}: T` (what no other field reads): kept under that text, not a rule (a head that
// is one hole would read everything). A pattern is a body written.
Pattern := {
  {{written}} =>
    written
}
{pattern: Pattern}:{ }{type} =>
  .holding("{pattern}", {type})
// (code read in a node: its definitions are the node's; a class's maker (what `X := class …` gives) has its own, see `class`)
&+= {{block}} =>
  {block}
  .
// A member given a value: given in what is before it.
{on}.{name} := {value} =>
  {on} &+= {
    {name} := {value}
  }

// (A member, `x.y`: `x`, then `.y` read in it, the reader's `.`.)

// A comment after a statement.
{statement} //{comment} =>
  {statement}
{statement} // {comment} =>
  {statement}

// A group: read as what is inside it. (A head that is one hole between two characters makes them a pair, as `{ }` are: a
// hole never ends inside one.)
({grouped}) =>
  {grouped}

// A name given a value in parentheses: `(a) := 1`. (A list of names, `(a, b) := …`, waits for `,`: a method on Node making a
// Ray.)
({name}) := {value} =>
  {name} := {value}

// Read on a value without a space between: tightest (precedence is the order rules are defined in: one defined later binds
// looser), so `a === x[k]` is `a === (x[k])`.
// What a value holds under a key: a key that is text, the member it names (`global["Decimal"]` is `Decimal`); any other, an
// entry (keys the same when `===`). (Given one: see `x[key] = v` below.)
// Partial arguments: `f<a: 5>` is `f` with those given first (code: inlined into each call before its own arguments): `g :=
// f<a: 5>`, then `g(1)` gives `b`.
{function}<{{given}}> =>
  ((also) => {function}({given}, also))

// A narrowing, `T{constraint}` (a method: a class's own `x{ … }` is read first): a T for which the constraint, read with `.` the value, answers true. Called, `p{O: level}()`: what
// it narrows given what the constraint writes (settings), called. (Made in a node holding these, as a class is: none is its
// own rule, which a typed hole `{x: T}` reads.)
{{constraint}} =>
  ({
    narrows := .
    holds (it) =>
      it with {
        {constraint}
      }
    () =>
      holds(narrows)
      narrows()
    narrowing := { }
  }).narrowing

// What a value answers to `?`: anything is true, but `None` and `false`.
? {yes} : {no} =>
  {yes}
None := {
  ? {yes} : {no} =>
    {no}
  value =>
    None
  next =>
    None
}
false := {
  ? {yes} : {no} =>
    {no}
}
true := { }
!{x} =>
  {x} ? false : true
{a} || {b} =>
  {a} ? {a} : {b}
{a} && {b} =>
  {a} ? {b} : {a}
{a} ?? {b} =>
  {a} ? {a} : {b}
// A choice, `c ? a : b`: the condition all before the `?` (`x > 1 ? a : b`).
{condition} ? {yes} : {no} =>
  ({condition}) ? {yes} : {no}
// The same value: gone to as a label (a node is the label written as it); nothing there, another.
{a} === {b} =>
  goto {a}
  goto other
  {b}\
  true
  goto same
  other\
  false
  same\
{a} !== {b} =>
  ({a} === {b}) ? false : true
// A branch: the block taken read where the branch is (a label gone to by what the condition answers; named apart from a
// loop's, which `break` and `continue` go to through it).
if {condition} {{taken}} =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {taken}
  passed\
unless {condition} {{taken}} =>
  {condition} ? (goto passed) : (goto taken)
  taken\
  {taken}
  passed\
// (a chain, `if … {} elsif … {} else {}`: its condition ends at the nearest body)
nearest if {condition} {{taken}} {chain} =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {chain}
  passed\
nearest elsif {condition} {{taken}} =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {taken}
  passed\
nearest elsif {condition} {{taken}} {chain} =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {chain}
  passed\
nearest elsif {condition} {{taken}} else {{otherwise}} =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {otherwise}
  passed\
if {condition} {{taken}} else {{otherwise}} =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {otherwise}
  passed\

// Loops: `break` goes to the loop's end, `continue` to its start.
while {condition} {{body}} =>
  again\
  {condition} ? (goto looping) : (goto done)
  looping\
  {body}
  goto again
  done\
loop {{body}} =>
  again\
  {body}
  goto again
  done\
{body} while {condition} =>
  again\
  {condition} ? (goto looping) : (goto done)
  looping\
  {body}
  goto again
  done\
do {{body}} while {condition} =>
  start\
  {body}
  again\
  {condition} ? (goto start) : (goto done)
  done\
break =>
  goto done
continue =>
  goto again

// Leaving a call: `return v` (the call answers v), `return`.
return {value} =>
  {value}
  goto returned
return =>
  goto returned
// The call it is in, again from its start: `recur(arguments)`, with these; `recur`, with the same.
recur({again}) =>
  given := ({again})
  goto rebinding
recur =>
  goto recurring

// Code read in a value, `.` that value: `x with { … }` (before the loosest, so `y := x with { … }` gives y it).
{on} with {{block}} =>
  {on} reading {
    {block}
  }

// The loosest, defined here once more and in this order, tightest first (a rule defined again is placed as defined now):
//   `=` (a member, `x.m = v`, given in `x`; and `x: T = v`: the value checked against T before the name, with its type, is given
//     it);
//   a closure: a rule on one line, read where a value is wanted, is a node holding it (see `language3.ts`); reading on in it
//     (`f(5)`) runs its right side in a new node in it, its parameters taking the arguments (arguments are code inlined into
//     the call: `f(x: 5)` declares its `x`, answering `declared`; see `taking`); its parameters go up to the
//     nearest `=>`, so it is made by the rule creator that does not go on; a call written with a hole, `({args}) =>`, is a
//     rule as written; a call ends at `returned\` (`return v` goes there, the call answering v), and begins at `recurring\` (`recur`
//     goes there; `recur(…)` first gives its parameters these, `given`);
//   a method: `name (parameters) =>` gives the name a closure, as `name := (parameters) =>` does (so its locals are its
//     own); a rule without parameters, `name =>`, is one too (read on in a value, `.` is that value); `x.name (…) =>` is a
//     member (a name handed on is a value: what is in it is not read again, so the member is written as one);
//   `:=`, and its more particular forms: a closure or a class given to a name (`f := (x) => …`, `X := class (…) => { … }`:
//     a line with `=>` outside brackets is a definition, read only by rules with `=>` in their heads; the name handed on as
//     written, so `global[n] := class …` is one), a member (so
//     `x.m := () => …` is one), a key (`x[k] = v`), names at once;
//   a guard: `x := 1 if c` guards the statement (and `x if a && b` guards on both);
//   `,`: a list of what is on either side.
// Rules after it are led by a literal, or are methods, so it stays the loosest. (A head written `{ }` for a space reads
// the same: it keeps a rule from reading another's head as one it reads.) (A language read after this one (the host's
// kinds) reads the logic, the choice, control flow, the guards and `,` again after its own operators, so those stay looser.)
{name} = {value} =>
  {value}
  {name} =>
    {value}
{on}.{name} = {value} =>
  {on}.{name} := {value}
{name}:{ }{type} = {value} =>
  ({value}) checked {type}
  {name}: {type} =>
    {value}
nearest ({{parameter}}) => {body} =>
  ({ {parameter} }) =>
    {body}
nearest ({parameters}) => {body} =>
  ({arguments}) =>
    ({parameters}) taking {arguments}
    goto recurring
    rebinding\
    ({parameters}) := given
    recurring\
    {body}
    returned\
nearest () => {body} =>
  () =>
    recurring\
    {body}
    returned\
{name} ({parameters}) => {body} =>
  {name} := (({parameters}) => {body})
{name} () => {body} =>
  {name} := (() => {body})
{on}.{name}{ }({parameters}) => {body} =>
  {on}.{name} := (({parameters}) => {body})
{on}.{name}{ }() => {body} =>
  {on}.{name} := (() => {body})
{name} := {value} =>
  {value}
  {name} =>
    None
  {name} =>
    {value}
{{name}}{ }:={ }() => {body} =>
  {name} := (() => {body})
{{name}}{ }:={ }({parameters}) => {body} =>
  {name} := (({parameters}) => {body})
{on}.{name}{ }:={ }() => {body} =>
  {on}.{name} := (() => {body})
{on}.{name}{ }:={ }({parameters}) => {body} =>
  {on}.{name} := (({parameters}) => {body})
{{name}}{ }:={ }class{ }({fields}) => {{block}} =>
  {name} := (class ({fields}) => {
    {block}
  })
{{name}}{ }:={ }class:{ }{parent}{ }({fields}) => {{block}} =>
  {name} := (class: {parent} ({fields}) => {
    {block}
  })
// (what it is given in made first when nothing has that name yet, `orbitmines.com := …`: a name not given reads as its text)
{on}.{name} := {value} =>
  ({on} := { }) if ({on}) === "{on}"
  {on} &+= {
    {name} := {value}
  }
{on}[{key}] = {value} =>
  ({key} is String) ? ({on}.{key} = {value}) : {on}.holding({key}, {value})
{on}[{key}] := {value} =>
  ({key} is String) ? ({on}.{key} := {value}) : {on}.holding({key}, {value})
({name}) := {value} =>
  {name} := {value}
({name}, {names}) := {list} =>
  ({name}, {names}) from {list}
{guarded} if {condition} =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {guarded}
  passed\
{guarded} unless {condition} =>
  {condition} ? (goto passed) : (goto taken)
  taken\
  {guarded}
  passed\
// A list: `a, b` is a Ray of both, `a, b, c` one of all three; the loosest of all (`a = 1, b = 2` is `(a = 1), (b = 2)`). Both
// read here first (`f(x: 1, y: 2)`: each declared where the list is); a side that only declared (`declared`) is no value in it.
{list}, {other} =>
  {list}
  {other}
  ({list} === declared) ? {other} : (({other} === declared) ? {list} : ((({list}).listing ? ({list}).listed() : Listing.new.append({list})).joined({other})))
// (three or more: the rest read as a new list, this one put first: each once)
{list}, {other}, {{more}} =>
  {list}
  (({other}, {more}) -- .led({list}))
// (a value that is not a list led by another: both, in a new list)
led (value) =>
  (value === declared) ? . : ((. === declared) ? value : Listing.new.append(value).joined(.))
// A record: names given values in parentheses, `(a: 1, b: 2)`, a node holding them (a call's own `(…)` is read before
// this: its named arguments are inlined into it). Its names are words (`(made class: …)` is a group), its first value not
// a definition (`(class: P (x) => { … })` is a group). (Its brackets written as text, so it is not read as a closure.)
{`(`}{name}:{ }{value}, {{rest}}{`)`} =>
  (goto record) unless ("{name}" contains " ") || ("{value}" contains " => ")
  goto .
  record\
  {
    {name}: {value}
    {rest}
  }
{`(`}{name}:{ }{value}{`)`} =>
  (goto record) unless ("{name}" contains " ") || ("{value}" contains " => ")
  goto .
  record\
  {
    {name}: {value}
  }

// Ray: a chain of vertices, each holding a value (`head` the first vertex, `tail` the last; a vertex's `next`, `previous`).
// Called on a Ray (`r.append(1)`), `.` in a method is that Ray.
// (the list the language reads (`[…]`, `a, b`) is `Listing`, made at the end, in Iterable: what the library adds to
// Iterable is its too, below its own)
// (anything but a Ray read on: not a listing)
listing := false

// (A list, `a, b`: see `,` below, the loosest.)

// A value that is not a list (Ray's own say otherwise): its first is itself, nothing after it.
first =>
  .
rest =>
  []

// Whether a name is defined where it is read (the lookup's first layer only, not further out): `here x`.
here {name} =>
  goto defined
  {name}
  false

// Names given values at once: `(a, b) := list`, each the next value in it (`:=`, below, reads it so).
({name}) from {list} =>
  {name} := {list}.first
({name}, {names}) from {list} =>
  {name} := {list}.first
  ({names}) from {list}.rest

// A closure with parameters called with none, `f()`: called with nothing given (each its default). (One without parameters
// has its own `()`, read first.)
() =>
  . (declared)

// A call's parameters taking its arguments: one parameter, all of them; several, each the next (walking the list's
// vertices; one its setup already defines, given by name or a partial argument, passes, leaving it for the next). Arguments that
// only declared (`declared`) give none: a list with nothing in it.
declared &+= {
  listing =>
    true
  head =>
    None
}
({{parameter}}) taking {value} =>
  ({parameter}) gets (({value} === declared) ? None : {value})
({{parameter}}, {{parameters}}) taking {list} =>
  ({parameter}, {parameters}) taking from ((({list}).listing) ? ({list}).head : Listing.new.append({list}).head)
({{parameter}}) taking from {vertex} =>
  ({parameter}) gets {vertex}.value
({{parameter}}, {{parameters}}) taking from {vertex} =>
  (goto took) if (({parameter}) gets {vertex}.value) === true
  ({parameters}) taking from {vertex}
  goto done
  took\
  ({parameters}) taking from {vertex}.next
  done\
// One parameter given a value (read first: a call's arguments declare what they name), unless it is defined here already
// (`true` when it took it; given, what `goto defined` answers): `x`, `x: T` (checked against T), `x = default` (None, the
// default; defined last, so `x: T = d` is that default unwrapped first). (A parameter is code, handed on as written: `x = 5` is read by these.)
({name}) gets {value} =>
  {value}
  goto defined
  {name}
  {name} := {value}
  true
({name}:{ }{type}) gets {value} =>
  ({name}) gets (({value}) checked {type})
({{parameter}} = {default}) gets {value} =>
  ({parameter}) gets ({value} ?? {default})

// A list written: `[]` an empty Ray, `[a, b]` a Ray of both, `[a]` of one.
[] =>
  Listing.new
[{inside}] =>
  ({inside}).listing ? {inside} : Listing.new.append({inside})
// `x[k]`: a method, read on what it is on (so a class's own `[…]` is read first): a name, that member; else what it holds
// under k. (After the list above: a head of the same shape after the one that made the pair is a call.)
[{key}] =>
  ({key} is String) ? .{key} : .held({key})

// The rest read on what is before it, as parentheses around that would (`a -- .x` is `a.x`; `.` in what is read, that value);
// `x ~~ …`: the same, answering `x`. Code read in a value, `.` that value (`x reading { … }`; `x with { … }`, below).
-- {{rest}} =>
  . {rest}
~~ {{rest}} =>
  . {rest}
  .
// (a closure after it, `x -- (y => …)`, `x ~~ ((y) => …)`: called with that value, made where it is written; its brackets
// written as text, so the head is not read as a method's)
{value} {`--`} {`(`}{parameter} => {body}{`)`} =>
  ((({parameter}) => {body}))({value})
{value} {`--`} {`(`}({parameters}) => {body}{`)`} =>
  ((({parameters}) => {body}))({value})
{value} {`~~`} {`(`}{parameter} => {body}{`)`} =>
  ((({parameter}) => {body}))({value})
  {value}
{value} {`~~`} {`(`}({parameters}) => {body}{`)`} =>
  ((({parameters}) => {body}))({value})
  {value}
reading {{block}} =>
  {block}

// `with` code, one line or a block: what it sets is set for where it is read (`&.caller`: the rewrite it is read in) and
// everything run from there, and gone when that ends: written into that program, not where the name is held. (The code is
// read in a node whose `=` does that; `assume` is the same.)
with {{code}} =>
  writing (&.caller) {
    {code}
  }
writing {program} {{code}} =>
  {program}
  {
    {name} = {value} =>
      {value}
      {program} &+= {
        {name} =>
          {value}
      }
  } reading {
    {code}
  }
assume {{code}} =>
  writing (&.caller) {
    {code}
  }

// A superposition: one of these values (`a | b`), and `x?`: `x` or None (methods on Node).
| {other} =>
  {
    superposes := true
    components := Listing.new.append(.).joined({other})
  }
? =>
  None | .

// Diagnostics: handed to the host (its label `report`, `.` this reading), and a value.
ERROR {message} =>
  goto report
  {
    message := {message}
    fatal := false
  }
FATAL {message} =>
  goto report
  {
    message := {message}
    fatal := true
  }
WARN {message} =>
  goto report
INFO {message} =>
  goto report
TODO {message} =>
  None
assert {condition} =>
  unless {condition} {
    ERROR assertion failed
  }
  {condition}

// A node made in a value (`x.interior`): it sees what the value sees, the value's rules first. `x.extended()`: one to make a
// class in (a class's own makes it where its instances are). (Named so no class's field of the same name hides it.)
interior =>
  { }
extended () =>
  .interior

// (A head with `x: {…}` in it is written `x:{ }{…}`, which means the same space, so the rule for a name with a type does not
// read it as one.)
// A class: a node made of its parent (`class: P`, else Node), its block read in it; it sees its parent's rules, so an instance
// of it does too. (Made in a node holding `superclass` and `extended`: they are read through it, not its own rules, which are what a
// typed hole `{x: T}` reads.) With fields, written as a closure is, `class (x, y) => { … }`: the class's `instance`, that closure (a call
// of it, the instance: in the class, its fields given the arguments; `of` its class), is what `X(…)` calls.
made class:{ }{parent} {{block}} =>
  ({parent}.extended() &+= {
    superclass := {parent}
    extended := () =>
      interior reading {
        { }
      }
    interior := {
      {block}
    }
  }).interior
// (one without fields makes instances too: given nothing, or named arguments, code inlined into the making)
class:{ }{parent} {{block}} =>
  class: {parent} (arguments = None) => {
    {block}
  }
// (the block read once for the class; again for each instance, only what is not a definition (`instanced`))
nearest class:{ }{parent}{ }({fields}) => {{block}} =>
  (made class: {parent} {
    {block}
    instance := ({fields}) =>
      of := instance
      (here of) instanced {
        {block}
      }
      of := instance
    // (what is added to the maker, `X &+= { … }`, is added to the class)
    instance &+= {
      {`&+=`} {{added}} =>
        interior &+= {
          {added}
        }
        .
    }
  }).instance
class {{block}} =>
  class: Node {
    {block}
  }
class{ }({fields}) => {{block}} =>
  class: Node ({fields}) => {
    {block}
  }

// What a value is: a Node (anything is; the outermost node); the value itself; an instance of the class (or of one after it,
// `class:`) it was made by; one of a superposition's components; a narrowing that holds of it; a member of an enumeration.
of := None
superclass := None
superposes := false
// (the program read at the top was read by none)
caller := None
descends (type) =>
  (. === type) || (.superclass ? .superclass.descends(type) : false)
is {type} =>
  ({type} === Node) || (. === {type}) || (.of ? .of.descends({type}) : false) || ({type}.superposes ? {type}.components.some((c) => . is c) : false) || ({type}.narrows ? ((. is {type}.narrows) && {type}.holds(.)) : false) || ({type}.members ? {type}.members.some((m) => m === .) : false)

// A value written into text (not text) taken by a typed hole `{x: T}`: one that is a T. (Written as a typed hole is above: this
// right side answers something only then.)
{value: type} =>
  (goto not_one) unless {value} is {type}
  {value}
  not_one\

// A level: a node of rules a value is given to (`{x: T} => …`): the value, written into text, read in it (by the first of
// them that takes it; none, the value).
{level} reducing {value} =>
  {level} reading {
    {value}
  }

// `this`: what `.` is.
this =>
  .
// `x ^style`: x, shown in that style (highlighting only); a head written so, the head.
^{style} =>
  .
{head} ^{style} => {{body}} =>
  {head} =>
    {body}

// A value checked against a type: reported when it is not one (None, not given yet, and anything against no type, pass).
type := None
checked {type} =>
  unless ({type} === None) || (. === None) || (. is {type}) {
    ERROR a value is not of the type it is given to
  }
  .

// `static`: what follows is read where it is (a class's block is read once, for the class).
static {{statement}} =>
  {statement}

// A class's block read for an instance: what declares is the class's (read once, for it); the rest (`&.caller[name] =
// this`) is read in the instance. What declares: a definition (its line has the definer), and what these read.
instanced {{code}} =>
  goto instanced
  {code}
goto declaring
{name} := {value}
goto declaring
{name}:{ }{type}
goto declaring
{name}:{ }{type}, {{rest}}
goto declaring
{name}:{ }{type} = {value}
goto declaring
{pattern: Pattern}:{ }{type}
goto declaring
{on}.{name} := {value}
goto declaring
({name}) := {value}
goto declaring
({name}, {names}) := {list}
goto declaring
static {{statement}}

// `x as T`: x, when it is a T; else what T makes of it (`T.from(x)`; none, by default).
from (x) =>
  None
as {type} =>
  (. is {type}) ? . : {type}.from(.)

// What a value holds under a key: its entries (`key`, `value`), a Ray; none until one is given.
entries := None
Entry := class (key, value) => { }
held (key) =>
  found := (.entries) ? .entries.find((e) => e.key === key) : None
  found ? found.value : None
holding (key, value) =>
  .entries := .entries ?? []
  found := .entries.find((e) => e.key === key)
  if found {
    found.value = value
  } else {
    .entries.append(Entry(key, value))
  }
  value

// (what a narrowing narrows: see `T{constraint}`)
narrows := None
// An enumeration: `enum A | B | C`, a node with a member for each name (a node in it), and `members` them all (the names
// are code: handed on as written; a rule's right side is not read by that rule, but what is in a group is).
members := None
nearest enum {{names}} =>
  Node.interior &+= {
    members := []
    enumerated {names}
  }
enumerated {name} =>
  {name} := { }
  members.append({name})
nearest enumerated {name} | {{rest}} =>
  {name} := { }
  members.append({name})
  (enumerated {rest})

// `dynamically`: given again (run again) whenever what it reads is written from outside in the rewrite it is read in
// (`&.caller`), or anything run from there: `dynamically x := v` (x is v again), `dynamically code` (the code runs again).
// What it reads: the names its code has in it (a write of one it does not have goes on past it). (That program's `=`: the
// write, then each one whose code has the name in it again, once: what they write, while they do, does not; nor does any
// write while they are given again. A member written, `x.y = v`, is
// `x.y := v`: written as `y = v` in `x`. The `:=` form is written `{ }` after `dynamically`, so the code form, a modifier,
// does not read its definition.)
dynamics := None
dynamically {{code}} =>
  dynamic_in (&.caller) {
    {code}
  }
  {code}
dynamically{ }{name} := {{value}} =>
  {name} := {value}
  dynamic_in (&.caller) {
    {name} = ({value})
  }
dynamic_in {program} {{code}} =>
  {program}
  {program} &+= {
    dynamics := dynamics ?? {
      updating := false
      refreshing := []
      refresh (written) =>
        // (its own flag given directly (`:=`): not a write the overrides below see)
        unless .updating {
          .updating := true
          .refreshing.for((one) => (one.again() if one.reads contains written))
          .updating := false
        }
    }
    {written} = {given} =>
      (goto quiet) if dynamics.updating
      {written} = {given}
      dynamics.refresh(.written)
      goto done
      quiet\
      {written} = {given}
      done\
    {on}.{written} = {given} =>
      (goto quiet) if dynamics.updating
      {on}.{written} := {given}
      dynamics.refresh(.written)
      goto done
      quiet\
      {on}.{written} := {given}
      done\
  }
  {program}.dynamics.refreshing.append({
    reads := .code
    again := () => {
      {code}
    }
  })
// The classes the library adds to: what is iterable, an array of it, text (an array of characters), a number, a character
// (a number), a program, a diagnostic.
Iterable := class { }
// A list: its own methods first, then what Iterable has (the library adds the rest there).
Iterable &+= {
  Listing := {
    // (a class made of it, of it: not of Iterable's class)
    interior =>
      { }
    extended () =>
      .interior
    new =>
      {
        head := None
        tail := None
        listing := true
      }
    append (value) =>
      link := {
        value := value
        next := None
        previous := None
      }
      if .tail {
        link.previous := .tail
        .tail.next := link
      } else {
        .head := link
      }
      .tail := link
      .
    // (a list led by a value: this one, the value first (a side that only declared is no value in it))
    led (value) =>
      (value === declared) ? . : .prepend(value)
    for (body) =>
      at := .head
      while at {
        body(at.value)
        at = at.next
      }
      .
    first =>
      .head ? .head.value : None
    last =>
      .tail ? .tail.value : None
    empty =>
      .head ? false : true
    count =>
      counted := 0
      at := .head
      while at {
        counted = counted + 1
        at = at.next
      }
      counted
    rest =>
      made := Listing.new
      at := .head ? .head.next : None
      while at {
        made.append(at.value)
        at = at.next
      }
      made
    prepend (value) =>
      link := {
        value := value
        next := None
        previous := None
      }
      if .head {
        .head.previous := link
        link.next := .head
      } else {
        .tail := link
      }
      .head := link
      .
    take () =>
      first := .head
      .head := first ? first.next : None
      .tail := .head ? .tail : None
      first ? first.value : None
    find (predicate) =>
      at := .head
      while at {
        return at.value if predicate(at.value)
        at = at.next
      }
      None
    some (predicate) =>
      found := false
      at := .head
      while at {
        if predicate(at.value) {
          found = true
          break
        }
        at = at.next
      }
      found
    every (predicate) =>
      !(.some((x) => !predicate(x)))
    map (mapping) =>
      made := Listing.new
      .for((x) => made.append(mapping(x)))
      made
    without (value) =>
      made := Listing.new
      .for((x) => (made.append(x) unless x === value))
      made
    listed () =>
      made := Listing.new
      .for((x) => made.append(x))
      made
    joined (other) =>
      if other.listing {
        other.listed().for((x) => .append(x))
      } else {
        .append(other)
      }
      .
  }
}
Listing := Iterable.interior.Listing
Ray := Listing
Array := class: Iterable { }
String := class: Array { }
Number := class { }
Char := class: Number { }
Program := class { }
Diagnostic := class { }
