// A page is a program; the levels compile it to pixels here, and to the web and the terminal in UI.HTML and UI.TUI (ui/HTML.ray, ui/TUI.ray), writing the languages $.html, $.css, $.js and $.ansi.

mark ^keyword := external global

page := Program(code: {
  "Ray" ^h1
  @https://orbitmines.com
})
scene := page{O: UI.Scene}()
unless scene.children.first.content is String { INFO@mark `UI1 a string does not become text` }
unless UI.Theme.face(scene.children.first, 0).font.weight >= 600 { INFO@mark `UI2 a heading style does not give a heading` }
unless scene.children.last.location == @https://orbitmines.com { INFO@mark `UI3 a location does not become a link` }
unless scene.flow == block { INFO@mark `UI4 lines do not stack` }
unless Program(code: { "a", "b" }){O: UI.Scene}().flow == inline { INFO@mark `UI5 a comma does not flow inline` }

dot := Geometry.Box(width: 2px, height: 2px, fill: Geometry.Color(255, 0, 0))
with UI.scene.size = Geometry.Vector(4px, 4px) {
  raster := Program(code: { dot }).rendered(Language.Direct.level)
  unless raster.at(0, 0) == Geometry.Color(255, 0, 0) { INFO@mark `UI40 a filled box is not drawn` }
  unless raster.at(3, 3).alpha == 0 { INFO@mark `UI41 outside the box was drawn` }
}
unless Geometry.Color(0, 0, 0).over(Geometry.Color(255, 255, 255, 0.5)) == Geometry.Color(128, 128, 128) { INFO@mark `UI42 half white over black is not grey` }

unless Geometry.Ball(size: Geometry.Vector(10px, 10px)).contains(Geometry.Vector(5px, 5px)) { INFO@mark `UI50 a ball does not contain its centre` }
if Geometry.Ball(size: Geometry.Vector(10px, 10px)).contains(Geometry.Vector(0px, 0px)) { INFO@mark `UI51 a ball contains its corner` }
unless (Geometry.Transform.translate(Geometry.Vector(1, 2)) * Geometry.Transform.scale(Geometry.Vector(2, 2))).applied(Geometry.Vector(1, 1)) == Geometry.Vector(3, 4) { INFO@mark `UI52 transforms do not compose` }
unless (6/12).md.at == 768px { INFO@mark `UI53 md is not the 768px breakpoint` }
unless ((6/12).md -> (12/12).xs).at(768px) == 6/12 { INFO@mark `UI54 an interpolated share is not its breakpoint's at the breakpoint` }

UI.at = @https://orbitmines.com/profiles
unless UI.at == @https://orbitmines.com/profiles { INFO@mark `UI63 navigating does not change where the user is` }
UI.back
unless UI.at != @https://orbitmines.com/profiles { INFO@mark `UI64 going back stays where the user went` }

if @me/device/handheld { INFO@mark `UI67 a platform is handheld before any level says so` }
first_box := Geometry.Box()
second_box := Geometry.Box()
Geometry.Box(children: [first_box, second_box])
if first_box.id == second_box.id { INFO@mark `UI68 two shapes share an id` }
unless first_box.id == first_box.id { INFO@mark `UI69 a shape's id changes` }
unless Geometry.Box(children: [first_box]).reachable.count == 2 { INFO@mark `UI70 a box holding one shape does not expand to two` }

away := @https://orbitmines.com{window == new}
unless away.window == new { INFO@mark `UI80 a location narrowed to a new window does not open one` }
unless (@https://orbitmines.com).window == same { INFO@mark `UI81 a location opens a new window by default` }
Geometry.Box(location: away).activate
unless @me/device/opened == away { INFO@mark `UI84 activating a new-window link does not open it` }
if UI.at == away { INFO@mark `UI85 activating a new-window link navigates the page itself` }

searched := @https://orbitmines.com/archive?search=ray&page=2
unless searched.query.search == "ray" && searched.query.page == "2" { INFO@mark `UI86 a query parameter is not read` }
unless searched.path == "https://orbitmines.com/archive" { INFO@mark `UI87 a location's path keeps its query` }
unless searched.with(search: "orbit").query.search == "orbit" && searched.with(search: "orbit").query.page == "2" { INFO@mark `UI88 with does not replace one parameter and keep the rest` }
if searched.with(search: None).query.search { INFO@mark `UI89 with None does not remove a parameter` }
unless (@https://orbitmines.com/archive?q=a%20b).query.q == "a b" { INFO@mark `UI90 a query parameter is not decoded` }
unless (@https://orbitmines.com/archive/on-orbits).segments.last == "on-orbits" { INFO@mark `UI91 a location's last segment is not its name` }

solved := (children, scrolled: Geometry.Length = 0px) => Geometry.Box(size: Geometry.Vector(1000px, 800px), scrolled: Geometry.Vector(0px, scrolled), children: children).solve
fixed_width := Geometry.Box(width: 48px, height: 10px)
solved([fixed_width])
unless fixed_width.size.x == 48px { INFO@mark `UI100 a fixed width is not kept` }
lifted_up := Geometry.Box(height: 20px, margin: Geometry.Edges(top: -10px))
solved([Geometry.Box(height: 20px), lifted_up])
unless lifted_up.origin.y == 770px { INFO@mark `UI101 a negative margin does not pull a shape up` }
padded_child := Geometry.Box(height: 10px)
solved([Geometry.Box(padding: Geometry.Edges(5px, 5px, 5px, 5px), children: [padded_child])])
unless padded_child.origin == Geometry.Vector(5px, 5px) { INFO@mark `UI102 padding does not move what it holds` }
pinned := Geometry.Box(position: Geometry.Absolute(), inset: Geometry.Edges(6px, None, None, 6px), height: 10px)
after_pinned := Geometry.Box(height: 10px)
solved([pinned, after_pinned])
unless pinned.origin == Geometry.Vector(6px, 784px) { INFO@mark `UI103 an absolute shape is not placed by its insets` }
unless after_pinned.origin.y == 790px { INFO@mark `UI104 an absolute shape takes space in the flow` }
fixed_bar := Geometry.Box(position: Geometry.Fixed(), inset: Geometry.Edges(0px, None, None, 0px), height: 10px)
solved([Geometry.Box(height: 3000px, children: [Geometry.Box(height: 500px), fixed_bar])], scrolled: 100px)
unless fixed_bar.at.y == 790px { INFO@mark `UI105 a fixed shape scrolls with the page` }
sticky_bar := Geometry.Box(position: Geometry.Sticky(), inset: Geometry.Edges(0px, None, None, None), height: 10px)
solved([Geometry.Box(height: 1000px, children: [sticky_bar])], scrolled: 300px)
unless sticky_bar.at.y == 790px { INFO@mark `UI106 a sticky shape does not stay at the top while its parent is in view` }
anchor := Geometry.Box(height: 20px)
tip := UI.Popover(position: Geometry.Anchored(anchor: anchor), height: 10px)
solved([anchor, tip])
unless tip.at.y == 770px { INFO@mark `UI107 a popover is not placed below its anchor` }
if tip.visible { INFO@mark `UI108 a popover shows before its anchor is hovered or focused` }

unless Geometry.Steps([(9/12).xs, (6/12).md]).at(700px) == 9/12 && Geometry.Steps([(9/12).xs, (6/12).md]).at(800px) == 6/12 { INFO@mark `UI109 breakpoints written as a list do not jump` }
unless ((9/12).xs -> (6/12).md).at(384px) == 5/8 { INFO@mark `UI110 -> does not interpolate between breakpoints` }
unless ((12/12).xs -> (10/12).sm -> (8/12).md).at(576px) == 10/12 { INFO@mark `UI111 a chain of -> does not pass through its middle breakpoint` }
unless Geometry.Box(width: [(12/12).xs, (6/12).md]).measured("width", 800px) == 400px { INFO@mark `UI112 a breakpoint list is not a width share` }

red_bar := Geometry.Box(position: Geometry.Fixed(), inset: Geometry.Edges(0px, None, None, 0px), fill: Geometry.Color(255, 0, 0), width: 16px, height: 16px)
scrolled_page := Geometry.Box(height: 2000px, children: [Geometry.Box(height: 1000px), red_bar])
with UI.scene.size = Geometry.Vector(80 * 8px, 24 * 16px) {
  with UI.scene.scrolled = Geometry.Vector(0, 320px) {
    unless Program(code: { scrolled_page }).rendered(Language.Direct.level).at(0, 0) == Geometry.Color(255, 0, 0) { INFO@mark `UI117 a fixed shape leaves the top of a scrolled raster` }
  }
}
drawer := UI.Drawer(open: true)
with UI.scene = Geometry.Box(children: [drawer]) {
  unless UI.locked { INFO@mark `UI118 an open drawer does not lock page scroll` }
  UI.scene.scroll(100px)
  unless UI.scene.scrolled.y == 0px { INFO@mark `UI119 a locked page scrolls` }
}
UI.Overlay(closes: drawer).activate
if drawer.open { INFO@mark `UI120 activating a drawer's overlay does not close it` }

unless (pt 5).padding.top == 10px { INFO@mark `UI121 pt 5 is not five steps of the default spacing` }
with UI.Theme.spacing = 4px {
  unless (p 2).padding.left == 8px && (p 2).padding.top == 8px { INFO@mark `UI122 the shorthands do not follow the theme's spacing` }
}
unless (mt -60px).margin.top == -60px { INFO@mark `UI123 a length given to a shorthand is scaled` }
unless (px 3).padding.top == 0px && (px 3).padding.left == 6px { INFO@mark `UI124 px spaces the top` }

narrowed_box := Geometry.Box(){width <= 1240px & height == 120px, overflow == clip}
unless narrowed_box.fields["width"].type.most == 1240px && narrowed_box.height == 120px { INFO@mark `UI126 a narrowing on a shape is not its constraints` }
unless narrowed_box.overflow == clip { INFO@mark `UI127 a narrowing does not set a shape's field` }
unless Geometry.Box(content: "a"){font.size == 18px}.font.size == 18px { INFO@mark `UI128 font_size does not size the text` }
inner_text := Geometry.Box(content: "a")
Geometry.Box(children: [inner_text]){font.size == 18px}
unless inner_text.font.size == 18px { INFO@mark `UI129 a box's font_size does not reach the text it holds` }
unless Geometry.Box(){gap == Geometry.Vector(6px, 6px)}.gap == Geometry.Vector(6px, 6px) { INFO@mark `UI130 gap is not narrowed` }
unless Geometry.Box(content: "a  b").lines() == ["a b"] && Geometry.Box(content: "a  b"){white_space == Geometry.WhiteSpace.pre}.lines() == ["a  b"] { INFO@mark `UI131 white_space does not decide whether spaces collapse` }
unless Geometry.Box(){height >= 22px}.fields["height"].type.least == 22px { INFO@mark `UI132 min_height is not a least height` }
unless Geometry.Box(){transform == Geometry.Transform.translate(Geometry.Vector(10px))}.transform == Geometry.Transform.translate(Geometry.Vector(10px)) { INFO@mark `UI133 transform == translate(…) does not move the shape` }
unless Geometry.Box(){transition == Geometry.Transition(0.4 s, Geometry.ease)}.transition.duration == 0.4 s { INFO@mark `UI134 animated does not give the shape a transition` }
unless Geometry.Box(){position.kind == fixed, inset.top == 0px}.position.kind == fixed { INFO@mark `UI135 position == fixed is not narrowed` }
dynamic_style := Program(code: { "x" ^{1 < 2 ? "muted" : "none"} }){O: UI.Scene}()
unless dynamic_style.styles.contains("muted") { INFO@mark `UI136 a dynamic style is not applied` }
unless dynamic_style.styles is Dynamic { INFO@mark `UI137 a dynamic style is not kept for the levels to recompute` }
styled_link := Geometry.Box(location: @/x)
muting := { {x: Geometry.Shape{location}} => x ^muted }
with UI.Theme.kinds = muting {
  Geometry.Box(children: [styled_link]).themed
  unless styled_link.styles.contains("muted") && styled_link.color == UI.Theme["muted"].color { INFO@mark `UI139 a kind's default style is not applied` }
}
search_field := Geometry.Box(content: Choice(type: String, value: "", placeholder: "Search", placeholder_color: Geometry.Color(1, 2, 3)))
unless search_field.face.content == "Search" && search_field.face.color == Geometry.Color(1, 2, 3) { INFO@mark `UI140 an empty field does not show its placeholder in its colour` }
code_area := Geometry.Box(content: Choice(type: String{multiline}, value: "x := 1", language: ".ray"))
unless code_area.face.content.marks.nonempty && code_area.face.content == "x := 1" { INFO@mark `UI142 a text area in a language is not painted` }
red := Geometry.Color(255, 0, 0)
unless UI.Theme.painted("keyword") == "#6C6783" as Geometry.Color { INFO@mark `UI146 a highlighting style has no colour in the default palette` }
unless UI.Theme.painted("muted") == UI.Theme["muted"].color { INFO@mark `UI147 a page style is not a highlighting style` }

unless currentColor is Section { INFO@mark `UI148 currentColor is not an inherited paint` }
tinted_icon := Geometry.Box(content: @./icons/link.svg, fill: currentColor)
Geometry.Box(color: red, children: [tinted_icon])
unless tinted_icon.painted(tinted_icon.fill) == red { INFO@mark `UI152 an icon filled with currentColor does not take the colour around it` }

revealed := Geometry.Box(origin: Geometry.Vector(0, -300px), size: Geometry.Vector(100px, 100px))
with UI.scene = Geometry.Box(size: Geometry.Vector(1000px, 800px), overflow: scroll, children: [revealed]) {
  UI.scene.reveal(revealed)
  unless UI.scene.scrolled.y == 1000px { INFO@mark `UI153 revealing a shape does not scroll to it` }
  UI.scene.reveal(revealed, align: center)
  unless UI.scene.scrolled.y == 650px { INFO@mark `UI154 revealing a shape in the centre does not centre it` }
  UI.scene.reveal(revealed, offset: -100px)
  unless UI.scene.scrolled.y == 900px { INFO@mark `UI155 a reveal's offset is not kept` }
  UI.scene.reveal(revealed, smooth: true)
  unless UI.scene.transition && UI.scene.scrolled.y == 1000px { INFO@mark `UI156 a smooth reveal does not move towards the shape` }
  UI.scene.scrolled = Geometry.Vector(0, 120px)
  unless UI.scene.scrolled.y == 120px { INFO@mark `UI157 the page scroll cannot be set` }
}
scroller := Geometry.Box(size: Geometry.Vector(100px, 200px), overflow: scroll, children: [Geometry.Box(origin: Geometry.Vector(0, -900px), size: Geometry.Vector(100px, 100px))])
scroller.reveal(scroller.children.first)
unless scroller.scrolled.y == 1000px { INFO@mark `UI158 revealing within a container does not scroll the container` }
unless revealed.size.y == 100px { INFO@mark `UI159 a shape's height cannot be measured` }
scrolled_child := Geometry.Box(height: 10px)
solved([Geometry.Box(scrolled: Geometry.Vector(0, 50px), overflow: scroll, children: [scrolled_child])])
unless scrolled_child.at.y == 840px { INFO@mark `UI160 a scrolled container does not move what it holds` }

keyboard := @me/device/keyboard
keyboard["f"].press(Keyboard.Modifier.control)
unless keyboard.pressed("f", modifier: Keyboard.Modifier.control | Keyboard.Modifier.meta) { INFO@mark `UI162 ctrl+f is not read as ctrl or cmd + f` }
if keyboard.pressed("f", modifier: Keyboard.Modifier.alt) { INFO@mark `UI163 ctrl+f is read as alt+f` }
keyboard["f"].release
if keyboard.pressed("f") { INFO@mark `UI164 a released key stays pressed` }
swipe_start := Time.now
UI.pointed().to(Geometry.Vector(200px, 0px), pressing: [0], time: swipe_start)
UI.pointed().to(Geometry.Vector(180px, 0px), time: swipe_start + 10 ms)
unless UI.pointer.velocity.x == -2px { INFO@mark `UI168 pointer velocity is not distance over time` }
UI.pointed().to(Geometry.Vector(100px, 0px), pressing: [], time: swipe_start + 300 ms)
unless UI.pointer.swipe.distance.x == -100px && UI.pointer.swipe.duration == 300 ms { INFO@mark `UI169 a press, move and release is not a swipe` }
selected_field := Geometry.Box(content: Choice(type: String, value: "hello"))
selected_field.select
unless selected_field.text.marks{.style == "selected"}.last.to == 5 && selected_field.text.marked_text("selected") == "hello" { INFO@mark `UI171 selecting a field whole does not select its text` }

watched_value := 1
fired_count := 0
watch := Program(code: { fired_count = fired_count + 1 }).when(Program(code: { watched_value }))
watch.fired
unless fired_count == 0 { INFO@mark `UI174 when … changes fires before anything changed` }
watched_value = 2
watch.fired
unless fired_count == 1 { INFO@mark `UI175 when … changes does not fire on a change` }
watch.fired
unless fired_count == 1 { INFO@mark `UI176 when … changes fires twice for one change` }
became_count := 0
becoming := Program(code: { became_count = became_count + 1 }).when(Program(code: { watched_value }), 3)
watched_value = 4
becoming.fired
watched_value = 3
becoming.fired
unless became_count == 1 { INFO@mark `UI177 when … becomes fires on another value` }
timer_fired := false
timer := Program(code: { timer_fired = true }).after(0 s)
timer.fired
unless timer_fired { INFO@mark `UI178 after fires late` }
if Program(code: { timer_fired = false }).after(1 h).ready { INFO@mark `UI179 after fires early` }
unless Program(code: { fired_count = 0 }).after(6 s) === Program(code: { fired_count = 0 }).after(6 s) { INFO@mark `UI180 a timer asked for again in the same frame restarts` }
unless ({ timer_fired = true } after 6 s) is UI.Watch { INFO@mark `UI181 x after 6 s is not a timer` }

watched := (@https://www.youtube.com/watch?v=O6v_gzlI1kY){alt: "OrbitMines"}
video := Program(code: { watched }){O: UI.Scene}()
unless video.content === watched && video.content.embedded == "https://www.youtube.com/embed/O6v_gzlI1kY" { INFO@mark `UI182 a YouTube link is not embedded as its player` }
solved([video])
unless video.size.y == video.size.x * 9 / 16 { INFO@mark `UI184 an embedded video is not 16:9` }
with UI.scene.size = Geometry.Vector(64px, 36px) {
  unless Program(code: { video }).rendered(Language.Direct.level).at(1, 1).alpha > 0 { INFO@mark `UI186 an embedded frame leaves no placeholder in a raster` }
}

site := UI.Site(index: (home: "home", fadi: (name: "fadi") @ @/@fadi, ether: (name: "ether") @ @/@ether))
unless site.at("/@nobody") === site.index { INFO@mark `UI187 a path nothing matches is not the index` }
unless site.at("/@fadi").name == "fadi" { INFO@mark `UI188 a path matching one value is not that value` }
unless UI.Site(index: (first: (name: "a") @ @/x/a, second: (name: "a") @ @/x/a)).at("/x/a")#.count == 2 { INFO@mark `UI189 two matches are not a chooser` }

ray_inline := @ray 1 + 2
unless ray_inline == 3 { INFO@mark `UI212 @ray does not read the rest of the line as Ray` }

logo := (@./logo.png){alt: "logo", width <= 400px}
logo_shape := Program(code: { logo }){O: UI.Scene}()
unless logo_shape.content === logo && logo_shape.content.language === Language.Image { INFO@mark `UI223 an image location is not shown as itself` }
unless logo.language === Language.Image && (@./clip.mp4).language === Language.Video && (@./song.mp3).language === Language.Audio { INFO@mark `UI224 a location's extension does not name its format` }
unless (@https://orbitmines.com/a.png?v=2).extension == "png" { INFO@mark `UI225 a query is read as part of the extension` }
unless logo_shape.fields["width"].type.most == 400px { INFO@mark `UI227 a narrowing on a location does not constrain where it is shown` }
placed_text := Program(code: { "Ray" @ (@https://orbitmines.com) }){O: UI.Scene}()
unless placed_text.content == "Ray" && placed_text.location == @https://orbitmines.com { INFO@mark `UI230 a value placed at a location is not a link to it` }
heading := Program(code: { "Ray" ^h1 }){O: UI.Scene}()
unless heading.content == "Ray" && heading.content.marks.some(.style == "h1") { INFO@mark `UI232 a style is not kept on the string it marks` }
highlighted := "x := 1".highlighted(".ray")
unless highlighted == "x := 1" && highlighted.partial_marks.nonempty { INFO@mark `UI233 a highlighted string is not the same string with marks` }
italic_text := Geometry.Box(content: "ab".marked("italic", 1, 2), size: Geometry.Vector(16px, 16px))
unless UI.Theme.face(italic_text, 1).font.style == italic && UI.Theme.face(italic_text, 0).font.style == normal { INFO@mark `UI235 a string's styles are not read per character` }
with @me = Character(name: "player") {
  unless Program(code: { "a" | "b" }){O: UI.Scene}().content is Choice { INFO@mark `UI239 a superposition is not a chooser for a player` }
}
with @me = Instance.local {
  if Program(code: { "a" | "b" }){O: UI.Scene}().content is Choice { INFO@mark `UI240 the computer asks someone to choose instead of picking` }
}

unless Geometry.left.vector(2) == Geometry.Vector(-1, 0) && Geometry.bottom.vector(2) == Geometry.Vector(0, -1) { INFO@mark `UI241 a side is not its axis and direction` }
unless Geometry.all.count == 4 && Geometry.horizontal#.count == 2 { INFO@mark `UI242 a plane does not have four sides` }
unless Geometry.Edges(1px, 2px, 3px, 4px)[Geometry.left] == 4px && Geometry.Edges(1px, 2px, 3px, 4px).total == Geometry.Vector(6px, 4px) { INFO@mark `UI243 edges are not read by side` }
unless (Geometry.Edges() ~~ .(Geometry.horizontal) = 5px).total == Geometry.Vector(10px, 0px) { INFO@mark `UI244 a superposed side does not set both edges` }
with Geometry.Space.current = Geometry.Space([Geometry.Axis(), Geometry.Axis(), Geometry.Axis()]) {
  unless Geometry.all.count == 6 && Geometry.Transform.identity.count == 4 { INFO@mark `UI245 a third axis does not add two sides and a row` }
  unless Geometry.Projection.orthographic().applied(Geometry.Vector(1, 2, 3)) == Geometry.Vector(1, 2) { INFO@mark `UI246 an orthographic projection does not drop depth` }
  unless Geometry.Box(size: Geometry.Vector(2, 2, 2)).contains(Geometry.Vector(1, 1, 1)) { INFO@mark `UI247 a box in three dimensions does not contain its centre` }
}
unless Geometry.euclidean(Geometry.Vector(0, 0), Geometry.Vector(3, 4)) == 5 { INFO@mark `UI248 the plane's distance is not euclidean` }
with Geometry.Space.current = Geometry.Space.grid(Geometry.Vector(2, 2)) {
  unless Geometry.graph(Geometry.Vector(0, 0), Geometry.Vector(1, 1)) == 2 { INFO@mark `UI249 a grid's distance is not the steps between cells` }
  square := Geometry.Cell(Geometry.Vector(0, 0), [0, 1])
  unless square.∂.count == 4 { INFO@mark `UI250 a square's boundary is not four edges` }
  unless [square].∂.∂.empty { INFO@mark `UI251 the boundary of a boundary is not nothing` }
  unless [square, Geometry.Cell(Geometry.Vector(1, 0), [0, 1])].∂.count == 6 { INFO@mark `UI252 the edge two squares share is on their boundary` }
  unless Geometry.Box(origin: Geometry.Vector(0, 0), size: Geometry.Vector(2, 1)).contains(Geometry.Vector(1, 0)) { INFO@mark `UI253 a region of cells does not contain its cell` }
}
with Geometry.Space.current = Geometry.Space.grid(Geometry.Vector(10, 10), loop: true) {
  unless Geometry.euclidean(Geometry.Vector(1, 0), Geometry.Vector(9, 0)) == 2 { INFO@mark `UI254 a looping axis does not wrap around` }
}
unless Geometry.Polygon(boundary: Geometry.triangle(Geometry.Vector(10, 10)), size: Geometry.Vector(10, 10)).contains(Geometry.Vector(5, 6)) { INFO@mark `UI255 a triangle does not wind around its centre` }
if Geometry.Polygon(boundary: Geometry.triangle(Geometry.Vector(10, 10)), size: Geometry.Vector(10, 10)).contains(Geometry.Vector(1, 9)) { INFO@mark `UI256 a triangle winds around a point outside it` }
unless Geometry.Sierpinski(size: Geometry.Vector(2px, 2px)).dimension.erred { INFO@mark `UI257 a fractal's dimension is measured before it is implemented` }
unless Compiler.reduced(Geometry.Sierpinski(size: Geometry.Vector(2px, 2px)), Geometry.Approximating(4px)).children.empty { INFO@mark `UI258 a copy smaller than the resolution is divided` }
unless Compiler.reduced(Geometry.Sierpinski(size: Geometry.Vector(16px, 16px)), Geometry.Approximating(4px)).children.count == 3 { INFO@mark `UI259 a fractal larger than the resolution is not its copies` }
animated := Geometry.Vector(0px, 0px) -> Geometry.Vector(100px, 0px) over (0 s .. 0.3 s)
with Time.now = animated.stops.last.at {
  unless animated.value == Geometry.Vector(100px, 0px) { INFO@mark `UI260 a value over a time is not where it ends when it ends` }
}
unless Geometry.Space.of(Graph.Simple().connect(1, 2)).projection.erred { INFO@mark `UI261 a graph is embedded before embedding is implemented` }
unless Compiler.reduced(Geometry.Vector(1px, 2px).map(. * 2), Geometry.specialised) == Geometry.Vector(2px, 4px) { INFO@mark `UI262 specialising a known plane changes what a vector maps to` }
unless Geometry.Transform.rotate((1 / 4) turn).count == 3 { INFO@mark `UI263 a plane's transform is not three by three` }

// A share in a length is a share of the parent; a theme style narrows; a location literal takes a narrowing
halved := Geometry.Box(size: Geometry.Vector(1000px, 800px), children: [Geometry.Box(){width <= 50%}]).solve
unless halved.children.first.size.x == 500px { INFO@mark `UI264 a share bound is not a share of the parent's width` }
unless Geometry.Box(size: Geometry.Vector(10px, 20px), radius: [50%]).radii.first == Geometry.Vector(5px, 10px) { INFO@mark `UI265 a share radius is not half the shape's size` }
with UI.Theme.styles = [("tall", {height >= 30px})] {
  unless Geometry.Box().styled("tall").fields["height"].type.least == 30px { INFO@mark `UI266 a theme style does not carry its bound` }
}
unless Choice(type: String{search}, value: "ray").shown == "ray" { INFO@mark `UI267 a search field is not a text field in the terminal` }
unless (@https://youtu.be/abc?si=xyz&t=1m5s).embedded as String == "https://www.youtube.com/embed/abc?si=xyz&start=65" { INFO@mark `UI268 an embedding drops the query` }
unless (@https://www.youtube.com/watch?v=abc&t=30).embedded as String == "https://www.youtube.com/embed/abc?start=30" { INFO@mark `UI269 a watch link's time is not where the embed starts` }
unless Program(code: { Choice(type: String) ^muted }){O: UI.Scene}().styles.contains("muted") { INFO@mark `UI270 a styled choice is not a styled box holding it` }
unless (@./logo.png{alt: "logo"}).alt == "logo" { INFO@mark `UI271 a narrowing after a location literal is not a narrowing` }
unless @./logo.png{alt: "logo"} as String == "./logo.png" { INFO@mark `UI272 a narrowing is read into the location's path` }
alt_of := (name: String) => @./logo.png{alt: name}
unless alt_of("written").alt == "written" { INFO@mark `UI273 a name in a narrowing is read against the location instead of where it is written` }
unless (@https://orbitmines.com/archive?search=).query.search == None { INFO@mark `UI274 an empty query parameter is not None` }
unless (@https://orbitmines.com/archive?page=2).query.search == None { INFO@mark `UI275 a missing query parameter is not None` }
unless ((@https://orbitmines.com/archive).query.search ?? "all") == "all" { INFO@mark `UI276 a location without a query has no parameter to default` }
unless (@https://orbitmines.com/archive).with(search: None) as String == "https://orbitmines.com/archive" { INFO@mark `UI277 an empty query is written` }

// Geometry's y points up; a screen's points down, and its levels flip what they are given.
unless Geometry.Space.plane.axes[1].orientation == +1 { INFO@mark `YU1 the plane's y does not point up` }
unless Geometry.Space.screen.axes[1].orientation == -1 { INFO@mark `YU2 a screen's y does not point down` }
unless Geometry.top.vector(2) == Geometry.Vector(0, 1) { INFO@mark `YU3 top is not up` }
unless Geometry.top.label == "top" && Geometry.bottom.label == "bottom" { INFO@mark `YU4 a side is not called what it is` }
unless Geometry.Space.screen.seen(Geometry.Vector(3px, 10px), Geometry.Vector(100px, 100px)) == Geometry.Vector(3px, 90px) { INFO@mark `YU5 a point is not flipped onto a screen` }
unless Geometry.Space.screen.seen(Geometry.Vector(0px, 80px), Geometry.Vector(100px, 100px), Geometry.Vector(10px, 20px)) == Geometry.Vector(0px, 0px) { INFO@mark `YU6 a box at the top is not at the top of a screen` }
unless Geometry.Space.screen.seen(Geometry.Vector(2px, 3px)) == Geometry.Vector(2px, -3px) { INFO@mark `YU7 a displacement up is not one up a screen` }
if Geometry.Space.plane.seen(Geometry.Vector(3px, 10px), Geometry.Vector(100px, 100px)) != Geometry.Vector(3px, 10px) { INFO@mark `YU8 the plane flips what it is given` }
first_laid := Geometry.Box(height: 20px)
second_laid := Geometry.Box(height: 20px)
solved([first_laid, second_laid])
unless first_laid.origin.y == 780px { INFO@mark `YU9 the first shape in a flow is not at the top` }
unless second_laid.origin.y < first_laid.origin.y { INFO@mark `YU10 a shape later in a flow is not below the one before it` }
bottomed := Geometry.Box(position: Geometry.Absolute(), inset: Geometry.Edges(None, None, 4px, None), height: 10px)
solved([bottomed])
unless bottomed.origin.y == 4px { INFO@mark `YU11 a bottom inset is not measured up from the bottom` }
unless Geometry.Edges(1px, 2px, 3px, 4px).start == Geometry.Vector(4px, 3px) { INFO@mark `YU12 a box's corner of origin is not its bottom left` }

// Spaces by their axes, holes, fields over points, sampling on a grid (F-G2, F-G4, F-G5, F-G6)
unless Geometry.Space.grid(Geometry.Vector(4, 4), [true, false]) is Geometry.Space.Cylinder { INFO@mark `FWG1 a grid with one looped axis is not a cylinder` }
unless Geometry.Space.grid(Geometry.Vector(4, 4), true) is Geometry.Space.Torus { INFO@mark `FWG2 a grid looped both ways is not a torus` }
unless Geometry.Space.plane is Geometry.Space.Plane { INFO@mark `FWG3 the plane is not a Plane` }
holed := Geometry.Box(size: Geometry.Vector(4px, 4px)) - Geometry.Box(size: Geometry.Vector(2px, 2px), transform: Geometry.Transform.translate(Geometry.Vector(1px, 1px)))
if holed.contains(Geometry.Vector(2px, 2px)) { INFO@mark `FWG4 a point in a hole is inside the shape` }
unless holed.contains(Geometry.Vector(0.5px, 0.5px)) { INFO@mark `FWG5 a point beside a hole is outside the shape` }
halves := (point: Geometry.Vector) => point.x > 1px ? Geometry.Color(255, 0, 0) : Geometry.Color(0, 0, 255)
unless Geometry.Box().sampled(halves, Geometry.Vector(2px, 0px)) == Geometry.Color(255, 0, 0) { INFO@mark `FWG6 a field is not read at its point` }
unless Geometry.Box().sampled(Geometry.Color(0, 255, 0), Geometry.Vector(2px, 0px)) == Geometry.Color(0, 255, 0) { INFO@mark `FWG7 a constant paint is not its own value at every point` }
unless Geometry.Box(size: Geometry.Vector(4px, 2px)).discretized(1px).cells.count == 8 { INFO@mark `FWG8 a box sampled at one pixel is not one cell per pixel` }

// Controllers are numbered on the device and take back their number (F-I1)
pad_device := Device()
unless pad_device.connected("pad A").id == 0 && pad_device.connected("pad A").guest { INFO@mark `FWU1 a new controller is not a guest with the first free id` }
unless pad_device.connected("pad B").id == 1 { INFO@mark `FWU2 a second controller does not take the next id` }
pad_device.disconnected("pad A")
unless pad_device.connected("pad A").id == 0 { INFO@mark `FWU3 a reconnecting controller does not take back its id` }
