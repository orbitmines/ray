  (parent reads ({fields}) as made) unless (parent === Node) || inherits_structure(`{fields}`, parent)
  made &+= {
    of := .
    {this}({arguments: Arguments}) => (this &+ {
      ({{fields}}) taking {arguments}
    })
    {this}() => this(declared)
  }
  made
})()
