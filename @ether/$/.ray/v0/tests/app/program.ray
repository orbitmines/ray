// A program is what it is written as. `**` reads one off a block handed to a
// rule, and what it reads is a program in turn — so what holds a program holds
// programs all the way down.
//
// The engine hands over two things and no more: the first statement, and what
// is left of the program after it. The chain that holds them is built in the
// language, with the same `chain` and `&=` as everything else, so a program is
// made of the language rather than of the engine.

mark ^keyword := external global

Written ^keyword := class {
  of (code) => code**
}
taken ^keyword := Written.of({
  one
  two
  three
})
unless (exists taken) { INFO@mark `PG1 a block handed to a rule is not read as a program` }
unless (exists taken.written) { INFO@mark `PG3 a program is not written as anything` }
unless (taken.count == three) { INFO@mark `PG8 a program of three statements does not count three` }
walked ^keyword := zero
taken for { walked = walked.succ }
unless (walked == three) { INFO@mark `PG9 walking a program of three does not visit three` }
unless (exists taken.first.value.written) { INFO@mark `PG5 a statement is not a program in turn` }
unless (taken.first.value.count == one) { INFO@mark `PG10 a statement is written as other than one thing` }

// A program of one statement is written as that one.
alone ^keyword := Written.of({ five })
unless (alone.count == one) { INFO@mark `PG11 a program of one statement counts other than one` }

// What it is read with: a level is a set of rules, and a program says which.
unless (exists taken.O) { INFO@mark `PG12 a program does not say which rules it is read with` }

// spec: running a program does not answer what it says — `p()` is not how a
// program is run, and neither is running one of the statements it is written
// as. What a program is *for* is being read back: `**` is asked for one at
// every method definition, and what runs is the method.

// A program is walkable as what it does as well as what it is written as:
// `flow` is the statements in order, where a jump is also an edge to the
// label it names, and goes on to what is written below it only when it has a
// condition. A statement is told apart by reading it back as bits.
// spec: that is the same want as applying a compiler level — the program read
// back, not just held — and nothing applies one yet.

// A statement is read back as what it is written as, so a jump can be told
// from anything else, and where it lands can be found.
jumping ^keyword := Written.of({
  goto past if five
  five
 past\
  six
})
landed ^keyword := jumping.written.head.next.next.value
unless (jumping.first.value.is_jump) { INFO@mark `PG16 a goto is not read as a jump` }
if (jumping.last.value.is_jump) { INFO@mark `PG17 a value is read as a jump` }
if (taken.first.value.is_jump) { INFO@mark `PG18 a name is read as a jump` }
unless (landed.is_label) { INFO@mark `PG19 a label is not read as one` }
if (jumping.first.value.is_label) { INFO@mark `PG20 a jump is read as a label` }
unless (jumping.first.value.is_conditional) { INFO@mark `PG21 a jump with a condition is not conditional` }
unless (exists (external alike (external where jumping.target_of(jumping.first.value)) (external where landed))) { INFO@mark `PG22 a jump does not land on its label` }
always ^keyword := Written.of({
  goto away
 away\
})
if (always.first.value.is_conditional) { INFO@mark `PG23 a jump without a condition is conditional` }
if (exists jumping.target_of(always.first.value)) { INFO@mark `PG24 a jump lands on a label it does not name` }

// As what it does: a jump is an edge to where it lands, and only a
// conditional one also goes on to what is written below it.
flowing ^keyword := jumping.flow
unless (exists flowing.head.jumps_to) { INFO@mark `PG25 a jump is not an edge` }
unless (exists (external alike (external where flowing.head.jumps_to.value) (external where landed))) { INFO@mark `PG26 a jump's edge does not reach its label` }
unless flowing.head.falls_through { INFO@mark `PG27 a conditional jump does not go on below it` }
unless flowing.head.next.falls_through { INFO@mark `PG28 a value does not go on below it` }
if always.flow.head.falls_through { INFO@mark `PG29 a jump without a condition goes on below it` }
