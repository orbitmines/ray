mark ^keyword := external global

uu := UUID.v4()
unless (uu.spelled.count == 32) { INFO@mark `UU1 v4 has other than 32 digits` }
unless (uu.version == 4) { INFO@mark `UU2 v4 version is not 4` }
unless (uu.variant == UUID.Variant.rfc_4122) { INFO@mark `UU3 v4 variant is not RFC 4122` }
uu_text := uu.as_string
unless (uu_text.count == 36) { INFO@mark `UU4 v4 text is not 36 characters` }
unless (uu_text.at(8).value == U+002D) { INFO@mark `UU5 no dash after eight digits` }
unless (uu_text.at(14).value == U+0034) { INFO@mark `UU6 the version digit is not 4` }

// A UUID is itself.
unless (uu == uu) { INFO@mark `UU7 a uuid is not itself` }

// The text form puts its dashes where RFC 4122 asks.
unless (uu_text.at(13).value == U+002D) { INFO@mark `UU10 no dash after thirteen characters` }
unless (uu_text.at(18).value == U+002D) { INFO@mark `UU11 no dash after eighteen characters` }
unless (uu_text.at(23).value == U+002D) { INFO@mark `UU12 no dash after twenty-three characters` }

// spec: two draws are two uuids, which `feature.ray` claims of the bits they
// are drawn from rather than of the uuids. A second draw here costs more than
// ten minutes: the digits now actually vary, so every nibble is accumulated
// rather than left at zero, and a number is a walk.

// What is written down is read back as the same uuid. A text is read here
// rather than a drawn uuid written out and read again, because drawing costs
// a nibble's worth of walking for each of thirty-two digits.
spelled_out := "00000000-0000-4000-8000-000000000000"
read_back := UUID.read(spelled_out)
unless (read_back.spelled.count == 32) { INFO@mark `UU15 what is read back has other than 32 digits` }
unless (read_back.version == 4) { INFO@mark `UU16 what is read back is not of the version it was written with` }
unless (read_back.variant == UUID.Variant.rfc_4122) { INFO@mark `UU17 what is read back is not of the variant it was written with` }
unless (read_back.as_string == spelled_out) { INFO@mark `UU13 a uuid written down does not read back as itself` }

// What a digit written in sixteen is worth, either case.
unless ("7".head.value.hexadecimal_digit == 7) { INFO@mark `UU18 7 is not seven in sixteen` }
unless ("a".head.value.hexadecimal_digit == 10) { INFO@mark `UU19 a is not ten in sixteen` }
unless ("F".head.value.hexadecimal_digit == 15) { INFO@mark `UU20 F is not fifteen in sixteen` }

// The other versions the draft names. spec: what makes each of them what it
// is — a timestamp, an md5, an sha1 — waits on the clock and on the hashes,
// so what is claimed here is that they are written down.
unless (UUID.v1) { INFO@mark `UU21 the version built from a time is not there` }
unless (UUID.v3) { INFO@mark `UU22 the version built from a namespace and a name is not there` }
unless (UUID.v5) { INFO@mark `UU23 the other version built that way is not there` }
// spec: building a `v3` or a `v5` is not claimed here — the `namespace: UUID`
// field is typed, and asking whether a thirty-two digit uuid is one costs
// more than the rest of the file.

// A version 1 identifier: when it was made, counted in hundreds of
// nanoseconds since the Gregorian reform, and never the same twice.
made_first := UUID.v1.generate
made_second := UUID.v1.generate
unless (made_first.version == 1) { INFO@mark `UU30 a generated version 1 identifier is not version 1` }
if (made_first == made_second) { INFO@mark `UU31 two version 1 identifiers made one after the other are the same` }
unless (made_first.time < made_second.time) { INFO@mark `UU32 the later identifier is not later` }
unless (made_first.variant == UUID.Variant.rfc_4122) { INFO@mark `UU33 a generated identifier is not of the RFC 4122 variant` }
unless (UUID.Namespace.DNS.version == 1) { INFO@mark `UU34 the DNS namespace is not a version 1 identifier` }
unless (UUID.Namespace.DNS.as_string == "6ba7b810-9dad-11d1-80b4-00c04fd430c8") { INFO@mark `UU35 the DNS namespace does not write as itself` }
