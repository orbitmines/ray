Language.Direct := class: Language {
  static extensions = ".direct"
  static space (size: Geometry.Vector) => Geometry.Space.grid(Geometry.Vector(size.x as px, size.y as px))

  Drawing := class = raster: Geometry.Raster, ops: *[]
  Draw := class = shape: Geometry.Shape, outer: Geometry.Transform = Geometry.Transform.identity {
    placed => outer * Geometry.Transform.translate(shape.at) * shape.displayed("transform")
    inner => placed * Geometry.Transform.translate(shape.at * -1)
    area => space(shape.size).positions
    inside => shape.rectangular ? area : area{shape.boundary.winding(.) != 0}
    opacity => shape.effects{. is Geometry.Filter && .kind == opacity}.amount.product ?? 1
  }
  Painted := class = points: (at: Geometry.Vector, sample: Geometry.Vector)[], paint: Geometry.Paint?, alpha: Probability = 1
  Outlined := class = outlines: Geometry.Curve[], transform: Geometry.Transform, paint: Geometry.Paint?
  Stroked := class = outline: Geometry.Shape, transform: Geometry.Transform, width: Geometry.Length, paint: Geometry.Paint?
  Shown := class = draw: Draw

  rules := {
    {root: Geometry.Shape{solved}} => Drawing(Geometry.Raster.blank(root.size.x as px, root.size.y as px), [Draw(root), root.lifted.map(Draw(.))].flatten)
    {drawing: Drawing{ops.flatten.every(. is Program)}} => drawing.raster ~~ drawing.ops.flatten

    {draw: Draw{shape.content is Choice}} => [
      Draw(Geometry.Box(origin: draw.shape.at, size: draw.shape.size, fill: draw.shape.painted(draw.shape.fill), stroke: draw.shape.stroke, radius: draw.shape.radius, effects: draw.shape.effects), draw.outer),
      Draw(draw.shape.face, draw.outer)
    ]
    {draw: Draw} => [
      Painted(draw.inside.map(point => (at: draw.placed.applied(point), sample: point)), draw.shape.painted(draw.shape.fill), draw.opacity) if draw.shape.fill && !(draw.shape.content is Location),
      Stroked(draw.shape.boundary, draw.placed, draw.shape.stroke.width, draw.shape.painted(draw.shape.stroke.paint)) if draw.shape.stroke,
      Shown(draw) if draw.shape.content,
      draw.shape.in_place.sort_by(.layer).map(Draw(., draw.inner)) if draw.shape.visible,
      draw.shape.effects{. is Geometry.Blur}.map(blur => { .blurred(draw.inside.map(draw.placed.applied(.)), blur.radius as px) })
    ]

    {shown: Shown{draw.shape.content is String}} => shown.draw -- (draw => draw.shape -- (text => with Geometry.Font.inherited = text.em {
      text.lines(text.size.x).enumerate.map(row => row.value.reduce(placed = (pen: 0px, ops: []) => {
        look = UI.Theme.face(text, .index)
        size = look.font.size as px
        height = size * look.font.line_height
        glyph = Font(look.font).glyph(text.case ? text.case(.) : .)
        (pen: placed.pen + glyph.advance * size / glyph.units, ops: [placed.ops,
          Draw(Geometry.Box(origin: Geometry.Vector(placed.pen, row.index * height), size: Geometry.Vector(size * 0.6, height), fill: look.fill), draw.placed) if look.styles.contains("selected"),
          Outlined(glyph.outlines, draw.placed * Geometry.Transform.translate(Geometry.Vector(placed.pen, row.index * height)) * Geometry.Transform.scale(Geometry.Vector(size / glyph.units, size / glyph.units)), text.painted(look.color) ?? Geometry.Color(0, 0, 0))
        ].flatten)
      }).ops).flatten
    }))
    {shown: Shown{draw.shape.content is Location && draw.shape.content.language === Language.Image && draw.shape.fill}} => shown.draw -- (draw => draw.shape.content.pixels -- (raster => draw.area.map(point =>
      draw.placed.applied(point) -- (at => { .put(at.x, at.y, ((draw.shape.painted(draw.shape.fill) as Geometry.Color) ?? Geometry.Color(0, 0, 0)) ~~ .alpha *= raster.at(point.x * raster.width / draw.shape.size.x, point.y * raster.height / draw.shape.size.y).alpha) })
    )))
    {shown: Shown{draw.shape.content is Location && draw.shape.content.language === Language.Image}} => shown.draw -- (draw => draw.shape.content.pixels -- (raster => draw.area.map(point =>
      draw.placed.applied(point) -- (at => { .put(at.x, at.y, raster.at(point.x * raster.width / draw.shape.size.x, point.y * raster.height / draw.shape.size.y)) })
    )))
    {shown: Shown{draw.shape.content is Location && draw.shape.content.video_site}} => shown.draw -- (draw => Draw(Geometry.Box(origin: draw.shape.at, size: draw.shape.size, fill: Geometry.Color(17, 20, 24), stroke: Geometry.Stroke(Geometry.Color(128, 128, 128)), children: [
      Geometry.Box(content: "▶ " + (draw.shape.content.alt ?? draw.shape.content as String), origin: draw.shape.size * (1 / 4) + Geometry.Vector(0, draw.shape.size.y / 4 - 8px), size: draw.shape.size * (1 / 2), align: center, color: Geometry.Color(246, 247, 249))
    ]), draw.outer))
    {shown: Shown{draw.shape.content is Program}} => shown.draw -- (draw => draw.shape.content().map(Draw(., draw.placed)))
    {shown: Shown} => []

    {painted: Painted{paint is Geometry.Color}} => (painted.paint ~~ .alpha *= painted.alpha) -- (color => painted.points.map(point => { .put(point.at.x, point.at.y, color) }))
    {painted: Painted{paint is Geometry.Gradient}} => painted.points.map(point => { .put(point.at.x, point.at.y, painted.paint.at(point.sample.x) ~~ .alpha *= painted.alpha) })
    {painted: Painted{paint is Geometry.Pattern}} => painted.paint -- (pattern => Compiler.reduced(Drawing(Geometry.Raster.blank(pattern.repeat.x as px, pattern.repeat.y as px), [Draw(pattern.shape)]), rules) -- (tile =>
      painted.points.map(point => { .put(point.at.x, point.at.y, tile.at(point.sample.x % pattern.repeat.x, point.sample.y % pattern.repeat.y) ~~ .alpha *= painted.alpha) })
    ))
    {painted: Painted} => []
    {outlined: Outlined} => outlined.outlines.map(.edges.map((a, b) => (outlined.transform.applied(a), outlined.transform.applied(b)))).flatten(1) -- (edges => edges.map(.0.y) -- (ys => Painted((ys.min..<ys.max).map(y =>
      edges{(.0.y <= y) != (.1.y <= y)}.map(.0.x + (y - .0.y) * (.1.x - .0.x) / (.1.y - .0.y)).sort.chunk(2).map((a, b) => (a..<b).map(x => (at: Geometry.Vector(x, y), sample: Geometry.Vector(x, y))))
    ).flatten, outlined.paint)))
    {stroked: Stroked} => Painted(stroked.outline.edges.map((a, b) => (stroked.transform.applied(a), stroked.transform.applied(b))).map((a, b) =>
      (0..<a.distance(b) as px).map(step => a.mix(b, step / a.distance(b)) -- (point => (-(stroked.width / 2)..stroked.width / 2).map(w => (at: Geometry.Vector(point.x + w, point.y), sample: point))))
    ).flatten, stroked.paint)
  }
  level := Geometry.Preparing(1px) + rules

  Font := class = font: Geometry.Font {
    file => font.family.map(Fonts.located(.)).first
    glyph (character: Char) => $.opentype.read(IO.host(file.path))[character]
  }
  Fonts := class {
    located (family: String) => ["/usr/share/fonts", "/System/Library/Fonts", "C:/Windows/Fonts"].map(IO.listing(.)).flatten{(.segments.last ?? "").fold_case ~= family.fold_case}.first
  }

  Display := class = target: Location, title: String = "" {
    write (raster: Geometry.Raster) => (title = UI.page?.title ?? "") -- IO.write(target, raster)
    open (to: Location) => OS.launch(to)
    read => $.html.DOM.dispatched(external io `window` None)
  }
}
