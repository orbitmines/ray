      q = q + 1
    }
    text(o, n)
  }
  static text_put (n, r: Text) => {
    copy(n, r.from, r.to - r.from)
    n + (r.to - r.from)
  }
  static byte_kept (n, q) => {
    byte_put(n, byte(q))
    n + 1
  }
  static mapped_structure (n: Node, f, g) => Readings.structure_into(copied(n), n.keys, list(), f, g)
  static structure_into (o: Node, s: List, l, f, g) => {
    i := 0
    while i < s.count {
