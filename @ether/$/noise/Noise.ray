// The Noise Protocol Framework, revision 34 (https://noiseprotocol.org/noise.html)
Noise := class: Language = pattern = XX, dh: Encoding.Agreement = X25519, cipher = ChaCha20Poly1305, hash: Encoding.Digest = SHA256 {
  static extensions = ".noise"

  // Tokens of message patterns (§7.1); XX: -> e, <- e, ee, s, es, -> s, se (§7.5)
  static Token := enum e | s | ee | es | se | ss
  static XX = (name: "XX", messages: [[Token.e], [Token.e, Token.ee, Token.s, Token.es], [Token.s, Token.se]])

  // The protocol name: the pattern, then the DH, cipher and hash functions by their Noise names (§8, §12.1, §12.3, §12.5)
  static called (algorithm) => algorithm === X25519 ? "25519" : algorithm === ChaCha20Poly1305 ? "ChaChaPoly" : algorithm === SHA256 ? "SHA256"
    : Program(name: "a Noise name for this algorithm", goal: algorithm)
  name => ["Noise", pattern.name, called(dh), called(cipher), called(hash)].join("_")
  size => hash.write([]).bytes.count

  // HMAC (https://www.rfc-editor.org/rfc/rfc2104#section-2), and HKDF: extract with the salt, then expand T(1), T(2), … (https://www.rfc-editor.org/rfc/rfc5869#section-2.2, #section-2.3);
  // Noise's HKDF is this with the chaining key as salt and no info (§4.3)
  hmac (key: Byte[], data: Byte[]) => (key.count > hash.block ? hash.write(key).bytes : key) -- (k => [k, [0] * (hash.block - k.count)].flatten) -- (k =>
    hash.write([k.map(. ~x|| 0x5c), hash.write([k.map(. ~x|| 0x36), data].flatten).bytes].flatten).bytes)
  hkdf (salt: Byte[], ikm: Byte[], info: Byte[] = [], length: Number = 2 * size) => expanded(hmac(salt, ikm), info, length)
  expanded (prk: Byte[], info: Byte[], length: Number) => (1..(length / size).ceil).reduce(blocks = [] => [blocks, [hmac(prk, [blocks.last ?? [], info, .].flatten)]].flatten(1)).flatten[..<length]

  // A CipherState: a key and a nonce; with no key yet, text passes as it is (§5.1). ChaChaPoly's nonce is 32 zero bits, then n as 64 bits little-endian (§12.3)
  static Cipher := class = cipher: Language = ChaCha20Poly1305, k: Byte₃₂?, n: Number = 0 {
    nonce => [[0] * 4, Encoding.little(n, 8)].flatten
    encrypted (ad: Byte[], plaintext: Byte[]) => k ? cipher.sealed(k, nonce, ad, plaintext) ~~ (n += 1) : plaintext
    decrypted (ad: Byte[], ciphertext: Byte[]) => k ? cipher.opened(k, nonce, ad, ciphertext) ~~ (n += 1) : ciphertext
  }

  // A handshake, initiated or answered with a static key; its DH function is the one the key names (§5.3)
  static handshake (initiator: boolean, s: Encoding.Key, prologue: Byte[] = [], pattern = XX, cipher = ChaCha20Poly1305, hash: Encoding.Digest = SHA256) =>
    Handshake(protocol: Noise(pattern, dh: s.algorithm, cipher, hash), initiator, s) ~~ .mixed_hash(prologue)

  // The HandshakeState with its SymmetricState: the name as h (padded, or hashed when longer than HASHLEN), ck = h, then the tokens of each message in turn (§5.2, §5.3)
  static Handshake := class = protocol: Noise, initiator: boolean, s: Encoding.Key, e: Encoding.Key?, rs: Byte[]?, re: Byte[]?, step: Number = 0 {
    h: Byte[] = protocol.name.bytes -- (.count <= protocol.size ? [., [0] * (protocol.size - .count)].flatten : protocol.hash.write(.).bytes)
    ck: Byte[] = h
    cipher: Cipher = Cipher(cipher: protocol.cipher)
    bound: Byte[]?

    width => s.public.count
    messages => protocol.pattern.messages
    done => step == messages.count
    writes => !done && (step % 2 == 0) == initiator

    mixed_hash (data: Byte[]): static => this ~~ (.h = protocol.hash.write([h, data].flatten).bytes)
    mixed_key (ikm: Byte[]): static => protocol.hkdf(ck, ikm).chunk(protocol.size) -- (out => this ~~ (.ck = out[0]) ~~ (.cipher = Cipher(cipher: protocol.cipher, k: out[1][..<32])))
    encrypted_and_hashed (plaintext: Byte[]) => cipher.encrypted(h, plaintext) -- (c => c ~~ mixed_hash(c))
    decrypted_and_hashed (ciphertext: Byte[]) => cipher.decrypted(h, ciphertext) ~~ mixed_hash(ciphertext)
    // ee, ss, and es / se from each side's view (§5.3)
    agreed (token: Token) => token == Token.ee ? e.agreed(re) : token == Token.ss ? s.agreed(rs) : (token == Token.es) == initiator ? e.agreed(rs) : s.agreed(re)

    // WriteMessage: e appends a fresh ephemeral key, s the static key encrypted, a DH token mixes the key; then the payload, after h is kept as what a signature binds (§5.3)
    written (payload: Byte[] = []) => messages[step].reduce(message = [] => . -- (token => [message,
      token == Token.e ? (e = protocol.dh.pair()).public ~~ mixed_hash(e.public)
      : token == Token.s ? encrypted_and_hashed(s.public)
      : [] ~~ mixed_key(agreed(token))].flatten)
    ) -- (message => [message, encrypted_and_hashed(payload ~~ (bound = h))].flatten) ~~ (step += 1)

    // ReadMessage: the same tokens taken off the front; the payload is what is left (§5.3)
    read (message: Byte[]) => messages[step].reduce(rest = message => . -- (token =>
      token == Token.e ? rest[width..] ~~ (re = rest[..<width]) ~~ mixed_hash(re)
      : token == Token.s ? (width + (cipher.k ? 16 : 0)) -- (n => rest[n..] ~~ (rs = decrypted_and_hashed(rest[..<n])))
      : rest ~~ mixed_key(agreed(token)))
    ) -- (rest => decrypted_and_hashed(rest ~~ (bound = h))) ~~ (step += 1)

    // Split: two CipherStates from ck, the first for the initiator's sending; h stays as the channel binding (§5.2, §11.2)
    session => done ? protocol.hkdf(ck, []).chunk(protocol.size).map(Cipher(cipher: protocol.cipher, k: .[..<32])) -- (pair =>
      Session(sending: initiator ? pair[0] : pair[1], receiving: initiator ? pair[1] : pair[0], binding: h, peer: Encoding.Key(algorithm: protocol.dh, public: rs)))
      : Program(name: "finish the handshake", goal: this)
  }

  // The transport phase: each side's CipherState, the handshake hash, and the remote static key (§5.1, §11.2)
  static Session := class = sending: Cipher, receiving: Cipher, binding: Byte[], peer: Encoding.Key {
    sent (payload: Byte[]) => sending.encrypted([], payload)
    received (message: Byte[]) => receiving.decrypted([], message)
  }
}
