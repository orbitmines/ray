// Secure Hash Standard, SHA-1 (https://csrc.nist.gov/pubs/fips/180-4/upd1/final)
SHA1 := class: Language {
  static extensions := ".sha1"
  // 512-bit blocks, a 160-bit digest, in bytes (FIPS 180-4 §1)
  static block := 64
  static size := 20

  // Padding: the message, a 1 bit, zeros, and the message length in bits as 64 bits (FIPS 180-4 §5.1.1)
  static Padded := class (message: Byte[], 0x80, Byte{== 0}[]{length == (119 - message.count % 64) % 64}, size: Binary₆₄ = message.count * 8)
  // The padded message is a multiple of 512 bits, its last 64 bits the length (FIPS 180-4 §5.1.1)
  assert (SHA1.Padded(message: "abc".bytes) as Byte[]).count == 64 && (SHA1.Padded(message: "abc".bytes) as Byte[]).last == 0x18  // SHI4 abc is not padded to one block ending in its length, 24 bits
  assert (SHA1.Padded(message: [0] * 56) as Byte[]).count == 128  // SHI5 a 448-bit message is not padded to two blocks
  // Initial hash value (FIPS 180-4 §5.3.1)
  static initial := [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
  // Constants, one for each twenty steps (FIPS 180-4 §4.2.1)
  static K := [0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xCA62C1D6]
  // Ch, Parity, Maj, Parity (FIPS 180-4 §4.1.1)
  static f (t, x, y, z) => t < 20 ? (x ~&& y) ~x|| ((2 ^ 32 - 1 - x) ~&& z)
    : 40 <= t < 60 ? (x ~&& y) ~x|| (x ~&& z) ~x|| (y ~&& z)
    : x ~x|| y ~x|| z
  // ROTL (FIPS 180-4 §3.2)
  static rotl (x, n) => ((x as Binary₃₂).loop << n) as Number
  // Message schedule (FIPS 180-4 §6.1.2, step 1)
  static schedule (block: Binary₃₂[]) => (16..<80).reduce(w = block => [w, rotl(w[-3] ~x|| w[-8] ~x|| w[-14] ~x|| w[-16], 1)])
  // Eighty steps over a, b, c, d, e, then added to the hash (FIPS 180-4 §6.1.2, steps 2–4)
  static compressed (h, block: Binary₃₂[]) => schedule(block).enumerate.reduce(v = h => [
    (rotl(v[0], 5) + f(.index, v[1], v[2], v[3]) + v[4] + K[(.index / 20).floor] + .value) % 2 ^ 32, v[0], rotl(v[1], 30), v[2], v[3]
  ]).zip(h).map((a, b) => (a + b) % 2 ^ 32)

  written := {
    {writing: Language.Writing} => (Padded(message: writing.value as Byte[]) as Byte[]).chunk(64).map(.chunk(4).map(. as Binary₃₂))
      .reduce(h = initial => compressed(h, .)).map(. as Binary₃₂ as Byte₄).flatten
  }
}
// One-block message "abc" (FIPS 180-4 example SHA1.pdf, and FIPS 180-2 Appendix A.1)
assert SHA1.write("abc".bytes) as Byte₂₀ as Hexadecimal₄₀ == "a9993e364706816aba3e25717850c26c9cd0d89d"  // SHI1 abc does not digest as in FIPS 180's one-block example
// Two-block message, the 448 bits "abcdbcde…nopq" (FIPS 180-4 example SHA1.pdf, and FIPS 180-2 Appendix A.2)
assert SHA1.write("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes) as Byte₂₀ as Hexadecimal₄₀ == "84983e441c3bd26ebaae4aa1f95129e5e54670f1"  // SHI2 the 448-bit message does not digest as in FIPS 180's two-block example
// The empty message (NIST CAVP SHAVS, SHA1ShortMsg.rsp, Len = 0)
assert SHA1.write([]) as Byte₂₀ as Hexadecimal₄₀ == "da39a3ee5e6b4b0d3255bfef95601890afd80709"  // SHI3 the empty message does not digest as da39a3ee…
