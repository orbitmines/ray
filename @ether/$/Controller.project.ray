@ether/os
@ether/device

// Game controllers: numbered on the device as they connect, a disconnected one taking its number back (F-I1); a controller
// nobody plays is a guest
Controllers := class: Location {
  static Controller := class: Nameable (held: *, character: Character?) => {
    guest => .character === None
  }
  [id: Number.Nat] => .children{.name == id}.first
  connected (held) => .children{.held == held}.first ?? .add(Controllers.Controller(name: .reclaimed(held) ?? (0..).find(!this[.]), held))
  disconnected (held) => .children = .children{.held != held}
  reclaimed (held) => [.children, .children.previous**].flatten{.held == held && !this[.name]}.first.name

  // The controllers the operating system has connected, each numbered as it came: evdev's joysticks and gamepads on Linux
  // (`/dev/input/event*` with BTN_GAMEPAD, https://www.kernel.org/doc/html/latest/input/gamepad.html), GameInput's on
  // Windows (https://learn.microsoft.com/gaming/gdk/_content/gc/input/overviews/input-overview), Game Controller's on macOS
  // (GCController.controllers, https://developer.apple.com/documentation/gamecontroller), the Gamepad API's in a browser
  // (navigator.getGamepads, https://www.w3.org/TR/gamepad/); on ether those the player's device shares
  static made => Controllers() ~~ ((if OS.Ether { @me/device/storage["controllers"] ?? [] } else { (external os `controllers`) ?? [] }).for(this.connected(.)))
}

// Controllers are numbered on the device and take back their number (F-I1)
assert {
  pads := Controllers()
  assert pads.connected("pad A").name == 0 && pads.connected("pad A").guest  // FWU1 a new controller is not a guest with the first free id
  assert pads.connected("pad B").name == 1  // FWU2 a second controller does not take the next id
  pads.disconnected("pad A")
  assert pads.connected("pad A").name == 0  // FWU3 a reconnecting controller does not take back its id
}
