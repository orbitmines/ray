// CL2 a section after | is not applied to the value before it
assert (1 | +2 | +3) == (1 | 3 | 6)
// HS2 a superposition of three does not have three possible values
assert (1 | 2 | 3)#.count == 3
// HS6 #x is not x#
assert #(1 | 2) == (1 | 2)#
// HS7 one of two possibilities is not a counted type of one
assert "A" is 1 ("A" | "B")
// HS8 both possibilities are a counted type of one
assert !(("A" | "B") is 1 ("A" | "B"))
// HS9 two of four possibilities are not half of them
assert ("A" | "B") is 50% ("A" | "B" | "C" | "D")
// HS10 half of two possibilities is not one
assert "B" is 0.5 ("A" | "B")
// SP4 an operator does not carry through |
assert (1 | 2) + 1 == 2 | 3
// SP5 a superposition on the right does not carry
assert 10 - (1 | 2) == 9 | 8
// A superposed element makes branches: one path through each value (U1)
assert ([1, "2a" | "2b", 3]).(
  .#.count == 2  // SP8 a superposed element in a list does not make two paths
  & .#.some(== [1, "2b", 3])  // SP9 a path through the second value is missing
)
assert {
  chosen := 1 | 2
  result := chosen + 10
  // SP12 fixing a source does not refine what depends on it
  assert result{chosen == 2} == 12
}
