  c
  external emit 0x04
  external emit 0x7F
  a
  external emit 0x05
  b
  external emit 0x0B
}
// Memory: a word, a byte
load {a} => {
  a
  external emit 0x28
  external emit 2
  external emit 0
}
load8 {a} => {
  a
  external emit 0x2D
  external emit 0
  external emit 0
}
{a} <- {v} => {
  a
  v
  external emit 0x36
  external emit 2
  external emit 0
}
{a} <-8 {v} => {
  a
  v
  external emit 0x3A
  external emit 0
  external emit 0
}
// A local: its name, from here on in its function, its value; given one, the get it writes made a set
var {x} {i} => {
  {x} => {
    external emit 0x20
    external leb {i}
  }
}
{x} = {v} => {
  v
  external mark
  {x}
  external patch 0x21
}
// Statements
return {v} => {
  v
  external emit 0x0F
}
trap => external emit 0x00
drop {v} => {
  v
  external emit 0x1A
}
exit {n} => {
  external emit 0x0C
  external leb {n}
}
if {c} do {body} => {
  c
  external emit 0x04
  external emit 0x40
  body
  external emit 0x0B
}
when {c} do {yes} else {no} => {
  c
  external emit 0x04
  external emit 0x40
  yes
  external emit 0x05
  no
  external emit 0x0B
}
while {c} do {body} => {
  external emit 0x02
  external emit 0x40
  external emit 0x03
  external emit 0x40
  c
  external emit 0x45
  external emit 0x0D
  external emit 1
  body
  external emit 0x0C
  external emit 0
  external emit 0x0B
  external emit 0x0B
}
// A module: its sections; a function declared (its index, how many it takes: its type), then written in that order
section {id} do {body} => {
  external emit {id}
  external begin
  body
  external finish
}
declare {name} {index} takes {count} => {
  {name} => external leb {index}
  external emit {count}
}
function {name} locals {count} do {body} => {
  external begin
  external emit 1
  external leb {count}
  external emit 0x7F
  external .
  body
  external emit 0x0B
  external finish
}
// A name for a number, from here on
constant {name} {value} => {
  {name} => external const {value}
