// What this interpreter's own kinds of value are, for now: a number (a JS number) and text (a JS string), their operations
// the host's (`goto js`: the next statement is JS, `self` the value read on, each hole its value, `$(text)` text read here).
// A port of `js.kinds.ray` to test with until the library reads numbers and text itself; read after the language.

// Numbers, as written: a digit (`Digit`'s own rules), digits, digits with a fraction (`Number`'s own rules: a typed hole
// `{n: Number}` takes what they read; what it took is read in `Number`). Read anywhere through the rule after them. (Read again
// after the library: its `Digit` kept, these added to it.)
(Digit := class { }) unless here Digit
Digit &+= {
  0 =>
    goto js
    0
  1 =>
    goto js
    1
  2 =>
    goto js
    2
  3 =>
    goto js
    3
  4 =>
    goto js
    4
  5 =>
    goto js
    5
  6 =>
    goto js
    6
  7 =>
    goto js
    7
  8 =>
    goto js
    8
  9 =>
    goto js
    9
}
// (digits after one another: what a number is written as, its own (the library adds to `Number`, not to it))
Digits := class { }
Digits &+= {
  {digit: Digit} =>
    digit
  {digit: Digit}{rest: Digits} =>
    goto js
    Number($.text('digit') + $.text('rest'))
}
Number &+= {
  {digits: Digits} =>
    digits
  {whole: Digits}.{fraction: Digits} =>
    goto js
    Number($.text('whole') + '.' + $.text('fraction'))
}
{number: Number} ^number =>
  number

// (a number written in hexadecimal, `0xff`: its hexadecimal digits, `Hexadecimals`'s own rules; a letter a name it holds, as
// a typed hole does not read a type's methods)
Hexadecimal_digit := { }
Hexadecimal_digit &+= {
  0 =>
    goto js
    '0'
  1 =>
    goto js
    '1'
  2 =>
    goto js
    '2'
  3 =>
    goto js
    '3'
  4 =>
    goto js
    '4'
  5 =>
    goto js
    '5'
  6 =>
    goto js
    '6'
  7 =>
    goto js
    '7'
  8 =>
    goto js
    '8'
  9 =>
    goto js
    '9'
  a := "a"
  b := "b"
  c := "c"
  d := "d"
  e := "e"
  f := "f"
  A := "A"
  B := "B"
  C := "C"
  D := "D"
  E := "E"
  F := "F"
}
Hexadecimals := { }
Hexadecimals &+= {
  {digit: Hexadecimal_digit} =>
    digit
  {digit: Hexadecimal_digit}{rest: Hexadecimals} =>
    digit
}
0x{digits: Hexadecimals} =>
  goto js
  parseInt($.text('digits'), 16)
// Bits, as written: `0b010`, the text of its digits (it keeps its length; `+` joins two).
0b{digits: Digits} =>
  goto js
  /^[01]+$/.test($.text('digits')) ? $.text('digits') : undefined

// What both answer, an operator written between two (`a + b`: read on `a`): one declared later binds looser (`1 + 2 == 3` is
// `(1 + 2) == 3`), one declared with it as loosely (`10 - 2 - 3` is `(10 - 2) - 3`). `-` before `+`, `/` before `*`: `a + (b - c)`
// is `(a + b) - c`; `%` after `*` (`n / 100 % 10`). Text added to: joined; anything else, composed. Comparisons: `true`/`false`.
// Of two whole numbers, what `Number` says: `-` none below zero, `/` whole (by zero, zero), `%` by zero, the number.
compounds / {other} ^operator =>
  goto js
  Number.isInteger(self) && Number.isInteger(other) && self >= 0 && other >= 0 ? (other === 0 ? 0 : Math.floor(self / other)) : self / other
compounds * {other} ^operator =>
  goto js
  typeof self === 'number' ? self * other : typeof self === 'string' ? self.repeat(other) : typeof self === 'object' && self !== null && $($.written(self) + '.listing') === $('true') ? $($.written(self) + '.repeated(' + $.written(other) + ')') : undefined
compounds % {other} ^operator =>
  goto js
  other === 0 ? self : ((self % other) + other) % other
compounds - {other} ^operator =>
  goto js
  Number.isInteger(self) && Number.isInteger(other) && self >= 0 && other >= 0 ? Math.max(0, self - other) : self - other
compounds + {other} ^operator =>
  goto js
  typeof self === 'string' ? self + String(other) : typeof self === 'number' ? self + other : undefined
  .composed({other})
chainable < {other} ^operator =>
  goto js
  $(self < other ? 'true' : 'false')
chainable <= {other} ^operator =>
  goto js
  $(self <= other ? 'true' : 'false')
chainable > {other} ^operator =>
  goto js
  $(self > other ? 'true' : 'false')
chainable >= {other} ^operator =>
  goto js
  $(self >= other ? 'true' : 'false')
chainable == {other} ^operator =>
  goto js
  self === other ? $('true') : typeof self === 'object' && self !== null && typeof other === 'object' && other !== null && $($.written(self) + '.listing') === $('true') && $($.written(self) + '.alike(' + $.written(other) + ')') === $('true') ? $('true') : $('false')
!= {other} ^operator =>
  goto js
  self === other ? $('false') : typeof self === 'object' && self !== null && typeof other === 'object' && other !== null && $($.written(self) + '.listing') === $('true') && $($.written(self) + '.alike(' + $.written(other) + ')') === $('true') ? $('false') : $('true')

// Text (`""`: none). (text with an escape in it, `"\e[0m"`: each escape what String.ray's `Escape` says it stands for)
"" =>
  goto js
  ''
unescaped =>
  goto js
  typeof self !== 'string' ? undefined : self.replace(/\\(.)/gs, (_, c) => ({ '0': '\0', a: '\x07', b: '\b', t: '\t', n: '\n', f: '\f', r: '\r', e: '\x1b' })[c] ?? c)
// (whether it is a name: a letter or `_`, then letters, digits, `_`)
named =>
  goto js
  $(/^[\p{L}_][\p{L}\p{N}_]*$/u.test(String(self)) ? 'true' : 'false')
// (whether it has a space not inside a bracket: written as more than one thing)
spaced =>
  goto js
  $([...String(self)].reduce((at, c) => at.done ? at : '([{'.includes(c) ? { ...at, depth: at.depth + 1 } : ')]}'.includes(c) ? { ...at, depth: at.depth - 1 } : c === ' ' && at.depth === 0 ? { ...at, done: true } : at, { depth: 0, done: false }).done ? 'true' : 'false')
contains {other} =>
  goto js
  $(String(self).includes(String(other)) ? 'true' : 'false')
begins {other} =>
  goto js
  $(String(self).startsWith(String(other)) ? 'true' : 'false')
split({separator}) =>
  goto js
  typeof self === 'string' ? $('[' + self.split(String(separator)).map(part => JSON.stringify(part)).join(', ') + ']') : undefined
count =>
  goto js
  typeof self === 'string' ? [...self].length : undefined
reads_text {text} =>
  goto js
  typeof text === 'string' && $.whole(text, self) ? $(text) : $('None')
headed {{header}} =>
  goto js
  (function (header) { const open = String.fromCharCode(123), close = String.fromCharCode(125), quote = String.fromCharCode(34), pieces = [], fields = []; let depth = 0, quoted = 0, start = 0; for (let i = 0; i <= header.length; i++) { const c = header.charCodeAt(i); if (quoted) { if (c === quoted) quoted = 0; continue; } if (c === 34 || c === 96) { quoted = c; continue; } if (c === 40 || c === 91 || c === 123) depth++; else if (c === 41 || c === 93 || c === 125) depth--; else if (i === header.length || (c === 44 && depth === 0)) { pieces.push(header.slice(start, i).trim()); start = i + 1; } } let head = '', literal = false; for (const piece of pieces) { const q = piece.charCodeAt(0); if ((q === 34 || q === 96) && piece.length > 1 && piece.charCodeAt(piece.length - 1) === q) { head += piece.slice(1, -1).replace(/[^ ]+/g, function (run) { return open + String.fromCharCode(96) + run + String.fromCharCode(96) + close; }); literal = true; continue; } if (!/^[\p{Ll}_][\p{L}\p{N}_]*$/u.test(piece)) return undefined; head += open + piece + close; fields.push(quote + open + piece + close + quote); } return literal ? $(head + ' ' + String.fromCharCode(61, 62) + String.fromCharCode(10) + '  ' + String.fromCharCode(91) + fields.join(', ') + String.fromCharCode(93)) : undefined; })($.text('header').trim().replace(/^[(]|[)]$/g, ''))
// (text as its characters, one after another: a list of them; what they hold for, `text{c => …}`, as text again)
characters =>
  goto js
  typeof self === 'string' ? $('[' + [...self].map(c => JSON.stringify(c)).join(', ') + ']') : undefined
{`{`}{parameter} => {body}{`}`} =>
  (goto .) unless . is String
  (.characters{ {parameter} => {body} }).join("")

// What a number or text is made of: Number, String (a node's own `of` is read before this).
of =>
  goto js
  typeof self === 'number' ? $('Number') : typeof self === 'string' ? $('String') : undefined
  None
// A whole number's links (what `Number` walks): the one before it (`next`; none before zero), the one after it.
next =>
  goto js
  typeof self === 'number' && Number.isInteger(self) && self >= 0 ? (self === 0 ? $('None') : self - 1) : undefined
succ =>
  goto js
  typeof self === 'number' && Number.isInteger(self) && self >= 0 ? self + 1 : undefined

// Ranges of numbers: `a..<b` (up to b, not it), `a..b` (with it), going down when b is below a (of anything else, none).
..{last} =>
  goto js
  typeof self === 'number' && typeof last === 'number' ? $('[' + Array.from({ length: Math.abs(last - self) + 1 }, (_, i) => self + (last >= self ? i : -i)).join(', ') + ']') : $('None')
..<{last} =>
  goto js
  typeof self === 'number' && typeof last === 'number' ? $('[' + Array.from({ length: Math.abs(last - self) }, (_, i) => self + (last >= self ? i : -i)).join(', ') + ']') : $('None')
..<{ }{last} =>
  . ..<({last})
..{ }{last} =>
  . ..({last})

// (bytes as text, one character each; a character's code; text from one place up to another; where text is last found,
// starting at or before a place, or -1)
latin1 =>
  goto js
  typeof self === 'object' && self !== null && $($.written(self) + '.listing') === $('true') ? (function (codes) { for (let at = $($.written(self) + '.head'); at !== $('None'); at = $($.written(at) + '.next')) codes.push($($.written(at) + '.value')); return String.fromCharCode(...codes); })([]) : undefined
// (a list of whole numbers: how many times each of 0 up to `size` is in it; its largest)
tally({size}) =>
  goto js
  typeof self === 'object' && self !== null && $($.written(self) + '.listing') === $('true') ? (function (counts) { for (let at = $($.written(self) + '.head'); at !== $('None'); at = $($.written(at) + '.next')) { const value = $($.written(at) + '.value'); if (typeof value === 'number' && value >= 0 && value < size) counts[value]++; } return $('[' + counts.join(', ') + ']'); })(new Array(size).fill(0)) : undefined
maximum =>
  goto js
  typeof self === 'object' && self !== null && $($.written(self) + '.listing') === $('true') ? (function (largest) { for (let at = $($.written(self) + '.head'); at !== $('None'); at = $($.written(at) + '.next')) { const value = $($.written(at) + '.value'); if (typeof value === 'number' && value > largest) largest = value; } return largest; })(0) : undefined
code_at({index}) =>
  goto js
  typeof self === 'string' ? self.charCodeAt(index) : undefined
substring({from}, {to}) =>
  goto js
  typeof self === 'string' ? self.slice(from, to) : undefined
last_index_of({piece}, {before}) =>
  goto js
  typeof self === 'string' ? self.lastIndexOf(piece, before) : undefined
// (text as the bytes UTF-8 writes it in)
bytes =>
  goto js
  typeof self === 'string' ? (function (made) { for (const byte of new TextEncoder().encode(self)) $($.written(made) + '.append(' + byte + ')'); return made; })($('Listing.new')) : undefined
// (a whole number as bits: that many, the most significant first)
binary({width}) =>
  goto js
  typeof self === 'number' && Number.isInteger(self) && self >= 0 ? self.toString(2).padStart(width, '0').slice(-width) : undefined
// (a whole number in base 16, as `0x` is followed)
hexadecimal =>
  goto js
  typeof self === 'number' && Number.isInteger(self) && self >= 0 ? self.toString(16) : undefined
// (an integer's sum, difference and product: exact, with a sign (BigInt), not what `+`, `-` and `*` of whole numbers are)
added({other}) =>
  goto js
  Number.isInteger(self) && Number.isInteger(other) ? Number(BigInt(self) + BigInt(other)) : undefined
subtracted({other}) =>
  goto js
  Number.isInteger(self) && Number.isInteger(other) ? Number(BigInt(self) - BigInt(other)) : undefined
multiplied({other}) =>
  goto js
  Number.isInteger(self) && Number.isInteger(other) ? Number(BigInt(self) * BigInt(other)) : undefined
// (two integers' bits both set, as two's complement: `and`)
anded({other}) =>
  goto js
  Number.isInteger(self) && Number.isInteger(other) ? Number(BigInt(self) & BigInt(other)) : undefined
// (an integer brought into the integers of a width modulo 2 to that power: signed, or not)
wrapped_into({bits}, {signed}) =>
  goto js
  Number.isInteger(self) ? Number(signed === $('true') ? BigInt.asIntN(bits, BigInt(self)) : BigInt.asUintN(bits, BigInt(self))) : undefined
// (an integer's byte at a place, as two's complement of 64 bits, the least significant first: what memory holds of it)
byte_at({index}) =>
  goto js
  Number.isInteger(self) && Number.isInteger(index) ? Number((BigInt.asUintN(64, BigInt(self)) >> BigInt(8 * index)) & 255n) : undefined
// (text in base 16, `0xfffffff7`, as a whole number of a width in two's complement: -9)
signed_hexadecimal({width}) =>
  goto js
  typeof self === 'string' && /^-?0x[0-9a-f]+$/i.test(self) ? Number(BigInt.asIntN(width, BigInt(self.replace(/^-/, ''))) * (self.startsWith('-') ? -1n : 1n)) : undefined
// (bits the other way around; the whole number they write, the most significant first; text in pieces of a size)
reversed =>
  goto js
  typeof self === 'string' ? [...self].reverse().join('') : undefined
unsigned =>
  goto js
  typeof self === 'string' && /^[01]*$/.test(self) ? (self.length ? parseInt(self, 2) : 0) : undefined
pieces({size}) =>
  goto js
  typeof self === 'string' ? (function (made) { for (let at = 0; at < self.length; at += size) $($.written(made) + '.append("' + self.slice(at, at + size) + '")'); return made; })($('Listing.new')) : undefined

// A class header as a structure of bits (`structures3.ts`): its maker given its named pieces, and the header as read; a value
// read from bits by it (`bits as T`); a value written as bits (`x.binary`); a table of symbols and their bits, a prefix code.
plain {{header}} =>
  goto js
  $($.host.plain($, $.text('header')) ? 'true' : 'false')
instance_defined {{fields}} {{block}} =>
  goto js
  $.host.instance($.text('fields'), $.text('block'), $.written).forEach(statement => $(statement))
bits_read({bits}) =>
  goto js
  $.host.read($, self, bits)
binary =>
  goto js
  typeof self === 'object' && self !== null ? $.host.write($, self) : undefined
Coded({codes}) =>
  goto js
  $.host.coding(codes, $)

// What a number answers to `?`: whether it holds (one that is zero does not, as `holds` says of a Number).
? {yes} : {no} =>
  goto js
  self === 0 ? undefined : $('goto holds')
  {no}
  goto answered
  holds\
  {yes}
  answered\
