@ether/os

// A display: full screen or not, kept awake or not, and how its user prefers to see it
Display := class: Location {
  fullscreen: boolean = false
  awake: boolean = false
  // as its user prefers (the operating system's settings): reduced motion, dark, contrast, whether focused
  preferences: (reduced_motion: boolean, dark: boolean, contrast: "more" | "less" | "normal", focused: boolean) = (external os `display_preferences`) ?? (false, false, "normal", true)
}
assert !(Display().fullscreen) & !(Display().awake)  // DSP1 a display is full screen or kept awake unasked
