Language.Direct := class: Language {
  static extensions = ".direct"
  static space (size: Geometry.Vector) => Geometry.Space.grid(Geometry.Vector(size.x as px, size.y as px))
  static outer: Geometry.Transform = Geometry.Transform.identity

  Geometry.Shape &+= {
    placed => Language.Direct.outer * Geometry.Transform.translate(at) * displayed("transform")
    pixels_inside => Language.Direct.space(size).positions -- (area => rectangular ? area : area{boundary.winding(.) != 0})
    opacity => effects{. is Geometry.Opacity}.amount.product ?? 1
    drawn_writes => Compiler.reduced(this, UI.Lowered) -- (shape => [
      Language.Direct.painted(shape.pixels_inside.map(point => (at: shape.placed.applied(point), sample: point)), shape.painted(shape.fill), shape.opacity) if shape.fill,
      Language.Direct.stroked(shape.boundary, shape.placed, shape.stroke.width, shape.painted(shape.stroke.paint)) if shape.stroke,
      Compiler.reduced(shape, Language.Direct.shown) if shape.content,
      (with Language.Direct.outer = shape.placed * Geometry.Transform.translate(shape.at * -1) { shape.in_place.sort_by(.layer).map(.drawn_writes) }) if shape.visible,
      shape.effects{. is Geometry.Blur}.map(blur => { .blurred(shape.pixels_inside.map(shape.placed.applied(.)), blur.radius as px) })
    ])
  }
  Screen := class raster: Geometry.Raster {
    seen (at: Geometry.Vector) => Geometry.Space.screen.seen(at, Geometry.Vector(raster.width, raster.height), Geometry.Vector(1, 1))
    at (point: Geometry.Vector) => seen(point) -- (cell => raster.at(cell.x, cell.y))
    put (point: Geometry.Vector, color: Geometry.Color) => seen(point) -- (cell => raster.put(cell.x, cell.y, color))
    blurred (area: Geometry.Vector[], radius: Number) => raster.blurred(area.map(seen(.)), radius)
  }

  rules := {
    {root: Geometry.Shape{solved && !parent}} => (Screen(Geometry.Raster.blank(root.size.x as px, root.size.y as px)) ~~ [root, root.lifted].flatten.map(.drawn_writes).flatten).raster
  }
  shown := {
    {text: Geometry.Shape{content is String}} => with Geometry.Font.inherited = text.em {
      text.lines(text.size.x).enumerate.map(row => row.value.reduce(placed = (pen: 0px, ops: []) => {
        look = UI.Theme.face(text, .)
        size = look.font.size as px
        height = size * look.font.line_height
        top = text.size.y - row.index * height
        glyph = Font(look.font).glyph(text.case ? text.case(.) : .)
        (pen: placed.pen + glyph.advance * size / glyph.units, ops: [placed.ops,
          painted(Geometry.Space.grid(Geometry.Vector(size * 0.6, height)).positions.map(point => (at: text.placed.applied(point + Geometry.Vector(placed.pen, top - height)), sample: point)), look.fill) if look.styles.contains("selected"),
          outlined(glyph.outlines, text.placed * Geometry.Transform.translate(Geometry.Vector(placed.pen, top - glyph.ascender * size / glyph.units)) * Geometry.Transform.scale(Geometry.Vector(size / glyph.units, size / glyph.units)), text.painted(look.color) ?? Geometry.Color(0, 0, 0))
        ].flatten)
      }).ops).flatten
    }
    {canvas: Geometry.Shape{content is Program && !(content is Choice)}} => with Language.Direct.outer = canvas.placed { canvas.content().map(.drawn_writes) }
    {shape: Geometry.Shape} => []
  }
  painting (points: (at: Geometry.Vector, sample: Geometry.Vector)[], alpha: Probability) => {
    {color: Geometry.Color} => (color ~~ .alpha *= alpha) -- (faded => points.map(point => { .put(point.at, faded) }))
    {gradient: Geometry.Gradient} => points.map(point => { .put(point.at, gradient.at(point.sample.x) ~~ .alpha *= alpha) })
    {pattern: Geometry.Pattern} => (Screen(Geometry.Raster.blank(pattern.repeat.x as px, pattern.repeat.y as px)) ~~ pattern.shape.drawn_writes).raster -- (tile =>
      points.map(point => { .put(point.at, Screen(tile).at(Geometry.Vector(point.sample.x % pattern.repeat.x, point.sample.y % pattern.repeat.y)) ~~ .alpha *= alpha) }))
    {sampled: Geometry.Pointwise} => points.map(point => { .put(point.at, sampled(point.sample) ~~ .alpha *= alpha) })
    {paint} => []
  }
  painted (points: (at: Geometry.Vector, sample: Geometry.Vector)[], paint: Geometry.Paint?, alpha: Probability = 1) => Compiler.reduced(paint, painting(points, alpha))
  outlined (outlines: Geometry.Curve[], transform: Geometry.Transform, paint: Geometry.Paint?) => outlines.map(.edges.map((a, b) => (transform.applied(a), transform.applied(b)))).flatten(1) -- (edges => edges.map(.0.y) -- (ys => painted((ys.min..<ys.max).map(y =>
    edges{(.0.y <= y) != (.1.y <= y)}.map(.0.x + (y - .0.y) * (.1.x - .0.x) / (.1.y - .0.y)).sort.chunk(2).map((a, b) => (a..<b).map(x => (at: Geometry.Vector(x, y), sample: Geometry.Vector(x, y))))
  ).flatten, paint)))
  stroked (outline: Geometry.Shape, transform: Geometry.Transform, width: Geometry.Length, paint: Geometry.Paint?) => painted(outline.edges.map((a, b) => (transform.applied(a), transform.applied(b))).map((a, b) =>
    (0..<a.distance(b) as px).map(step => a.mix(b, step / a.distance(b)) -- (point => (-(width / 2) .. width / 2).map(w => (at: Geometry.Vector(point.x + w, point.y), sample: point))))
  ).flatten, paint)
  level := Geometry.Preparing(1px) + rules

  Font := class font: Geometry.Font {
    file => font.family.map(Fonts.named).first
    glyph (character: Char) => $.opentype.read(file.held as Byte[])[character]
  }

  Display := class: UI.Interface target: Location, title: String = "" {
    dynamically event: @me/instance
    start => { (@me/device/opened).held() } when @me/device/opened changes
    stop => None
    write (raster: Geometry.Raster) => (title = UI.page.title ?? "") -- (target.held = raster)
    read => UI.Input.dispatched(event)
  }
}

Device &+= {
  window: Language.Direct.Display?
}
