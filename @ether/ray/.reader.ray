{pattern} => {body} =>
  external rule pattern body
{name} := {value} =>
  external declare name value
//{comment} =>
  external label comment

// Control flow: a block given after a word is a capture like any other, continued on deeper lines.
if {condition} then {block} =>
  external goto taken condition
  external goto done
  external label taken
  block
  external label done
unless {condition} then {block} =>
  external goto done condition
  block
  external label done
while {condition} do {block} =>
  external label again
  external goto body condition
  external goto done
  external label body
  block
  external goto again
  external label done

// Nodes, members, identity. What is declared first binds loosest, so `.` comes after the rules written with it.
nothing =>
  external get node nothing
node =>
  external node
same {a} {b} =>
  external same a b
set {x} . {member} to {value} =>
  external set x member value
{x} . {member} =>
  external get x member
yes =>
  external node

// ---------------------------------------------------------------- the reader (spec/Reader.md R1, R2), handed reading at the end
learned := external learned
end := learned . end
space := learned . space
indent := learned . indent
access := learned . access

// Whether `a` is the same character as `b`.
character {a} is {b} =>
  external same a b

// The place after `chain` spelled from `at`, or nothing. A space in it also reads a line end and the indentation that
// continues a statement (R0.1, as the first statement wrote its definer's space).
spelled {chain} from {at} =>
  here := at
  wanted := chain
  result := yes
  while wanted do
    unless here then
      result := nothing
      wanted := nothing
    if here then
      c := here . character
      w := wanted . character
      matches := character c is w
      continued := nothing
      unless matches then
        if character w is space then
          if character c is end then
            continued := continuation after here
      if continued then
        here := continued
        wanted := wanted . next
        matches := nothing
      if matches then
        here := here . next
        wanted := wanted . next
      unless matches then
        unless continued then
          result := nothing
          wanted := nothing
  if result then
    set result . end to here
  result

// The place after a line end and one or more indentations, or nothing.
continuation after {at} =>
  here := at . next
  more := spelled indent from here
  found := nothing
  while more do
    found := more . end
    more := spelled indent from found
  found

// Characters the reader names are taken from where they are written here.
characters of {written} =>
  where := external span written
  where . from
quote := characters of "
quote := quote . character
pairs := characters of ()[]{}
opening := pairs . character
pairs := pairs . next
closing := pairs . character
pairs := pairs . next
opening_list := pairs . character
pairs := pairs . next
closing_list := pairs . character
pairs := pairs . next
opening_block := pairs . character
pairs := pairs . next
closing_block := pairs . character

// The bracket that closes `c`, or nothing when `c` opens none.
closer of {c} =>
  found := nothing
  if character c is opening then
    found := closing
  if character c is opening_list then
    found := closing_list
  if character c is opening_block then
    found := closing_block
  found

// Whether `c` closes a bracket.
closes {c} =>
  found := nothing
  if character c is closing then
    found := yes
  if character c is closing_list then
    found := yes
  if character c is closing_block then
    found := yes
  found

// Where the statement starting at `at` ends: the first line end not followed by a line deeper than `base` (R0.1), or `to`.
statement end from {at} to {to} below {base} =>
  here := at
  found := to
  open_ones := nothing
  while here do
    if same here to then
      here := nothing
    if here then
      c := here . character
      // a statement goes on while a bracket it opened is open (quoted text holds none)
      shut := closer of c
      if shut then
        pushed := node
        set pushed . shut to shut
        set pushed . next to open_ones
        open_ones := pushed
      unless shut then
        if open_ones then
          expected := open_ones . shut
          if character c is expected then
            open_ones := open_ones . next
        if character c is quote then
          skipping := here . next
          while skipping do
            if same skipping to then
              skipping := nothing
            if skipping then
              d := skipping . character
              if character d is end then
                skipping := nothing
            if skipping then
              if character d is quote then
                here := skipping
                skipping := nothing
              if skipping then
                skipping := skipping . next
      ending := nothing
      unless open_ones then
        if character c is end then
          ending := yes
      if ending then
        deeper := nothing
        next := here . next
        inside := next
        if base then
          inside := nothing
          based := spelled base from next
          if based then
            inside := based . end
        if inside then
          deeper := spelled indent from inside
        unless deeper then
          found := here
          here := nothing
      if here then
        here := here . next
  found

// Whether `b` comes after `a` before `limit` (walking: there are no integers).
{b} comes after {a} =>
  here := a
  found := nothing
  while here do
    here := here . next
    if same here b then
      found := yes
      here := nothing
  found

// A reading of `pieces` from `at` that ends at `limit`: its `captures` (a chain of `name`, `from`, `to`), or nothing. A capture
// reads one or more characters, the longest first; one that crosses a line end runs to `limit`.
readings of {pieces} from {at} to {limit} =>
  found := nothing
  unless pieces then
    if same at limit then
      found := yes
      set found . end to at
  if pieces then
    literal := pieces . literal
    if literal then
      spelt := spelled literal from at
      if spelt then
        far := spelt . end
        within := same far limit
        unless within then
          within := limit comes after far
        if within then
          found := readings of pieces . next from far to limit
    unless literal then
      found := captured pieces from at to limit
  found

// The ends a capture from `at` can have, the longest first: every place after `at` up to `limit`, but past a line end only
// `limit` itself.
ends from {at} to {limit} =>
  stack := nothing
  here := at . next
  crossed := nothing
  going := yes
  while going do
    at_limit := same here limit
    keep := yes
    if crossed then
      unless at_limit then
        keep := nothing
    if keep then
      link := node
      set link . place to here
      set link . next to stack
      stack := link
    if at_limit then
      going := nothing
    unless here then
      going := nothing
    if going then
      c := here . character
      if character c is end then
        crossed := yes
      here := here . next
  stack

// Whether `type` holds the places from `from` to `to`: its check, when it has one, else its own rules reading them whole.
// Three values in order, as captures for a rule applied to values.
values {a} {b} {c} =>
  third := node
  set third . value to c
  second := node
  set second . value to b
  set second . next to third
  first := node
  set first . value to a
  set first . next to second
  first

{kind} holds from {from} to {to} =>
  check := kind . check
  found := nothing
  if check then
    given := values kind from to
    here := external .
    found := external apply check given here
  unless check then
    own := external own_rules kind
    found := reading from from to to among own
  found

captured {pieces} from {at} to {limit} =>
  name := pieces . capture
  rest_pieces := pieces . next
  ends := ends from at to limit
  // a capture followed by a literal ends only where that literal starts (its first character, or a line end for a space)
  wanted := nothing
  if rest_pieces then
    following := rest_pieces . literal
    if following then
      wanted := following . character
  piece_type := pieces . type
  found := nothing
  while ends do
    e := ends . place
    worth := yes
    if wanted then
      worth := nothing
      if e then
        c := e . character
        if character c is wanted then
          worth := yes
        if character wanted is space then
          if character c is end then
            worth := yes
    if worth then
      if piece_type then
        worth := piece_type holds from at to e
    rest := nothing
    if worth then
      rest := readings of rest_pieces from e to limit
    if rest then
      cap := node
      set cap . name to name
      if piece_type then
        set cap . type to piece_type
      set cap . from to at
      set cap . to to e
      earlier := rest . captures
      set cap . next to earlier
      set rest . captures to cap
      found := rest
      ends := nothing
    if ends then
      ends := ends . next
  found

// Whether two chains spell the same.
chain {a} equals {b} =>
  x := a
  y := b
  result := yes
  while x do
    unless y then
      result := nothing
      x := nothing
    if y then
      c := x . character
      d := y . character
      unless character c is d then
        result := nothing
        x := nothing
      if x then
        x := x . next
        y := y . next
  if y then
    result := nothing
  result

// Reading handed to the rule defined last (R0.6); bodies planned by the rule defined last, too.
hand reading over =>
  latest := external latest
  external reader latest
hand planning over =>
  latest := external latest
  external planner latest

// What reads the statement from `at` to `limit` with the rules in reach of `scope` (R2.5): every rule that reads it whole;
// between them, one led by a literal over one led by a capture; then one written with the same head as a later one gives way
// to it (`=>`), otherwise the one declared first reads it (G3.1). The rules come nearest scope first, latest first. Answers
// a node with the `rule` and its `captures`, or nothing.
reading from {at} to {limit} in {scope} =>
  rules := external rules scope
  reading from at to limit among rules

reading from {at} to {limit} among {rules} =>
  best := nothing
  best_rule := nothing
  definer := external definer
  defining := external head definer
  while rules do
    rule := rules . rule
    pieces := rule . pieces
    r := readings of pieces from at to limit
    if r then
      take := yes
      if best then
        mine := external head rule
        theirs := external head best_rule
        if chain mine equals theirs then
          take := nothing
        led := pieces . literal
        best_pieces := best_rule . pieces
        best_led := best_pieces . literal
        if led then
          unless best_led then
            take := yes
        unless led then
          if best_led then
            take := nothing
        // the rule that defines rules reads a definition whole, whatever else could (R0.1)
        if chain mine equals defining then
          take := yes
        if chain theirs equals defining then
          take := nothing
      if take then
        best := r
        best_rule := rule
    rules := rules . next
  if best then
    set best . rule to best_rule
  best

// Whether the places from `at` to `limit` hold a space.
spaced from {at} to {limit} =>
  here := at
  found := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is space then
        found := yes
        here := nothing
      if here then
        here := here . next
  found

// One statement of a body, as a step (R0.4): a call of an external (`access name arguments…`), a rule with its captures, one
// word, or what nothing reads.
step from {at} to {limit} in {scope} =>
  made := node
  set made . from to at
  set made . to to limit
  led := spelled access from at
  called := nothing
  if led then
    after := led . end
    c := after . character
    if character c is space then
      called := after . next
  if called then
    set made . external to yes
    words := words from called to limit
    first := words . from
    set made . name_from to first
    last := words . to
    set made . name_to to last
    rest := words . next
    set made . arguments to rest
  unless called then
    r := reading from at to limit in scope
    if r then
      rule := r . rule
      set made . rule to rule
      caps := r . captures
      set made . captures to caps
    unless r then
      unless spaced from at to limit then
        set made . word to yes
  made

// The words from `at` to `limit`, separated by spaces: a chain of `from`, `to`.
words from {at} to {limit} =>
  first := nothing
  last := nothing
  here := at
  start := at
  while here do
    stop := same here limit
    unless stop then
      c := here . character
      if character c is space then
        stop := yes
    if stop then
      unless same start here then
        word := node
        set word . from to start
        set word . to to here
        if last then
          set last . next to word
        unless last then
          first := word
        last := word
      if same here limit then
        here := nothing
      if here then
        here := here . next
        start := here
    unless stop then
      here := here . next
  first

// The first place from `at` that is not a space or a line end, or nothing before `to`.
blank from {at} to {to} =>
  here := at
  found := nothing
  while here do
    if same here to then
      here := nothing
    if here then
      c := here . character
      skip := nothing
      if character c is space then
        skip := yes
      if character c is end then
        skip := yes
      unless skip then
        found := here
        here := nothing
      if here then
        here := here . next
  found

// The statements of a body from `from` to `to`, each at the body's indentation `base`: a chain of steps.
plan {from} to {to} below {base} in {scope} =>
  first := nothing
  last := nothing
  at := from
  while at do
    if same at to then
      at := nothing
    if at then
      at := blank from at to to
    if at then
      limit := statement end from at to to below base
      made := step from at to limit in scope
      if last then
        set last . next to made
      unless last then
        first := made
      last := made
      at := nothing
      if limit then
        unless same limit to then
          at := limit . next
          if base then
            based := spelled base from at
            if based then
              at := based . end
  first

hand planning over

// ---------------------------------------------------------------- heads read in Ray (R2.2)
open := learned . open
close := learned . close

// The place of the bracket that closes one opened just before `at`, or nothing when another opens first or none closes.
closing from {at} to {limit} =>
  here := at
  found := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is open then
        here := nothing
      if here then
        if character c is close then
          found := here
          here := nothing
      if here then
        here := here . next
  found

// A piece of a head, added to the chain `into` (a node with `first` and `last`).
add {kind} piece from {piece_from} to {piece_to} into {into} =>
  made := node
  set made . from to piece_from
  set made . to to piece_to
  external set made kind yes
  last := into . last
  if last then
    set last . next to made
  unless last then
    set into . first to made
  set into . last to made

// The pieces of a head: a capture is the brackets around a name (its first word), brackets around brackets are literal,
// the rest is literal. A chain of `literal`/`capture`, each with `from` and `to`.
pieces of {head_from} to {head_to} like {like} =>
  into := node
  at := head_from
  start := head_from
  while at do
    if same at head_to then
      at := nothing
    if at then
      c := at . character
      captured := nothing
      if character c is open then
        inner := at . next
        shut := closing from inner to head_to
        if shut then
          unless same inner shut then
            captured := yes
      if captured then
        unless same start at then
          add literal piece from start to at into into
        name_end := word end from inner to shut
        typed := typed name from inner to name_end
        unless typed then
          add capture piece from inner to name_end into into
        if typed then
          bare := typed . name_end
          add capture piece from inner to bare into into
          type_from := name_end . next
          capture_type := external read type_from shut like
          made := into . last
          set made . type to capture_type
        at := shut . next
        start := at
      unless captured then
        at := at . next
  unless same start head_to then
    add literal piece from start to head_to into into
  into . first

// Where the word from `at` ends: at a space, or at `limit`.
word end from {at} to {limit} =>
  here := at
  found := limit
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is space then
        found := here
        here := nothing
      if here then
        here := here . next
  found

// A capture's name written with its type (`{d: Digit}`): the name ends before the colon. Answers a node with `name_end`, or nothing.
colon := characters of :
colon := colon . character
typed name from {at} to {limit} =>
  here := at
  before := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      before := here
      here := here . next
  found := nothing
  if before then
    c := before . character
    if character c is colon then
      found := node
      set found . name_end to before
  found

// A type: a scope of the rules its block defines (R2.3).
type {block} =>
  made := node
  external apply block nothing made
  made

// Rules defined from here on are read by their heads in Ray.
{pattern} => {body} =>
  where := external span pattern
  head_from := where . from
  head_to := where . to
  pieces := pieces of head_from to head_to like pattern
  external define pattern pieces body

// One statement read at the top: applied in place, or reported. Answers the place after it.
read statement at {at} =>
  here := external .
  scope := here . parent
  limit := statement end from at to nothing below nothing
  r := reading from at to limit in scope
  if r then
    rule := r . rule
    caps := r . captures
    external apply rule caps scope
  unless r then
    external report at limit
  after := nothing
  if limit then
    after := limit . next
  after

hand reading over

// ---------------------------------------------------------------- types with a check: characters, repetition (R2.2)
latest rule =>
  external latest
checked by {check} =>
  made := node
  set made . check to check
  made

// One character, any.
one character {kind} {from} {to} =>
  following := from . next
  same following to
Char := checked by latest rule

// One character, not `excluded`.
one character except {kind} {from} {to} =>
  following := from . next
  found := nothing
  if same following to then
    c := from . character
    excluded := kind . excluded
    unless character c is excluded then
      found := yes
  found
except_rule := latest rule
everything but {c} =>
  made := checked by except_rule
  set made . excluded to c
  made

// One or more of `item`, one after another.
one or more {kind} {from} {to} =>
  item := kind . item
  e := from . next
  found := nothing
  going := yes
  while going do
    if item holds from from to e then
      if same e to then
        found := yes
      unless found then
        unless same e to then
          found := one or more kind e to
    if found then
      going := nothing
    if same e to then
      going := nothing
    if going then
      e := e . next
  found
many_rule := latest rule
{item} repeated =>
  made := checked by many_rule
  set made . item to item
  made

// ---------------------------------------------------------------- text written in quotes
Unquoted := everything but quote
Quoted := Unquoted repeated
"{text: Quoted}" =>
  external span text

// ---------------------------------------------------------------- brackets: what they hold is balanced
// Balanced text: every bracket it opens it closes, in order, and it closes none it did not open; quoted text is skipped.
balanced {kind} {from} {to} =>
  open_ones := nothing
  here := from
  ok := yes
  while here do
    if same here to then
      here := nothing
    if here then
      c := here . character
      shut := closer of c
      if shut then
        pushed := node
        set pushed . shut to shut
        set pushed . next to open_ones
        open_ones := pushed
      unless shut then
        if closes c then
          unless open_ones then
            ok := nothing
            here := nothing
          if open_ones then
            expected := open_ones . shut
            unless character c is expected then
              ok := nothing
              here := nothing
            if here then
              open_ones := open_ones . next
        if character c is quote then
          here := here . next
          skipping := here
          while skipping do
            if same skipping to then
              ok := nothing
              skipping := nothing
              here := nothing
            if skipping then
              d := skipping . character
              if character d is quote then
                here := skipping
                skipping := nothing
              if skipping then
                skipping := skipping . next
      if here then
        here := here . next
  if open_ones then
    ok := nothing
  ok
Balanced := checked by latest rule

// A group: what is in brackets is read as itself.
({inside: Balanced}) =>
  inside
