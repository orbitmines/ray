    l
  }
  static invoke0 (c) => Calls.direct(c) ? call(c, shared_args(3928, 0), 0) : invoke(c, list(), 0)
  static invoke1 (c, a) => Calls.direct(c) ? call(c, Calls.args1(a), 0) : invoke(c, append(list(), a), 0)
  static invoke2 (c, a, b) => Calls.direct(c) ? call(c, Calls.args2(a, b), 0) : invoke(c, append(append(list(), a), b), 0)
  static call1 (f, x) => Calls.direct(f) ? call(f, Calls.args1(x), 0) : call(f, append(list(), x), 0)
  static call_member0 (x, sym) => Calls.closure_call0(x, sym, own_closure(x, sym))
  static closure_call0 (x, sym, c: Closure) => (c != None) ? indirect(c.env, shared_args(3928, 0), 0, c.function) : invoke0(member2(x, sym))
  static call_member1 (x, sym, a) => Calls.closure_call1(x, sym, a, own_closure(x, sym))
  static closure_call1 (x, sym, a, c: Closure) => (c != None) ? indirect(c.env, Calls.args1(a), 0, c.function) : invoke1(member2(x, sym), a)
  static call_member2 (x, sym, a, b) => Calls.closure_call2(x, sym, a, b, own_closure(x, sym))
  static closure_call2 (x, sym, a, b, c: Closure) => (c != None) ? indirect(c.env, Calls.args2(a, b), 0, c.function) : invoke2(member2(x, sym), a, b)
