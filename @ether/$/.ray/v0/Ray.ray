// class Ordered

Iterable := class: Ordered {
  entry => None

  empty => .count.is_zero
  nonempty => .empty.not

  bounded => true
  unbounded => .bounded.not

  count => if (exists .entry) { .entry.count } else { zero }

  first => .entry.first
  last => .entry.last

  // The draft's one traversal: `for` hands each element to the block as `it`.
  for (body) => if (exists .entry) { .entry for body } else { this }

  // `every (predicate) => map(predicate)~{== false}.empty`, `some => ~{predicate}.nonempty`:
  // the block is the predicate, read for each `it`.
  every (predicate) => (
    holds ^keyword := true
    for {
      verdict := inline predicate
      unless verdict { holds = false }
    }
    holds
  )
  some (predicate) => (
    holds ^keyword := false
    for {
      verdict := inline predicate
      if verdict { holds = true }
    }
    holds
  )

  // `all => reduce(|)`: every element superposed: the first, with each next
  // pushed onto its components (`#`).
  all => (
    superposed ^keyword := None
    for {
      if (exists superposed) { superposed = superposed | it.value } else { superposed = it.value }
    }
    superposed
  )

  // `fill (x) all = x`
  fill (x) => for { it.value = x }

  // `compact => this~{!=.instance_of None}`: the elements that hold something.
  compact => this{exists this}

  at (index: Number) => .entry.at(index)

  // A chain is its own path, so its length is its count.
  paths => this
  length => .paths.count

  // Each element reaches every other by going forward and backward along the chain.
  connected => true
  consistent => true
  acyclic => .entry.acyclic
  undirected => false
  unidirectional => false
}

// A program is what it is written as: the statements, in the order they are
// written on the page, each of them a program in turn. What order they *run*
// in is another thing, and a goto is what says it.
Program := class: Iterable {
  entry => .written
  // spec: what follows a statement is written down by the engine and does not
  // read back — `.written` answers the first, and running it answers what it
  // says, but asking that one what follows it gives a name with nothing behind
  // it rather than the next statement. Until that reads back, a program is one
  // statement deep: `count` and `for` below are written for the chain they
  // will walk.
  // Walked here rather than left to `Iterable`, since a statement is a
  // program and not yet a ray: what links them is what is written next.
  for (body) => (
    it ^keyword := .written
    while (exists it) {
      inline body
      it = it.next
    }
    this
  )
  count => (
    total ^keyword := zero
    walker ^keyword := .written
    while (exists walker) {
      total = total.succ
      walker = walker.next
    }
    total
  )
  first => .written
  empty => .count.is_zero
}

Ray := class: Iterable {
  entry => this

  is_initial => (exists .previous).not
  is_terminal => (exists .next).not

  is_first => .is_initial
  is_last => .is_terminal

  initial => (
    walker := this
    while walker.is_initial.not { walker = walker.previous }
    walker
  )
  terminal => (
    walker := this
    while walker.is_terminal.not { walker = walker.next }
    walker
  )

  first => .initial
  last => .terminal

  // The boundaries a ray shows to the edges it sits on, per `Boundary.Initial(∙: this)`.
  initial_boundary => Boundary.Initial(vertex: this)
  terminal_boundary => Boundary.Terminal(vertex: this)

  count => (
    total := one
    walker := this
    while walker.is_terminal.not {
      total = total.succ
      walker = walker.next
    }
    total
  )

  // Walked rather than called again for each step: reading the rest of a ray
  // by asking it to read itself nests one application per element, and a
  // statement is only allowed so many, so a long ray was walked partway and
  // said nothing about stopping.
  for (body) => (
    it ^keyword := this
    going ^keyword := true
    while going {
      inline body
      // Where a ray ends is its own to say — a boundary ends where its edge
      // is, not where its `next` runs out — so the walk asks it, as asking it
      // to walk the rest of itself did.
      going = it.is_terminal.not
      if going { it = it.next }
    }
    this
  )

  at (index: Number) => (
    here := this
    left := index
    while left {
      here = here.next
      left = left.pred
    }
    here
  )

  // A chain walked forward never returns to where it started.
  acyclic => .terminal.is_terminal

  == (other: Ray) => (
    mine := this
    theirs := other
    while (mine.is_terminal.not.and(theirs.is_terminal.not)) {
      mine = mine.next
      theirs = theirs.next
    }
    // Walked together to their ends, two rays are the same; two that went
    // nowhere at all are the same only when they say the same thing.
    if (.is_terminal.and(other.is_terminal)) {
      exists (external alike (this) (other))
    } else {
      mine.is_terminal.and(theirs.is_terminal)
    }
  )
  != (other: Ray) => (this == other).not
}

// A boundary is the ray a vertex shows to the edge it sits on; an edge is the
// ray between two boundaries. Both are rays themselves, which is what makes
// the structure self-similar.
Boundary := class: Ray {
  // `vertex | ∙` and `edge | ⊙`: the unicode aliases wait on a way to spell them.
  is_initial => (exists .edge).not
  is_terminal => (exists .edge).not

  Initial := class: Boundary {
    // `⊙ = Edge(x.terminal: this)`
    edge => Edge(to: this)
    is_initial => true
    is_terminal => false
  }
  Terminal := class: Boundary {
    // `⊙ = Edge(x.initial: this)`
    edge => Edge(from: this)
    is_initial => false
    is_terminal => true
  }
}

Edge := class: Ray {
  // `value | x : { initial | ⊣ : Boundary?, terminal | ⊢ : Boundary? }`
  is_initial => (exists .from).not
  is_terminal => (exists .to).not

  // `initial = Boundary(∙: ⊙⊢∙⊣x)`, `terminal = Boundary(∙: x⊢∙⊣⊙)`
  initial => .from
  terminal => .to
}


// The structures of the draft: an Iterable whose rays are constrained.
// spec: the constraints (`(1 unless HyperContinuations) Vertex.Boundary`) are
// carried as the two flags and asked of a structure through `is_valid`, not
// enforced while it is built.
Structure := class: Iterable {
  hyper_continuations => false
  hyper_edges => false
  is_valid => true
}
Hypergraph := class: Structure {
  hyper_edges => true
}
Graph := class: Structure {
  hyper_continuations => true
}
Forest := class: Structure {
  hyper_continuations => true
  is_valid => .acyclic.and(.consistent)
}
Tree := class: Forest {
  is_valid => .acyclic.and(.consistent).and(.connected)
}
Path := class: Structure {
  is_valid => .consistent.and(.connected)
  paths => this
  // `length: 1 N∞`: the count, or unbounded when a walk comes back around.
  length => if .acyclic { .count } else { None }
}
Array := class: Path {
  acyclic => true
}

// spec: the draft's Traverser: how `for` walks a structure. A chain has one
// way through it, so depth-first and breadth-first meet; both are named so a
// structure with branches can choose.
Traverser := class {
  Order := enum depth_first | breadth_first
  default => Traverser.Order.depth_first
  walk (entry, body) => entry for body
}


// A chain of components is an Array (a path without cycles), and each link in it a Ray: the
// containers `class` builds before this file loads take both on here.
Chain.components.hierarchy &= Array
Link.components.hierarchy &= Ray

