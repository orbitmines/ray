!language
{
  }
=>

// The rule creator: a rule written `{head} => {body}` from here on goes on to the next reading while there is one (`goto .`),
// any rule's, so the text is rewritten by the latest rule's reading that goes furthest; and so does the creator (a head goes up
// to the last definer).
{head} => {body} =>
  goto .
  {head} =>
    goto .
    {body}
  goto styled
  function
goto styled
punctuation
// One written `nearest {head} => {body}` does not go on: it is rewritten by its first reading (its holes ending nearest).
nearest {head} => {body} =>
  {head} =>
    {body}

// A typed hole, `{x: T}` in a head: it takes what `T`'s own rules read whole (matched as a head is, nothing read), and what it
// took is read in `T`. This rule, a head that is one hole written as the two its right side has, says how one is written. (In
// a rule's right side, a hole's name is what it took.)
{name: type} =>
  {name}: {type}
// The same way, a hole in a style, `{name ^style}`, is the hole `name` (`^` is a method answering what it is on: it is for
// highlighting and nothing else), and one taken as written, `{literal name}`, the hole `name` (a hole is code already).
{name ^style} =>
  {name} ^{style}
{literal name} =>
  {name}
// A head written with a style after it, `if {condition} {{taken}} ^keyword =>`: the head, its literals shown in that style (the host
// told, `goto styled`: the rule defined last).
{head} ^{style} => {{body}} =>
  {head} =>
    {body}
  goto styled
  {style}
// A test, `assert c`: checked after everything is read (when the host puts that off: reading
// abstractly; what it reads is read then, so it is written below any rule, here too), where it is written;
// in a class, once (not again in each instance, unless it names something the instance has). (`dynamically assert c` is no
// test: checked in each instance, with its data.)
assert {condition} ^keyword =>
  goto afterwards
  ensure {condition}
goto independent
assert {condition}

// A name with a type and no value: declared here, its value the type (read, both its type and its value are of that kind),
// the type read where it is written (in a call's arguments, `f(x: x)`, the caller's `x`); it answers `declared`. (Written
// `{ }` after `:`, which means the same space, so the rule below does not read this as a name with a type.)
{name}:{ }{type} =>
  {type}
  (declarations := Listing.new) unless (here declarations) && declarations
  declarations.append("{name}")
  {name}: {type} =>
    {type}
  declared
assert {
  {a} %+ {b} => true
  // GR1 a rule written at the top reads at the top
  assert true %+ true
  inside => (
    {a} %+ {b} => false
    true %+ true
  )
  // GR2 a rule written in a body overrides the reading in that body
  assert !(inside)
  // GR3 a rule written in a body does not change the reading after it
  assert true %+ true
  beside => true %+ true
  // GR4 a rule written in one body is not seen in a sibling body
  assert beside
  {a} %++ {b} => false
  {a} %+++ {b} => true
  // GR5 the longest declared word wins: %++ is not read as %+ followed by +
  assert !(true %++ true)
  // GR6 the longest declared word wins: %+++ is not read as %++ followed by +
  assert true %+++ true
  // GR7 a longer word declared later does not take over the shorter one
  assert true %+ true
}
// (several at once: `a: 1, b: 2`)
{name}:{ }{type}, {{rest}} =>
  {name}: {type}
  {rest}
// A name with a type, in a definition's head (whatever wrote it: `:=`, `=`, destructuring, a closure's parameters, a class's
// fields, a declaration): the rule is the name's, what it reads checked against the type (`checked`, below), the type kept
// with it. (Defined after a declaration, it binds looser: `f: T => v` is a rule.)
{name}: {type} => {body} =>
  {name} =>
    ({body}) checked ({type})
  {name}.type =>
    {type}

// Which way a statement is read is the order the rules are defined in: of the rules reading all of it, the latest is read
// first (its operator binds loosest). So the operators that bind tightest come first.

// Text: what is written between quotes (`.text`, a capture read as a value, is its text as written; each escape in it, `\e`,
// what it stands for).
"{text}" ^string =>
  (.text).unescaped
unescaped =>
  .
`{text}` ^string =>
  .text
// S158 written text is not read as a string
assert `ab` as String == "ab"
// (given code, a block on one line, `f(code: { … })`: that code, unread, run when it is called)
{name}:{ }{`{`}{ }{code}{ }{`}`} =>
  {name} := (() => ({code}))
  declared
{name}:{ }{`{`}{code}{`}`} =>
  {name} := (() => ({code}))
  declared

// A name given a value again: the value read, then the name a rule reading it. A definition whose right side is a value
// rewrites the rule of the nearest node that has the name (here, when none does).
{name} = {value} =>
  {value}
  {name} =>
    {value}
// A name declared here, given a value: a rule here first (not a value: any other definition is made where it is read), then
// given it (that rule, the nearest: not a write through `=`).
{name} := {value} =>
  {value}
  {name} =>
    None
  {name} =>
    {value}
  goto styled
  variable

// Node: the outermost node (`.`, here, is the node being read in). Every node sees its rules, so they are what any value
// read on reads: its methods.
Node := .
// (`global`: the same outermost node, named for what is defined everywhere: `global[name] := …`, `global.None`)
global := Node
// (the names declared in a node, in order (`x: T`): its fields; see `fields` in the library)
declarations := None
// (what a declaration, `x: T`, answers: nothing but that it declared)
declared := { }
assert {
  declared := 3 ; declared += 1
  // CF20 a declaration and an assignment on one line did not both run
  assert declared == 4
}
// A field named by its pattern as written, `{*}: T` (what no other field reads): kept under that text, not a rule (a head that
// is one hole would read everything). A pattern is a body written.
Pattern := {
  {{written}} =>
    written
}
{pattern: Pattern}:{ }{type} =>
  (declarations := Listing.new) unless (here declarations) && declarations
  declarations.append("{pattern}")
  .holding("{pattern}", {type})
// (code read in a node: its definitions are the node's; a class's maker (what `X := class …` gives) has its own, see `class`)
&+= {{block}} =>
  {block}
  .
// A member given a value: given in what is before it.
{on}.{name} := {value} =>
  {on} &+= {
    {name} := {value}
  }
  goto styled
  property

// (A member, `x.y`: `x`, then `.y` read in it, the reader's `.`.)

// A comment after a statement.
{statement} //{comment} =>
  {statement}
{statement} // {comment} =>
  {statement}

// A group: read as what is inside it. (A head that is one hole between two characters makes them a pair, as `{ }` are: a
// hole never ends inside one.)
({grouped}) =>
  {grouped}

// A name given a value in parentheses: `(a) := 1`. (A list of names, `(a, b) := …`, waits for `,`: a method on Node making a
// Ray.)
({name}) := {value} =>
  {name} := {value}

// Read on a value without a space between: tightest (precedence is the order rules are defined in: one defined later binds
// looser), so `a === x[k]` is `a === (x[k])`.
// What a value holds under a key: a key that is text, the member it names (`global["Decimal"]` is `Decimal`); any other, an
// entry (keys the same when `===`). (Given one: see `x[key] = v` below.)
// Partial arguments: `f<a: 5>` is `f` with those given first (code: inlined into each call before its own arguments): `g :=
// f<a: 5>`, then `g(1)` gives `b`.
{function}<{{given}}> =>
  ((also) => {function}({given}, also))

// A narrowing, `T{constraint}` (a method: a class's own `x{ … }` is read first): a T for which the constraint, read with `.` the
// value, answers true (`constraint`, `holds`); what `Narrowing` has (the library adds to it). Called, `p{O: level}()`: what it
// narrows given what the constraint writes (settings), called. (Made in a node holding these, as a class is: none is its own
// rule, which a typed hole `{x: T}` reads.)
{{constraint}} =>
  . -- (narrowed => (Narrowing.extended() &+= {
    narrows := narrowed
    constraint := (it) => it with { {constraint} }
    holds (it) =>
      constraint(it)
    () =>
      holds(narrows)
      narrows()
    narrowing := { }
  }).narrowing)

// `!x`: false when x is anything but `None` and `false` (`?`, below). (Before the operators: `a != b` is `!=`, not `a` then `!`.)
!{x} =>
  {x} ? false : true
// BB4 not(true) should be false
assert !(!true)
// BB5 not(false) should be true
assert !false
// BO21 not not true is not true
assert !!true
// BO22 not not false is true
assert !(!!false)
// BO28 asking whether nothing is there answers nothing
assert !None
// What the host's own kinds of value answer (their operators: they bind tighter than what follows).
goto kinds

// What a value answers to `?`: anything is true, but `None` and `false`.
? {yes} : {no} =>
  {yes}
None := {
  ? {yes} : {no} =>
    {no}
  value =>
    None
  next =>
    None
  // (a member of None is None: chains need no `?.`)
  .{member} =>
    None
}
// BO27 nothing is there
assert !(None)
// Negations on nothing answer true (T1.8)
// NGN1 nothing is said to be one
assert None != 1
// NGN2 nothing is said to match
assert None !~= "a"
false := {
  ? {yes} : {no} =>
    {no}
}
// BO23 true is not itself
assert true == true
// BO24 true is false
assert !(true == false)
// BO25 true is not there
assert true
// BO26 false holds as a condition
assert !(false)
true := { }
{a} || {b} =>
  {a} ? {a} : {b}
// BB8 or(true,false) should be true
assert true || false
// BB9 or(false,false) should be false
assert !(false || false)
// BO4 or(false,true) should be true
assert false || true
// BO5 or(true,true) should be true
assert true || true
// N97 zero or true is not true
assert 0 || true
// N98 zero or false is true
assert !(0 || false)
assert {
  cleared_vertex := [1, 2].entry
  kept_vertex := cleared_vertex
  cleared_vertex = None
  // NGN4 a vertex set to nothing keeps its boundaries
  assert !(kept_vertex.initial || kept_vertex.terminal)
}
{a} && {b} =>
  {a} ? {b} : {a}
// BB6 and(true,true) should be true
assert true && true
// BB7 and(true,false) should be false
assert !(true && false)
// BO2 and(false,true) should be false
assert !(false && true)
// BO3 and(false,false) should be false
assert !(false && false)
// BB16 true && !false should be true
assert true && !false
// N95 one and true is not true
assert 1 && true
// N96 zero and true is true
assert !(0 && true)
// NGN3 a negation on nothing does not answer true against something, or holds against nothing
assert None != 5 && !(None != None)
// HS11 choosing a counted type does not resolve to one of its possibilities
assert (choose 1 ("A" | "B")) is ("A" | "B") && (choose 1 ("A" | "B"))#.count == 1
// `a & b` of two that are true or false: both (`x.(.a == 1 & .b == 2)`); of anything else, what its own `&` is (a Node's,
// their conjunction).
{a} & {b} =>
  (goto .) unless ({a} === true) || ({a} === false)
  {a} && {b}
// TY68 what holds both does not hold the second
assert (1 & 2).contains(2)
// TY69 three held at once are not three
assert (1 & 2 & 3).conjoined.count == 3
{a} ?? {b} =>
  {a} ? {a} : {b}
// BN1 ?? does not fall back on nothing
assert None ?? true
// BN2 ?? replaces a value that is there
assert !(false ?? true)
assert {
  maybe: boolean? = None
  // BN3 ?? does not fall back on an optional left empty
  assert maybe ?? true
}
// The same value: gone to as a label (a node is the label written as it); nothing there, another.
{a} === {b} =>
  goto {a}
  goto other
  {b}\
  true
  goto same
  other\
  false
  same\
{a} !== {b} =>
  ({a} === {b}) ? false : true
// A choice, `c ? a : b`: the condition all before the `?` (`x > 1 ? a : b`).
{condition} ? {yes} : {no} =>
  ({condition}) ? {yes} : {no}
// BT3 c ? a : b does not take a when c holds
assert true ? true : false
// BT4 c ? a : b takes a when c does not hold
assert !(false ? true : false)
// BT5 c ? a : b does not take b for a named c
assert false ? false : true
// A branch: the block taken read where the branch is (a label gone to by what the condition answers; named apart from a
// loop's, which `break` and `continue` go to through it).
if {condition} {{taken}} ^keyword =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {taken}
  passed\
// IC4 an if whose block holds no cases is read as cases
assert !((if 0 { "taken" }))
// CC6 a bare if with a false predicate is not None-like
assert !((if false { true }))
unless {condition} {{taken}} ^keyword =>
  {condition} ? (goto passed) : (goto taken)
  taken\
  {taken}
  passed\
// CC7 unless did not fire
assert (unless false { true })
// CF9 unless has no other side
assert (unless true { 1 } else { 2 }) == 2
// (a chain, `if … {} elsif … {} else {}`: its condition ends at the nearest body; what follows it an `elsif`)
nearest if {condition} {{taken}} {chain} =>
  (goto .) unless (.chain) begins "elsif"
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {chain}
  passed\
nearest elsif {condition} {{taken}} =>
  {condition} ? (goto taken) : (goto passed)
  taken\
  {taken}
  passed\
nearest elsif {condition} {{taken}} {chain} =>
  (goto .) unless (.chain) begins "elsif"
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {chain}
  passed\
nearest elsif {condition} {{taken}} else {{otherwise}} =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {otherwise}
  passed\
// CC3 elsif did not fire
assert (if false { true } elsif true { true } else { false })
// CC4 else after elsif did not fire
assert (if false { true } elsif false { true } else { true })
if {condition} {{taken}} else {{otherwise}} ^keyword =>
  {condition} ? (goto taken) : (goto otherwise)
  taken\
  {taken}
  goto passed
  otherwise\
  {otherwise}
  passed\
// CC1 if-true did not take the then branch
assert (if true { true } else { false })
// CC12 an if whose taken branch is None is present
assert !((if false { 1 } else { None }))
// CC13 an if whose taken branch is one is absent
assert (if true { 1 } else { None })
// CC2 if-false took the then branch
assert !((if false { true } else { false }))
// CC5 a later branch overrode the first
assert (if true { true } elsif true { false } else { false })
// Only the branch that is taken runs
// CF1 a taken branch did not answer
assert (if true { true } else {
  false = true
  false
})
// CF2 the branch nobody took ran anyway
assert !(false)
// CF5 a branch does not answer its last statement
assert (if true {
  1
  2
  3
} else { None }) == 3
// CF6 a branch inside a branch is not read there
assert (if true { if false { 1 } else { 2 } } else { 3 }) == 2
// CF7 a number that is there does not hold
assert (if 1 { true } else { false })
// CF8 nothing holds
assert !((if None { true } else { false }))

// Loops: `break` goes to the loop's end, `continue` to its start.
while {condition} {{body}} ^keyword =>
  again\
  {condition} ? (goto looping) : (goto done)
  looping\
  {body}
  goto again
  done\
// Loops
assert {
  flag := true
  while flag { flag = false }
  // CC8 while did not run its body
  assert !(flag)
}
assert {
  ran := false
  while false { ran = true }
  // CC9 while ran with a false predicate
  assert !(ran)
}
loop {{body}} ^keyword =>
  again\
  {body}
  goto again
  done\
{body} while {condition} ^keyword =>
  again\
  {condition} ? (goto looping) : (goto done)
  looping\
  {body}
  goto again
  done\
do {{body}} while {condition} ^keyword =>
  start\
  {body}
  again\
  {condition} ? (goto start) : (goto done)
  done\
assert {
  seen := false
  do { seen = true } while false
  // CC10 do-while did not run its body at least once
  assert seen
}
assert {
  stop := true
  do { stop = false } while stop
  // CC11 do-while did not stop
  assert !(stop)
}
assert {
  asked := 0
  do { asked += 1 } while false
  // CF12 do ran other than once when it never holds
  assert asked == 1
}
break ^keyword =>
  goto done
assert {
  stopped := 0
  while true {
    stopped = stopped + 1
    break if stopped == 3
  }
  // RC2 break does not leave the loop
  assert stopped == 3
}
continue ^keyword =>
  goto again

// Leaving a call: `return v` (the call answers v), `return`.
return {value} ^keyword =>
  {value}
  goto returned
// `recur` re-enters the method; `break` and `continue` in a loop (P2.4, P2.1)
assert {
  countdown (n) => (
    return n if n == 0
    recur(n - 1)
  )
  // RC1 recur(args) does not re-enter the method
  assert countdown(5) == 0
}
return ^keyword =>
  goto returned
// The call it is in, again from its start: `recur(arguments)`, with these; `recur`, with the same.
recur({again}) ^keyword =>
  given := ({again})
  goto rebinding
recur ^keyword =>
  goto recurring

// Code read in a value, `.` that value: `x with { … }` (before the loosest, so `y := x with { … }` gives y it).
{on} with {{block}} ^keyword =>
  {on} reading {
    {block}
  }

// The loosest, defined here once more and in this order, tightest first (a rule defined again is placed as defined now):
//   `=` (a member, `x.m = v`, given in `x`; and `x: T = v`: the value checked against T before the name, with its type, is given
//     it);
//   a closure: a rule on one line, read where a value is wanted, is a node holding it (see `language3.ts`); reading on in it
//     (`f(5)`) runs its right side in a new node in it, its parameters taking the arguments (arguments are code inlined into
//     the call: `f(x: 5)` declares its `x`, answering `declared`; see `taking`); its parameters go up to the
//     nearest `=>`, so it is made by the rule creator that does not go on; a call written with a hole, `({args}) =>`, is a
//     rule as written; a call ends at `returned\` (`return v` goes there, the call answering v), and begins at `recurring\` (`recur`
//     goes there; `recur(…)` first gives its parameters these, `given`);
//   a method: `name (parameters) =>` gives the name a closure, as `name := (parameters) =>` does (so its locals are its
//     own); a rule without parameters, `name =>`, is one too (read on in a value, `.` is that value); `x.name (…) =>` is a
//     member (a name handed on is a value: what is in it is not read again, so the member is written as one);
//   `:=`, and its more particular forms: a closure or a class given to a name (`f := (x) => …`, `X := class (…) => { … }`:
//     a line with `=>` outside brackets is a definition, read only by rules with `=>` in their heads; the name handed on as
//     written, so `global[n] := class …` is one), a member (so
//     `x.m := () => …` is one), a key (`x[k] = v`), names at once;
//   a guard: `x := 1 if c` guards the statement (and `x if a && b` guards on both);
//   `,`: a list of what is on either side.
// Rules after it are led by a literal, or are methods, so it stays the loosest. (A head written `{ }` for a space reads
// the same: it keeps a rule from reading another's head as one it reads.) (A language read after this one (the host's
// kinds) reads the logic, the choice, control flow, the guards and `,` again after its own operators, so those stay looser.)
{name} = {value} =>
  {value}
  {name} =>
    {value}
{on}.{name} = {value} =>
  {on}.{name} := {value}
{name}:{ }{type} = {value} =>
  ({value}) checked ({type})
  (declarations := Listing.new) unless (here declarations) && declarations
  declarations.append("{name}")
  {name}: {type} =>
    {value}
nearest ({{parameter}}) => {body} =>
  ({ {parameter} }) =>
    {body}
nearest ({parameters}) => {body} =>
  ({arguments}) =>
    ({parameters}) taking {arguments}
    goto recurring
    rebinding\
    ({parameters}) := given
    recurring\
    {body}
    returned\
nearest () => {body} =>
  () =>
    recurring\
    {body}
    returned\
{name} ({parameters}) => {body} =>
  {name} := (({parameters}) => {body})
  goto styled
  function
{name} () => {body} =>
  {name} := (() => {body})
  goto styled
  function
{on}.{name}{ }({parameters}) => {body} =>
  {on}.{name} := (({parameters}) => {body})
{on}.{name}{ }() => {body} =>
  {on}.{name} := (() => {body})
{name} := {value} =>
  {value}
  {name} =>
    None
  {name} =>
    {value}
  goto styled
  variable
{{name}}{ }:={ }() => {body} =>
  {name} := (() => {body})
  goto styled
  function
{{name}}{ }:={ }({parameters}) => {body} =>
  {name} := (({parameters}) => {body})
  goto styled
  function
{on}.{name}{ }:={ }() => {body} =>
  {on}.{name} := (() => {body})
{on}.{name}{ }:={ }({parameters}) => {body} =>
  {on}.{name} := (({parameters}) => {body})
{{name}}{ }:={ }class{ }({fields}) => {{block}} =>
  {name} := (class ({fields}) => {
    {block}
  })
  goto styled
  class
// A setting changed for a block is back once the block is left
assert {
  Setting := class { static level = 1 }
  // WI1 a setting is not seen in the context it is set in
  assert (
    with Setting.level = 2
    Setting.level
  ) == 2
  // WI2 a setting outlived its block
  assert Setting.level == 1
  // WI3 assume is not with
  assert (
    assume Setting.level = 3
    Setting.level
  ) == 3
}
// `.( … )` reads among the members of what is before it (A8)
assert {
  Grouped := class {
    first => 1
    second => 2
  }
  // GP1 .( ) does not read the members of what is before it
  assert Grouped.(first + second) == 3
}
// Labels in a class body are entries (L§4.2)
assert {
  Entered := class {
    steps := 0
   later\
    steps = 7
  }
  // EP1 ~label does not enter the class at that label
  assert Entered~later().steps == 7
  // EP2 ~default is not the class itself
  assert Entered~default == Entered
  // A class body runs like any function: labels are never skipped; a Component's labels are entered, not executed (F-D13, L§4.2.1)
  // CMP1 a label in a class body stops its construction
  assert Entered().steps == 7
}
assert {
  Panel := class: Component {
    shown := 0
   opened\
    shown = 1
   closed\
    shown = 2
  }
  // CMP2 constructing a component runs past its first label
  assert Panel().shown == 0
  // CMP3 entering a component at a label runs past the next label
  assert Panel~opened().shown == 1
  // CMP4 entering a component at its last label does not run what follows it
  assert Panel~closed().shown == 2
}
assert {
  TA := class { }
  TB := class: TA { }
  // TY1 an instance is not an instance of its class
  assert TA() is TA
  // TY2 an instance is not one of a class that requires nothing
  assert TA() is TB
  // TY3 an instance is not an instance of its own class
  assert TB() is TB
  // TY4 an instance is not an instance of what its class is built on
  assert TB() is TA
  // TY6 five is not one of a class that requires nothing
  assert 5 is TA
  // TY7 a class is written nowhere
  assert external where TA
  // TY8 two classes are written in one place
  assert !((external where TA) == (external where TB))
  TC := TA
  // TY9 one class under two names is written twice
  assert (external where TA) == (external where TC)
}
// A class requires the fields it writes with their type
assert {
  Needs := class { amount: Number }
  Gives := class { amount => 1 }
  Lacks := class { other => 1 }
  // TY60 what gives every required name is not one
  assert Gives() is Needs
  // TY61 what lacks a required name is one
  assert !(Lacks() is Needs)
  // TY62 a number gives a name it does not have
  assert !(5 is Needs)
  // TY64 what is entered nowhere is an array
  assert !(Lacks() is Array)
}
// A child is made of its parent's fields, defaults and methods
assert {
  Parent := class {
    named: "p"
    flag: false
    greet => named
  }
  Child := class: Parent {
    extra: "e"
  }
  // TY10 the child's own field is not there
  assert Child().extra
  // TY11 the parent's field is not there
  assert Child().named
  // TY12 the parent's method does not answer
  assert Child().greet == "p"
  // TY13 the parent's default is not false
  assert !Child().flag
  // TY14 the parent's field cannot be given
  assert Child(named: "q").named == "q"
  // `Type?` is the type or nothing
  Either := Parent?
  // TY21 a child is not one of its parent or nothing
  assert Child() is Either
  // TY22 a parent is not one of itself or nothing
  assert Parent() is Either
  // TY23 nothing is not one of a thing or nothing
  assert None is Either
  // TY24 nothing is one of a thing
  assert !(None is Parent)
}
// A class built inside a method answers with what that call wrote
assert {
  Wrapping := class {
    wrapped (tag) => class: this {
      says => tag
    }
  }
  once := Wrapping.wrapped(1)
  twice := once.wrapped(2)
  thrice := twice.wrapped(3)
  // TY28 the first wrapping says other than what it was written with
  assert once.says == 1
  // TY29 a wrapping of a wrapping says its parent's
  assert twice.says == 2
  // TY30 a third wrapping says an older one's
  assert thrice.says == 3
  // TY31 building on a class changed what it says
  assert once.says == 1
}
// A class written as a structure: each named position a field of that type
assert {
  Pointed := class whole: Number, ".", part: Number {
    summed => whole + part
  }
  pointed := Pointed(whole: 2, part: 3)
  // TY32 a structure's first field is not what it was built with
  assert pointed.whole == 2
  // TY33 a structure's last field is not what it was built with
  assert pointed.part == 3
  // TY34 a structure's body does not read its fields
  assert pointed.summed == 5
  // TY35 a structure does not keep what is written between its fields
  assert Pointed.positions[1] == "."
}
assert {
  Ranged := class low: Decimal, "-", high: Decimal {
    width => high - low
  }
  range_of{ }{written: Ranged} => written
  ranged := range_of 2-7
  // TY36 a structure read from text does not start at what is written first
  assert ranged.low == 2
  // TY37 a structure read from text does not end at what is written last
  assert ranged.high == 7
  // TY38 a structure read from text is not built as one
  assert ranged.width == 5
  positioned: Ranged = (4, "-", 9)
  // TY39 positions given to a structure are not built as one
  assert positioned.width == 5
  misfit: Ranged = (4, "+", 9)
  // TY40 positions that do not fit a structure are taken as a structure
  assert misfit[1] == "+"
  spanned: Ranged = 3-8
  // TY41 text given to a structure is not read by it
  assert spanned.width == 5
}
assert {
  Bare := class only: Number
  // HD6 a header without a body has no field
  assert Bare(3).only == 3
}
// Uniqueness under an equivalence (T6.9)
assert {
  UniquelyNamed := class { unique<in: .fold_case> name: String }
  named_first := UniquelyNamed(name: "Ada")
  named_other := UniquelyNamed(name: "Bea")
  // UQI1 a name no other holds is not unique
  assert named_other.name.is_unique<in: .fold_case>
  named_clash := UniquelyNamed(name: "ADA")
  // UQI2 a name another holds in other case is unique with case folded
  assert !(named_clash.name.is_unique<in: .fold_case>)
  // UQI3 a name is not unique without folding case though no other is equal
  assert named_clash.name.is_unique
}
assert {
  Greeter := class {
    greeting => name
    twice => greeting
  }
  Loud := class: Greeter {
    greeting => global
    polite => super.greeting
  }
  loud := Loud(name: global)
  // C22 super.greeting did not run the parent's method on the instance
  assert loud.polite
  // C23 super reaches the parent's other methods
  assert loud.super.twice
}
// A class extended later reaches every instance built from it
assert {
  Late := class { }
  built_before := Late()
  Late &+= {
    added => 1
  }
  // C24 a class extended later does not reach an instance built before
  assert built_before.added == 1
  // C25 a class extended later does not reach an instance built after
  assert Late().added == 1
}
assert {
  G1 := class { depth => 1 }
  G2 := class: G1 { depth => 2 }
  G3 := class: G2 { depth => 3 }
  // C26 the nearest class does not answer
  assert G3().depth == 3
  // C27 the middle class answers its parent's
  assert G2().depth == 2
  // C28 the first class answers something else
  assert G1().depth == 1
  // C29 a class three deep has no super
  assert G3.super
  // C30 super does not reach the class it is built on
  assert G3.super.depth == 2
}
{{name}}{ }:={ }class:{ }{parent}{ }({fields}) => {{block}} =>
  {name} := (class: {parent} ({fields}) => {
    {block}
  })
  goto styled
  class
// (what it is given in made first when nothing has that name yet, `orbitmines.com := …`: a name not given reads as its text)
{on}.{name} := {value} =>
  ({on} := { }) if ({on}) === "{on}"
