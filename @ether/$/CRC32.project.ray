// CRC-32 of ISO 3309, ITU-T V.42 and IEEE 802.3: the polynomial reflected as 0xEDB88320, the register starting and ending inverted (https://www.rfc-editor.org/rfc/rfc1952#section-8, https://www.w3.org/TR/png-3/#D-CRCAppendix)
CRC32 := class: Language {
  static extensions := ".crc32"
  static size := 4

  static step (c, byte: Byte) => (0..7).reduce(r = c ~x|| byte => r.odd ? (r / 2).floor ~x|| 0xEDB88320 : (r / 2).floor)
  // The checksum as 32 bits, most significant byte first (https://www.w3.org/TR/png-3/#5CRC-algorithm)
  written := {
    {writing: Language.Writing} => ((writing.value as Byte[]).reduce(c = 0xFFFFFFFF => step(c, .)) ~x|| 0xFFFFFFFF) as Binary₃₂ as Byte[]
  }
}
// The catalogue's check: "123456789" is 0xCBF43926
assert "123456789".bytes as CRC32 as Binary₃₂ == 0xCBF43926  // CRC1 the check string does not sum to cbf43926
assert [] as CRC32 as Binary₃₂ == 0  // CRC2 no bytes do not sum to zero
// PNG's IEND chunk carries the CRC of its type alone (https://www.w3.org/TR/png-3/#11IEND)
assert "IEND".bytes as CRC32 as Byte[] == [0xAE, 0x42, 0x60, 0x82]  // CRC3 IEND's type does not sum to ae426082
