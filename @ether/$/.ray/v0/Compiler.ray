Compiler := class {
  none := {
  }

  default := {
    {a} + 0 => a
    {a} - 0 => a
    0 + {a} => a
    {a} * 0 => 0
    0 * {a} => 0
    {a} * 1 => a
    1 * {a} => a
    {a} / 1 => a
    {a} * 2 => a + a
    {a}.unique.unique => a.unique
    {a}.reverse.reverse => a
    {a}.compact.compact => a.compact
    {a}.flatten.flatten => a.flatten
    {a}.sort.sort => a.sort
  }

  folding := {
    {a} + 0 => a
    0 + {a} => a
    {a} * 1 => a
    1 * {a} => a
  }

  memoised := {
  }

  logic := {
    !!{a} => a as boolean
    {a} && {a} => a
    {a} || {a} => a
  }

  levels => [none, default, folding, memoised, logic]
}

Debug := class {
  timed := {
  }
}

// A level is the rules in scope (P8.1). Levels compose by putting both in scope: `Web.HTML + Web.CSS + Web.JS` (F-D7).
// What a level produces is a value; it becomes text only where it is written to a location, in that location's language (X1.7).
Program &+= {
  O | optimizations := Compiler.none
  + (other: Program) => Program(code: (code, other.code))
}
