forward :=
forward unordered
forward ^{literal word ^ word}{ }

external  ^external := external external
global    ^keyword := external global
// Optimistically unordered: If there's a non-circular dependency chain, it will remain ordered.
unordered ^keyword := external unordered
inline    ^keyword := external inline
literal   ^keyword := external literal
theme     ^keyword := external theme
report    ^keyword := external report
forward   ^keyword := external forward
None      ^keyword := external none

`{literal string ^string}` ^string.punctuation => string
//{literal comment?} ^comment => None

{`{`}{expr ^block}{`}`} ^punctuation => (
  scope ^keyword := external .
  value := inline expr
  // A block is made of its value, and of None too: then it stands for nothing.
  goto block_composes if (external own value)
  goto block_done
 block_composes\
  external extend scope value
 block_done\

  scope ^namespace
)
({expr}) ^punctuation => expr
[{expr}] ^punctuation => expr

goto{ }{literal target ^label} ^class => external goto target global
goto{ }{literal target ^label}{ }if{ }{condition} ^class => external goto target condition
unordered {literal label ^label}\ ^punctuation => external label label

return{ }{value} ^keyword => (
  value
  goto return\
)

// The colours a style may be written with, as the draft spells them.
RGB := class {
  Hexadecimal := class { }
}

^: {
  {literal}: () => A
  {: LSP.SemanticToken.Type}: () => A
  #{: RGB.Hexadecimal}: () => A
} ^punctuation := external ^
^{ }{literal color: RGB.Hexadecimal ^ color} => external ^ color


chain (holder) => (
  links ^keyword := external .
  instance := global
  owner := holder
  head := None
  tail := None
  external extend links Chain

  links ^namespace
)

link (holds, before) => (
  entry ^keyword := external .
  instance := global
  value := holds
  previous := before
  next := None
  external extend entry Link

  entry ^namespace
)

// `class: Parent { body }`: a class beneath another; instances compose the
// parent, and a value is verified against the parent's body before its own.
// spec: the parent's body is not run per instance. Its fields are inherited as
// the parent static declared them, defaults and all, and may be given at the
// call — but a field whose default is a thing rather than a value is the
// *same* thing for every instance: two `class: Parent` instances share one
// `kept: (chain None)`, where two instances of a class declaring it themselves
// do not. The library declares such fields again in each subclass to avoid it.
// What this waits on is the constructor running what the parent declared, in
// the instance, before what the class itself declares.
unordered class:{ }{parent}{ }{block} ^keyword => (class block): parent

unordered class{ }{block} ^keyword => (
  static ^keyword := external .
  static.instance = None
  static.components = chain None
  static.components.hierarchy = chain static
  super ^keyword => (
    parent := static.components.hierarchy.tail.value
    instance := this
    view ^keyword := external .
    external extend view parent
    external extend view instance

    view
  )
  inline block

  // The constructor is the body itself: what is passed is typed by the
  // `field: Type` lines it meets, what is not is declared by them.
  ({inline args}) => (
    static ^keyword := this
    this ^keyword := external .
    this.components = chain None
    this.components.hierarchy = chain this
    this.components.hierarchy &= static
    this.instance = global
    inline block

    this ^variable
  )

  static ^class
)

unordered base{ }class{ }{body} ^keyword => (
  static := class { inline body }

  external base static
  
  static
)

Node := base class {

  {(String ^function | `{`, expr ^parameter, `}` | `[`, operator ^operator, `]`)[]}{ }=>{body} ^punctuation => external GRAMMAR_RULE

  , ^punctuation ^separator => this
  // Function definition
  static DEFINE_METHOD = `=`
  // `(args) => body`: a function; the body comes only after `=>`, so
  // `f(args).member` stays a call followed by a member.
  ({args ^parameter}){ }=>{ }{block} ^punctuation => (this ^function) [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def
  )

  -- ^punctuation (call) => call(this)
  
  = ^punctuation (x) => (
    external assign this x

    this
  )
  := ^punctuation (x) => (
    external declare this x

    this
  )
  : ^punctuation ^annotation (type) => (
    goto typed if (external own this)
    goto absent if (None.instance_of(type))
    external declare this type
    goto done
   absent\
    external declare this None
    goto done
   typed\
    // A value passed where a type is written types nothing: `n: two`.
    goto done if type.instance
    // What holds nothing is not made of anything, and there is nothing of it
    // to check.
    goto holding if this
    goto done
   holding\
    // What is already held is checked against the type, not made of it: a
    // value is not the place a field's type is written down.
    goto held if this.instance
    this.components.hierarchy &= type
   held\
    type.verify(this)
   done\

    this
  )
  // `field?: Type`: absent is None, present is typed.
  // `X?` is `X | None`; a field of such a type is None when absent.
  ? ^punctuation => this | None
  ?: ^punctuation (type) => this: (type?)
  // `x ==.instance_of type`, as presence: None is an instance of a type when
  // None is among its components (`T?` is `T | None`), and anything else is
  // an instance of what it is built on. A primitive beneath `if` (the
  // annotation and the pattern reader ask it), so it walks by goto.
  // Two things written in one place are one thing, which is what tells one
  // type from another.
  instance_of (type) => (
    found ^keyword := None
    goto mine if this
    goto no if type.instance
    goto scan if type.components
    goto no
   scan\
    walker ^keyword := type.components.head
   step\
    goto present if walker
    goto no
   present\
    goto skip if walker.value
    goto yes
   skip\
    walker = walker.next
    goto step
   mine\
    found = .built_on(type)
    goto admitted if found
    goto alternatives if type.components
    goto no
   alternatives\
    // A type written as alternatives (`A | None`, which `A?` spells) is any
    // one of them: what is built on one of them is one of it.
    other ^keyword := type.components.head
   alternative\
    goto try_alternative if other
    goto no
   try_alternative\
    found = .built_on(other.value)
    goto admitted if found
    other = other.next
    goto alternative
   admitted\
    found = type.admits(this).holds
    goto no
   yes\
    found = global
   no\

    found
  )
  // Whether what this is built on reaches that type: what a thing is made of,
  // and what that is made of in turn. Two things written in one place are one
  // thing, which is what tells one type from another.
  // spec: the draft's `class Location = Ray` (Entity.ray) is a location with a
  // hierarchy — a parent and children, a host instance — and every Node holds
  // one, written `@`. Here a location is where a thing is written, which the
  // machine answers (`external where`), and the hierarchy awaits the world's
  // locations. `location` is not a name on Node, because a field of that name
  // is what a persona and an item hold.
  built_on (type) => (
    walker ^keyword := .components.hierarchy.head
    found ^keyword := None
    while (exists walker) {
      if (exists (external alike (external where walker.value) (external where type))) { found = global }
      unless (exists found) {
        if (exists walker.value.built_on(type)) { found = global }
      }
      walker = walker.next
    }

    found
  )
  // `{name: Type}` in a pattern: the capture is what its type reads out of
  // the text there, and the pattern holds only where that is not None. A type
  // that says nothing of reading takes the text as it is.
  accepts ^reader (text) => text
  // Whether a block, read with this as `this`, holds.
  satisfies (predicate) => (inline predicate)
  // `Type.verify(x)`: what a type asserts of a value typed by it; a narrowing
  // (`Type{predicate}`) asserts its predicate, after what it narrows asserts.
  verify (candidate) => candidate
  // `Type.admits(x)`: the same thing asked rather than asserted, so that being
  // one of a kind can be answered. A kind admits what it is made for; a
  // narrowing admits what also satisfies it.
  admits (candidate) => true
  // `Type{predicate}`: the type narrowed by a constraint; `values{predicate}`:
  // the values that satisfy it.
  {this}{`{`}{literal narrowing}{`}`} ^punctuation => (
    narrowed ^keyword := this
    selected ^keyword := None
    if (exists narrowed.instance) {
      selected = chain None
      narrowed for {
        held := it.value
        if (held.satisfies({ inline narrowing })) { selected &= held }
      }
    } else {
      selected = class: narrowed {
        // What the narrowed type reads, where it satisfies the constraint.
        accepts (text) => (
          candidate := narrowed.accepts(text)
          if (exists candidate) { if (candidate.satisfies({ inline narrowing })) { candidate } else { None } } else { None }
        )
        verify (candidate) => (
          narrowed.verify(candidate)
          unless (candidate.satisfies({ inline narrowing })) { ERROR@candidate `does not satisfy a constraint of its type` }

          candidate
        )
        admits (candidate) => if (narrowed.admits(candidate)) { candidate.satisfies({ inline narrowing }) } else { false }
        if (exists this.instance) { selected.verify(this) }
      }
    }

    selected
  )
  // `Type<args>`: the type with some of its constructor's arguments given.
  // spec: one `<>` per type for now; a second narrowing keeps only its own.
  {this}<{literal partial ^parameter}> ^punctuation => (
    narrowed ^keyword := this

    class: narrowed { inline partial }
  )
  // `x ~~ expression`: the expression read with `x` as `this`; `x` again.
  ~~ ^punctuation (x) => (
    inline x

    this
  )
  // `a ; b`: what is written after is read where it is written, and is what
  // the whole answers — the draft's `; (call) => call<local: &caller>()`
  // (.ray3/Node.ray). This is what separates two statements written on one
  // line: a newline separates them otherwise, and `,` is for where a list is
  // meant rather than a second statement.
  ; ^punctuation (x) => inline x

  &= ^punctuation (x) => (
    value := x
    previous := this.tail
    added := link value previous
    goto more if previous
    this.head = added
    goto linked
   more\
    previous.next = added
   linked\
    this.tail = added
    goto owned if this.owner
    goto done
   owned\
    holder := this.owner
    external extend holder value
   done\

    this
  )
  // `a | b`: a superposed with b — a copy of `a` whose components (`#`) gain `b`.
  | ^punctuation (other) => (
    superposed ^keyword := external .
    superposed.instance = None
    superposed.components = chain None
    external extend superposed this
    goto superpose_each if this.components.head
    superposed.components &= this
    goto superpose_other
   superpose_each\
    alternative ^keyword := this.components.head
   superpose_step\
    goto superpose_copy if alternative
    goto superpose_other
   superpose_copy\
    superposed.components &= alternative.value
    alternative = alternative.next
    goto superpose_step
   superpose_other\
    superposed.components &= other

    superposed
  )

  . ^punctuation => this
  .{literal property ^property} ^punctuation => this[property]
  {\n}.{literal property ^property} ^punctuation => this[property]

  [{property ^property}] ^punctuation => external get this property

  // spec: a written literal has no equality of its own. Giving one to every
  // node here does answer two written texts, but it also reads a written
  // numeral as its text, so `4 == four` turns false: what a numeral is, is
  // settled by the rule that reads it, and asking `==` of it first never lets
  // that happen. Two literals are compared through `String.of` until a
  // literal is a thing in itself.
 
  test5 => TODO
  test4 a => TODO // Doesnt work, since this is test4.a => TODO
  test (a) => {
    TODO
  }
  test2 test: () => ReturnType, ReturnType -- = DEFAULT_FUNC => ActualReturnType => {

  }
  test3 (paramater2) => TODO
}

// Set the actual method used for function definitions.
Node.DEFINE_METHOD = `&=`

Chain := class {
  entry => .head
}
Link := class { }

if := class {
  { }{cond}{ }{yes} ^class => (
    branch ^keyword := external .
    inline static
    taken := None

    goto enter if cond.holds
    goto skip
   enter\
    taken = global
    result := (yes)
    inline result
   skip\

    branch ^variable
  )

  elsif{ }{cond}{ }{block} ^class => (
    branch ^keyword := external .
    inline this
    taken := .taken

    // What a branch already taken is written against is not read at all: the
    // condition of every `elsif` after it costs nothing.
    goto skip if taken
    goto enter if cond.holds
    goto skip
   enter\
    taken = global
    result := (block)
    inline result
   skip\

    branch ^variable
  )

  // A branch written on the next line is the same branch: what follows the
  // newline is read on what came before it.
  {\n}elsif{ }{cond}{ }{block} ^class => this elsif cond block
  {\n}else{ }{block} ^class => this else block

  else{ }{block} ^class => (
    branch ^keyword := external .
    inline this
    taken := .taken

    goto skip if taken
    taken = global
    result := (block)
    inline result
   skip\

    branch ^variable
  )
}

// What is written unless something is what is written when that something is
// not taken: the branch not taken, asking the condition nothing that `if`
// does not ask it itself. Asking `cond.not` instead lost every condition that
// is not a boolean — `.not` was unresolved, the block never ran, and a test
// that reports by `unless` reported nothing.
unless{ }{cond}{ }{block} ^class => if cond { } else block

while := class {
  { }{cond}{ }{block} ^class => (
    loop ^keyword := external .
    inline static

   again\
    goto more if cond.holds
    goto done
   more\
    block
    goto again
   done\

    loop ^variable
  )

  { }{block}{ }while{ }{cond} ^class => (
    block

    this cond block
  )
}

do ^keyword := while

// `dynamically x`: read now (spec: re-read when what it depends on changes).
dynamically ^keyword (x) => (inline x)
// `assert condition`: reported when it does not hold.
assert ^keyword (condition) => (
  unless condition { ERROR@condition `assertion failed` }

  condition
)

unordered enum ^keyword => (
  // A member is built on what the enum is (the rule's receiver), not on this
  // helper class, which is only where the rules are written.
  static := class {
    {literal member ^enumMember} ^punctuation => (
      entry := this(name: member)
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    {literal member ^enumMember}{ }{fields ^property} ^punctuation => (
      entry := this(
        name: member
        inline fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember} ^punctuation => (
      entry := this(name: member)
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember}{ }{fields ^property} ^punctuation => (
      entry := this(
        name: member
        inline fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )

    // One member is another when it is the same member: what a member is, is
    // the name it is written under. What carries no name is what it is by
    // where it is written.
    == (other) => if ((exists .name).and(exists other.name)) {
      exists (external alike (.name) (other.name))
    } else {
      exists (external alike (external where this) (external where other))
    }
  }

  static ^enum
)

unordered enum{ }{literal member ^enumMember}{ }{fields? ^property}{ }{literal rest?}{ }{`{`}{block?}{`}`} ^keyword => (
  static ^keyword := external .
  inline enum
  inline block

  entry := static(
    name: member
    inline fields
  )
  entry.name = member
  static[member] = entry ^enumMember
  static.components &= entry
  inline rest

  static ^enum
)

Program := class {
  // `func(args)`
  ({inline args}) => (
    local ^keyword = external .
    inline this
  )
  // `func args`
  { }{expr} => this(expr)
}

LSP := {
  SemanticToken := class {
    Type := enum namespace | type | class | enum | interface | struct | typeParameter | parameter | variable | property | enumMember | event | function | method | macro | keyword | modifier | comment | string | number | regexp | operator | decorator
    Modifier := enum declaration | definition | readonly | static | deprecated | abstract | async | modification | documentation | defaultLibrary
  }
}

DARK := theme `Ether.ray - Dark` {
  // Based off https://github.com/simurai/duotone-dark-syntax
  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^type = ^class = ^enum = ^interface = ^struct = ^event = ^enumMember = ^U2
  ^typeParameter = ^parameter = ^U0
  ^variable = ^property = ^U1
  ^function = ^method = ^decorator = ^U4 
  ^macro = ^U2
  ^keyword = ^modifier = ^comment = ^U3
  ^string = ^number = ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment
}
inline DARK

Diagnostic := class {
  
}

// Wrapping of errors with additional information? 
// Non-allowed variables within errors are traced. And dont get sent over pipelines which arent allowed to view them.
// Autoreturn if failed?
// &:= for errors and things to say stack all the errors together if that is used.
// Errors like OOM What to do/
// Access function context of the error?

FATAL{`@` ^punctuation}{var} ^fatal (comment: String ^comment) => report FATAL var comment 
ERROR{`@` ^punctuation}{var} ^error (comment: String ^comment) => report ERROR var comment 
 WARN{`@` ^punctuation}{var} ^warn  (comment: String ^comment) => report WARN var comment 
 INFO{`@` ^punctuation}{var} ^info  (comment: String ^comment) => report INFO var comment 
DEBUG{`@` ^punctuation}{var} ^debug (comment: String ^comment) => report DEBUG var comment 
TRACE{`@` ^punctuation}{var} ^trace (comment: String ^comment) => report TRACE var comment 

// Merge into DEBUG with |
TODO ^debug (comment: String ^comment) => DEBUG@. comment 

// Precedence: of two operators around a shared operand, the
// tighter one groups first (precedence = declaration order).
// spec: none of the three rules below reaches an expression yet, so
// `two * three + one` is eight and `one < two < three` is false. What `[x]`
// binds is written down now — it names what stands there, the way `{x}` names
// what it holds — and four things are still in the way, each measured:
//   · `.precedence` is answered by nothing. It is declaration order, which is
//     where a rule is written; `external where` gives that as `file:offset`,
//     and comparing two of those is comparing texts, which the entrypoint
//     cannot do (String is written later).
//   · `&`, `chainable`, `left-to-right` and `right-to-left` are unwritten, so
//     `missing` holds both other rules back before they are ever tried.
//   · `[x: chainable]` does not constrain what it matches — the word is read
//     for what it says about unread names and nothing else — so a rule asking
//     for a chainable operator would take any operator at all.
//   · a capture standing for the receiver refuses a space before what follows
//     unless a space is written in the pattern, and an operator is always
//     written between spaces, so the match stops at the first piece.
{a} [x] {b} [y] {c} => (a [x] b) [y] c if x.precedence >= y.precedence
{a} [x] {b} [y] {c} => a [x] (b [y] c) if x.precedence < y.precedence

// Pointing apart: both apply to the shared operand (Grammar.ray:189)
{l} [x: right-to-left] {m} [y: left-to-right] {r} => l [x] m & m [y] r

// spec: what chains was written here as a class whose `accepts` answers the
// operators that do — `[x: chainable]` asks it now, the way `{x: Type}` asks
// what it holds. Written, it costs a tenth of every run and the rule it is for
// still never fires, so it is written down rather than kept: nothing reads an
// operator out of a rule body yet, so `a [x] b` cannot apply what `[x]` names.
// Chainable: a < b < c  =>  a < b & b < c
{a} [x: chainable] {b} [y: chainable] {c} => a [x] b & b [y] c

