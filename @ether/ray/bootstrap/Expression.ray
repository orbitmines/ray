
// Expression: a language read from its own text. Its first line says how a rule is written: `!language`, the brackets a
// hole is written in (`{ }`), then the rule that makes rules, written with them (`{LHS} => {RHS}`). Every statement after it
// is read in a node by the longest of that node's rules that reads it; the rule that makes rules adds one there, its head
// read the same way, its body read when it is applied, in a node of its own whose caller is what applied it. Only four
// things are given: `external .` (a node), `external &` (what applies), `external goto` and `external label` (where control
// goes). Read under a level, `Program{O: …}`, what it reads is a Program (statements as vertices, gotos as edges), and a
// back end is one more level: `Wasm` writes that Program as WebAssembly.
// (a line's end, as a text)
line_end := "\n"
Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    // (a hole's brackets, a space where its name goes)
    CAPTURE: (String+, \s, String+),
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}(`LHS`) | RHS: CAPTURE.map{== \s}(`RHS`) | String)[],
    \n\n
  ),
  (
    // (the rule that makes rules: any space in it any amount of space, each hole anything, its left side a head of the same
    // shape again, `[LHS: [LHS, RHS], RHS]`; the first statement)
    Code := (BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Code) | String)[]
    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES.map{is \s}((space) => \s[])
    GRAMMAR_RULE_DEF.RHS = Code
    GRAMMAR_RULE_DEF.LHS = Code
    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF
    
    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,
    statements: (
      // A node: its rules by their heads; what it does not read, what it is in reads.
      Node := class (in?: Node, of?: Node) => {
        // (itself, as its rules' bodies name it: `this` there is what a statement calls them on)
        node := this
        rules := {
          [rule: GRAMMAR_RULE.LHS] := (caller) => {
            // (as the holes that wrote it took it, defined where they are used; each hole shown as its head says, `{x ^style}`)
            taken := takes(caller)
            written := level spliced (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)
            // (a name written in a pair, `(x) := v`: x read as a value, declared again where something visible defines it)
            named := between(written)
            valued := (!(written.first == hole_opening) && (level cw_enclosed (written))) && !has_hole(named)
            rule_lhs := valued ? named : written
            rule_rhs := inside_of(level spliced (rule.RHS) (BOOTSTRAPPER.CAPTURE) (taken))
            rule_where := home_of(caller, level spliced_entry (valued ? between(rule.LHS) : rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)) ?? (place_of(caller) ?? node)
            rule_home := (valued ? defined_in(rule_where, rule_lhs) : None) ?? rule_where
            sink = Array.new
            head := (rule_lhs as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => named_in(Program(in: node), hole.inside))
            rule_styled := sink.map((sp) => [level place_name (sp.rest.first), sp.first])
            // (its body read once, in a node of its own, run in a node in that one each time it is applied)
            rule_body := Node(in: ((caller.bound === None) ? node : caller.in))
            rule_home.rules[[head]] := (caller) => {
              me := applied
              me.bound = holes
              me.caller = caller
              me.in = Node(in: rule_body)
              me.bound.for((hole) => me.in.rules[[hole.key | BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => parameter_read(hole, applied, hole_value(hole, c, caller)))
              me.in.written_keys.for((hk) => hk.named = true)
              me.this = caller.this
              me.bound.for((hole) => rule_styled{.first == hole.key}#.for((sh) => painted.append([sh.last, hole.value, [[hole]]])))
              (rule_own.styled_as ?? Array.new).for((rs) => painted.append([rs.first, [rule_lhs, me.input], [me.bound]]))
              // (its body read and run in turn where it runs, the rule set aside while it is read: a rule never reads itself)
              me.outside = aside
              aside = [rule_own].joined(aside)
              (rs: Statements(me.in)(me) = rule_rhs)
              aside = me.outside
              left := leaving(finished(me), me.answer)
              // (the pairs its body's rules wrote, known only while it is read)
              level unpaired (me.in)
              left
            }
            rule_own := rule_home.rules.keys.last
            rule_own.written_head = rule_lhs
            (rule_own.named = true) if !has_hole(rule_lhs)
            // (the pairs its head writes, `({x})`, known to what is read after it; one holding `=>`, a rule that defines)
            level paired (rule_lhs) (BOOTSTRAPPER.CAPTURE) (rule_home)
            (rule_own.defines = true) if (level holds_text (rule_lhs) (separator))
            rule_own
          }
          [{value: concurrently node.prefix(.)}: node.keys, rest: (String | \n)[]] := (caller) => {
            v := value(caller)
            on := Node(in: caller.in, of: v)
            // (what it is read on gives what is read on it: a node its rules, anything else its fields; one of the level's own
            // kinds of value, what the level says it is, `level kinds`)
            o := ((level kind_of (v)) === None) ? v : named_in(Program(in: kinds_of(caller)), level kind_of (v))
            (o.rules === None) ? members(o).for((m) => on.rules[[m.key]] := (c) => m.value) : o.written_keys.for((e) => on.rules[[e.key]] := e.value)
            r := (rs: Statements(on) = rest)
            (r === None) ? None : run_by(r, Program(caller: caller, in: on, this: v))
          }
        }
        // (a name read inside its own reading is its place)
        named_as (text, by) => ((node.naming_here ?? Array.new){. == text}#.count > 0) ? Place(text, node) : named_now(text, by)
        named_now (text, by) => {
          was_naming := node.naming_here
          node.naming_here = [text].joined(was_naming ?? Array.new)
          r := (level holds_text (text) (line_end)) ? apart(by, () => turned(node, text, by)) : named_once(text, by)
          node.naming_here = was_naming
          r
        }
        // (a text of one line is one statement, read whole, or the place it names; one of more, its statements read in turn)
        named_once (text, by) => {
          v := (vs: Statements(node) = text)
          (v === None) ? Place(text, node) : apart(by, () => v(by))
        }
        split_key := rules.keys.last
        maker_key := rules.keys.first
        // (its rules but the two every node has, the one that makes rules and the split)
        written_keys => rules.keys{!((. === maker_key) || (. === split_key))}#
        // (a definition, `=>` outside pairs: the latest rule that defines, else the rule that makes rules; none set aside)
        // (what reads it here, but a name, `x`, read at its start, when what it is in reads it all, `x = v`)
        whole (text) => nearer(text, made(text, defines(text)))
        nearer (text, near) => (near === None) ? in?.whole(text) : ((near.named && !(text == near.key)) ? fuller(text, near, in?.whole(text)) : near)
        fuller (text, near, far) => (text == far?.key) ? far : near
        made (text, defining_text) => (((rules.keys.first === maker_key) && defining_text) && (text ~= maker_key)) ? (defining(text) ?? maker_key) : longest(text, defining_text)
        prefix (text) => longest(text, defines(text)) ?? in?.prefix(text)
        defining (text) => (level keys_reading (rules.keys) (text)){.defines && (!among(aside, .) && (text ~= .))}#.sort(.length).last ?? in?.defining(text)
        longest (text, defining_text) => (level keys_reading (rules.keys) (text)){!(. === split_key) && ((defining_text || !((. === maker_key) || .defines)) && (!among(aside, .) && (text ~= .)))}#.sort(.length).last
        // (and the split, `x.f`, when it reads more)
        reading (text) => longer(text, whole(text))
        longer (text, found) => ((found === maker_key) || (text == found?.key) || !prefer_split(text, found)) ? found : split_key
        // (the split, when it reads more of the text than the key does, read again: what was read since may have been another
        // text)
        prefer_split (text, found) => (text ~= split_key) && ((found === None) || (split_key.length > ((text ~= found) ? found.length : 0)))
        keys => (in === None) ? rules.keys : (rules.keys | in.keys)
      }
      // A program running: what applied it, where it is.
      Program := class (caller?: Program, at?: Statement, in?: Node, this?: Node, for_value?: Node) => { }
      Argument := class (\s+, word: String) => { }
      global := Node({
        rules[`external`, \s+, rule: String, args: Argument[]] := (caller) => {
          `.` => (caller.this = (caller.in = Node(in: caller.in)))
          `&` => caller
          `goto` (to) => (caller.at = to.first) if (to.rest.empty || to.rest.first)
          `label` (to) => to.first
          `style` (how) => painted_with(how, caller)
          `include` (file) => included(caller, file.first)
          `rule` (head) => rule_written(caller.in, head.first)
          `shown` (how) => (how.first === None) ? how.last : shown_of(level last_with (painted) (1) (how.first), how.last)
        }[rule](args.map((argument) => given(caller, rule, argument, args.first)))
      })
      // Statements: each, after any space, read by the longest rule that reads it (all at once, where they can be); run in
      // order, each given what applies them.
      Statement := class (
        leading_whitespace?: (\s | \n)[]+,
        {statement: concurrently context.reading(.)}: context.keys,
        trailing_whitespace?: (\s | \n)[]+
      ) => {}
      // (the statements as read kept on the node they are read in, `statements`: what each read, its rule and what that took)
      Statements (context: Node) => dynamically Statement[] & (caller: Program) => (
        context.statements = .
        arrived(caller, listed(.))
      )
      listed (read) => read.map((s) => s.statement)
      // (a text read by a program, run apart from its own statements: what it read so far, what waits, what it answered)
      apart (program, inner) => {
        was := [program.done, program.waiting, program.answer]
        program.done = None
        program.waiting = None
        r := inner()
        program.done = was.first
        program.waiting = was.rest.first
        program.answer = was.last
        r
      }
      turned (place, text, program) => {
        (rs: Statements(place)(program) = text)
        program.answer
      }
      // (a text's statements run by a program of its own, its jumps going on in what applied it)
      run_by (code, program) => {
        code(program)
        leaving(finished(program), program.answer)
      }
      // (each in turn, as it is read: run, but while a jump waits for a label not read yet; a jump back goes on after its label
      // among those read, another round)
      arrived (program, read) => {
        read.for((s) => arrive(program, s))
        program.answer
      }
      arrive (program, statement) => {
        program.done = (program.done ?? Array.new).append(statement)
        (program.at === None) ? go(program, [statement]) : waits(program, statement)
      }
      waits (program, statement) => (!(program.at == afterwards) && label_is(program, statement)) ? go(gone_on(program), [statement]) : kept(program, statement)
      kept (program, statement) => program.waiting = (program.waiting ?? Array.new).append(statement)
      go (program, read) => {
        rounds := [read]
        rounds.for((r) => rounds.append(settled(ran(program, r))) if !(rounds.last === None))
        program
      }
      ran (program, round) => {
        program.waiting = None
        round.for((s) => (program.at === None) ? runs(program, s) : kept(program, s))
        program
      }
      // (a label or a jump answers nothing: the body answers what was answered before it; while it runs, the rule is no longer
      // set aside)
      runs (program, statement) => {
        before := program.answer
        inside := aside
        aside = program.outside ?? aside
        a := statement(program)
        aside = inside
        program.answer = ((statement.rule == `label`) || (statement.rule == `goto`)) ? before : a
        program
      }
      // (a jump: to its label among those read, what runs next; to the host's `afterwards`, the rest kept for when everything
      // is read; to its `report`, said, then on (in a test, to its `erred`); else waiting for its label)
      settled (program) => {
        (level kept_later (program)) if (program.at == afterwards)
        said(program) if (program.at == report)
        to := (program.at === None) ? program.waiting : labelled(program, program.done)
        gone_on(program) if !((program.at === None) || (to === None))
        to
      }
      gone_on (program) => {
        forget(program)
        program.at = None
        program
      }
      labelled (program, read) => read.empty ? None : (label_is(program, read.first) ? read.rest : labelled(program, read.rest))
      label_is (program, statement) => (statement.rule == `label`) && same_label(label_of(Program(in: program.in), statement.args.first.word), program.at)
      // (a body read to its end: a value gone to that no label in it is, `external goto {a}`, goes on after the jump)
      finished (program) => !((level kind_of (program.at)) == `list`) ? program : go(gone_on(program), program.waiting ?? Array.new)
      leaving (program, answer) => {
        (program.caller.at = program.at) if !((program.at === None) || (program.at == afterwards))
        answer
      }
      // (what the host is given, `external <rule> <arguments…>`: each argument read where it is written, but a label (a jump's
      // first, a label's), its word, or, written in the brackets holes are written in, the value that reads as)
      given (program, name, argument, first) => (((name == `goto`) || (name == `label`)) && (argument === first)) ? label_of(program, argument.word) : ((name == `include`) ? takes(program){.key == ((argument.word.first == hole_opening) ? between(argument.word) : argument.word)}#.first : named_in(program, argument.word))
      label_of (program, word) => (word ~= BOOTSTRAPPER.CAPTURE.map{== \s}(String+)) ? [named_in(program, word)] : Place(word, global)
      same_label (one, other) => ((level kind_of (one)) == `list`) ? (((level kind_of (other)) == `list`) && (one.first == other.first)) : (one == other)
      afterwards := Place(`afterwards`, global)
      // (everything read, the tests kept for afterwards run, each in memory of its own (Design §21.4), what it kept for
      // afterwards run inside it; where the host runs them a step at a time, held for it)
      run_later (unused) => level run_kept (ran_later) (tested_later)
      tested_later (program) => level tested_here ((program.bound.first).value)
      ran_later (program) => {
        testing = program
        finished(go(gone_on(program), program.waiting ?? Array.new))
        testing = None
      }
      // (what is said, `external goto report`: what the hole took and where, each in turn; the host reads them)
      report := Place(`report`, global)
      reported := level reports
      testing := None
      said (program) => {
        reported.append([takes(program).first, bound_along(program)])
        program.at = None
        (testing.at = Place(`erred`, global)) if !(testing === None)
      }
      kinds := Array.new
      kinds_of (program) => kinds.first ?? known(named_in(program, `level kinds`))
      known (kind) => (kind.rules === None) ? kind : kinds.append(kind).first
      // (what a name is read as: without the space around it, unless it is only space)
      trimmed_or (text, otherwise) => (text.length == 0) ? otherwise : text
      // (a hole's value, read once in what applied it; a jump back in a body forgets what its holes answered, a loop asks again)
      held (hole, answer) => ((hole.answered === None) ? (hole.answered = [answer()]) : hole.answered).first
      forget (program) => (program.bound ?? Array.new).for((fh) => fh.answered = None)
      // (who reads a hole: the program reading it once it entered a block, else what applied the rule)
      reader (program, otherwise) => ((program.in === None) || !(program.in === program.this)) ? otherwise : program
      // (a hole's value in its body, `{x}` read there: read once, by who reads it)
      hole_value (hole, program, applier) => held(hole, () => named_for(program, reader(program, applier), hole.value))
      // (a hole read for code read in a value, `x.( … )`: read where it is written, what it defines the value's)
      named_for (program, by, text) => in_value(by, text, ((program.in?.of === None) || (by.in === program.in)) ? by.in?.of : program.in.of)
      in_value (program, text, held_value) => (held_value === None) ? named_in(program, text) : for_value(program, held_value, text)
      for_value (program, held_value, text) => {
        was := program.for_value
        program.for_value = held_value
        r := named_in(program, text)
        program.for_value = was
        r
      }
      named_in (program, text) => program.in.named_as(trimmed_or(level cw_trimmed (text), text), program)
      aside := Array.new
      among (list_of, one) => list_of{. === one}#.count > 0
      // (the bracket a hole opens with, and whether a text holds one)
      hole_opening := BOOTSTRAPPER.CAPTURE.first
      has_hole (text) => level holds_text (text) (hole_opening)
      // (what a definition is written with, the header's `=>`, outside every pair; the header's brackets a pair)
      separator := level separator_of (BOOTSTRAPPER.CAPTURES.text) (BOOTSTRAPPER.CAPTURE)
      defines (text) => level holds_outside (text) (separator)
      level closing (BOOTSTRAPPER.CAPTURE)
      // (what is painted, `external style`: each style, what it is shown on and what the holes took; the host reads them)
      painted := level paints
      // (the program the text is run by, and a text read after it as more of it, by the same program (the editor's file read
      // on what the entrypoint already read)
      top := Program(in: global, this: global)
      read_text (text) => {
        named_in(top, text)
        run_later(0)
      }
      level entry_read (read_text)
      sink := Array.new
      painted_with (how, program) => {
        sink.append(painted.append([how.first, how.last, bound_along(program)]).last)
        // (a rule keeps the styles it is shown as, read each time it is applied)
        ((how.last).styled_as = ((how.last).styled_as ?? Array.new).append(sink.last)) if !((how.last).written_head === None)
        how.last
      }
      // (a hole read in its body: its name shown as a parameter, where it is read)
      parameter_read (hole, program, answer) => {
        painted.append([`parameter`, [hole.key, program.input], [Array.new]])
        answer
      }
      // (what a value is shown as: the style it was given last, `made ^class`; else what is given)
      shown_of (style, otherwise) => (style === None) ? otherwise : style.first
      // (a rule by its head as written, `level rule`: the latest written so, here or around)
      rule_written (place, text) => ((place === None) || (text === None)) ? None : (place.rules.keys{.written_head == text}#.last ?? rule_written(place.in, text))
      bound_along (program) => (program === None) ? Array.new : [program.bound].joined(bound_along(program.caller))
      // (what the holes took where a program runs, the nearest first; where the rule is used whose holes took a head)
      takes (program) => (program === None) ? Array.new : (program.bound ?? Array.new).joined(takes(program.caller))
      // (a file, `external include <location>`: the text the host gave for the location as written where the include is, read
      // in turn there, as the code written in its place)
      included (program, hole) => file_read(holder(program, written_by(program, hole)), written_by(program, hole))
      file_read (program, hole) => ((program === None) || ((level file_named (level cw_trimmed (hole.value))) === None)) ? None : named_in(program.caller, level file_named (level cw_trimmed (hole.value)))
      // (the hole a hole's text names, `{x}`, further out, as far as one does)
      written_by (program, hole) => (((hole === None) || !((level cw_trimmed (hole.value)).first == hole_opening)) || (holder(program, hole) === None)) ? hole : (outer_hole(holder(program, hole), between(level cw_trimmed (hole.value))) ?? hole)
      outer_hole (program, name) => written_by(program.caller, takes(program.caller){.key == name}#.first)
      holder (program, hole) => ((hole === None) || (program === None)) ? None : (among(program.bound ?? Array.new, hole) ? program : holder(program.caller, hole))
      home_of (program, hole) => (holder(program, hole) === None) ? None : place_of(holder(program, hole).caller)
      // (where a program defines: in the value it reads code for, `x.( … )`, else where it is)
      place_of (program) => (program.for_value?.rules === None) ? program.in : program.for_value
      // (the nearest node that defines a name itself)
      defined_in (place, text) => (place === None) ? None : ((place.written_keys{text ~= .}#.count > 0) ? place : defined_in(place.in, text))
      // (what is between a text's first character and its last)
      between (text) => level cw_trimmed (level cw_inner (text))
      // (a body written in the brackets holes are written in is the code inside them, its lines as written: from right after
      // the bracket)
      inside_of (text) => {
        code := level cw_trimmed (text)
        ((code.first == hole_opening) && (level cw_enclosed (code))) ? level cw_span_of (level cw_inner (code)) (between(code)) : code
      }
      // (the compiler's parser: a grammar's rules read in a node of their own, a word what nothing else there reads)
      parse_node_of (grammar_text) => {
        g := Node(in: global)
        (gs: Statements(g) = grammar_text)(Program(in: g))
        p := Node()
        level moved_keys (g) (p)
        leaf := Node(in: global)
        (ls: Statements(leaf) = `{name_word} => external &`)(Program(in: leaf))
        p.split_key = leaf.rules.keys.last
        p
      }
      parser (grammar, program_text) => {
        grammar.parse_node = grammar.parse_node ?? parse_node_of(grammar.text)
        level curried_value (ps: Statements(grammar.parse_node) = program_text)
      }
      level set_parser (parser)
      // (read in turn; everything read, what was kept for afterwards)
      (Statements(global)(top), (\s | \n)[], (⊣ & ((end) => run_later(0)))(0))
    )
  )
) => { }
ex := (level input_part 0) as Expression
assert "!language   { }   {LHS} => {RHS}\n\n" as Expression -- .(
  .BOOTSTRAPPER.CAPTURE == `{ }`
  & .BOOTSTRAPPER.CAPTURES.LHS == `{LHS}`
  & .BOOTSTRAPPER.CAPTURES.RHS == `{RHS}`
)
// (its parts, each in turn)
assert {
  Ranged2 := class low: Decimal, "-", high: Decimal { }
  ranged2: Ranged2 = 3-8
  assert ranged2.high == 8  // ZZ1
  assert (`2-7` as Ranged2).high == 7  // ZZ2
  Ranged3 := class (low: Decimal, "-", high: Decimal) => { }
  ranged3: Ranged3 = 3-8
  assert ranged3.high == 8  // ZZ3
  Ranged4 := class (low: String+, "-", high: String+) => { }
  ranged4: Ranged4 = 3-8
  assert ranged4.high == "8"  // ZZ4
  Ranged5 := class (low: String+, `-`, high: String+) => { }
  ranged5: Ranged5 = 3-8
  assert ranged5.high == `8`  // ZZ5
  assert (`3-8` as Ranged5).high == `8`  // ZZ6
  Ranged6 := class (low: String+, \s, high: String+) => { }
  assert (`3 8` as Ranged6).high == `8`  // ZZ7
}
assert `{ }` is (String+, \s, String+)  // EX1 a hole's brackets around a space are not a capture
assert {
  Headed := class (head: `!language`, \s[]+, rest: String) => { }
  assert (`!language  x` as Headed).rest == `x`  // EX2 a text read as a structure does not give its last field what follows the space
}
assert {
  Captured := class (left: String+, \s, right: String+) => { }
  assert (`{ }` as Captured).left == `{`  // EX3 a text read as a structure does not give its first field the text before the space
}
assert {
  Inner := class (left: String+, \s, right: String+) => { }
  Outer := class (inner: Inner, `;`) => { }
  assert (`{ };` as Outer).inner.left == `{`  // EX4 a field of a structure is not read as its own structure
}
assert {
  Nested := class (inner: (left: String+, \s, right: String+), `;`) => { }
  assert (`{ };` as Nested).inner.right == `}`  // EX5 a field written as a structure is not read as one
}
assert {
  Spanned := class (spanned: (String+, \s, String+), `;`) => { }
  assert (`{ };` as Spanned).spanned == `{ }`  // EX6 a field written as positions does not take their span
}
assert `{LHS}` is `{ }`.map{== \s}(`LHS`)  // EX7 a text's space mapped to LHS does not read {LHS}
assert !(`{ }` is `{ }`.map{== \s}(`LHS`))  // EX9 a text's space mapped to LHS still reads the space
assert {
  Dependent := class (open: String, \s, close: open) => { }
  assert (`a a` as Dependent).close == `a`  // EX8 a field's type does not see a field before it
}
assert {
  Scoped := class (
    (
      statements: (
        Seen := 46
        Node := class (marked?: Node) => { mark := 1 }
        Inner := class (in?: Inner) => {
          rules := { got := (x) => Seen }
          made => Node()
        }
        got_seen := Inner().rules.got(0)
        made_mark := Inner().made.mark
        String
      )
    )
  ) => { }
  scoped := "x" as Scoped
  assert (external member (scoped) (`got_seen`)) == 46  // EX10 a closure in a class written in a header's statements does not see the header's names
  assert (external member (scoped) (`made_mark`)) == 1  // EX11 a class's `Node` written in a header's statements is the language's
}
