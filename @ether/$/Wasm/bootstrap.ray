  external emit 0x7F
  a
  external emit 0x05
  b
  external emit 0x0B
}
// Memory: a word, a byte
load {a} => {
  a
  external emit 0x28
  external emit 2
  external emit 0
}
load8 {a} => {
  a
  external emit 0x2D
  external emit 0
  external emit 0
}
{a} <- {v} => {
  a
  v
  external emit 0x36
  external emit 2
  external emit 0
}
{a} <-8 {v} => {
  a
  v
  external emit 0x3A
  external emit 0
