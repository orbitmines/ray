!language   { }   {LHS} => {RHS}

{lhs} => {rhs} => {
  {lhs} => {rhs}
}
// {comment} => { }
// The first statement is the rule creator: a rule written `{head} => {body}` is defined where it is read. Its body is what
// `body` took (code, read once, with the rules before it: a rule never reads itself); its head is read with the rules there:
// what is in a hole is code too (`{x: T}` is the hole `x` with `{x}: {type}` read in it, `{x ^style}` with `{x} ^{style}`, and
// text a hole reads as, `{\`=>\`}`, is that text). A hole written against text takes no space (`{x}: {type}`: `:` binds the
// nearest), never ends inside a word, and none ends inside a pair: the brackets, and what a head that is one hole between two
// characters makes a pair (`({grouped})`). Of the rules reading all of a statement, a definition first (`=>` outside
// brackets), then one led by text, then the latest: declaration order is precedence, what is declared last binds loosest.
// Then a comment: nothing. (One after a statement, below.)

// A group: what is inside it, its value (a block in it, `({ … })`, a node).
({grouped}) => grouped
// `.`: what is read in, `this` (in a method, what it is read on); `&`, the application it is written in, read as a node: what
// its holes took (as text), its `caller`, and its `this`. A member, `x.name`: the name read in x (`x.name(y)`: the name, then
// `(y)` read on it where it is written); `x.( … )`, the code read in x. (In a method, a node made sees what it is read on
// first, then where it was written: `.name` is that one's.)
. => (external &).this
.{member} => {member}
.({member}) => {member}
this => .
// Text as written: between backticks.
`{text}` => (external &).text
// Code read in a value (`x &+= { … }` defines in x), the value.
// A value made of another too, `X &+= Y`: Y one of its components (§3.2: its rules seen after X's own, the last added first).
{on} &+= {value} => {
  (on).(external . {value})
  on
}
{on} &+= {`{`}{code}{`}`} => {
  (on).({code})
  on
}
// A name given a value: the value read, then the name a rule answering it, here. A member given one, given in what it is on.
{name} = {value} => {
  value
  {name} => value
}
// A name with a type: its type kept with it (in a head, `{x: T}`: the hole takes what T's own rules read whole).
{x}: {type} => {
  x.type = type
  x
}
// `x ^style`: x, shown in that style (highlighting only). A head written with a style after it: its text shown so.
{x} ^{style} => {
  x.style = style
  x
}
{lhs} ^{style} {`=>`} {rhs} => ({lhs} => {rhs}).style = style
`{text}` ^string => (external &).text
({grouped}) ^punctuation => grouped
{statement} // {comment} ^comment => {statement}
// {comment} ^comment => { }

// A block: a node, its code read in it (`.` it). (A rule's body written in brackets is code: one that makes a node has the
// block as its statement, `x => { { … } }`.)
{`{`}{code}{`}`} ^punctuation => {
  external .
  {code}
  .
}
// A name declared here, given a value. (`x: T = v`: the value checked against T first, the name keeping its type.)
{name} := {value} ^punctuation => {
  value
  {name} => value
}
// A name: a word (a head that is one hole takes one). A member's is one: `x.f(y)` is `f` read in x, then `(y)` read on it,
// with x as `this`.
Name := {
  // (the word as written: what it names need not be there, `circle (radius: Number)`)
  {word} => `{word}`
}
{name}: {type} = {value} ^operator => {
  (value) checked (type)
  {name} := value
  // (nothing holds no member: a default of nothing keeps no type, `x: T = None`)
  ({name}.type = type) unless value === None
}
// An optional one, `x?: T`: nothing unless it is given (`x: T = None`).
{name}?: {type} ^operator => {name}: {type} = None
assert {
  Linked := class (in?: Linked) => { }
  outer := Linked()
  assert Linked(in: outer).in === outer  // OP1 an optional field given is not what it was given
  assert !(outer.in)  // OP2 an optional field not given is something
  Defaulted := class (up: Defaulted = None) => { }
  assert Defaulted().up === None  // OP3 a typed field defaulting to nothing is something (a member of None set; or made with nothing, given `declared`)
}

// Text: what is written between quotes, each escape in it (`\e`) what it stands for (`.unescaped`, the library's).
"{text}" ^string => ((external &).text).unescaped
unescaped => .
assert `ab` as String == "ab"  // S158 written text is not read as a string

// Diagnostics: said where they are about (the host's label `report`, what the first hole took), and a value.
ERROR {message} ^error => {
  external goto report
  {
    message := `{message}`
    fatal := false
  }
}
FATAL {message} ^fatal => {
  external goto report
  {
    message := `{message}`
    fatal := true
  }
}
WARN {message} ^warn => external goto report
INFO {message} ^info => external goto report
TODO {message} ^debug => None
ensure {condition} => {
  unless (condition) {
    ERROR assertion failed
  }
  condition
}
// A test, `assert c`: checked after everything is read (the host's label `afterwards`), where it is written; painted as what
// it found (`untested` until then): `passed`, `failed` (also when anything was said while it ran: a name nothing defines).
assert {condition} ^untested => {
  external goto afterwards
  (external &) ^((ensure {condition}) ? `passed` : `failed`)
  external goto tested
  // (one that said something, an error in it: failed; the host's label `erred`)
  external label erred
  (external &) ^`failed`
  external label tested
}

// Node: the outermost node (`.` here). Every node sees its rules, so they are what any value read on reads: its methods.
Node := .
global := Node
// (what a declaration answers, `x: T`: nothing but that it declared)
declared := { }
assert {
  declared := 3 ; declared += 1
  assert declared == 4  // CF20 a declaration and an assignment on one line did not both run
}
// (what a method's body declares is the value's, `.`; in a block of its own, `{ … }`, the block's)
assert {
  Probed := class {
    local_of_probe := false
    probe_local => {
      {
        local_of_probe := true
      }
      true
    }
  }
  probed := Probed()
  probed.probe_local
  probed.local_of_probe === false
}  // LK1 a name declared in a block in a method's body is declared on what the method is read on
assert {
  {a} %+ {b} => true
  assert true %+ true  // GR1 a rule written at the top reads at the top
  inside => (
    {a} %+ {b} => false
    true %+ true
  )
  assert !(inside)  // GR2 a rule written in a body overrides the reading in that body
  assert true %+ true  // GR3 a rule written in a body does not change the reading after it
  beside => true %+ true
  assert beside  // GR4 a rule written in one body is not seen in a sibling body
  {a} %++ {b} => false
  {a} %+++ {b} => true
  assert !(true %++ true)  // GR5 the longest declared word wins: %++ is not read as %+ followed by +
  assert true %+++ true  // GR6 the longest declared word wins: %+++ is not read as %++ followed by +
  assert true %+ true  // GR7 a longer word declared later does not take over the shorter one
}
// A field named by its pattern as written, `{*}: T`: kept under that text, not a rule (a head that is one hole would read
// everything). A pattern is a body written.
Pattern := {
  {written} => written
}


// What a value answers to `?`: anything is true, but `None` and `false`.
? {yes} : {no} ^operator => yes
None := {
  ? {yes} : {no} => no
  value => None
  next => None
  // (a member of None is None: chains need no `?.`)
  .{member} => None
  assert true.next == false  // BOR1 true.next should be false
  assert false.next == true  // BOR2 false.next should be true
  assert true.next.next == true  // BOR3 true.next.next should be true
  assert false.next.next == false  // BOR4 false.next.next should be false
}
// (enumerations and classes: read where None's rules are not)
assert {
  Colour := enum red | green | blue
  assert Colour.red  // EM1 the member an enum is written with is not there
  assert Colour.blue  // EM2 the last member is not there
  assert Colour.red == Colour.red  // EM4 a member is not itself
  assert !(Colour.red == Colour.blue)  // EM5 two members of one enum are the same
  assert Colour.red is Colour  // EM6 a member is not one of its enum
  assert Colour#.count == 3  // EM7 an enum of three has other than three members
  assert Colour# == [Colour.red, Colour.green, Colour.blue]  // EM14 an enum's members are not its three, in order
  assert Colour.red.next == Colour.green  // EM25 the member after red is not green
  Size := enum small | large
  assert !(Size.small is Colour)  // EM15 a member is one of another enum
}
assert {
  R := class { }
  S := class: R { s => S(next: this) }
  assert S().s.s.s  // C5 a successor chain through class: Parent broke
  assert S.components.hierarchy.first  // C6 class: Parent did not add a class component
  assert S.super  // C7 super is missing
}
assert {
  E := enum p | q | r
  assert E#.first == E.p  // C9 the first enum member is not the first written
  assert E#.first.next.next == E.r  // C10 enum members are not chained forward
  assert E#.last.previous.previous == E.p  // C11 enum members are not chained backward
  assert E#.count == 3  // C12 an enum of three has other than three members
  assert E#.first.is_initial  // C13 the members are not an Iterable of Rays
  assert E#.last == E.r  // C14 Iterable.last did not reach the last member
}
assert (true |+ "A").next == false | "B"  // SP2 |+ does not answer with either component
assert !(None)  // BO27 nothing is there
// Negations on nothing answer true (T1.8)
assert None != 1  // NGN1 nothing is said to be one
assert None !~= "a"  // NGN2 nothing is said to match
false := {
  ? {yes} : {no} => no
  // (the two of them a Ray, each the other's next)
  next => true
  previous => true
}
assert true == true  // BO23 true is not itself
assert !(true == false)  // BO24 true is false
assert true  // BO25 true is not there
assert !(false)  // BO26 false holds as a condition
true := {
  next => false
  previous => false
}

// `!x`: false when x is anything but `None` and `false`.
!{x} ^operator => x ? false : true
// (`!!x`, written together: x as true or false)
!!{x} ^operator => x ? true : false
assert !(!true)  // BB4 not(true) should be false
assert !false  // BB5 not(false) should be true
assert !!true  // BO21 not not true is not true
assert !(!!false)  // BO22 not not false is true
assert !None  // BO28 asking whether nothing is there answers nothing
{a} || {b} ^operator => a ? a : b
assert true || false  // BB8 or(true,false) should be true
assert !(false || false)  // BB9 or(false,false) should be false
assert false || true  // BO4 or(false,true) should be true
assert true || true  // BO5 or(true,true) should be true
assert 0 || true  // N97 zero or true is not true
assert !(0 || false)  // N98 zero or false is true
assert {
  cleared_vertex := [1, 2].entry
  kept_vertex := cleared_vertex
  cleared_vertex = None
  assert !(kept_vertex.initial || kept_vertex.terminal)  // NGN4 a vertex set to nothing keeps its boundaries
}
{a} && {b} ^operator => a ? b : a
assert true && true  // BB6 and(true,true) should be true
assert !(true && false)  // BB7 and(true,false) should be false
assert !(false && true)  // BO2 and(false,true) should be false
assert !(false && false)  // BO3 and(false,false) should be false
assert true && !false  // BB16 true && !false should be true
assert 1 && true  // N95 one and true is not true
assert !(0 && true)  // N96 zero and true is true
assert None != 5 && !(None != None)  // NGN3 a negation on nothing does not answer true against something, or holds against nothing
assert (choose 1 ("A" | "B")) is ("A" | "B") && (choose 1 ("A" | "B"))#.count == 1  // HS11 choosing a counted type does not resolve to one of its possibilities
// `a & b` of two that are true or false: both; of anything else, what its own `&` is (a Node's, their conjunction).
conjoined := None
{a} & {b} ^operator => (((a) === true) || ((a) === false)) ? ((a) && (b)) : ((a) conjoined_with (b))
// (held at once: each of them, `1 & 2 & 3` three)
{a} conjoined_with {b} ^keyword => ({
  conjoined := (((a).conjoined) ? (a).conjoined.listed() : Ray.new.append(a)).joined(((b).conjoined) ? (b).conjoined : Ray.new.append(b))
  contains (x) => conjoined.some((y) => y == x)
})
assert (true & true)  // BB17 true and true is not true
assert !(true & false)  // BB18 true and false is true
assert (1 & 2).contains(2)  // TY68 what holds both does not hold the second
assert (1 & 2 & 3).conjoined.count == 3  // TY69 three held at once are not three
{a} ?? {b} ^operator => (a === None) ? b : a
assert None ?? true  // BN1 ?? does not fall back on nothing
assert !(false ?? true)  // BN2 ?? replaces a value that is there
// The same value: gone to as a label (a label written as a value is gone to by that value); nothing there, another.
{a} === {b} ^operator => {
  external goto {a}
  external goto other
  external label {b}
  true
  external goto same
  external label other
  false
  external label same
}
{a} !== {b} ^operator => (a === b) ? false : true
// A choice, `c ? a : b`: the condition all before the `?`.
{condition} ? {yes} : {no} ^operator => (condition) ? yes : no
assert true ? true : false  // BT3 c ? a : b does not take a when c holds
assert !(false ? true : false)  // BT4 c ? a : b takes a when c does not hold
assert false ? false : true  // BT5 c ? a : b does not take b for a named c

// A branch: the block taken read where the branch is (labels named apart from a loop's, which `break` and `continue` go to
// through it); not taken, what follows its block (`else { … }`, `elsif c { … } …`: code, read there), else None. (A block is
// written in brackets, so a condition is all that is before it: `if x > 3 { … }`.)
if {condition} {`{`}{taken}{`}`} ^keyword => {
  {condition} ? (external goto taken) : (external goto passed)
  external label taken
  {taken}
  external goto branched
  external label passed
  None
  external label branched
}
if {condition} {`{`}{taken}{`}`} {chain} ^keyword => {
  {condition} ? (external goto taken) : (external goto passed)
  external label taken
  {taken}
  external goto branched
  external label passed
  {chain}
  external label branched
}
else {`{`}{otherwise}{`}`} ^keyword => {otherwise}
elsif {condition} {`{`}{taken}{`}`} ^keyword => if {condition} { {taken} }
elsif {condition} {`{`}{taken}{`}`} {chain} ^keyword => if {condition} { {taken} } {chain}
unless {condition} {`{`}{taken}{`}`} ^keyword => if !(condition) { {taken} }
unless {condition} {`{`}{taken}{`}`} {chain} ^keyword => if !(condition) { {taken} } {chain}
assert !((if 0 { "taken" }))  // IC4 an if whose block holds no cases is read as cases
assert !((if false { true }))  // CC6 a bare if with a false predicate is not None-like
assert (unless false { true })  // CC7 unless did not fire
assert (unless true { 1 } else { 2 }) == 2  // CF9 unless has no other side
assert (if false { true } elsif true { true } else { false })  // CC3 elsif did not fire
assert (if false { true } elsif false { true } else { true })  // CC4 else after elsif did not fire
assert (if true { true } else { false })  // CC1 if-true did not take the then branch
assert !((if false { 1 } else { None }))  // CC12 an if whose taken branch is None is present
assert (if true { 1 } else { None })  // CC13 an if whose taken branch is one is absent
assert !((if false { true } else { false }))  // CC2 if-false took the then branch
assert (if true { true } elsif true { false } else { false })  // CC5 a later branch overrode the first
// CF5 a branch does not answer its last statement
assert (if true {
  1
  2
  3
} else { None }) == 3
assert (if true { if false { 1 } else { 2 } } else { 3 }) == 2  // CF6 a branch inside a branch is not read there
assert (if 1 { true } else { false })  // CF7 a number that is there does not hold
assert !((if None { true } else { false }))  // CF8 nothing holds

// Loops: `break` goes to the loop's end, `continue` to its start.
while {condition} {`{`}{body}{`}`} ^keyword => {
  external label again
  {condition} ? (external goto looping) : (external goto done)
  external label looping
  {body}
  external goto again
  external label done
}
assert {
  flag := true
  while flag { flag = false }
  assert !(flag)  // CC8 while did not run its body
}
assert {
  ran := false
  while false { ran = true }
  assert !(ran)  // CC9 while ran with a false predicate
}
loop {`{`}{body}{`}`} ^keyword => while true { {body} }
{body} while {condition} ^keyword => while {condition} { {body} }
do {`{`}{body}{`}`} while {condition} ^keyword => {
  {body}
  while {condition} { {body} }
}
assert {
  seen := false
  do { seen = true } while false
  assert seen  // CC10 do-while did not run its body at least once
}
assert {
  stop := true
  do { stop = false } while stop
  assert !(stop)  // CC11 do-while did not stop
}
assert {
  asked := 0
  do { asked += 1 } while false
  assert asked == 1  // CF12 do ran other than once when it never holds
}
break ^keyword => external goto done
assert {
  stopped := 0
  while true {
    stopped = stopped + 1
    break if stopped == 3
  }
  assert stopped == 3  // RC2 break does not leave the loop
}
continue ^keyword => external goto again
assert {
  skipped := 0
  counted := 0
  while counted < 5 {
    counted = counted + 1
    continue if counted == 2
    skipped = skipped + 1
  }
  assert skipped == 4  // RC3 continue does not go on with the next round
}
// Leaving a call: `return v` (the call answers v), `return`; the call again from its start, `recur(arguments)`.
return {value} ^keyword => {
  value
  external goto returned
}
return ^keyword => external goto returned
recur({again}) ^keyword => return this({again})
recur ^keyword => external goto recurring
assert {
  countdown (n) => (
    return n if n == 0
    recur(n - 1)
  )
  assert countdown(5) == 0  // RC1 recur(args) does not re-enter the method
}

// A closure: a rule read where a value is wanted, a node holding it; read on (`f(5)`), its right side run in a new node in it,
// its parameters taking the arguments (code, read where they are written: `f(x: 5)` declares its `x`, answering `declared`).
// (A head led by `{this}` is a method: read only on a value, what follows it; so `(…)` in the body is not a call of itself.)
// It ends at `returned` (`return v` goes there), and begins again at `recurring` (`recur(…)` gives its parameters these first).
// (Its parameters take the arguments' values: a type a parameter is given, `x: T`, is checked on the value, not read in the
// text.)
({parameters}) {`=>`} {body} ^punctuation => {
  external .
  {this}({arguments}) => {
    external .
    ({{parameters}}) taking {arguments}
    external label recurring
    {{body}}
    external label returned
  }
  // (called on what follows it, without brackets: `double 4`, `6 == 6` (`==` a method of 6), `"0".."9"`)
  {this}{arguments} => {
    external .
    ({{parameters}}) taking {arguments}
    external label recurring
    {{body}}
    external label returned
  }
  // (called with nothing: its parameters as written, their defaults given)
  {this}() => {
    external .
    ({{parameters}})
    external label recurring
    {{body}}
    external label returned
  }
  .
}
() {`=>`} {body} ^punctuation => {
  external .
  {this}() => {
    external .
    external label recurring
    {{body}}
    external label returned
  }
  .
}
assert {
  Hugged := { }
  Hugged &+= {
    .. (last) => false
  }
  assert !(Hugged..Hugged)  // CL19 an operator method does not take what is written right after it
  assert !(Hugged ..Hugged)  // CL20 an operator method after a space does not take what is written right after it
  assert !(Hugged.. Hugged)  // CL21 an operator method does not take what follows it after a space
  given_nothing := (x) => false
  assert !(given_nothing Hugged)  // CL22 a closure is not called on what follows it without brackets (`f x`)
}
// (called with nothing: with nothing given, each parameter its default)
{this}() ^punctuation => this(declared)
// A method: `name (parameters) =>` (a space before them) gives the name a closure, as `name := (parameters) =>` does (so its locals are its own);
// `x.name (…) =>` is a member.
{name} := ({parameters}) {`=>`} {body} ^function => {name} := (({parameters}) => {body})
{on}.{name} := ({parameters}) {`=>`} {body} ^function => {on}.{name} := (({parameters}) => {body})
{name} := () {`=>`} {body} ^function => {name} := (() => {body})
{on}.{name} := () {`=>`} {body} ^function => {on}.{name} := (() => {body})
// Partial arguments: `f<a: 5>` is f with those given first.
{function}<{given}> ^punctuation => { (also) => {function}({given}, also) }

// A call's parameters taking its arguments, by composition: the parameters run as written, where the call runs (`a` names a
// place, `b = 0` gives it its value first, `x: T` its type), `,` composing them; each then takes the argument in its place
// (one that only declared, `declared`, gives none: what it had stays).
// (rules, not closures: a closure's parameters are given by these)
// (their holes named apart from the call's, whose `parameters` and `arguments` they are given)
({written_parameters}) taking {passed} ^keyword => {
  (.) given_names (passed)
  // (given nothing, `declared`: the parameters as written, their defaults given (none, what they had))
  if passed === declared { ({written_parameters}) } else { ({written_parameters}) := passed }
}
// (a closure written in a rule's body reads the rule's holes, where they are read: in its body, and in code read on its
// parameter (its body copied into the method that calls it: each copy keeps the names of where it was written))
{x} reads_closed {y} => {
  closed (z) => {y}
  closed(x)
}
assert true reads_closed (false === false)  // CL1 a closure in a rule's body does not read the rule's hole
{x} reads_closed_on {y} => {
  closed (z) => z.({y})
  closed(x)
}
assert true reads_closed_on (. === true)  // CL2 a closure in a rule's body reads the rule's hole in code read on its parameter
// A closure calls itself (recursion), directly or through a local
recurring_flip (n) => n ? recurring_flip(false) : true
assert recurring_flip(true)  // RC1 a call inside itself does not take its own argument
recurring_local (n) => {
  again := recurring_local
  n ? again(false) : true
}
assert recurring_local(true)  // RV2 a call of itself through a local does not take its own argument
shadowed_name := false
takes_shadowed (shadowed_name) => shadowed_name
shadowed_taken := takes_shadowed(true)
assert shadowed_taken === true  // GN1 a parameter named as a visible name does not take its value
assert shadowed_name === false  // GN2 a parameter named as a visible name gave that one its value
// (what is given by name, `f(x: 5)`: the callee's `x`, declared in what is called; the rest each in its place, in order)
{on} given_names {passed} ^keyword => {
  {
    named_on := on
    named_passed := passed
    if ((named_passed).listing === true) && ((named_passed).spread === true) {
      named_at := (named_passed).head
      while named_at {
        if (named_at.value).named_argument === true { (named_on) declares ((named_at.value).name) as ((named_at.value).value) }
        named_at = named_at.next
      }
    } else {
      if (named_passed).named_argument === true { (named_on) declares ((named_passed).name) as ((named_passed).value) }
    }
  }
  true
}
{on} declares {key} as {value} ^keyword => (on) declares_key key as value
// (its key a hole of another rule: what that answers, a text, the name)
{on} declares_key {key} as {value} ^keyword => (on).{key} := value
{places} takes {taken} ^keyword => {
  {
    places_were := places
    taken_was := taken
    ((places_were).listing === true) ? ((places_were) each takes (taken_was)) : ((places_were) alone takes (taken_was))
  }
  true
}
{place} alone takes {taken} ^keyword => {
  {
    place_was := place
    alone_taken := taken
    unless (alone_taken === declared) || ((alone_taken).named_argument === true) {
      (place) := (alone_taken) checked ((place_was).type)
    }
  }
  true
}
// (each of a list of places the value in its place of what is given: a list a `,` made, else that one value)
{places} each takes {taken} ^keyword => {
  {
    at := places.head
    each_taken := taken
    taken_at := (((each_taken).listing === true) && ((each_taken).spread === true)) ? (each_taken).head : Ray.new.append(each_taken).head
    while at {
      while taken_at && ((taken_at.value).named_argument === true) { taken_at = taken_at.next }
      // (a text written among the places, `class a: T, ".", b: U`: no field, it takes nothing)
      unless (at.value).textual === true {
        (at.value) alone takes (taken_at ? taken_at.value : declared)
        taken_at = taken_at ? taken_at.next : None
      }
      at = at.next
    }
  }
  true
}
{name} := lazily {default} ^keyword => {
  {name} => {
    kept := ({default})
    {name} = kept
    kept
  }
}

// A section given to a method, `xs.map(.value)`: the function of what it misses.
{method}(.{section}) ^punctuation => .{method}((it) => it.{section})
// `code**`: what is written, as a program.
{code}** ^operator => Program(code: {code})

// A list written: `[]` an empty one, `[a, b]` both, `[a]` one; `T[]`, what holds Ts one after another.
[] ^punctuation => Ray.new
[{inside}] ^punctuation => (inside, Ray.new).gathered
{element}[] ^punctuation => (() => {
  made := ({
    narrows := Node
    holds (it) => it.every((item) => item is element)
  }) &+ { }
  made &+= {
    {value: element} => Ray.new.append(value)
    {first: element}{rest: made} => Ray.new.append(first).joined(rest)
  }
  made
})()
// `x[k]`: a member (a key that is text), else what x holds under k.
{on}[{key}] ^punctuation => (key is String) ? (on).{key} : (on).held(key)
assert {
  xs := [0, 0, 0]
  xs[1] = 5
  assert xs[1] == 5  // IX1 placing a value in a list at a number leaves the list as it was
}
{on}[{key}] := {value} ^punctuation => (key is String) ? ((on).{key} := value) : (on).holding(key, value)
assert {
  Keyed := { }
  Keyed["inner"] := true
  assert Keyed.inner  // IX2 x["k"] := v does not declare k in x (`(on).{key}` in a body was read as a narrowing of `(on).`)
  named := "other"
  Keyed[named] := true
  assert Keyed.other  // IX3 x[name] := v, name holding a text, does not declare that text in x
}
// A record: names given values in parentheses, a node holding them.
({name}: {value}) ^operator => {
  {
    {name} := {value}
  }
}
// A value that is not a list: its first is itself, nothing after it.
listing := false
first => .
rest => []
assert {
  here := 0
  there := 0
  here = 1 ; there = 2
  assert here == 1  // CF18 the first of two assignments on one line did not run
  assert there == 2  // CF19 the second of two assignments on one line did not run
}

// The rest read with `.` what is before it: `x -- .y` is `x.y`; `x ~~ …` the same, answering x.
{value} -- {rest} ^operator => value ~~ {
  {rest}
}
{value} ~~ {rest} ^operator => {
  value &+= {
    {rest}
  }
  value
}
assert (1, 2 -- .map(+1)) == (2, 3)  // DD1 -- does not continue on the whole line before it
assert (5 -- . + 1) == 6  // DD2 -- does not give what it continues with as .
assert (5 -- . + 1 if . > 3) == 6  // DD3 -- with a condition that holds does not continue
assert (5 -- . + 1 if . > 9) == 5  // DD4 -- with a condition that fails does not keep what is before it
assert {
  continued := 5
    -- . * 2
    -- . + 1 if . > 100
  assert continued == 10  // DD5 -- on the next line does not continue the line above
}
assert (1, 2 ~~ .map(+1)) == (1, 2)  // DD6 ~~ does not answer the whole line before it
{on} reading {code} ^keyword => on &+= {
  {code}
}
{on} with {code} ^keyword => on reading {code}
// `with` code: what it sets, set for where it is read (the caller) and what runs from there, gone when that ends.
with {code} ^keyword => (external &).caller reading {code}
assume {code} ^keyword => (external &).caller reading {code}
// Guards: `x if c`, `x unless c` (not taken: None).
{guarded} if {condition} ^keyword => if {condition} { {guarded} }
{guarded} unless {condition} ^keyword => unless {condition} { {guarded} }

// A superposition: one of these values (`a | b`), and `x?`: `x` or None.
{a} | {b} ^operator => ({
  superposes := true
  // (one superposed with a superposition: its components, each one; `1 | 2 | 3` three)
  components := (((a).superposes === true) ? (a).components.listed() : Ray.new.append(a)).joined(((b).superposes === true) ? (b).components : Ray.new.append(b))
}) &+ {
  {value: a} => value
  {value: b} => value
}
assert (1 | +2 | +3) == (1 | 3 | 6)  // CL2 a section after | is not applied to the value before it
assert (1 | 2 | 3)#.count == 3  // HS2 a superposition of three does not have three possible values
assert (1 | 2 | 3).components.count == 3  // SP13 a superposition of three holds a superposition of two (its components not each one)
assert #(1 | 2) == (1 | 2)#  // HS6 #x is not x#
assert "A" is 1 ("A" | "B")  // HS7 one of two possibilities is not a counted type of one
assert !(("A" | "B") is 1 ("A" | "B"))  // HS8 both possibilities are a counted type of one
assert ("A" | "B") is 50% ("A" | "B" | "C" | "D")  // HS9 two of four possibilities are not half of them
assert "B" is 0.5 ("A" | "B")  // HS10 half of two possibilities is not one
assert (1 | 2) + 1 == 2 | 3  // SP4 an operator does not carry through |
assert 10 - (1 | 2) == 9 | 8  // SP5 a superposition on the right does not carry
// A superposed element makes branches: one path through each value (U1)
assert ([1, "2a" | "2b", 3]).(
  .#.count == 2  // SP8 a superposed element in a list does not make two paths
  & .#.some(== [1, "2b", 3])  // SP9 a path through the second value is missing
)
assert {
  chosen := 1 | 2
  result := chosen + 10
  assert result{chosen == 2} == 12  // SP12 fixing a source does not refine what depends on it
}
{x}? ^operator => None | x
// What a value can be, `x#` (`#x`): an enumeration's members, a superposition's components, else itself alone.
possible => (.members) ? .members : (((.superposes) === true) ? .components : [.])
# => .possible
#({value}) ^punctuation => (value).possible

// A narrowing, `T{constraint}`: a T the constraint (read with `.` the value) holds for.
{narrowed}{`{`}{constraint}{`}`} ^punctuation => Narrowing &+ {
  narrows := narrowed
  holds (it) => it.({constraint})
  {value: narrowed} => (holds(value) === true) ? value : (ERROR not one of what it narrows to)
}
// `x as T`: x, when it is a T; else what T makes of it (`T.from(x)`; none, by default).
as {type} ^keyword => (. is type) ? . : type.from(.)
from (x) => None
// (a conversion written in the class converted to, `(x: S) as (=== T) => …`: what T makes of an S)
({parameter}) as (=== {type}) {`=>`} {body} => ({type}).from := (({parameter}) => {body})
// (`x as *`: what x converts to, each conversion its types define, as a list of them, each run only when asked (§7.5): none
// by default; each conversion written adds itself to those its class had (its body reads the `as *` before it))
as * => []
converted_by (conversion) => .({conversion}())
// (what nothing led by text reads on a value: read on what it converts to, the nearest conversion (§7.5); none, on itself,
// where nothing reads it, said there)
// (no name declared in it: what a method's body declares is declared in what it is read on, here every value)
{this}{rest} => (((this as *).first) ? this.converted_by((this as *).first) : this){rest}
as (=== {type}) {`=>`} {body} => {
  as {type} => {body}
  as {`*`} => ((this as *), (() => {body}))
}
// Modifiers on an operator: `compounds op …` (and `x op= y`, `x = x op y`); `chainable op …` (and `a op b op c`).
compounds {operator} {rest} {`=>`} {body} => {
  {operator} {rest} => {body}
  {name} {operator}= {value} => {name} = {name} {operator} (value)
}
// (`right-to-left op …`: what follows it, all of it, its right side (`2 ^ 3 ^ 2` is `2 ^ (3 ^ 2)`): the operator as it is)
right-to-left {operator} {rest} {`=>`} {body} => {
  {operator} {rest} => {body}
}
chainable {operator} {rest} {`=>`} {body} => {
  {operator} {rest} => {body}
  {operator} {middle} {operator} {last} => (. {operator} (middle)) && ((middle) {operator} {last})
}
// (two holes written after a value in a body, `(l) {operator} {r}`: read as one, the operator applied; RB1)
{l} applying {operator} to {r} => (l) {operator} {r}
assert false applying === to false  // RB1 a body's `(l) {operator} {r}` read as `{r}` alone
// Names written together, `a | b => …`: each the same rule (`a | b | c`, the rest of them again; `a | b (x) => …`, each taking
// what follows the last; `a | b := v`, the first given it, the others reading it). Only names: `{a} | {b} => …` is not.
{name: Name} | {other} {`=>`} {body} => {
  {name} => {body}
  {other} => {body}
}
{name: Name} | {other: Name}{ }({parameters}) {`=>`} {body} => {
  {name} ({parameters}) => {body}
  {other} ({parameters}) => {body}
}
{name: Name} | {other} := {value} => {
  {name} := {value}
  {other} => {name}
}
// NA1 one of two names written together does not read the rule
assert {
  Aliased := class {
    nonzero | holds => 5
    first | second | third => 6
    twice | double (x) => x * 2
    O | optimizations := 7
  }
  assert Aliased().nonzero == 5 & Aliased().holds == 5
  assert Aliased().first == 6 & Aliased().third == 6  // NA2 the third of three names does not read the rule
  assert Aliased().twice(4) == 8 & Aliased().double(5) == 10  // NA3 names taking what follows them do not take it
  assert Aliased().optimizations == 7  // NA4 a value named twice is not read by its second name
}

// A node made of a value (it sees what the value sees, the value's rules first): `x &+ { … }`, the code read in it.
{on} &+ {code} ^operator => ((on).interior) &+= {
  {code}
}
interior => {
  external .
  .
}
extended () => .interior

// A class: what it holds a node made of its parent (`class: P`, else Node), its block read in it; the class a node made of
// that, its own rules what reads as it (its header: `class (x: T) => …` reads what T reads, a class of it; one with no header
// reads what the classes made of it read); with fields (`class (x, y) => { … }`), its instances made by calling it, each a
// node made of it, its fields given the arguments, `of` it. (Its block is read once, for the class: an instance has what it
// declares through the class it is made of.)
