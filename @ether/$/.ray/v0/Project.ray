// A project: one name per project, dependency lines, lookup through dependencies to @ether (P8.8, F-C8).
Project := class: Location = name: String, parent: Project?, children: Location[] = [], host: *?, dependencies: Dependency[] = [], written_against: Version?, carried: *[] = [], readings: Reading[] = [], overrides: *[] = [], definitions: Definition[] = [] {
  static Form := enum ether | relative | upward | absolute | user | remote

  // `@ether/UI`, `@./sibling %3`, `@../up`, `@/absolute`, `@user`, `@https://…`
  static Dependency := class ("@", location: (!" ")[], (" ", version: Version)?) => {
    form: Form => location ~= ⊢"ether/" ? ether
      : location ~= ⊢"./" ? relative
      : location ~= ⊢"../" ? upward
      : location ~= ⊢"/" ? absolute
      : location ~= "://" ? remote
      : user
    // The @ether userspace is filled by the language, which bundles its own .ray files; what it does not bundle comes over the network from @ether.
    project: Project? => form.match
      ether => Language.ray.bundled(location["ether/".length..]) ?? Network.fetch(@ether, location["ether/".length..], version) as Project
      remote => Network.fetch(location as Location, "", version) as Project
      * => IO.read(location) as Project
  }
  depend (line: String) => dependencies.push(line as Dependency) -- this

  static Definition := class = name: String, value: *
  define (name: String, value) => defined_here(name)
    ? ERROR@name `two definitions with the same name in one project`
    : definitions.push Definition(name, value) -- value
  defined_here (name: String) => definitions{.name == name}.last

  // The nearest definition: here, a child project, then up the parents; then the dependencies, then @ether.
  nearest (name: String) => defined_here(name) ?? children{==.instance_of Project}.defined_here(name).first ?? parent?.nearest(name)
  lookup (name: String) => (nearest(name) ?? dependencies.project.nearest(name).first)?.value ?? World.ether.lookup(name)

  // The @ray %N a package was written against; files carried for hosts on another version (L7.5).
  write_against (version: Version) => (written_against = version) -- this
  carries (host_versions: Version[]) => written_against && !host_versions.contains(written_against)
  carry (files: *[]) => carried.push files -- this

  static Reading := class = pattern: String, language: Language {
    covers (file_name: String) => pattern ~= ⊢"*" ? file_name ~= pattern[1..] ⊣ : file_name == pattern
  }
  reads (pattern: String, language: Language) => readings.push Reading(pattern, language) -- this
  language_of (file_name: String) => readings{.covers(file_name)}.first?.language ?? Language.for_file(file_name)

  override (setting) => overrides.push setting -- this
}

// The external layout: `.ether/external/@name/$/@location/%/version` (L6.2)
Layout := class {
  root = ".ether/external/@"
  checked_out (name: String) => root, "/@", name
  path (name: String, locations: String[], version: String) => checked_out(name), "/$", locations.map("/@", .), "/%/", version
  changed (name: String, user: String, branch: String) => checked_out(name), "/$/@", user, "%", branch
}
