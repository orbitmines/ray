Channel := Program + History
// CH7 a channel refused a program
assert (Channel() |= Program(code: { @me.device })).count == 1
Chat := Channel{Pure & Terminating}
// A channel is a history read as the program it is; a message is a commit carrying any program. A chat narrows it.
assert {
  room := Chat()
  // CH1 a new chat already holds messages
  assert room.count == 0
  room.commit(1, Program(code: { "hi" }))
  // CH2 sending something does not keep it
  assert room.count == 1
  room.commit(2, Program(code: { "ho" }))
  // CH3 sending twice keeps other than two
  assert room.count == 2
  // CH4 a message forgot who sent it
  assert room.first.who == 1
  // CH5 a message forgot what was sent
  assert room.last.change() == "ho"
  // CH6 a chat took a program that breaks its narrowing
  assert (room |= Program(code: { while true { } })).erred
}
