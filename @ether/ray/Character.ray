Nameable := class {
  static PREFIX: String?
  name: *?
}

// A character by its name, `@"ada"` (`@"{name}"`): one claimed, made from what it is called
@"{name ^string}" ^string => Character(name: `{name}`)
// A fragment tagged by a language, `@html <p>{who}</p>`, `@json { … }`: taken whole, its block or the rest of its line,
// and read by nothing until a dependency is flagged as a language (spec/TODO.md)
@{tag: Char.Word[]} {{block}} ^keyword => `{block}`
@{tag: Char.Word[]} {first: Char.Word | "<" | "(" | "`" | "\"" | "-"}{rest} ^keyword => `{first}{rest}`

Character := class: Hierarchy &+ Nameable {
  // what a value nobody granted is visible to, as this character runs (`@me/policy`): nobody, unless it is set
  policy: Accessor = none
  // The same principal as `other`: here, the same value; @ether/security compares verified roots instead. (Whom a
  // principal answers for, a grant's, a delegation's: `==` it, or `is` it when that is a narrowing of principals.)
  chainable == (other) => this === other
  static PREFIX := "@"

  quests => Program#{who: this}{.running}
}
// (asserted out here: a class's body runs for each one made, so a character made in it would make one again)
assert @"plc".policy === none  // AC50 the policy nobody has changed is not the permission nobody has
assert {
  c := @"c"
  assert c == c  // CHR2 a character is not the same as itself
  assert !(c == @"c")  // CHR3 two different characters of one name are the same
  assert c is Character{.name == "c"} & !(c is Character{.name == "d"})  // CHR5 a character is not of a narrowing it satisfies, or is of one it does not
  assert c is Character & c is Accessor  // CHR49 a character is not a character, or not who may
}

