// IP addresses (draft: .ray2/Test.ray). An address is its segments: four of
// eight bits written in decimal with dots between them, or eight of sixteen
// written in hexadecimal with colons. spec: the draft's arithmetic over a
// whole address (`+ offset`), its CIDR ranges and the choices RFC 5952 asks
// for are notes below; a number here is walked, so 2³² of them is not a thing
// the language reaches.

// class IP < Location &+ (-1 <- . -> +1)
// spec: `Location` and the line from one address to the next await World's
// locations; what an address is, is its segments.
IP := class {
  segments: Node

  // static NUMBER_OF_SEGMENTS: Decimal, static SEGMENT_LENGTH: Decimal
  // The counts belong to the kind of address; each kind says its own.
  segment_count => .segments.count
  segment_length => eight
  // static NUMBER_OF_BITS = NUMBER_OF_SEGMENTS * SEGMENT_LENGTH
  bit_count => .segment_count * .segment_length
  // The separator between segments, and the base they are written in.
  separator => Character.of(ascii_dot)
  base => ten

  // `as Binary`: the bits of every segment, most significant first.
  bits => (
    out := chain None
    walker ^keyword := .segments.head
    length := .segment_length
    while (exists walker) {
      bits_of(walker.value, length) for { out &= it.value }
      walker = walker.next
    }
    out
  )

  // `({segments.join(".")})`: the segments written out, with the separator
  // between them.
  as_string => (
    parts := chain None
    walker ^keyword := .segments.head
    radix := .base
    while (exists walker) {
      parts &= walker.value.spelled_in(radix)
      walker = walker.next
    }
    String.joined(parts, .separator)
  )

  == (other: IP) => .as_string == other.as_string

  // The address read back from its text: each part is a number in the base.
  read (text: String, separator: Character, radix: Number) => (
    out := chain None
    text.split(separator) for { out &= it.value.as_number_in(radix) }
    out
  )
}

// static v4 := class: IP ({segments.join(".")}) => (NUMBER_OF_SEGMENTS = 4,
// SEGMENT_LENGTH = 8, Segment: Decimal{< 2^8})
IP.v4 = class: IP {
  segment_length => eight
  separator => Character.of(ascii_dot)
  base => ten
}
// static Segment: Decimal{< 2^8}
IP.v4.Segment = Number{. < two.pow(eight)}

// static v6 := class: IP ((left: Segment[]).join(":")?, zero_compression: "::"
// (? if !defined_segments.empty), (right: Segment[]).join(":")?, (":",
// embedded_ipv4: IPv4)?) => (NUMBER_OF_SEGMENTS = 8, SEGMENT_LENGTH = 16,
// Segment: Hexadecimal{length <= 4})
// spec: the draft's constructor reads the two sides of a `::` and an embedded
// v4 address; here an address is its eight segments, and `compressed` is where
// the zeros it writes as `::` are chosen.
IP.v6 = class: IP {
  segment_length => ten + six
  separator => Character.of(ascii_colon)
  base => ten + six

  // number_of_compressed_segments => NUMBER_OF_SEGMENTS - defined_segments.length
  // The longest run of zero segments, as where it starts and how long it is.
  // RFC 5952 asks for the longest run, and the first of equal runs, which is
  // what taking a later run only when it is longer does.
  zeros => (
    best_at ^keyword := zero
    best_run ^keyword := zero
    at ^keyword := zero
    run ^keyword := zero
    walker ^keyword := .segments.head
    while (exists walker) {
      if walker.value.is_zero {
        run = run.succ
        if (best_run < run) {
          best_run = run
          best_at = at.succ - run
        }
      } else { run = zero }
      at = at.succ
      walker = walker.next
    }
    Chain.Run(at: best_at, length: best_run)
  )

  // `compress_zeros`: the text with the longest run of zeros written `::`.
  // The symbol is not used for a single zero field (RFC 5952 4.2.2).
  compressed => (
    found := .zeros
    if (found.length < two) { .as_string } else {
      before := .written(zero, found.at)
      after := .written(found.at + found.length, .segment_count)
      before + (String.of(`::`) + after)
    }
  )
  // The segments from one place up to another, with colons between them.
  written (from: Number, until: Number) => (
    parts := chain None
    at ^keyword := from
    radix := .base
    while (at < until) {
      parts &= .segments.at(at).value.spelled_in(radix)
      at = at.succ
    }
    String.joined(parts, .separator)
  )
}
// static Segment: Hexadecimal{length <= 4}
IP.v6.Segment = Number{. < two.pow(ten + six)}

// A run of alike entries in a chain: where it starts and how long it is.
Chain.Run = class {
  at: Number
  length: Number
}

IPv4 := IP.v4
IPv6 := IP.v6

