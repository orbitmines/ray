@ether/os
@ether/time

// A vibration: on for each duration of its pattern, off for the next (https://www.w3.org/TR/vibration/)
Vibration := class (pattern: Quantity.Temporal[] = []) => {
  // as the device vibrates: a controller's rumble through evdev's force feedback on Linux
  // (https://www.kernel.org/doc/html/latest/input/ff.html), GameInput's on Windows, navigator.vibrate in a browser; a Mac
  // does not vibrate; on ether it is what the player's device is given
  felt => if OS.Ether { this } elsif OS.Macos { None } else { external os `vibrate` .pattern }
}
assert Vibration(pattern: [200 ms, 100 ms]).pattern.count == 2  // VIB1 a vibration does not keep its pattern
