  static byte_mapped (n, q, f, g) => truthy(call1(f, text(q, q + 1))) ? Readings.text_put(n, (g is Closure) ? call1(g, text(q, q + 1)) : g) : Readings.byte_kept(n, q)
  static text_put (n, r: Text) => {
    copy(n, r.from, r.to - r.from)
    n + (r.to - r.from)
  }
  static byte_kept (n, q) => {
