Document := class = entries: (name: String, value: *)[] = [] {
  [name: String] => entries{.name == name}.last?.value
  .{literal name ^property} ^punctuation => this[name]
  fields => entries
  names => entries.name

  within (name: String) => this[name] -- (. is Document[] ? .last : . ?? (Document() ~~ entries.push (name: name, value: .)))
  within_path (path: String[]): static => this ~~ (path.empty ? this : within(path.first).within_path(path.rest))
  put (path: String[], value): static => this ~~ (path.count == 1 ? entries.push (name: path.first, value: value) : within(path.first).put(path.rest, value))
  appended (path: String[]): static => this ~~ (path.count == 1
    ? (this[path.first] ?? ([] ~~ entries.push (name: path.first, value: .))).push Document()
    : within(path.first).appended(path.rest))
}
