Encoding := class {
  Algorithm := enum sha1 | sha256 | sha512 | sha3 | md5 | blowfish | blake3 | base64 | gzip {
    extensions => "." + name
    read (encoded) => this is Digest ? ERROR `a digest is written and never read back` : encoded.value
    write (value) => this is Digest ? Hash(value, algorithm: this) : Packed(value, algorithm: this)
  }
  Algorithm.components.hierarchy &= Language
  Digest := Algorithm{. is (sha1 | sha256 | sha512 | sha3 | md5 | blake3)}

  Packed := class = value: *, algorithm: Algorithm {
    as (target) => algorithm.read(this)
  }

  Hash := class = value: *, algorithm: Digest {
    chainable == (other: Hash) => algorithm == other.algorithm && value == other.value
  }

  Encrypted<T> := class = value: T, key: Key? {
    opened (holder) => key && holder?.key == key ? value : Quest(name: "find the key", goal: this)
  }
}
Gzip := Encoding.Algorithm.gzip

Base64 := class = (sextets: (Binary⁶ as Alphabet)[], "="[]{length == (4 - sextets.count % 4) % 4}) {
  static Alphabet = ("A".."Z", "a".."z", "0".."9", "+", "/") as String

  bytes: Byte[] => sextets.map(.integer).flatten.chunk(8){.count == 8}.map(Binary(integer: .))
  static (bytes: Byte[]) as (=== Base64) => Base64(sextets: bytes.map(.integer).flatten.chunk(6).map(Binary(integer: (., ["0"] * (6 - .count)))))
}
