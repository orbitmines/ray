// `.components` holds what a value superposes, `.components.hierarchy` its classes.

mark ^keyword := external global

A := class {
  mk => A(from: this)
}
a := A()
b := a.mk
c := b.mk
unless a.components.hierarchy.last { INFO@mark `C1 an instance has no class component` }
unless c.components.hierarchy.first.mk { INFO@mark `C2 the class component of an instance is not its class` }
unless a.components.hierarchy.owner { INFO@mark `C3 a hierarchy does not know what it belongs to` }
unless a.components.hierarchy.count == 1 { INFO@mark `C4 a plain instance has other than one class component` }

R := class { }
S := class: R { s => S(next: this) }
unless S().s.s.s { INFO@mark `C5 a successor chain through class: Parent broke` }
unless S.components.hierarchy.first { INFO@mark `C6 class: Parent did not add a class component` }
unless S.super { INFO@mark `C7 super is missing` }
unless Ray.super.count { INFO@mark `C8 Ray.super does not reach Iterable's count` }

Greeter := class {
  greeting => name
  twice => greeting
}
Loud := class: Greeter {
  greeting => global
  polite => super.greeting
}
loud := Loud(name: global)
unless loud.polite { INFO@mark `C22 super.greeting did not run the parent's method on the instance` }
unless loud.super.twice { INFO@mark `C23 super reaches the parent's other methods` }

E := enum p | q | r
unless E#.first == E.p { INFO@mark `C9 the first enum member is not the first written` }
unless E#.first.next.next == E.r { INFO@mark `C10 enum members are not chained forward` }
unless E#.last.previous.previous == E.p { INFO@mark `C11 enum members are not chained backward` }
unless E#.count == 3 { INFO@mark `C12 an enum of three has other than three members` }
unless E#.first.is_initial { INFO@mark `C13 the members are not an Iterable of Rays` }
unless E#.last == E.r { INFO@mark `C14 Iterable.last did not reach the last member` }

M := a | b
unless M.components.first.mk { INFO@mark `C15 | did not superpose its left side` }
unless M.components.last.mk { INFO@mark `C16 | did not superpose its right side` }
unless (M | c).components.count == 3 { INFO@mark `C17 | on a Many did not append` }
unless (A() | A()).components.count == 2 { INFO@mark `C31 superposing two does not make two components` }
lone := A()
lone | A()
unless lone.components.count == 0 { INFO@mark `C32 superposing changed the left side` }

k := [a, b]
unless k.first.next { INFO@mark `C18 a list is not linked forward` }
unless k.last.previous { INFO@mark `C19 a list is not linked backward` }
if k.first.previous { INFO@mark `C20 the first of a list has a previous` }
unless k.count == 2 { INFO@mark `C21 a list of two does not count two` }

// A class extended later reaches every instance built from it
Late := class { }
built_before := Late()
Late &+= {
  added => 1
}
unless built_before.added == 1 { INFO@mark `C24 a class extended later does not reach an instance built before` }
unless Late().added == 1 { INFO@mark `C25 a class extended later does not reach an instance built after` }

G1 := class { depth => 1 }
G2 := class: G1 { depth => 2 }
G3 := class: G2 { depth => 3 }
unless G3().depth == 3 { INFO@mark `C26 the nearest class does not answer` }
unless G2().depth == 2 { INFO@mark `C27 the middle class answers its parent's` }
unless G1().depth == 1 { INFO@mark `C28 the first class answers something else` }
unless G3.super { INFO@mark `C29 a class three deep has no super` }
unless G3.super.depth == 2 { INFO@mark `C30 super does not reach the class it is built on` }
