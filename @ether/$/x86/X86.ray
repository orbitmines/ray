// An instruction: a REX prefix or none, then one of the encodings above, given the prefix (made once X86 is, so that its header sees the encodings are of bits)
X86.Instruction := class (
  prefixes: X86.Prefix[]{length <= 3},
  rex: X86.Rex[]{length <= 1},
  operation: X86.Imul<prefixes, rex> | X86.Sub<prefixes, rex> | X86.Mov<prefixes, rex> | X86.Lea<prefixes, rex> | X86.Add<prefixes, rex> | X86.MovImmediate<prefixes, rex> | X86.Neg<prefixes, rex> | X86.Not<prefixes, rex>
    | X86.Cmp<prefixes, rex> | X86.CmpSmall<prefixes, rex> | X86.AndSmall<prefixes, rex> | X86.Shr<prefixes, rex> | X86.Test<prefixes, rex> | X86.TestByte<prefixes, rex>
    | X86.MoveIf<prefixes, rex> | X86.JumpIf<prefixes, rex> | X86.Jump<prefixes, rex> | X86.Nop<prefixes, rex> | X86.LongNop<prefixes, rex>
    | X86.MoveSigned<prefixes, rex> | X86.JumpIfNear<prefixes, rex> | X86.JumpNear<prefixes, rex>
    | X86.Load<prefixes, rex> | X86.AddLoaded<prefixes, rex> | X86.Store<prefixes, rex> | X86.StoreByte<prefixes, rex> | X86.AddStored<prefixes, rex>
    | X86.AddStoredByte<prefixes, rex> | X86.CmpStored<prefixes, rex> | X86.MoveZero<prefixes, rex> | X86.SetIf<prefixes, rex>
    | X86.ShiftCount<prefixes, rex> | X86.ShiftOne<prefixes, rex> | X86.Sar<prefixes, rex> | X86.Or<prefixes, rex> | X86.And<prefixes, rex>
    | X86.Immediate<prefixes, rex> | X86.CmpAccumulator<prefixes, rex> | X86.StoreImmediate<prefixes, rex> | X86.SmallStored<prefixes, rex>
