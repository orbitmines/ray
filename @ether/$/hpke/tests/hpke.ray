// HPKE base mode with DHKEM(X25519, HKDF-SHA256), HKDF-SHA256 and ChaCha20Poly1305 against RFC 9180's test vector A.2.1 (https://www.rfc-editor.org/rfc/rfc9180#appendix-A.2.1).

mark ^keyword := global

hpke := HPKE()
unless hpke.suite == [0x48, 0x50, 0x4b, 0x45, 0x00, 0x20, 0x00, 0x01, 0x00, 0x03] { INFO@mark `HPKE1 the suite is not HPKE, 0x0020, 0x0001, 0x0003` }

// DeriveKeyPair from ikmE and ikmR (RFC 9180 §7.1.3)
hpke_e := hpke.derived("909a9b35d3dc4713a5e72a4da274b55d3d3821a37e5d099e74a647db583a904b" as Hexadecimal₆₄ as Byte₃₂)
hpke_r := hpke.derived("1ac01f181fdf9f352797655161c58b75c656a6cc2716dcb66372da835542e1df" as Hexadecimal₆₄ as Byte₃₂)
unless hpke_e.secret as Hexadecimal₆₄ == "f4ec9b33b792c372c1d2c2063507b684ef925b8c75a42dbcbf57d63ccd381600" { INFO@mark `HPKE2 skEm of A.2.1 is not f4ec9b33…` }
unless hpke_r.secret as Hexadecimal₆₄ == "8057991eef8f1f1af18f4a9491d16a1ce333f695d4db8e38da75975c4478e0fb" { INFO@mark `HPKE3 skRm of A.2.1 is not 8057991e…` }
unless hpke_r.public as Hexadecimal₆₄ == "4310ee97d88cc1f088a5576c77ab0cf5c3ac797f3d95139c6c84b5429c59662a" { INFO@mark `HPKE4 pkRm of A.2.1 is not 4310ee97…` }

// Encap with skEm, Decap with skRm (RFC 9180 §4.1)
hpke_encap := hpke.encapsulated(hpke_r.published, hpke_e)
unless hpke_encap.enc as Hexadecimal₆₄ == "1afa08d3dec047a643885163f1180476fa7ddb54c6a8029ea33f95796bf2ac4a" { INFO@mark `HPKE5 enc of A.2.1 is not 1afa08d3…` }
unless hpke_encap.shared as Hexadecimal₆₄ == "0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7" { INFO@mark `HPKE6 the shared secret of A.2.1 is not 0bbe7849…` }
unless hpke.decapsulated(hpke_encap.enc, hpke_r) == hpke_encap.shared { INFO@mark `HPKE7 Decap does not give the secret Encap gave` }

// The key schedule with info "Ode on a Grecian Urn" (RFC 9180 §5.1)
hpke_s := hpke.sender(hpke_r.published, "Ode on a Grecian Urn".bytes, hpke_e).context
unless hpke_s.key as Hexadecimal₆₄ == "ad2744de8e17f4ebba575b3f5f5a8fa1f69c2a07f6e7500bc60ca6e3e3ec1c91" { INFO@mark `HPKE8 the key of A.2.1 is not ad2744de…` }
unless hpke_s.base_nonce as Hexadecimal₂₄ == "5c4d98150661b848853b547f" { INFO@mark `HPKE9 the base nonce of A.2.1 is not 5c4d9815…` }
unless hpke_s.exporter as Hexadecimal₆₄ == "a3b010d4994890e2c6968a36f64470d3c824c8f5029942feb11e7a74b2921922" { INFO@mark `HPKE10 the exporter secret of A.2.1 is not a3b010d4…` }

// Encryptions 0 and 1 of "Beauty is truth, truth beauty", with aad Count-0 and Count-1 (RFC 9180 §5.2, A.2.1.1)
unless hpke_s.sealed("Count-0".bytes, "Beauty is truth, truth beauty".bytes) as Hexadecimal₉₀ == "1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db21993c62ce81883d2dd1b51a28" { INFO@mark `HPKE11 ciphertext 0 of A.2.1.1 is not 1c5250d8…` }
unless hpke_s.nonce as Hexadecimal₂₄ == "5c4d98150661b848853b547e" { INFO@mark `HPKE12 the nonce after one message is not the base nonce XOR 1` }
unless hpke_s.sealed("Count-1".bytes, "Beauty is truth, truth beauty".bytes) as Hexadecimal₉₀ == "6b53c051e4199c518de79594e1c4ab18b96f081549d45ce015be002090bb119e85285337cc95ba5f59992dc98c" { INFO@mark `HPKE13 ciphertext 1 of A.2.1.1 is not 6b53c051…` }
hpke_r_context := hpke.receiver(hpke_encap.enc, hpke_r, "Ode on a Grecian Urn".bytes)
unless hpke_r_context.opened("Count-0".bytes, "1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db21993c62ce81883d2dd1b51a28" as Hexadecimal₉₀ as Byte₄₅) == "Beauty is truth, truth beauty".bytes { INFO@mark `HPKE14 the recipient does not open ciphertext 0` }

// Single-shot: what is sealed to a key opens with it, and not with another key or other info (RFC 9180 §6.1)
hpke_other := X25519.pair()
hpke_one := hpke.sealed(hpke_r.published, "info".bytes, [], "a content key".bytes)
unless hpke.opened(hpke_r, "info".bytes, [], hpke_one) == "a content key".bytes { INFO@mark `HPKE15 a single-shot seal does not open for its recipient` }
unless hpke.opened(hpke_other, "info".bytes, [], hpke_one) is Diagnostic { INFO@mark `HPKE16 a single-shot seal opens for another key` }
unless hpke.opened(hpke_r, "other".bytes, [], hpke_one) is Diagnostic { INFO@mark `HPKE17 a single-shot seal opens under other info` }
if hpke.sealed(hpke_r.published, "info".bytes, [], "a content key".bytes) == hpke_one { INFO@mark `HPKE18 two seals of one plaintext are the same` }
