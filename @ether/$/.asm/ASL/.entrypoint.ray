        b6 := byte.head.next.value
        b5 := byte.head.next.next.value
        b4 := byte.head.next.next.next.value
        b3 := byte.head.next.next.next.next.value
        b2 := byte.head.next.next.next.next.next.value
        b1 := byte.head.next.next.next.next.next.next.value
        unless (b6.or(b5.and(b4).and((b3.and(b2.or(b1))).not))) { plain = false }
