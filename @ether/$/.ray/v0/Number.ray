// A number is a ray: zero has no next, and every other number is the next of the one before.
Number := class: Ray {
  succ => Number(next: this)
  pred => next
  is_zero => next === None
  nonzero => !is_zero
  holds => nonzero
  as (=== boolean) => nonzero
  [&&, ||, !&&, !||, x||, x!||].for operator => {
    `operator` (b) => (this as boolean) operator b
  }

  == (other: Number) => is_zero ? other.is_zero : other.nonzero && pred == other.pred
  < (other: Number) => other.nonzero && (is_zero || pred < other.pred)
  <= (other: Number) => !(other < this)

  + (other: Number) => other.is_zero ? this : succ + other.pred
  - (other: Number) => other.is_zero || is_zero ? this : pred - other.pred
  * (other: Number) => other.is_zero ? 0 : this * other.pred + this
  / (other: Number) => this < other ? 0 : (this - other) / other + 1
  % (other: Number) => other.is_zero || this < other ? this : (this - other) % other
  right-to-left ^ (exponent: Number) => exponent.is_zero ? 1 : this ^ exponent.pred * this
  ! => is_zero ? 1 : pred! * this

  gcd (other: Number) => other.is_zero ? this : other.gcd(this % other)
  lcm (other: Number) => this * other / gcd(other)
  divides (other: Number) => other % this == 0
  coprime (other: Number) => gcd(other) == 1

  even => is_zero || pred.odd
  odd => !even
  half => this / 2
  squared => this ^ 2
  min (other: Number) => this < other ? this : other
  max (other: Number) => this < other ? other : this
  saturate (limit: Number) => min(limit)

  // `1..3`, `3..1` walks down (R4.1); `1..<3`
  .. (last: Number) => this == last ? [this] : this, (this < last ? succ : pred)..last
  ..< (last: Number) => this == last ? [] : this, (this < last ? succ : pred)..<last

  // A number is iterable: an unbounded line through it.
  bounded => false
  entry => (-1 <- this -> +1)
  ∞ => entry.unbounded

  n.times (block) => (0..<this).for block

  digits (base: Number) => this < base ? [this] : (this / base).digits(base), this % base
  static (digits: Number[]) as (base: Number) => digits.reduce(0) (acc, current) => acc * base + current

  root (degree: Number) => (0..this){. ^ degree <= this}.last
  // Irrationals are generators: the digits of a root are computed on demand (N1.4).
  root_of (degree: Number) => root(degree) ^ degree == this ? root(degree)
    : Real(integer: root(degree), fraction: (1 -> +1).map(place => (this * 10 ^ (degree * place)).root(degree) % 10))

  // Bitwise operations on bit strings and binary numbers alike (N1.11).
  bits (other: Number) => digits(2).length max other.digits(2).length -- digits(2).padded(.).zip(other.digits(2).padded(.))
  [&&, ||, x||, !&&, !||, x!||].for operator => {
    `"~" + operator` (other: Number) => bits(other).map((a, b) => a operator b) as 2
  }
  ~! (width: Number) => digits(2).padded(width).map(!) as 2
}

zero := Number()
0 := zero

Probability := Number{0 <= . <= 1}

Number &+= {
  static Bases = {
    Binary: Digit = "0" | "1"
    Ternary: Digit = "0".."2"
    Quaternary: Digit = "0".."3"
    Quinary: Digit = "0".."4"
    Senary: Digit = "0".."5"
    Septenary: Digit = "0".."6"
    Octal: Digit = "0".."7"
    Nonary: Digit = "0".."8"
    Decimal: Digit = "0".."9"
    Undecimal: Digit = Decimal | ("a" | "A")
    Duodecimal: Digit = Decimal | ("a" | "A")..("b" | "B")
    Tridecimal: Digit = Decimal | ("a" | "A")..("c" | "C")
    Tetradecimal: Digit = Decimal | ("a" | "A")..("d" | "D")
    Pentadecimal: Digit = Decimal | ("a" | "A")..("e" | "E")
    Hexadecimal: Digit = Decimal | ("a" | "A")..("f" | "F")
  }
  static Base := Number{2 <= .}
}

Digit := class: String

dynamically Number.Bases.for name => {
  internal Base => Number.Bases[name]

  global[name] := class: Number = integer: Base.Digit[]{length >= 1} {
    static Digit = Base
    static radix = Base#.count
    String => this as String

    as Number => integer.map(as Decimal) as radix
    as String => integer as String

    {fraction: static.String} (): Real => integer, ".", fraction

    // A natural is a Signed without its sign, both ways (N1.9).
    as Signed => Signed(integer: this)
    static Signed := class = sign: "-"?, integer: static {
      as static => integer if !negative
      negative => sign
      == (other: Signed) => integer == other.integer && (negative == other.negative || integer.is_zero)
      - => Signed(sign: negative ? None : "-", integer)
      + (other: Signed) => negative == other.negative ? Signed(sign, integer + other.integer)
        : integer < other.integer ? Signed(other.sign, other.integer - integer) : Signed(sign, integer - other.integer)
      - (other: Signed) => this + -other
      * (other: Signed) => Signed(sign: negative != other.negative ? "-" : None, integer * other.integer)
      < (other: Signed) => negative ? !other.negative || other.integer < integer : !other.negative && integer < other.integer
    }
    static Real := class = integer: static, ".", fraction: static{unbounded} {
      static Signed := class = sign: "-"?, real: Real

      // `0.5` is `5` counted in `10 ^ places`; division writes its digits on demand (N1.4).
      places => fraction.length
      scaled => (integer, fraction) as radix
      static written (counted: Number, places: Number) => Real(integer: counted / radix ^ places, fraction: (counted % radix ^ places).digits(radix).padded(places))
      as Number => integer if fraction.every(== 0)
      + (other: Real) => written(scaled * radix ^ other.places + other.scaled * radix ^ places, places + other.places)
      * (other: Number | Real) => other ==.instance_of Real ? written(scaled * other.scaled, places + other.places) : written(scaled * other, places)
      / (other: Number) => Real(integer: scaled / other / radix ^ places, fraction: (1 -> +1).map(place => scaled * radix ^ place / other % radix)[places..])
      == (other: Real) => scaled * radix ^ other.places == other.scaled * radix ^ places

      rational => fraction ==.instance_of (static | static[]{length == ∞})
      irrational => !rational
    }
  }

  // Leading zeros are equivalent to the number without them (N1.15).
  Base{: 0+, number: Base} as (=== Base) => number
}

Decimal &+= {
  % => this / 100
}

{digits: Decimal.String} => Decimal(integer: digits)
-{number: Decimal} => Decimal.Signed(sign: "-", integer: number)
0x{digits: Hexadecimal.String} | 0X{digits: Hexadecimal.String} => Hexadecimal(integer: digits)
0b{digits: Binary.String} | 0B{digits: Binary.String} => Binary(integer: digits)
{number: Decimal}.{fraction: Decimal.String} => Decimal.Real(integer: number, fraction: fraction)

// `u8 = Binary⁸`, `i8 = Binary⁸.Signed` (N1.7)
u{width: Decimal} => Binary{length == width}
i{width: Decimal} => Binary{length == width}.Signed
USize = u8 | u16 | u32 | u64

boolean &+= {
  as Binary => this ? 1₂ : 0₂
}

√{radicand: Number} => radicand.root_of(2)
∛{radicand: Number} => radicand.root_of(3)
∜{radicand: Number} => radicand.root_of(4)
∑ | Σ {summed: Iterable} => summed.sum
∏ {multiplied: Iterable} => multiplied.product

Iterable &+= {
  ∞ => unbounded
  // `0..2..1` goes on from where the last range ended.
  .. (next: Number) => this, (last..next)[1..]
  padded (width: Number, with = 0) => [with] * (width - length), this
}

// A program read back as its text: what it jumps to, which heads it requires, and where a spelling is declared.
Program &+= {
  is_jump => code ~= ⊢"goto "
  is_label => code ~= "\" ⊣
  jump => code ~= (⊢"goto ", name: Char.Word[], (" ", condition: *)?)
  is_conditional => is_jump && jump.condition
  target_of (jump: Program) => written{.is_label && .code == jump.jump.name + "\"}.first

  flow => written.map(step => (step, jumps_to: step.is_jump ? target_of(step) : None, falls_through: !step.is_jump || step.is_conditional))
  jumps_backward => written.some(step => step.is_jump && written.index_of(target_of(step)) <= written.index_of(step))
  terminating => !jumps_backward

  head => code ~= (⊢ head: (!(" " | "(" | ":" | "?"))[], ending: (" " | "(" | ":" | "?")?)
  required_heads => written{(.head.ending == ":" && .head.head ~= ⊢Char.Word) || .code ~= (.head.head, " => TODO")}.head.head
  declares (head: String) => written.some(.code ~= ⊢(head, " " | "(" | ":"))
  precedence (spelled: String) => written.index_of(written{.code ~= ⊢((Modifier.spellings, " ")?, spelled, " ")}.first)
}

Terminating := Program{terminating}
