  // (where it is entered, Iterable's `entry`: its first vertex)
  entry => .head
  // (a member it does not have (`missing_name`, the kernel's, which asks only when each of its values, one a class made, has it
  // as its own): each of its values' own, superposed in order (`.statement` of the Statements read, each statement: `.statement#.for .(caller)` runs them in
  // turn); one alone, a superposition of it alone; else None)
  missing => {
    missing_of := .missing_name
    missing_at := .head
    missing_values := Array.new
    missing_all := missing_at !== None
    while missing_at && missing_all {
      missing_value := missing_at.value
      missing_one := external member (missing_value) (missing_of)
      if missing_one === None {
        missing_all = false
      } else {
        missing_values.append(missing_one)
      }
      missing_at = missing_at.next
    }
    missing_all ? superposed_of(missing_values) : None
  }
  // (a range, what it can be (`#`): its values)
  members => ((.is_range) === true) ? this : None
  // (none, empty: as a text is, by what it holds, not by counting it (Iterable's `count == 0`, counted by `reduce`, which
  // asks `empty`))
  empty => .head === None
  // (a list as a type: one of its values, `"0".."9"` of a character)
  one_held (value) => {
    at := .head
    while at && !(at.value == value) {
      at = at.next
    }
    at ? true : false
  }
  // (a range of characters as a type, `"0".."9"`: a text of one character one of its values, by its characters (a value
  // not a text, a code point: that character's))
  one_same (text) => {
    at := .head
    one_char := (text).first
    while at && !((((at.value).textual === true) && ((at.value).same_characters(text) !== None)) || (!((at.value).textual === true) && (at.value == one_char))) {
      at = at.next
    }
    at ? true : false
  }
  one_written (text) => {
    at := .head
    while at && !(at.value == text) {
      at = at.next
    }
    at ? at.value : None
  }
  spreading => {
    .spread := true
    .
  }
  gathered => {
    .spread := false
    .
  }
  linked (value) => {
    {
      value := value
      next := None
      previous := None
      // (the name it was written as, the place it sits in: none)
      written_name := None
    }
  }

  append (value) => {
    link := Array.linked(value)
    if .tail {
      link.previous := .tail
      .tail.next := link
    } else {
      .head := link
    }
    .tail := link
    .
  }
  prepend (value) => {
    link := Array.linked(value)
    if .head {
      .head.previous := link
      link.next := .head
    } else {
      .tail := link
    }
    .head := link
    .
  }
  // (`xs[n]`, a number: its nth value, from 0)
  indexed (index) => {
    at := .head
    left := index
    while at && left > 0 {
      at = at.next
      left = left - 1
    }
    at ? at.value : None
  }
  // (`xs[n] = v`: its nth value made v, from 0; past its end, nothing)
  placed (index, value) => {
    at := .head
    left := index
    while at && left > 0 {
      at = at.next
      left = left - 1
    }
    (at.value = value) if at
    value
  }
  // (`,` given a list: a copy of it, what comes first then put in front, not into the one given)
  listed () => {
    made := Array.new
    at := .head
    while at {
      external named_like (made.append(at.value)) at
      at = at.next
    }
    made
  }
  joined (other) => {
    joining := .
    if other.listing {
      at := (other === joining) ? other.listed().head : other.head
      while at {
        external named_like (joining.append(at.value)) at
        at = at.next
      }
    } else {
      joining.append(other)
    }
    joining
  }
}
assert [1, 2].some((x) => x == 2)  // RS5 some does not find what is second (`return v if c` returned whether c held or not)
assert !([1, 2].some((x) => x == 3))  // RS6 some finds what is not there
assert [1, 2].find((x) => x == 2) == 2  // RS7 find does not find what is second
// Lists, read without numbers or `==`: what a method with parameters does to what it is read on, and closures given to them
assert ["a"].first  // LS1 a list of one has no first (`.head :=` in `append (value) =>` declared in its own node)
assert !(["a"].empty)  // LS2 a list of one is empty
assert ["a", "b"].last  // LS3 a list of two has no last
assert ["a", "b"].map((x) => x).last  // LS4 a mapped list has no last
assert {
  second_of := (a, b) => b
  assert second_of(1, [2, 3]).count == 2  // LS8 a list given as the last argument was spread into the arguments
}
assert [None].some((x) => x === None)  // LS7 a list holding nothing does not hold nothing (some asked what it found, not whether)
assert [1].joined([2, 3]).count == 3  // LS6 a list joined with two is not three (`.` in the closure `joined` gives `for` is the closure's argument; or a method's locals were its receiver's, each call the same)
assert {
  seen := false
  ["a"].for((x) => {
    seen = true
  })
  assert seen  // LS5 a closure given to for does not see where it was written, or its `=` does not change the name there
}
assert {
  kept := true
  shadowing := () => {
    kept := false
  }
  shadowing()
  assert kept  // CL18 := in a closure changed the name where the closure was written
}
assert {
  ran := 0
  running := (x) => (ran = ran + 1)
  running.named_argument
  assert ran == 0  // CL19 a member read on a closure called it
}
assert {
  Writer := class {
    via (f) => f(1)
    inner () => .via((x) => this)
  }
  writer := Writer()
  assert writer.inner() === writer  // CL20 `this` in a closure written in a method is not what the method was read on
}
assert {
  Implicit := class {
    helper (x) => x + this.base
    base => 1
    calls () => .helper(2)
  }
  assert Implicit().calls() == 3  // MI1 a method called as `.helper` in another of its class is not called on the same value
  Passing := class {
    inner (other) => other + 1
    outer (other) => .inner(other)
  }
  assert Passing().outer(1) == 2  // MI2 a method passing its parameter to another whose parameter is named the same is not given it
}
assert {
  outer_kept := 1
  Shadowing := class {
    own => {
      outer_kept := 2
      outer_kept
    }
  }
  assert Shadowing().own == 2  // LK2 a method's own name answered the one visible where the method is written (its body read before it ran)
  assert outer_kept == 1  // LK3 a method's own name changed the one visible where it is written
}
assert {
  gone := true
  while gone {
    gone = false
  }
  assert !gone  // CC14 while does not ask its condition again after its body (what its holes took was kept)
}
assert {
  ["Probed"].for((name) => {
    global[name] := true
  })
  assert Probed  // IX4 global[name] := in a closure does not declare the name the text holds
}
assert {
  defaulted := (given = None) => given
  defaulted()
  assert !(None)  // BN4 a parameter's default `= None` made None a name of its own (the value read as a left side)
  assert ["a"].first  // BN5 a parameter's default `= None` changed what None is for lists
}
assert Ray.super.count  // C8 Ray.super does not reach Iterable's count
assert 1 is Array  // TY63 a number is not an array
// (a text is its characters: the first, then the rest (`first`, `rest`, by the kernel's map for what it holds); none, empty)
// (a range, `"0".."9"`: a type of what it holds, what it can be (`#`) its values)
ranged (values) => values ~~ (.is_range := true)
is_range := false
String := class: Array {
  // (entered at its first character: that character, equipped with where it is (next, the rest entered); a step into it,
  // there)
  entered_at (text) => text.empty ? None : ((text.until(text.rest)) &+ { next => text.rest.entry })
  entry => .entered_at(this)
  // (a step into it: where it is entered, on from there what that is next to)
  next => .entry
  // (from one character to another, `"\t".."\r"`: the characters from the first's to the last's, as characters are ordered)
  .. (last) => ranged((.first)..((last).first))
  // (no first character, nor a rest: the null character is a first character, though false as a boolean, and after it
  // there is a rest (of none))
  empty => !.first && !.rest
  // (`t[n]`: its nth character, from 0, by what it holds (its first and rest), as a list's by its links)
  indexed (index) => .empty ? None : ((index == 0) ? .first : .rest.indexed(index - 1))
  textual := true
  closure := false
  // (a `.` in it on its own, not after a name or what closes, nor before a name: code of what it is read on)
  bare_dot => dot_alone(` `, this)
  // (a `.` it begins with: a member read in what it is read on, `.length`)
  dot_led => .empty ? false : ((.first) == 46)
  // (a class as a text, `Decimal as String` (`Decimal.String`): any class is one, the texts its fields are written as, in
  // order (a list of types reads a text in order); anything else, none)
  from (given) => (((given).of === given) && ((given).written_as !== None)) ? global.String{. is (given).written_as} : None
}
// (the characters a name is not made of, and what is before a `.` that is not a value's (`(`, an operator, a space))
not_named := ` ()[]{},;:=!&|<>+-*/%?^#~@`
one_of (character, among) => among.empty ? false : (((character).same_characters(among.first) !== None) ? true : one_of(character, among.rest))
dot_alone (before, text) => text.empty ? false : ((((text.first).same_characters(`.`) !== None) && one_of(before, not_named) && (text.rest.empty || one_of(text.rest.first, not_named))) ? true : dot_alone(text.first, text.rest))
Dotted := String{.bare_dot}
// (code not led by a `.`: what is given, not a member read in what it is given to)
Undotted := String{!(.empty) && !(.dot_led)}
assert `candidate is .`.bare_dot  // DT1 a `.` alone in an argument is not found
assert !(`x.y`.bare_dot)  // DT2 a member is a `.` alone
assert !(`(it) => it.({code})`.bare_dot)  // DT3 a member read on a value is a `.` alone
assert "ab" is String  // TX1 a text is not a String (the kernel's map, `wasm.o.ray`, says it is)
assert !("ab".empty)  // TX2 a text of two characters is empty
assert "ab".rest.first  // TX3 a text of two has no second character
assert "a".rest.empty  // TX4 the rest of a text of one is not empty
assert !("".first)  // TX5 an empty text has a first character
assert 1 + 2 as String == "3"  // PR38 as does not bind looser than plus
assert ("A", "A") is ...String  // SD3 ...T is not T[]
// (a number stands for a bit: as a condition, zero does not hold)
Number := class {
  ? {yes} : {no} => (.next === None) ? no : yes
}
assert 5 is Number  // TY5 five is not a Number
// Narrowings ask the constraint as well as what they narrow
assert {
  Small := Number{. < 5}
  Tiny := Small{. < 2}
  Even := Number{. % 2 == 0}
  assert 3 is Small  // TY16 three is not one of the small
  assert !(7 is Small)  // TY17 seven is one of the small
  assert 1 is Tiny  // TY19 one is not tiny
  assert !(3 is Tiny)  // TY20 three is tiny
  assert !(7 is Tiny)  // TY25 seven is tiny
  assert Tiny.admits(1)  // TY26 the tiny do not admit one
  assert !(Tiny.admits(3))  // TY27 the tiny admit three
  assert 4 is Small & Even  // TY65 four is not both small and even
  assert !(3 is Small & Even)  // TY66 three is both small and even
  assert !(6 is Small & Even)  // TY67 six is both small and even
}
assert 3 is Number  // TY18 three is not a number
// Calling a narrowed type chooses a value of it.
assert (Number{. > 5}()) > 5  // CN1 a value chosen from a narrowing does not satisfy it
// `boolean`: what `false` and `true` are (`false | true`).
boolean := false | true
assert {
  maybe: boolean? = None
  assert maybe ?? true  // BN3 ?? does not fall back on an optional left empty
}
// `#` is what a value may be (A1, T2.3)
assert boolean#.count == 2  // HS1 boolean does not have two possible values
assert boolean{. == true}() == true  // CN2 the only member a narrowing admits is not the one chosen
assert true is (1 boolean)  // CN5 one boolean (`Number{#.count == 1}`, a value of one possibility) does not admit true
false &+= {
  of := boolean
  assert {
    Side := enum near (of: "here") | far (of: "there") {}
    assert Side.near == Side.near  // HO3 a member is not itself
    assert !(Side.near == Side.far)  // HO4 two members of one enum are the same
    assert Side.near.of == "here"  // HO5 what a member holds is not what it was written as
    assert !(Side.near.of == "there")  // HO6 a member holds what the other one does
  }
}
true &+= {
  of := boolean
}
Char := class: Number { }
// (a 32-bit integer: its bits, 32 binary digits (Number.ray's `Binary₃₂.Signed`))
Int32 := class (bits) => { }
Program := class { }
Narrowing := class { }
Diagnostic := class { }
assert {
  fired := 0
  unless false { fired += 1 }
  unless 1 == 2 { fired += 1 }
  unless None { fired += 1 }
  assert fired == 3  // HO1 unless does not take the block when the condition does not hold
}
// A map's own key wins over Node's member (T8.7, T2.8)
assert ({ count: 3 }).(
  .count == 3  // FWO1 a map's own count does not win over Node's
  & (. as Object).count == 3  // FWO3 a value without Node does not read its own key
)

// A theme: what each style is shown as (`^style = ^shown`: another style, or a colour, `^ #F2F0FF`), in the order written; the
// one made last, `Theme.current`, the one shown.
Theme := {
  current := None
}
theme {name} {written} ^keyword => {
  // (its own node: what it declares is not declared where it is read)
  {
    made := {
      name := name
      styles := Array.new
    }
    // (each one written: what it took, the style and what it is shown as)
    made &+= {
      // (the `^`s written as text: `{lhs} ^{style} => …` would read the head as one shown in a style)
      {`^`}{style} = {`^`}{shown} => .styles.append(external &)
      {`^`}{style} = {`^`} {shown} => .styles.append(external &)
      {written}
    }
    Theme.current = made
  }
  Theme.current
}

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^U2
  ^type = ^U2
  ^class = ^U2
  ^enum = ^U2
  ^interface = ^U2
  ^struct = ^U2
  ^event = ^U2
  ^enumMember = ^U2
  ^typeParameter = ^U0
  ^parameter = ^U0
  ^variable = ^U1
  ^property = ^U1
  ^function = ^U4
  ^method = ^U4
  ^decorator = ^U4
  ^macro = ^U2
  ^keyword = ^U3
  ^modifier = ^U3
  ^comment = ^U3
  ^string = ^D2
  ^number = ^D2
  ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment

  // A test, `assert`, as what it found (failed, passed, not run); what is written after it in its own colours, muted: taken this
  // much toward this.
  ^failed = ^error
  ^passed = ^debug
  ^untested = ^comment
  ^muted = ^comment
  ^muting = ^ 50%
}

// (a comment after a statement, defined again last: what is declared last binds loosest, so it is read before anything else)
{statement} // {comment} ^comment => {statement}

// (what a class is made of is its own: one made of it that is given another part, `Chain &+= Array` (Chain made of Iterable,
// Array too), does not give it to the class (where Array would be made of itself))
Made_kept := class { }
Made_kept &+= class { }
Made_within := class: Made_kept { }
Made_within &+= class: Made_kept { }
assert !(Made_kept.descends(Made_within))  // MO1 a part given to what is made of a class was given to the class
assert Made_within.descends(Made_kept)  // MO2 what is made of a class does not descend from it
// (a choice written apart holds a `,` between its `?` and `:`, and, written as a statement, after its `:` too)
assert (true ? `a`, `b` : `c`).count == 2  // CH1 a choice did not hold the list between its ? and :
assert {
  chosen_rest (flag) => flag ? [] : `x`, `y`
  assert chosen_rest(false).count == 2  // CH2 a choice written as a statement did not hold the list after its :
}
// (a word and `=>` as an argument is a closure of it, not a rule of the scope the call is in)
assert [`a`].map(item_given => item_given).count == 1  // LA1 a closure of one word given as an argument was not called
// (an operator missing a side is the function of what it misses)
assert [`a`, `b`].some(== `b`)  // SE1 a section given as an argument did not compare each
// (a text at a number: its character there)
assert "ab"[1] == "ab".rest.first  // TI1 a text at one is not its second character
// (an operator takes what follows it up to one declared before it, wherever each was written)
assert 14 == 2 + 12  // PR1 == took only the first of what follows it
// (a typed parameter is the call's own, whatever what it is called on has of that name)
typed_named (count: Number) => count
assert [1, 2, 3].typed_named(7) == 7  // TP1 a typed parameter read as the member of what the method was called on
assert {
  Flipping := class {
    right-to-left ~~ => true
    flips (other) => ~~other
  }
  flipping := Flipping()
  assert ~~flipping  // RT1 a right-to-left operator taking nothing is not read written before its value
  assert flipping.flips(flipping)  // RT2 a right-to-left operator before a name, in a method, read as the method's own
}
assert {
  defining_global {operator} => {
    global.({a} {operator} {b} => true)
  }
  Defining := class {
    defining_global %^%
  }
  assert false %^% false  // CP1 an operator a rule's hole took, in its head, defined where the rule ran (`x += 1` unread)
}
assert {
  Behind := class: Array {
    empty => true
  }
  Behind &+= [false]
  assert Behind().empty === true  // MO3 what a class is made of, added after it, reads before the class's own block (§3.2)
}
assert {
  Tilded := class {
    marked := false
  }
  tilde_target := Tilded()
  tilde_found := None
  tilde_found = tilde_target ~~ .marked = true
  assert tilde_found === tilde_target  // TD1 `x = y ~~ .m = v` read `=` before `~~`: (x = (y ~~ .m)) = v
  tilde_other := Tilded()
  tilde_other ~~ (.marked = true)
  assert tilde_other.marked === true  // TD3 `x ~~ (.m = v)` does not set x's m
}
assert {
  Answering_typed := class {
    answered: Node{. === true} => true
  }
  assert Answering_typed().answered === true  // TA1 a member written with what it answers (`paths: Path{…} =>`) is not defined
}

// Files: `include` one in what this is where it is written (the language's own, in the language), `read` one in a scope of
// its own. A location, `@./*.ray`, is beside the file it is written in; `given` is what the host was given. The language's
// own project first, its `.project.ray` before the rest; then what it was given.
include {location} ^keyword => external include {location}
read {location} ^keyword => external read {location}
include @./.project.ray
//include @./*.ray
include @./Node.ray
include @./Ray.ray
include @./Number.ray
include @./String.ray
include @./CLI.ray
include @./Expression.ray
include @./Compiler.ray
read given
