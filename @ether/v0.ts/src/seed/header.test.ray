say {x} =>
  external io stdout x
a := external node
b := external node
P := class = left: Node, right: Node {
  swapped => P(right, left)
}
p := P(a, b)
say (p.left === a)
say (p.right === b)
q := p.swapped
say (q.left === b)
Q := class (only: Node) {
  it => only
}
say (Q(a).it === a)
R := class = value: Node
say (R(b).value === b)
