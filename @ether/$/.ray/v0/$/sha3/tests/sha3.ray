// SHA3-256 digests of FIPS 202's examples (https://csrc.nist.gov/projects/cryptographic-standards-and-guidelines/example-values, SHA3-256_Msg0.pdf, SHA3-256_1600.pdf).

mark ^keyword := external global

// The empty message (FIPS 202 example SHA3-256_Msg0.pdf)
unless SHA3.write([]) as Byte³² as Hexadecimal⁶⁴ == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a" { INFO@mark `KEC1 the empty message does not digest as in FIPS 202's Msg0 example` }
// "abc" (NIST CAVP SHA-3 example values, SHA3-256 of "abc")
unless SHA3.write("abc".bytes) as Byte³² as Hexadecimal⁶⁴ == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532" { INFO@mark `KEC2 abc does not digest as 3a985da7…` }
// The 448-bit message "abcdbcde…nopq" (NIST CAVP SHA-3 example values)
unless SHA3.write("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes) as Byte³² as Hexadecimal⁶⁴ == "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376" { INFO@mark `KEC3 the 448-bit message does not digest as 41c0dba2…` }
// 1600 bits of 0xA3, longer than the rate, absorbed in two blocks (FIPS 202 example SHA3-256_1600.pdf)
unless SHA3.write([0xA3] * 200) as Byte³² as Hexadecimal⁶⁴ == "79f38adec5c20307a98ef76e8324afbfd46cfd81b22e3973c65fa1bd9de31787" { INFO@mark `KEC4 1600 bits of a3 do not digest as in FIPS 202's 1600-bit example` }
// pad10*1 with the domain bits: a message one byte short of the rate ends in 0x86 (FIPS 202 §5.1, Appendix B.2)
unless SHA3.padded([0] * 135).last == 0x86 && SHA3.padded([0] * 136).count == 272 { INFO@mark `KEC5 the padding is not 0x06 … 0x80, merged to 0x86 in a single byte` }
// The round constants RC[0] and RC[23] (FIPS 202 §3.2.5)
unless (0..6).map(j => SHA3.rc(j) * 2 ^ (2 ^ j - 1)).sum == 1 && (0..6).map(j => SHA3.rc(j + 7 * 23) * 2 ^ (2 ^ j - 1)).sum == 0x8000000080008008 { INFO@mark `KEC6 the round constants of the first and last round are not 0x1 and 0x8000000080008008` }
