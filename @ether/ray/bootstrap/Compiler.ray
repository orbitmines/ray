  static made_type (mt) => (Lowered.named(mt) === None) ? None : mt
  static type_in (te, tn) => te.empty ? None : ((te.first.first == tn) ? te.first.last : Lowered.type_in(te.rest, tn))
  static field_type (ft_kind, ft_name) => (Lowered.field_holder(ft_kind, ft_name) === None) ? None : Lowered.field_named(Lowered.field_holder(ft_kind, ft_name).last, ft_name).last
