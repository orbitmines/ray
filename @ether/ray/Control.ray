// `dynamically name = value`: `name` read as `value` is each time it is read (P5.1)
dynamically {name} = {value} ^keyword =>
  name => value
dynamically {name} := {value} ^keyword =>
  name => value
dynamically if{ }{cond}{ }{block} ^keyword => Dynamic(program: () => if cond block)
// Run now, and again when what it reads is written (P5.1, P5.1a: by what runs it again, a runner, the TUI's loop)
dynamically {value} ^keyword => Dynamic(program: value**, source: value**)
Dynamic := class program: Program, source: Program? {
  dirty: Node?
  .{literal property ^property} ^punctuation => @member (program()) (@text property)
  as (=== boolean) => program() as boolean
  // `dynamic` read again, now that what it depends on changed
  static refreshed (dynamic) => dynamic.program()
}
watch (dynamic) => dynamic
// `dynamically assert c`: checked by what runs dynamic values again (a runner), not as it is written
dynamically assert {conditions} ^keyword => Dynamic(program: (Program(code: conditions**).written{!.()} -- .for(ERROR `assertion failed`) -- .empty)**)

Quantity.Temporal &+= {
  right-to-left sleep => Time.now -- (start => await dynamically (Time.now >= start + this))
}

Component := class {
  {literal label ^label}\ ^punctuation => return this
}

never := Node{false}
