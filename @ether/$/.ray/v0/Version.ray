Version := class: Ray ("%", number: Decimal, ("'", revision: Decimal)?) => {
  latest => !revision
  breaks_freely => number == 0

  chainable == (other: Version) => number == other.number && revision == other.revision
  chainable < (other: Version) => number < other.number || number == other.number && revision? < other.revision ?? ∞

  next => %(number + 1)
  previous => %(number - 1)
  continuations => Migration.leaving(this).to

  resolved (revisions: Version[]) => latest ? revisions{number == this.number}.max(.revision) ?? this : this

  static Range := class ("%[", first: Decimal, "..", last: Decimal, "]") => {
    includes (version: Version) => first <= version.number <= last
    versions => (first..last).map(%.)
  }

  static Pin := class ("%[", label: UUID | Char.Word[], "]")
}

{value}%{pin: Version.Pin} ^punctuation => value.history.checkout(pin.label, as_of: &caller.history.last?.stamp)

Versioned<T> := class = value: T, range: Version.Range? {
  at (version: Version) => value if !range || range.includes(version)
  selected (range: Version.Range) => range.versions.map(at(.)){!= None}
}

Migration := class (from: Version, " -> ", to: Version, " ", body: Function) => {
  static declared: Migration[] = []
  (static.declared ??= []).push this

  backward: Migration => Migration(from: to, to: from, body: body⁻¹ ?? Quest(name: "derive the inverse of a migration", goal: this))

  static leaving (version: Version) => declared{.from == version}, declared{.to == version}.backward
  static migrate (old, from: Version, to: Version) => from.shortest_path_to(to) -- (path => path is Quest
    ? Quest(name: "migrate", goal: (value: old, from: from, to: to))
    : path.zip(path.rest).map((a, b) => leaving(a){.to == b}.first).reduce(held = old => .body(held)))
}

Stamp := class = wall: Decimal, ".", logical: Decimal = 0, "@", node: * {
  chainable < (other: Stamp) => (wall, logical, node as String) < (other.wall, other.logical, other.node as String)
  when: Time => ((wall * 100) ns) as Time
  static at (time: Time, node) => Stamp(wall: (time as ns / 100).floor, node)
}

HybridClock := class = node: *, wall: Decimal = 0, logical: Decimal = 0 {
  measured => (Time.now as ns / 100).floor

  now: Stamp => {
    at = measured
    logical = wall < at ? 0 : logical + 1
    wall = wall max at
    Stamp(wall, logical, node)
  }

  receive (remote: Stamp): Stamp => {
    highest = measured max wall max remote.wall
    logical = if highest == wall == remote.wall { (logical max remote.logical) + 1 }
      elsif highest == wall { logical + 1 }
      elsif highest == remote.wall { remote.logical + 1 }
      else { 0 }
    wall = highest
    Stamp(wall, logical, node)
  }
}

Definition := class = id: UUID = choose UUID.v1{unique}, name: String, holder: *?, language: Language = Language.ray {
  chainable == (other: Definition) => id == other.id

  file (named: String = name) => language === Language.ray ? named + ".ray" : named
  path_in (history: History) => ((holder is Definition ? holder.path_in(history) : holder), file(history.name_of(this))){!= None && .nonempty}.join("/")
}

Operation := class = kind: Kind, definition: Definition, stamp: Stamp, who: *, before: *?, after: *?, substitutes: UUID?, body: Program? {
  static Kind := enum define | change | rename | remove {
    inverse => this == define ? remove : this == remove ? define : this
  }

  inverse => Operation(kind.inverse, definition, stamp, who, before: after, after: before)
  matches (current) => !before || before == current
  concurrent (other: Operation) => definition == other.definition && kind != Kind.rename && other.kind != Kind.rename && (after ?? body) != (other.after ?? other.body)
  summary => (kind as String) + " " + (kind == Kind.rename ? before + " -> " + after : definition.name)

  applied (held) => kind == Kind.rename ? held : kind == Kind.remove ? None : body ? held -- body : after
}

Backend := class: Language {
  static Fidelity := enum lossless | snapshot
  static fidelity: Fidelity = Fidelity.snapshot
  static similar: Probability = 50%

  static Entry := class: Hierarchy = name: String = "", content: Byte[]?, mode: Mode = Mode.file {
    static Mode := enum file | executable | link | directory | module

    directory => content === None
    path => (parent?.path, name){!= None && .nonempty}.join("/")
    files => directory ? children.map(.files).flatten : [this]
    child (named: String) => children.find(c => c.name == named)
    at (path: String) => path.split("/"){.nonempty}.reduce(held = this => held?.child(.))
    placed (path: String, bytes: Byte[], kind: Mode = Mode.file): static => path.split("/"){.nonempty} -- (segments =>
      (child(segments.first) ?? add(Entry(name: segments.first))) -- (next => segments.count == 1 ? next ~~ (.content = bytes) ~~ (.mode = kind) : next.placed(segments.rest.join("/"), bytes, kind)))
      -- this

    static of (files: (path: String, content: Byte[], mode: Mode?)[]) => files.reduce(root = Entry() => root.placed(.path, .content, .mode ?? Mode.file))
  }

  static Revision := class = id: *, tree: Entry, parents: *[] = [], who: *, when: Time, message: String = "", recorded: String?, renames: (from: String, to: String)[] = []

  static similarity (a: Byte[], b: Byte[]) => (a as String).lines -- (left => (b as String).lines -- (right =>
    left.count + right.count == 0 ? 1 : 2 * left{right.contains(.)}.count / (left.count + right.count)))

  static renamed_from (file: Entry, gone: Entry[], hinted: (from: String, to: String)[]) =>
    gone.find(.path == hinted.find(.to == file.path)?.from)
    ?? gone{similarity(.content, file.content) >= similar} -- (close => close{similarity(.content, file.content) == close.map(similarity(.content, file.content)).max} -- (best =>
      best.count > 1 ? Quest(name: "rename", goal: (to: file, from: best)) : best.first))

  static read_file (file: Entry) => Language.for_file(file.name).read(file.content as String)

  static identity (file: Entry, before: Entry, held, gone: Entry[], hints) => (held[file.path] if before.at(file.path))
    ?? (renamed_from(file, gone, hints) -- (from => from is Quest ? from : held[from?.path]))
    ?? Definition(name: file.name, holder: file.parent.path, language: Language.for_file(file.name))

  static inferred (before: Entry, after: Entry, held, defined, made) => (
    after.files.map(file => defined.find(.path == file.path).definition -- (definition => before.files.find(held[.path] == definition) -- (old => old === None
      ? [made(Operation.Kind.define, definition, None, read_file(file))]
      : [made(Operation.Kind.rename, definition, old.name, file.name) if old.path != file.path,
         made(Operation.Kind.change, definition, read_file(old), read_file(file)) if old.content != file.content]))).flatten,
    before.files{!defined.definition.contains(held[.path])}.map(made(Operation.Kind.remove, held[.path], read_file(.), None))
  ).flatten(1)

  static Reading := class = history: History = History(), commits = {}, trees = {}, known = {} {
    read (revision: Revision): static => {
      parent = revision.parents.first
      before = parent ? trees[parent] : Entry()
      held = parent ? known[parent] : {}
      gone = before.files{!revision.tree.at(.path)}
      defined = revision.tree.files.map(file => (path: file.path, definition: identity(file, before, held, gone, revision.renames)))
      stamp = history.received(Stamp.at(revision.when, node: revision.who))
      made = (kind, definition, old, new) => Operation(kind, definition, stamp, revision.who, before: old, after: new)
      previous = revision.parents.map(commits[.])#
      commits[revision.id] = revision.recorded
        ? Ray.history.commit(revision.recorded as Ray.history.Line, previous)
        : History.Commit(who: revision.who, value: inferred(before, revision.tree, held, defined, made), when: revision.when, stamp, message: revision.message, previous)
      trees[revision.id] = revision.tree
      known[revision.id] = defined.map((.path, .definition))
      history.head = commits[revision.id]
      this
    }
  }

  static revisions (history: History) => history.since(None).map(commit => Revision(
    id: commit.id, parents: commit.parents.id, who: commit.who, when: commit.when,
    message: commit.message ?? commit.operations.map(.summary).join(\n),
    tree: history.at(commit).tree,
    recorded: Ray.history.line(commit),
    renames: commit.operations{.kind == Operation.Kind.rename}.map(o => (from: o.definition.path_in(history.at(commit.parents.first)), to: o.definition.path_in(history.at(commit))))))
  static reading (revisions: Revision[]) => revisions.reduce(reading = Reading() => reading.read(.))
  static history_of (revisions: Revision[]) => reading(revisions).history

  static common (a: Byte[], b: Byte[]) => a.empty || b.empty || a.first != b.first ? 0 : 1 + common(a.rest, b.rest)
  static runs (source: Byte[], target: Byte[]) => target.empty ? [] : (0..<source.count).map(at => (from: at, count: common(source[at..], target))).max_by(.count) -- (best =>
    best && best.count >= 4 ? [(from: best.from, count: best.count)], runs(source, target[best.count..]) : runs(source, target[1..]) -- (rest =>
      rest.first?.bytes ? [(bytes: (target[..0], rest.first.bytes).flatten)], rest.rest : [(bytes: target[..0])], rest))

  read (source) => Compiler.reduced(source, level + Compiler.stored)
  write (history: History) => Compiler.reduced(Language.Writing(history), written + Compiler.stored)
  written_to (history: History, location: Location) => write(history).files.for(location / .path = .content) -- location
  append (location: Location, history: History) => written_to(History(repository: history.repository, base: history.head?.previous, head: history.head), location)
  converted (location, from: Backend) => write(from.read(location))
  tree_at (location: Location, label) => read(location).at(label).tree
}

Ray.history := class: Backend {
  static extensions = ".%"
  static fidelity = Backend.Fidelity.lossless

  static Line := class (
    label: UUID | Char.Word[], "\\",
    (" ", parents: (UUID, (" & ", UUID)[]))?,
    (" ", stamp: Stamp)?,
    ((" @", who: (Char.Word | "-")[] | UUID, " { ", body: Program, " }") | ((" " | \n), body: Program)),
    (\n | ⊣)
  )
  static File := class (lines: Line[])
  static Index := class (entries: (name: String, ": ", object: UUID | "None", \n)[]) {
    [name: String] => entries{.name == name}.last?.object -- (. == "None" ? None : .)
  }
  static Cache := class (values: (label: UUID, "\\ ", value: Program, \n)[]) {
    [label: UUID] => values{.label == label}.last?.value
    nearest (history: History, label: UUID) => history.find(label)?.ancestry.reverse.find(commit => values.some(.label == commit.id))
  }
  static Body := class = operation: Operation
  static Pin := class = definition: Definition, commit: UUID

  static bodies := {
    {body: Body{operation.body}} => body.operation.body as String
    {pin: Pin} => ".[", pin.definition.id, "] = ", pin.definition.id, "%[", pin.commit, "]"
    {body: Body{operation.kind == Operation.Kind.rename}} => ". named ", Language.ray.write(body.operation.after)
    {body: Body{operation.kind == Operation.Kind.remove}} => "None"
    {body: Body} => Language.ray.write(body.operation.after)
  }

  static edit (before, after) => (Language.ray.write(before) as Byte[]) -- (old => (Language.ray.write(after) as Byte[]) -- (new =>
    Backend.common(old, new) -- (prefix => Backend.common(old[prefix..].reverse, new[prefix..].reverse) -- (suffix =>
      (". edited(", prefix, ", ", old.count - suffix, ", ", Language.ray.write(new[prefix..<new.count - suffix] as String), ")") as String))))

  static written_body (commit: History.Commit, object: Definition? = None) => object
    ? commit.operations.map(Compiler.reduced(Body(.), bodies + Compiler.stored)).join("; ")
    : commit.value is Iterable && commit.value.nonempty && commit.value.every(. is Pin) ? commit.value.map(Compiler.reduced(., bodies)).join("; ")
    : commit.operations.empty ? Language.ray.write(commit.value)
    : commit.operations.map(operation => (".[", operation.definition.id, "] ", operation.kind == Operation.Kind.define ? ":= (" : "= .[" + operation.definition.id + "] -- (",
        Compiler.reduced(Body(operation), bodies + Compiler.stored), ")")).join("; ")

  static line (commit: History.Commit, above: History.Commit? = None, object: Definition? = None) => (
    commit.id, "\\",
    (" ", commit.parents.id.join(" & ")) unless commit.parents.empty || commit.parents == [above],
    " ", commit.stamp as String,
    " @", commit.who?.name ?? commit.who?.id ?? "me",
    " { ", written_body(commit, object), " }", \n
  ) as String

  static operations (line: Line, object: Definition?, first: boolean) => object
    ? [line.body ~= (⊢". named ", name: String) ⊣ -- (renamed => line.body as String == "None"
        ? Operation(Operation.Kind.remove, object, line.stamp, line.who)
        : renamed ? Operation(Operation.Kind.rename, object, line.stamp, line.who, after: renamed.name)
        : Operation(first ? Operation.Kind.define : Operation.Kind.change, object, line.stamp, line.who, body: line.body))]
    : line.body.written{.code ~= ⊢".["}.map(statement => statement.code ~= (⊢".[", object: UUID, "] ", (":= (" as defines | ("= .[", UUID, "] -- (") | "= "), body: Program, ")"?) ⊣ -- (part =>
        Definition(id: part.object, name: part.object as String) -- (object => part.defines
          ? [Operation(Operation.Kind.define, object, line.stamp, line.who, body: part.body)]
          : operations(Line(label: line.label, stamp: line.stamp, who: line.who, body: part.body), object, false)))).flatten

  static commit (line: Line, previous: History.Commit?, object: Definition? = None, first = false) => History.Commit(
    who: line.who ? Character.local(line.who) ?? line.who : &caller,
    value: operations(line, object, first) -- (found => found.empty ? line.body : found),
    id: line.label, when: line.stamp?.when ?? Time.now, stamp: line.stamp, previous)

  static Directory := class = location: Location {
    index => (location / "index.ray").content as Index
    files => IO.listing(location){.name ~= ".ray" ⊣ && .name != "index.ray"}
    file (object: UUID) => location / (object as String + ".ray")
    caches => IO.listing(location){.name ~= ".ray.txt" ⊣}.map(.content as Cache) -- (found => Cache(values: found.values.flatten))
  }

  static level := {
    {at: Location{segments.last == ".%"}} => Directory(location: at)
    {directory: Directory} => directory.files.map(.content as File).reduce(held = History() => held.read(.)) ~~ .cache = directory.caches
    {program: Program{written.some(.is_label)}} => (program.code as String) as File -- History().read(.)
  }

  static Project := class = history: History {
    commits => history.since(None)
    above (commit, among) => among[commit.index - 1] if commit.index > 0
    file => (path: history.id as String + ".ray", content: commits.map(line(., above: above(., commits))).join("") as Byte[])
    index => (path: "index.ray", content: history.definitions.map(history.name_of(.), ": ", .id, \n).join("") as Byte[])
    stored_file => file
    object_files => []
    cache_files => []
    files => [[stored_file, index], object_files, cache_files].flatten(1)

    objects => history.definitions.map(definition => commits{.operations.some(.definition == definition)} -- (touching => (path: definition.id as String + ".ray",
      content: touching.map(commit => line(History.Commit(who: commit.who, value: commit.operations{.definition == definition}, id: commit.id, when: commit.when, stamp: commit.stamp, previous: above(commit, touching)), above: above(commit, touching), object: definition)).join("") as Byte[])))
    referenced => (path: file.path, content: commits.map(commit => line(History.Commit(who: commit.who, value: commit.operations.map(Pin(.definition, commit.id)), id: commit.id, when: commit.when, stamp: commit.stamp, previous: commit.previous), above: above(commit, commits))).join("") as Byte[])
    caches => [(path: history.id as String + ".ray.txt", content: commits{.index % 64 == 63 || . === history.head}.map(commit => (commit.id, "\\ ", Language.ray.write(history.at(commit).value), \n)).join("") as Byte[])]
  }

  static written := {
    {writing: Language.Writing{value is History}} => Project(history: writing.value)
    {project: Project} => Backend.Entry.of(project.files)
  }

  append (location: Location, history: History) => history.head -- (commit => {
    location / (history.id as String + ".ray") += line(commit, above: history.written_last)
    commit.operations{.kind != Operation.Kind.change}.for(location / "index.ray" += (.kind == Operation.Kind.remove ? .definition.name : .after ?? .definition.name) + ": " + (.kind == Operation.Kind.remove ? "None" : .definition.id as String) + \n)
    history.written_last = commit
    location
  })
}

History &+= {
  read (file: Ray.history.File): static => file.lines.reduce(held = this => held.commit_line(.))
  commit_line (line: Ray.history.Line): static => this ~~ .head = Ray.history.commit(line,
    previous: line.parents ? line.parents#.map(find(.))# : head)

  cache: Ray.history.Cache?
  stored => Store.routed(this)#{. is Backend}
  lossless => stored.find(.fidelity == Backend.Fidelity.lossless)
}

History{location ∈ @me}$ = Ray.history | Git

Program &+= {
  as (=== History) => Ray.history.read(this)
}

Node &+= {
  edited (from: Number, to: Number, text: String) => Language.ray.write(this) -- (written => Language.ray.read((written[..<from], text, written[to..]).join("")))
}
