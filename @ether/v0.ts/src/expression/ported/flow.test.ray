say {x} =>
  @me/instance = x
a := @made Node
b := @made Node
say ((if true { a } else { b }) === a)
say ((if false { a } else { b }) === b)
r := if false { a }
else { b }
say (r === b)
s := if false { a } elsif true { b } else { a }
say (s === b)
n := @made Node
n.next = a
at := n
count := None
while at {
  count = at
  at = at.next
}
say (count === a)
unless false { say unless-taken }
