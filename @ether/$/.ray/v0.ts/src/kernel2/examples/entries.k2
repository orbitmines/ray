; A region entered at two entries at once: both reach exit 0, so the caller gets what both answered.
region main cells=2 exits=1
  entry start
start:
  enter pick in=0,1 args=#10 out=got:c1
got:
  print c1
  exit 0 c1

region pick cells=2 exits=1
  entry double
  entry triple
double:
  add c1 c0 c0
  exit 0 c1
triple:
  add c1 c0 c0
  add c1 c1 c0
  exit 0 c1
