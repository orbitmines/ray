}
// Layout (`level layout …`): whether a line goes on into the next (more indented, or a closing); a text's gaps (white)
// and words as a pattern; a word's inside, a line end in a text; the first or last where.
Layout := class {
  static continued_from (a, n) => (comma_ended(a, n) != 0) ? 1 : Layout.continued_by(n, Origins.indent_at_origin(origin_at(a)))
  static continued_by (n, d) => (d < 0) ? 0 : Layout.indented_past(n, d, indent_at(n + 1))
  static indented_past (n, d, j) => (((n + 1 + j) >= textend) || (byte(n + 1 + j) == 10)) ? 0 : ((j > d) || (pair_class(n + 1 + j) == 3))
  static spaced (l: List, j) => ((j < 0) || (j >= l.count)) ? 0 : Layout.not_literal(at(l, j))
  static not_literal (g: Pattern) => (g.kind != literally) && (g.kind != named_field)
  static gaps (l, a, e) => {
    q := a
    while q < e {
      q = (chared(byte(q), 3) != 0) ? Layout.gap_added(l, q, Layout.spaces_run(q, e)) : Layout.word_added(l, q, Layout.word_run(q, e))
    }
    l
  }
  static spaces_run (q, e) => {
    r := q
    while (r < e) && (chared(byte(r), 3) != 0) {
      r = r + 1
    }
    r
  }
  static word_run (q, e) => {
    r := q
    while (r < e) && (chared(byte(r), 3) == 0) {
      r = r + 1
    }
    r
  }
  static gap_added (l, s, q) => {
    append(l, Layout.gap_pattern(Layout.gap_kind(l, s, q)))
    q
  }
  static gap_kind (l: List, s, q) => ((l.count > 0) && Layout.is_literal(at(l, l.count - 1))) ? ((Layout.line_in(s, q) != 0) ? 2 : 4) : 0
  static is_literal (p: Pattern) => p.kind == literally
  static gap_pattern (t) => (t > 0) ? greedy(either(append(append(list(), chars(1)), chars(t))), 1) : greedy(chars(1), 1)
  static word_added (l, s, q) => {
    append(l, literal(text(s, q)))
    q
  }
  static line_in (a, e) => {
    q := a
    while q < e {
      return 1 if byte(q) == 10
      q = q + 1
    }
    0
  }
  static first_where (l: List, f) => (l is List) ? Layout.first_in(l, f) : member2(select(l, f), Symbol.first)
  static first_in (l: List, f) => {
    i := 0
    while i < l.count {
      return at(l, i) if truthy(call1(f, at(l, i)))
      i = i + 1
    }
    None
  }
  static last_where (l: List, f) => (l is List) ? Layout.last_in(l, f) : member2(select(l, f), Symbol.last)
  static last_in (l: List, f) => {
    i := l.count - 1
    while i >= 0 {
      return at(l, i) if truthy(call1(f, at(l, i)))
      i = i - 1
    }
    None
  }
}
// Indexes (`level indexed …`, removable: each a cache of what it answers): whether a text occurs in another (by the
// bytes and byte pairs in it, and over the program's text or the text taken, an index of where each byte and pair is,
// sorted, searched by halves); where a pair that opens at a place ends (`pair_end`, by place, the classes' version);
// whether a part is held outside brackets (`holds_outside`).
Indexes := class {
  // (whether a text occurs between a and e)
  static occurs (l: Text, a, e) => ((l.to - l.from) == 0) ? 1 : Indexes.found_at(l, a, e)
  static found_at (l: Text, a, e) => {
    q := a
    while (q + (l.to - l.from)) <= e {
