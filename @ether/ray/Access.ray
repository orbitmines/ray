Access := class (who: *?, method: `=` | `()` | * = *, filter: Program?, target: *?) => {
  static Reading := *{. != `=` && . != `()`}

  // A grant's expression and filter are read to check it, never run for what they do: only one that changes nothing
  // outside itself and terminates is granted, so checking a permission runs no one's code. Reading the time stays
  // allowed (`@bob.read history{from Time.now}`, L§9.2), so this is `!Effecting`, not `Pure`.
  static checkable (expression) => !(expression is Program) || !(expression is Effecting) && expression is Terminating

  allowed: *?

  allows (called) => called is method#
  reads => allows(`read`)
  writes => allows(`=`)
  executes => allows(`()`)
  // Who is compared as a principal (`answers_for`): identity in the core, verified roots with @ether/security.
  // A grant placed somewhere (its own location) holds only there; one placed nowhere holds everywhere (W2.27).
  covers (who, called, at = None) => who.answers_for(this.who) && allows(called) && (!location || !at || at is location#) && (!filter || checkable(filter) && filter.entered(this, None))

  // A grant is an Access on what it names: on what the expression answers when that is held somewhere (a value, a
  // field), on the expression itself when it derives something (`@ether.read x.count`, L§8.2.2).
  { }{literal target} ^punctuation => Program(code: target**) -- (named => checkable(named) && checkable(filter)
    ? named() -- (value => value is Node && value.parent ? value : named) -- (held => held ~~ .access |= (this ~~ .target = held))
    : ERROR@Access `a grant names an expression that changes nothing and terminates`)
}

none := Character{false}
// CST2 the permission nobody has reaches someone
assert !(Character(name: "anyone").answers_for(none))
// CST3 the permission nobody has is not the narrowest
assert none is local

{who: Character}.read ^keyword => Access(who, method: Access.Reading)
{who: Character}.write ^keyword => Access(who, method: `=`)
{who: Character}.execute ^keyword => Access(who, method: `()`)
{who}{{literal filter}}.read ^keyword => Access(who, method: Access.Reading, filter: Program(code: (filter**)))
{who}{{literal filter}}.write ^keyword => Access(who, method: `=`, filter: Program(code: (filter**)))
{who}{{literal filter}}.execute ^keyword => Access(who, method: `()`, filter: Program(code: (filter**)))
const {target} ^keyword => target ~~ .access |= Access(none, method: `=`, target: target)
// const is none.write: nobody may write it, and what it holds inherits that.
// CST1 const is not the permission nobody has
assert (const (count: 1)).access#(const (count: 1)).some((const (count: 1)).who === none && (const (count: 1)).writes)
confidential = => Node.policy

Node &+= {
  static policy: * = none

  visibility => access ?? (parent ? parent.visibility : None) ?? Access(Node.policy, method: Access.Reading, target: this)
  // Grants on a derivative sit on the expression that names it, found by what that expression answers (L§8.2.2).
  granted => [visibility#, Program#{.access && .names(this)}.access#].flatten
  allows (who, called, at = None) => granted.find(.covers(who, called, at)) ~~ (.allowed = this if .)
  // A secret is a node no one may read (`none.read`, W5.6): stores skip it and logging out drops it.
  unreadable => access#.some(.who === none && .reads)
}
// confidential follows the policy, but never past @private.managed.
assert {
  with Node.policy = public {
    // CK1 confidential widens with a public policy
    assert confidential is @private.managed
    // CK2 confidential reaches a stranger under a public policy
    assert !(Character(name: "stranger") is confidential)
  }
}
assert {
  with Node.policy = local {
    // CK3 confidential is wider than a narrower policy
    assert confidential is local
  }
}

Program &+= {
  names (value) => this === value || this == value || Access.checkable(this) && this() === value
  // A grant names an expression: a derivative may be granted where the value it derives from is not.
  assert {
    gx_reader := Character(name: "reader")
    gx := (count: 3, secret: "s")
    gx_reader.read gx.count
    gx_grant := Program#{.access#.some(.who === gx_reader)}.first?.access
    // GX1 a grant took the value of what it names instead of the expression
    assert gx_grant.target is Program
    // GX2 a grant does not name the expression it was given
    assert gx_grant.target.names(Program(code: { gx.count }))
    // GX3 a grant on one derivative names another
    assert !(gx_grant.target.names(Program(code: { gx.secret })))
    // GX4 a granted derivative is refused
    assert Program(code: { gx.count }).allows(gx_reader, `count`)
    // GX5 a grant on a count lets another field leave
    assert !(Program(code: { gx.secret }).allows(gx_reader, `secret`))
    gx_whole := (count: 1)
    gx_reader.read gx_whole
    // GX6 a grant naming a value does not cover that value
    assert gx_whole.allows(gx_reader, `size`)
    // GACC1 a grant naming a value is not on that value
    assert gx_whole.access#.some(.who === gx_reader)
  }
  // PURG4 checking a grant runs an expression with effects
  assert !(Program(code: { IO().output("leak") }).names("leak"))

  caller: Program?
  // Who runs a program is its chain of callers, the origin first; a prompt names them all.
  assert {
    hop_origin := Program(who: Character(name: "company"))
    hop_run := Program(who: Character(name: "me"), caller: hop_origin)
    // HOP1 a run's chain is not its origin first and its runner last
    assert hop_run.hops.first === hop_origin.who && hop_run.hops.last === hop_run.who
    // HOP2 a prompt does not name the whole chain
    assert hop_run.prompt == "@company wants to run this, originating from @me"
  }
  hops | chain => [caller.hops ?? [], who].flatten.unique
  may (method, target) => hops.every(target.allows(., method))
  ask (method, target) => may(method, target) || ERROR@Access `not granted`
  // AC26 a capability nobody granted does not err
  assert &@.ask(`()`, @me/device/camera).erred
  prompt => hops.map(.PREFIX + .name) -- (named => named.first + " wants to run this"
    + (named.count > 1 ? ", originating from " + named[1..].join(" <- ") : ""))

  // What a run may do is the runner's setting (L§8.1): `with (Program.speculated |= x)`, `with (Program.refused |= x)`, or a `.cfg.ray`.
  static speculated: *[] = []
  static refused: *[] = []

  continuations => calls{!.is_external}.map(.**)
  effects => reachable.map(.calls{.is_external}.external_name).flatten.unique
}
// What a program does is what its externals are: io and os are effects, the time is not deterministic.
// EFF1 adding numbers is not pure
assert Program(code: { 1 + 1 }) is Pure
// EFF2 writing out is not an effect
assert Program(code: { IO().output("x") }) is Effecting
// EFF3 reading the time is deterministic
assert !(Program(code: { Time.now }) is Deterministic)
assert {
  with (Program.refused |= Program(code: { IO().output("x") })) {
    // EFF4 a refused program is not refused
    assert Program(code: { IO().output("x") }) is Refused
  }
}
// EFF5 an effect nobody speculated runs in full
assert Program(code: { IO().output("x") }) is Abstracted

&@ ^keyword => &.caller as Program

Pure := Program{effects.empty}
Deterministic := Program{!effects.some(. is ("random" | "time" | "io"))}
Nondeterministic := Program{!(. is Deterministic)}
Effecting := Program{effects.some(. is ("io" | "os"))}
Initializer := Program{.calls.every(.is_external && .external_name is ("declare" | "assign"))}
Refused := Program{. is Program.refused#}
Abstracted := Program{. is Effecting && !(. is Program.speculated#)}

[(`pure`, Pure), (`deterministic`, Deterministic), (`nondeterministic`, Nondeterministic)].for (word, claim) => {
  right-to-left `word` {method} ^keyword => method -- (ERROR `this method is not what it is marked as` unless method** is claim)
}
