@ether/encryption
@x25519
@chacha20poly1305
@sha256
@hkdf

// Hybrid Public Key Encryption, base mode (https://www.rfc-editor.org/rfc/rfc9180)
HPKE := class: Language kem: Language = X25519, kdf: Language = SHA256, aead: Language = ChaCha20Poly1305 {
  static extensions := ".hpke"

  // DHKEM(X25519, HKDF-SHA256), HKDF-SHA256 and ChaCha20Poly1305 by their identifiers, two bytes each (RFC 9180 §7.1, §7.2, §7.3)
  static ids := {
    {algorithm: *{=== X25519}} => 0x0020
    {algorithm: *{=== SHA256}} => 0x0001
    {algorithm: *{=== ChaCha20Poly1305}} => 0x0003
    {algorithm} => ERROR@Name `an HPKE identifier for this algorithm`
  }
  static identified (algorithm) => Compiler.reduced(algorithm, HPKE.ids) as Binary₁₆ as Byte[]

  kem_suite => ["KEM".bytes, HPKE.identified(this.kem)].flatten
  suite => ["HPKE".bytes, [.kem, .kdf, .aead].map(HPKE.identified(.))].flatten
  size => .kdf.size

  // LabeledExtract and LabeledExpand: "HPKE-v1", the suite and the label before what is extracted or expanded (RFC 9180 §4)
  extracted (suite: Byte[], salt: Byte[], label: String, ikm: Byte[]) => HKDF(this.kdf).extracted(salt, ["HPKE-v1".bytes, suite, label.bytes, ikm].flatten)
  expanded (suite: Byte[], prk: Byte[], label: String, info: Byte[], length: Number) => HKDF(this.kdf).expanded(prk, [length as Binary₁₆ as Byte[], "HPKE-v1".bytes, suite, label.bytes, info].flatten, length)

  // DeriveKeyPair for X25519: the secret expanded from the input keying material (RFC 9180 §7.1.3)
  derived (ikm: Byte[]) => .kem.generated(this.expanded(this.kem_suite, this.extracted(this.kem_suite, [], "dkp_prk", ikm), "sk", [], 32))
  // ExtractAndExpand over the DH output, with enc and the recipient's public key as context; Encap with an ephemeral key, Decap with the recipient's (RFC 9180 §4.1)
  shared (dh: Byte[], enc: Byte[], recipient: Byte[]) => .expanded(this.kem_suite, this.extracted(this.kem_suite, [], "eae_prk", dh), "shared_secret", [enc, recipient].flatten, this.size)
  encapsulated (recipient: Key, e: Key = .kem.generated()) => (shared: .shared(e.agreed(recipient.public), e.public, recipient.public), enc: e.public)
  decapsulated (enc: Byte[], recipient: Key) => .shared(recipient.agreed(enc), enc, recipient.public)

  // KeySchedule in base mode: no PSK, the info hashed into the context, then the key, the base nonce and the exporter secret (RFC 9180 §5.1)
  scheduled (shared: Byte[], info: Byte[]) => [[0x00], .extracted(this.suite, [], "psk_id_hash", []), .extracted(this.suite, [], "info_hash", info)].flatten -- (context =>
    this.extracted(this.suite, shared, "secret", []) -- (secret => HPKE.Context(hpke: this, key: this.expanded(this.suite, secret, "key", context, 32),
      base_nonce: this.expanded(this.suite, secret, "base_nonce", context, this.aead.nonce_size), exporter: this.expanded(this.suite, secret, "exp", context, this.size))))

  // The encryption context: each message's nonce is the base nonce XOR the sequence number (RFC 9180 §5.2, §5.3)
  static Context := class hpke: HPKE, key: Byte[], base_nonce: Byte[], exporter: Byte[], seq: Number = 0 {
    nonce => .base_nonce.zip(this.seq as Binary{.length == 8 * this.base_nonce.count} as Byte[]).map((a, b) => a ~x|| b)
    sealed (aad: Byte[], plaintext: Byte[]) => .hpke.aead.sealed(this.key, this.nonce, aad, plaintext) ~~ (this.seq += 1)
    assert {
      hpke := HPKE()
      assert hpke.suite == [0x48, 0x50, 0x4b, 0x45, 0x00, 0x20, 0x00, 0x01, 0x00, 0x03]  // HPKE1 the suite is not HPKE, 0x0020, 0x0001, 0x0003
      // DeriveKeyPair from ikmE and ikmR (RFC 9180 §7.1.3)
      hpke_e := hpke.derived("909a9b35d3dc4713a5e72a4da274b55d3d3821a37e5d099e74a647db583a904b" as Hexadecimal₆₄ as Byte₃₂)
      assert hpke_e.secret as Hexadecimal₆₄ == "f4ec9b33b792c372c1d2c2063507b684ef925b8c75a42dbcbf57d63ccd381600"  // HPKE2 skEm of A.2.1 is not f4ec9b33…
      hpke_r := hpke.derived("1ac01f181fdf9f352797655161c58b75c656a6cc2716dcb66372da835542e1df" as Hexadecimal₆₄ as Byte₃₂)
      assert hpke_r.secret as Hexadecimal₆₄ == "8057991eef8f1f1af18f4a9491d16a1ce333f695d4db8e38da75975c4478e0fb"  // HPKE3 skRm of A.2.1 is not 8057991e…
      assert hpke_r.public as Hexadecimal₆₄ == "4310ee97d88cc1f088a5576c77ab0cf5c3ac797f3d95139c6c84b5429c59662a"  // HPKE4 pkRm of A.2.1 is not 4310ee97…
      // Encap with skEm, Decap with skRm (RFC 9180 §4.1)
      hpke_encap := hpke.encapsulated(hpke_r.published, hpke_e)
      assert hpke_encap.enc as Hexadecimal₆₄ == "1afa08d3dec047a643885163f1180476fa7ddb54c6a8029ea33f95796bf2ac4a"  // HPKE5 enc of A.2.1 is not 1afa08d3…
      assert hpke_encap.shared as Hexadecimal₆₄ == "0bbe78490412b4bbea4812666f7916932b828bba79942424abb65244930d69a7"  // HPKE6 the shared secret of A.2.1 is not 0bbe7849…
      assert hpke.decapsulated(hpke_encap.enc, hpke_r) == hpke_encap.shared  // HPKE7 Decap does not give the secret Encap gave
      // The key schedule with info "Ode on a Grecian Urn" (RFC 9180 §5.1)
      hpke_s := hpke.sender(hpke_r.published, "Ode on a Grecian Urn".bytes, hpke_e).context
      assert hpke_s.key as Hexadecimal₆₄ == "ad2744de8e17f4ebba575b3f5f5a8fa1f69c2a07f6e7500bc60ca6e3e3ec1c91"  // HPKE8 the key of A.2.1 is not ad2744de…
      assert hpke_s.base_nonce as Hexadecimal₂₄ == "5c4d98150661b848853b547f"  // HPKE9 the base nonce of A.2.1 is not 5c4d9815…
      assert hpke_s.exporter as Hexadecimal₆₄ == "a3b010d4994890e2c6968a36f64470d3c824c8f5029942feb11e7a74b2921922"  // HPKE10 the exporter secret of A.2.1 is not a3b010d4…
      // Encryptions 0 and 1 of "Beauty is truth, truth beauty", with aad Count-0 and Count-1 (RFC 9180 §5.2, A.2.1.1)
      assert hpke_s.sealed("Count-0".bytes, "Beauty is truth, truth beauty".bytes) as Hexadecimal₉₀ == "1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db21993c62ce81883d2dd1b51a28"  // HPKE11 ciphertext 0 of A.2.1.1 is not 1c5250d8…
      assert hpke_s.nonce as Hexadecimal₂₄ == "5c4d98150661b848853b547e"  // HPKE12 the nonce after one message is not the base nonce XOR 1
      assert hpke_s.sealed("Count-1".bytes, "Beauty is truth, truth beauty".bytes) as Hexadecimal₉₀ == "6b53c051e4199c518de79594e1c4ab18b96f081549d45ce015be002090bb119e85285337cc95ba5f59992dc98c"  // HPKE13 ciphertext 1 of A.2.1.1 is not 6b53c051…
      hpke_r_context := hpke.receiver(hpke_encap.enc, hpke_r, "Ode on a Grecian Urn".bytes)
      assert hpke_r_context.opened("Count-0".bytes, "1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db21993c62ce81883d2dd1b51a28" as Hexadecimal₉₀ as Byte₄₅) == "Beauty is truth, truth beauty".bytes  // HPKE14 the recipient does not open ciphertext 0
      // Single-shot: what is sealed to a key opens with it, and not with another key or other info (RFC 9180 §6.1)
      hpke_other := X25519.generated()
      hpke_one := hpke.sealed(hpke_r.published, "info".bytes, [], "a content key".bytes)
      assert hpke.opened(hpke_r, "info".bytes, [], hpke_one) == "a content key".bytes  // HPKE15 a single-shot seal does not open for its recipient
      assert hpke.opened(hpke_other, "info".bytes, [], hpke_one) is Diagnostic  // HPKE16 a single-shot seal opens for another key
      assert hpke.opened(hpke_r, "other".bytes, [], hpke_one) is Diagnostic  // HPKE17 a single-shot seal opens under other info
      assert !(hpke.sealed(hpke_r.published, "info".bytes, [], "a content key".bytes) == hpke_one)  // HPKE18 two seals of one plaintext are the same
    }
    opened (aad: Byte[], ciphertext: Byte[]) => .hpke.aead.opened(this.key, this.nonce, aad, ciphertext) ~~ (this.seq += 1)
    exported (context: Byte[], length: Number) => .hpke.expanded(this.hpke.suite, this.exporter, "sec", context, length)
  }

  // SetupBaseS and SetupBaseR (RFC 9180 §5.1.1)
  sender (recipient: Key, info: Byte[] = [], e: Key = .kem.generated()) => .encapsulated(recipient, e) -- (held => (enc: held.enc, context: this.scheduled(held.shared, info)))
  receiver (enc: Byte[], recipient: Key, info: Byte[] = []) => .scheduled(this.decapsulated(enc, recipient), info)

  // Single-shot Seal and Open: enc, then the ciphertext (RFC 9180 §6.1)
  static Sealed := class (enc: Byte₃₂, ciphertext: Byte[])
  sealed (recipient: Key, info: Byte[], aad: Byte[], plaintext: Byte[]) => .sender(recipient, info) -- (held => HPKE.Sealed(enc: held.enc, ciphertext: held.context.sealed(aad, plaintext)) as Byte[])
  opened (recipient: Key, info: Byte[], aad: Byte[], sealed: Byte[]) => (sealed as HPKE.Sealed) -- (held => this.receiver(held.enc, recipient, info).opened(aad, held.ciphertext))

  // A tag only the recipient recomputes, from the shared secret by LabeledExpand over the info (RFC 9180 §4, RFC 5869 §2.3), so a recipient finds its own sealed message among many without opening them
  tag (shared: Byte[], info: Byte[], length: Number = 16) => .expanded(this.suite, shared, "tag", info, length)
  tagged (recipient: Key, info: Byte[], aad: Byte[], plaintext: Byte[]) => .encapsulated(recipient) -- (held =>
    (tag: this.tag(held.shared, info), sealed: HPKE.Sealed(enc: held.enc, ciphertext: this.scheduled(held.shared, info).sealed(aad, plaintext)) as Byte[]))
  recognised (recipient: Key, info: Byte[], expected: Byte[], sealed: Byte[]) => .tag(this.decapsulated((sealed as HPKE.Sealed).enc, recipient), info) == expected
}

// A key with a public part (a KEM's, `X25519.generated()`) is written to through HPKE: what is encrypted for it, only its
// secret reads back (@ether/encryption)
X25519 &+= {
  static sealed_for (key: Key, bytes: Byte[]) => HPKE(kem: X25519).sealed(key, [], [], bytes)
  static opened_with (key: Key, written: Byte[]) => HPKE(kem: X25519).opened(key, [], [], written)
}
assert {
  inbox := X25519.generated()
  number: Number = Encrypted(5, inbox)
  assert number is Number & inbox.read(number) == 5  // HPKE20 a value encrypted to a key's public part is not read back by its secret
  assert X25519.generated().read(number).erred  // HPKE21 another key reads back what was encrypted to this one
  assert !(inbox == ChaCha20Poly1305.generated())  // HPKE22 keys of different algorithms are equal
}
