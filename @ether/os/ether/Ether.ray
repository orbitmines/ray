OS.Ether := class: OS {
  [property: String] => { "platform": "ether", "architecture": "ray" }[property]
  running => OS#{!== OS.Ether}.map(.()){running}.empty

  read (location: Location) => @me/device/storage[location.normalised]
  write (location: Location, content) => @me/device/storage[location.normalised] = content
  listing (location: Location) => @me/device/storage.fields.name{~= ⊢(location.normalised + "/")}
    .map(.after(location.normalised + "/").before("/")).unique.map(location / .)
  sent (stream: String, content) => ERROR@OS `streams are not written in Ray yet`
  received (stream: String) => ERROR@OS `streams are not written in Ray yet`
  launch (location: Location) => ERROR@OS `opening a location is not written in Ray yet`
  bit => ERROR@OS `a source of random bits is not written in Ray yet`
  now: Time => ERROR@OS `the clock kept by NTP is not written in Ray yet`
  time_zones: TimeZone.Source => TimeZone.Zoneinfo(directory: @tzif/zoneinfo)
  fonts: Location[] => ERROR@OS `fonts are not written in Ray yet`

  tcp (address: String, bytes: Byte[]) => ERROR@OS `TCP is not written in Ray yet`
  udp (address: String, bytes: Byte[]) => ERROR@OS `UDP is not written in Ray yet`
  // TLS 1.3 (https://www.rfc-editor.org/rfc/rfc8446) with ALPN (https://www.rfc-editor.org/rfc/rfc7301)
  tls (address: String, offered: String[]) => ERROR@OS `TLS 1.3 is not written in Ray yet`
  mac_address: MAC? => None
  connected: boolean => ERROR@OS `a network in Ray is not written yet`
}
OS |= OS.Ether
