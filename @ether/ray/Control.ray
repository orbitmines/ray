
Quantity.Temporal &+= {
  right-to-left sleep => Time.now -- (start => await dynamically (Time.now >= start + this))
  assert {
    sleep (1 ms)
  }
}

Component := class {
  {literal label ^label}\ ^punctuation => return this
}

never := Node{false}
// NV1 something is of the type that never returns
assert !(never.admits(5))
















// CF3 the first holding arm is not what answered
assert (if false {
  0 += 1
  1
} elsif true {
  0 += 1
  2
} elsif true {
  0 += 1
  3
} else {
  0 += 1
  4
}) == 2

// CF4 more than one arm of a chain ran
assert 0 == 1




assert {
  left := 3
  rounds := 0
  while left {
    rounds += 1
    left -= 1
  }
  // CF10 a loop ran other than three times
  assert rounds == 3
  // CF11 a loop left its count behind
  assert left == 0
}

// `;`
// CF14 the semicolon does not answer what is written after it
assert (1 ; 2) == 2

// CF15 the last of three is not what the whole answers
assert (1 ; 2 ; 3) == 3

assert {
  semi_counted := 0
  (semi_counted = 1) ; (semi_counted += 1)
  // CF16 two bracketed statements on one line did not both run
  assert semi_counted == 2
}

// ER2 a default replaced what did not fail
assert 7 $ 5 == 7
