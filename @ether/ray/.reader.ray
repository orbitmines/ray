{pattern} => {body} =>
  external rule pattern body
{name} := {value} =>
  external declare name value
//{comment} =>
  external label comment

// ---------------------------------------------------------------- the vocabulary the reader is written in
// Until the reader defines the language's own (below, on `Node`), these are rules; each is spelled and means what the
// language's does (spec/Language.md L§2), so the reader is written in Ray. What is declared first binds loosest.

// A member set (`x.m = v`) and a name written (`x = v`: the binding it was declared in, the nearest frame that has it).
{x}.{member} = {value} =>
  external set x member value
{name} = {value} =>
  holder := external declaring name
  external set holder name value
{a} === {b} =>
  external same a b
{x}.{member} =>
  external get x member
true := external node
// Nothing: what a node does not have.
empty := external node
None := empty.nothing

// Control flow (spec/Grammar.md G2.19): what is indented under `if`, `unless` and `while` is their block.
if {condition} {block} =>
  external goto taken condition
  external goto done
  external label taken
  block
  external label done
unless {condition} {block} =>
  external goto done condition
  block
  external label done
while {condition} {block} =>
  external label again
  external goto body condition
  external goto done
  external label body
  block
  external goto again
  external label done

// ---------------------------------------------------------------- the reader (spec/Reader.md R1, R2), handed reading at the end
learned := external learned
end := learned.end
space := learned.space
indent := learned.indent
access := learned.access
defining := learned.definer

// The place after `chain` spelled from `at`, or nothing. A space in it also reads a line end and the indentation that
// continues a statement (R0.1, as the first statement wrote its definer's space).
{at}.spelled({chain}) =>
  at.spells(chain, None)

// The same, for a chain that ends at `chain_end` (a literal written in a head).
{at}.spells({chain}, {chain_end}) =>
  here := at
  wanted := chain
  result := external node
  if wanted === chain_end
    wanted = None
  while wanted
    unless here
      result = None
      wanted = None
    if here
      c := here.character
      w := wanted.character
      matches := c === w
      continued := None
      unless matches
        if w === space
          if c === end
            continued = here.continuation
      if continued
        here = continued
        wanted = wanted.next
        matches = None
      if matches
        here = here.next
        wanted = wanted.next
      if wanted === chain_end
        wanted = None
      unless matches
        unless continued
          result = None
          wanted = None
  if result
    result.end = here
  result

// The place after a line end and one or more indentations, or nothing.
{at}.continuation =>
  here := at.next
  more := here.spelled(indent)
  found := None
  while more
    found = more.end
    more = found.spelled(indent)
  found

// Characters the reader names are taken from where they are written here.
written := external span "/()[]{}:.,`\n?
mark := written.from
quote := mark.character
mark = mark.next
slash := mark.character
mark = mark.next
opening := mark.character
mark = mark.next
closing := mark.character
mark = mark.next
opening_list := mark.character
mark = mark.next
closing_list := mark.character
mark = mark.next
opening_block := mark.character
mark = mark.next
closing_block := mark.character
mark = mark.next
colon := mark.character
mark = mark.next
dot := mark.character
mark = mark.next
comma := mark.character
mark = mark.next
backtick := mark.character
mark = mark.next
backslash := mark.character
mark = mark.next
letter_n := mark.character
mark = mark.next
question := mark.character

// The bracket that closes `c`, or nothing when `c` opens none.
{c}.closer =>
  found := None
  if c === opening
    found = closing
  if c === opening_list
    found = closing_list
  if c === opening_block
    found = closing_block
  found

// Whether `c` closes a bracket.
{c}.closes =>
  found := None
  if c === closing
    found = true
  if c === closing_list
    found = true
  if c === closing_block
    found = true
  found

// Where the statement starting at `at` ends: the first line end not followed by a line deeper than `base` (R0.1), or `to`.
{at}.statement_end({to}, {base}) =>
  here := at
  found := to
  open_ones := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      // a statement goes on while a bracket it opened is open (quoted text holds none)
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if open_ones
          expected := open_ones.shut
          if c === expected
            open_ones = open_ones.next
        if c === quote
          skipping := here.next
          while skipping
            if skipping === to
              skipping = None
            if skipping
              d := skipping.character
              if d === end
                skipping = None
            if skipping
              if d === quote
                here = skipping
                skipping = None
              if skipping
                skipping = skipping.next
      ending := None
      unless open_ones
        if c === end
          ending = true
      if ending
        deeper := None
        next := here.next
        inside := next
        if base
          inside = None
          based := next.spelled(base)
          if based
            inside = based.end
        if inside
          deeper = inside.spelled(indent)
        unless deeper
          found = here
          here = None
      if here
        here = here.next
  found

// Whether `far` is reached walking from `at` without passing `limit` (what was read from `at` stays inside the statement).
{at}.reaches({far}, {limit}) =>
  here := at
  found := None
  going := true
  while going
    if here === far
      found = true
      going = None
    if going
      if here === limit
        going = None
      unless here
        going = None
    if going
      here = here.next
  found

// A reading of `pieces` from `at` that ends at `limit`: its `captures` (a chain of `name`, `from`, `to`), or nothing. A capture
// reads one or more characters, the longest first; one that crosses a line end runs to `limit`.
// The same, in a `mode`: nothing reads up to `limit`; a prefix reading (on a receiver, R2.1) may end anywhere before it,
// its last capture reading one operand.
{at}.readings({pieces}, {limit}, {mode}) =>
  found := None
  unless pieces
    ends_here := at === limit
    if mode
      ends_here = true
    if ends_here
      found = external node
      found.end = at
  if pieces
    literal := pieces.literal
    gap := pieces.gap
    line_end := pieces.line_end
    fixed := literal
    far := None
    if literal
      lit_from := pieces.from
      lit_to := pieces.to
      spelt := at.spells(lit_from, lit_to)
      if spelt
        far = spelt.end
    if gap
      fixed = true
      far = at.spaces_after
    if line_end
      fixed = true
      if at
        c := at.character
        if c === end
          far = at.next
    if far
      within := at.reaches(far, limit)
      if within
        found = far.readings(pieces.next, limit, mode)
    unless fixed
      found = at.captured(pieces, limit, mode)
  found

// The place after one or more spaces from `at`, or nothing when no space is there.
{at}.spaces_after =>
  here := at
  found := None
  while here
    c := here.character
    if c === space
      here = here.next
      found = here
      unless here
        here = None
    unless c === space
      here = None
  found

// The places a capture from `at` can end at, up to `limit`, as a chain of `place`s: where `wanted` is (the first character of
// the literal that follows it, or a line end for a space), anywhere when nothing is wanted; past a line end only `limit`.
// The longest first when `longest` (a leading capture), else the shortest, a line end before a space (G2.19: what is
// indented under a line is that line's argument).
{at}.ends({limit}, {wanted}, {longest}) =>
  first := None
  last := None
  here := at.next
  crossed := None
  going := true
  while going
    at_limit := here === limit
    keep := at_limit
    unless crossed
      keep = true
    c := None
    if here
      c = here.character
    if keep
      if wanted
        keep = None
        if c === wanted
          keep = true
        if wanted === space
          if c === end
            keep = true
    if keep
      link := external node
      link.place = here
      if longest
        link.next = first
        first = link
      unless longest
        if c === end
          link.next = first
          first = link
          unless last
            last = link
        unless c === end
          if last
            last.next = link
          unless last
            first = link
          last = link
    if at_limit
      going = None
    unless here
      going = None
    if going
      here = here.next
      // past a line end only `limit`
      if c === end
        crossed = true
        here = limit
  first

// The statement from `at` to `limit` indexed (R2.5, so a capture need not walk it for each rule): up to the first line end
// (a capture ends past it only at `limit`, where no literal after it can start) every character keeps the places it is at,
// latest first, and every place the next place of its character (`next_same`). Answers the index's stamp; what the
// characters and places keep is this statement's while their `stamp` is it. Made again when another statement was indexed
// since.
{at}.indexed({limit}) =>
  stamp := at.index
  fresh := None
  if stamp
    if stamp.to === limit
      if registry.indexed === stamp
        fresh = true
  unless fresh
    stamp = external node
    stamp.to = limit
    at.index = stamp
    registry.indexed = stamp
    here := at.next
    while here
      if here === limit
        here = None
      if here
        c := here.character
        here.stamp = stamp
        here.next_same = None
        unless c.stamp === stamp
          c.stamp = stamp
          c.places = None
          c.last_at = None
        link := external node
        link.place = here
        link.next = c.places
        c.places = link
        previous := c.last_at
        if previous
          previous.next_same = here
        c.last_at = here
        here = here.next
        if c === end
          here = None
  stamp

// The first place from `this` on, on its line and before `limit`, holding the character `c`, or nothing.
{this}.first_of({c}, {limit}) =>
  here := this
  going := true
  while going
    if here === limit
      here = None
    unless here
      going = None
    if going
      d := here.character
      if d === c
        going = None
      if d === end
        here = None
        going = None
    if going
      here = here.next
  here

// Whether a capture can end at `here` when `wanted` follows it (as `ends` keeps them).
{here}.can_end({wanted}) =>
  found := true
  if wanted
    found = None
    if here
      c := here.character
      if c === wanted
        found = true
      if wanted === space
        if c === end
          found = true
  found

// Whether `type` holds the places from `from` to `to`: its check, when it has one, else its own rules reading them whole.
{kind}.holds({from}, {to}) =>
  check := kind.check
  found := None
  if check
    // the captures, given as values in the order the check's head names them
    to_given := external node
    to_given.value = to
    from_given := external node
    from_given.value = from
    from_given.next = to_given
    given := external node
    given.value = kind
    given.next = from_given
    here := external .
    found = external apply check given here
  unless check
    own := kind.rules
    found = from.reading(to, own)
  found

{at}.captured({pieces}, {limit}, {mode}) =>
  name := pieces.capture
  rest_pieces := pieces.next
  // a capture followed by a literal ends only where that literal starts
  wanted := None
  if rest_pieces
    if rest_pieces.literal
      next_from := rest_pieces.from
      wanted = next_from.character
  ends := None
  same := None
  indexed := None
  // a leading capture with a literal after it: the places that literal can start at, from the statement's index
  if pieces.leading
    if wanted
      unless pieces.optional
        stamp := at.indexed(limit)
        if wanted.stamp === stamp
          ends = wanted.places
        if wanted === space
          if end.stamp === stamp
            line_end := end.places
            at_line_end := external node
            at_line_end.place = line_end.place
            at_line_end.next = ends
            ends = at_line_end
        indexed = true
  // any other with a literal after it: the places from `at` where that literal starts, the shortest first (a line end first,
  // G2.19), on the line `at` is on in the statement indexed last (when it was indexed up to the same `limit`)
  unless indexed
    if wanted
      unless pieces.leading
        unless pieces.optional
          stamp := registry.indexed
          first_place := None
          if stamp.to === limit
            first_place = at.next
          if first_place
            if first_place.stamp === stamp
              indexed = true
              same = first_place.first_of(wanted, limit)
              if wanted === space
                if end.stamp === stamp
                  line_end := end.places
                  at_line_end := external node
                  at_line_end.place = line_end.place
                  ends = at_line_end
  // the last piece of a head read whole ends where the statement does
  unless rest_pieces
    unless mode
      unless at === limit
        ends = external node
        ends.place = limit
        indexed = true
  unless indexed
    ends = at.ends(limit, wanted, pieces.leading)
  // read on a receiver, a capture that ends the head reads one operand
  if mode
    unless rest_pieces
      ends = None
      operand_at := at.spaces_after
      unless operand_at
        operand_at = at
      operand := operand_at.operand_end(limit)
      if operand
        ends = external node
        ends.place = operand
  // an optional capture may hold nothing: tried after every other end
  optional := None
  if pieces.optional
    optional = at.can_end(wanted)
  if optional
    empty := external node
    empty.place = at
    tail := ends
    unless tail
      ends = empty
    while tail
      following := tail.next
      unless following
        tail.next = empty
      tail = following
  piece_type := pieces.type
  found := None
  going := true
  while going
    // the next end: from the chain `ends`, then the places of the wanted character (`same`)
    e := None
    worth := None
    if ends
      e = ends.place
      worth = true
      ends = ends.next
    unless worth
      if same
        e = same
        worth = true
        same = same.next_same
    unless worth
      going = None
    if worth
      if piece_type
        unless at === e
          worth = piece_type.holds(at, e)
    // a capture taken as written that ends the head takes one word
    if worth
      if pieces.raw
        unless rest_pieces
          if at.spaced(e)
            worth = None
    rest := None
    if worth
      rest = e.readings(rest_pieces, limit, mode)
    if rest
      cap := external node
      cap.name = name
      cap.piece = pieces
      if piece_type
        cap.type = piece_type
      raw := pieces.raw
      if raw
        cap.raw = true
      cap.from = at
      cap.to = e
      earlier := rest.captures
      cap.next = earlier
      rest.captures = cap
      found = rest
      going = None
  found

// Where the reader keeps what it knows of its rules: the `latest` defined, and the `definer` (the first statement's rule).
registry := external node

// The scope the reader is read in: the top.
top := external .

// The rules in reach of `scope`: each scope's `rules`, nearest scope first (its parents through `parent`), latest first;
// stopping before the scope `outside` (a value's own rules and its classes', not the top scope's).
{scope}.rules_in_reach({outside}) =>
  first := None
  last := None
  here := scope
  if here === outside
    here = None
  while here
    links := here.rules
    while links
      link := external node
      r := links.rule
      link.rule = r
      if last
        last.next = link
      unless last
        first = link
      last = link
      links = links.next
    here = here.parent
    if here === outside
      here = None
  first

// Whether one of `pieces` is a literal spelling the definer (learned from the first statement).
{pieces}.spells_the_definer =>
  piece := pieces
  found := None
  while piece
    if piece.literal
      lit_from := piece.from
      lit_to := piece.to
      if lit_from.spells_chain(lit_to, defining)
        found = true
        piece = None
    if piece
      piece = piece.next
  found

// Whether the places from `from` to `to` spell the chain `chain` (which ends by itself).
{from}.spells_chain({to}, {chain}) =>
  here := from
  wanted := chain
  result := true
  going := true
  while going
    here_done := here === to
    unless wanted
      going = None
      unless here_done
        result = None
    if going
      if here_done
        going = None
        result = None
    if going
      c := here.character
      w := wanted.character
      unless c === w
        result = None
        going = None
      if going
        here = here.next
        wanted = wanted.next
  result

// Whether the chain `a` has more pieces than the chain `b` (walked side by side: there are no integers).
{a}.longer_than({b}) =>
  x := a
  y := b
  going := true
  while going
    unless x
      going = None
    unless y
      going = None
    if going
      x = x.next
      y = y.next
  result := None
  if x
    unless y
      result = true
  result

// Whether two rules are written with the same head (their heads spell the same).
{a}.alike({b}) =>
  x := a.head_from
  x_end := a.head_to
  y := b.head_from
  y_end := b.head_to
  result := true
  going := true
  while going
    x_done := x === x_end
    y_done := y === y_end
    if x_done
      going = None
      unless y_done
        result = None
    if going
      if y_done
        going = None
        result = None
    if going
      c := x.character
      d := y.character
      unless c === d
        result = None
        going = None
      if going
        x = x.next
        y = y.next
  result

// Whether the head `pieces` is more particular than the head `other` (R2.5): walked side by side, character by character, at
// the first place where one has a literal and the other a capture, the one with the literal.
{pieces}.more_particular({other}) =>
  x := pieces
  y := other
  x_at := None
  y_at := None
  found := None
  going := true
  while going
    unless x
      going = None
    unless y
      going = None
    if going
      x_open := x.capture
      y_open := y.capture
      if x_open
        if y_open
          x = x.next
          y = y.next
        unless y_open
          going = None
      unless x_open
        if y_open
          found = true
          going = None
        unless y_open
          x_literal := x.literal
          y_literal := y.literal
          unless x_literal
            going = None
          unless y_literal
            going = None
          if going
            unless x_at
              x_at = x.from
            unless y_at
              y_at = y.from
            c := x_at.character
            d := y_at.character
            unless c === d
              going = None
          if going
            x_at = x_at.next
            y_at = y_at.next
            x_to := x.to
            y_to := y.to
            if x_at === x_to
              x = x.next
              x_at = None
            if y_at === y_to
              y = y.next
              y_at = None
  found

// Whether a reading by the head `pieces` is taken over one by the head `other` that reads as much (R2.5): the more particular;
// between two led by a literal, the one with more pieces; otherwise as `taken` says (by the order they were declared in).
{pieces}.chosen_over({other}, {taken}) =>
  chosen := taken
  more := pieces.more_particular(other)
  less := other.more_particular(pieces)
  if more
    chosen = true
  if less
    chosen = None
  unless more
    unless less
      if pieces.literal
        if other.literal
          if pieces.longer_than(other)
            chosen = true
          if other.longer_than(pieces)
            chosen = None
  chosen

// What reads the statement from `at` to `limit` with the rules in reach of `scope` (R2.5): every rule that reads it whole;
// between them, one led by a literal over one led by a capture; then one written with the same head as a later one gives way
// to it (`=>`), otherwise the one declared first reads it (G3.1). The rules come nearest scope first, latest first. Answers
// a node with the `rule` and its `captures`, or nothing.
{at}.reading_in({limit}, {scope}) =>
  rules := scope.rules_in_reach(None)
  at.reading(limit, rules)

{at}.reading({limit}, {rules}) =>
  best := None
  best_rule := None
  definer := registry.definer
  while rules
    rule := rules.rule
    pieces := rule.pieces
    r := at.readings(pieces, limit, None)
    if r
      take := true
      if best
        best_pieces := best_rule.pieces
        if rule.alike(best_rule)
          take = None
        take = pieces.chosen_over(best_pieces, take)
        // the rule that defines rules reads a definition whole, unless the other spells the definer itself (2026-10-06: a
        // method head with parameters is read by the rule written with the definer in it, not as a rule of that name)
        if rule.alike(definer)
          take = true
          if best_pieces.spells_the_definer
            take = None
        if best_rule.alike(definer)
          take = None
          if pieces.spells_the_definer
            take = true
      if take
        best = r
        best_rule = rule
    rules = rules.next
  if best
    best.rule = best_rule
  best

// What reads the most of the text from `at` before `limit` among `rules`, read on a receiver (R2.1): its `rule`, `captures` and
// `end`. Between readings that end at the same place, as `reading from … among` chooses.
{at}.prefix_reading({limit}, {rules}) =>
  best := None
  best_rule := None
  while rules
    rule := rules.rule
    pieces := rule.pieces
    r := at.readings(pieces, limit, true)
    if r
      take := true
      if best
        far := r.end
        best_far := best.end
        take = None
        unless far === best_far
          if best_far.reaches(far, limit)
            take = true
        if far === best_far
          take = true
          best_pieces := best_rule.pieces
          if rule.alike(best_rule)
            take = None
          take = pieces.chosen_over(best_pieces, take)
      if take
        best = r
        best_rule = rule
    rules = rules.next
  if best
    best.rule = best_rule
  best

// Whether the places from `at` to `limit` hold a space.
{at}.spaced({limit}) =>
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === space
        found = true
        here = None
      if here
        here = here.next
  found

// One statement of a body, as a step (R0.4): a call of an external (`access name arguments…`), a rule with its captures, one
// word, or what nothing reads.
{at}.step({limit}, {scope}) =>
  made := external node
  made.from = at
  made.to = limit
  led := at.spelled(access)
  called := None
  if led
    after := led.end
    c := after.character
    if c === space
      called = after.next
  if called
    made.external = true
    words := called.words(limit)
    first := words.from
    made.name_from = first
    last := words.to
    made.name_to = last
    rest := words.next
    made.arguments = rest
  unless called
    r := at.reading_in(limit, scope)
    if r
      rule := r.rule
      made.rule = rule
      caps := r.captures
      made.captures = caps
    unless r
      // what no rule in reach reads whole: its first operand, read when it runs, and the rest read by that value's rules
      split := at.operand_end(limit)
      sending := None
      if split
        unless split === limit
          sending = registry.sender
      if sending
        sender := registry.sender
        made.rule = sender
        pieces := sender.pieces
        receiver_piece := pieces
        rest_piece := receiver_piece.next
        rest_piece = rest_piece.next
        rest_cap := external node
        rest_cap.piece = rest_piece
        rest_cap.from = split
        rest_cap.to = limit
        rest_cap.raw = true
        receiver_cap := external node
        receiver_cap.piece = receiver_piece
        receiver_cap.from = at
        receiver_cap.to = split
        receiver_cap.next = rest_cap
        made.captures = receiver_cap
      unless sending
        unless at.spaced(limit)
          made.word = true
  made

// Where the first operand from `at` ends: after a bracketed group, quoted text, or a word (up to a space, a bracket or a
// dot). Nothing when there is none.
{at}.operand_end({limit}) =>
  c := at.character
  found := None
  shut := c.closer
  if shut
    found = at.balanced_end(limit)
  unless shut
    if c === quote
      here := at.next
      while here
        if here === limit
          here = None
        if here
          d := here.character
          if d === quote
            found = here.next
            here = None
          if here
            here = here.next
  unless found
    unless shut
      unless c === quote
        here = at
        while here
          stop := here === limit
          unless stop
            d = here.character
            if d === space
              stop = true
            if d.closer
              stop = true
            if d === dot
              stop = true
          unless stop
            unless here === at
              stop = here.starts_a_base_rule
          if stop
            unless here === at
              found = here
            here = None
          if here
            here = here.next
  found

// Whether one of the base's rules (what every value has: `Node`'s operators) starts with a literal spelled at `at`: an
// operand ends there (the operators the language defines decide where a word ends).
{at}.starts_a_base_rule =>
  base := registry.base
  found := None
  if base
    links := base.rules
    while links
      rule := links.rule
      pieces := rule.pieces
      first_from := pieces.from
      first_to := pieces.to
      if pieces.literal
        if at.spells(first_from, first_to)
          found = true
          links = None
      if links
        links = links.next
  found

// The place after the bracket that closes the one at `at`.
{at}.balanced_end({limit}) =>
  open_ones := None
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if open_ones
          expected := open_ones.shut
          if c === expected
            open_ones = open_ones.next
            unless open_ones
              found = here.next
              here = None
      if here
        here = here.next
  found

// The words from `at` to `limit`, separated by spaces: a chain of `from`, `to`.
{at}.words({limit}) =>
  first := None
  last := None
  here := at
  start := at
  while here
    stop := here === limit
    unless stop
      c := here.character
      if c === space
        stop = true
    if stop
      unless start === here
        word := external node
        word.from = start
        word.to = here
        if last
          last.next = word
        unless last
          first = word
        last = word
      if here === limit
        here = None
      if here
        here = here.next
        start = here
    unless stop
      here = here.next
  first

// The first place from `at` that is not a space, a line end or a comment (`//` to the line's end, skipped before any rule
// reads it: comments say anything, definitions included), or nothing before `to`.
{at}.skip_blank({to}) =>
  here := at
  found := None
  while here
    if here === to
      here = None
    if here
      c := here.character
      skip := None
      if c === space
        skip = true
      if c === end
        skip = true
      if c === slash
        following := here.next
        if following
          f := following.character
          if f === slash
            skip = true
            going := true
            while going
              following = here.next
              unless following
                going = None
              if following === to
                going = None
              if going
                d := following.character
                if d === end
                  going = None
              if going
                here = following
      unless skip
        found = here
        here = None
      if here
        here = here.next
  found

// The statements of a body from `from` to `to`, each at the body's indentation `base`: a chain of steps.
{from}.plan({to}, {base}, {scope}) =>
  first := None
  last := None
  at := from
  while at
    if at === to
      at = None
    if at
      at = at.skip_blank(to)
    if at
      limit := at.statement_end(to, base)
      made := at.step(limit, scope)
      if last
        last.next = made
      unless last
        first = made
      last = made
      at = None
      if limit
        unless limit === to
          at = limit.next
          if base
            based := at.spelled(base)
            if based
              at = based.end
  first

// Bodies are planned by the rule defined last (R0.6), once the seed's rules are the reader's.
planned_by := external rules top
plan_rule := planned_by.rule

// ---------------------------------------------------------------- heads read in Ray (R2.2)
open := learned.open
close := learned.close

// The place of the bracket that closes one opened just before `at`, or nothing when another opens first or none closes.
{at}.closing({limit}) =>
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === open
        here = None
      if here
        if c === close
          found = here
          here = None
      if here
        here = here.next
  found

// A piece of a head, added to the chain `into` (a node with `first` and `last`).
{into}.add({kind}, {piece_from}, {piece_to}) =>
  made := external node
  made.from = piece_from
  made.to = piece_to
  external set made kind true
  last := into.last
  if last
    last.next = made
  unless last
    into.first = made
  into.last = made

// The pieces of a head: a capture is the brackets around a name (its first word), brackets around brackets are literal,
// the rest is literal. A chain of `literal`/`capture`, each with `from` and `to`.
{head_from}.pieces({head_to}, {like}) =>
  into := external node
  at := head_from
  start := head_from
  while at
    if at === head_to
      at = None
    if at
      c := at.character
      captured := None
      if c === open
        inner := at.next
        shut := inner.closing(head_to)
        if shut
          unless inner === shut
            captured = true
      if captured
        unless start === at
          into.add(literal, start, at)
        inner.held(shut, into, like)
        at = shut.next
        start = at
      unless captured
        at = at.next
  unless start === head_to
    into.add(literal, start, head_to)
  into.first

// What a capture's brackets hold (R2.2): spaces only, a gap; `\n`, a line end; text in backticks, a literal; `literal`
// and a name, a capture taken as written; a name ending in `?`, a capture that may hold nothing; a name ending in `:` and a
// type, a typed capture (the type read once, here). Anything after the name (`^style`) is the highlighting's.
{inner}.held({shut}, {into}, {like}) =>
  c := inner.character
  done := None
  if c === space
    rest := inner.spaces_after
    if rest === shut
      into.add(gap, inner, shut)
      done = true
  unless done
    if c === backtick
      lit_from := inner.next
      lit_to := lit_from.closing_backtick(shut)
      if lit_to
        into.add(literal, lit_from, lit_to)
        done = true
  unless done
    if c === backslash
      n := inner.next
      d := n.character
      if d === letter_n
        after_n := n.next
        if after_n === shut
          into.add(line_end, inner, shut)
          done = true
  unless done
    name_from := inner
    name_end := inner.word_end(shut)
    raw := None
    if name_from.spells_word(raw_word, name_end)
      unless name_end === shut
        raw = true
        name_from = name_end.next
        name_end = name_from.word_end(shut)
    last_char := name_from.last_place(name_end)
    l := last_char.character
    optional := None
    if l === question
      optional = true
    typed := name_from.typed_name(name_end)
    bare := name_end
    if optional
      bare = last_char
    if typed
      bare = typed.name_end
    leading := None
    unless into.first
      leading = true
    into.add(capture, name_from, bare)
    made := into.last
    if raw
      made.raw = true
    if optional
      made.optional = true
    if leading
      made.leading = true
    if typed
      type_from := name_end.next
      capture_type := external read type_from shut like
      made.type = capture_type

// The place of the backtick that closes one, from `at`, before `limit`.
{at}.closing_backtick({limit}) =>
  here := at
  found := None
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === backtick
        found = here
        here = None
      if here
        here = here.next
  found

// The last place from `at` before `limit`.
{at}.last_place({limit}) =>
  here := at
  found := at
  while here
    if here === limit
      here = None
    if here
      found = here
      here = here.next
  found

// Whether the places from `at` to `limit` spell the word written from `word . from` to `word . to`.
{at}.spells_word({word}, {limit}) =>
  x := word.from
  x_end := word.to
  y := at
  result := true
  going := true
  while going
    x_done := x === x_end
    y_done := y === limit
    if x_done
      going = None
      unless y_done
        result = None
    if going
      if y_done
        going = None
        result = None
    if going
      c := x.character
      d := y.character
      unless c === d
        result = None
        going = None
      if going
        x = x.next
        y = y.next
  result

// Where the word from `at` ends: at a space, or at `limit`.
{at}.word_end({limit}) =>
  here := at
  found := limit
  while here
    if here === limit
      here = None
    if here
      c := here.character
      if c === space
        found = here
        here = None
      if here
        here = here.next
  found

// A capture's name written with its type (`{d: Digit}`): the name ends before the colon. Answers a node with `name_end`, or nothing.
raw_word := external span literal
{at}.typed_name({limit}) =>
  here := at
  before := None
  while here
    if here === limit
      here = None
    if here
      before = here
      here = here.next
  found := None
  if before
    c := before.character
    if c === colon
      found = external node
      found.name_end = before
  found

// A rule kept where it reads rules: on its scope's `rules`, latest first; the registry's `latest`.
{made}.keep =>
  scope := made.scope
  link := external node
  link.rule = made
  earlier := scope.rules
  link.next = earlier
  scope.rules = link
  registry.latest = made
  made

// The seed's rules, taken over once: the top scope's, latest first; the earliest is the first statement's.
take_over_the_seeds_rules =>
  imported := external rules top
  top.rules = imported
  registry.top = top
  last := imported
  while last
    first_statement := last.rule
    last = last.next
  registry.definer = first_statement
  registry.latest = imported.rule

// A type: a scope of the rules its block defines (R2.3).
type {block} =>
  made := external node
  external apply block None made
  made

// Rules defined from here on are read by their heads in Ray.
{pattern} => {body} =>
  where := external span pattern
  head_from := where.from
  head_to := where.to
  pieces := head_from.pieces(head_to, pattern)
  made := external define pattern pieces body
  made.keep

take_over_the_seeds_rules
external planner plan_rule

// One statement read at the top: applied in place, or reported. Answers the place after it.
{given}.read_statement =>
  here := external .
  scope := here.parent
  at := given.skip_blank(None)
  limit := None
  if at
    limit = at.statement_end(None, None)
  if at
    made := at.step(limit, scope)
    rule := made.rule
    if rule
      caps := made.captures
      external apply rule caps scope
    unless rule
      external report at limit
  after := None
  if limit
    after = limit.next
  after

reader := registry.latest
external reader reader

// The rules a value is read by (R2.1): its own and its classes' (not the top scope's), then what every value has.
{value}.reading_rules =>
  top := registry.top
  rules := value.rules_in_reach(top)
  base := registry.base
  base_rules := base.rules
  if rules
    last := rules
    while last
      following := last.next
      unless following
        last.next = base_rules
      last = following
  unless rules
    rules = base_rules
  rules

// ---------------------------------------------------------------- values with rules of their own (R2.1: a rule is a method)
// What a statement's first operand is read as, when no rule in reach reads it whole: the rest is read by that value's rules,
// applied with `this` bound to it.
{this}.sent({rest}) =>
  where := external span rest
  at := where.from
  rest_to := where.to
  within := where.frame
  sender := registry.sender
  sender_pieces := sender.pieces
  this_piece := sender_pieces
  // the first receiver is a place (its code, unread): what it holds is read for its rules only when it holds something
  current := this
  value := None
  receiver_at := external span this
  frame := receiver_at.frame
  held := None
  while frame
    held = external get frame this
    if held
      frame = None
    if frame
      frame = frame.parent
  if held
    value = held
  unless held
    // not a name a frame holds: a group, quoted text, or a name nothing holds yet (a place)
    first_place := receiver_at.from
    c := first_place.character
    if c.closer
      value = this
    if c === quote
      value = this
  result := current
  going := true
  while going
    rules := value.reading_rules
    r := at.prefix_reading(rest_to, rules)
    unless r
      spaced := at.spaces_after
      if spaced
        at = spaced
        r = at.prefix_reading(rest_to, rules)
    unless r
      external report at rest_to
      going = None
    if r
      rule := r.rule
      caps := r.captures
      bound := external node
      bound.piece = this_piece
      bound.value = current
      bound.next = caps
      result = external apply rule bound within
      at = r.end
      if at === rest_to
        going = None
      current = result
      value = result
  result

sent_rule := registry.latest
registry.sender = sent_rule

// ---------------------------------------------------------------- types with a check: characters, repetition (R2.2)
{check}.checked =>
  made := external node
  made.check = check
  made

// One character, any.
{kind}.one_character({from}, {to}) =>
  following := from.next
  following === to
Char := registry.latest.checked

// One character, not `excluded`.
{kind}.one_character_except({from}, {to}) =>
  following := from.next
  found := None
  if following === to
    c := from.character
    excluded := kind.excluded
    unless c === excluded
      found = true
  found
except_rule := registry.latest
{c}.anything_but =>
  made := except_rule.checked
  made.excluded = c
  made

// One or more of `item`, one after another.
{kind}.one_or_more({from}, {to}) =>
  item := kind.item
  e := from.next
  found := None
  going := true
  while going
    if item.holds(from, e)
      if e === to
        found = true
      unless found
        unless e === to
          found = kind.one_or_more(e, to)
    if found
      going = None
    if e === to
      going = None
    if going
      e = e.next
  found
many_rule := registry.latest
{item}[] =>
  made := many_rule.checked
  made.item = item
  made

// ---------------------------------------------------------------- text written in quotes
Unquoted := quote.anything_but
Quoted := Unquoted[]
"{text: Quoted}" =>
  external span text

// ---------------------------------------------------------------- brackets: what they hold is balanced
// Balanced text: every bracket it opens it closes, in order, and it closes none it did not open; quoted text is skipped.
{kind}.balanced({from}, {to}) =>
  open_ones := None
  here := from
  ok := true
  while here
    if here === to
      here = None
    if here
      c := here.character
      shut := c.closer
      if shut
        pushed := external node
        pushed.shut = shut
        pushed.next = open_ones
        open_ones = pushed
      unless shut
        if c.closes
          unless open_ones
            ok = None
            here = None
          if open_ones
            expected := open_ones.shut
            unless c === expected
              ok = None
              here = None
            if here
              open_ones = open_ones.next
        if c === quote
          here = here.next
          skipping := here
          while skipping
            if skipping === to
              ok = None
              skipping = None
              here = None
            if skipping
              d := skipping.character
              if d === quote
                here = skipping
                skipping = None
              if skipping
                skipping = skipping.next
      if here
        here = here.next
  if open_ones
    ok = None
  ok
Balanced := registry.latest.checked

// A group: what is in brackets is read as itself.
({inside: Balanced}) =>
  inside

// ---------------------------------------------------------------- what every value has (the base)
Node := type
  .{literal property} =>
    external get this property
  .{literal property} = {value} =>
    external set this property value
  // `,` composes one value, a list (no split, 2026-09-27): `a, b, c` is the list of `a`, `b` and `c`, each as written (a
  // place or a value, read when it is used).
  ,{other} =>
    list := None
    known := external span this
    unless known
      list = this
      unless list.listing
        list = None
    unless list
      list = external node
      list.listing = true
      first := external node
      first_item := external ** this
      first.item = first_item
      list.first = first
      list.last = first
    added := external node
    other_item := external ** other
    added.item = other_item
    last := list.last
    last.next = added
    list.last = added
    list
registry.base = Node

// ---------------------------------------------------------------- classes
// A class is the frame its block is read in (its statics and its methods are that frame's); calling it makes an instance: a
// frame of its own, made by a rule written in the class (so the class is around it), with the block read again in it.
class {block} =>
  static := external .
  external apply block None static
  instance frame =>
    external .
  ({args?}) =>
    instance := instance frame
    external apply block None instance
    if args
      external apply args None instance
    instance
  static

// ---------------------------------------------------------------- methods: `name (a, b) => body`
// A method is a rule whose head is its name and its parameters, each a capture: `foo (a, b) => …` is `foo({a}, {b})`, so a call
// binds each argument to its parameter by reading, as any rule's captures are.
parentheses := external span ()
comma_written := external span ,
{name} ({parameters?}) {`=>`} {body} =>
  name_at := external span name
  pieces := external node
  name_from := name_at.from
  name_to := name_at.to
  pieces.add(literal, name_from, name_to)
  // the brackets as written here
  open_at := parentheses.from
  close_at := open_at.next
  close_end := close_at.next
  pieces.add(literal, open_at, close_at)
  parameters_at := external span parameters
  if parameters_at
    at := parameters_at.from
    stop := parameters_at.to
    start := at
    while at
      ending := at === stop
      unless ending
        c := at.character
        if c === comma
          ending = true
      if ending
        pieces.add(capture, start, at)
        if at === stop
          at = None
        if at
          comma_from := comma_written.from
          comma_to := comma_written.to
          pieces.add(literal, comma_from, comma_to)
          at = at.next
          spaced := at.spaces_after
          if spaced
            pieces.add(gap, at, spaced)
            at = spaced
          start = at
      unless ending
        at = at.next
  pieces.add(literal, close_at, close_end)
  chain := pieces.first
  made := external define name chain body
  made.keep
