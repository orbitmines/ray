Network &+= {
  static Port = Decimal{< 2^16}

  static DomainName := class (text: (Char.Letter | Char.Digit | "-" | ".")[]) => {
    valid => 0 < text.count < 2^8
    static canonical := DomainName{text == text.fold_case}
  }

  static Proxy := class = through: Character, admits: *? {
    carries (traffic) => !admits || traffic is admits
  }

  static Protocol := enum ether (port: @ether.port) | https (port: 443) | http (port: 80) | ssh (port: 22) | wss (port: 443) | ws (port: 80) | dns (port: 53)

  static URL := Location{scheme}

  static Socket := class {
    static Address := class (("[", host: IPv6, "]") | host: IPv4 | host: DomainName, ":", port: Port) => {
      send (bytes: Byte[]) => external network `tcp` (this as String, bytes)
      datagram (bytes: Byte[]) => external network `udp` (this as String, bytes)
      // TLS 1.3 (https://www.rfc-editor.org/rfc/rfc8446) with ALPN (https://www.rfc-editor.org/rfc/rfc7301): the
      // connection, and the protocol of `offered` the two sides agreed on.
      tls (offered: String[]) => external network `tls` (this as String, offered) as (connection: *, protocol: String?)
    }
  }

  static Hosts := class {
    static equivalences => @/etc/hosts.content as Unicode.Table<(address: (!" " && !"\t")[], (" " | "\t")[], names: (!" " && !"\t")[].join((" " | "\t")[]))>
    // A redirect is a world name (W1.9, `@name = holder`), so it passes the world's write check like any name.
    static resolved (name: String) => World.current["@", name] -- (held => held is Location ? held
      : DomainName(equivalences.rows{name.fold_case is .names.fold_case#}.last?.address ?? name))
  }
}

Effecting |= Program{effects.some(. is "network")}

Location &+= {
  static canonical := Location{!port || port != protocol?.port}
  protocol => Network.Protocol#{as String == scheme}.first
  resolved => Network.Hosts.resolved(host) -- (. == host ? $.dns.resolve(host) ?? . : .)
  socket => Network.Socket.Address(host: host, port: port ?? protocol?.port)
}

Device &+= {
  network: (mac: Binary₄₈, connected: boolean) = (mac: (external os `mac_address`) ?? (Binary₄₈.random ~~ .[7] = 1), connected: (external network `connected`) ?? false)
}

Instance &+= {
  seen_from (other: Instance) => other === this ? @localhost : this
  local => this is @localnetwork
  canonical: static => this as Location.canonical
}

{address: Network.URL | Network.Socket.Address | IP | Network.DomainName}: Instance => (address as String) as Instance
