// Comparisons chain; operators group by the order Number declares them.

mark ^keyword := global

unless 1 < 2 < 3 { INFO@mark `PR3 one below two below three does not hold` }
if 3 < 2 < 1 { INFO@mark `PR4 three below two below one holds` }
if 1 < 3 < 2 { INFO@mark `PR5 a chain that breaks at the end holds` }
if 2 < 1 < 3 { INFO@mark `PR6 a chain that breaks at the start holds` }
unless 3 > 2 > 1 { INFO@mark `PR16 three above two above one does not hold` }
if 1 > 2 > 3 { INFO@mark `PR17 one above two above three holds` }
unless 1 <= 2 <= 3 { INFO@mark `PR18 a chain of at-mosts does not hold` }
if 1 <= 3 <= 2 { INFO@mark `PR19 a chain of at-mosts that breaks holds` }
unless 3 >= 2 >= 1 { INFO@mark `PR20 a chain of at-leasts does not hold` }
unless 1 == 1 == 1 { INFO@mark `PR21 a chain of sames does not hold` }
if 1 == 1 == 2 { INFO@mark `PR22 a chain of sames that breaks holds` }
unless 0 <= 1 <= 1 { INFO@mark `PR36 a probability's bounds do not chain` }

{start} - {once} - {twice} => (start - once) - twice
unless 10 - 2 - 3 == 5 { INFO@mark `PR1 ten less two less three is not five` }
unless (10 + 10) - 4 - 6 == 10 { INFO@mark `PR2 twenty less four less six is not ten` }

unless 1 + 2 == 3 { INFO@mark `PR7 one and two is not three` }
unless 1 < 2 { INFO@mark `PR8 one is not below two` }
if 2 < 1 { INFO@mark `PR9 two is below one` }
unless 2 * 3 == 6 { INFO@mark `PR10 an operator the rule does not ask for stopped working` }
unless 10 - 2 == 8 { INFO@mark `PR11 one less on its own stopped working` }
unless 1 + 2 + 3 == 6 { INFO@mark `PR12 three added is not six` }

unless 2 * 3 + 1 == 7 { INFO@mark `PR23 two times three and one is not seven` }
unless 1 + 2 * 3 == 7 { INFO@mark `PR24 one and two times three is not seven` }
unless 10 / 2 / 5 == 1 { INFO@mark `PR25 ten shared twice is not one` }
unless 2 * 3 * 2 == 12 { INFO@mark `PR26 two times three times two is not twelve` }
unless 10 - 4 * 2 == 2 { INFO@mark `PR27 ten less four times two is not two` }
unless 1 + 2 < 4 { INFO@mark `PR28 one and two is not below four` }
if 4 < 1 + 2 { INFO@mark `PR29 four is below one and two` }
unless 1 + 2 == 3 { INFO@mark `PR30 one and two is not three` }
unless 3 == 1 + 2 { INFO@mark `PR31 three is not one and two` }
if 2 * 3 < 5 { INFO@mark `PR32 two times three is below five` }
unless 1 + 2 >= 3 { INFO@mark `PR33 one and two is not at least three` }
if 1 + 2 > 4 { INFO@mark `PR34 one and two is above four` }
unless 4 >= 1 + 2 { INFO@mark `PR35 four is not at least one and two` }
unless 2 ^ 3 * 2 == 16 { INFO@mark `PR37 raising does not bind tighter than times` }
unless 1 + 2 as String == "3" { INFO@mark `PR38 as does not bind looser than plus` }
