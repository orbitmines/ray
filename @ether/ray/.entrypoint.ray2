first =>
  .
rest =>
  []

// Whether a name is defined where it is read (the lookup's first layer only, not further out): `here x`.
here {name} =>
  goto defined
  {name}
  false
assert {
  here := 0
  there := 0
  here = 1 ; there = 2
  // CF18 the first of two assignments on one line did not run
  assert here == 1
  // CF19 the second of two assignments on one line did not run
  assert there == 2
}

// Names given values at once: `(a, b) := list`, each the next value in it (`:=`, below, reads it so).
({name}) from {list} =>
  {name} := {list}.first
({name}, {names}) from {list} =>
  {name} := {list}.first
  ({names}) from {list}.rest

// A closure with parameters called with none, `f()`: called with nothing given (each its default). (One without parameters
// has its own `()`, read first.)
() =>
  . (declared)

