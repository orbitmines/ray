None => @js $.none ??= new Ray()
Word => @js $.word ??= Object.assign(new Ray(), { scope: true })
Node => @js $.base ??= new Ray()
this => @js $.self(F)
global => @js $.global
@made {x} => @js new Ray(x)
@same {a} {b} => @js $.name(F, (a ?? $.none) === (b ?? $.none) ? "true" : "false")
@declaring {name} => @js $.declaring(F.m.get("name"), F)
@show {x} => @js $.output($.show(x))
& => @js $.here(F)
@has {x} {name} => @js $.name(F, $.has(x, F.m.get("name").s.trim()) ? "true" : "false")
@of {x} => @js x instanceof Ray ? x.outer : undefined
@applies {x} => @js $.name(F, x instanceof Ray && x.eqs.some(eq => !("lit" in eq.pieces[0]) || eq.pieces[0].lit === "()") ? "true" : "false")
@declare {value} => @js $.declare(F, value, false)
@assign {value} => @js $.declare(F, value, true)
@inside {x} {type} => @js $.name(F, (() => { for (let n = x; n instanceof Ray; n = n.outer) if (n === type) return true; return false; })() ? "true" : "false")
@text {x} => @js F.m.get("x").s
@given {instance} {arguments} => @js $.given($.get(F, "instance"), $.written(F.m.get("arguments")))
@block {made} {code} => @js $.blocks.set($.get(F, "made"), $.written(F.m.get("code")))
@run {program} => @js $.ran($.get(F, "program"))
@kind {name} {class} => @js $.kinds.set(F.m.get("name").s.trim(), $.written(F.m.get("class")))
// a context of its own: what is read there is read by its rules alone (and by those of the context it continues into)
@context {outer} => @js Object.assign(new Ray(outer instanceof Ray && outer !== $.none ? outer : undefined), { scope: true, alone: true })
// text read in a context, whole; else nothing
@read {context} {text} => @js $.read_in($.get(F, "context"), $.get(F, "text"))
// what the language says a head is, and what is inside a capture in one: the context it is read in, and a closure from the text
// to what it writes
@heads {context} {reading} => @js ($.heads_by = $.get(F, "context"), $.heading = $.get(F, "reading"), undefined)
@captures {context} {reading} => @js ($.captures_by = $.get(F, "context"), $.capturing = $.get(F, "reading"), undefined)
// a form a head is defined as: as written, what it declares first; one applied with what is on its right, `this`
@form {written} {given} => @js $.form($.get(F, "written"), $.get(F, "given"))
// (a method given what follows it, after a space: a call, not what goes on from the line above)
@called {written} {given} => @js $.form($.get(F, "written"), $.get(F, "given"), undefined, false, true)
@applied {written} {receiver} => @js $.form($.get(F, "written"), undefined, $.get(F, "receiver"))
// a head read as another: the definition read again, with that one
@again {written} => @js $.form($.get(F, "written"), undefined, undefined, true)
// where a statement ends; what a capture is written between
@end => @js $.learned.end
@open => @js $.learned.open
@close => @js $.learned.close
// text after text
@joined {a} {b} => @js $.show($.get(F, "a")) + $.show($.get(F, "b"))
// text with no `separator` outside its brackets (read by `within` too, when that reads text)
@outside {separator} {within} => @js $.outside($.get(F, "separator"), $.get(F, "within"))
// Numbers: the host's own (a JS number), read where digits are written; a Number whose operations are the host's (loosest first).
// a symbol: no letters or digits (`..<`, `√`): what is written as one hugs what it takes
Symbolic => @js $.reader(s => s.length > 0 && !/[\p{L}\p{N}_\s]/u.test(s) ? s : undefined)
Numeral => @js $.reader(s => /^[0-9]+(\.[0-9]+)?$/.test(s) ? Number(s) : undefined)
{number Numeral} => number
@kind number HostNumber
HostNumber := class: Number {
  == {other} => @js $.name(F, F.self === $.get(F, "other") ? "true" : "false")
  != {other} => @js $.name(F, F.self !== $.get(F, "other") ? "true" : "false")
  < {other} => @js $.name(F, F.self < $.get(F, "other") ? "true" : "false")
  <= {other} => @js $.name(F, F.self <= $.get(F, "other") ? "true" : "false")
  > {other} => @js $.name(F, F.self > $.get(F, "other") ? "true" : "false")
  >= {other} => @js $.name(F, F.self >= $.get(F, "other") ? "true" : "false")
  + {other} => @js F.self + $.get(F, "other")
  - {other} => @js F.self - $.get(F, "other")
  * {other} => @js F.self * $.get(F, "other")
  / {other} => @js F.self / $.get(F, "other")
  % {other} => @js ((F.self % $.get(F, "other")) + $.get(F, "other")) % $.get(F, "other")
  ^ {other} => @js F.self ** $.get(F, "other")
  succ => @js F.self + 1
  pred => @js F.self - 1
  is_zero => @js $.name(F, F.self === 0 ? "true" : "false")
}
// `while c { body }`: the body again while `c` holds (every value but nothing and false), iterated by the host.
while {condition} {{body}} => @js (() => { for (const no = $.name(F, "false"); ;) { const c = $.get(F, "condition"); if (c === undefined || c === $.none || c === no) return undefined; $.get(F, "body"); } })()
// Text: the host's own (a JS string), a String whose operations are the host's.
@kind string HostString
@character {x} => @js String.fromCodePoint($.get(F, "x"))
HostString := class: String {
  == {other} => @js $.name(F, F.self === $.get(F, "other") ? "true" : "false")
  != {other} => @js $.name(F, F.self !== $.get(F, "other") ? "true" : "false")
  < {other} => @js $.name(F, F.self < $.get(F, "other") ? "true" : "false")
  > {other} => @js $.name(F, F.self > $.get(F, "other") ? "true" : "false")
  ..{last} =>
    made := []
    at := this.codepoint
    end := (last).codepoint
    while at <= end {
      made.append(@character at)
      at = at + 1
    }
    made
  + {other} => @js F.self + $.show($.get(F, "other"))
  codepoint => @js F.self.codePointAt(0)
  length => @js [...F.self].length
}
// Types read text (a type in a rule where statements are read): which fields hold what the language's types are made of.
@js $.patterns = { superposed: "superposes", alternatives: "components", narrowed: "narrows", constraint: "constraint", repeated: "of", sequence: "head", value: "value", next: "next", one: "Char", read_by: { Number: "Numeral", String: "Text" } }
// any text (what reads a String written in a rule's head)
Text => @js $.reader(s => s)
