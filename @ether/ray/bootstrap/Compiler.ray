  static aside_count => (aside_or_none() == None) ? 0 : Texts.count_of(aside_or_none())
  static in_order (item, f, args, pos) => {
    at := pos
    while (at < textend) && (stopped() == 0) {
      at = Turns.statement_turn(item, f, args, pos, at)
      return (0 - at) - 1 if at < 0
    }
    at
