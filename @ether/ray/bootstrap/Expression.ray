// Texts: what the language's own levels ask of a text (`level cw_…`: trimmed, inside its brackets, enclosed, a span), and
// what reading one asks too (its words, where a quote or a bracket closes); what the back end's compiler asks besides is
// its own (`$/Wasm.project.ray`'s `Writing`).
Texts := class {
  static trimmed_text (from, to) => {
    a := from
    e := to
    while (a < e) && white(byte(a)) {
      a = a + 1
    }
    while (e > a) && white(byte(e - 1)) {
      e = e - 1
    }
    text(a, e)
  }
  static at_text (q, e, a, z) => ((q + (z - a)) > e) ? 0 : texteq(q, a, z - a)
  static word_byte (c) => ((c >= 97) && (c <= 122)) || ((c >= 65) && (c <= 90)) || ((c >= 48) && (c <= 57)) || (c == 95)
  static cw_trimmed (t: Text) => (t is Text) ? Texts.trimmed_text(t.from, t.to) : t
  static cw_inner (t: Text) => ((t is Text) && ((t.to - t.from) >= 2)) ? text(t.from + 1, t.to - 1) : None
  static cw_span_of (t: Text, x: Text) => ((t is Text) && (x is Text)) ? text(t.from, x.to) : None
  // (whether a text, trimmed, is one bracket's: opened at its start, closed only at its end, what is quoted passed over)
  static cw_enclosed (t: Text) => Texts.enclosed_in(Texts.trimmed_text(t.from, t.to))
  static enclosed_in (u: Text) => (((u.to - u.from) >= 2) && (opener(byte(u.from)) != 0) && Texts.closed_last(u.from, u.to)) ? true : false
  static closed_last (a, e) => {
    d := 0
    q := a
    while q < e {
      d = d + Texts.depth_change(byte(q))
      return 0 if (closer(byte(q)) != 0) && (d == 0) && ((q + 1) < e)
      q = Texts.quote_byte(byte(q)) ? Texts.quote_skipped(q + 1, e, byte(q)) : q
      q = q + 1
    }
    closer(byte(e - 1)) != 0
  }
  static depth_change (c) => (opener(c) != 0) ? 1 : ((closer(c) != 0) ? (0 - 1) : 0)
  static quote_byte (c) => (c == 34) || (c == 96)
  static quote_skipped (from, e, c) => {
    q := from
    while (q < e) && (byte(q) != c) {
      q = ((byte(q) == 92) && (c == 34)) ? (q + 2) : (q + 1)
    }
    q
  }
  static same_text (x: Text, t: Text) => (x is Text) && ((x.to - x.from) == (t.to - t.from)) && texteq(x.from, t.from, t.to - t.from)
  static count_of (l: List) => l.count
}
// Splices (`level spliced …`): a capture, `open close` (what opens, a space, what closes), in a text: what is between an
// open and a close (or a doubled open and a doubled close) is a name, taken from a list of entries (each a key and a
// value, `take_named`: the value, trimmed, itself a capture of a name taken further on, that), and written in its place.
Splices := class {
  static Taken := (entry, past)
  static opening_end_at (from, to) => {
    oe := from
    while (oe < to) && (byte(oe) != 32) {
      oe = oe + 1
    }
    oe
  }
  static capture_ok (cap: Text, oe) => ((oe - cap.from) != 0) && ((oe + 1) < cap.to)
  static found_from (from, e, a, z) => {
    q := from
    while (q < e) && (at_text(q, e, a, z) == 0) {
      q = q + 1
    }
    q
  }
  static trimmed_of (v: Text) => Texts.trimmed_text(v.from, v.to)
  static spliced_entry (t: Text, cap: Text, l) => ((t is Text) && (cap is Text) && (l is List) && Splices.capture_ok(cap, Splices.opening_end_at(cap.from, cap.to))) ? Splices.entry_taken(t, cap, Splices.opening_end_at(cap.from, cap.to), l) : None
  static entry_taken (t, cap, oe, l) => {
    taken_reset()
    Splices.spliced_into(t, cap, oe, l, 0)
    taken_entry()
  }
  static spliced (t: Text, cap: Text, l) => ((t is Text) && (cap is Text) && (l is List) && Splices.capture_ok(cap, Splices.opening_end_at(cap.from, cap.to))) ? Splices.spliced_as(t, cap, Splices.opening_end_at(cap.from, cap.to), l, Splices.spliced_whole(t, cap, Splices.opening_end_at(cap.from, cap.to), l)) : t
  static spliced_as (t, cap, oe, l, whole) => (whole != None) ? whole : Splices.spliced_written(t, cap, oe, l, alloc_bytes(Splices.spliced_into(t, cap, oe, l, 0) + 8))
  static spliced_written (t, cap, oe, l, o) => text(o, o + Splices.spliced_into(t, cap, oe, l, o))
  // (how long the text is with each name taken, written to out unless it is 0)
  static spliced_into (t: Text, cap: Text, oe, l, out) => {
    n := 0
    q := t.from
    m := None
    while q < t.to {
      m = (at_text(q, t.to, cap.from, oe) != 0) ? Splices.single_or(((at_text(q + (oe - cap.from), t.to, cap.from, oe) != 0) ? Splices.doubled_found(q + ((oe - cap.from) * 2), Splices.found_from(q + ((oe - cap.from) * 2), t.to, oe + 1, cap.to), t.to, cap, oe, l) : None), q, t.to, cap, oe, l) : None
      n = (m === None) ? Splices.byte_copied(out, n, q) : Splices.taken_copied(out, n, m)
      q = (m === None) ? (q + 1) : Splices.past_of(m)
    }
    n
  }
  static past_of (m: Taken) => m.past
  static doubled_found (s, r, e, cap: Text, oe, l) => ((r < e) && (at_text(r + (cap.to - (oe + 1)), e, oe + 1, cap.to) != 0)) ? Splices.taken_or_none(take_named(s, r, l, cap.from, oe, cap.to), r + ((cap.to - (oe + 1)) * 2)) : None
  static single_or (m, q, e, cap: Text, oe, l) => (m === None) ? Splices.single_found(q + (oe - cap.from), Splices.found_from(q + (oe - cap.from), e, oe + 1, cap.to), e, cap, oe, l) : m
  static single_found (s, r, e, cap: Text, oe, l) => (r < e) ? Splices.taken_or_none(take_named(s, r, l, cap.from, oe, cap.to), r + (cap.to - (oe + 1))) : None
  static taken_or_none (x, past) => (x == 0) ? None : Taken(entry: x, past: past)
  static taken_copied (out, n, m: Taken) => Splices.copied_in(out, n, Splices.trimmed_of(m.entry))
  static copied_in (out, n, u: Text) => {
    Splices.copy_out(out + n, u.from, u.to - u.from) if out != 0
    n + (u.to - u.from)
  }
  static copy_out (o, s, k) => {
    copy(o, s, k)
    copied_from(o, s, k)
  }
  static byte_copied (out, n, q) => {
    Splices.byte_out(out + n, q) if out != 0
