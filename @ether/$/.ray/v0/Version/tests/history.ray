// Version control: one history that every language reads into and writes out of; Ray's own is the .% form.

mark ^keyword := external global

ada := Instance.local.login(Character(name: "ada"))

// A commit is any Ray, run on the value before it (`.`).
vh := History(repository: Repository())
vh.commit(ada, Program(code: { .greet = "hello" }))
unless vh.value.greet == "hello" { INFO@mark `VC1 a commit's program did not run on the value` }
vh.commit(ada, Program(code: { .welcome = .greet; .greet = None }))
unless vh.value.welcome == "hello" && vh.value.greet == None { INFO@mark `VC2 a renaming program did not rename` }
vh.commit(ada, Program(code: { .count = 0; (0..<100).for { this.count += 1 } }))
unless vh.value.count == 100 { INFO@mark `VC3 a loop in a commit did not run` }
unless vh.at(vh.head.previous).value.count == None { INFO@mark `VC4 an earlier version sees a later change` }
unless vh.head.previous.stamp < vh.head.stamp { INFO@mark `VC5 a later commit is not stamped later` }

// Running as a character.
unless (@ada { @me }) == ada { INFO@mark `VC6 a block run as a character does not run as it` }

// `.%`: a line per commit, `LABEL\ with (@me = @who; now = X) <change>`, ordinary Ray.
vl := vh.head.written(above: vh.head.previous)
unless vl ~= ⊢(vh.head.id as String + "\\ ") { INFO@mark `VC7 a line does not begin with its label` }
unless vl ~= "\\ with (@me = @ada; now = " { INFO@mark `VC8 a line does not set who made the commit and when` }
unless vl ~= "(0..<100).for" { INFO@mark `VC9 a line does not hold the program as written` }
vt := Language.ray.write(vh)
vf := vt.at(vh.id as String + ".ray").content as String
unless vf.lines{.nonempty}.count == 3 { INFO@mark `VC10 three commits are other than three lines` }
unless !vt.at("index.ray") { INFO@mark `VC11 a history is written with an index beside its program` }
vb := (vf as Program) as History
unless vb.head.id == vh.head.id { INFO@mark `VC12 a history read back has other labels` }
unless vb.count == 3 { INFO@mark `VC13 a history read back has other than its three commits` }
unless vb.value.welcome == "hello" && vb.value.count == 100 { INFO@mark `VC14 a history read back has another value` }
unless vb.head.previous.stamp < vb.head.stamp { INFO@mark `VC15 a history read back lost its order` }

// A labelled program is a history of its labels.
vp := Program(code: {
  first\
  1
  second\
  2
})
unless (vp as History).count == 2 { INFO@mark `VC16 a labelled program is not a history of its labels` }
unless !Language.cfg.admits(Program(code: { while true { } })) { INFO@mark `VC57 a line's settings may run forever` }

// What the Ray language keeps.
unless Language.ray.fidelity == Language.Fidelity.lossless { INFO@mark `VC17 the .% history is not lossless` }
unless $.ray === Language.ray { INFO@mark `VC43 $.ray is not the Ray language` }

// A foreign snapshot: the change between two trees, written as Ray.
text := "x := 1\ny := 2\nz := 3" as Byte[]
vs1 := Language.Entry.of([(path: "a.ray", content: text)])
vs2 := Language.Entry.of([(path: "b.ray", content: text)])
unless History.change(vs1, vs2) as String == ".[\"b.ray\"] = .[\"a.ray\"]; .[\"a.ray\"] = None" { INFO@mark `VC29 a moved file is not read as a move` }
unless (History.valued(vs1) -- History.change(vs1, vs2))["b.ray"] == History.valued(vs1)["a.ray"] { INFO@mark `VC30 a move does not keep the value` }
vt1 := Language.Entry.of([(path: "a.ray", content: text), (path: "c.ray", content: text)])
unless History.change(vt1, vs2) is Abstract { INFO@mark `VC31 a rename two files could have made is not a quest` }

// Merging: concurrent changes to one field are a quest; to two are not.
vm := History(repository: Repository())
vm.commit(ada, Program(code: { .x = 1 }))
vbranch := vm.fork
vm.commit(ada, Program(code: { .x = 2 }))
vbranch.commit(ada, Program(code: { .x = 3 }))
unless vm.merge(vbranch) is Abstract { INFO@mark `VC32 two changes to one field merged without asking` }
vn := History(repository: Repository())
vn.commit(ada, Program(code: { .x = 1 }))
vother := vn.fork
vn.commit(ada, Program(code: { .x = 2 }))
vother.commit(ada, Program(code: { .y = 5 }))
vn.merge(vother)
unless vn.head.merged { INFO@mark `VC33 a merge of two branches does not have both as parents` }
unless vn.value.x == 2 && vn.value.y == 5 { INFO@mark `VC34 a merge lost a change from one side` }

// Pins, and a fix that substitutes a version: a rule on mentions of the version it fixes.
vstd := History(repository: Repository())
vstd.commit(ada, 1)
vbug := vstd.head.id
vstd.fix(ada, vbug, 2)
unless vstd.checkout(vbug) == 2 { INFO@mark `VC35 a pin to a fixed version does not get the fix` }
unless vstd.checkout(vbug, as_of: vstd.head.previous.stamp) == 1 { INFO@mark `VC36 what was written before the fix does not replay as recorded` }

// One global order over separate histories.
vglobal := History.global([vstd, vn])
unless vglobal.ordered.zip(vglobal.ordered.rest).every((a, b) => !(b.stamp < a.stamp)) { INFO@mark `VC37 the global order is not by stamp` }
unless vglobal.head.parents.count == 2 { INFO@mark `VC38 the global history does not join every history` }

// Storage choices are optimisation levels.
unless Compiler.levels.contains(Compiler.stored) { INFO@mark `VC39 storage is not a compiler level` }
unless Compiler.reduced(vh, Compiler.cached).cache_files.first.content as String ~= ⊢(vh.head.id as String + "\\ ") { INFO@mark `VC40 the cache does not hold the value at the head` }
unless History.edit("abcdef", "abXdef") as String == ". edited(3, 4, \"X\")" { INFO@mark `VC41 a small change is not written as an edit` }
unless "abcdef".edited(3, 4, "X") == "abXdef" { INFO@mark `VC42 an edit does not produce the changed value` }

// A stretch runs from where its start holds to the commit where its end holds; the last may not have ended yet.
vs := History()
[1, 5, 6, 2, 7].for(vs.commit(ada, .))
stretched := vs{from value > 4 to value <= 4}
unless stretched.count == 2 { INFO@mark `VC44 a history is not read as its stretches` }
unless stretched.first.value == [5, 6, 2] { INFO@mark `VC45 a stretch does not end with the commit that ends it` }
unless stretched.last.value == [7] { INFO@mark `VC46 an unfinished last stretch is left out` }
unless vs{from value > 4}.first.value == [5, 6, 2] { INFO@mark `VC47 a stretch with no end does not end where its start stops holding` }
unless vs.since(None){.value == 5}.first.next.value == 6 { INFO@mark `VC48 a commit's next is not the one after it on its line` }
unless vs.head.next == None { INFO@mark `VC49 the head has a next` }

// `+` rebases (other's commits appended, re-stamped), `|` merges, `&+` interleaves by stamp.
hb := History(repository: Repository())
hb.commit(ada, Program(code: { .x = 1 }))
hb_other := hb.fork
hb.commit(ada, Program(code: { .x = 2 }))
hb_other.commit(ada, Program(code: { .y = 5 }))
hb_rebased := hb + hb_other
unless hb_rebased.value.x == 2 && hb_rebased.value.y == 5 { INFO@mark `HB1 a rebase lost a change from one side` }
if hb_rebased.since(None).some(.merged) { INFO@mark `HB2 a rebase made a merge` }
unless hb_other.head.stamp < hb_rebased.head.stamp { INFO@mark `HB3 a rebased commit kept its old stamp` }
unless hb.value.y == None { INFO@mark `HB4 rebasing changed the history it started from` }
hb_merged := hb | hb_other
unless hb_merged.head.merged { INFO@mark `HB5 a merge is not one commit with both heads as parents` }
unless hb_merged.value.x == 2 && hb_merged.value.y == 5 { INFO@mark `HB6 a merge with | lost a change from one side` }
hb_woven := hb &+ hb_other
unless hb_woven.since(None).count == 3 { INFO@mark `HB7 an interleaving has other than the three commits of both` }
if hb_woven.since(None).some(.merged) { INFO@mark `HB8 an interleaving made a merge` }
unless hb_woven.value.x == 2 && hb_woven.value.y == 5 { INFO@mark `HB9 an interleaving lost a change from one side` }
unless hb_woven.head.stamp == hb_other.head.stamp { INFO@mark `HB10 an interleaving re-stamped what it ordered` }

// A history may hold branches with no common commit.
hr := History(repository: Repository())
hr.commit(ada, Program(code: { .a = 1 }))
hr_apart := History(repository: Repository())
hr_apart.commit(ada, Program(code: { .b = 2 }))
hr_joined := hr | hr_apart
unless hr_joined.roots.count == 2 { INFO@mark `HB11 a merge of two unrelated histories does not keep both roots` }
unless hr_joined.value.a == 1 && hr_joined.value.b == 2 { INFO@mark `HB12 a merge of two unrelated histories lost one of them` }
hr_text := Language.ray.write(hr_joined).at(hr_joined.id as String + ".ray").content as String
unless hr_text ~= ". = None; " { INFO@mark `HB13 a second root is written as continuing the line above it` }
unless ((hr_text as Program) as History).roots.count == 2 { INFO@mark `HB14 a history read back has other than its two roots` }
unless (hr + hr_apart).value.b == 2 { INFO@mark `HB15 a rebase onto an unrelated history lost its commits` }

// Forking is a copy, whose history is a fork of the original's.
hx := Character(name: "forked")
hx.history.commit(ada, 1)
hx_copy := hx.copy
hx_copy.history.commit(ada, 2)
unless hx.history.since(None).count == 1 { INFO@mark `HB16 committing to a copy changed the original's history` }
unless hx_copy.history.since(None).count == 2 { INFO@mark `HB17 a copy's history does not continue the original's` }

// A history read without trust keeps its lines and ignores their claims (L§9.2.12)
claimed := History()
claimed.commit(ada, 1, versions: ["fixed"])
unless (with History.trusted = false { claimed.head.versions }).empty { INFO@mark `FWV1 an untrusted history's claims were believed` }
unless claimed.head.versions == ["fixed"] { INFO@mark `FWV2 a trusted history's claims were not kept` }
