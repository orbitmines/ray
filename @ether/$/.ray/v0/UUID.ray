UUID := class: Hexadecimal {
  spelled: Node

  version => .spelled.head.at(12).value

  Variant := enum reserved_ncs | rfc_4122 | reserved_microsoft | reserved_future

  variant => (
    leading := .spelled.head.at(16).value
    if (leading < 8) { UUID.Variant.reserved_ncs }
    elsif (leading < 12) { UUID.Variant.rfc_4122 }
    elsif (leading < 14) { UUID.Variant.reserved_microsoft }
    else { UUID.Variant.reserved_future }
  )

  drawn (count: Number) => (
    out := chain None
    left ^keyword := count
    while left {
      nibble ^keyword := 0
      bit ^keyword := 4
      while bit {
        nibble = nibble + nibble
        if (exists (external random)) { nibble = nibble.succ }
        bit = bit.pred
      }
      out &= nibble
      left = left.pred
    }
    out
  )

  v1 := class: UUID {

  }

  v3 := class: UUID {
    namespace: UUID
    name: String

  }

  v4 := class: UUID {
    spelled: UUID.drawn(32) ~~ (
      .head.at(12).value = 4
      this.head.at(16).value = 8 + (.head.at(16).value % 4)
    )

  }

  v5 := class: UUID {
    namespace: UUID
    name: String

  }

  as_string => (
    out := chain None
    walker ^keyword := .spelled.head

    dash ^keyword := U+002D
    groups := chain None
    groups &= 8
    groups &= 4
    groups &= 4
    groups &= 4
    groups &= 12
    groups for {
      unless (it.value == 8) { out &= dash }
      left ^keyword := it.value
      while left {
        out &= Character.decimal_digit(walker.value)
        walker = walker.next
        left = left.pred
      }
    }
    out.as_string
  )
  chainable == (other: UUID) => .as_string == other.as_string

  read (text: String) => (
    out := chain None

    dash ^keyword := U+002D
    text for {
      character := it.value
      unless (character == dash) { out &= character.hexadecimal_digit }
    }

    read_version := out.head.at(12).value
    if (read_version == 1) { UUID.v1(spelled: out) }
    elsif (read_version == 3) { UUID.v3(spelled: out) }
    elsif (read_version == 4) { UUID.v4(spelled: out) }
    elsif (read_version == 5) { UUID.v5(spelled: out) }
    else { UUID(spelled: out) }
  )

  Namespace := class {
    DNS => "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
    URL => "6ba7b811-9dad-11d1-80b4-00c04fd430c8"
    OID => "6ba7b812-9dad-11d1-80b4-00c04fd430c8"
    X500 => "6ba7b814-9dad-11d1-80b4-00c04fd430c8"
  }
}

Character.components.hierarchy &= class {
  hexadecimal_digit => if .digit { .codepoint - 48 } else { .lower.codepoint - 87 }
}
