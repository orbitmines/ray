mark ^keyword := external global

winter := "2024-01-15T12:00:00Z" as ISO_8601 as Time
unless OS.Linux().time_zones is TimeZone.Zoneinfo { INFO@mark `TZ1 linux does not read the host's zoneinfo` }
unless OS.Macos().time_zones is TimeZone.Zoneinfo { INFO@mark `TZ2 macos does not read the host's zoneinfo` }
if OS.Linux().time_zones.directory == OS.Ether().time_zones.directory { INFO@mark `TZ3 linux downloads the data instead of reading the host's` }
unless OS.Windows().time_zones is OS.Windows.ICU { INFO@mark `TZ4 windows does not ask the OS's ICU` }
unless OS.Browser().time_zones is OS.Browser.Intl { INFO@mark `TZ5 the browser does not ask Intl` }
unless [OS.Linux(), OS.Macos(), OS.Ether()].every(.time_zones.at("UTC", winter).offset == 0 seconds) { INFO@mark `TZ15 UTC is off zero on a platform that reads TZif` }
if OS.Linux().time_zones.directory ~= ⊢"tzif" { INFO@mark `TZ18 a host refers to @tzif for its zone data` }
Plan9 := class: OS
unless Plan9().time_zones.erred { INFO@mark `TZ21 an operating system without time-zone data does not err` }

unless [OS.Ether, OS.Linux, OS.Macos, OS.Windows, OS.Browser].every(. is OS#) { INFO@mark `OSE1 an os project does not add its operating system to OS` }
if Plan9 is OS# { INFO@mark `OSE2 a class of OS is one of its members without being added` }
unless OS#.map(.()){running}.count == 1 { INFO@mark `OSE3 other than one operating system runs this device` }
unless OS.current.running { INFO@mark `OSE4 the current operating system is not one the host runs` }
unless [OS.Linux(), OS.Macos(), OS.Windows(), OS.Browser()].every(.fonts is Location[]) { INFO@mark `OSE5 an operating system does not say where its fonts are` }
