@ether/encryption
@x25519
@chacha20poly1305
@sha256
@hkdf

// The Noise Protocol Framework, revision 34 (https://noiseprotocol.org/noise.html)
Noise := class: Language pattern = XX, dh: Language = X25519, cipher = ChaCha20Poly1305, hash: Language = SHA256 {
  static extensions := ".noise"

  // Tokens of message patterns (§7.1), each written and read by its narrowing below; XX: -> e, <- e, ee, s, es, -> s, se (§7.5)
  static Token := enum e | s | ee | es | se | ss
  // Each token is written and read by its own narrowing; a DH token from each side's view (§5.3, §7.1)
  assert Noise.Token.e is Noise.Ephemeral && Noise.Token.s is Noise.Static && Noise.Token.es is Noise.Mixing && !(Noise.Token.e is Noise.Mixing)  // NZ16 a token is not the narrowing that writes and reads it
  static XX := (name: "XX", messages: [[Noise.Token.e], [Noise.Token.e, Noise.Token.ee, Noise.Token.s, Noise.Token.es], [Noise.Token.s, Noise.Token.se]])

  // e: a fresh ephemeral key, its public half in the clear and mixed into h; read, the other's (§5.3)
  static Ephemeral := Noise.Token{== Noise.Token.e} {
    written (hs: Noise.Handshake) => (hs.e = hs.protocol.dh.generated()).public ~~ hs.mixed_hash(hs.e.public)
    read (hs: Noise.Handshake, rest: Byte[]) => rest[hs.width..] ~~ (hs.re = rest[..<hs.width]) ~~ hs.mixed_hash(hs.re)
    assert {
      nz_bob := Noise.handshake(false, X25519.generated())
      // -> e; <- e, ee, s, es; -> s, se: both sides end with one handshake hash, each holding the other's static key (§7.5)
      nz_bob.read(nz_alice.written())
      nz_hello := nz_alice.read(nz_bob.written("hello".bytes))
      assert nz_hello == "hello".bytes  // NZ5 the payload of the second message does not read back
      assert nz_alice.h == nz_bob.h && nz_alice.bound == nz_bob.bound  // NZ8 the two sides end with other handshake hashes
      assert nz_alice.rs == nz_bob.s.public && nz_bob.rs == nz_alice.s.public  // NZ9 a side does not learn the other's static key
      assert !(nz_alice.e.public == nz_bob.e.public)  // NZ10 both sides used one ephemeral key
      // Split: what one side sends, the other receives (§5.2)
      nz_a := nz_alice.session
      nz_b := nz_bob.session
      assert nz_b.received(nz_a.sent("ping".bytes)) == "ping".bytes  // NZ11 a transport message from the initiator does not arrive
      assert nz_a.received(nz_b.sent("pong".bytes)) == "pong".bytes  // NZ12 a transport message from the responder does not arrive
      assert nz_a.binding == nz_b.binding  // NZ13 the two sessions are bound to other hashes
      assert nz_a.peer.algorithm === X25519  // NZ14 the peer's key does not name its algorithm
    }
  }
  // s: the static public key, encrypted once there is a key (§5.3)
  static Static := Noise.Token{== Noise.Token.s} {
    written (hs: Noise.Handshake) => hs.encrypted_and_hashed(hs.s.public)
    read (hs: Noise.Handshake, rest: Byte[]) => (hs.width + (hs.cipher.k ? 16 : 0)) -- (n => rest[n..] ~~ (hs.rs = hs.decrypted_and_hashed(rest[..<n])))
  }
  // ee, es, se, ss: the first letter names the initiator's key, the second the responder's; each side agrees its own with the other's public one, then mixes the key (§5.3, §7.1)
  static Mixing := Noise.Token{is Noise.Token.ee | Noise.Token.es | Noise.Token.se | Noise.Token.ss} {
    agreed (hs: Noise.Handshake) => (hs.initiator ? .name : <-this.name) -- (keys => hs.`keys[0]`.agreed(hs.`"r" + keys[1]`))
    written (hs: Noise.Handshake) => [] ~~ hs.mixed_key(this.agreed(hs))
    read (hs: Noise.Handshake, rest: Byte[]) => rest ~~ hs.mixed_key(this.agreed(hs))
  }

  // The protocol name: the pattern, then the DH, cipher and hash functions by their Noise names (§8, §12.1, §12.3, §12.5)
  static names := {
    {algorithm: *{=== X25519}} => "25519"
    {algorithm: *{=== ChaCha20Poly1305}} => "ChaChaPoly"
    {algorithm: *{=== SHA256}} => "SHA256"
    {algorithm} => ERROR@Name `a Noise name for this algorithm`
  }
  assert Compiler.reduced(HKDF, Noise.names).erred  // NZ17 an algorithm without a Noise name has one
  name => ["Noise", .pattern.name, [.dh, .cipher, .hash].map(Compiler.reduced(., Noise.names))].flatten.join("_")
  size => .hash.size
  // Noise's HKDF is RFC 5869's with the chaining key as salt and no info (§4.3)
  kdf => HKDF(this.hash)

  // A CipherState: a key and a nonce; with no key yet, text passes as it is (§5.1). ChaChaPoly's nonce is 32 zero bits, then n as 64 bits little-endian (§12.3)
  static Cipher := class cipher: Language = ChaCha20Poly1305, k: Byte₃₂?, n: Number = 0 {
    nonce => [[0] * 4, .n.little(8)].flatten
    encrypted (ad: Byte[], plaintext: Byte[]) => .k ? .cipher.sealed(this.k, this.nonce, ad, plaintext) ~~ (this.n += 1) : plaintext
    decrypted (ad: Byte[], ciphertext: Byte[]) => .k ? .cipher.opened(this.k, this.nonce, ad, ciphertext) ~~ (this.n += 1) : ciphertext
  }

  // A handshake, initiated or answered with a static key; its DH function is the one the key names (§5.3)
  static handshake (initiator: boolean, s: Key, prologue: Byte[] = [], pattern = Noise.XX, cipher = ChaCha20Poly1305, hash: Language = SHA256) =>
    Noise.Handshake(protocol: Noise(pattern, dh: s.algorithm, cipher, hash), initiator, s) ~~ .mixed_hash(prologue)
  assert Noise.handshake(true, X25519.generated()).(
    nz_bob.read(.written()) == []  // NZ6 an empty payload does not read back empty
    & .done && nz_bob.done  // NZ7 three messages do not finish XX
  )

  // The HandshakeState with its SymmetricState: the name as h (padded, or hashed when longer than HASHLEN), ck = h, then the tokens of each message in turn (§5.2, §5.3)
  static Handshake := class protocol: Noise, initiator: boolean, s: Key, e: Key?, rs: Byte[]?, re: Byte[]?, step: Number = 0 {
    h: Byte[] = .protocol.name.bytes -- (.count <= this.protocol.size ? [., [0] * (this.protocol.size - .count)].flatten : this.protocol.hash.write(.).bytes)
    ck: Byte[] = .h
    cipher: Noise.Cipher = Noise.Cipher(cipher: this.protocol.cipher)
    bound: Byte[]?

    width => .s.public.count
    messages => .protocol.pattern.messages
    done => .step == .messages.count
    writes => !.done && (.step % 2 == 0) == .initiator

    mixed_hash (data: Byte[]): static => this ~~ (.h = this.protocol.hash.write([this.h, data].flatten).bytes)
    mixed_key (ikm: Byte[]): static => .protocol.kdf.derived(this.ck, ikm).chunk(this.protocol.size) -- (out => this ~~ (.ck = out[0]) ~~ (.cipher = Noise.Cipher(cipher: this.protocol.cipher, k: out[1][..<32])))
    encrypted_and_hashed (plaintext: Byte[]) => .cipher.encrypted(this.h, plaintext) -- (c => c ~~ this.mixed_hash(c))
    decrypted_and_hashed (ciphertext: Byte[]) => .cipher.decrypted(this.h, ciphertext) ~~ this.mixed_hash(ciphertext)
    // WriteMessage: each token in turn, then the payload, after h is kept as what a signature binds (§5.3)
    written (payload: Byte[] = []) => .messages[.step].map(.written(this)).flatten -- (message => [message, this.encrypted_and_hashed(payload ~~ (this.bound = this.h))].flatten) ~~ (this.step += 1)

    // ReadMessage: the same tokens taken off the front; the payload is what is left (§5.3)
    read (message: Byte[]) => .messages[.step].reduce(rest = message => .read(this, rest)) -- (rest => this.decrypted_and_hashed(rest ~~ (this.bound = this.h))) ~~ (this.step += 1)

    // Split: two CipherStates from ck, the first for the initiator's sending; h stays as the channel binding (§5.2, §11.2)
    session => .done ? .protocol.kdf.derived(this.ck, []).chunk(this.protocol.size).map(Noise.Cipher(cipher: this.protocol.cipher, k: .[..<32])) -- (pair =>
      Session(sending: this.initiator ? pair[0] : pair[1], receiving: this.initiator ? pair[1] : pair[0], binding: this.h, peer: Key(algorithm: this.protocol.dh, public: this.rs)))
      : ERROR@Handshake `finish the handshake`
    assert Noise.handshake(true, X25519.generated()).session.erred  // NZ15 an unfinished handshake has a session
  }

  // The transport phase: each side's CipherState, the handshake hash, and the remote static key (§5.1, §11.2)
  static Session := class sending: Noise.Cipher, receiving: Noise.Cipher, binding: Byte[], peer: Key {
    sent (payload: Byte[]) => .sending.encrypted([], payload)
    received (message: Byte[]) => .receiving.decrypted([], message)
  }
}
// The name has 32 bytes, HASHLEN, so h starts as the name itself (§5.2, §8)
assert Noise().(
  .name == "Noise_XX_25519_ChaChaPoly_SHA256"  // NZ3 the protocol is not named Noise_XX_25519_ChaChaPoly_SHA256
  & Noise.handshake(true, X25519.generated()).h == .name.bytes  // NZ4 a name of HASHLEN bytes is not h as it is
)
