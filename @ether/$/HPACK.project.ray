@deflate

// HPACK: Field compression for HTTP/2 (https://www.rfc-editor.org/rfc/rfc7541)
HPACK := class: Language {
  static extensions := ".hpack"

  // Static table (https://www.rfc-editor.org/rfc/rfc7541#appendix-A)
  static Static := [
    (":authority", ""), (":method", "GET"), (":method", "POST"), (":path", "/"), (":path", "/index.html"), (":scheme", "http"), (":scheme", "https"),
    (":status", "200"), (":status", "204"), (":status", "206"), (":status", "304"), (":status", "400"), (":status", "404"), (":status", "500"),
    ("accept-charset", ""), ("accept-encoding", "gzip, deflate"), ("accept-language", ""), ("accept-ranges", ""), ("accept", ""),
    ("access-control-allow-origin", ""), ("age", ""), ("allow", ""), ("authorization", ""), ("cache-control", ""), ("content-disposition", ""),
    ("content-encoding", ""), ("content-language", ""), ("content-length", ""), ("content-location", ""), ("content-range", ""), ("content-type", ""),
    ("cookie", ""), ("date", ""), ("etag", ""), ("expect", ""), ("expires", ""), ("from", ""), ("host", ""), ("if-match", ""), ("if-modified-since", ""),
    ("if-none-match", ""), ("if-range", ""), ("if-unmodified-since", ""), ("last-modified", ""), ("link", ""), ("location", ""), ("max-forwards", ""),
    ("proxy-authenticate", ""), ("proxy-authorization", ""), ("range", ""), ("referer", ""), ("refresh", ""), ("retry-after", ""), ("server", ""),
    ("set-cookie", ""), ("strict-transport-security", ""), ("transfer-encoding", ""), ("user-agent", ""), ("vary", ""), ("via", ""), ("www-authenticate", "")
  ].map((name: .0, value: .1))

  // Integer representation: an N-bit prefix, continued in 7-bit groups least significant first (https://www.rfc-editor.org/rfc/rfc7541#section-5.1)
  static Integer := class<prefix: Number> (
    (small: Binary{length == prefix && . < 2 ^ prefix - 1})
    | (Binary{length == prefix && . == 2 ^ prefix - 1}, groups: (Binary₁{== 1}, group: Binary₇)[], Binary₁{== 0}, last: Binary₇)
  ) {
    value => small ?? 2 ^ prefix - 1 + [groups.group, last].flatten.enumerate.map(.value * 128 ^ .index).sum
    assert (0b111111001101000001010 as HPACK.Integer<5>).value == 1337  // HP3 continuation octets do not read back as 1337
    assert HPACK.write([(name: ":method", value: "GET")]) as Byte[] == [0x82]  // HP12 a field in the static table is not written as its index
    assert HPACK.read([0x04, 0x0c, "/sample/path".bytes].flatten)[":path"] == "/sample/path"  // HP13 a literal without indexing does not read as in C.2.2
    assert HPACK.read([0x10, 0x08, "password".bytes, 0x06, "secret".bytes].flatten)["password"] == "secret"  // HP14 a literal never indexed does not read as in C.2.3
    assert third_fields.contains((name: ":authority", value: "www.example.com")) && third_fields.contains((name: "custom-key", value: "custom-value"))  // HP15 the third request of C.3.3 does not read its authority and custom-key
    assert "no-cache" as HPACK.Coded as Byte[] == [0xa8, 0xeb, 0x10, 0x64, 0x9c, 0xbf]  // HP16 no-cache is not Huffman coded as in C.4.2
    assert "custom-key" as HPACK.Coded as Byte[] == [0x25, 0xa8, 0x49, 0xe9, 0x5b, 0xa9, 0x7d, 0x7f]  // HP17 custom-key is not Huffman coded as in C.4.3
    assert "custom-value" as HPACK.Coded as Byte[] == [0x25, 0xa8, 0x49, 0xe9, 0x5b, 0xb8, 0xe8, 0xb4, 0xbf]  // HP18 custom-value is not Huffman coded as in C.4.3
    assert "302" as HPACK.Coded as Byte[] == [0x64, 0x02]  // HP19 302 is not Huffman coded as in C.6.1
    assert "private" as HPACK.Coded as Byte[] == [0xae, 0xc3, 0x77, 0x1a, 0x4b]  // HP20 private is not Huffman coded as in C.6.1
    assert "Mon, 21 Oct 2013 20:13:21 GMT" as HPACK.Coded as Byte[] == [0xd0, 0x7a, 0xbe, 0x94, 0x10, 0x54, 0xd4, 0x44, 0xa8, 0x20, 0x05, 0x95, 0x04, 0x0b, 0x81, 0x66, 0xe0, 0x82, 0xa6, 0x2d, 0x1b, 0xff]  // HP21 the date of C.6.1 is not Huffman coded as there
    assert "https://www.example.com" as HPACK.Coded as Byte[] == [0x9d, 0x29, 0xad, 0x17, 0x18, 0x63, 0xc7, 0x8f, 0x0b, 0x97, 0xc8, 0xe9, 0xae, 0x82, 0xae, 0x43, 0xd3]  // HP22 the location of C.6.1 is not Huffman coded as there
    as (=== Decimal) => .value
    static (value: Decimal) as (=== HPACK.Integer) => value < 2 ^ prefix - 1 ? HPACK.Integer<prefix>(small: value)
      : <-((value - 2 ^ prefix + 1).digits(128)) -- (digits => HPACK.Integer<prefix>(groups: digits[..<-1].map((group: .)), last: digits.last))
  }
  assert (10 as HPACK.Integer<5>) as Binary == 0b01010  // HP1 10 is not written in a 5-bit prefix as in C.1.1
  assert (1337 as HPACK.Integer<5>) as Binary == 0b111111001101000001010  // HP2 1337 is not written with continuation octets as in C.1.2
  assert (42 as HPACK.Integer<8>) as Byte[] == [0x2a]  // HP4 42 on an octet boundary is not 2a as in C.1.3

  // Huffman code: canonical, so given by each symbol's code length; symbol 256 is EOS (https://www.rfc-editor.org/rfc/rfc7541#appendix-B)
  static Lengths := [
    (5, "012aceiost"), (6, " %-./3456789=A_bdfghlmnpru"), (7, ":BCDEFGHIJKLMNOPQRSTUVWYjkqvwxyz"), (8, "&*,;XZ"), (10, "!\"()?"), (11, "'+|"), (12, "#>"),
    (13, [0, 36, 64, 91, 93, 126]), (14, "^}"), (15, "<`{"), (19, [92, 195, 208]),
    (20, [128, 130, 131, 162, 184, 194, 224, 226]),
    (21, [153, 161, 167, 172, 176, 177, 179, 209, 216, 217, 227, 229, 230]),
    (22, [129, 132, 133, 134, 136, 146, 154, 156, 160, 163, 164, 169, 170, 173, 178, 181, 185, 186, 187, 189, 190, 196, 198, 228, 232, 233]),
    (23, [1, 135, 137, 138, 139, 140, 141, 143, 147, 149, 150, 151, 152, 155, 157, 158, 165, 166, 168, 174, 175, 180, 182, 183, 188, 191, 197, 231, 239]),
    (24, [9, 142, 144, 145, 148, 159, 171, 206, 215, 225, 236, 237]),
    (25, [199, 207, 234, 235]),
    (26, [192, 193, 200, 201, 202, 205, 210, 213, 218, 219, 238, 240, 242, 243, 255]),
    (27, [203, 204, 211, 212, 214, 221, 222, 223, 241, 244, 245, 246, 247, 248, 250, 251, 252, 253, 254]),
    (28, [2, 3, 4, 5, 6, 7, 8, 11, 12, 14, 15, 16, 17, 18, 19, 20, 21, 23, 24, 25, 26, 27, 28, 29, 30, 31, 127, 220, 249]),
    (30, [10, 13, 22, 256])
  ]
  static code := Deflate.Huffman((0..256).map(symbol => HPACK.Lengths{symbol is (.1 is String ? .1.bytes : .1)#}.first.0))

  // Huffman-coded octets: codes most significant bit first, padded to the octet with the high bits of EOS (https://www.rfc-editor.org/rfc/rfc7541#section-5.2)
  static Coded := class (symbols: HPACK.code.Symbol{< 256}[], padding: Binary{.length < 8 && .every(. == 1)} = [1] * ((8 - symbols.map(HPACK.code.bits(.).length).sum % 8) % 8)) {
    text => .symbols as Byte[] as String
    static (text: String) as (=== HPACK.Coded) => HPACK.Coded(symbols: text as Byte[])
  }
  assert "www.example.com" as HPACK.Coded as Byte[] == [0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff]  // HP10 www.example.com is not Huffman coded as in C.4.1

  // String literal: H, the length, then the octets, Huffman coded when H is set (https://www.rfc-editor.org/rfc/rfc7541#section-5.2)
  static Text := class (huffman: Binary₁ as boolean = false, size: HPACK.Integer<7> = octets.count as HPACK.Integer<7>, octets: Byte[]{.length == size.value}) {
    value => .huffman ? (.octets as HPACK.Coded).text : .octets as String
    static (text: String) as (=== HPACK.Text) => HPACK.Text(octets: text as Byte[])
  }

  // Field representations (https://www.rfc-editor.org/rfc/rfc7541#section-6)
  static Representation := class (
    // Indexed field (https://www.rfc-editor.org/rfc/rfc7541#section-6.1)
    (Binary₁{== 1}, index: HPACK.Integer<7>{value > 0})
    // Literal with incremental indexing, without indexing, never indexed (https://www.rfc-editor.org/rfc/rfc7541#section-6.2)
    | (((kind: ₂01, at: HPACK.Integer<6>) | (kind: ₂0000, at: HPACK.Integer<4>) | (kind: ₂0001, at: HPACK.Integer<4>)), (name: HPACK.Text) if at.value == 0, value: HPACK.Text)
    // Dynamic table size update (https://www.rfc-editor.org/rfc/rfc7541#section-6.3)
    | (₂001, size: HPACK.Integer<5>)
  ) {
    inserting => .kind == ₂01
    field (table: HPACK.Table) => .index ? table[.index.value] : (name: .name.value ?? table[.at.value].name, value: .value.value)
    static (field: (name: String, value: String)) as (=== HPACK.Representation) => HPACK.Representation(kind: ₂0000, at: 0 as HPACK.Integer<4>, name: field.name as HPACK.Text, value: field.value as HPACK.Text)
  }

  // The dynamic table: newest first after the static entries, each costing its octets plus 32, the oldest evicted to fit (https://www.rfc-editor.org/rfc/rfc7541#section-2.3, https://www.rfc-editor.org/rfc/rfc7541#section-4)
  static Table := class entries: (name: String, value: String)[] = [], limit: Number = 4096 {
    size => .entries.map(.name.bytes.count + .value.bytes.count + 32).sum
    fitted => .size <= .limit ? this : HPACK.Table(this.entries[..<-1], this.limit).fitted
    inserted (entry: (name: String, value: String)) => HPACK.Table([[entry], this.entries].flatten(1), this.limit).fitted
    resized (limit: Number) => HPACK.Table(this.entries, limit).fitted
    [index: Number] => [HPACK.Static, .entries].flatten(1)[index - 1]
  }

  // A field block: its representations in order, each seeing the table left by those before it (https://www.rfc-editor.org/rfc/rfc7541#section-3.2)
  static Block := class (representations: HPACK.Representation[]) {
    decoded (table: HPACK.Table = HPACK.Table()) => .representations.reduce(held = (table: table, fields: []) => .field(held.table) -- (field =>
      .size ? (table: held.table.resized(.size.value), fields: held.fields)
      : (table: .inserting ? held.table.inserted(field) : held.table, fields: [held.fields, field])))
  }
  // The blocks of one connection share its dynamic table, in the order they are decoded (https://www.rfc-editor.org/rfc/rfc7541#section-2.2)
  static Connection := class blocks: HPACK.Block[] {
    fields => .blocks.reduce(held = (table: HPACK.Table(), fields: []) => .decoded(held.table) -- (decoded => (table: decoded.table, fields: [held.fields, [decoded.fields]].flatten(1)))).fields
    assert {
      first := [0x82, 0x86, 0x84, 0x41, 0x0f, "www.example.com".bytes].flatten
      assert HPACK.read(first)[":authority"] == "www.example.com"  // HP8 the first request of C.3.1 does not read its authority
      second := [0x82, 0x86, 0x84, 0xbe, 0x58, 0x08, "no-cache".bytes].flatten
      connection := HPACK.Connection([first as HPACK.Block, second as HPACK.Block]).fields.last
      assert connection.contains((name: ":authority", value: "www.example.com")) && connection.contains((name: "cache-control", value: "no-cache"))  // HP11 the second request of C.3.2 does not find its authority in the dynamic table
    }
  }

  // The encoder's choices: an index for what the static table holds, and Huffman coding when it is shorter (https://www.rfc-editor.org/rfc/rfc7541#section-7.1)
  static Optimizations := {
    {r: HPACK.Representation{.kind == ₂0000 && name && (name: name.value, value: value.value) is HPACK.Static#}} =>
      Representation(index: (HPACK.Static.index_of((name: r.name.value, value: r.value.value)) + 1) as HPACK.Integer<7>)
    {r: HPACK.Representation{.kind == ₂0000 && .name && .name.value is HPACK.Static.name#}} =>
      Representation(kind: r.kind, at: (HPACK.Static.name.index_of(r.name.value) + 1) as HPACK.Integer<4>, value: r.value)
    {text: HPACK.Text{!huffman && (.value as HPACK.Coded as Byte[]).count < octets.count}} => HPACK.Text(huffman: true, octets: text.value as HPACK.Coded as Byte[])
  }

  level := {
    {block: HPACK.Block} => {
      held := { }
      block.decoded().fields.for(held[.name] = .value)
      held
    }
  }
  written := HPACK.Optimizations + {
    {writing: Language.Writing} => HPACK.Block(representations: writing.value.map(. as HPACK.Representation))
  }
}
assert HPACK.read([0x82])[":method"] == "GET"  // HP7 index 2 is not :method GET as in C.2.4

assert ([0x40, 0x0a, "custom-key".bytes, 0x0d, "custom-header".bytes].flatten).(
  HPACK.read(.)["custom-key"] == "custom-header"  // HP5 a literal with indexing does not read as in C.2.1
  & (. as HPACK.Block).decoded().table.size == 55  // HP6 the dynamic table after C.2.1 is not 55 octets
)

assert HPACK.read(([0x82, 0x86, 0x84, 0x41, 0x8c, 0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff]))[":authority"] == "www.example.com"  // HP9 a Huffman-coded authority does not read as in C.4.1
