// JS fragments written inline, and the JS language writing them.

mark ^keyword := external global

who := "Ray"
js_listen := @js document.getElementById({who}).addEventListener("click", (event) => ray.activate({who}))
unless js_listen is JS.Listen && js_listen.event == "click" { INFO@mark `UI206 a js listener fragment is not a Listen` }
unless js_listen.target is JS.ById && js_listen.target.id == "Ray" { INFO@mark `UI207 a js fragment does not find an element by a held id` }
unless ((@js f({who})) as JS) == "f(\"Ray\")" { INFO@mark `UI208 a string hole in js is not a string literal` }
unless ((@js ray.set("a", 1 + 2 * 3)) as JS) == "ray.set(\"a\",(1+(2*3)))" { INFO@mark `UI209 js operators do not keep their precedence` }
unless (@js effect(["a"], () => { f() })) is JS.Effect { INFO@mark `UI210 a js effect fragment is not an Effect` }
unless [@js f(), 4].count == 2 { INFO@mark `UI211 a js fragment does not stop where its grammar stops` }
js_block := @js {
  f()
  g({who})
}
unless js_block.count == 2 && (js_block.last as JS) == "g(\"Ray\")" { INFO@mark `UI219 a js block is not its statements` }
unless (@js {who} + 1) is JS.Operation { INFO@mark `UI220 a hole right after @js is read as a block` }
js_commented := @js {
  // note
  f()
}
unless (JS.Module(js_commented) as JS) == "/* note*/;f();" { INFO@mark `UI238 a js comment is not written into the js` }
anonymous := @js function (a) { return a }
unless anonymous is JS.Function && anonymous.name == None && (JS.read(anonymous as JS) as JS) == (anonymous as JS) { INFO@mark `UI292 a written anonymous function does not read back` }
