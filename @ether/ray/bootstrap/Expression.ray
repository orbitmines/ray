      q = q + 1
    }
    q
  }
  static file_named (t: Text) => (t is Text) ? Entry.file_in(Texts.trimmed_text(t.from, t.to), Entry.zero_from(program_from(), program_from() + program_length()) + 1, program_from() + program_length()) : None
