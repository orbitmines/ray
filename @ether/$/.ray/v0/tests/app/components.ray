// `.components` holds what a value superposes, `.components.hierarchy` its classes.

mark ^keyword := external global

A := class {
  mk => A(from: this)
}
a := A()
b := a.mk
c := b.mk
unless a.components.hierarchy.last { INFO@mark `C1 an instance has no class component` }
unless c.components.hierarchy.first.mk { INFO@mark `C2 the class component of an instance is not its class` }
unless a.components.hierarchy.owner { INFO@mark `C3 a hierarchy does not know what it belongs to` }
unless a.components.hierarchy.count == 1 { INFO@mark `C4 a plain instance has other than one class component` }

R := class { }
S := class: R { s => S(next: this) }
unless S().s.s.s { INFO@mark `C5 a successor chain through class: Parent broke` }
unless S.components.hierarchy.first { INFO@mark `C6 class: Parent did not add a class component` }
unless S.super { INFO@mark `C7 super is missing` }
unless Ray.super.count { INFO@mark `C8 Ray.super does not reach Iterable's count` }

Greeter := class {
  greeting => name
  twice => greeting
}
Loud := class: Greeter {
  greeting => global
  polite => super.greeting
}
loud := Loud(name: global)
unless loud.polite { INFO@mark `C22 super.greeting did not run the parent's method on the instance` }
unless loud.super.twice { INFO@mark `C23 super reaches the parent's other methods` }

E := enum p | q | r
unless E#.first == E.p { INFO@mark `C9 the first enum member is not the first written` }
unless E#.first.next.next == E.r { INFO@mark `C10 enum members are not chained forward` }
unless E#.last.previous.previous == E.p { INFO@mark `C11 enum members are not chained backward` }
unless E#.count == 3 { INFO@mark `C12 an enum of three has other than three members` }
unless E#.first.is_initial { INFO@mark `C13 the members are not an Iterable of Rays` }
unless E#.last == E.r { INFO@mark `C14 Iterable.last did not reach the last member` }

M := a | b
unless M.components.first.mk { INFO@mark `C15 | did not superpose its left side` }
unless M.components.last.mk { INFO@mark `C16 | did not superpose its right side` }
unless (M | c).components.count == 3 { INFO@mark `C17 | on a Many did not append` }
unless (A() | A()).components.count == 2 { INFO@mark `C31 superposing two does not make two components` }
lone := A()
lone | A()
unless lone.components.count == 0 { INFO@mark `C32 superposing changed the left side` }

k := [a, b]
unless k.first.next { INFO@mark `C18 a list is not linked forward` }
unless k.last.previous { INFO@mark `C19 a list is not linked backward` }
if k.first.previous { INFO@mark `C20 the first of a list has a previous` }
unless k.count == 2 { INFO@mark `C21 a list of two does not count two` }

// A class extended later reaches every instance built from it
Late := class { }
built_before := Late()
Late &+= {
  added => 1
}
unless built_before.added == 1 { INFO@mark `C24 a class extended later does not reach an instance built before` }
unless Late().added == 1 { INFO@mark `C25 a class extended later does not reach an instance built after` }

G1 := class { depth => 1 }
G2 := class: G1 { depth => 2 }
G3 := class: G2 { depth => 3 }
unless G3().depth == 3 { INFO@mark `C26 the nearest class does not answer` }
unless G2().depth == 2 { INFO@mark `C27 the middle class answers its parent's` }
unless G1().depth == 1 { INFO@mark `C28 the first class answers something else` }
unless G3.super { INFO@mark `C29 a class three deep has no super` }
unless G3.super.depth == 2 { INFO@mark `C30 super does not reach the class it is built on` }

// `#` is what a value may be (A1, T2.3)
unless boolean#.count == 2 { INFO@mark `HS1 boolean does not have two possible values` }
unless (1 | 2 | 3)#.count == 3 { INFO@mark `HS2 a superposition of three does not have three possible values` }
unless 5#.count == 1 { INFO@mark `HS3 a single value has other than one possible value` }
unless (1 | 2)#.contains((1 | 2)#.random) { INFO@mark `HS4 a random possible value is not one of them` }
unless (1 | 2)#.succ.contains(3) { INFO@mark `HS5 a member asked of the possible values is not asked of each` }
unless #(1 | 2) == (1 | 2)# { INFO@mark `HS6 #x is not x#` }
unless "A" is 1 ("A" | "B") { INFO@mark `HS7 one of two possibilities is not a counted type of one` }
if ("A" | "B") is 1 ("A" | "B") { INFO@mark `HS8 both possibilities are a counted type of one` }
unless ("A" | "B") is 50% ("A" | "B" | "C" | "D") { INFO@mark `HS9 two of four possibilities are not half of them` }
unless "B" is 0.5 ("A" | "B") { INFO@mark `HS10 half of two possibilities is not one` }
unless (choose 1 ("A" | "B")) is ("A" | "B") && (choose 1 ("A" | "B"))#.count == 1 { INFO@mark `HS11 choosing a counted type does not resolve to one of its possibilities` }
unless (33% ("A" | "B" | "C")) is Diagnostic { INFO@mark `HS12 a share that is not a whole number of a discrete structure's possibilities is not a type error` }
unless 2 seconds is Quantity { INFO@mark `HS13 a count before a unit is read as a count, not a quantity` }
unless Decimal{. % 2 == 0} is 50% Decimal { INFO@mark `HS14 a share of an infinite structure is not taken by its density` }
unless (Device().choose(Decimal)) is Diagnostic { INFO@mark `HS15 the computer chose uniformly among infinitely many possibilities` }

// `&+` and `|+` superpose components; `+` lets the right one override (T2.1, A1)
unless (true &+ "A").next == false & "B" { INFO@mark `SP1 &+ does not answer with both components` }
unless (true |+ "A").next == false | "B" { INFO@mark `SP2 |+ does not answer with either component` }

// What is done with a superposition is done with each value (A1, U1)
unless (1 & 2) + 1 == 2 & 3 { INFO@mark `SP3 an operator does not carry through &` }
unless (1 | 2) + 1 == 2 | 3 { INFO@mark `SP4 an operator does not carry through |` }
unless 10 - (1 | 2) == 9 | 8 { INFO@mark `SP5 a superposition on the right does not carry` }
incremented (a) => a + 1
unless incremented(1 & 2) == 2 & 3 { INFO@mark `SP6 a call does not carry through &` }
unless incremented(1 | 2) == 2 | 3 { INFO@mark `SP7 a call does not carry through |` }

// A superposed element makes branches: one path through each value (U1)
branched := [1, "2a" | "2b", 3]
unless branched#.count == 2 { INFO@mark `SP8 a superposed element in a list does not make two paths` }
unless branched#.some(== [1, "2b", 3]) { INFO@mark `SP9 a path through the second value is missing` }

// Each value remembers where it came from; fixing a source refines what depends on it (U1)
doubled (a) => a * 2
tripled (a) => a * 3
traced := doubled(1) | tripled(2)
unless traced#.origin.contains(doubled) { INFO@mark `SP10 a superposed call does not remember what it came from` }
unless traced#{.origin == tripled}.first == 6 { INFO@mark `SP11 a value is not selected by its origin` }
chosen := 1 | 2
result := chosen + 10
unless result{chosen == 2} == 12 { INFO@mark `SP12 fixing a source does not refine what depends on it` }
