external class {name}{block}

// Syntax highlighting. H's methods are decorators: every group is declared
// here — the runtime enumerates none. Leading a rule definition they style
// the rule, inside a pattern piece they style that piece, and applied to
// anything else they return it unchanged.
class H
  external namespace
  external type
  external class
  external enum
  external interface
  external struct
  external typeParameter
  external parameter
  external variable
  external property
  external enumMember
  external event
  external function
  external method
  external macro
  external keyword
  external modifier
  external comment
  external string
  external number
  external regexp
  external operator
  external decorator

// Punctuation isn't an LSP standard type — it IS comment, everywhere.
H.punctuation = H.comment

H.string `{string: String}` => string
H.comment //{comment: String} =>

// Grouping: that parentheses, brackets and braces nest is not built in — it
// follows from these rules being active while scanning.
H.punctuation {`{`}{expr}{`}`} => TODO
H.punctuation ({expr}) => expr
H.punctuation [{expr}] => expr

H.keyword external external

class Program
  external ({args}) =>
  {` `}{expr} => this(expr)

class Node

  // The grammar-rule definition rule itself: the bootstrapper hardcodes this
  // shape for this file only; once declared here, the interpreter relies on
  // this declaration for every file that follows.
  external {(H.function String.Word | H.punctuation `{`, H.parameter expr, H.punctuation `}`)[]}{H.keyword `=>`}{body}

  {H.punctuation `.`}{H.property property} => this[property]

  // When bootstrapping, function definitions cannot use '&=', which is the actual default set lower in this file.
  static DEFINE_METHOD = `=`

  // Function definition
  H.punctuation {` `}({H.parameter args}){block} => this [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def
  )

  test () TODO
  test2 (parameter, parameter2) TODO2

  external static
  external {H.punctuation `[`}{H.property property}{H.punctuation `]`}
  external **: Program
  external = (x): x


// Set the actual method used for function definitions.
Node.DEFINE_METHOD = `&=`
