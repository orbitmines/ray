  external emit 0x04
  external emit 0x7F
  b
  external emit 0x41
  external emit 0
  external emit 0x47
  external emit 0x05
  external emit 0x41
  external emit 0
  external emit 0x0B
}
{a} || {b} => {
  a
  external emit 0x04
  external emit 0x7F
  external emit 0x41
  external emit 1
  external emit 0x05
  b
  external emit 0x41
  external emit 0
  external emit 0x47
  external emit 0x0B
}
