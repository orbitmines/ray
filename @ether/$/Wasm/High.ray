  static rejoined (rl) => (rl.count < 2) ? rl : High.rejoin(rl.rest, rl.first, High.quotes_of(rl.first), Array.new)
  static rejoin (rr, rc, rq, ro) => rr.empty ? ro.append(rc) : (((rq % 2) == 1) ? High.rejoin(rr.rest, level cw_span_of (rc) (rr.first), rq + High.quotes_of(rr.first), ro) : High.rejoin(rr.rest, rr.first, High.quotes_of(rr.first), ro.append(rc)))
  static quotes_of (qo) => High.quotes_in(qo, 0, Compiled.bytes(qo))
  static quotes_in (ot, oa, oe) => ((oe - oa) > 32) ? (High.quotes_in(ot, oa, (oa + oe) / 2) + High.quotes_in(ot, (oa + oe) / 2, oe)) : High.quotes_from(ot, oa, oe, 0)
  static quotes_from (ft, fi, fe, fn) => (fi >= fe) ? fn : (High.operator_led(High.char_at(ft, fi), "\\") ? High.quotes_from(ft, fi + 2, fe, fn) : ((High.char_at(ft, fi) == "\"") ? High.quotes_from(ft, fi + 1, fe, fn + 1) : High.quotes_from(ft, fi + 1, fe, fn)))
  static char_at (ct, ci) => (ci == 0) ? ct.first : level cw_slice (ct) (ci) (ci + 1)
  static kind (kt) => Compiled.kind_of(High.parsed_one(kt))
  static program (pr_text, pr_runtime, pr_pages) => {
    Compiled.parts(`this, key, value, length, count, first, last, keys, sort, for, body, statements, statement, rest, empty, reading, text, caller, at, node, in, rules, map, \s, \n, String, ⊣, None, true, false, \n\n, input, holes, Place, noted, applied, members, whole, joined, append, new, Array`).for((s) => level cw_symbol_of (s))
    High.w(pr_runtime)
    High.w("\nfunction main() {\n  var scope\n  free = 8388608 + (((load 4088) + 7) / 8) * 8\n  names = list()\n  symtab()\n  scope = node(0)\n  define(scope, 57, arrays())\n")
    Compiled.statements_of(pr_text).for((st) => High.statement_isolated(st))
    High.w("\n}\n")
    High.w("function symtab() {\n  seeded(")
    High.text(`this`)
    High.w(")\n")
    High.symbols_from(1, level cw_symbol_count)
    High.w("  0\n}\n")
    level cw_aside_out
    level cw_taken
    Low.module_of(level cw_taken, pr_pages)
  }
  static statements (ss) => ss.for((st) => High.statement(st))
  static statements_isolated (ss) => ss.for((st) => High.statement_isolated(st))
  static symbols_from (sf_at, sf_count) => (sf_at < sf_count) ? High.symbol_seeded(sf_at, sf_count) : 0
  static symbol_seeded (ss_at, ss_count) => {
    High.w("  seeded(")
    High.text(level cw_symbol_text (ss_at))
