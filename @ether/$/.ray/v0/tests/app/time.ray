// Time: the units, and what a calendar says about a year. The numbers are
// kept small, because a number here is walked.

mark ^keyword := external global

unless (Second.is_temporal) { INFO@mark `TI1 a second is not temporal` }
unless (Hour.is_temporal) { INFO@mark `TI2 an hour is not temporal` }
unless (Hour.base_unit == Second) { INFO@mark `TI3 an hour is not counted in seconds` }
unless (Minute.base_unit == Second) { INFO@mark `TI4 a minute is not counted in seconds` }

unless (Julian.hours_in_day == ((two * ten) + four)) { INFO@mark `TI5 a day is not twenty-four hours` }
unless (Julian.minutes_in_hour == (six * ten)) { INFO@mark `TI6 an hour is not sixty minutes` }
unless (Julian.seconds_in_minute == (six * ten)) { INFO@mark `TI7 a minute is not sixty seconds` }

unless (Julian.is_leap_year(four)) { INFO@mark `TI8 the fourth year is not a leap year` }
if (Julian.is_leap_year(five)) { INFO@mark `TI9 the fifth year is a leap year` }
unless (Gregorian.is_leap_year(four)) { INFO@mark `TI10 the fourth year is not a leap year in the Gregorian` }
if (Gregorian.is_leap_year(three)) { INFO@mark `TI11 the third year is a leap year in the Gregorian` }

unless (Julian.months.count == (ten + two)) { INFO@mark `TI12 a year has other than twelve months` }
unless (Julian.weekdays.count == seven) { INFO@mark `TI13 a week has other than seven days` }

unless (seconds(five).is_temporal) { INFO@mark `TI14 five seconds is not temporal` }
unless (seconds(five).amount == five) { INFO@mark `TI15 five seconds is not five of them` }
unless (minutes(two).unit == Minute) { INFO@mark `TI16 two minutes are not minutes` }

// The century rule is the Gregorian's, and UTC is where the offsets start.
if (Gregorian.is_leap_year(hundred)) { INFO@mark `TI17 a hundred is a leap year in the Gregorian` }
unless (Julian.is_leap_year(hundred)) { INFO@mark `TI18 a hundred is not a leap year in the Julian` }
unless (UTC.offset.is_zero) { INFO@mark `TI19 UTC is at some offset` }
unless (exists Julian.months.head.value.place) { INFO@mark `TI20 the first month has no place` }

// Months: what each is named, how long it is, and where it sits. February is
// the only one a leap year changes.
february := Julian.months.head.next.value
unless (february.place == two) { INFO@mark `TI21 the second month does not sit second` }
unless (february.length == ((two * ten) + eight)) { INFO@mark `TI22 february is other than twenty-eight days` }
unless (february.days_in(four, Julian) == ((two * ten) + nine)) { INFO@mark `TI23 february in a leap year is other than twenty-nine days` }
unless (february.days_in(five, Julian) == ((two * ten) + eight)) { INFO@mark `TI24 february in a plain year is other than twenty-eight days` }
january := Julian.months.head.value
unless (january.place == one) { INFO@mark `TI25 the first month does not sit first` }
unless (january.days_in(four, Julian) == ((three * ten) + one)) { INFO@mark `TI26 a leap year lengthens january` }
unless (Julian.days_in_month(january, four) == ((three * ten) + one)) { INFO@mark `TI27 a calendar does not ask a month how long it is` }

// Weekdays, in the order a week is walked.
unless (Weekday.monday == Julian.weekdays.head.value) { INFO@mark `TI28 a week does not begin on monday` }
unless (Weekday.sunday == Julian.weekdays.tail.value) { INFO@mark `TI29 a week does not end on sunday` }
if (Weekday.monday == Weekday.tuesday) { INFO@mark `TI30 two weekdays are the same day` }

// The units, and how they are counted in one another.
unless (Minute.base == Second) { INFO@mark `TI31 a minute is not built on a second` }
unless (Hour.base == Minute) { INFO@mark `TI32 an hour is not built on a minute` }
unless (Day.base == Hour) { INFO@mark `TI33 a day is not built on an hour` }
unless (Week.base == Day) { INFO@mark `TI34 a week is not built on a day` }
unless (Minute.ratio == (six * ten)) { INFO@mark `TI35 a minute is other than sixty of what it is built on` }
unless (Week.ratio == seven) { INFO@mark `TI36 a week is other than seven of what it is built on` }
unless (Week.rank == four) { INFO@mark `TI37 a week is other than four steps off its base` }

// The Gregorian differs from the Julian only at a century, and agrees again
// at four hundred.
unless (Gregorian.is_leap_year(four * hundred)) { INFO@mark `TI38 four hundred is not a leap year in the Gregorian` }
unless (Julian.is_leap_year(four * hundred)) { INFO@mark `TI39 four hundred is not a leap year in the Julian` }
unless (GMT.offset.is_zero) { INFO@mark `TI40 GMT is at some offset` }
if (UTC.leap_seconds) { INFO@mark `TI41 UTC counts leap seconds` }

// Where a day falls in its year: the months before it, and itself.
unless (Julian.day_of_year(Julian.months.head.value, one, five) == one) { INFO@mark `TI42 the first of january is not the first day of the year` }
unless (Julian.day_of_year(Julian.months.head.next.value, one, five) == ((three * ten) + two)) { INFO@mark `TI43 the first of february is not the thirty-second day` }
unless (Julian.day_of_year(Julian.months.head.next.next.value, one, four) == ((six * ten) + one)) { INFO@mark `TI44 the first of march in a leap year is not the sixty-first day` }
unless (Julian.day_of_year(Julian.months.head.next.next.value, one, five) == (six * ten)) { INFO@mark `TI45 the first of march in a plain year is not the sixtieth day` }

// A time is how long since its epoch, in the calendar it is counted by.
here := Time(calendar: Julian, since_epoch: seconds(five))
later := Time(calendar: Julian, since_epoch: seconds(eight))
unless (here == here) { INFO@mark `TI46 a time is not itself` }
if (here == later) { INFO@mark `TI47 two times are the same` }
unless (here < later) { INFO@mark `TI48 five seconds in is not before eight` }
if (later < here) { INFO@mark `TI49 eight seconds in is before five` }
unless ((later - here).as_seconds == three) { INFO@mark `TI50 the three seconds between them are not three` }
unless ((here + seconds(three)) == later) { INFO@mark `TI51 five seconds on plus three is not eight` }
unless (here.as(Gregorian).calendar == Gregorian) { INFO@mark `TI52 reading a time by another calendar does not` }
unless (here.as(Gregorian) == here) { INFO@mark `TI53 the same moment read by another calendar is another moment` }
unless (here.since_calendar_epoch.as_seconds == five) { INFO@mark `TI54 a time with no epoch of its own is not since its calendar's` }

// A time counted from another time.
since_then := Time(calendar: Julian, since_epoch: seconds(two), epoch: here)
unless (since_then.since_calendar_epoch.as_seconds == seven) { INFO@mark `TI55 two seconds after five is not seven since the start` }
unless (since_then < Time(calendar: Julian, since_epoch: seconds(eight))) { INFO@mark `TI56 seven is not before eight` }

// What a segment of a calendar is.
recurring := Calendar.Segment(name: one, length: seconds(two), period: seconds(two))
plain_segment := Calendar.Segment(name: two, length: seconds(two))
unless (recurring.is_recurring) { INFO@mark `TI57 a segment with a period does not recur` }
if (plain_segment.is_recurring) { INFO@mark `TI58 a segment without a period recurs` }
unless (recurring.epoch == one) { INFO@mark `TI59 a segment does not start at one` }
