say {x} =>
  external io stdout x
// a dynamic value watched: what it depends on (its code and the rules it calls) written marks it to run again: the names, then true
Scene := class {
  size: Node?
}
scene := Scene(size: true)
draw => scene.size
d := dynamically draw
say (external get d source)
say ((external get d source).mentioned)
watch(d)
say (external get registry watching)
scene.size = false
say (external get d dirty)
// `(M if c) x` applies the prefix M when c holds (P1.9b): false said, then nothing; a Dynamic, then the plain value true
loud {x} => say x
(loud if true) false
(loud if false) true
e := (dynamically if true) true
say (external get e source)
f := (dynamically if false) true
say f
