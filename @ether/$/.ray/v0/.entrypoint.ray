{pattern} => {body} => external rule pattern body
//{comment?} => None
;{statement} => statement
({expr}) => expr
{{expr}} => external ** expr
{name} := {value} => external declare name value
literal := external literal
^ := external ^
{target} ^{literal style}{ } => ^(style)(target)
^{literal style}{ } => ^(style)
global ^keyword := external global
unordered ^keyword := external unordered
inline ^keyword := external inline
literal ^keyword := external literal
theme ^keyword := external theme
report ^keyword := external report
forward := external forward
None := external none

^{ }{literal color ^ color} => ^(color)
{pattern} ^{literal style} => {body} => ^(style)(external rule pattern body)
`{literal string ^string}` ^string.punctuation => string
\n => `
`
//{comment?} ^comment => None
/*{comment?}*/ ^comment => None

[{expr}] ^punctuation => (
  listed := chain None
  external extend listed Listed
  listed &= expr
  listed
)

goto {literal target ^label} ^class => external goto target global
goto {literal target ^label} if {condition} ^class => external goto target condition
{literal label ^label}\ ^punctuation => external label label

return {value} ^keyword => (
  value
  goto return\
)

chain {holder} ^keyword => (
  links ^keyword := external .
  instance := global
  owner := holder
  head := None
  tail := None
  external extend links Chain
  links
)

link {value} {previous} ^keyword => (
  entry ^keyword := external .
  instance := global
  next := None
  external extend entry Link
  entry
)

class {block} => (
  static := external .
  static.instance = None
  static.components = chain None
  static.components.hierarchy = chain static
  static.written_body = external ** block
  static.classes_read = None
  static.requirements_read = None
  static.requirements_known = None
  static.heads_read = None
  static.heads_known = None
  written_as => static.written_body**
  super => (
    parent := static.components.hierarchy.tail.value
    instance := this
    view := external .
    external extend view parent
    external extend view instance
    view
  )
  ({args}) => .construct(args)
  static.reading_statics = global
  inline block
  static.reading_statics = None

  construct (args) => (
    static := this
    goto positional if static.header_names
    goto named
   positional\
    goto named if (named_arguments(args))
    (inline (external ** static.header_names.join(`, `))) := (inline args)
    goto entered
   named\
    inline args
   entered\
    this := external .
    this.components = chain None
    this.components.hierarchy = chain this
    this.components.hierarchy &= static
    this.instance = global
    inline block
    if static.is_abstract { ERROR@this `constructs a class that leaves a method unwritten` }
    this
  )

  static
)

base class {body} => (
  static := external .
  static.instance = None
  static.components = chain None
  static.components.hierarchy = chain static
  static.written_body = external ** body
  static.requirements_read = chain None
  static.requirements_known = global
  written_as => static.written_body**
  inline body
  external base static {
    external declare this external .
  }
  static
)

if ^keyword := class {
  { }{cond}{ }{yes} ^class => (
    branch ^keyword := external .
    inline static
    taken := None
    answer := None

    goto enter if (cond as boolean).holds
    goto skip
   enter\
    taken = global
    result := None
    external declare result (inline (external ** yes))
    answer = result
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )

  elsif{ }{cond}{ }{block} ^class => (
    branch ^keyword := external .
    inline this
    taken := .taken
    answer := .answer

    goto skip if taken
    goto enter if (cond as boolean).holds
    goto skip
   enter\
    taken = global
    result := None
    external declare result (inline (external ** block))
    answer = result
    goto composes if (external own result)
    goto skip
   composes\
    external extend branch result
   skip\

    branch ^variable
  )

  {\n}elsif{ }{cond}{ }{block} ^class => this elsif cond block
  {\n}else{ }{block} ^class => this else block

  else{ }{block} ^class => (
    chosen ^keyword := .answer
    goto done if .taken
    chosen = inline (external ** block)
   done\

    chosen
  )

  as (=== boolean) => (.answer as boolean)
}

unless{ }{cond}{ }{block} ^class => (
  branch ^keyword := external .
  inline if
  taken := None
  answer := None

  goto skip if (cond as boolean).holds
  taken = global
  result := None
  external declare result (inline (external ** block))
  answer = result
  goto composes if (external own result)
  goto skip
 composes\
  external extend branch result
 skip\

  branch ^variable
)

while ^keyword := class {
  { }{cond}{ }{block} ^class => (
    looping ^keyword := external .
    inline static
    written_block := external ** block

   continue\
    goto more if (cond as boolean).holds
    goto break
   more\
    inline written_block
    goto continue
   break\

    looping ^variable
  )

  { }{block}{ }while{ }{cond} ^class => (
    written_block := external ** block
    inline written_block

    this cond block
  )
}

do{ }{block}{ }while{ }{cond} ^class => (
  first_round := external ** block
  inline first_round
  while cond block
)

loop{ }{block} ^class => while true block
// `break`/`continue` leave or repeat a loop; `recur(args)` re-enters the method with other arguments, `recur` with the same (P2.1, P2.4).
break ^keyword => goto break
recur({given}) ^keyword => (
  arguments = given
  goto recur
)
recur ^keyword => goto recur
continue ^keyword => goto continue

Program := class {
  ({arguments}) => if .instance { .entered(.context, arguments) } else { .construct(arguments) }

  { }{expr} => this(expr)

  entered (element, given) => (
    closure_code := .code
    closure_parameters := .parameters
    entering := chain None
    entering.target = element
    entered_value := None
    if (closure_parameters.not) {
      external define entering.target `closure_entered` { inline closure_code } None
      entered_value = entering.target.closure_entered
    } else {
      external define entering.target `closure_applied{arguments}` {
        (inline closure_parameters) := arguments
        inline closure_code
      } None
      entered_value = entering.target.closure_applied(given)
    }
    entered_value
  )
}

Modifier := class {
  kind => TODO
  modify (definition) => (
    definition.components = chain None
    definition.components.hierarchy = chain None
    definition.components.hierarchy &= this
    definition
  )
}
chainable ^keyword := class: Modifier { chains => TODO }
compounds ^keyword := class: Modifier { compounds => TODO }
right-to-left ^keyword := class: Modifier { reads_right_to_left => TODO }
left-to-right ^keyword := class: Modifier { reads_left_to_right => TODO }
chainable {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined := external define head `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  chainable.modify(defined)
)
compounds {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined := external define head `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  compounds.modify(defined)
)
right-to-left {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined := external define head `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  right-to-left.modify(defined)
)
left-to-right {head} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  defined := external define head `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  left-to-right.modify(defined)
)
right-to-left {head} | {alias} ({parameters ^parameter}) => {block} => (
  method_parameters := external ** parameters
  method_written := external ** block
  external define alias `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  defined := external define head `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
  right-to-left.modify(defined)
)
right-to-left {head} => {body} => right-to-left.modify(external rule head body)
right-to-left {head} | {alias} => {body} => (
  external rule alias body
  right-to-left.modify(external rule head body)
)
Modifier.spellings = chain None
Modifier.spellings &= `chainable`
Modifier.spellings &= `compounds`
Modifier.spellings &= `right-to-left`
Modifier.spellings &= `left-to-right`

Node := base class {

  // `--` continues on what the line before it is, `~~` likewise but answers that line; declared first, so both take the whole line (A-C5).
  continued_by (call) => Program(code: call).entered(this, None)
  continued_if (call, condition) => Program(code: condition).entered(this, None) ? .continued_by(call) : this
  --{call} ^punctuation => .continued_by(external ** call)
  --{call} if {condition} ^punctuation => .continued_if((external ** call), (external ** condition))
  {\n}--{call} ^punctuation => .continued_by(external ** call)
  {\n}--{call} if {condition} ^punctuation => .continued_if((external ** call), (external ** condition))
  ~~{x} ^punctuation => (
    .continued_by(external ** x)
    this
  )
  {\n}~~{x} ^punctuation => (
    .continued_by(external ** x)
    this
  )

  , => this

  ; ^punctuation (x) => x
  listing => None

  ({parameters ^parameter}) => {block} => (
    method_parameters := external ** parameters
    method_written := external ** block
    this ^function
    external define this `{arguments}` {
     recur\
      (inline method_parameters) := arguments
      inline method_written
    } parameters
  )
  ^{literal style} ({parameters ^parameter}) => {block} => (
    method_parameters := external ** parameters
    method_written := external ** block
    this ^function
    external define this `{arguments}` {
     recur\
      (inline method_parameters) := arguments
      inline method_written
    } parameters
  )

  , ^punctuation (other) => (
    listed := chain None
    goto branching if other.superposes
    external extend listed Listed
    listed &= this
    goto continued if other.continues
    listed &= other
    goto done
   continued\
    listed &= other(this)
    goto done
   branching\
    first := this
    listed = other.each((one) => first, one)
   done\
    listed
  )

  ={x} ^punctuation => (
    external assign this x

    this
  )
  :={x} ^punctuation => (
    goto existing if external own this
    external declare this x
    goto declared
   existing\
    goto both if x.head
    goto plain
   both\
    goto destructure if this.head
   plain\
    external declare this x
    goto declared
   destructure\
    external declare name this.head
    external declare value x.head
   next\
    goto declared if (name.not)
    goto spreading if name.value.spreads
    external declare name.value value.value
    name = name.next
    value = value.next
    goto next
   spreading\
    after := 0
    counting := name.next
    while counting {
      after = after.succ
      counting = counting.next
    }
    remaining := 0
    counting = value
    while counting {
      remaining = remaining.succ
      counting = counting.next
    }
    spread := chain None
    external extend spread Listed
    while (after < remaining) {
      spread &= value.value
      value = value.next
      remaining = remaining.pred
    }
    external declare name.value.of spread
    name = name.next
    goto next
   declared\
    this
  )

  ?? ^punctuation (other) => (
    chosen := this
    if (chosen === None) { chosen = other }
    chosen
  )
  ? => None | this
  ?: ^punctuation (type) => this: (type?)

  compounds + (component) => (
    external extend this component
    this
  )
  compounds - (component) => (
    remaining := chain this
    walker := this.components.hierarchy.head
    while walker {
      unless (walker.value === component) { remaining &= walker.value }
      walker = walker.next
    }
    this.components.hierarchy = remaining
    this.classes_read = None
    this
  )

  === (other) => (
    answer := None
    goto marking if this
    goto done if other
    answer = global
    goto done
   marking\
    marker := external .
    marker.probe = global
    this.identical = marker
    goto owned if (external own other.identical)
    goto cleared
   owned\
    answer = other.identical.probe
   cleared\
    marker.probe = None
   done\

    answer
  )
  as (=== boolean) => true

  not => (
    answer := global
    goto held if this
    goto done
   held\
    answer = None
   done\

    answer
  )
  and (b) => (
    answer := b
    goto done if this
    answer = this
   done\

    answer
  )
  or (b) => (
    answer := this
    goto done if this
    answer = b
   done\

    answer
  )
  && (b) => .and(b)
  || (b) => .or(b)
  nand (b) => .and(b).not
  xor (b) => .or(b).and(.nand(b))
  xnor (b) => .xor(b).not

  :{type} ^punctuation => (
    if (external own this) {
      unless type.instance {
        if this {
          if this.instance { type.verify(this) }
          elsif this.written_body { unless ((this === type) || this.subtype_of(type)) { ERROR@this `is not of the type it is declared as` } }
          elsif (this.instance_of(type)) {
            if type.repeating { external assign this this.instance_of(type) }
            type.verify(this)
          }
          else { ERROR@this `is not of the type it is declared as` }
        }
      }
    } elsif (None.instance_of(type)) { external declare this None }
    else {
      external declare this type
      if type.written_body { external declare this this }
    }

    this
  )

  subtype_of (other) => (
    found := None
    held := this.classes.head
    while (held && found.not) {
      if (held.value === other) { found = global }
      held = held.next
    }
    found
  )
  supertype_of (other) => other.subtype_of(this)

  classes => (
    unless ((external own this.classes_read) && this.classes_read) {
      this.classes_read = chain None
      reached := chain None
      reached &= this
      parent := this.components.hierarchy.head
      while parent {
        unless (parent.value === None) { extended_by(reached, parent.value.classes.head) }
        parent = parent.next
      }
      this.classes_read = reached
    }
    this.classes_read
  )
  heads_written => (
    unless this.heads_known {
      read := chain None
      if this.written_body {
        left := this.written_body
        one := external first left
        while one {
          read &= head_of(one)
          left = external rest left
          one = external first left
        }
      }
      this.heads_read = read
      this.heads_known = global
    }
    this.heads_read
  )
  requirements => (
    unless this.requirements_known {
      wanted := chain None
      held := this.classes.head
      while held {
        head := held.value.heads_written.head
        while head {
          if head.value.is_required { wanted &= head.value.spelled }
          head = head.next
        }
        held = held.next
      }
      this.requirements_read = wanted
      this.requirements_known = global
    }
    this.requirements_read
  )
  declaring (wanted_head) => (
    found := None
    held := this.classes.head
    while (held && found.not) {
      head := held.value.heads_written.head
      while (head && found.not) {
        if (head.value.is_declared && (head.value.spelled === wanted_head)) { found = global }
        head = head.next
      }
      held = held.next
    }
    found
  )
  structurally (type) => (
    holding := global
    wanted := None
    unless (.subtype_of(type)) { wanted = type.requirements.head }
    while (wanted && holding) {
      unless (.declaring(wanted.value)) { holding = None }
      wanted = wanted.next
    }
    holding
  )
  instance_of (type) => (
    found := None
    among := None
    if this.codepoint { among = type.superposes }
    if this {
      if (type.repeating || type.listing) { found = read_whole(this, type) }
      elsif (type.pattern && !this.instance) {
        read := read_whole(this, type.pattern)
        if read { found = type.built_from(read) }
      }
      elsif among {
        alternative := type.components.head
        while (alternative && found.not) {
          if alternative.value.superposes { if (this.instance_of(alternative.value)) { found = alternative } }
          elsif (same_text(this, alternative.value)) { found = alternative }
          alternative = alternative.next
        }
      } else {
        found = .structurally(type)
        if (found.not && type.components) {
          other := type.components.head
          while (other && found.not) {
            found = .structurally(other.value)
            other = other.next
          }
        }
        if found { found = type.admits(this) }
      }
    } else {
      unless type.instance {
        if type.components {
          walker := type.components.head
          while (walker && found.not) {
            if (walker.value === None) { found = global }
            walker = walker.next
          }
        }
      }
    }

    found
  )

  is_abstract => (
    missing := None
    head := this.heads_written.head
    while (head && missing.not) {
      if head.value.is_required { missing = global }
      head = head.next
    }
    missing
  )

  fields => (
    found := chain None
    holder := this
    colon := code_points(`x:y`).head.next.value
    held := this.classes.head
    while held {
      if held.value.written_body {
        statements := Program(code: held.value.written_body).written
        statements for {
          read := it.value.head_read
          if (read.ending && (read.ending == colon)) {
            named := read.points.as(String)
            found &= Field(name: named, value: (external get holder named))
          }
        }
      }
      held = held.next
    }
    found
  )

  canonical => (
    normal := this
    if (this.normalizer) { normal = this.normalizer(this) }
    normal
  )

  structure => None

  built_from (reading) => (
    made := this()
    reading for {
      if it.value.named { made[it.value.name] = it.value.value }
    }
    made
  )

  satisfies (predicate) => (
    answer := Program(code: (external ** predicate)).entered(this, None)
    if (answer.continues || answer.code) { answer = answer(this) }
    if answer.superposed { answer = answer.holds_for(this) }
    answer
  )

  verify (candidate) => candidate

  admits (candidate) => global

  {this}{{literal narrowing}} ^punctuation => (
    narrowed := this
    closure := { inline narrowing }
    selected := None
    if (narrowed.superposes && narrowed.components.head.value.instance) {
      alternative := narrowed.components.head
      while alternative {
        if (alternative.value.satisfies(closure)) { if selected { selected = selected | alternative.value } else { selected = alternative.value } }
        alternative = alternative.next
      }
    } elsif (narrowed.instance) {
      selected = chain None
      narrowed for {
        held := it.value
        if (held.satisfies(closure)) { selected &= held }
      }
    } else {
      selected = class: narrowed {
        constraint := closure
        narrows := narrowed

        verify (candidate) => (
          this.narrows.verify(candidate)
          unless (candidate.satisfies(this.constraint)) { ERROR@candidate `does not satisfy a constraint of its type` }

          candidate
        )
        admits (candidate) => if (this.narrows.admits(candidate)) { candidate.satisfies(this.constraint) } else { None }
        chosen_within (width) => (
          picked := this.narrows.chosen_within(width)
          if (picked.satisfies(this.constraint)) { picked } else { .chosen_within(width.succ) }
        )
        () ^punctuation => .chosen_within(1)
        if (this.instance) { selected.verify(this) }
      }
    }

    selected
  )

  {this}<{literal partial}> ^punctuation => (
    narrowed := this

    class: narrowed { inline partial }
  )

  ** => Program(code: (external ** this))

  &+={ }{{members}} ^punctuation => (
    this.components.hierarchy &= class { inline members }
    this
  )
  &={x} ^punctuation => (
    previous := this.tail
    adding := x
    added := link adding previous
    goto more if previous
    this.head = added
    goto linked
   more\
    previous.next = added
   linked\
    this.tail = added
    goto owned if this.owner
    goto done
   owned\
    holder := this.owner
    external extend holder x
   done\

    this
  )

  | ^punctuation (other) => (
    superposed := external .
    goto valued if this.instance
    external extend superposed this
   valued\
    superposed.instance = None
    superposed.superposes = global
    superposed.components = chain None
    if this.components.head { extended_by(superposed.components, this.components.head) } else { superposed.components &= this }
    if other.continues { superposed.components &= other(superposed.components.tail.value) } else { superposed.components &= other }

    superposed
  )

  . => this
  .{literal property ^property} ^punctuation => external get this property

  [{property}] ^punctuation => external get this property
  [] => (
    item := this
    repeated := class: Array { }
    repeated.repeats = item
    repeated.repeating = global
    repeated
  )

  ++ => (
    copy := external .
    external extend copy this
    copy
  )

  diagnostics = None
  diagnosed (diagnostic) => (
    unless this.diagnostics { this.diagnostics = chain None }
    this.diagnostics &= diagnostic
    this
  )

  right-to-left ! => .not
}

Node.DEFINE_METHOD = `&=`

external extend None {
  as (=== boolean) => false
  == (other) => other === None
  != (other) => (other === None).not
}

class:{ }{header}{`{`}{members?}{`}`} ^keyword => (
  made := class { inline members }
  made.written_body = external ** members
  made.components.hierarchy &= header
  made
)

extended_by (onto, walker) => (
  while walker {
    onto &= walker.value
    walker = walker.next
  }
  onto
)

Chain := class {
  entry => .head
}
Listed := class {
  listing => global
  , ^punctuation (other) => (
    joined := chain None
    goto branching if other.superposes
    external extend joined Listed
    extended_by(joined, this.head)
    goto continued if other.continues
    joined &= other
    goto done
   continued\
    joined &= other(this.tail.value)
    goto done
   branching\
    before := this
    joined = other.each((one) => before, one)
   done\
    joined
  )
}
Link := class { }

Reading := class {
  rest: Node
  value: Node
}
Field := class {
  name: Node
  value: Node
}
Chosen := class {
  among: Node
  value: Node
  previous => .among.previous
  next => .among.next
}
Capture := class {
  name: Node
  type: Node
  capturing => true
}
Captured := class {
  name: Node
  value: Node
  named => true
}
Call := class {
  statement: Node
  is_external => .statement.written_with(`external`)
  external_name => (
    named := chain None
    space := code_points(`x y`).head.next.value
    skipped := 9
    ended := false
    code_points(.statement.code) for {
      if skipped.nonzero { skipped = skipped.pred } elsif !ended {
        if (it.value == space) { ended = true } else { named &= it.value }
      }
    }
    named.as(String)
  )
  ** => .statement
}

text_bits (text) => (
  held := chain None
  take (bit) => (
    held &= bit
    global
  )
  external bits text take
  held
)
bits_onto (held, text) => extended_by(held, text_bits(text).head)
prefix_of (at, spelling) => (
  prefix := None
  matching := global
  compare (bit) => (
    unless at { matching = None }
    if matching {
      unless (bit === at.value) { matching = None }
      at = at.next
    }
    matching
  )
  external bits spelling compare
  if matching { prefix = Reading(rest: at, value: spelling) }
  prefix
)
same_text (first_text, second_text) => (
  same := false
  if (first_text && second_text) {
    matched := prefix_of(text_bits(first_text).head, second_text)
    if matched { unless matched.rest { same = true } }
  }
  same
)
outnumbers (first_reading, other) => (
  mine := chain None
  theirs := chain None
  if first_reading.head { mine = first_reading } else { mine &= first_reading }
  if other.head { theirs = other } else { theirs &= other }
  a := mine.head
  b := theirs.head
  while (a && b) {
    a = a.next
    b = b.next
  }
  a
)
read_whole (text, type) => (
  whole := None
  if type.repeating {
    tree := None
    if type.repeats.superposes { tree = spelled_tree_of(type.repeats) }
    if (tree) {
      ends := spelled_ends(text, tree)
      if (ends) {
        if type.repeats.spelled_unique { whole = spelled_reading(ends) } else { whole = read_repeated(text_bits(text).head, type.repeats) }
      }
    } else { whole = read_repeated(text_bits(text).head, type.repeats) }
  } else {
    candidate := readings_of(text_bits(text).head, type).head
    while candidate {
      reading := candidate.value
      unless reading.rest {
        if whole {
          if (outnumbers(reading.value, whole)) { whole = reading.value }
        } else { whole = reading.value }
      }
      candidate = candidate.next
    }
  }
  whole
)

spelled_node ^keyword => (
  node := external .
  ends := None
  path := None
  zero := None
  one := None
  node
)
spelled_tree_of (type) => (
  unless type.spelled_tree_known {
    type.spelled_tree = None
    type.spelled_unique = global
    root := spelled_node
    plain := global
    insert (kind, path) => (
      at := root
      bit := text_bits(kind).head
      while bit {
        if at.ends { type.spelled_unique = None }
        if bit.value {
          unless at.one { at.one = spelled_node }
          at = at.one
        } else {
          unless at.zero { at.zero = spelled_node }
          at = at.zero
        }
        bit = bit.next
      }
      unless (at === root) {
        if (at.ends || at.zero || at.one) { type.spelled_unique = None }
        at.ends = global
        at.path = path
      }
    )
    gather (kind, path) => (
      if kind.superposes {
        alternative := kind.components.head
        while alternative {
          deeper := chain None
          extended_by(deeper, path.head)
          deeper &= alternative
          gather(alternative.value, deeper)
          alternative = alternative.next
        }
      } elsif (kind.repeating || kind.listing || kind.capturing || kind.written_body) { plain = None }
      else { insert(kind, path) }
    )
    gather(type, chain None)
    if plain { type.spelled_tree = root }
    type.spelled_tree_known = global
  }
  type.spelled_tree
)
spelled_ends (text, root) => (
  active := chain None
  active &= root
  ended := chain None
  completed := None
  step (bit) => (
    reached := chain None
    done := None
    at := active.head
    while at {
      next_node := None
      if bit { next_node = at.value.one } else { next_node = at.value.zero }
      if next_node {
        reached &= next_node
        if next_node.ends {
          done = global
          ended &= next_node
        }
      }
      at = at.next
    }
    if done { reached &= root }
    completed = done
    active = reached
    reached.head
  )
  external bits text step
  unless active.head { completed = None }
  unless completed { ended = None }
  ended
)
spelled_reading (ends) => (
  whole := chain None
  ended := ends.head
  while ended {
    step := ended.value.path.tail
    chosen := step.value.value
    while step {
      chosen = Chosen(among: step.value, value: chosen)
      step = step.previous
    }
    whole &= chosen
    ended = ended.next
  }
  whole
)

head_stops := ` ` | `(` | `:` | `?`
not_word_starts := `{` | `[` | `^` | `@`
heads_root ^keyword => (
  unless global.heads_trie { global.heads_trie = spelled_node }
  global.heads_trie
)
todo_held := chain None
todo_bits ^keyword => (
  unless todo_held.head { bits_onto(bits_onto(bits_onto(todo_held, `=`), `>`), ` TODO`) }
  todo_held
)
byte_steps := text_bits(` `)
written_head ^keyword => (
  node := external .
  spelled := None
  stop := None
  is_required := None
  is_declared := None
  node
)
head_of (statement) => (
  read := written_head
  stops := spelled_tree_of(head_stops)
  starts := spelled_tree_of(not_word_starts)
  head_at := heads_root
  byte_from := heads_root
  stop_at := stops
  start_at := starts
  first_bit := None
  second_bit := None
  bits_seen := None
  second_seen := None
  word_start := None
  first_done := None
  step_at := byte_steps.head
  todo_at := None
  reading := global
  take (bit) => (
    going := global
    if reading {
      if bit {
        unless head_at.one { head_at.one = spelled_node }
        head_at = head_at.one
        if stop_at { stop_at = stop_at.one }
        if start_at { start_at = start_at.one }
      } else {
        unless head_at.zero { head_at.zero = spelled_node }
        head_at = head_at.zero
        if stop_at { stop_at = stop_at.zero }
        if start_at { start_at = start_at.zero }
      }
      unless first_done {
        if bits_seen {
          unless second_seen {
            second_bit = bit
            second_seen = global
          }
        } else {
          first_bit = bit
          bits_seen = global
        }
      }
      step_at = step_at.next
      unless step_at {
        if stop_at { if stop_at.ends { read.stop = stop_at.path.head.value } }
        if read.stop {
          reading = None
          if (read.stop === head_stops.components.head) { todo_at = todo_bits.head } else { going = None }
        } else {
          unless first_done {
            first_done = global
            if (first_bit || second_bit) { word_start = global }
            if start_at { if start_at.ends { word_start = None } }
            start_at = None
            unless word_start {
              reading = None
              going = None
            }
          }
          byte_from = head_at
          stop_at = stops
          step_at = byte_steps.head
        }
      }
    } else {
      if (bit === todo_at.value) { todo_at = todo_at.next } else { going = None }
      unless todo_at {
        read.is_required = global
        going = None
      }
    }
    going
  )
  external bits statement take
  read.spelled = byte_from
  if read.stop {
    unless (read.stop === head_stops.components.tail) { read.is_declared = global }
    if ((read.stop === head_stops.components.head.next.next) && word_start) { read.is_required = global }
  }
  read
)

read_repeated (start, element) => (
  whole := None
  layer := chain None
  layer &= Reading(rest: start, value: chain None)
  while layer.head {
    reached := chain None
    state := layer.head
    while state {
      reading := state.value
      steps := readings_of(reading.rest, element).head
      while steps {
        step := steps.value
        unless (step.rest === reading.rest) {
          seen := None
          known := reached.head
          while (known && !seen) {
            if (known.value.rest === step.rest) { seen = global }
            known = known.next
          }
          unless seen {
            more := chain None
            extended_by(more, reading.value.head)
            more &= step.value
            reached &= Reading(rest: step.rest, value: more)
            unless step.rest { whole = more }
          }
        }
        steps = steps.next
      }
      state = state.next
    }
    layer = reached
  }
  whole
)
readings_of (rest, type) => (
  found := chain None
  if type.repeating {
    firsts := readings_of(rest, type.repeats).head
    while firsts {
      first := firsts.value
      single := chain None
      single &= first.value
      found &= Reading(rest: first.rest, value: single)
      unless (first.rest === rest) {
        others := readings_of(first.rest, type).head
        while others {
          more := chain None
          more &= first.value
          extended_by(more, others.value.value.head)
          found &= Reading(rest: others.value.rest, value: more)
          others = others.next
        }
      }
      firsts = firsts.next
    }
  } elsif type.listing {
    reached := chain None
    listed_from := rest
    reached &= Reading(rest: listed_from, value: chain None)
    item := type.head
    while item {
      further := chain None
      so_far_at := reached.head
      while so_far_at {
        so_far := so_far_at.value
        nexts := readings_of(so_far.rest, item.value).head
        while nexts {
          parts := chain None
          extended_by(parts, so_far.value.head)
          parts &= nexts.value.value
          further &= Reading(rest: nexts.value.rest, value: parts)
          nexts = nexts.next
        }
        so_far_at = so_far_at.next
      }
      reached = further
      item = item.next
    }
    found = reached
  } elsif type.superposes {
    alternative := type.components.head
    while alternative {
      alternatives := readings_of(rest, alternative.value).head
      while alternatives {
        found &= Reading(rest: alternatives.value.rest, value: Chosen(among: alternative, value: alternatives.value.value))
        alternatives = alternatives.next
      }
      alternative = alternative.next
    }
  } elsif type.capturing {
    captures := readings_of(rest, type.type).head
    while captures {
      found &= Reading(rest: captures.value.rest, value: Captured(name: type.name, value: captures.value.value))
      captures = captures.next
    }
  } elsif type.written_body {
    piece := chain None
    at := rest
    while at {
      piece &= at.value
      at = at.next
      copied := chain None
      extended_by(copied, piece.head)
      if (copied.instance_of(type)) { found &= Reading(rest: at, value: copied) }
    }
  } else {
    matched := prefix_of(rest, type)
    if matched { found &= matched }
  }
  found
)

capture_of (content) => (
  colon := content.index_of(`:`)
  named := content
  typed := None
  if colon {
    named = content.slice(0, colon)
    typed = content.slice(colon.succ, content.count)
  }
  name := None
  named.split(` `) for {
    word := it.value
    unless (word.empty || word.starts_with(`^`) || same_text(word, `literal`)) { name = word }
  }
  if (name.ends_with(`?`)) { name = name.slice(0, name.count.pred) }
  type := Node
  if typed {
    written := None
    styled := false
    typed.split(` `) for {
      word := it.value
      if (word.starts_with(`^`)) { styled = true }
      unless (styled || word.empty) { if written { written = written + ` ` + word } else { written = word } }
    }
    if written { type = inline (external ** written) }
  }
  Capture(name: name, type: type)
)
pattern_of (head) => (
  pattern := None
  head for {
    part := it.value
    item := part.value
    if part.among.previous { item = capture_of(part.value.head.next.value) }
    if pattern { pattern = pattern, item } else { pattern = [item] }
  }
  pattern
)
matcher_of (pattern) => ((text, captured) => (
  read := None
  reading := None
  start := text_bits(text).head
  readings_of(start, pattern) for {
    if reading {
      if (outnumbers(it.value.value, reading.value)) { reading = it.value }
    } else { reading = it.value }
  }
  if reading {
    reading.value for {
      if it.value.named { captured[it.value.name] = it.value.value }
    }
    read = chain None
    walker := start
    while (walker && !(walker === reading.rest)) {
      read &= walker.value
      walker = walker.next
    }
  }
  read
))

// A class written with its pattern: `class = a: T, b: U = d { … }`, `class (pattern) => { … }`, `class: Parent (pattern) => { … }`; the named parts are its fields, taken by position or by name (A7, T3.10, T3.15b).
header_items (written, separator) => (
  items := chain None
  piece := chain None
  depth := 0
  quoted := false
  opening := code_points(`([{`)
  closing := code_points(`)]}`)
  quote := code_points(`"`).head.value
  apart := code_points(separator).head.value
  code_points(written) for {
    point := it.value
    if (point == quote) { quoted = !quoted }
    unless quoted {
      if (opening.contains(point)) { depth = depth.succ }
      if (closing.contains(point)) { depth = depth.pred }
    }
    if (depth.is_zero && !quoted && (point == apart)) {
      items &= piece.as(String).trimmed
      piece = chain None
    } else { piece &= point }
  }
  if piece.head { items &= piece.as(String).trimmed }
  items
)
header_word (item) => (
  word := chain None
  ended := false
  code_points(item) for {
    unless ended { if (it.value.word) { word &= it.value } else { ended = true } }
  }
  (word.head && !word.head.value.digit) ? word.as(String) : None
)
header_field (item) => (
  named := header_word(item)
  field := None
  if named {
    rest := item.slice(named.count, item.count).trimmed
    if (rest.empty || rest.starts_with(`:`) || rest.starts_with(`?:`) || rest.starts_with(`=`) || rest.starts_with(`|`)) { field = named }
  }
  field
)
argument_name (item) => (
  named := header_word(item)
  given := None
  if named {
    rest := item.slice(named.count, item.count)
    if (rest.starts_with(`:`) && !rest.starts_with(`::`)) { given = named }
  }
  given
)
named_arguments (args) => (
  found := false
  header_items((external ** args), `,`) for { if (argument_name(it.value)) { found = true } }
  found
)
header_names (header) => (
  names := chain None
  alternatives := header_items(header, `|`)
  alternatives for {
    alternative := it.value
    header_items(alternative, `,`) for {
      item := it.value
      named := header_field(item)
      if named { unless (names.contains(named)) { names &= named } }
      elsif (item.starts_with(`(`) && (header_items(item, `|`).count == 1)) {
        header_names(item.slice(1, item.count.pred)) for { unless (names.contains(it.value)) { names &= it.value } }
      }
    }
  }
  names
)
header_type (header) => (
  read := None
  alternatives := header_items(header, `|`)
  if (alternatives.count > 1) {
    alternatives for {
      one := header_type(it.value)
      if read { read = read | one } else { read = one }
    }
  } else {
    header_items(header, `,`) for {
      item := it.value
      named := header_field(item)
      one := None
      if named {
        typed := header_items(item.slice(named.count, item.count).trimmed, `=`).head.value
        if (typed.starts_with(`?:`)) { typed = typed.slice(2, typed.count).trimmed + `?` }
        elsif (typed.starts_with(`:`)) { typed = typed.slice(1, typed.count).trimmed }
        else { typed = `*` }
        one = Capture(name: named, type: inline (external ** typed))
      } elsif (item.starts_with(`(`)) { one = header_type(item.slice(1, item.count.pred)) }
      else { one = inline (external ** item) }
      if read { read = read, one } else { read = [one] }
    }
  }
  read
)
header_statements (header) => (
  statements := chain None
  header_items(header, `,`) for { if (header_field(it.value)) { statements &= it.value } }
  statements.join(`
`)
)
written_class (parent, header, members) => (
  fields_written := header_statements(header)
  made := class {
    inline (external ** fields_written)
    inline members
  }
  made.written_body = external ** (fields_written + `
` + code_points(members).as(String))
  if parent { made.components.hierarchy &= parent }
  made.header_names = header_names(header)
  made.pattern = header_type(header)
  made.positions = made.pattern
  made
)

class = {header}{ }{`{`}{members?}{`}`} ^keyword => written_class(None, (external ** header), (external ** members))
class = {header}{\n} ^keyword => written_class(None, (external ** header), None)
class ({header}) => {`{`}{members?}{`}`} ^keyword => written_class(None, (external ** header), (external ** members))
class ({header}){ }{`{`}{members?}{`}`} ^keyword => written_class(None, (external ** header), (external ** members))
class ({header}) => {single}{\n} ^keyword => written_class(None, (external ** header), (external ** single))
class:{ }{parent} = {header}{ }{`{`}{members?}{`}`} ^keyword => written_class(parent, (external ** header), (external ** members))
class:{ }{parent} = {header}{\n} ^keyword => written_class(parent, (external ** header), None)
class:{ }{parent} ({header}) => {`{`}{members?}{`}`} ^keyword => written_class(parent, (external ** header), (external ** members))
class:{ }{parent} ({header}){ }{`{`}{members?}{`}`} ^keyword => written_class(parent, (external ** header), (external ** members))

// `static` puts a member on the class, read once when the class is, and shared by its instances (L§2.2, A7).
static{ }{literal name ^property} := {value} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  external declare name value
 done\
  static
)
static{ }{literal name ^property} = {value} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  external declare name value
 done\
  static
)
static{ }{literal name ^property}: {type} = {value} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  external declare name value
  name: type
 done\
  static
)
static{ }{literal name ^property}: {type}{\n} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  name: type
 done\
  static
)
static{ }{head} ({parameters ^parameter}) => {block} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  method_parameters := external ** parameters
  method_written := external ** block
  external define head `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
 done\
  static
)
static{ }{head} => {block} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  external rule head block
 done\
  static
)
static ({parameters ^parameter}) => {block} ^keyword => (
  goto shared if static.reading_statics
  goto done
 shared\
  method_parameters := external ** parameters
  method_written := external ** block
  external define static `{arguments}` {
   recur\
    (inline method_parameters) := arguments
    inline method_written
  } parameters
 done\
  static
)
Modifier.spellings &= `static`

{condition} ? {yes} : {no} ^punctuation => (
  chosen := no
  if condition { chosen = yes }
  chosen
)

dynamically ^keyword (x) => (inline x)

assert ^keyword (condition) => (
  unless condition { ERROR@condition `assertion failed` }

  condition
)

enum ^keyword => (

  static := class {
    {literal member ^enumMember} ^punctuation => (
      entry := this()
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    {literal member ^enumMember}{ }{given_fields ^property} ^punctuation => (
      entry := this(
        inline given_fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember} ^punctuation => (
      entry := this()
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )
    |{ }{literal member ^enumMember}{ }{given_fields ^property} ^punctuation => (
      entry := this(
        inline given_fields
      )
      this[member] = entry ^enumMember
      this.components &= entry

      this
    )

    chainable == (candidate) => (
      (this === candidate) || same_text((external where this), (external where candidate))
    )
    admits (candidate) => .components.contains(candidate)
  }

  static ^enum
)

enum{ }{literal member ^enumMember}{ }{given_fields? ^property}{ }{literal rest?} {`{`}{block}{`}`} ^keyword => (
  static := external .
  inline enum
  inline block

  entry := static(
    inline given_fields
  )
  static[member] = entry ^enumMember
  static.components &= entry
  inline rest

  static ^enum
)

enum{ }{literal member ^enumMember}{ }{given_fields? ^property}{ }{literal rest?}{\n} ^keyword => (
  static := external .
  inline enum

  entry := static(
    inline given_fields
  )
  static[member] = entry ^enumMember
  static.components &= entry
  inline rest

  static ^enum
)

Program.components.hierarchy &= class {
  optimizations => .O
  {this}{`{`}{literal setting}{`}`} ^punctuation => class: this { inline setting }

  written => (
    out := chain None
    left := .code
    one := external first left
    while (one) {
      out &= Program(code: one)
      left = external rest left
      one = external first left
    }
    out
  )
  entry => .written.entry
  first => .written.first
  last => .written.last
  count => .written.count
  empty => .count.is_zero
  for (body) => (
    statements := .written
    statements for body
    this
  )

  variables => (
    names := chain None
    statements := .written
    statements for {
      read := head_of(it.value.code)
      if read.is_declared { names &= read.spelled }
    }
    names
  )
  usages (name) => (
    used := chain None
    statements := .written
    statements for {
      if (it.value.mentions(name)) { used &= it.value }
    }
    used
  )
  mentions (name) => (
    wanted := code_points(name)
    found := false
    remaining := code_points(.code)
    while (remaining.nonempty && !found) {
      if (remaining.head.value == wanted.head.value) { found = .same_points(remaining.head, wanted) }
      remaining.pop_front
    }
    found
  )
  is_terminal => .written.empty
  calls => (
    found := chain None
    statements := .written
    statements for { found &= Call(statement: it.value) }
    found
  )

  compounds + (addend) => (
    augend := .code
    {
      inline augend
      inline addend.code
    }
  )
}

LSP := {
  SemanticToken := class {
    Type := enum namespace | type | class | enum | interface | struct | typeParameter | parameter | variable | property | enumMember | event | function | method | macro | keyword | modifier | comment | string | number | regexp | operator | decorator
    Modifier := enum declaration | definition | readonly | static | deprecated | abstract | async | modification | documentation | defaultLibrary
  }
}

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^U2
  ^type = ^U2
  ^class = ^U2
  ^enum = ^U2
  ^interface = ^U2
  ^struct = ^U2
  ^event = ^U2
  ^enumMember = ^U2
  ^typeParameter = ^U0
  ^parameter = ^U0
  ^variable = ^U1
  ^property = ^U1
  ^function = ^U4
  ^method = ^U4
  ^decorator = ^U4
  ^macro = ^U2
  ^keyword = ^U3
  ^modifier = ^U3
  ^comment = ^U3
  ^string = ^D2
  ^number = ^D2
  ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment
}
inline DARK

Diagnostic := class {
  message: Node
  kind: Node?
  fatal: Node?
  cause: Node?

  causes => (
    all := chain None
    all &= this
    if cause { extended_by(all, cause.causes.head) }
    all
  )
}

FATAL{`@`}{var}{ }{comment ^comment} ^fatal => (
  report FATAL var comment
  var.diagnosed(Diagnostic(message: comment, fatal: true))
)
ERROR{`@`}{var}{ }{comment ^comment} ^error => (
  report ERROR var comment
  var.diagnosed(Diagnostic(message: comment))
)
FATAL[{kind}] {message} ^fatal => Diagnostic(kind: kind, message: message, fatal: true)
ERROR[{kind}] {message} ^error => Diagnostic(kind: kind, message: message)
 WARN{`@`}{var}{ }{comment ^comment} ^warn => report WARN var comment
 INFO{`@`}{var}{ }{comment ^comment} ^info => report INFO var comment
DEBUG{`@`}{var}{ }{comment ^comment} ^debug => report DEBUG var comment
TRACE{`@`}{var}{ }{comment ^comment} ^trace => report TRACE var comment

TODO{ }{comment ^comment} ^debug => DEBUG@. comment 

boolean := enum false (holds: None) | true (holds: global) {
  nand (b) => (.holds && (b as boolean).holds) ? false : true

  not => .nand(this)

  and (b) => .nand(b).not
  or (b) => .not.nand(b.not)
  nor (b) => .or(b).not
  xor (b) => .or(b).and(.nand(b))
  xnor (b) => .xor(b).not

  as (=== boolean) => this
  as (=== Binary) => this ? 1₂ : 0₂

  next => .not
  previous => .not

  & (b) => .and(b)
  && (b) => .and(b)
  || (b) => .or(b)
  !&& (b) => .nand(b)
  !|| (b) => .nor(b)
  x|| (b) => .xor(b)
  x!|| (b) => .xnor(b)
}

true := boolean.true
false := boolean.false

{l} [x: right-to-left] {m} [y: left-to-right] {r} => l[x] m & m[y] r

{base} [x: right-to-left] {middle_operand} [y: right-to-left] {top} => base[x] (middle_operand[y] top)

{left} [x: left-to-right] {middle} [y: right-to-left] {right} => (
  ERROR@middle `mixes directions around one operand; use parentheses`
  None
)

[x: right-to-left] {operand} [y: left-to-right] {rest} => ([x] operand)[y] rest

{first} [x: chainable] {shared} [y: chainable] {last} => (first[x] shared) & (shared[y] last)

{a} [x: compounds]{`=`} {b} => a = (a[x] b)

{guarded} if {condition} => (
  kept := None
  if condition { kept = guarded }
  kept
)
{guarded} unless {condition} => (
  kept := guarded
  if condition { kept = None }
  kept
)
