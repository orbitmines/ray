IP := class {
  segments: Node

  segment_count => .segments.count
  segment_length => 8

  bit_count => .segment_count * .segment_length

  separator => U+002E
  base => 10

  bits => (
    out := chain None
    walker ^keyword := .segments.head
    length := .segment_length
    while (exists walker) {
      bits_of(walker.value, length) for { out &= it.value }
      walker = walker.next
    }
    out
  )

  as_string => (
    parts := chain None
    walker ^keyword := .segments.head
    radix := .base
    while (exists walker) {
      parts &= walker.value.spelled_in(radix)
      walker = walker.next
    }
    String.joined(parts, .separator)
  )

  chainable == (other: IP) => .as_string == other.as_string

  from_bits (address_bits) => (
    out := chain None
    bit_at ^keyword := address_bits.head
    while (exists bit_at) {
      segment_bits := chain None
      left_in_segment ^keyword := .segment_length
      while ((exists bit_at).and(left_in_segment.nonzero)) {
        segment_bits &= bit_at.value
        bit_at = bit_at.next
        left_in_segment = left_in_segment.pred
      }
      out &= number_of(segment_bits)
    }
    this.components.hierarchy.head.value(segments: out)
  )

  compounds + (offset: Number) => .from_bits(IP.sum_of(.bits, bits_of(offset, .bit_count), false))
  compounds - (offset: Number) => .from_bits(IP.sum_of(.bits, IP.inverted(bits_of(offset, .bit_count)), true))

  sum_of (left_bits, right_bits, carry_in) => (
    reversed_bits := chain None
    carry_on ^keyword := carry_in
    left_at ^keyword := left_bits.tail
    right_at ^keyword := right_bits.tail
    while (exists left_at) {
      ones_here ^keyword := 0
      if left_at.value { ones_here = ones_here.succ }
      if right_at.value { ones_here = ones_here.succ }
      if carry_on { ones_here = ones_here.succ }
      sum_bit ^keyword := 0
      if ones_here.odd { sum_bit = 1 }
      reversed_bits &= sum_bit
      carry_on = 1 < ones_here
      left_at = left_at.previous
      right_at = right_at.previous
    }
    forwards := chain None
    walker ^keyword := reversed_bits.tail
    while (exists walker) {
      forwards &= walker.value
      walker = walker.previous
    }
    forwards
  )
  inverted (some_bits) => (
    flipped := chain None
    some_bits for {
      flipped_bit ^keyword := 1
      if it.value { flipped_bit = 0 }
      flipped &= flipped_bit
    }
    flipped
  )

  compounds / (prefix_length: Number) => (
    kept_bits ^keyword := prefix_length
    cleared := chain None
    bit_at ^keyword := .bits.head
    while (exists bit_at) {
      if kept_bits.is_zero { cleared &= 0 } else {
        cleared &= bit_at.value
        kept_bits = kept_bits.pred
      }
      bit_at = bit_at.next
    }
    this.from_bits(cleared)
  )

  read (text: String, separator: Character, radix: Number) => (
    out := chain None
    text.split(separator) for { out &= it.value.as_number_in(radix) }
    out
  )
}

IP.v4 = class: IP {
  segment_length => 8
  separator => U+002E
  base => 10
}

IP.v4.Segment = Number{. < 256}

IP.v6 = class: IP {
  segment_length => 16
  separator => U+003A
  base => 16

  zeros => (
    best_at ^keyword := 0
    best_run ^keyword := 0
    at ^keyword := 0
    run ^keyword := 0
    walker ^keyword := .segments.head
    while (exists walker) {
      if walker.value.is_zero {
        run = run.succ
        if (best_run < run) {
          best_run = run
          best_at = at.succ - run
        }
      } else { run = 0 }
      at = at.succ
      walker = walker.next
    }
    Chain.Run(at: best_at, length: best_run)
  )

  compressed => (
    found := .zeros
    if (found.length < 2) { .as_string } else {
      before := .written(0, found.at)
      after := .written(found.at + found.length, .segment_count)
      before + ("::" + after)
    }
  )

  written (from: Number, until: Number) => (
    parts := chain None
    at ^keyword := from
    radix := .base
    while (at < until) {
      parts &= .segments.at(at).value.spelled_in(radix)
      at = at.succ
    }
    String.joined(parts, .separator)
  )
}

IP.v6.Segment = Number{. < 65536}

Chain.Run = class {
  at: Number
  length: Number
}

IPv4 := IP.v4
IPv6 := IP.v6
