
// Expression: a language read from its own text. Its first line says how a rule is written: `!language`, the brackets a
// hole is written in (`{ }`), then the rule that makes rules, written with them (`{LHS} => {RHS}`). Every statement after it
// is read in a node by the longest of that node's rules that reads it; the rule that makes rules adds one there, its head
// read the same way, its body read when it is applied, in a node of its own whose caller is what applied it. Only four
// things are given: `external .` (a node), `external &` (what applies), `external goto` and `external label` (where control
// goes). Read under a level, `Program{O: …}`, what it reads is a Program (statements as vertices, gotos as edges), and a
// back end is one more level: `Wasm` writes that Program as WebAssembly.
NodeX := None
ProgramX := None
StatementsX := None
globalX := None
PaintedX := None
LaterX := None
Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    // (a hole's brackets, a space where its name goes)
    CAPTURE: (String+, \s, String+),
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}(`LHS`) | RHS: CAPTURE.map{== \s}(`RHS`) | String)[],
    \n\n
  ),
  (
    // (the rule that makes rules: any space in it any amount of space, each hole anything, its left side a head of the same
    // shape again, `[LHS: [LHS, RHS], RHS]`; the first statement)
    Code := (BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Code) | String)[]
    Head := (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (inside: Code)) | String)[]
    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES.map{is \s}((space) => \s[])
    GRAMMAR_RULE_DEF.RHS = Code
    GRAMMAR_RULE_DEF.LHS = Code
    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF
    
    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,
    statements: (
      // A node: its rules by their heads; what it does not read, what it is in reads.
      Node := class (in?: Node) => {
        // (itself, as its rules' bodies name it: `this` there is what a statement calls them on)
        node := this
        rules := {
          [rule: GRAMMAR_RULE.LHS] := (caller) => {
            // (the node its body is read in, kept with it: what it reads there, its statements, is its body)
            rule_body := Node(in: node)
            // (what it is written as, each `{name}` a hole took where it is defined written as what that hole took)
            taken := takes(caller)
            rule_lhs := level spliced (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)
            rule_rhs := inside_of(level spliced (rule.RHS) (BOOTSTRAPPER.CAPTURE) (taken))
            // (where it is defined: here, or, when its head is what the holes of a rule took, beside the statement that applied that
            // rule (a rule that writes a rule writes it where it is used))
            rule_home := home_of(caller, level spliced_entry (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)) ?? node
            // (and what each hole is shown as, `{x ^style}`: what reading its head painted)
            outer_sink := sink
            sink = Array.new
            head := (rule_lhs as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => node.named(hole.inside))
            rule_styled := sink.map((sp) => Array.new.append(level place_name (sp.rest.first)).append(sp.first))
            sink = outer_sink
            // (its body, read once, when it is first applied, and what it is shown as, `{head} ^style => …`, looked up then)
            rule_read := Once()
            rule_style := Once()
            rule_home.rules[[head]] := (caller) => {
              took := holes
              me := running(applied, caller, holed(rule_body, took, (c, hole) => caller.in.named_by(hole.value, caller)), caller.this, took)
              took.for((hole) => rule_styled.for((sh) => hole_painted(sh, hole)))
              rule_painted(rule_style.of(() => styles_shown{.first === rule_own}#), rule_lhs, me)
              leaving(me, rule_read.of(() => body_of(took, rule_body, rule_rhs, rule_own))(me))
            }
            rule_home.rules[[head]].body = rule_body
            rule_own := rule_home.rules.keys.last
            // (the pairs its head writes, a hole between two characters (`({x})`, `"{x}"`), known to what is read after it)
            level paired (rule_lhs) (BOOTSTRAPPER.CAPTURE)
            defining_kept(rule_own, rule_lhs)
            rule_own
          }
          [{value: concurrently node.prefix(.)}: node.keys, rest: String] := (caller) => {
            v := value(caller)
            on := Node(in: caller.in)
            members(v).for((m) => on.rules[[m.key]] := (c) => m.value)
            r := (rs: Statements(on) = rest)
            me := running(applied, caller, on, v, None)
            leaving(me, r(me))
          }
        }
        named (text) => named_by(text, Program(in: node))
        // (a name: what reading it answers, by what applied it; a place, if nothing reads it or it is read inside its own
        // reading)
        named_by (text, by) => naming.holds(text) ? Place(text, node) : naming.during(text, () => named_now(text, by))
        named_now (text, by) => {
          v := (vs: Statements(node) = text)
          (v === None) ? Place(text, node) : v(by)
        }
        split_key := rules.keys.last
        maker_key := rules.keys.first
        // (the longest of its rules that reads a statement, else what it is in reads: a definition (`=>` outside pairs) by the
        // latest rule that defines, else the rule that makes rules; anything else by any other but the split; and never a rule
        // whose body is being read)
        whole (tx) => (made(tx) ? (defining(tx) ?? maker_key) : longest(tx)) ?? in?.whole(tx)
        prefix (tx) => longest(tx) ?? in?.prefix(tx)
        made (tx) => (rules.keys.first === maker_key) && ((tx ~= maker_key) && defines(tx))
        defining (tx) => rules.keys{definer_is(.) && (!(aside.holds(.)) && (tx ~= .))}#.sort(.length).last
        longest (tx) => rules.keys{!((. === split_key) || aside.holds(.)) && ((!((. === maker_key) || definer_is(.)) || defines(tx)) && (tx ~= .))}#.sort(.length).last
        longer (lw, ls) => (lw === None) ? ls : ((ls === None) ? lw : ((ls.length > lw.length) ? ls : lw))
        reading (tx) => {
          w := whole(tx)
          (w === maker_key) ? w : longer(w, (split_key === None) ? None : ((tx ~= split_key) ? split_key : None))
        }
        keys => (in === None) ? rules.keys : ((rules.keys === None) ? in.keys : (rules.keys | in.keys))
      }
      // A program running: what applied it, where it is.
      Program := class (caller?: Program, at?: Statement, in?: Node, this?: Node) => { }
      Argument := class (\s+, word: String) => { }
      global := Node({
        rules[`external`, \s+, rule: String, args: Argument[]] := (caller) => {
          `.` => Node(in: caller.at.node)
          `&` => caller
          `goto` (to) => (caller.at = to.first) if (to.rest.empty || to.rest.first)
          `label` (to) => to.first
          `style` (how) => painted_with(how, caller)
          `shown` (how) => how.first
        }[rule](args.map((argument) => caller.in.named(argument.word)))
      })
      // Statements: each, after any space, read by the longest rule that reads it (all at once, where they can be); run in
      // order, each given what applies them.
      Statement := class (
        leading_whitespace?: (\s | \n)[]+,
        {statement: concurrently context.reading(.)}: context.keys
      ) => {}
      // (what is being read, while it is: a name read inside its own reading, a rule set aside while its body is read)
      Reading := class () => {
        now := Array.new
        holds (x) => now{. == x}#.count > 0
        during (x, f) => {
          .now = Array.new.append(x).joined(now)
          v := f()
          .now = now.rest
          v
        }
      }
      naming := Reading()
      aside := Reading()
      // (the brackets holes are written in, the header's, a pair: what a statement written over lines is closed by)
      bracketed := level closing (BOOTSTRAPPER.CAPTURE)
      // (what is painted, `external style`: each style with what it is shown on, in turn; the host reads them)
      painted := Array.new
      painted_with (pa, pc) => {
        pe := Array.new.append(pa.first).append(pa.last).append(bound_along(pc))
        painted.append(pe)
        sink.append(pe)
        styles_shown.append(Array.new.append(pa.last).append(pa.first))
        pa.last
      }
      sink := Array.new
      styles_shown := Array.new
      // (a rule shown as written, `{head} ^style => …`, where it is applied: what its head reads there but the holes)
      rule_painted (rs, rh, rm) => (rs.count > 0) ? painted.append(Array.new.append(rs.first.rest.first).append(Array.new.append(rh).append(rm.input)).append(Array.new.append(rm.bound))) : None
      // (a hole shown as its head says, `{x ^style}`, where it is applied: the text it took, in that style)
      hole_painted (hs, hh) => (hs.first == hh.key) ? painted.append(Array.new.append(hs.rest.first).append(hh.value).append(Array.new.append(Array.new.append(hh)))) : None
      // (where it is painted: what the holes took in each program it runs in, the nearest first)
      bound_along (bc) => (bc === None) ? Array.new : Array.new.append(bc.bound).joined(bound_along(bc.caller))
      // (a rule's body, read the first time it is applied, with the rule itself set aside (a rule never reads its own body):
      // each hole found in what runs it, the nearest program it is `bound` in, by what applied that one)
      body_of (took, body, code, rule) => aside.during(rule, () => {
        shape := holed(body, took, (c, hole) => hole_in(c, hole.key))
        (rhs: Statements(shape) = code)
      })
      // (a node where each hole a rule took is read by its name, as it is or in the brackets holes are written in)
      holed (outer, took, found) => {
        n := Node(in: outer)
        took.for((hole) => {
          n.rules[[hole.key]] := (c) => found(c, hole)
          n.rules[[BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => found(c, hole)
        })
        n
      }
      // (an application running: what applied it, the node it reads in, what it is on, what its holes took)
      running (me, by, at, on, took) => {
        me.caller = by
        me.in = at
        me.this = on
        me.bound = took
        me
      }
      // (what is read once, the first time it is asked for, then kept)
      Once := class () => {
        kept := Array.new
        of (f) => kept.empty ? kept.append(f()).first : kept.first
      }
      hole_in (hc, hk) => (hc === None) ? None : hole_found(hc, hk, (hc.bound === None) ? None : hc.bound{.key === hk}#.first)
      hole_found (fc, fk, fe) => (fe === None) ? hole_in(fc.caller, fk) : fc.caller.in.named_by(fe.value, fc.caller)
      // (a body written in the brackets holes are written in is the code inside them)
      inside_of (it) => {
        code := level cw_trimmed (it)
        ((code.first == BOOTSTRAPPER.CAPTURE.first) && ((level cw_enclosed (code)) === true)) ? level cw_trimmed (level cw_span_of (level cw_slice (code) (1) (2)) (level cw_chopped (code))) : code
      }
      // (the rules that are definitions themselves, their heads holding what a definition is written with (`=>`, as the
      // header writes it): one that reads a statement the rule that makes rules reads takes it, the latest first)
      definers := Array.new
      home_of (hc, he) => ((he === None) || (hc === None)) ? None : ((hc.bound === None) ? home_of(hc.caller, he) : ((hc.bound{. === he}#.count > 0) ? ((hc.caller === None) ? None : hc.caller.in) : home_of(hc.caller, he)))
      defining_kept (dk, dl) => ((level holds_text (dl) (level separator_of (BOOTSTRAPPER.CAPTURES.text) (BOOTSTRAPPER.CAPTURE))) === true) ? definers.append(dk) : None
      definer_is (dk) => definers{. === dk}#.count > 0
      // (a statement is a definition when it holds what one is written with outside every pair: `=>` outside brackets)
      defines (dt) => (level holds_outside (dt) (level separator_of (BOOTSTRAPPER.CAPTURES.text) (BOOTSTRAPPER.CAPTURE))) === true
      // (what the holes took where a program runs, the nearest first)
      takes (tc) => (tc === None) ? Array.new : ((tc.bound === None) ? takes(tc.caller) : tc.bound.joined(takes(tc.caller)))
      // (what is kept for afterwards, each run in turn once everything is read)
      later := Array.new
      afterwards := Place(`afterwards`, global)
      // (statements run in turn by a program, each answering: after one jumps (`external goto`), on from its label
      // (`external label`) among them all; none there, the jump goes on in what applied the program (`leaving`), or, to the
      // host's `afterwards`, it is kept with the rest for when everything is read)
      run_all (p, all) => run_from(p, all, all, None)
      run_from (p, all, from, answer) => from.empty ? answer : went(p, all, from, from.first(p))
      went (p, all, from, answer) => (p.at === None) ? run_from(p, all, from.rest, answer) : jumped(p, all, from, answer, labelled(p, all))
      jumped (p, all, from, answer, to) => (to === None) ? ((p.at == afterwards) ? kept_later(p, all, from.rest, answer) : answer) : run_from(gone_on(p), all, to, answer)
      labelled (p, ls) => ls.empty ? None : (label_is(p, ls.first) ? ls.rest : labelled(p, ls.rest))
      label_is (p, s) => (s.rule == `label`) && (p.in.named(s.args.first.word) == p.at)
      gone_on (p) => {
        p.at = None
        p
      }
      kept_later (p, all, from, answer) => {
        later.append(Array.new.append(all).append(from).append(gone_on(p)))
        answer
      }
      leaving (me, answer) => {
        (me.caller.at = me.at) if !(me.at === None)
        answer
      }
      run_later (rl) => later.empty ? None : ran_later(later.first, later.rest)
      ran_later (lf, lr) => {
        later = lr
        run_from(lf.last, lf.first, lf.rest.first, None)
        run_later(0)
      }
      // (the statements as read kept on the node they are read in, `statements`: what each read, its rule and what that took)
      Statements (context: Node) => dynamically Statement[] & (caller: Program) => (
        context.statements = .
        run_all(caller, listed(.))
      )
      // (what was read, one after another)
      listed (lr) => lr.map((s) => s.statement)

      NodeX = Node
      ProgramX = Program
      StatementsX = Statements
      globalX = global
      PaintedX = painted
      LaterX = run_later
      top := Program(in: global)
      Statements(global)(top)
    ),
    (\s | \n)[]
  )
) => {
  // (what was kept for afterwards, run now that everything is read)
  LaterX(0)
}
ex := (level input_part 0) as Expression
parse_node_of (grammar_text) => {
  g := NodeX(in: globalX)
  (gs: StatementsX(g) = grammar_text)(ProgramX(in: g))
  p := NodeX()
  level moved_keys (g) (p)
  leaf := NodeX(in: globalX)
  (ls: StatementsX(leaf) = "{name_word} => external &")(ProgramX(in: leaf))
  p.split_key = leaf.rules.keys.last
  p
}
parser (grammar, program_text) => {
  grammar.parse_node = grammar.parse_node ?? parse_node_of(grammar.text)
  level curried_value (ps: StatementsX(grammar.parse_node) = program_text)
}
level set_parser (parser)
assert "!language   { }   {LHS} => {RHS}\n\n" as Expression -- .(
  .BOOTSTRAPPER.CAPTURE == `{ }`
  & .BOOTSTRAPPER.CAPTURES.LHS == `{LHS}`
  & .BOOTSTRAPPER.CAPTURES.RHS == `{RHS}`
)
// (its parts, each in turn)
assert {
  Ranged2 := class low: Decimal, "-", high: Decimal { }
  ranged2: Ranged2 = 3-8
  assert ranged2.high == 8  // ZZ1
  assert (`2-7` as Ranged2).high == 7  // ZZ2
  Ranged3 := class (low: Decimal, "-", high: Decimal) => { }
  ranged3: Ranged3 = 3-8
  assert ranged3.high == 8  // ZZ3
  Ranged4 := class (low: String+, "-", high: String+) => { }
  ranged4: Ranged4 = 3-8
  assert ranged4.high == "8"  // ZZ4
  Ranged5 := class (low: String+, `-`, high: String+) => { }
  ranged5: Ranged5 = 3-8
  assert ranged5.high == `8`  // ZZ5
  assert (`3-8` as Ranged5).high == `8`  // ZZ6
  Ranged6 := class (low: String+, \s, high: String+) => { }
  assert (`3 8` as Ranged6).high == `8`  // ZZ7
}
assert `{ }` is (String+, \s, String+)  // EX1 a hole's brackets around a space are not a capture
assert {
  Headed := class (head: `!language`, \s[]+, rest: String) => { }
  assert (`!language  x` as Headed).rest == `x`  // EX2 a text read as a structure does not give its last field what follows the space
}
assert {
  Captured := class (left: String+, \s, right: String+) => { }
  assert (`{ }` as Captured).left == `{`  // EX3 a text read as a structure does not give its first field the text before the space
}
assert {
  Inner := class (left: String+, \s, right: String+) => { }
  Outer := class (inner: Inner, `;`) => { }
  assert (`{ };` as Outer).inner.left == `{`  // EX4 a field of a structure is not read as its own structure
}
assert {
  Nested := class (inner: (left: String+, \s, right: String+), `;`) => { }
  assert (`{ };` as Nested).inner.right == `}`  // EX5 a field written as a structure is not read as one
}
assert {
  Spanned := class (spanned: (String+, \s, String+), `;`) => { }
  assert (`{ };` as Spanned).spanned == `{ }`  // EX6 a field written as positions does not take their span
}
assert `{LHS}` is `{ }`.map{== \s}(`LHS`)  // EX7 a text's space mapped to LHS does not read {LHS}
assert !(`{ }` is `{ }`.map{== \s}(`LHS`))  // EX9 a text's space mapped to LHS still reads the space
assert {
  Dependent := class (open: String, \s, close: open) => { }
  assert (`a a` as Dependent).close == `a`  // EX8 a field's type does not see a field before it
}
assert {
  Scoped := class (
    (
      statements: (
        Seen := 46
        Node := class (marked?: Node) => { mark := 1 }
        Inner := class (in?: Inner) => {
          rules := { got := (x) => Seen }
          made => Node()
        }
        got_seen := Inner().rules.got(0)
        made_mark := Inner().made.mark
        String
      )
    )
  ) => { }
  scoped := "x" as Scoped
  assert (external member (scoped) (`got_seen`)) == 46  // EX10 a closure in a class written in a header's statements does not see the header's names
  assert (external member (scoped) (`made_mark`)) == 1  // EX11 a class's `Node` written in a header's statements is the language's
}
