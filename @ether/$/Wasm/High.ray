// High: Ray code written as the low level's (what the runtime is written in), then written as WebAssembly by `Low`. A
// value is one i32 (a number twice itself and one; None 0, false 8, true 12; a node, a list, a text, a closure, a class
// where it is made); a name is read in the scope it is written in (`get(scope, its number)`); each function the
// runtime's `(env, args, named)`, its scope a node in what it was made in (a class's, the instance). (What a function
// written inside another writes is set aside, written after.)
High := {
  static closing (cz) => High.w(")")
  static w (wt) => level write wt
  static number (wn) => level cw_write_number wn
  static symbol (sn) => High.number(High.symbol_number(Compiled.trimmed(sn)))
  static symbol_number (sy) => (sy === None) ? None : level cw_symbol_of (sy)
  static unescaped (ue) => (ue === None) ? None : level cw_unescaped (ue)
  static chopped (cp) => (cp === None) ? None : level cw_chopped (cp)
  static span_of (sa, sb) => ((sa === None) || (sb === None)) ? None : level cw_span_of (sa) (sb)
