// Types: what a value is built on, and where a type is written.

mark ^keyword := global

TA := class { }
TB := class: TA { }
unless TA() is TA { INFO@mark `TY1 an instance is not an instance of its class` }
unless TA() is TB { INFO@mark `TY2 an instance is not one of a class that requires nothing` }
unless TB() is TB { INFO@mark `TY3 an instance is not an instance of its own class` }
unless TB() is TA { INFO@mark `TY4 an instance is not an instance of what its class is built on` }
unless 5 is Number { INFO@mark `TY5 five is not a Number` }
unless 5 is TA { INFO@mark `TY6 five is not one of a class that requires nothing` }

// A class requires the fields it writes with their type
Needs := class { amount: Number }
Gives := class { amount => 1 }
Lacks := class { other => 1 }
unless Gives() is Needs { INFO@mark `TY60 what gives every required name is not one` }
if Lacks() is Needs { INFO@mark `TY61 what lacks a required name is one` }
if 5 is Needs { INFO@mark `TY62 a number gives a name it does not have` }
unless 1 is Array { INFO@mark `TY63 a number is not an array` }
if Lacks() is Array { INFO@mark `TY64 what is entered nowhere is an array` }

unless external where TA { INFO@mark `TY7 a class is written nowhere` }
if (external where TA) == (external where TB) { INFO@mark `TY8 two classes are written in one place` }
TC := TA
unless (external where TA) == (external where TC) { INFO@mark `TY9 one class under two names is written twice` }

// A child is made of its parent's fields, defaults and methods
Parent := class {
  named: "p"
  flag: false
  greet => named
}
Child := class: Parent {
  extra: "e"
}
unless Child().extra { INFO@mark `TY10 the child's own field is not there` }
unless Child().named { INFO@mark `TY11 the parent's field is not there` }
unless Child().greet == "p" { INFO@mark `TY12 the parent's method does not answer` }
unless !Child().flag { INFO@mark `TY13 the parent's default is not false` }
unless Child(named: "q").named == "q" { INFO@mark `TY14 the parent's field cannot be given` }

// Narrowings ask the constraint as well as what they narrow
Small := Number{. < 5}
Tiny := Small{. < 2}
Even := Number{. % 2 == 0}
unless 3 is Small { INFO@mark `TY16 three is not one of the small` }
if 7 is Small { INFO@mark `TY17 seven is one of the small` }
unless 3 is Number { INFO@mark `TY18 three is not a number` }
unless 1 is Tiny { INFO@mark `TY19 one is not tiny` }
if 3 is Tiny { INFO@mark `TY20 three is tiny` }
if 7 is Tiny { INFO@mark `TY25 seven is tiny` }
unless Tiny.admits(1) { INFO@mark `TY26 the tiny do not admit one` }
if Tiny.admits(3) { INFO@mark `TY27 the tiny admit three` }
unless 4 is Small & Even { INFO@mark `TY65 four is not both small and even` }
if 3 is Small & Even { INFO@mark `TY66 three is both small and even` }
if 6 is Small & Even { INFO@mark `TY67 six is both small and even` }
unless (1 & 2).contains(2) { INFO@mark `TY68 what holds both does not hold the second` }
unless (1 & 2 & 3).conjoined.count == 3 { INFO@mark `TY69 three held at once are not three` }

// A class built inside a method answers with what that call wrote
Wrapping := class {
  wrapped (tag) => class: this {
    says => tag
  }
}
once := Wrapping.wrapped(1)
twice := once.wrapped(2)
thrice := twice.wrapped(3)
unless once.says == 1 { INFO@mark `TY28 the first wrapping says other than what it was written with` }
unless twice.says == 2 { INFO@mark `TY29 a wrapping of a wrapping says its parent's` }
unless thrice.says == 3 { INFO@mark `TY30 a third wrapping says an older one's` }
unless once.says == 1 { INFO@mark `TY31 building on a class changed what it says` }

// `Type?` is the type or nothing
Either := Parent?
unless Child() is Either { INFO@mark `TY21 a child is not one of its parent or nothing` }
unless Parent() is Either { INFO@mark `TY22 a parent is not one of itself or nothing` }
unless None is Either { INFO@mark `TY23 nothing is not one of a thing or nothing` }
if None is Parent { INFO@mark `TY24 nothing is one of a thing` }

// A class written as a structure: each named position a field of that type
Pointed := class whole: Number, ".", part: Number {
  summed => whole + part
}
pointed := Pointed(whole: 2, part: 3)
unless pointed.whole == 2 { INFO@mark `TY32 a structure's first field is not what it was built with` }
unless pointed.part == 3 { INFO@mark `TY33 a structure's last field is not what it was built with` }
unless pointed.summed == 5 { INFO@mark `TY34 a structure's body does not read its fields` }
unless Pointed.positions[1] == "." { INFO@mark `TY35 a structure does not keep what is written between its fields` }

Ranged := class low: Decimal, "-", high: Decimal {
  width => high - low
}
range_of{ }{written: Ranged} => written
ranged := range_of 2-7
unless ranged.low == 2 { INFO@mark `TY36 a structure read from text does not start at what is written first` }
unless ranged.high == 7 { INFO@mark `TY37 a structure read from text does not end at what is written last` }
unless ranged.width == 5 { INFO@mark `TY38 a structure read from text is not built as one` }
positioned: Ranged = (4, "-", 9)
unless positioned.width == 5 { INFO@mark `TY39 positions given to a structure are not built as one` }
misfit: Ranged = (4, "+", 9)
unless misfit[1] == "+" { INFO@mark `TY40 positions that do not fit a structure are taken as a structure` }
spanned: Ranged = 3-8
unless spanned.width == 5 { INFO@mark `TY41 text given to a structure is not read by it` }

// Class headers: fields written inline, a class read by its pattern, `static` (A7, T3.10, T3.15b)
Pair := class left: Number, right: Number = 7 {
  total => left + right
}
unless Pair(1, 2).left == 1 { INFO@mark `HD1 a header field is not taken by position` }
unless Pair(1, 2).right == 2 { INFO@mark `HD2 the second header field is not taken by position` }
unless Pair(right: 3, left: 4).total == 7 { INFO@mark `HD3 header fields are not taken by name` }
unless Pair(1).right == 7 { INFO@mark `HD4 a header default is not used when not given` }
Bare := class only: Number
unless Bare(3).only == 3 { INFO@mark `HD6 a header without a body has no field` }
Tagged := class ("#", tag: Decimal) => {
  doubled => tag * 2
}
unless Tagged(tag: 4).doubled == 8 { INFO@mark `HD7 a class read by its pattern has no named part as a field` }
tagged_of{ }{written: Tagged} => written
unless (tagged_of #21).tag == 21 { INFO@mark `HD8 a class written as a pattern does not read its text` }
Sub := class: Pair (": ", first: Number) => {
  head => first
}
unless Sub(first: 2).head == 2 { INFO@mark `HD9 class: Parent (pattern) has no field from its pattern` }
unless Sub(first: 2) is Pair { INFO@mark `HD10 class: Parent (pattern) is not built on Parent` }
Count := class {
  static made := 0
  static zero => 0
  static Inner := class { }
  tally => made
}
first_count := Count()
second_count := Count()
Count.made = 2
unless first_count.tally == 2 { INFO@mark `HD11 a static is not shared by the instances` }
unless second_count.tally == 2 { INFO@mark `HD12 a static is per instance` }
unless Count.zero == 0 { INFO@mark `HD13 a static method is not on the class` }
unless Count.Inner { INFO@mark `HD14 a static class is not on the class` }
Both := class: Pair &+ Tagged { }
unless Both(left: 1, right: 2, tag: 3).total == 3 { INFO@mark `HD15 class: A &+ B is not built on A` }
unless Both(left: 1, right: 2, tag: 3).doubled == 6 { INFO@mark `HD16 class: A &+ B is not built on B` }

// Negations on nothing answer true (T1.8)
unless None != 1 { INFO@mark `NGN1 nothing is said to be one` }
unless None !~= "a" { INFO@mark `NGN2 nothing is said to match` }
unless None != 5 && !(None != None) { INFO@mark `NGN3 a negation on nothing does not answer true against something, or holds against nothing` }
cleared_vertex := [1, 2].entry
kept_vertex := cleared_vertex
cleared_vertex = None
if kept_vertex.initial || kept_vertex.terminal { INFO@mark `NGN4 a vertex set to nothing keeps its boundaries` }

// Uniqueness under an equivalence (T6.9)
UniquelyNamed := class { unique<in: .fold_case> name: String }
named_first := UniquelyNamed(name: "Ada")
named_other := UniquelyNamed(name: "Bea")
unless named_other.name.is_unique<in: .fold_case> { INFO@mark `UQI1 a name no other holds is not unique` }
named_clash := UniquelyNamed(name: "ADA")
if named_clash.name.is_unique<in: .fold_case> { INFO@mark `UQI2 a name another holds in other case is unique with case folded` }
unless named_clash.name.is_unique { INFO@mark `UQI3 a name is not unique without folding case though no other is equal` }
unless [1, 2, 1].unique == [1, 2] { INFO@mark `UQI4 each thing once is no longer what unique answers` }

// A map's own key wins over Node's member (T8.7, T2.8)
counted_map := { count: 3 }
unless counted_map.count == 3 { INFO@mark `FWO1 a map's own count does not win over Node's` }
unless (counted_map as Object).count == 3 { INFO@mark `FWO3 a value without Node does not read its own key` }
