Access := class (who: *?, method: `=` | `()` | * = *, filter: Program?, target: *?) => {
  static Reading := *{. != `=` && . != `()`}
  assert `read` is Access.Reading  // AC27 reading is not a reading method
  assert !(`=` is Access.Reading)  // AC28 writing is a reading method
  assert !(`()` is Access.Reading)  // AC29 executing is a reading method

  // A grant's expression and filter are read to check it, never run for what they do: only one that changes nothing
  // outside itself and terminates is granted, so checking a permission runs no one's code. Reading the time stays
  // allowed (`@bob.read history{from Time.now}`, L§9.2), so this is `!Effecting`, not `Pure`.
  static checkable (expression) => !(expression is Program) || !(expression is Effecting) && expression is Terminating
  assert Access.checkable(Program(code: { 1 + 1 }))  // AC30 a program with no effects that terminates cannot be checked
  assert !Access.checkable(Program(code: { IO().output("x") }))  // AC31 a program with an effect can be checked
  assert Access.checkable(5)  // AC32 a value that is not a program cannot be checked

  allowed: *?

  allows (called) => called is method#
  assert Access(method: `=`).allows(`=`)  // AC33 a grant of writing does not allow writing
  assert !Access(method: `=`).allows(`()`)  // AC34 a grant of writing allows executing
  reads => allows(`read`)
  writes => allows(`=`)
  executes => allows(`()`)
  assert Access(method: Access.Reading).reads  // AC35 a grant of reading does not allow reading
  assert !Access(method: Access.Reading).writes  // AC36 a grant of reading allows writing
  assert Access(method: `=`).writes  // AC37 a grant of writing does not allow writing
  assert !Access(method: `=`).reads  // AC38 a grant of writing allows reading
  assert Access(method: `()`).executes  // AC39 a grant of executing does not allow executing
  assert !Access(method: `()`).writes  // AC40 a grant of executing allows writing
  // Who is compared as a principal (`answers_for`): identity in the core, verified roots with @ether/security.
  // A grant placed somewhere (its own location) holds only there; one placed nowhere holds everywhere (W2.27).
  covers (who, called, at = None) => who.answers_for(this.who) && allows(called) && (!location || !at || at is location#) && (!filter || checkable(filter) && filter.entered(this, None))
  assert {
    alice := Character(name: "alice")
    grant := Access(alice, method: `=`)
    assert grant.covers(alice, `=`)  // AC41 a grant does not cover the one it was given to
    assert !grant.covers(alice, `()`)  // AC42 a grant covers a method it does not allow
    assert !grant.covers(Character(name: "bob"), `=`)  // AC43 a grant covers someone it was not given to
  }

  // A grant is an Access on what it names: on what the expression answers when that is held somewhere (a value, a
  // field), on the expression itself when it derives something (`@ether.read x.count`, L§8.2.2).
  { }{literal target} ^punctuation => Program(code: target**) -- (named => checkable(named) && checkable(filter)
    ? named() -- (value => value is Node && value.parent ? value : named) -- (held => held ~~ .access |= (this ~~ .target = held))
    : ERROR@Access `a grant names an expression that changes nothing and terminates`)
}

none := Character{false}
assert !(Character(name: "anyone").answers_for(none))  // CST2 the permission nobody has reaches someone
assert none is local  // CST3 the permission nobody has is not the narrowest

{who: Character}.read ^keyword => Access(who, method: Access.Reading)
assert {
  zed := Character(name: "zed")
  assert zed.read.who.same(zed)  // AC44 `.read` is not a grant to that character
  assert zed.read.reads  // AC45 `.read` does not allow reading
  assert !zed.read.writes  // AC46 `.read` allows writing
  assert zed.write.writes  // AC47 `.write` does not allow writing
  assert !zed.write.reads  // AC48 `.write` allows reading
  assert zed.execute.executes  // AC49 `.execute` does not allow executing
}
{who: Character}.write ^keyword => Access(who, method: `=`)
{who: Character}.execute ^keyword => Access(who, method: `()`)
{who}{{literal filter}}.read ^keyword => Access(who, method: Access.Reading, filter: Program(code: (filter**)))
{who}{{literal filter}}.write ^keyword => Access(who, method: `=`, filter: Program(code: (filter**)))
{who}{{literal filter}}.execute ^keyword => Access(who, method: `()`, filter: Program(code: (filter**)))
const {target} ^keyword => target ~~ .access |= Access(none, method: `=`, target: target)
// const is none.write: nobody may write it, and what it holds inherits that.
assert (const (count: 1)).access#(const (count: 1)).some((const (count: 1)).who === none && (const (count: 1)).writes)  // CST1 const is not the permission nobody has
confidential = => Node.policy

Node &+= {
  static policy: * = none
  assert Node.policy === none  // AC50 the policy nobody has changed is not the permission nobody has

  visibility => access ?? (parent ? parent.visibility : None) ?? Access(Node.policy, method: Access.Reading, target: this)
  assert (count: 1).visibility.who === Node.policy  // AC51 a value granted nothing is not visible to the policy
  // Grants on a derivative sit on the expression that names it, found by what that expression answers (L§8.2.2).
  granted => [visibility#, Program#{.access && .names(this)}.access#].flatten
  allows (who, called, at = None) => granted.find(.covers(who, called, at)) ~~ (.allowed = this if .)
  // A secret is a node no one may read (`none.read`, W5.6): stores skip it and logging out drops it.
  unreadable => access#.some(.who === none && .reads)
  assert (const (count: 1)).unreadable == false  // AC52 a constant is unreadable 
  assert (count: 1).unreadable == false  // AC53 a value nobody restricted is unreadable
}
// confidential follows the policy, but never past @private.managed.
assert {
  with Node.policy = public {
    assert confidential is @private.managed  // CK1 confidential widens with a public policy
    assert !(Character(name: "stranger") is confidential)  // CK2 confidential reaches a stranger under a public policy
  }
}
assert {
  with Node.policy = local {
    assert confidential is local  // CK3 confidential is wider than a narrower policy
  }
}

Program &+= {
  names (value) => this === value || this == value || Access.checkable(this) && this() === value
  assert Program(code: { 1 + 1 }).names(2)  // AC54 a checkable program does not name what it answers
  assert !Program(code: { 1 + 1 }).names(3)  // AC55 a program names what it does not answer
  // A grant names an expression: a derivative may be granted where the value it derives from is not.
  assert {
    gx_reader := Character(name: "reader")
    gx := (count: 3, secret: "s")
    gx_reader.read gx.count
    gx_grant := Program#{.access#.some(.who === gx_reader)}.first?.access
    assert gx_grant.target is Program  // GX1 a grant took the value of what it names instead of the expression
    assert gx_grant.target.names(Program(code: { gx.count }))  // GX2 a grant does not name the expression it was given
    assert !(gx_grant.target.names(Program(code: { gx.secret })))  // GX3 a grant on one derivative names another
    assert Program(code: { gx.count }).allows(gx_reader, `count`)  // GX4 a granted derivative is refused
    assert !(Program(code: { gx.secret }).allows(gx_reader, `secret`))  // GX5 a grant on a count lets another field leave
    gx_whole := (count: 1)
    gx_reader.read gx_whole
    assert gx_whole.allows(gx_reader, `size`)  // GX6 a grant naming a value does not cover that value
    assert gx_whole.access#.some(.who === gx_reader)  // GACC1 a grant naming a value is not on that value
  }
  assert !(Program(code: { IO().output("leak") }).names("leak"))  // PURG4 checking a grant runs an expression with effects

  caller: Program?
  // Who runs a program is its chain of callers, the origin first; a prompt names them all.
  assert {
    hop_origin := Program(who: Character(name: "company"))
    hop_run := Program(who: Character(name: "me"), caller: hop_origin)
    assert hop_run.hops.first === hop_origin.who && hop_run.hops.last === hop_run.who  // HOP1 a run's chain is not its origin first and its runner last
    assert hop_run.prompt == "@company wants to run this, originating from @me"  // HOP2 a prompt does not name the whole chain
  }
  hops | chain => [caller.hops ?? [], who].flatten.unique
  assert Program(who: Character(name: "solo")).hops.count == 1  // AC56 a program with no caller has more than itself in its chain
  assert Program(who: Character(name: "solo")).prompt == "@solo wants to run this"  // AC57 a prompt for a lone program names more than its runner
  may (method, target) => hops.every(target.allows(., method))
  ask (method, target) => may(method, target) || ERROR@Access `not granted`
  assert &@.ask(`()`, @me/device/camera).erred  // AC26 a capability nobody granted does not err
  prompt => hops.map(.PREFIX + .name) -- (named => named.first + " wants to run this"
    + (named.count > 1 ? ", originating from " + named[1..].join(" <- ") : ""))

  // What a run may do is the runner's setting (L§8.1): `with (Program.speculated |= x)`, `with (Program.refused |= x)`, or a `.cfg.ray`.
  static speculated: *[] = []
  static refused: *[] = []
  assert Program.speculated.count == 0  // AC58 nothing is speculated unless asked
  assert Program.refused.count == 0  // AC59 nothing is refused unless asked

  continuations => calls{!.is_external}.map(.**)
  effects => reachable.map(.calls{.is_external}.external_name).flatten.unique
  assert Program(code: { IO().output("x") }).effects.contains("io")  // AC60 writing out is not an effect named io
}
// What a program does is what its externals are: io and os are effects, the time is not deterministic.
assert Program(code: { 1 + 1 }) is Pure  // EFF1 adding numbers is not pure
assert Program(code: { IO().output("x") }) is Effecting  // EFF2 writing out is not an effect
assert !(Program(code: { Time.now }) is Deterministic)  // EFF3 reading the time is deterministic
assert {
  with (Program.refused |= Program(code: { IO().output("x") })) {
    assert Program(code: { IO().output("x") }) is Refused  // EFF4 a refused program is not refused
  }
}
assert Program(code: { IO().output("x") }) is Abstracted  // EFF5 an effect nobody speculated runs in full

&@ ^keyword => &.caller as Program

Pure := Program{effects.empty}
assert Program(code: { 1 + 1 }) is Deterministic  // AC61 adding numbers is not deterministic
assert !(Program(code: { 1 + 1 }) is Effecting)  // AC62 adding numbers is an effect
assert Program(code: { Time.now }) is Nondeterministic  // AC63 reading the time is not nondeterministic
assert !(Program(code: { 1 + 1 }) is Nondeterministic)  // AC64 adding numbers is nondeterministic
Deterministic := Program{!effects.some(. is ("random" | "time" | "io"))}
Nondeterministic := Program{!(. is Deterministic)}
Effecting := Program{effects.some(. is ("io" | "os"))}
Initializer := Program{.calls.every(.is_external && .external_name is ("declare" | "assign"))}
assert Program(code: { x := 1 }) is Initializer  // AC65 a program that only declares is not an initializer
assert !(Program(code: { IO().output("x") }) is Initializer)  // AC66 a program that writes out is an initializer
Refused := Program{. is Program.refused#}
Abstracted := Program{. is Effecting && !(. is Program.speculated#)}

[(`pure`, Pure), (`deterministic`, Deterministic), (`nondeterministic`, Nondeterministic)].for (word, claim) => {
  right-to-left `word` {method} ^keyword => method -- (ERROR `this method is not what it is marked as` unless method** is claim)
}

// (what the bootstrap leaves to this file: it needs what is here)
Node &+= {
  right-to-left internal => this ~~ .access = Access(&.caller, method: Access.Reading, target: this)
}
// Checking a permission runs no one's code: a grant whose expression or filter has effects is refused when granted, and never run.
assert {
  purg_reader := Character(name: "purg-reader")
  purg_lamp := (lamp: 1)
  assert (purg_reader.read IO().output("leak")) is Diagnostic  // PURG1 a grant naming an expression with effects is granted
  assert (purg_reader{IO().output("leak")}.read purg_lamp) is Diagnostic  // PURG2 a grant whose filter has effects is granted
  assert !(purg_lamp.access)  // PURG3 a refused grant is kept
  assert !((purg_reader.read Time.now) is Diagnostic)  // PURG5 a grant reading the time is refused
}
