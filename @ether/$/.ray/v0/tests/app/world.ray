// Worlds, characters, quests, histories and the features: built by their
// constructors from the fields their classes declare.

mark ^keyword := external global

wg := World(name: "genesis")
wp := wg.add(Player(name: "alice"))
unless wp.name == "alice" { INFO@mark `WO1 spawned player lost its name` }
unless wg.characters.count == 1 { INFO@mark `WO2 world has other than one character` }
wq := Quest(name: "find", goal: None)
if wq.done { INFO@mark `WO3 a new quest is done` }
wh := History(repository: wg)
unless wh.commit(wp, "hello").count == 1 { INFO@mark `WO4 a commit did not add to the history` }
unless Network.DomainName(text: "a.b").valid { INFO@mark `WO7 the domain name a.b is not valid` }
if Network.DomainName(text: "").valid { INFO@mark `WO8 a name of nothing is a valid domain name` }
unless Keyboard.Key(name: "a").press.pressed { INFO@mark `WO9 a pressed key is not pressed` }
unless Chat().say(wp, "hi").count == 1 { INFO@mark `WO10 a said message is not in the chat` }
unless Proof.theorem(Proof.Proposition(holds: true), Proof(proposition: None, argument: Proof.Proposition(holds: true))) { INFO@mark `WO11 the theorem does not hold` }

// Locations: what holds what, and how deep that goes.
here := Location(host: None)
there := here.holds(Location(host: None))
unless here.depth == 0 { INFO@mark `LO1 a location nothing holds is not at zero` }
unless there.depth == 1 { INFO@mark `LO2 a held location is not one deep` }
unless here.children.count == 1 { INFO@mark `LO3 the holder does not hold one` }
unless there.parent { INFO@mark `LO4 a held location has no parent` }

// Tasks, references, characters and repositories: what a class says it holds.
wt := Task(name: "walk", goal: None)
if wt.interrupted { INFO@mark `TA1 a new task is interrupted` }
unless wt.interrupt.interrupted { INFO@mark `TA2 an interrupted task is not interrupted` }

wr := Reference(title: "a")
unless wr.draft { INFO@mark `RE1 a new reference is no draft` }
if wr.publish.draft { INFO@mark `RE2 a published reference is still a draft` }

wa := Avatar(character: wp, platform: None)
unless wp.add(wa).character.name == "alice" { INFO@mark `PE1 an embodied avatar is not of its character` }
unless wp.avatars.count == 1 { INFO@mark `PE2 a character has other than one avatar` }

unless Repository(world: wg).histories.empty { INFO@mark `RP1 a new repository already has histories` }
unless Region(name: "north").name == "north" { INFO@mark `RG1 a region is not a world by another name` }
unless here == here { INFO@mark `LO5 a location is not itself` }

// A world is a location: what holds places, and is held.
realm := World(name: "realm")
held := realm.holds(Location(host: None))
unless held.parent === realm { INFO@mark `WL1 a place a world holds does not have the world as its parent` }
unless realm.children.first === held { INFO@mark `WL2 a world does not hold the place it took` }
unless realm is Location { INFO@mark `WL3 a world is not a location` }

unless wg == wg { INFO@mark `WO12 a world is not itself` }
if wg == World(name: "other") { INFO@mark `WO13 two worlds are the same world` }

// Items: what one is issued by, where it is, and what says so.
wi := Item(name: "lamp", issuer: wg)
unless wi.name == "lamp" { INFO@mark `ITM1 an item lost its name` }
unless wi.issuer == wg { INFO@mark `ITM2 an item forgot who issued it` }
unless (wi ~~ .location = here).location == here { INFO@mark `ITM3 a moved item is not where it was moved` }
wc := Certificate(issuer: wg, secret: None)
unless (wi ~~ .certificate = wc).certificate == wc { INFO@mark `ITM4 a certified item does not carry its certificate` }

unless wp is Offline { INFO@mark `PE3 a new character is not offline` }
unless Accessor.Permission.public { INFO@mark `AC1 there is no public permission` }
if Accessor.Permission.private == Accessor.Permission.public { INFO@mark `AC2 private and public are the same` }

// Reserving a name: the world issues it, keeps it, and answers the same
// reservation to whoever asks for that name again.
wr := wg.reserve("alice")
unless wr.name == "alice" { INFO@mark `RS1 a reservation does not hold the name it was made for` }
unless wr.issuer == wg { INFO@mark `RS2 a reservation forgot which world issued it` }
unless wg.reservations.count == 1 { INFO@mark `RS3 the world did not keep what it issued` }
unless wg.reserve("alice") == wr { INFO@mark `RS4 reserving a taken name issues a second one` }
unless wg.reservations.count == 1 { INFO@mark `RS5 reserving twice kept two` }
unless wg.reserve("bob").name == "bob" { INFO@mark `RS6 another name is not another reservation` }
unless wg.reservations.count == 2 { INFO@mark `RS7 the world did not keep both` }
unless wg.reserved("alice") { INFO@mark `RS8 a taken name does not read as taken` }
if wg.reserved("carol") { INFO@mark `RS9 an untaken name reads as taken` }
// A name is taken within a world and nowhere else.
if World(name: "elsewhere").reserved("alice") { INFO@mark `RS10 a name reserved in one world is taken in another` }
unless wg.reserved("ALICE") { INFO@mark `RS11 a reserved name is free again in other letter case` }

// A history keeps what was committed, in the order it was committed.
repo := Repository(world: wg)
past := History(repository: repo)
unless past.count == 0 { INFO@mark `HI1 a new history already holds commits` }
past.commit(wp, "first")
unless past.count == 1 { INFO@mark `HI2 committing does not keep it` }
past.commit(wp, "second")
unless past.count == 2 { INFO@mark `HI3 committing twice keeps other than two` }
unless past.latest.value == "second" { INFO@mark `HI4 the latest is not the last committed` }
unless past.latest.who == wp { INFO@mark `HI5 a commit forgot who made it` }
branched := past.fork
unless branched.count == 0 { INFO@mark `HI6 a fork starts with commits on it` }
unless branched.base === past.last { INFO@mark `HI7 a fork forgot what it came from` }

// What is written down about something read.
cite := Reference(title: "on rays")
cite.authors.push wp
unless cite.draft { INFO@mark `RF1 a new reference is not a draft` }
if cite.publish.draft { INFO@mark `RF2 publishing does not take it out of draft` }
unless cite.notes.empty { INFO@mark `RF3 a new reference already has notes` }
cite.note = "a note"
unless cite.notes.count == 1 { INFO@mark `RF4 a note is not kept` }
unless cite.title == "on rays" { INFO@mark `RF5 a reference forgot its title` }

// Who may see what.
unless Accessor.Permission.confidential { INFO@mark `AC3 there is no confidential permission` }
unless Accessor.Permission#.count == 7 { INFO@mark `AC4 there are other than seven permissions` }
unless Accessor(who: Accessor.Permission.public).who == Accessor.Permission.public { INFO@mark `AC5 an accessor forgot its level` }
reader := Character(name: "reader")
once_target := "used once"
reader{uses < 1}.execute once_target
unless Permissions.current.allows(reader, `()`, once_target) { INFO@mark `AC6 a grant never used before is refused` }
if Permissions.current.allows(reader, `()`, once_target) { INFO@mark `AC7 a grant for one use allowed a second` }
day_target := "read by day"
reader{0:00 <= now}.read day_target
unless Permissions.current.allows(reader, `size`, day_target) { INFO@mark `AC8 a grant whose filter holds is refused` }
night_target := "never read"
reader{now < 0:00}.read night_target
if Permissions.current.allows(reader, `size`, night_target) { INFO@mark `AC9 a grant whose filter fails is allowed` }
if Permissions.current.allows(reader, `=`, day_target) { INFO@mark `AC10 a read grant allows writing` }

// A quest is what there is to do: the steps it takes, and whether it is done.
errand := Quest(name: "fetch", goal: wi)
if errand.done { INFO@mark `QU1 a new quest is already done` }
unless errand.difficulty == 0 { INFO@mark `QU2 a quest with no steps is difficult` }
errand.step("go")
errand.step("take")
unless errand.difficulty == 2 { INFO@mark `QU3 a quest of two steps is not two hard` }
unless errand.complete.done { INFO@mark `QU4 completing a quest does not` }
unless errand.goal == wi { INFO@mark `QU5 a quest forgot what it is for` }
// Posting answers the quest, the way spawning answers the character.
unless wg.add(errand) == errand { INFO@mark `QU6 posting a quest does not answer it` }
unless wg.quests.count == 1 { INFO@mark `QU11 posting a quest does not put it in the world` }

// A task is a quest that can be interrupted.
job := Task(name: "carry", goal: wi)
if job.interrupted { INFO@mark `QU7 a new task is already interrupted` }
unless job.interrupt.interrupted { INFO@mark `QU8 interrupting a task does not` }
if job.done { INFO@mark `QU9 an interrupted task is done` }
unless job.difficulty == 0 { INFO@mark `QU10 a task with no steps is difficult` }

// Where someone is says how they are, and saying nothing holds them to nothing.
away := Character(name: "away")
unless away is Offline { INFO@mark `PS1 someone with nowhere to be is not offline` }
somewhere := Instance(location: here)
present := Character(name: "present", presence: somewhere)
unless (present is Online) == (present.presence.device.network.connected ?? false) { INFO@mark `PS2 someone somewhere is not as that place is` }
if present is Offline && present is Online { INFO@mark `PS3 someone somewhere is offline and online at once` }
if present.constraint { INFO@mark `PS4 someone who said nothing is held to something` }

// What a world and a character are written with in front of their names.
unless World(name: "w").PREFIX == "#" { INFO@mark `WP1 a world is not written with a hash` }
unless Character(name: "p").PREFIX == "@" { INFO@mark `WP2 a character is not written with an at sign` }

// A name given to something is the name it answers to afterwards.
renamed := Character(name: "before").named("after")
unless renamed.name == "after" { INFO@mark `WP3 something named is not called that` }

// What a world holds, and how many live in it.
county := World(name: "county")
unless county.population == 0 { INFO@mark `WP4 an empty world has someone in it` }
county.add(Character(name: "one"))
county.add(Character(name: "two"))
unless county.population == 2 { INFO@mark `WP5 two who live there do not count two` }
unless county.items.empty { INFO@mark `WP6 an empty world holds something` }
county.add(Item(name: "lamp", issuer: county))
unless county.items.count == 1 { INFO@mark `WP7 what was added to a world is not there` }
if county.shadowing { INFO@mark `WP8 a world falls back to another by itself` }

// A name issued in a world is the reservation that took it, and reserving it
// again is reserving it once.
taken := county.issue("a")
unless taken.name == "a" { INFO@mark `WP9 what was issued does not hold the name` }
unless taken.issuer == county { INFO@mark `WP10 what issued a name is not the world` }
unless county.reserve("a") == taken { INFO@mark `WP11 reserving a taken name takes it again` }

// An item sits somewhere, is obtained by something, and carries what says so.
lamp := Item(name: "lamp", issuer: county)
if lamp.obtained_by { INFO@mark `WP12 an item nobody has is had by something` }
if lamp.certificate { INFO@mark `WP13 an item carries a certificate it was not given` }
paper := Certificate(issuer: county, secret: 1)
unless lamp.certify(paper).certificate == paper { INFO@mark `WP14 what an item was given is not what it carries` }
unless paper.issued_on { INFO@mark `WP15 a certificate says nothing about when it was issued` }

// What is written down about something read elsewhere.
cited := Reference(title: "a paper")
cited.authors.push 1
unless cited.draft { INFO@mark `WP16 something written down is not a draft to begin with` }
if cited.publish.draft { INFO@mark `WP17 something published is still a draft` }
if cited.location { INFO@mark `WP18 a reference points somewhere it was not pointed` }
unless cited.date { INFO@mark `WP19 a reference says nothing about when` }
unless (cited ~~ .note = "read it").notes.count == 1 { INFO@mark `WP20 a note taken is not kept` }

// Who belongs to an organization.
guild := Organization(name: "guild")
unless guild.members.empty { INFO@mark `WP21 an organization nobody joined has members` }
unless guild is Offline { INFO@mark `WP22 an organization is not offline to begin with` }

sited := Reference(title: "t", subtitle: "s", date: "2025-01-01" as Time, location: @https://a.b | "p")
unless sited.subtitle == "s" { INFO@mark `WR1 a reference forgot its subtitle` }
unless sited.year == 2025 { INFO@mark `WR2 a reference forgot its year` }
unless sited.location ∋ @https://a.b { INFO@mark `WR3 a reference forgot its link` }
unless sited.location ∋ "p" { INFO@mark `WR4 a reference forgot its pointer` }
unless Reference(title: "t").authors.empty { INFO@mark `WR5 a new reference already has authors` }
unless Reference(title: "t").organizations.empty { INFO@mark `WR6 a new reference already has organizations` }
unless Reference(title: "t").published.empty { INFO@mark `WR7 a new reference is already published somewhere` }
sited.authors.push wp
unless sited.authors.count == 1 { INFO@mark `WR8 an author added is not kept` }
unless sited.authors.first == wp { INFO@mark `WR9 the author kept is not the one added` }
unless (Reference(title: "t") ~~ .note = "n").notes.first.value == "n" { INFO@mark `WR10 a note forgot its text` }
unless (Reference(title: "t") ~~ .note = "n").notes.first.when { INFO@mark `WR11 a note says nothing about when` }
if Reference(title: "t").location { INFO@mark `WR12 a new reference has a remote it was not given` }

// A status is what a character is now, read off what it runs; saying one is a
// constraint on what may run.
unless Status#.count == 9 { INFO@mark `CS1 there are other than nine statuses` }
if Idle === Busy { INFO@mark `CS2 idle and busy are the same` }
unless Character(name: "s").status.contains(Offline) { INFO@mark `CS3 a character nowhere does not read as offline` }
if Character(name: "s").status.contains(Online) { INFO@mark `CS4 a character nowhere reads as online` }
if Character(name: "s") is Idle { INFO@mark `CS5 a character nowhere is idle` }
if Character(name: "s") is Busy { INFO@mark `CS6 a character with nothing to focus on is busy` }
focused := Character(name: "f", focus: Job(program: Program()))
unless focused is Busy { INFO@mark `CS7 a character focused on a job is not busy` }
focused.focus.state = Job.State.done
if focused is Busy { INFO@mark `CS8 a character whose focus is done is still busy` }
quiet := Character(name: "q")
if quiet is DoNotDisturb { INFO@mark `CS9 a character is not to be disturbed before saying so` }
quiet.status = DoNotDisturb
unless quiet.constraint === DoNotDisturb { INFO@mark `CS10 a status said is not kept as what may run` }
unless quiet is DoNotDisturb { INFO@mark `CS11 a character that said do not disturb is not left alone` }
unless quiet.status.contains(DoNotDisturb) { INFO@mark `CS12 do not disturb does not read back` }
disturbed := false
(disturbed = true) unless quiet is DoNotDisturb
if disturbed { INFO@mark `CS13 something flagged against do not disturb ran anyway` }
held_back := Character(name: "h") ~~ .status = !Offline
if held_back is Offline { INFO@mark `CS14 a character held to not offline is offline` }
hidden := Character(name: "hidden", presence: somewhere) ~~ .status = Invisible
unless hidden is Invisible { INFO@mark `CS15 a character that went invisible is not` }
if hidden is Online { INFO@mark `CS16 an invisible character is online to someone else` }
unless Program(code: { (hidden is Online) == (hidden.presence.device.network.connected ?? false) }).run_as(hidden) { INFO@mark `CS17 an invisible character is not as it is to itself` }

looked := World(name: "looked")
looked.add(Character(name: "Fadi"))
unless looked@fadi == looked.characters.first { INFO@mark `LK1 @name does not find a character ignoring case` }
unless looked.characters.count == 1 { INFO@mark `LK2 the plural is not the collection of that class` }
inner := World(name: "inner")
looked.add(inner)
unless looked#INNER == inner { INFO@mark `LK3 #name does not find a world ignoring case` }
unless looked@nobody == World.ether@nobody { INFO@mark `LK4 a name not defined here does not fall back to @ether` }

// Locations written as values (L§6.1, A3)
site := @https://orbitmines.com/archive
unless site as String == "https://orbitmines.com/archive" { INFO@mark `LC1 @https://… is not a location of what is written` }
unless @"a location with spaces" as String == "a location with spaces" { INFO@mark `LC2 @"…" does not keep its spaces` }
unless @./lib/logo.png as String == "./lib/logo.png" { INFO@mark `LC3 @./path is not a relative location` }
unless @ether/UI as String == "ether/UI" { INFO@mark `LC4 @name/path is not a location under that name` }
unless (@./lib / "logo.png") == @./lib/logo.png { INFO@mark `LC5 / does not go into a location` }

release := 17
unless (@https://www.unicode.org/Public/ release /ucd) as String == "https://www.unicode.org/Public/17/ucd" { INFO@mark `LC6 a value between the parts of a location is not written into it` }
unless (@https://www.unicode.org/ucd/UnicodeData.txt) as String ~= "UnicodeData.txt" ⊣ { INFO@mark `LC7 a dot in a path is not part of the path` }
unless (@https://www.unicode.org/ucd)/UnicodeData.txt as String == "https://www.unicode.org/ucd/UnicodeData.txt" { INFO@mark `LC8 a path written after a location does not continue it` }
unless (@https://en.wikipedia.org/wiki/Dune_(novel)) as String == "https://en.wikipedia.org/wiki/Dune_(novel)" { INFO@mark `LC9 a location loses the parentheses in its path` }
icon_name := "tick"
unless (@./icons/ icon_name .svg) as String == "./icons/tick.svg" { INFO@mark `LC10 a location does not go on with an extension after a value` }

// A character has an identity of its own, and is here when this machine has it.
unless Character(name: "c").id { INFO@mark `WO14 a character has no identity of its own` }
here_now := Instance.local.login(Character(name: "local-one"))
unless Character.local("local-one") === here_now { INFO@mark `WO15 a character logged in here is not here` }
if Character.local("nobody-here") { INFO@mark `WO16 a character nobody logged in is here` }

// A character used as a condition is whether it is @me.
cw := Character(name: "viewer")
unless Program(code: { cw ? true : false }).run_as(cw) { INFO@mark `CW1 a character as a condition is false to itself` }
if Program(code: { cw ? true : false }).run_as(Character(name: "other")) { INFO@mark `CW2 a character as a condition is true to someone else` }

// Handed-over code runs as the character that handed it over; its runs are logged for replay.
hg_giver := Character(name: "giver")
hg := Program(code: { @me }).handed(hg_giver)
unless hg.run == hg_giver { INFO@mark `HG1 handed-over code does not run as the character that handed it over` }
unless Run.log.head.who == hg_giver { INFO@mark `HG2 a run of handed-over code is not logged as its giver` }
unless Run.replay(Run.log.head) == hg_giver { INFO@mark `HG3 a logged run does not replay as its character` }
unless Run.kept == 30 days { INFO@mark `HG4 run logs are not kept for thirty days` }
with Run.kept = 0 seconds {
  if Run.logs.some(=== Run.log.head) { INFO@mark `HG5 a run older than the configured window is kept for replay` }
}

// A reserved name is unique in its world under case folding.
rz := World(name: "folded")
rz.reserve("Alice")
unless rz.reserved("ALICE").name == "Alice" { INFO@mark `RZ1 a name found in another letter case lost the case it was reserved in` }
unless rz.issue("aLiCe").erred { INFO@mark `RZ2 one name was issued twice in other letter cases` }
if World(name: "unfolded").issue("ALICE").erred { INFO@mark `RZ3 a name is unique beyond the world that issued it` }
