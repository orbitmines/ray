@ether/os
@tzif
@ether/time
@unicode

// Time zones and leap seconds: IANA's tz data (https://data.iana.org/time-zones/tz-link.html), read from where the
// operating system keeps it, else downloaded (@tzif/zoneinfo).
LeapSeconds := class ((TimeZone.source.directory / "leap-seconds.list").held as Unicode.Table<(seconds: Decimal, "\t", *)>).rows
  .map(.seconds seconds as Time(epoch: "1900-01-01"))
{
  at (minute: Time) => this.contains(minute.round(minute) + 1 minute)
}

TimeZone := class (name: String) {
  // IANA tz database compiled to TZif (RFC 8536), one file per zone, read only when that zone is asked for (https://data.iana.org/time-zones/tz-link.html)
  static Zoneinfo := class (directory: Location) {
    data (zone: String) => TZif.read((.directory / zone).held as Byte[])
    at (zone: String, time: Time) => .data(zone).at(time)
    assert {
      summer := "2024-07-01T12:00:00Z" as ISO_8601 as Time
      assert TimeZone("UTC").at(summer).offset == 0 seconds  // TZ14 UTC is off zero on this host
      Counting := class: TimeZone.Zoneinfo {
        asked: String[] = []
        data (zone: String) => (.asked.push zone) -- TZif.read((.directory / zone).held as Byte[])
      }
      counting := Counting(directory: @tzif/zoneinfo)
      counting.at("Europe/Amsterdam", summer)
      assert counting.asked == ["Europe/Amsterdam"]  // TZ16 reading one zone read others than the one asked for
    }
    assert {
      winter := "2024-01-15T12:00:00Z" as ISO_8601 as Time
      // Where the zones are read, per operating system.
      with (@me/device as OS) = OS.Linux {
        assert TimeZone.source is TimeZone.Zoneinfo  // TZ1 linux does not read the host's zoneinfo
        assert !(TimeZone.source.directory == @tzif/zoneinfo)  // TZ3 linux downloads the data instead of reading the host's
        assert !(TimeZone.source.directory ~= ⊢"tzif")  // TZ18 a host refers to @tzif for its zone data
        assert TimeZone.source.at("UTC", winter).offset == 0 seconds  // TZ15 UTC is off zero on linux
      }
      with (@me/device as OS) = OS.Ether {
        assert TimeZone.source is TimeZone.Zoneinfo  // ETH7 the language as the operating system does not read TZif
        assert TimeZone.source.directory == @tzif/zoneinfo  // TZ17 the language as the operating system does not take its zone data from @tzif/zoneinfo
        amsterdam := TimeZone("Europe/Amsterdam")
        assert amsterdam.at(summer).offset == 2 hours  // TZ9 Amsterdam in summer is not at +02:00 on ether
        assert amsterdam.at(summer).abbreviation == "CEST" && amsterdam.at(summer).daylight  // TZ10 Amsterdam in summer is not on CEST
        assert amsterdam.at(winter).offset == 1 hour  // TZ11 Amsterdam in winter is not at +01:00 on ether
        assert amsterdam.at(winter).abbreviation == "CET" && !amsterdam.at(winter).daylight  // TZ12 Amsterdam in winter is not on CET
        assert TimeZone("UTC").at(summer).offset == 0 seconds  // TZ13 UTC is off zero on ether
      }
    }
    version => ((.directory / "version").held as String).trimmed
    assert TimeZone.Zoneinfo(directory: @tzif/zoneinfo).version == "2026c"  // TZ8 the downloaded data is not tzdata 2026c
    zones => ((.directory / "zones").held as String).lines{.nonempty}
  }

  // Where the zones are read: the host's zoneinfo (tzfile(5): $TZDIR, else /usr/share/zoneinfo,
  // https://man7.org/linux/man-pages/man5/tzfile.5.html), Windows' ICU, the browser's Intl, on ether the downloaded @tzif.
  static source => if OS.Linux || OS.Macos { TimeZone.Zoneinfo(directory: ((@me/device as OS).env.TZDIR ?? "/usr/share/zoneinfo") as Location) }
    elsif OS.Windows { TimeZone.ICU() }
    elsif OS.Browser { TimeZone.Intl() }
    else { TimeZone.Zoneinfo(directory: @tzif/zoneinfo) }
  assert {
    with (@me/device as OS) = OS.Macos {
      assert TimeZone.source is TimeZone.Zoneinfo  // TZ2 macos does not read the host's zoneinfo
    }
  }
  assert {
    with (@me/device as OS) = OS.Windows {
      assert TimeZone.source is TimeZone.ICU  // TZ4 windows does not ask the OS's ICU
    }
  }
  assert {
    with (@me/device as OS) = OS.Browser {
      assert TimeZone.source is TimeZone.Intl  // TZ5 the browser does not ask Intl
    }
  }

  // Windows 10 1703+ ships ICU and its tz data as icu.dll (https://learn.microsoft.com/en-us/windows/win32/intl/international-components-for-unicode--icu-), ucal API (https://unicode-org.github.io/icu-docs/apidoc/released/icu4c/ucal_8h.html)
  static ICU := class {
    call (function: String, arguments) => @icu function arguments
    // a Windows zone id read as its IANA name through CLDR's windowsZones (https://learn.microsoft.com/en-us/windows-hardware/manufacture/desktop/default-time-zones)
    iana (zone: String) => .call("ucal_getTimeZoneIDForWindowsID", (zone, "001")) ?? zone
    at (zone: String, time: Time) => .call("ucal_open", (.iana(zone), "", "UCAL_GREGORIAN")) ~~ this.call("ucal_setMillis", (., (time as s).floor * 1000)) -- (calendar =>
      this.call("ucal_inDaylightTime", (calendar)) -- (daylight => (
        offset: ((this.call("ucal_get", (calendar, "UCAL_ZONE_OFFSET")) + this.call("ucal_get", (calendar, "UCAL_DST_OFFSET"))) / 1000) seconds,
        daylight: daylight,
        abbreviation: this.call("ucal_getTimeZoneDisplayName", (calendar, daylight ? "UCAL_SHORT_DST" : "UCAL_SHORT_STANDARD", "en")) as String
      )) ~~ this.call("ucal_close", calendar))
  }

  // ECMA-402 Intl.DateTimeFormat: the offset in force read back from formatToParts with timeZoneName "longOffset" (https://tc39.es/ecma402/#sec-createdatetimeformat, https://tc39.es/ecma402/#sec-formatdatetimetoparts), answered by the page at @me/device/zones (`zones/<zone>/<at>`; keeping answers is a cache level)
  static Intl := class {
    asked (zone: String, time: Time) => await (@me/device/zones / zone / ((time as s).floor * 1000 as String)).value
    offset (zone: String, time: Time) => (this.asked(zone, time).offset ~= ("GMT", (sign: "+" | "-", hours: Decimal, ":", minutes: Decimal)?)) -- (.sign ? (.sign == "-" ? -1 : 1) * (.hours hours + .minutes minutes) : 0 seconds)
    at (zone: String, time: Time) => this.offset(zone, time) -- (in_force => (
      offset: in_force,
      daylight: in_force > this.offset(zone, time - 182 days).min(this.offset(zone, time + 182 days)),
      abbreviation: this.asked(zone, time).abbreviation
    ))
    // ECMA-402 Intl.DateTimeFormat formatToParts, the zone's offset ("longOffset") and abbreviation ("short") (https://tc39.es/ecma402/#sec-createdatetimeformat, https://tc39.es/ecma402/#sec-formatdatetimetoparts)
    static script := @js {
      ray.awaited("@me/device/zones", (path) => {
        const [zone, at] = [path.split("/").slice(0, -1).join("/"), Number(path.split("/").at(-1))]
        const part = (style) => new Intl.DateTimeFormat("en-US", \{timeZone: zone, timeZoneName: style}).formatToParts(at).find((part) => part.type === "timeZoneName").value
        ray.set("@me/device/zones/" + path, \{offset: part("longOffset"), abbreviation: part("short")})
      })
    }
  }

  data => TimeZone.source.data(.name)
  at (time: Time) => TimeZone.source.at(.name, time)
}

UTC &+= {
  static minute := Calendar.Segment(global.minute, 60 seconds | 61 seconds if .leap_seconds && LeapSeconds.at(this))
}

// RFC 9557: the zone named in brackets after a timestamp's offset
ISO_8601 &+= {
  zone => TimeZone(.zone_name) if .zone_name
}
// RFC 9557: the zone named in brackets
assert ("2026-10-06T12:00:00+02:00[Europe/Paris]" as ISO_8601).zone.name == "Europe/Paris"  // WD10 the zone named in brackets is not read
