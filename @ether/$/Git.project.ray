@deflate
@sha1
@sha256
@zlib
@crc32
@ether/version-control
@ether
@ether/time
@unicode
@name

// Git's formats (https://git-scm.com/docs/gitformat-pack, https://git-scm.com/docs/gitformat-index, https://git-scm.com/docs/gitprotocol-http)
// The object format is part of the type: Git reads and writes SHA-1 repositories, Git<SHA256> SHA-256 ones (https://git-scm.com/docs/hash-function-transition)
Git<hash: SHA1 | SHA256 = SHA1> := class {
  static extensions := ".git"
  static noted_at := "refs/notes/ray"

  // The hash naming every object, by the name of its digest: "sha1" or "sha256"; any other name is a repository git cannot read (https://git-scm.com/docs/hash-function-transition#_object_names, https://git-scm.com/docs/git-config#Documentation/git-config.txt-extensionsobjectFormat)
  static formatted (name: String) => [SHA1, SHA256].find(.extensions == "." + name.fold_case) ?? ERROR@Format `an object format by that name`
  format_name => .hash.extensions[1..]
  // Compatibility mode, each object named in both formats through a translation table (https://git-scm.com/docs/hash-function-transition#_translation_table, https://git-scm.com/docs/git-config#Documentation/git-config.txt-extensionscompatObjectFormat)
  static compatible := ERROR@Format `extensions.compatObjectFormat: every object named in a second format beside the repository's own`

  // An object name written out: two hexadecimal digits a byte, 40 in SHA-1, 64 in SHA-256 (https://git-scm.com/docs/hash-function-transition#_object_names)
  Id := Hexadecimal{.length == this.hash.size * 2}
  // An object name as bytes, in trees, packs and pack indexes: 20 in SHA-1, 32 in SHA-256 (https://git-scm.com/docs/hash-function-transition#_object_format)
  Raw := Byte[]{.count == this.hash.size}
  // The name of no object, as a push names a reference not yet there (https://git-scm.com/docs/gitprotocol-pack#_reference_update_request_and_packfile_transfer)
  zero: Id => "0" * .hash.size * 2
  // An object is named by the hash of its type, size and content, in the repository's format (https://git-scm.com/docs/hash-function-transition#_object_format)
  hashed (bytes: Byte[]): Id => (bytes as this.hash).digest as Git.Raw as Id

  // A tree entry's mode, in octal: a file, an executable, a symbolic link, a tree, or a submodule's commit (https://git-scm.com/docs/gitformat-index#_index_entry)
  static Mode := enum file (code: "100644") | executable (code: "100755") | link (code: "120000") | directory (code: "40000") | module (code: "160000") {
    static (code: String) as (=== Git.Mode) => Git.Mode#{.code == code}.first
    static (content: Byte[]) as (=== Git.Mode) => content is Executable ? Git.Mode.executable : Git.Mode.file
  }
  // Files at their paths as a tree: what is directly in it, a file or a directory of what is under that name
  // (https://git-scm.com/docs/gitformat-index#_index_entry)
  static entries (files: (path: String, content: Byte[])[]) => files.map(.path.split("/"){.nonempty}.first).unique.map(name =>
    files{.path.split("/"){.nonempty}.first == name} -- (under => under.count == 1 && under.first.path.split("/"){.nonempty}.count == 1
      ? (name: name, file: under.first.content)
      : (name: name, files: under.map((path: .path.after(name + "/"), content: .content)))))
  // every object of a tree of files: the tree, its trees and its blobs
  static objects_in (files: (path: String, content: Byte[])[]): Git.Object[] => [files as Git.Object, Git.entries(files).map(entry => entry.files
    ? Git.objects_in(entry.files) : [Git.Object("blob", entry.file)]).flatten]

  Object := class kind: "blob" | "tree" | "commit" | "tag", content: Byte[] {
    framed: Byte[] => (.kind + " " + .content.count as String + "\x00") as Byte[], .content
    id: Id => hashed(this.framed)
    assert Git.Object("blob", "hello\n" as Byte[]).id == "ce013625030ba8dba906f756967f9e9ca394464a"  // VC28 a git blob is not named by the hash git gives it
    // Object formats (https://git-scm.com/docs/hash-function-transition, https://git-scm.com/docs/git-config#Documentation/git-config.txt-extensionsobjectFormat)
    assert Git<SHA256>.Object("blob", "hello\n" as Byte[]).id == "2cf8d83d9ee29543b34a87727421fdecb7e3f3a183d337639025de576db9ebb4"  // VC50 a git blob in a sha256 repository is not named by the hash git gives it
    assert Git.Object("tree", []).id == "4b825dc642cb6eb9a060e54bf8d69288fbee4904"  // VC51 git's empty tree is not named as git names it
    assert Git<SHA256>.Object("tree", []).id == "6ef19b41225c5369f1c104d45d8d85efa9b057b53b14b4b9b939dd74decc5321"  // VC52 git's empty tree in a sha256 repository is not named as git names it
    assert Git<SHA256>.Object("blob", "hello\n" as Byte[]).id.count == 64 && Git.Object("blob", "hello\n" as Byte[]).id.count == 40  // VC54 an object's id is not 64 hexadecimal digits in sha256 and 40 in sha1
    path => "objects/" + .id[..1] + "/" + .id[2..]
    assert ((([(path: "hello", content: "hello\n" as Byte[])] as Git<SHA256>.Object).content as Git<SHA256>.Tree).entries.first.id as Byte[]).count == 32  // VC55 a tree entry's id is not 32 bytes in sha256
    // Modes and pack object types are read and written by the header (https://git-scm.com/docs/gitformat-index#_index_entry, https://git-scm.com/docs/gitformat-pack#_object_types)
    assert "100755" as Git.Mode == Git.Mode.executable && Git.Mode.directory.code == "40000"  // GIT1 a tree entry's mode is not read by its octal code
    loose: Byte[] => Zlib(deflated: Deflate.deflated(.framed)) as Byte[]
    static (files: (path: String, content: Byte[])[]) as (=== Git.Object) => Git.Object("tree", files as Git.Tree as Byte[])
  }
  Loose := class (kind: Char.Letter[], " ", size: Decimal, "\x00", content: Byte[]{.count == size}) {
    object => Git.Object(this.kind, this.content)
  }

  // Each entry names its object in bytes of the repository's format (https://git-scm.com/docs/hash-function-transition#_object_format)
  Tree := class (entries: (mode: ("0".."7")[] as Git.Mode, " ", name: (!"\x00")[], "\x00", id: Git.Raw)[]) {
    // Tree entries sort as if a directory's name ended in /
    static (files: (path: String, content: Byte[])[]) as (=== Git.Tree) => Git.Tree(entries: Git.entries(files).sort(.files ? .name + "/" : .name).map(entry =>
      (mode: entry.files ? Git.Mode.directory : entry.file as Git.Mode, name: entry.name, id: (entry.files ? entry.files as Git.Object : Git.Object("blob", entry.file)).id as Git.Raw)))
  }

  Signature := class (name: (!"<")[], " <", email: (!">")[], "> ", seconds: Decimal, " ", zone: (("+" | "-"), Decimal.Digit₄)) {
    when: Time => (.seconds seconds) as Time
    static (signed: (who: *, when: Time)) as (=== Git.Signature) => Git.Signature(name: (signed.who.full_name#.first ?? signed.who.name#.first ?? signed.who) as String, email: (signed.who.email#.first as String) ?? (signed.who.name#.first ?? "someone") + "@ether", seconds: (signed.when as s).floor, zone: "+0000")
  }

  // A commit's tree and parents, and a tag's object, are written as names in the repository's format (https://git-scm.com/docs/hash-function-transition#_object_format)
  Commit := class (
    "tree ", tree: Git.Id, \n,
    parents: ("parent ", Git.Id, \n)[],
    "author ", author: Git.Signature, \n,
    "committer ", committer: Git.Signature, \n,
    headers: (key: Char.Word[], " ", value: ((!\n)[], (\n, " ", (!\n)[])[]), \n)[],
    \n,
    message: Char[]
  )

  Tag := class ("object ", object: Git.Id, \n, "type ", kind: Char.Letter[], \n, "tag ", name: (!\n)[], \n, ("tagger ", tagger: Git.Signature, \n)?, \n, message: Char[])

  // References hold names in the repository's format (https://git-scm.com/docs/gitrepository-layout#_refs, https://git-scm.com/docs/hash-function-transition#_object_names)
  Reference := class ((("ref: ", symbolic: (!\n)[]) | id: Git.Id), \n)
  PackedReferences := class (("# pack-refs with:", (!\n)[], \n)?, references: (id: Git.Id, " ", name: (!\n)[], \n, ("^", peeled: Git.Id, \n)?)[])

  // A reference delta's base and the trailing checksum are hashes of the repository's format (https://git-scm.com/docs/gitformat-pack#_pack_pack_files_have_the_following_format, https://git-scm.com/docs/hash-function-transition#_pack_format)
  Pack := class ("PACK", version: Binary₃₂{== 2 || == 3}, count: Binary₃₂, entries: Entry[]{count == this.count}, checksum: Git.Raw) {
    // Object types; 6 and 7 are deltas against a base at an offset back in the pack or by its name (https://git-scm.com/docs/gitformat-pack#_object_types)
    static Kind := enum commit (code: 1) | tree (code: 2) | blob (code: 3) | tag (code: 4) | offset_delta (code: 6) | reference_delta (code: 7) {
      static (code: Binary₃) as (=== Kind) => Kind#{.code == code}.first
    }
    assert Git.Pack.Kind.reference_delta.code == 7 && 2 as Git.Pack.Kind == Git.Pack.Kind.tree  // GIT2 a pack entry's type is not read by its number

    static Size := class (more: Binary₁{== 1}, low: Binary₇)[], (Binary₁{== 0}, last: Binary₇) {
      value => (.last, .more.low.reverse).flatten as Binary
    }
    static Entry := class (
      (continues: Binary₁, type: Binary₃ as Kind, low: Binary₄), size: (continues ? Size : None),
      (offset: Size = at - base_entry.at) if type == Kind.offset_delta,
      (base: Git.Raw) if type == Kind.reference_delta,
      data: Zlib
    ) {
      base_entry: Entry?
      length => (.size.value ?? 0, .low) as Binary
      at => previous ? previous.at + (previous as Byte[]).count : 12
      crc32 => this as Byte[] as CRC32 as Binary₃₂
      object (pack: Git.Pack, store) => Git.Object(this.type.name, this.data.inflated)
    }
    // A delta's object is its base's, the delta applied (https://git-scm.com/docs/gitformat-pack#_deltified_representation)
    static OffsetDelta := Entry{.type == Kind.offset_delta} {
      object (pack: Git.Pack, store) => pack.entries.find(.at == at - offset.value).object(pack, store) -- (source => Git.Object(source.kind, Git.Delta(data.inflated).applied(source.content)))
    }
    static ReferenceDelta := Entry{.type == Kind.reference_delta} {
      object (pack: Git.Pack, store) => store.object(base as Git.Id) -- (source => Git.Object(source.kind, Git.Delta(data.inflated).applied(source.content)))
    }

    static entry (object: Git.Object, previous: Git.Object?, base: Entry?) => (previous && previous.kind == object.kind ? Git.Delta.between(previous.content, object.content) : None) -- (delta =>
      delta && delta.size < object.content.count
        ? Entry(type: Git.Pack.Kind.offset_delta, size: delta.size, base_entry: base, data: Zlib(deflated: Deflate.deflated(delta as Byte[])))
        : Entry(type: Git.Pack.Kind#{.name == object.kind}.first, size: object.content.count, data: Zlib(deflated: Deflate.deflated(object.content))))
    static (objects: Git.Object[]) as (=== Git.Pack) => objects.sort(o => (o.kind, o.content.count)) -- (sorted => Git.Pack(version: 2, count: sorted.count,
      entries: sorted.reduce(made = [] => made, [Git.Pack.entry(., previous: sorted[.index - 1] if .index > 0, base: made.last)])))

    object_at (offset: Number, store) => .entries.find(.at == offset).object(this, store)
    id => .checksum as Git.Id
  }

  Delta := class (source: Git.Pack.Size, target: Git.Pack.Size, instructions: (Copy | Insert)[]) {
    static Copy := class (Binary₁{== 1}, sizes: Binary₃, offsets: Binary₄, offset: Byte[]{.count == offsets.ones}, size: Byte[]{.count == sizes.ones}) {
      from => .offsets.spread(this.offset) as Binary
      length => (.sizes.spread(this.size) as Binary) -- (. == 0 ? 0x10000 : .)
    }
    static Insert := class (Binary₁{== 0}, length: Binary₇{> 0}, bytes: Byte[]{.count == length})

    applied (base: Byte[]) => .instructions.map(. is Git.Delta.Copy ? base[.from..<.from + .length] : .bytes).flatten
    size => (this as Byte[]).count
    static between (base: Byte[], target: Byte[]) => Git.Delta(source: base.count, target: target.count, instructions: target.runs(base).map(run => run.bytes
      ? run.bytes.chunk(127).map(Git.Delta.Insert(length: .count, bytes: .))
      : [Git.Delta.Copy(from: run.from, length: run.count)]).flatten)
  }

  // Version 2: the names and both trailing checksums are hashes of the repository's format (https://git-scm.com/docs/gitformat-pack#_version_2_pack_idx_files_support_packs_larger_than_4_gib_and, https://git-scm.com/docs/hash-function-transition#_pack_index)
  // Version 3, naming each object in both formats, belongs to compatibility mode (https://git-scm.com/docs/hash-function-transition#_pack_index)
  Index := class (
    0xFF, "tOc", version: Binary₃₂{== 2},
    fanout: Binary₃₂[]{count == 256},
    ids: Git.Raw[]{count == fanout.last},
    crcs: Binary₃₂[]{count == fanout.last},
    offsets: (large: Binary₁, offset: Binary₃₁)[]{count == fanout.last},
    larger: Binary₆₄[],
    pack: Git.Raw, checksum: Git.Raw
  ) {
    offset_of (id: Git.Id) => .ids.index_of(id as Git.Raw) -- (at => at === None ? None : this.offsets[at] -- (.large == 1 ? this.larger[.offset] : .offset))
    static (pack: Git.Pack) as (=== Git.Index) => pack.entries.sort(.object(pack, None).id) -- (sorted => Git.Index(version: 2,
      fanout: (0..255).map(byte => sorted{.object(pack, None).id[..1] as Hexadecimal <= byte}.count),
      ids: sorted.map(.object(pack, None).id as Git.Raw), crcs: sorted.map(.crc32),
      offsets: sorted.map((large: 0, offset: .at)), larger: [], pack: pack.checksum))
  }

  Line := class (((length: Hexadecimal₄{!= "0000" && != "0001" && != "0002"}), payload: Byte[]{.count == length - 4}) | flush: "0000" | delimiter: "0001" | end: "0002") {
    static (text: String) as (=== Git.Line) => Git.Line(length: text.count + 4, payload: text as Byte[])
  }
  // A server names its object format among its capabilities, SHA-1 when it does not, and advertises names in it (https://git-scm.com/docs/gitprotocol-capabilities#_object_format)
  Advertised := class (Git.Line("# service=", service: Char[], \n), Git.Line.flush, references: Git.Line(id: Hexadecimal{.length == SHA1.size * 2 || .length == SHA256.size * 2}, " ", name: (!"\x00" && !\n)[], ("\x00", capabilities: (!\n)[])?, \n?)[], Git.Line.flush) {
    format => (.references.first.capabilities ?? "").split(" ").find(. ~= ⊢"object-format=") -- (named => named ? Git.formatted(named[14..]) : SHA1)
  }
  // A client asks for the format the server named, on its first request line (https://git-scm.com/docs/gitprotocol-capabilities#_object_format)
  asked: String => .hash === SHA1 ? "" : " object-format=" + .format_name

  // A repository's configuration, in git-config's syntax (https://git-scm.com/docs/git-config#_syntax)
  Config := class (sections: (
    "[", name: (Char.Letter | Char.Digit | "-" | ".")[], (" \"", subsection: (!"\"" && !\n)[], "\"")?, "]", \n,
    variables: ((indent: ("\t" | " ")[] = "\t", key: (Char.Letter, (Char.Letter | Char.Digit | "-")[]), (" "[], "=", " "[], value: (!\n)[])?, \n) | (("\t" | " ")[], ("#" | ";"), (!\n)[], \n) | \n)[]
  )[]) {
    // Section and variable names are case-insensitive, the last value given wins, and a variable without one is true (https://git-scm.com/docs/git-config#_syntax)
    value (section: String, key: String) => .sections{.name.fold_case == section}.map(.variables{.key}).flatten{.key.fold_case == key}.last -- (found => found ? found.value ?? "true" : None)
    assert {
      ada := Instance.local.login(@"ada")
      vh := History(repository: Repository())
      vh.commit(ada, Program(code: { .greet = "hello" }))
      vh.commit(ada, Program(code: { .welcome = .greet; .greet = None }))
      vg := Git.Written(history: vh).files
      assert vg.find(.path == "HEAD").content as String == "ref: refs/heads/main\n"  // VC24 git's HEAD does not name the branch
      assert vg.some(.path == Git.noted_at)  // VC25 git keeps no notes of the programs
      vgh := (Git.Written(history: vh).placed_at(@./history-test) as Git.Store).history
      assert vgh.head.id == vh.head.id  // VC26 a history written as git and read back has other labels
      assert vgh.value.welcome == "hello" && vgh.value.greet == None  // VC27 a history written as git and read back has another value
      assert (Git<SHA256>.Written(history: vh).files.find(.path == "config").content as Git.Config).format === SHA256  // VC57 a history written as sha256 git does not name its object format in its config
      vgs := (Git<SHA256>.Written(history: vh).placed_at(@./history-test-sha256) as Git.Store).history
      assert vgs.head.id == vh.head.id  // VC58 a history written as sha256 git and read back has other labels
    }
    // Version 0 knows no extensions; version 1 reads them (https://git-scm.com/docs/gitrepository-layout#_config, https://git-scm.com/docs/git-config#Documentation/git-config.txt-corerepositoryFormatVersion)
    version: Decimal => (.value("core", "repositoryformatversion") ?? "0") as Decimal
    // extensions.objectFormat; SHA-1 when absent, or in a version 0 repository (https://git-scm.com/docs/git-config#Documentation/git-config.txt-extensionsobjectFormat, https://git-scm.com/docs/hash-function-transition#_repository_format_extension)
    format => .version == 1 && .value("extensions", "objectformat") ? Git.formatted(this.value("extensions", "objectformat")) : SHA1
    assert ("[core]\n\trepositoryformatversion = 1\n[extensions]\n\tobjectFormat = sha256\n" as Git.Config).format === SHA256  // VC53 a sha256 repository's config does not read as sha256
    assert Git.hash === SHA1 && ("" as Git.Config).format === SHA1 && ("[core]\n\trepositoryformatversion = 0\n[extensions]\n\tobjectFormat = sha256\n" as Git.Config).format === SHA1  // VC56 the object format is not sha1 by default
    // A new repository: version 0 in SHA-1, version 1 naming its extensions.objectFormat otherwise (https://git-scm.com/docs/git-init#Documentation/git-init.txt---object-formatformat, https://git-scm.com/docs/hash-function-transition#_repository_format_extension)
    static (format: SHA1 | SHA256) as (=== Git.Config) => Git.Config(sections: [
      (name: "core", variables: [(key: "repositoryformatversion", value: format === SHA1 ? "0" : "1"), (key: "filemode", value: "true"), (key: "bare", value: "false")]),
      (name: "extensions", variables: [(key: "objectFormat", value: format.extensions[1..])]) if format !== SHA1
    ])
    assert Git.formatted("SHA256") === SHA256 && Git.formatted("md5").erred && Git<SHA256>.format_name == "sha256"  // GIT3 an object format is not named by its digest
  }

  Store := class root: Location?, fetched: Git.Pack[] = [], given: (String, Git.Id)[] = [] {
    loose (id: Git.Id) => .root ? (.root / ("objects/" + id[..1] + "/" + id[2..])) as Byte[] -- (bytes => bytes.nonempty ? ((bytes as Zlib).inflated as Git.Loose).object : None) : None
    packs => .fetched.map(pack => (index: pack as Git.Index, pack)), (.root ? (.root / "objects/pack").children{.name ~= ".idx" ⊣}.map(index => (index: index as Byte[] as Git.Index, pack: (((index as Path)[..<-4] + ".pack") as Location) as Byte[] as Git.Pack)) : [])
    packed (id: Git.Id) => .packs.find(.index.offset_of(id) != None) -- (found => found.pack.object_at(found.index.offset_of(id), this))
    object (id: Git.Id) => .loose(id) ?? .packed(id)

    references => .given, (.root ? (((.root / "packed-refs") as Byte[] as Git.PackedReferences).references.map((.name, .id)), (.root / "refs").children**{!(. is Directory)}.map(at => ((at as Path)[(this.root as Path).count + 1..], (at as Byte[] as Git.Reference).id))) : [])
    reference (name: String) => .references{.0 == name}.last.1
    current => .root ? ((.root / "HEAD") as Byte[] as Git.Reference).symbolic : .references.find(.0 ~= ⊢"refs/heads/" && .1 == this.reference("HEAD")).0
    head => .reference("HEAD") ?? ((.root / "HEAD") as Byte[] as Git.Reference) -- (head => head.symbolic ? this.reference(head.symbolic) : head.id)
    branches => .references{.0 ~= ⊢"refs/heads/"}.map((name: .0[11..], id: .1))

    config => .root ? (.root / "config") as Byte[] as Config : hash as Config
    commit (id: Git.Id) => .object(id).content as Git.Commit
    // the files of a tree at their paths (one executable granted executing)
    tree (id: Git.Id, under: String = "") => (.object(id).content as Git.Tree).entries.map(entry => entry.mode == Git.Mode.directory
      ? this.tree(entry.id as Git.Id, under + entry.name + "/")
      : [(path: under + entry.name, content: this.object(entry.id as Git.Id).content ~~ (Accessor.execute . if entry.mode == Git.Mode.executable))]).flatten(1)
    recorded => .reference(Git.noted_at) -- (tip => tip ? this.tree(this.commit(tip).tree).map((target: .path.replace("/", ""), line: .content as String)) : [])
    reachable (ids: Git.Id[]) => ids.map(id => (this.reachable(this.commit(id).parents), id)).flatten.unique
    read_commit (id: Git.Id, made, repository: Repository) => .commit(id) -- (made_by => (this.recorded.find(.target == id).line -- (noted => noted ? (noted as Program as History).head : None) ?? History.Commit(
      stamp: repository.clock.receive(Stamp.at(made_by.author.when, node: made_by.author.name)), who: @"{made_by.author.name}" ?? made_by.author.name,
      change: History.change(made_by.parents.first ? this.tree(this.commit(made_by.parents.first).tree) : [], this.tree(made_by.tree)),
      when: made_by.author.when, message: made_by.message)) ~~ (.previous = made_by.parents.map(made[.])#))

    history => (Repository() @ .root) -- (repository => this.reachable(this.references{.0 != Git.noted_at && .0 != "HEAD"}.map(.1)).reduce(made = {} => made, {(.): this.read_commit(., made, repository)}) -- (made => repository
      ~~ (.histories = this.branches.map(branch => History(repository, head: made[branch.id], name: branch.name)))
      -- History(repository, head: made[this.head], name: this.current)))
  }

  Remote := class: Location {
    advertised (service: String) => (this / "info/refs").with(service: service) as Byte[] as Git.Advertised
    fetched => .advertised("git-upload-pack") -- (offered => (this as String as Git<offered.format>.Remote).fetching(offered))
    fetching (offered: Git.Advertised) => ((this / "git-upload-pack") = (
      offered.references.enumerate.map(("want " + .value.id + (.index == 0 ? asked : "") + \n) as Git.Line), Git.Line.flush, "done\n" as Git.Line
    )) as Git.Pack -- (pack => Git.Store(fetched: [pack], given: offered.references.map((.name, .id as Git.Id))))
    pushed (written: Git.Written, old: Git.Id?) => (this / "git-receive-pack") = (
      ((old ?? zero) + " " + written.head.id + " refs/heads/" + written.branch + "\x00report-status" + asked + "\n") as Git.Line, Git.Line.flush, written.objects as Git.Pack
    )
  }

  Written := class history: History {
    branch => .history.name ?? "main"
    // its files placed under a location
    placed_at (location: Location) => .files.for(file => (location / file.path) = file.content) -- location
    line => .history.since(None)
    commits => .line.reduce(made = {} => made, {(.id): Git.Object("commit", Git.Commit(
      tree: (this.history[.].tree as Git.Object).id, parents: .parents.map(made[.id].id),
      author: (who: .who, when: .when) as Git.Signature, committer: (who: .who, when: .when) as Git.Signature, headers: [], message: .message ?? .change as String) as Byte[])})
    head => .commits[.history.head.id]
    notes => .line.map(commit => (path: this.commits[commit.id].id, content: commit.written() as Byte[])) -- (noted =>
      noted -- (tree => (who: this.history.head.who, when: Time.now) as Git.Signature -- (signed => [Git.objects_in(tree), Git.Object("commit", Git.Commit(tree: (tree as Git.Object).id, parents: [], author: signed, committer: signed, headers: [], message: "Notes added by Ray") as Byte[])].flatten)))
    objects => (.line.map(Git.objects_in(this.history[.].tree)).flatten, .commits.values, .notes).flatten.unique(.id)
    object_files => .objects.map((path: .path, content: .loose))
    // A new repository records its object format in its config (https://git-scm.com/docs/gitrepository-layout#_config, https://git-scm.com/docs/hash-function-transition#_repository_format_extension)
    files => .object_files, [
      (path: "config", content: hash as Git.Config as Byte[]),
      (path: "HEAD", content: ("ref: refs/heads/" + .branch + \n) as Byte[]),
      (path: "refs/heads/" + .branch, content: (.head.id + \n) as Byte[]),
      (path: Git.noted_at, content: (.notes.last.id + \n) as Byte[]) if .notes.nonempty
    ]
  }

  // A repository on disk is read in the format its config names (https://git-scm.com/docs/gitrepository-layout#_config, https://git-scm.com/docs/hash-function-transition#_repository_format_extension)
  static opened (root: Location) => Git<((root / "config") as Byte[] as Git.Config).format>.Store(root: root)

  // A repository where it is: a remote fetched, else the one on disk (in the `.git` of a working tree)
  static (at: Location) as (=== Git.Store) => at.scheme is ("https" | "http" | "git" | "ssh") ? (at as Path as Git.Remote).fetched
    : Git.opened((at / ".git/HEAD") as boolean ? at / ".git" : at)

  static stored := {
    {written: Git.Written}.object_files => written.objects as Git.Pack -- (pack => [
      (path: "objects/pack/pack-" + pack.id + ".pack", content: pack as Byte[]),
      (path: "objects/pack/pack-" + pack.id + ".idx", content: pack as Git.Index as Byte[])
    ])
  }

  tree_at (location: Location, label) => Git.opened(location) -- (store => store.recorded.find(.line ~= ⊢(label as String + "\\")) -- (noted => noted ? store.tree(store.commit(noted.target).tree) : None))
  // A push writes in the format the server names (https://git-scm.com/docs/gitprotocol-capabilities#_object_format)
  push (history: History, remote: Location) => (remote as Path as Git.Remote).advertised("git-receive-pack") -- (offered => Git<offered.format> -- (git =>
    (remote as Path as git.Remote).pushed(git.Written(history: history), offered.references.find(.name == "refs/heads/" + (history.name ?? "main")).id)))
}
assert !(Git is Lossless)  // VC19 git does not keep snapshots
