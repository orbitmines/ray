Location &+= {
  normalised => segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  sandboxed => "instance/" + normalised
  system: FileSystem => Compiler.reduced(this, FileOptimizations)
  content => system.read(this) as String
  bytes => (system.read(this) ?? []) as Byte[]
  listing => system.listing(this)
  exists => system.exists(this)
  write (content): static => this ~~ system.write(., content)
  remove: static => this ~~ system.removed(.)
  origin => Location(scheme, host, port, path: "")
  .content = {value} ^punctuation => write(value)
}

FileSystem := class: Language {
  read (location: Location) => ERROR@FileSystem `no reader for the location`
  write (location: Location, content) => ERROR@FileSystem `no writer for the location`
  listing (location: Location) => []
  exists (location: Location) => read(location) != None
  removed (location: Location) => write(location, None)
}

FileSystem &+= {
  // The device's own files: the host's (sandboxed); a browser keeps them in its storage (as `ray:<path>`, Web Storage), the
  // language as the operating system on the device (`@me/device/storage`).
  static Host := class: FileSystem {
    key (location: Location) => "ray:" + location.normalised
    read (location: Location) => if OS.Browser { @me/device/storage[key(location)] }
      elsif OS.Ether { @me/device/storage[location.normalised] }
      else { external io location.sandboxed None }
    write (location: Location, content) => if OS.Browser { @me/device/storage[key(location)] = (content as String if content !== None) }
      elsif OS.Ether { @me/device/storage[location.normalised] = content }
      else { external io location.sandboxed content }
    listing (location: Location) => if OS.Browser {
        @me/device/storage.fields.name{~= ⊢(key(location) + "/")}.map(.after(key(location) + "/").before("/")).unique.map(location / .)
      } elsif OS.Ether {
        @me/device/storage.fields.name{~= ⊢(location.normalised + "/")}.map(.after(location.normalised + "/").before("/")).unique.map(location / .)
      } else {
        (&@.ask(`size`, location) -- (. == true ? @me/device.received(location as String) as String : .)).lines{.nonempty}.map(location / .)
      }
    removed (location: Location) => if OS.Browser || OS.Ether { write(location, None) } else { external os `remove` location.sandboxed }

    // Web Storage: localStorage, and the storage event other documents of the origin fire (https://html.spec.whatwg.org/multipage/webstorage.html#the-localstorage-attribute, https://html.spec.whatwg.org/multipage/webstorage.html#the-storageevent-interface)
    static script := @js {
      Object.keys(localStorage).forEach((key) => ray.set("@me/device/storage/" + key, localStorage.getItem(key)))
      window.addEventListener("storage", (event) => event.key === null
        ? ray.get("@me/device/storage.fields.name").forEach((key) => ray.set("@me/device/storage/" + key, null))
        : ray.set("@me/device/storage/" + event.key, event.newValue))
      effect(["@me/device/storage"], () => {
        const kept = ray.get("@me/device/storage.fields")
        Object.keys(localStorage).filter((key) => !kept.some((field) => field.name === key)).forEach((key) => localStorage.removeItem(key))
        kept.forEach((field) => localStorage.getItem(field.name) === field.value || localStorage.setItem(field.name, field.value))
      })
    }
  }
}

FileOptimizations := {
  {location: Location} => FileSystem.Host()
}

IO := class {
  output (text: String) => @me/device.sent("stdout", text)
  fetch (from: Location, path: String, version: Version?) => ((from / path + (version as String)).content if version) ?? (from / path).content
}

Random := class {
  secure => Random
  seeded (seed: Number) => Seeded(state: seed)

  bit => OS.Ether ? ERROR@OS `a source of random bits is not written in Ray yet` : (external random) ? 1 : 0
  bits (count: Number) => count.times.map(bit)
  number (width: Number) => Binary(integer: bits(width).map(Binary.digit))
  below (limit: Number) => {
    drawn = number((limit as Binary).length)
    drawn < limit ? drawn : below(limit)
  }

  static Seeded := class = state: Number {
    next => state = (state * 1664525 + 1013904223) % 2^32
    bit => next / 2^31 == 1 ? 1 : 0
    number (width: Number) => Binary(integer: width.times.map(bit).map(Binary.digit))
  }
}

choose {type} ^keyword => Program(who: @me, name: "choose", goal: type)
choose {n: Number} {type} ^keyword => Program(who: @me, name: "choose", goal: n type)
choose? {type} ^keyword => Program(who: @me, name: "choose", goal: type?)
choose? {type} ?? {placeholder} ^keyword => Program(who: @me, name: "choose", goal: type?, tried: placeholder)
Choice := Program{name == "choose"}

Proof := class = proposition: *, argument: * {
  static Proposition := class: Program {
    holds => this() as boolean
    negated => Proposition(code: { !holds })
    verify (actual) => attempt(actual)
    rolled_back => solution === None
  }

  holds => argument.holds

  static theorem | lemma | example (proposition, proof) => proof.holds ? true : ERROR@Proof `the proposition is not proven`
  static by_contradiction | contradiction (proposition, proof_of_negation) => !proof_of_negation.holds
  static rfl (proposition) => proposition.holds
}

! `+` `-`
! `*` `/`

