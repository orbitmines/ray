Skill := class: Ray {
  name: String
  quests: Node
  solved: (chain None)
  baseline: 0

  covers (quest) => quest.instance_of(.quests)
  solve (quest) => (
    .solved &= Skill.Solution(quest: quest, when: Time.now)
    this
  )
  recent (within) => (
    kept := chain None
    .solved for { if ((Time.now - it.value.when) < within) { kept &= it.value } }
    kept
  )
  proficiency (within) => (
    counted := .recent(within).count
    if (counted < .baseline) { .baseline + ((counted - .baseline) / 2) } else { counted }
  )
  settle => (
    .baseline = .solved.count
    this
  )
  Solution := class: Ray {
    quest: Node
    when: Node
    used: false
  }
}

Avatar.components.hierarchy &= class {
  skills: (chain None)
  traversed: (chain None)

  unlock (skill) => (
    .skills &= skill
    this
  )
  visit (location) => (
    .traversed &= location
    this
  )
  copied => Avatar(character: .character, platform: .platform)
  compounds + (other) => (
    other.skills for { unless (.skills.contains(it.value)) { .skills &= it.value } }
    other.traversed for { .traversed &= it.value }
    this
  )
  rewarded (solution) => solution.used
}

Mana := class: Ray {
  resource: Node
  capacity: Node
  held: None

  measured (resource) => Mana(resource: resource, capacity: IO.os(resource))
  cast (spell) => (
    .held = spell
    spell
  )
  free => (
    .held = None
    this
  )
  concentrating => (.held === None).not
}

Spell := class: Ray {
  operation: Node
  cost: Node
  progress: 0
  interrupt_level: 0

  interrupted_by (level) => .interrupt_level < level
}

Presence := enum memory | disk | remote

Room := class: Ray {
  value: Node

  items => .value.fields
  enter (item) => Room(value: item)
}

Onboarding := class: Ray {
  Purpose := enum everything | tools_only
  NetworkMode := enum online | pessimistically_online | invisible | prefer_offline | offline
  Look := enum realistic | voxel

  language: None
  purpose: Onboarding.Purpose.everything
  network: Onboarding.NetworkMode.online
  look: Onboarding.Look.realistic

  choose_language (language) => (
    .language = language
    this
  )
  choose_purpose (purpose) => (
    .purpose = purpose
    this
  )
  choose_network (mode) => (
    .network = mode
    this
  )
  choose_look (look) => (
    .look = look
    this
  )
  dialogue => .purpose == Onboarding.Purpose.everything
  permission => (
    if (.network == Onboarding.NetworkMode.online) { Accessor.Permission.public }
    elsif (.network == Onboarding.NetworkMode.pessimistically_online) { Accessor.Permission.protected }
    elsif (.network == Onboarding.NetworkMode.invisible) { Accessor.Permission.confidential }
    elsif (.network == Onboarding.NetworkMode.prefer_offline) { Accessor.Permission.private }
    else { Accessor.Permission.local }
  )
}
