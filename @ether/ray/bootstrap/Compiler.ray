  static expression (ex, ee) => Lowered.shaped(Compiled.trimmed(ex), Lowered.kind(ex), Lowered.parsed(ex), ee)
  static shaped (st, sk, sp, se) => (sk == `leaf`) ? (Compiled.bracketed(st) ? Lowered.grouped(Compiled.inner_of(st), se) : (Compiled.braced(st) ? Lowered.body(st, se) : Lowered.leaf(st, se))) : ((sk == `member_from`) ? Lowered.member(sp.member_from, Compiled.trimmed(sp.member_name), se) : ((sk == `indexed_of`) ? Lowered.indexed(sp.indexed_of, sp.index_at, se) : ((sk == `call_of`) ? Lowered.call(Compiled.trimmed(sp.call_of), sp.call_arguments, se) : ((sk == `called_of`) ? Lowered.call(Compiled.trimmed(sp.called_of), "", se) : Lowered.shaped_ops(st, sk, sp, se)))))
  static shaped_ops (st, sk, sp, se) => (sk == `group_code`) ? Lowered.grouped(sp.group_code, se) : ((sk == `choice_if`) ? Lowered.choice(sp.choice_if, sp.choice_yes, sp.choice_no, se) : ((sk == `equal_left`) ? Lowered.op(sp.equal_left, "==", sp.equal_right, se) : ((sk == `same_left`) ? Lowered.op(sp.same_left, "==", sp.same_right, se) : ((sk == `ne_left`) ? Lowered.op(sp.ne_left, "!=", sp.ne_right, se) : ((sk == `add_left`) ? Lowered.op(sp.add_left, "+", sp.add_right, se) : ((sk == `sub_left`) ? Lowered.op(sp.sub_left, "-", sp.sub_right, se) : ((sk == `mul_left`) ? Lowered.op(sp.mul_left, "*", sp.mul_right, se) : Lowered.shaped_more(st, sk, sp, se))))))))
  static shaped_more (st, sk, sp, se) => (sk == `div_left`) ? Lowered.op(sp.div_left, "/", sp.div_right, se) : ((sk == `rem_left`) ? Lowered.op(sp.rem_left, "%", sp.rem_right, se) : ((sk == `lt_left`) ? Lowered.op(sp.lt_left, "<", sp.lt_right, se) : ((sk == `gt_left`) ? Lowered.op(sp.gt_left, ">", sp.gt_right, se) : ((sk == `le_left`) ? Lowered.op(sp.le_left, "<=", sp.le_right, se) : ((sk == `ge_left`) ? Lowered.op(sp.ge_left, ">=", sp.ge_right, se) : ((sk == `shl_left`) ? Lowered.op(sp.shl_left, "<<", sp.shl_right, se) : ((sk == `shr_left`) ? Lowered.op(sp.shr_left, ">>", sp.shr_right, se) : Lowered.shaped_logic(st, sk, sp, se))))))))
  static shaped_logic (st, sk, sp, se) => (sk == `and_left`) ? Lowered.op(sp.and_left, "and", sp.and_right, se) : ((sk == `alt_left`) ? Lowered.op(sp.alt_left, "or", sp.alt_right, se) : Lowered.shaped_logic_more(st, sk, sp, se))
  static shaped_logic_more (st, sk, sp, se) => (sk == `land_left`) ? Lowered.choice(sp.land_left, sp.land_right, `0`, se) : ((sk == `lor_left`) ? Lowered.choice(sp.lor_left, `1`, sp.lor_right, se) : ((sk == `not_of`) ? Lowered.op(sp.not_of, "==", `0`, se) : ((sk == `is_left`) ? Lowered.is(sp.is_left, Compiled.trimmed(sp.is_type), se) : ((sk == `set_place`) ? Lowered.set(sp.set_place, sp.set_value, se) : ((sk == `if_value`) ? Lowered.when(sp.if_condition, sp.if_value, se) : Lowered.passed(st, sk, sp, se))))))
  // (the back end's own forms, `while`, `return`, `load`, `x <- v`: as they are, what they hold lowered)
  static passed (pt, pk, pp, pe) => (pk == `while_condition`) ? Lowered.looped(pp.while_condition, pp.while_block, pe) : ((pk == `return_value`) ? Lowered.returned(pp.return_value, pe) : ((pk == `load_at`) ? Lowered.loaded("load", pp.load_at, pe) : ((pk == `store_at`) ? Lowered.op(pp.store_at, "<-", pp.store_value, pe) : Lowered.passed_bytes(pt, pk, pp, pe))))
  static passed_bytes (pt, pk, pp, pe) => (pk == `load8_at`) ? Lowered.loaded("load8", pp.load8_at, pe) : ((pk == `store8_at`) ? Lowered.op(pp.store8_at, "<-8", pp.store8_value, pe) : (Compiled.braced(pt) ? Lowered.body(pt, pe) : High.unknown(pk)))
  static leaf (lt, le) => Lowered.local_in(le, lt) ? Lowered.named_local(lt) : ((Lowered.named_in(Lowered.constants, lt) === None) ? Lowered.w(lt) : Lowered.w(Lowered.named_in(Lowered.constants, lt).last))
  // (a parameter's or local's name, `the_x`: apart from any function's, which the back end reads alike whatever the case)
  static named_local (nl) => {
