// Networking
- Managed items by another instance (mirrors)

namespace Network

                    // ETHER
  class Protocol (name: String, default_port: Port) < name
    static#.push_back(this)

  Protocol("ether", 37839)
  Protocol("http", 80)
  Protocol("https", 443)
  Protocol("ftp", 21)

  DEFAULT_PORT: Port = Protocol{== "ether"}.default_port

  // TODO Default port depending on the scheme
  class URL < scheme | protocol : Protocol = "ether", "://", user_info: (user: String, (":", password: String)?, "@")? {host = ip, port}: Socket.Address | (host: DomainName, (":", port: Port = protocol.default_port ?? DEFAULT_PORT)?), path: "/", String, query: "?", {params: {}; .for [key, value] => params[key] = value}: (key: String, "=", value: String)[], fragment: "#", String

  Port = Decimal{< 2^16}

  class Socket
    static class Address = (ip: IPv4) | ("[",(ip: IPv6),"]"), (":", port: Port = DEFAULT_PORT)?
      protocol //TODO
    end
  end

  //TODO World names are instead used for /etc/hosts like behavior
  // Acts as a /etc/hosts
  Hosts: { {: Instance}: Instance } = {
    //TODO Or it's Character => Character instead (so we can also map @ether to @me)
    //TODO equivalence A => B
    //TODO A hostname without a space aren't by default reserved, but can be overwritten.
    confidential.write "localhost": "127.0.0.1" | "::1"
    //TODO external could fill these from /etc/hosts
    //TODO What about "ether".ignore_case => "ether.orbitmines.com"
  }

  dynamically Hosts.for host, ip => equivalence host -> ip

  //TODO Domainname:port castable to IP using nameservers.
end

+= Network

// Allow string CIDR notation
[IPv4, IPv6].for IP
  String{==.instance_of (ip: IP.String) + "/" + (prefix_length: Decimal{<= IP.NUMBER_OF_BITS}.String)}
    as :== IP = ip as IP / prefix_length
  end
end

//TODO Store history of DNS resolves, and then allow to use it if DNS doesnt resolve by checking whether the instance running match the public-key stored there.

+Node
  static class Remote
    //TODO All object access go over network, and backup it in a local copy, what if that local copy is already defined somewhere?
    //Remote .location might not know about our copy, so how do we do remote_variable @ local
    //TODO Settings location to an instance, should say: anywhere in this instance, I don't know where. So if it's @ some_specific_location in local, it should still go to this method?
    //TODO What if the value is stored at a location, but we're looking for something which is at an unknown instance? But with particular structure?

    // If we want the local reference to a particular value, we don't consult remote.
    @ instance: INSTANCE = instance[location]
  end
end
