// (as written: `(Base = Number, (quantities: (quantity: Base, (" ", (unit: Unit = Unit.None) = (unit as String){quantity == 1 ?
// singular : plural || singular})?)[]{length > 0}).join(" "))`; until a header is read as a pattern, its fields)
Quantity := class (quantities, Base = Number) => {
  assert 2 hours as String == "2 hours"  // U42 two hours are not written so
  dynamically assert .quantities.every _, unit => unit == this.quantities.0.unit
  dynamically assert .quantities.unit as this.quantities.0.unit[] -- .sorted(>)

  `quantity: Quantity` => .quantities ,= quantity
  assert 1d 10h 10m 30s as s == 123030 s  // U52 a juxtaposed quantity is not the sum of its parts

  // (in units one after another, `x as days hours minutes seconds`: as many of each as fit, the rest in the next)
  as (order: Quantity{.quantities.every(.quantity == 1)}) => Quantity(quantities: Quantity.split(this, order.quantities.unit))
  static split (left: Quantity, units) => units.empty ? [] : (units.count == 1 ? left.in(units.first) : left.in(units.first).floor) -- (count =>
    [[(quantity: count, unit: units.first)], Quantity.split(left - Quantity(quantities: [(quantity: count, unit: units.first)]), units.rest)].flatten)
  assert 10000000 s as days hours minutes seconds == 115d 17h 46m 40s  // U53 a quantity is not normalized into days hours minutes seconds

  unit => .quantities.last.unit
  amount => .quantities.last.quantity
  in (target: Unit) => Unit.converted(this.amount, this.unit, target)
  assert (5 bits).unit == bit  // U61 the unit of a quantity is not its unit
  assert (5 bits).amount == 5  // U62 the amount of a quantity is not its count
  assert (2 minutes).in(second) == 120  // U63 two minutes are not 120 in seconds
  assert (1 byte).in(bit) == 8  // U64 a byte is not 8 in bits
  finer (other: Quantity) => (Quantity(quantities: [(quantity: 1, unit: this.unit)]).in(other.unit) >= 1) ? other.unit : this.unit
  assert (1 minute).finer(1 second) == second  // U65 the finer of minutes and seconds is not seconds
  assert (1 second).finer(1 minute) == second  // U66 the finer of seconds and minutes is not seconds

  chainable == (other: Quantity) => .in(.finer(other)) == other.in(.finer(other))
  chainable < (other: Quantity) => .in(.finer(other)) < other.in(.finer(other))
  assert 2 bits < 3 bits  // U26 two bits are not fewer than three
  assert !(3 bits < 2 bits)  // U27 three bits are fewer than two
  assert !(2 seconds + 3 seconds < 5 seconds)  // U41 two and three seconds is below five seconds
  assert 2 bits <= 3 bits  // U67 two bits are not at most three
  assert 2 bits <= 2 bits  // U68 two bits are not at most two
  assert !(3 bits <= 2 bits)  // U69 three bits are at most two
  negated => this * (0 - 1)
  assert (5 bits).negated.amount == -5  // U70 the negation of five bits is not minus five
  assert 3 bits >= 3 bits  // U71 three bits are not at least three
  assert 4 bits >= 3 bits  // U72 four bits are not at least three
  assert !(2 bits >= 3 bits)  // U73 two bits are at least three
  assert !(90 s > 2 minutes)  // U74 ninety seconds are more than two minutes
  assert !(3 bits > 3 bits)  // U75 three bits are more than three
  assert 2 minutes > 90 s  // U55 two minutes are not more than ninety seconds
  chainable < (other: Number) => ERROR `a quantity does not compare with a plain number`
  chainable > (other: Number) => ERROR `a quantity does not compare with a plain number`
  compounds + (other: Quantity) => Quantity(quantities: [(quantity: .in(.finer(other)) + other.in(.finer(other)), unit: .finer(other))])
  assert 2 bits + 3 bits == 5 bits  // U22 two bits and three bits are not five
  assert 1 byte + 1 bit == 9 bits  // U25 a byte and a bit are not nine bits
  assert 2 seconds + 3 seconds == 5 seconds  // U40 two and three seconds is not five seconds
  compounds - (other: Quantity) => Quantity(quantities: [(quantity: .in(.finer(other)) - other.in(.finer(other)), unit: .finer(other))])
  assert 5 bits - 2 bits == 3 bits  // U23 five bits less two are not three
  compounds * (times: Number) => Quantity(quantities: [(quantity: .amount * times, unit: .unit)])
  compounds * (per: Quantity) => .unit is Unit.Rate ? Quantity(quantities: [(.amount * per.in(.unit.denominator), .unit.numerator)])
    : ERROR `a quantity is multiplied by another only as a rate by what it is per`
  assert 2 GB/s * 3 s == 6 GB  // U51 a rate times a duration is not an amount
  ± | +- (uncertainty: Quantity) => this - uncertainty | this + uncertainty
  assert (5 bits ± 1 bits)#.contains(4 bits)  // U76 five plus or minus one does not include four
  assert (5 bits ± 1 bits)#.contains(6 bits)  // U77 five plus or minus one does not include six
  assert !(5 bits ± 1 bits)#.contains(5 bits)  // U78 five plus or minus one includes five
  assert (2 bits).min(3 bits) == 2 bits  // U79 the smaller of two and three bits is not two
  assert !((2 bits).min(3 bits) == 3 bits)  // U80 the smaller of two and three bits is three
  assert (2 bits).max(3 bits) == 3 bits  // U81 the larger of two and three bits is not three
  assert !((2 bits).max(3 bits) == 2 bits)  // U82 the larger of two and three bits is two

  compounds / (unit: Unit) => Quantity(quantities: .quantities.map((quantity, from) => (quantity, from / unit)))
  assert (6 GB / s) as String == "6 GB/s"  // U83 six gigabytes per second are not written so

  static Temporal := Quantity{.unit == Unit.Temporal}
  assert 5 seconds . is Quantity.Temporal  // TI14 five seconds is not temporal
}
// (and so `>`, `<=`, `>=`, `min` and `max`, from `<` and `==`)
Quantity &+= Ordered

Unit := class (name + symbol: boolean? + plural: boolean? + singular: !symbol && !plural) => {
  static Rate := class: Unit (numerator: Unit, denominator: Unit) => {
    name => .numerator.name + "/" + .denominator.name
    assert (GB/s).numerator == GB  // U84 a rate does not hold its numerator
    assert (GB/s).denominator == s  // U85 a rate does not hold its denominator
    assert (GB/s) as String == "GB/s"  // U60 a rate is not named by its two units
    chainable == (other: Rate) => .numerator == other.numerator && .denominator == other.denominator
    assert (GB/s) == (GB/s)  // U86 a rate is not equal to itself
    assert !((GB/s) == (MB/s))  // U87 rates of different numerators are equal
    assert !((GB/s) == (GB/m))  // U88 rates of different denominators are equal
  }

  converting := None

  // (each made is known by its name and its symbol, everywhere: `px`, `pixel`; and as written after an amount: `16px`)
  (global[.name] = this) if .name
  assert 25.years == 25 years  // U49 a unit is not reachable as a member
  (global[.symbol] = this) if .symbol
  (Unit.Spelling[.name] = this) if .name
  (Unit.Spelling[.symbol] = this) if .symbol
  assert 3 s == 3 seconds  // U43 three s are not seconds

  static Temporal => second
  assert second is Unit.Temporal  // TI1 a second is not temporal

  as (=== Quantity) => 1, this
  assert (bit as Quantity).amount == 1  // U89 a unit as a quantity is not one of it
  assert (bit as Quantity).unit == bit  // U90 a unit as a quantity is a quantity of another unit
  as (other: . is Unit) => this as Quantity as other
  assert (minute as second) == 60 s  // U91 a minute as seconds is not sixty seconds

  dynamically assert this as String? != None
  as (=== String?) => .name
  assert bit as String == "bit"  // U36 a bit is not called that

  static spelled (spelling) => (spelling is Unit) ? spelling : global[spelling]
  assert Unit.spelled(second) == second  // U92 a unit spelled as itself is not itself
  assert Unit.spelled("second") == second  // U93 a unit spelled by its name is not that unit
  assert Unit.spelled("s") == second  // U94 a unit spelled by its symbol is not that unit
  // (a unit's name or symbol as written: each unit made gives it its own; read, the unit)
  static Spelling := { }

  compounds / (other: Unit) => Unit.Rate(numerator: this, denominator: other)
    -- .convert x => x * (this as other.static), other.static

  chainable == (other: Unit) => this === other || .name == other.name
  assert minute == minute  // U58 a unit is not itself
  assert !(minute == hour)  // U59 a minute is an hour
  // (what it makes of a quantity, `x as px`: the quantity in it)
  from (quantity: Quantity) => Quantity(quantities: [(quantity: quantity.in(this), unit: this)])

  // (what it is in another unit: a conversion read at the time, `x * k + b` (a linear one); backwards, its inverse)
  convert (convert, ToUnit: Unit) => (.converting = (to: ToUnit, by: convert)) -- this
  static converted (x, from: Unit, to: Unit) => (from == to) ? x : ((from.converting && Unit.reaches(from.converting.to, to)) ? Unit.converted(from.converting.by(x), from.converting.to, to) : (to.converting ? Unit.inverted(Unit.converted(x, from, to.converting.to), to.converting.by) : None))
  static inverted (y, by) => (y - by(0)) / (by(1) - by(0))
  static reaches (from: Unit, to: Unit) => from == to || (from.converting && Unit.reaches(from.converting.to, to))
  assert Unit.converted(2, minute, second) == 120  // U95 two minutes are not 120 seconds
  assert Unit.converted(120, second, minute) == 2  // U96 120 seconds are not two minutes
  assert Unit.converted(5, bit, bit) == 5  // U97 five of a unit are not five of it
  assert Unit.converted(1, bit, second) == None  // U98 bits are converted to seconds
  assert Unit.converted(2, hour, second) == 7200  // U99 two hours are not 7200 seconds (through minutes)
  assert Unit.inverted(120, (x) => x * 60) == 2  // U100 the inverse of a conversion does not recover 2 from 120
  assert Unit.reaches(hour, second)  // U101 hours do not reach seconds through minutes
  assert !Unit.reaches(second, hour)  // U102 seconds reach hours
  assert Unit.reaches(bit, bit)  // U103 a unit does not reach itself
  offset (offset: Number, ToUnit: Unit) => .convert(((x: Number) => x + offset), ToUnit)
  multiple (multiple: Number, ToUnit: Unit) => .convert(((x: Number) => x * multiple), ToUnit)

  magnitude (exponent: Number, ToUnit: Unit, Base: Decimal) => {
    convert (x: Decimal) => Decimal, ToUnit
      dynamically assert exponent >= 0 | x % 10^-exponent == 0
      x << exponent
    convert (x: Decimal.Real) => Decimal.Real, ToUnit
      if exponent == 0 { x }
      elsif exponent > 0 { x.integer, x.fraction.0 ?? 0, ".", x.fraction[1..] }
      else { x.integer[..<-1], ".", x.integer[-1] ?? 0, x.fraction }
  }
}

// (the unit of an amount written without one: made once Unit is)
Unit.None := Unit(global.None)

// (written right after it, or after a space: `16px`, `5 s`)
{amount: Number}{written: Unit.Spelling} => Quantity(quantities: [(quantity: amount, unit: Unit.spelled(written))])
{amount: Number} {written: Unit.Spelling} => Quantity(quantities: [(quantity: amount, unit: Unit.spelled(written))])
assert 2 seconds is Quantity  // HS13 a count before a unit is read as a count, not a quantity
assert 3.(. minutes == 180 s)  // U54 a number held in a variable does not take a unit after it
assert (5s).unit == second  // U109 a unit written right after a number is not that unit
assert (5s).amount == 5  // U110 an amount written before a unit is not its amount
assert (5 s).unit == second  // U111 a unit written after a space is not that unit

si_name (symbol, name, symbol_prefix, prefix) => symbol_prefix + symbol + symbol: true | prefix + name ("s" + plural: true)?

// (the prefixes, made once: each unit maps them)
SI_prefixes := {
  -30: "q", "quecto"
  -27: "r", "ronto"
  -24: "y", "yocto"
  -21: "z", "zepto"
  -18: "a", "atto"
  -15: "f", "femto"
  -12: "p", "pico"
  -9: "n", "nano"
  -6: "µ", "micro"
  -3: "m", "milli"
  -2: "c", "centi"
  -1: "d", "deci"
  0: "", ""
  1: "da", "deka"
  2: "h", "hecto"
  3: "k", "kilo"
  6: "M", "mega"
  9: "G", "giga"
  12: "T", "tera"
  15: "P", "peta"
  18: "E", "exa"
  21: "Z", "zetta"
  24: "Y", "yotta"
  27: "R", "ronna"
  30: "Q", "quetta"
}

SI_Unit {symbol: *} {name: *} => {
  private SI = SI_prefixes
    .map((magnitude, prefixes) => Unit(name: si_name(symbol, name, ...prefixes), magnitude: magnitude))
    .reduce(|)

  SI#.for FromUnit => FromUnit.magnitude SI.magnitude - FromUnit.magnitude, SI
}
assert 1dab == 10b  // U10 a deka-bit is not ten bits

IEC_prefixes := {
  1: "Ki", "kibi"
  2: "Mi", "mebi"
  3: "Gi", "gibi"
  4: "Ti", "tebi"
  5: "Pi", "pebi"
  6: "Ei", "exbi"
  7: "Zi", "zebi"
  8: "Yi", "yobi"
  9: "Ri", "robi"
  10: "Qi", "quebi"
}

Binary_Unit {symbol: *} {name: *} => {
  private IEC = IEC_prefixes
    .map((power, prefixes) => Unit(name: si_name(symbol, name, ...prefixes), power: power))
    .reduce(|)

  IEC#.for FromUnit => FromUnit.multiple 1024^FromUnit.power, global[name]
}

SI_Unit s "second"
SI_Unit m "meter"
SI_Unit g "gram"
SI_Unit A "ampere"
SI_Unit K "kelvin"
SI_Unit mol "mole"
SI_Unit cd "candela"

SI_Unit b "bit"
SI_Unit B "byte"
assert 1 kB == 1000 B  // UB4 a kilobyte is not 1000 bytes
assert 1 kilometer == 1000 meter  // U104 a kilometer is not 1000 meters
assert 1 mg == 0.001 g  // U105 a milligram is not a thousandth of a gram
assert 1 megabyte == 1000 kilobytes  // U106 a megabyte is not 1000 kilobytes
assert 1 ms == 0.001 s  // U107 a millisecond is not a thousandth of a second
Binary_Unit B "byte"
assert 1 KiB == 1024 B  // UB3 a kibibyte is not 1024 bytes
assert !(1 KiB == 1 kB)  // UB5 a kibibyte is a kilobyte
assert 1 GiB == 1024 MiB  // U108 a gibibyte is not 1024 mebibytes
assert 1 MiB == 1024 KiB  // UB7 mebi is not 1024 kibi
assert kibibyte as String == "kibibyte"  // UB10 a kibibyte is not called that
assert 2 KiB as String == "2 kibibytes"  // UB12 two kibibytes are not kibibytes
byte.multiple 8, bit
assert 1B == 8b  // U8 a byte does not equal eight bits
assert 1 byte as bit == 8 bits  // U3 a byte does not convert to eight bits
assert 8 bits as byte == 1 byte  // UB6 eight bits are not one byte
Quantity{.unit == bit} &+= {
  as (=== Binary) => .amount is Integer ? Binary{.length == this.amount} : ERROR `a bit count is whole bits`
  assert 2 B as Binary == Binary₁₆  // FWB1 two bytes are not sixteen bits of Binary
  assert 1 KiB as Binary == Binary{length == 8192}  // FWB2 a kibibyte is not 8192 bits of Binary
}

Unit(name: "minute" ("s" + plural: true)?, symbol: "min" | "m").multiple 60, second
assert 1 minute as seconds == 60 s  // U35 a minute is not sixty seconds
assert 8m == 8 meter | 8 minute  // U50 an ambiguous unit does not superpose
assert 2 minutes as seconds == 120 s  // TM1 two minutes are not 120 seconds
Unit(name: "hour" ("s" + plural: true)?, symbol: "h").multiple 60, minute
assert 2 hours as minutes == 120 minutes  // U46 two hours are not 120 minutes
Unit(name: "day" ("s" + plural: true)?, symbol: "d").multiple 24, hour
assert 1.5 days as hours == 36 h  // U45 1.5 days is not 36 hours
Unit(name: "week" ("s" + plural: true)?, symbol: "wk").multiple 7, day
assert 1 week == 7 days  // U56 a week is not seven days
Unit(name: "year" ("s" + plural: true)?, symbol: "y").multiple 365, day
assert 1 year == 365 days  // U57 a year is not 365 days

Unit(name: "celsius", symbol: "°C").offset 273.15, kelvin
assert 0 °C as kelvin == 273.15 K  // U47 zero celsius is not 273.15 kelvin
assert 273.15 K as celsius == 0 °C  // U48 the offset is not reversed

Unit(name: "thousand", symbol: "k").multiple 10^3, Unit.None
assert 1k == 1000  // UB15 1k is not a thousand
Unit(name: "million", symbol: "M").multiple 10^6, Unit.None
Unit(name: "billion", symbol: "B").multiple 10^9, Unit.None

Unit(name: "imaginary", symbol: "i")
Complex := Real + Imaginary
Imaginary := Quantity{.unit == i}
Complex &+= {
  real => this as Real
  imaginary => (this as Imaginary).amount
  chainable == (other: Complex) => .real == other.real && .imaginary == other.imaginary
  compounds * (other: Complex) => (.real * other.real - .imaginary * other.imaginary) + ((.real * other.imaginary + .imaginary * other.real) i)
  conjugate => .real + (.imaginary.negated i)

assert (3 + 4i).real == 3  // U112 the real part of 3 + 4i is not 3
assert (3 + 4i).imaginary == 4  // U113 the imaginary part of 3 + 4i is not 4
assert (3 + 4i).conjugate.imaginary == -4  // U114 the conjugate of 3 + 4i does not have imaginary part -4
assert (3 + 4i).conjugate.real == 3  // U115 the conjugate changed the real part
assert (1 + 2i) == (1 + 2i)  // U116 a complex number is not equal to itself
assert !((1 + 2i) == (1 + 3i))  // U117 complex numbers with different imaginary parts are equal
assert !((1 + 2i) == (2 + 2i))  // U118 complex numbers with different real parts are equal
assert ((1 + 2i) * (3 + 4i)).real == -5  // U119 the real part of (1 + 2i)(3 + 4i) is not -5
assert ((1 + 2i) * (3 + 4i)).imaginary == 10  // U120 the imaginary part of (1 + 2i)(3 + 4i) is not 10
}

// (what the bootstrap leaves to this file: it needs what is here)
{share: Number{0 < . < 1}} {counted: *{#.count != 1}{!(. is Unit)}} => share * counted#.count -- (whole => whole is Integer ? counted{#.count == whole}
  : counted#.count is ∞ ? counted{#.measure(counted#) == share * counted#.measure}
  : ERROR@Type `a share of a discrete structure is not a whole number of its possibilities`)
{count: Number | Range} {counted: *{#.count != 1}{!(. is Unit)}} => counted{#.count == count}
a | an {counted: *{#.count != 1}{!(. is Unit)}} => 1 counted
Unit(name: "turn" ("s" + plural: true)?)
Unit(name: "radian" ("s" + plural: true)?, symbol: "rad").multiple 1 / τ, turn
Unit(name: "degree" ("s" + plural: true)?, symbol: "deg" | "°").multiple 1 / 360, turn
Angle := Quantity{.unit is (turn | radian | degree)}
Angle &+= {
  cos => .in(radian).cos
  sin => .in(radian).sin
}
assert (33% ("A" | "B" | "C")) is Diagnostic  // HS12 a share that is not a whole number of a discrete structure's possibilities is not a type error
