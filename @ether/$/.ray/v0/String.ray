// Strings (drafts: .ray2/Language/String/String.ray, Unicode.ray; .ray3/Node.ray's
// `{string: String}`). A string is its characters, a character is the
// codepoint it is, and what is written between quotes is read as UTF-8 into
// codepoints (Unicode.ray). The one bridge from the machine is `bits`, which
// hands a literal's bytes to the language one bit at a time.

// class Char < Unicode.Scalar: a character is the codepoint it is.
Character := class: Unicode.Scalar {
  codepoint => this

  // How many bytes UTF-8 writes it in.
  width => if (this < 128) { 1 } elsif (this < 2048) { 2 } elsif (this < 65536) { 3 } else { 4 }
  octets => Unicode.UTF8.encode(this)

  // Letter: Char = "a".."z" | "A".."Z", and `\d`, `\s`, `\w`.
  // spec: only the Latin letters and digits until the Unicode tables are read
  // in (Unicode.ray); blanks are the space and the controls 9..13 (tab,
  // newline, vertical tab, form feed, carriage return).
  is_ascii => this < 128
  lower_case => (96 < this).and(this < 123)
  upper_case => (64 < this).and(this < 91)
  letter => .lower_case.or(.upper_case)
  digit => (47 < this).and(this < 58)
  blank => (this == 32).or((8 < this).and(this < 14))
  is_underscore => this == 95
  word => .letter.or(.digit).or(.is_underscore)

  // The Latin cases are thirty-two apart.
  upper => if .lower_case { (this - 32).as_character } else { this }
  lower => if .upper_case { (this + 32).as_character } else { this }
  swapped => if .lower_case { .upper } elsif .upper_case { .lower } else { this }

  // The value a character stands for as a digit: `0`..`9`, then `a`..`z`
  // (either case) from ten on; None for any other.
  digit_value => digit_of(this)

  // spec: `Unicode.Scalar`'s assertion, as a question rather than a refusal.
  is_scalar => Unicode.scalar(this)

  // \0 = U+0000, \t = U+0009, \n = U+000A, \r = U+000D
  null => U+0000
  tab => U+0009
  newline => U+000A
  carriage => U+000D
  space => U+0020
  underscore => U+005F

  // The Latin letters and digits, counted from one and from zero.
  latin_upper (index: Number) => (64 + index).as_character
  latin_lower (index: Number) => (96 + index).as_character
  decimal_digit (value: Number) => if (value < 10) { (48 + value).as_character } else { (87 + value).as_character }
}

// A number read as the character whose codepoint it is. A new one is made, so
// that the number itself does not become a character wherever it is written.
Number.components.hierarchy &= class {
  as_character => (
    held ^keyword := 0 + this
    external extend held Character
    held
  )
}

// The classes of characters, as narrowings of Character, made once here rather
// than in the body (which every character runs). spec: Symbol and the
// non-Latin letters wait on the Unicode tables.
Character.Letter = Character{.letter}
Character.Digit = Character{.digit}
Character.Blank = Character{.blank}
Character.Word = Character{.word}

// class String < Char[]: a string is the array of its characters. What an
// array is and does — its entry, how many it holds, what is first, whether
// two are the same — it is as an array, so none of that is written here.
String := class: Array {
  // Its UTF-8 bytes, bit by bit.
  bits => (
    held_bits := chain None
    this for { it.value.octets for { held_bits &= it.value.holds } }
    held_bits
  )

  // lower_case | lowercase, upper_case | uppercase, title_case | titlecase,
  // swap_case | swapcase, fold_case | foldcase.
  // spec: `title_case` capitalises the first letter of each word, `swap_case`
  // flips each; `fold_case` is `lower_case` (Latin only).
  lower_case => .map { it.value.lower }.as_string
  upper_case => .map { it.value.upper }.as_string
  swap_case => .map { it.value.swapped }.as_string
  fold_case => .lower_case
  title_case => (
    out := chain None
    at_start ^keyword := true
    this for {
      out &= (if at_start { it.value.upper } else { it.value.lower })
      at_start = it.value.blank
    }
    out.as_string
  )
  lowercase => .lower_case
  uppercase => .upper_case
  swapcase => .swap_case
  titlecase => .title_case
  foldcase => .fold_case

  // snake_case | snakecase, camel_case | camelcase | camelCase,
  // pascal_case | pascalcase | PascalCase.
  // spec: words are the runs between blanks or underscores; `snake_case`
  // joins them with `_` in lower case, `camel_case` capitalises all but the
  // first, `pascal_case` all of them.
  words => .split_by { character.blank.or(character.is_underscore) }
  snake_case => String.joined(.words.each_lower, "_")
  camel_case => (
    parts := chain None
    at_start ^keyword := true
    this.words for {
      parts &= (if at_start { it.value.lower_case } else { it.value.title_case })
      at_start = false
    }
    String.joined(parts, None)
  )
  pascal_case => String.joined(.words.each_title, None)
  snakecase => .snake_case
  camelcase => .camel_case
  pascalcase => .pascal_case
  camelCase => .camel_case
  PascalCase => .pascal_case

  // spec: English by suffix only: `plural` appends `s` unless the word already
  // ends in one; `singular` strips one trailing `s`.
  plural => if (.tail.value == "s") { this } else { this + "s" }
  singular => if (.tail.value == "s") { .slice(0, .count.pred) } else { this }

  // mirrored (bidi): the characters in the other order.
  mirrored => .reverse.as_string

  // The characters from one position up to (not including) another.
  slice (from, to) => (
    out := chain None
    walker ^keyword := .at(from)
    left ^keyword := to - from
    while (left.nonzero.and(exists walker)) {
      out &= walker.value
      walker = walker.next
      left = left.pred
    }
    out.as_string
  )

  starts_with (other: String) => (
    mine ^keyword := .head
    theirs ^keyword := other.head
    same ^keyword := true
    while ((exists theirs).and(exists mine)) {
      unless (mine.value == theirs.value) { same = false }
      mine = mine.next
      theirs = theirs.next
    }
    same.and((exists theirs).not)
  )
  ends_with (other: String) => .mirrored.starts_with(other.mirrored)
  // Walked rather than read with `for`, so that `this` is the text throughout
  // and the slice being asked about is a slice of it.
  contains (other: String) => (
    length := .count
    found ^keyword := false
    position ^keyword := 0
    walker ^keyword := .head
    while (exists walker) {
      if (.slice(position, length).starts_with(other)) { found = true }
      position = position.succ
      walker = walker.next
    }
    found.or(other.empty)
  )
  index_of (other: String) => (
    length := .count
    found ^keyword := None
    position ^keyword := 0
    walker ^keyword := .head
    while (exists walker) {
      unless (exists found) { if (.slice(position, length).starts_with(other)) { found = position } }
      position = position.succ
      walker = walker.next
    }
    found
  )

  // The pieces between the characters a block accepts, as a chain of strings.
  split_by (predicate) => (
    pieces := chain None
    current ^keyword := chain None
    this for {
      character ^keyword := it.value
      if (inline predicate) {
        pieces &= current.as_string
        current = chain None
      } else {
        current &= character
      }
    }
    pieces &= current.as_string
    pieces
  )
  split (separator: Character) => .split_by { character == separator }
  lines => .split(Character.newline)

  // `this` repeated a number of times.
  repeat (times: Number) => (
    out := chain None
    left ^keyword := times
    while left {
      this for { out &= it.value }
      left = left.pred
    }
    out.as_string
  )

  // String[] as String = reduce(,): the pieces of a chain, with a separator between.
  joined (parts, separator) => (
    out := chain None
    at_start ^keyword := true
    parts for {
      unless at_start { if (exists separator) { out &= separator } }
      it.value for { out &= it.value }
      at_start = false
    }
    out.as_string
  )

  // Whether this spells a number in a base: its characters are all digits
  // below the radix.
  spells_in (radix: Number) => .nonempty.and(.every { if (exists it.value.digit_value) { it.value.digit_value < radix } else { false } })

  // The number a string of decimal digits spells.
  as_number => .as_number_in(10)
  as_number_in (radix: Number) => (
    total ^keyword := 0
    this for { total = (total * radix) + it.value.digit_value }
    total
  )
  is_numeric => .nonempty.and(.every { it.value.digit })

  // spec: `()` on a string evaluates it as the name of a variable; that needs
  // names to be read from strings, which the runtime does not offer yet.

  // Concatenation: the other string's characters follow this string's; a
  // character follows as itself.
  compounds + (other) => (
    joined := chain None
    this for { joined &= it.value }
    if (exists other.codepoint) { joined &= other } else { other for { joined &= it.value } }
    joined.as_string
  )
}

// A chain of characters is the string it spells.
Chain.components.hierarchy &= class {
  as_string => (
    held ^keyword := this
    external extend held String
    held
  )
}

// What is written is read as the string its UTF-8 spells.
Node.components.hierarchy &= class {
  as_string => (
    encoded ^keyword := this
    external extend encoded Unicode.UTF8
    encoded.as_code_points.map { it.value.as_character }.as_string
  )
}
"{literal text ^string}" ^string.punctuation => text.as_string

// `Base.String => this as String`: a number spelled in a base, and a string
// read back as the number its digits spell there. spec: a bare `spelled` would
// shadow a field of that name on anything built on a number (UUID's digits).
Number.components.hierarchy &= class {
  spelled_in (radix: Number) => .digits_in(radix).map { Character.decimal_digit(it.value) }.as_string
}

// The pieces of a chain of strings, each in a case.
Chain.components.hierarchy &= class {
  each_lower => .map { it.value.lower_case }
  each_title => .map { it.value.title_case }
}

// A number as a chain of bits of a fixed width, most significant first: a
// binary counter, least significant bit first, is stepped once per unit of
// the number and then read backwards.
bits_of (number, width) => (
  counter := chain None
  left ^keyword := width
  while left {
    counter &= 0
    left = left.pred
  }
  rest ^keyword := number
  while rest {
    digit ^keyword := counter.head
    carrying ^keyword := true
    while (carrying.and(exists digit)) {
      if digit.value { digit.value = 0 } else {
        digit.value = 1
        carrying = false
      }
      digit = digit.next
    }
    rest = rest.pred
  }
  forwards := chain None
  walker ^keyword := counter.tail
  while (exists walker) {
    forwards &= walker.value
    walker = walker.previous
  }
  forwards
)
// The number a chain of bits spells, most significant first.
number_of (bits) => (
  total ^keyword := 0
  bits for {
    total = total + total
    if it.value { total = total.succ }
  }
  total
)


// spec: Regex, from the draft's `/{pattern}/{flags}`: only literal patterns
// are matched (a pattern is a String and a match is containment); the flag
// set is the draft's `i g u`; character classes await the Unicode tables.
//
// A matcher that reads the pattern character by character — `.` for any one,
// `*` `+` `?` for how many of the one before, `^` and `$` for the ends — was
// written and taken out again: `Regex.here(p.next, t.next)`, recursing twice
// over a two-character pattern, exhausts eight gigabytes, while the same
// recursion written over a plain chain (`K.step(link.next)`, three deep) costs
// nothing. What differs is inside `here`, not the recursion; until that is
// found a pattern is what it spells.
Regex := class {
  Flag := enum ignore_case | global | unicode
  pattern: String
  flags: (chain None)
  with (flag) => (
    .flags &= flag
    this
  )
  ignoring_case => .flags some { it.value == Regex.Flag.ignore_case }
  matches (text: String) => if .ignoring_case { text.fold_case.contains(.pattern.fold_case) } else { text.contains(.pattern) }
  find (text: String) => if .ignoring_case { text.fold_case.index_of(.pattern.fold_case) } else { text.index_of(.pattern) }
}


// A number as its decimal digits: a decimal counter, least significant digit
// first, is stepped once per unit and then read backwards.
Number.components.hierarchy &= class {
  as_string => (
    counter := chain None
    counter &= 0
    rest ^keyword := this
    while rest {
      digit ^keyword := counter.head
      carrying ^keyword := true
      while carrying {
        digit.value = digit.value.succ
        if (digit.value == 10) { digit.value = 0 } else { carrying = false }
        if carrying {
          unless (exists digit.next) { counter &= 0 }
          digit = digit.next
        }
      }
      rest = rest.pred
    }
    forwards := chain None
    walker ^keyword := counter.tail
    while (exists walker) {
      forwards &= Character.decimal_digit(walker.value)
      walker = walker.previous
    }
    forwards.as_string
  )
}


