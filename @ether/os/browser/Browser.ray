OS.Browser := class: OS {
  [property: String] => (external os property) as String
  running => platform == "browser"

  key (location: Location) => "ray:" + location.normalised
  read (location: Location) => @me/device/storage[key(location)]
  write (location: Location, content) => @me/device/storage[key(location)] = (content as String if content !== None)
  listing (location: Location) => @me/device/storage.fields.name{~= ⊢(key(location) + "/")}
    .map(.after(key(location) + "/").before("/")).unique.map(location / .)
  sent (stream: String, content) => external io stream content
  received (stream: String) => external io stream None
  bit => (external random) ? 1 : 0
  now: Time => nondeterministic (external time) ns ± (external time).resolution
  time_zones: TimeZone.Source => Intl()
  fonts: Location[] => []

  // Answered by the page at `zones/<zone>/<at>`; keeping answers is a cache level.
  zones: Zones = Zones(path: "zones")
  static Zones := class: Location {
    [zone: String, at: Number] => await (this / zone / (at as String)).value
  }

  // ECMA-402 Intl.DateTimeFormat: the offset in force read back from formatToParts with timeZoneName "longOffset" (https://tc39.es/ecma402/#sec-createdatetimeformat, https://tc39.es/ecma402/#sec-formatdatetimetoparts), answered by the page at @me/device/os/zones
  static Intl := class: TimeZone.Source {
    asked (zone: String, time: Time) => @me/device/os/zones[zone, (time as s).floor * 1000]
    offset (zone: String, time: Time) => (asked(zone, time).offset ~= ("GMT", (sign: "+" | "-", hours: Decimal, ":", minutes: Decimal)?)) -- (.sign ? (.sign == "-" ? -1 : 1) * (.hours hours + .minutes minutes) : 0 seconds)
    at (zone: String, time: Time) => offset(zone, time) -- (in_force => (
      offset: in_force,
      daylight: in_force > offset(zone, time - 182 days).min(offset(zone, time + 182 days)),
      abbreviation: asked(zone, time).abbreviation
    ))
  }

  static script := @js {
    // Web Storage: localStorage, and the storage event other documents of the origin fire (https://html.spec.whatwg.org/multipage/webstorage.html#the-localstorage-attribute, https://html.spec.whatwg.org/multipage/webstorage.html#the-storageevent-interface)
    Object.keys(localStorage).forEach((key) => ray.set("@me/device/storage/" + key, localStorage.getItem(key)))
    window.addEventListener("storage", (event) => event.key === null
      ? ray.get("@me/device/storage.fields.name").forEach((key) => ray.set("@me/device/storage/" + key, null))
      : ray.set("@me/device/storage/" + event.key, event.newValue))
    effect(["@me/device/storage"], () => {
      const kept = ray.get("@me/device/storage.fields")
      Object.keys(localStorage).filter((key) => !kept.some((field) => field.name === key)).forEach((key) => localStorage.removeItem(key))
      kept.forEach((field) => localStorage.getItem(field.name) === field.value || localStorage.setItem(field.name, field.value))
    })
    // ECMA-402 Intl.DateTimeFormat formatToParts, the zone's offset ("longOffset") and abbreviation ("short") (https://tc39.es/ecma402/#sec-createdatetimeformat, https://tc39.es/ecma402/#sec-formatdatetimetoparts)
    ray.awaited("@me/device/os/zones", (path) => {
      const [zone, at] = [path.split("/").slice(0, -1).join("/"), Number(path.split("/").at(-1))]
      const part = (style) => new Intl.DateTimeFormat("en-US", \{timeZone: zone, timeZoneName: style}).formatToParts(at).find((part) => part.type === "timeZoneName").value
      ray.set("@me/device/os/zones/" + path, \{offset: part("longOffset"), abbreviation: part("short")})
    })
  }
}
OS |= OS.Browser
