say {x} =>
  @me/instance = x
greet {who?} =>
  say who
greet
greet you
tag {literal word} =>
  say word
tag hello
spaced{ }{x} =>
  say x
spaced   wide
quoted {`=>`} {x} =>
  say x
quoted => arrow
{a} then {b} then {c} =>
  say a
  say b
  say c
one then two then three then four
