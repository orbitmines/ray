None => @js $.none ??= new Ray()
Word => @js $.word ??= Object.assign(new Ray(), { scope: true })
Node => @js $.base ??= new Ray()
this => @js $.self(F)
global => @js $.global
@made {x} => @js new Ray(x)
@same {a} {b} => @js $.name(F, (a ?? $.none) === (b ?? $.none) ? "true" : "false")
@declaring {name} => @js $.declaring(F.m.get("name"), F)
@show {x} => @js $.output($.show(x))
// `&`: the rule's application, a value: what it was read from is its `caller`
& => @js (a => (a.has("caller") || a.m.set("caller", a.caller), a))(F.caller)
// the context a statement is read in
@here => @js $.here(F)
// where the method it is read in was called from
@caller => @js $.caller_of(F)
@has {x} {name} => @js $.name(F, $.has(x, F.m.get("name").s.trim()) ? "true" : "false")
@of {x} => @js x instanceof Ray ? x.outer : undefined
@applies {x} => @js $.name(F, x instanceof Ray && x.eqs.some(eq => !("lit" in eq.pieces[0]) || eq.pieces[0].lit === "()") ? "true" : "false")
// (what it holds: a type, as written: read when it is read)
// (what is read when it is first read: a value, then kept)
@later {code} => @js $.later($.written(F.m.get("code")))
@holding {code} => @js ((p) => $.declare_at(p, $.holding(p, $.written(F.m.get("code"))), false))($.place_of(F))
// (the same, at a place taken before: `:` takes what it is applied on first)
@place_word {spot} => @js (p => p && typeof p === "object" ? p.word : undefined)($.get(F, "spot"))
@field_at {target} {spot} {value} => @js ((p) => p && typeof p === "object" ? ($.unread.delete(p), $.field_set($.get(F, "target"), p.word, $.get(F, "value"))) : undefined)($.get(F, "spot"))
@keep_place {name} => @js $.keep_place(F, F.m.get("name").s.trim())
@declare_at {spot} {value} => @js $.declare_at($.get(F, "spot"), value, false)
@holding_at {spot} {code} => @js ((p) => $.declare_at(p, $.holding(p, $.written(F.m.get("code"))), false))($.get(F, "spot"))
@assign {value} => @js $.assigning(F) || !$.placed(F) ? undefined : $.declare(F, $.defaulted(F) ? $.later($.written(F.m.get("value"))) : $.get(F, "value"), true)
// (one character of the host's text is a `Char` too)
// how the language says a value is of a type (`(value, type) => value is type`): asked by what reads a capture of a type
// `x` also made of `y`: what `y` holds (and comes to hold) read in `x` after what `x` continues into (`A + B`)
@also {x} {y} => @js ((a, b) => { if (a instanceof Ray && b instanceof Ray && a !== b) (a.also ??= []).push(b); return a; })($.get(F, "x"), $.get(F, "y"))
// a statement read as the class's own (`static`): what it defines applies to the class, not to what is made of it
// a method head the class's own (`static m => …`): what it defines applies to the class, not to what is made of it
@own {node} => @js ((n) => (n instanceof Ray && (n.own = true), n))($.get(F, "node"))
@statically {statement} => @js $.statically(F.m.get("statement"))
// (whether what is read is read as the class's own)
@static => @js $.name(F, $.static_now > 0 ? "true" : "false")
@inside {x} {type} => @js $.name(F, (() => { const v = x; if (typeof v === "string" && [...v].length === 1 && type === $.name(F, "Char")) return true; const start = x instanceof Ray ? x : $.kind_of(x); return start instanceof Ray && type instanceof Ray && $.made_of_(start, type); })() ? "true" : "false")
@text {x} => @js F.m.get("x").s
// a value's member by its name (as the host holds it: its own, its class's)
@member {x} {name} => @js $.field($.get(F, "x"), String($.get(F, "name")))
// what a value holds along a path (`device/terminal`, by `/`): each step a member it holds, else nothing
@path {x} {path} {by} => @js $.path($.get(F, "x"), String($.get(F, "path")), String($.get(F, "by")))
// the host this interpreter runs on: what it says of itself (`platform`, `architecture`, an environment variable), its clock (ns
// since 1970, and how fine it is), a random bit
@os {property} => @js (p => ({ platform: process.platform, architecture: process.arch })[p] ?? process.env[p])(String($.get(F, "property")))
@time => @js Date.now() * 1e6
@time_resolution => @js 1e6
@random => @js $.name(F, Math.random() < 0.5 ? "true" : "false")
// ICU's C API (Windows' icu.dll): not bound by this interpreter
@icu {function} {arguments} => @js undefined
// where a value was written (none known to this interpreter)
@where {x} => @js undefined
// what code writes as it is read (`with`), and that put back
@writing {settings} => @js $.writing(F.m.get("settings"))
@unwritten {journal} => @js $.unwritten($.get(F, "journal"))
// a message said where it is written
@report {message} => @js $.report(F.m.get("message"))
// what is written, as code (not read)
@code {x} => @js (r => ($.blocks.set(r, $.written(F.m.get("x"), true)), r))(new Ray())
@given {instance} {arguments} => @js $.given($.get(F, "instance"), $.written(F.m.get("arguments")))
@block {made} {code} => @js $.blocks.set($.get(F, "made"), $.written(F.m.get("code")))
@run {program} => @js $.ran($.get(F, "program"))
// a program called with what it is given: matched against its parameters as a method's are, its code run with them
@call {program} {code} {parameters} {given} => @js $.call_program($.get(F, "program"), $.get(F, "code"), $.get(F, "parameters"), F.m.get("given"))
@kind {name} {class} => @js $.kinds.set(F.m.get("name").s.trim(), $.written(F.m.get("class")))
// a context of its own: what is read there is read by its rules alone (and by those of the context it continues into)
@context {outer} => @js Object.assign(new Ray(outer instanceof Ray && outer !== $.none ? outer : undefined), { scope: true, alone: true })
// what reads what is inside a capture, and a method's parameters (each read into the node a head was read into)
@captures {context} => @js ($.captured_by = $.get(F, "context"), undefined)
// a node a head is read into, written as `text`; its parameters read into it; one of them (`a: T = d`, read into it); what `:`
// said of a member (as written); one applied with what is on its right
@named {text} => @js $.named($.written(F.m.get("text")).s.trim())
@unnamed => @js $.named("")
// a method given what is written between two texts, `[at: Integer]` (`xs[3]`)
@between {open} {close} {parameters} => @js $.read_parameters(Object.assign($.named(String($.get(F, "open"))), { closing: String($.get(F, "close")) }), $.written(F.m.get("parameters")))
@literally {text} => @js Object.assign($.named($.written(F.m.get("text")).s), { literal: true })
// (a class read with its header: its `header`, the pieces it was read as)
@parameters {node} {parameters} => @js (n => (n instanceof Ray && n.spelled === undefined && n.pieces !== undefined && n.m.set("header", n.pieces), n))($.read_parameters($.get(F, "node"), $.written(F.m.get("parameters"))))
@parameter {target} => @js $.parameter($.written(F.m.get("target")))
@typed {type} => @js $.name(F, $.typed(F, $.written(F.m.get("type"))) ? "true" : "false")
// a node's parameter, in order; whether a value has a member of its own; one given to it; what one given nothing is
@word => @js (() => { let n = F; while (n && !n.place) n = n.caller; return n?.place?.word; })()
@param {node} {index} => @js (n => n instanceof Ray && n.params ? n.params[$.get(F, "index")] : undefined)($.get(F, "node"))
@owns {target} {name} => @js $.name(F, $.has($.get(F, "target"), $.get(F, "name")) ? "true" : "false")
@field {target} {name} {value} => @js $.field_set($.get(F, "target"), $.get(F, "name"), $.get(F, "value"))
@default {target} {node} {name} => @js $.default_of($.get(F, "target"), $.get(F, "node"), $.get(F, "name"))
@takes {node} => @js (n => (n instanceof Ray && (n.params ??= []), n))($.get(F, "node"))
@again {name} {value} => @js (a => Object.assign($.named(a.text.s.slice(a.b, $.written(F.m.get("value")).e)), { again: true }))($.written(F.m.get("name")))
@leftward {node} => @js (n => (n instanceof Ray && (n.leftward = true), n))($.get(F, "node"))
// what a head was read as, defined (`receiver`: what it is applied with, when on its right; `between`: what is written between
// what it is given)
@admitting {f} => @js ($.admitting = $.get(F, "f"), undefined)
@define {node} {receiver} {between} => @js $.define(F, $.get(F, "node"), $.get(F, "receiver"), $.get(F, "between"))
// Numbers: the host's own (a JS number), read where digits are written; a Number whose operations are the host's (loosest first).
// a symbol: no letters or digits (`..<`, `√`): what is written as one hugs what it takes
Symbolic => @js $.reader(s => s.length > 0 && !/[\p{L}\p{N}_\s]/u.test(s) ? s : undefined)
Numeral => @js $.reader(s => /^[0-9]+(\.[0-9]+)?$/.test(s) ? Number(s) : undefined)
{number Numeral} => number
// `while c { body }`: the body again while `c` holds (every value but nothing and false), iterated by the host.
// `do { … } while c`: the block, then again while `c` holds
// (the language's `x while c`: `x` again while `c` holds)
// `loop { … }`: the block again, until a `break`
// jumps (the language's `break`, `continue`, `return`, `recur`, `goto`, labels): out of the loop, or method, they are written in
@return {value} => @js $.jump("return", $.get(F, "value"), F)
@recur {given} => @js $.jump("recur", $.written(F.m.get("given")), F)
@recur => @js $.jump("recur", undefined, F)
@goto {target} => @js ((t) => $.jump("goto", t && t.constructor && t.constructor.name === "Label" ? t : $.written(F.m.get("target")).s.trim()))($.get(F, "target"))
@label {name} => @js $.label(F)
@character {x} => @js String.fromCodePoint($.get(F, "x"))
// any text (what reads a String written in a rule's head)
Text => @js $.reader(s => s)
