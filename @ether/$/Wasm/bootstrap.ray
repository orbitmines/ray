!language   { }   {LHS} => {RHS}

{LHS} => {RHS} => x
// A number: the constant it is
{n} => external const {n}
({g}) => g
// A call: what it is given, then the function its name is
{f}() => {
  external emit 0x10
  f
}
{f}({args}) => {
  args
  external emit 0x10
  f
}
// (several given: each in turn; one written against the comma takes no space, `f((a + 1), b)`)
{a}, {b} => {
  a
  b
}
// The operators, the tightest first: one declared later binds looser
{a} * {b} => {
  a
  b
  external emit 0x6C
}
{a} / {b} => {
  a
  b
  external emit 0x6E
}
{a} % {b} => {
  a
  b
  external emit 0x70
}
{a} + {b} => {
  a
  b
  external emit 0x6A
}
{a} - {b} => {
  a
  b
  external emit 0x6B
}
{a} << {b} => {
  a
  b
  external emit 0x74
}
{a} >> {b} => {
  a
  b
  external emit 0x76
}
{a} >>s {b} => {
  a
  b
  external emit 0x75
}
{a} & {b} => {
  a
  b
  external emit 0x71
}
{a} | {b} => {
  a
  b
  external emit 0x72
}
{a} < {b} => {
  a
  b
  external emit 0x48
}
{a} > {b} => {
  a
  b
  external emit 0x4A
}
{a} <= {b} => {
  a
  b
  external emit 0x4C
}
{a} >= {b} => {
  a
  b
  external emit 0x4E
}
{a} == {b} => {
  a
  b
  external emit 0x46
}
{a} != {b} => {
  a
  b
  external emit 0x47
}
!{a} => {
  a
  external emit 0x45
}
{a} && {b} => {
  a
  external emit 0x04
  external emit 0x7F
  b
  external emit 0x41
  external emit 0
  external emit 0x47
  external emit 0x05
  external emit 0x41
  external emit 0
  external emit 0x0B
}
{a} || {b} => {
  a
  external emit 0x04
  external emit 0x7F
  external emit 0x41
  external emit 1
  external emit 0x05
  b
  external emit 0x41
  external emit 0
  external emit 0x47
  external emit 0x0B
}
{c} ? {a} : {b} => {
  c
  external emit 0x04
  external emit 0x7F
  a
  external emit 0x05
  b
  external emit 0x0B
}
// Memory: a word, a byte
load {a} => {
  a
  external emit 0x28
  external emit 2
  external emit 0
}
load8 {a} => {
  a
  external emit 0x2D
  external emit 0
  external emit 0
}
{a} <-! {v} => {
  a
  v
  external emit 0x36
  external emit 2
  external emit 0
}
// (a word written in memory older than a test's region: kept, to be undone when the test is done)
{a} <- {v} => {
  drop jot(({a}), ({v}))
}
{a} <-8 {v} => {
  a
  v
  external emit 0x3A
  external emit 0
  external emit 0
}
// A local: its name, from here on in its function, its value; given one, the get it writes made a set
var {x} {i} => {
  {x} => {
    external emit 0x20
    external leb {i}
  }
}
{x} = {v} => {
  v
  external mark
  {x}
  external patch 0x21
}
// Statements
return {v} => {
  v
  external emit 0x0F
}
trap => external emit 0x00
drop {v} => {
  v
  external emit 0x1A
}
exit {n} => {
  external emit 0x0C
  external leb {n}
}
if {c} do {body} => {
  c
  external emit 0x04
  external emit 0x40
  body
  external emit 0x0B
}
when {c} do {yes} else {no} => {
  c
  external emit 0x04
  external emit 0x40
  yes
  external emit 0x05
  no
  external emit 0x0B
}
while {c} do {body} => {
  external emit 0x02
  external emit 0x40
  external emit 0x03
  external emit 0x40
  c
  external emit 0x45
  external emit 0x0D
  external emit 1
  body
  external emit 0x0C
  external emit 0
  external emit 0x0B
  external emit 0x0B
}
// A module: its sections; a function declared (its index, how many it takes: its type), then written in that order
section {id} do {body} => {
  external emit {id}
  external begin
  body
  external finish
}
declare {name} {index} takes {count} => {
  {name} => external leb {index}
  external emit {count}
}
function {name} locals {count} do {body} => {
  external begin
  external emit 1
  external leb {count}
  external emit 0x7F
  external .
  body
  external emit 0x0B
  external finish
}
// A name for a number, from here on
constant {name} {value} => {
  {name} => external const {value}
}
