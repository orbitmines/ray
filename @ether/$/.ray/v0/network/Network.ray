Network &+= {
  static Port = Decimal{< 2^16}

  static Protocol &+= {
    name: String
    port: Port

    static ether = Protocol("ether", @ether.address.port)
    static https = Protocol("https", 443)
    static http = Protocol("http", 80)
    static ssh = Protocol("ssh", 22)
    static known = [ether, https, http, ssh]

    static named (written: String) => known{.name == written}.first
    static version => Handshake.version
  }

  static URL := class (
    (scheme: Char{!= ":"}[], "://")?,
    host_written: Char{!= ":" && != "/"}[],
    (":", port_written: Decimal)?,
    ("/", path: Char{!= "?"}[])?,
    ("?", query: String)?
  ) => {
    protocol => Protocol.named(scheme)
    host => Hosts.resolved(host_written)
    port => port_written ?? protocol?.port

    static parse (text: String) => text as URL
    as (:== String) => protocol.name + "://" + host.text + ":" + port as String + "/" + path
  }

  static Socket := namespace {
    static Address := class (("[", host: IPv6, "]") | host: IPv4 | host: DomainName, ":", port: Port) => { }
  }

  static Hosts := namespace {
    static Equivalence := class = name: String, host: String
    equivalences: Equivalence[] = []

    equate (name: String, host: String) => equivalences.push(Equivalence(name.fold_case, host)).host
    resolved (name: String) => DomainName(equivalences{.name == name.fold_case}.last?.host ?? name)
  }

  static DNS := namespace {
    static Record := class = name: String, address: *, key: *, when: Time = Time.now
    history: Record[] = []

    record (name: String, address, key) => history.push(Record(name, address, key)).address
    trusted (name: String, address, key) => (history{.name == name}.last?.key ?? key) == key
  }

  static Proxied := class = proxy: *, everything = true, who: Character?, block: *[]? {
    carries (traffic, character: Character) => everything || (who ? who == character : block.contains(traffic))
  }

  static Handshake := namespace {
    version => 0
    offer (versions) => versions{== version}.last ?? Quest(name: "agree on a version", goal: versions)
  }

  static Remote := class = location: *, character: Character {
    static Execution := class = code: *, as: Character, at: *

    run (code) => character.key ? Execution(code, as: character, at: location) : Quest(name: "authorise", goal: code)
    fresh (code) => Remote(location, Character(name: "unauthorised")).run(code)
  }

  static Challenge := class = message: *, due: Time, answered = false {
    answer (response) => {
      answered = response == message if Time.now < due
      answered
    }
  }

  static Stream := class = player: Character, location: *, watchers: Character[] = [] {
    watch (character: Character): static => {
      watchers.push character
      character.presence = location
      this
    }
    moved (location): static => {
      this.location = location
      watchers#.presence = location
      this
    }
  }

  static Update := class = from: History, into: History {
    apply => {
      conflicts = into.merge(from)
      conflicts.empty ? into : conflicts
    }
  }

  static Shard := class = character: Character, locations: Part[] = [] {
    static Part := class = part: *, location: *

    store (part, location): static => this ~~ locations.push Part(part, location)
  }
}

Instance &+= {
  address: (Network.URL | Network.Socket.Address | IP | Network.DomainName)?

  seen_from (other: Instance) => other === this ? @localhost : address
  local => address ==.instance_of @localnetwork
  canonical: static => Instance(location, address: address as String as address.static)
  // No MAC address: a random one with the multicast bit set (https://datatracker.ietf.org/doc/html/rfc4122#section-4.5)
  mac_address: Binary⁴⁸ => (external os `mac_address`) ?? (Binary⁴⁸.random ~~ .[7] = 1)
}

{address: Network.URL | Network.Socket.Address | IP | Network.DomainName}: Instance => Instance(location: address, address)
