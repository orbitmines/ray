// A file, as the bytes it holds: a chain of eight-bit words, in the order
// they are written. What a container says about them is said over this
// chain — where to go in it, how many bytes to take, which bytes together
// make one of the container's fields — and nothing in it is a number: an
// offset is the bits the file writes it with, and going there is done by
// what those bits say.

Bytes := class {
  // A file written by hand, in hexadecimal: two digits a byte, most
  // significant digit first, as `xxd -p` writes it — and, since most of a
  // small executable is zeros, `z` for four zero bytes. What is neither —
  // spaces, newlines — is passed over. `7f454c46 0201 z` is the first ten
  // bytes of a 64-bit little-endian ELF file, six of them zeros.
  //
  // The text is read a bit at a time (it is all the machine hands over), the
  // bits first and then eight at a time: `0` to `9` are 0011 followed by the
  // digit; `a` to `f` are 01100 followed by one to six, and stand for nine
  // more; `z` is 0111 1010.
  hex (written) => (
    zero := Bits.hex(`00`)
    text_bits := chain None
    take (bit) => (
      text_bits &= (inline bit)
      true
    )
    external bits written take
    decoded := chain None
    high := None
    reading := text_bits.head
    while (exists reading) {
      b6 := reading.next
      b4 := b6.next.next
      b3 := b4.next
      b2 := b3.next
      b1 := b2.next
      b0 := b1.next
      nibble := None
      if (b6.value.and(b4.value)) {
        decoded &= zero
        decoded &= zero
        decoded &= zero
        decoded &= zero
      } elsif b6.value {
        nibble = chain None
        nibble &= b0.value.not
        if b1.value { nibble &= b0.value.not } else { nibble &= b0.value }
        if b2.value { nibble &= true } else { nibble &= b1.value.and(b0.value) }
        nibble &= true
      } elsif b4.value {
        nibble = chain None
        nibble &= b0.value
        nibble &= b1.value
        nibble &= b2.value
        nibble &= b3.value
      }
      if (exists nibble) {
        if (exists high) {
          byte := chain None
          Bits.joined(byte, nibble)
          Bits.joined(byte, high)
          decoded &= Bits(bits: byte)
          high = None
        } else { high = nibble }
      }
      reading = b0.next
    }
    decoded
  )

  // The widths most fields are written in, made once.
  one := Bits.hex(`1`)
  two := Bits.hex(`2`)
  four := Bits.hex(`4`)
  eight := Bits.hex(`8`)

  // Where `count` bytes further on is, from the link `from`. The count is
  // read from its highest set bit down, each bit doubling the steps already
  // counted and adding one if it is set, so the steps are counted out the
  // way the bytes are walked: one for each. Nothing above the highest set
  // bit is walked at all. When `into` is a chain, each link walked over is
  // added to it.
  on (from, count, into) => (
    walking := Bytes.steps(count)
    here := from
    step := walking.head
    while ((exists step).and(exists here)) {
      if (exists into) { into &= here }
      here = here.next
      step = step.next
    }
    here
  )
  // A count as that many steps: a chain of it, one link for each.
  steps (count) => (
    top := count.bits.tail
    while ((exists top).and(top.value.not)) { top = top.previous }
    counted := chain None
    while (exists top) {
      twice := chain None
      step := counted.head
      while (exists step) {
        twice &= true
        twice &= true
        step = step.next
      }
      if top.value { twice &= true }
      counted = twice
      top = top.previous
    }
    counted
  )
  // The `count` bytes from `from` on, as a chain of their own.
  taken (from, count) => Bytes.held(Bytes.links(from, count))
  // The links that hold them.
  links (from, count) => (
    gathered := chain None
    Bytes.on(from, count, gathered)
    gathered
  )
  // The bytes a chain of links holds.
  held (spanned) => (
    holding := chain None
    taking := spanned.head
    while (exists taking) {
      holding &= taking.value.value
      taking = taking.next
    }
    holding
  )

  // Bytes read as one word, from the links that hold them. A little-endian
  // field is written least significant byte first, which is the order a
  // word's bits are held in, so its bytes are its word in order; a
  // big-endian one is written the other way round.
  word (spanned, big_endian) => (
    assembled := chain None
    reading := spanned.head
    if big_endian { reading = spanned.tail }
    while (exists reading) {
      byte := reading.value.value.bits
      Bits.joined(assembled, byte)
      if big_endian { reading = reading.previous } else { reading = reading.next }
    }
    Bits(bits: assembled)
  )
  // The other way round: a word written out as its bytes, into `into`.
  written (whole, big_endian, into) => (
    split := chain None
    octet := chain None
    bit_at := whole.bits.head
    while (exists bit_at) {
      octet &= bit_at.value
      if (exists octet.head.next.next.next.next.next.next.next) {
        split &= Bits(bits: octet)
        octet = chain None
      }
      bit_at = bit_at.next
    }
    byte_at := split.head
    if big_endian { byte_at = split.tail }
    while (exists byte_at) {
      into &= byte_at.value
      if big_endian { byte_at = byte_at.previous } else { byte_at = byte_at.next }
    }
    into
  )
  // Every byte of one chain added to another.
  appended (into, from) => (
    copying := from.head
    while (exists copying) {
      into &= copying.value
      copying = copying.next
    }
    into
  )

  // Whether two chains of bytes hold the same bytes, bit for bit, and as
  // many of them. Each bit is asked, not added: arithmetic here would cost
  // many times the walk.
  same (left, right) => (
    agrees := true
    mine := left.head
    theirs := right.head
    while ((exists mine).and(exists theirs)) {
      bit := mine.value.bits.head
      other := theirs.value.bits.head
      while (exists bit) {
        if bit.value {
          unless other.value { agrees = false }
        } elsif other.value { agrees = false }
        bit = bit.next
        other = other.next
      }
      mine = mine.next
      theirs = theirs.next
    }
    if ((exists mine).xor(exists theirs)) { agrees = false }
    agrees
  )
}

// One field of a container's layout, by its name and how many bytes it takes
// (as bits, like every other size here).
Slot := class {
  name: Node
  size: Node
}

// A field as it was read: its name, the links of the file its bytes are
// held by, how many there are and in which order they make its word. The
// word is read from them when it is asked for, and the field is written back
// as the bytes it was read from, which are that word written in that order.
// spec: a field given a new word is written from the word.
Stored := class {
  name: Node
  spanned: Node
  size: Node
  big: Node
  word => (
    from_links := .spanned
    order := .big
    Bytes.word(from_links, order)
  )
  written (into) => (
    target := into
    writing_links := .spanned
    writing := writing_links.head
    while (exists writing) {
      target &= writing.value.value
      writing = writing.next
    }
    target
  )
}

// A structure a container keeps in the file — a header, one entry of a
// table — as the fields it was read into, in the order they are written.
// `at` is the link its first byte is held by, `after` the link just past it.
// `owned` is whether the bytes it covers are written back from its fields;
// one that shares its bytes with a structure read before it is a view over
// them, and the one read first writes them.
Piece := class {
  name: Node
  values: Node
  at: Node
  after: Node
  owned: Node

  field (called) => Layout.find(.values, called)
  // Written back: each field, in its own order of bytes.
  written (into) => (
    target := into
    each_field := .values.head
    while (exists each_field) {
      each_field.value.written(target)
      each_field = each_field.next
    }
    target
  )
}

// Bytes no structure of the container reads: padding, alignment, what a
// segment holds, what nothing is known to say. They are kept as they are.
Gap := class {
  bytes: Node
  written (into) => (
    target := into
    kept := .bytes
    Bytes.appended(target, kept)
  )
}

// Reading structures out of a file, and laying the file out as what was read.
Layout := class {
  // The word of the field called `called` among `values`, or None.
  find (values, called) => (
    found := None
    looking := values.head
    while ((exists looking).and((exists found).not)) {
      if (exists (external alike (looking.value.name) (called))) { found = looking.value.word }
      looking = looking.next
    }
    found
  )
  // The fields `slots` names, read one after the other from `from`, each in
  // the order of bytes `big_endian` says, into `values`; every link they are read
  // from is added to `links`. What is answered is the link just past them.
  read (slots, from, big_endian, values, links) => (
    here := from
    slot := slots.head
    while (exists slot) {
      field_links := chain None
      width := slot.value.size
      here = Bytes.on(here, width, field_links)
      values &= Stored(name: slot.value.name, spanned: field_links, size: width, big: big_endian)
      Bytes.appended(links, field_links)
      slot = slot.next
    }
    here
  )
  // `count` entries of a table from the link `from` on, each `size` bytes
  // and read as `slots` says. What an entry holds beyond its slots is left
  // unread, and so kept.
  table (from, size, count, slots, is_big, called) => (
    entries := chain None
    entry_at := from
    remaining := Bytes.steps(count).head
    while (exists remaining) {
      entry_values := chain None
      entry_links := chain None
      past_entry := Layout.read(slots, entry_at, is_big, entry_values, entry_links)
      entries &= Layout.claimed(called, entry_values, entry_links, past_entry)
      entry_at = Bytes.on(entry_at, size, None)
      remaining = remaining.next
    }
    entries
  )
  // A structure is claimed in the file: its first link is marked with it and
  // every link it covers is marked as covered. If any of them already is,
  // another structure holds those bytes, and this one is only a view.
  claimed (called, read_values, links, past) => (
    free := true
    walker := links.head
    while (exists walker) {
      if (exists walker.value.covered) { free = false }
      walker = walker.next
    }
    piece := Piece(name: called, values: read_values, at: links.head.value, after: past, owned: free)
    if free {
      marking := links.head
      while (exists marking) {
        marking.value.covered = true
        marking = marking.next
      }
      starting := links.head.value
      starting.piece = piece
    }
    piece
  )

  // The file laid out as what was read of it: each structure that owns its
  // bytes, where it starts, and the bytes between them as gaps.
  pieces (file) => (
    out := chain None
    loose := chain None
    walker := file.head
    while (exists walker) {
      if (exists walker.piece) {
        if (exists loose.head) {
          out &= Gap(bytes: loose)
          loose = chain None
        }
        out &= walker.piece
        walker = walker.piece.after
      } else {
        loose &= walker.value
        walker = walker.next
      }
    }
    if (exists loose.head) { out &= Gap(bytes: loose) }
    out
  )
  // The file written back from its pieces.
  written (laid_out) => (
    whole_file := chain None
    emitting := laid_out.head
    while (exists emitting) {
      emitting.value.written(whole_file)
      emitting = emitting.next
    }
    whole_file
  )
}
