// (what a definition answers given its value: a left side made of names answers a list of their places (`(a, b) := list`, a
// call's parameters): each the value in its place)
{given} given {value} ^keyword => ((given).listing === true) ? ((((value).textual === true) && written_among((given).head)) ? (text_read((given).head, value) ? given : (ERROR a text does not read as what it is given to)) : ((given) each takes (value))) : given
// (a text is destructured only by places with a text written among them, `(a, `-`, b)`: a parameter list given a text, or
// String itself (which is textual), takes it whole)
written_among (at) => at ? (((at.value).textual === true) || written_among(at.next)) : false
// (a text given to places, with texts written among them, `(a, `-`, b) := `x-y``: read the way a list is given, in order,
// each written text there in its turn, each place the shortest span after which the rest reads (and its type reads))
text_read (at, text) => at ? (((at.value).textual === true) ? ((text.starts_with(at.value)) && text_read(at.next, text.after(at.value))) : text_spans(at, text, text.rest)) : text.empty
text_spans (at, text, cut) => (text_read(at.next, cut) && text_fits(at.value, text.until(cut))) ? text_given(at.value, text.until(cut)) : ((!cut.empty) && text_spans(at, text, cut.rest))
// (what is a text: a String; anything else is not)
textual := false
text_fits (place, span) => ((place).type === None) || (span is (place).type)
text_given (place, span) => {
  (place) alone takes (span)
  true
}
{name} = {value} => {
  // (the value first, as a value (read on, so in a left side too: `(a, b = c)`'s c is read, not declared))
  value
  (name) := value
}
// (`x[k] = v`, after it: what x holds under k, not a name)
{on}[{key}] = {value} ^punctuation => (((on).listing === true) && (key is Number)) ? (on).placed(key, value) : ((key is String) ? ((on).{key} = value) : (on).holding(key, value))
// (and composing, after giving: `,` binds loosest of all, `(a, b = 0)` is `a, (b = 0)`)
// A list: `a, b` a Ray of both (a side that only declared is no value in it), the loosest of all.
// (what follows, a list this `,` just made (still spreading, no one else's yet): the value put in front of it, not copied)
{list}, {other} ^punctuation => {
  (list === declared) ? other : ((other === declared) ? list : ((list).listing ? (list).joined(other) : ((((other).listing === true) && ((other).spread === true)) ? (other).prepend(list) : Ray.new.append(list).joined(other))).spreading)
}
// (a class written as a structure, its header a list of positions (`class a: T, ".", b: U { … }`): declared after `,`, so the
// whole definition reads as one, not as a list of its parts)
// (its header begins with a field's name, `Header`: `class: P { … }` is not one)
Header := {
  {field: Name}: {rest} => `{field}`
}
class {fields: Header} {`{`}{block}{`}`} ^keyword => { class: Node ({fields}) => { {block} } }
{name} := class {header: Header} {`{`}{block}{`}`} ^class => {name} := (class ({header}) => { {block} })
// Statements on one line: `a ; b` (declared after everything else here: the loosest of all, `x = 1 ; y = 2` two).
{first} ; {rest} ^punctuation => {
  {first}
  {rest}
}
assert {
  asserted := dynamically assert {
    true
    1 == 1
  }
  assert asserted  // DY1 a dynamic assert of holding conditions fails
}
assert {
  contributed := 1
  contribution := 2
  dynamically contributed &= contribution
  contribution = 3
  assert !(contributed == (1 & 2 & 3))  // FWQ6 a dynamic contribution kept its earlier value
}
// `dynamically x` reads x again each time (P5.1)
assert {
  moving := 1
  followed := dynamically moving + 1
  moving = 5
  assert followed == 6  // DY2 dynamically does not read again what it depends on
}

// A setting changed for a block is back once the block is left
assert {
  Setting := class { static level = 1 }
  // WI1 a setting is not seen in the context it is set in
  assert (
    with Setting.level = 2
    Setting.level
  ) == 2
  assert Setting.level == 1  // WI2 a setting outlived its block
  // WI3 assume is not with
  assert (
    assume Setting.level = 3
    Setting.level
  ) == 3
}
assert {
  Holder := class {
    Side := enum left | right {
    }
    side => Side.left
  }
  assert Holder.Side.left  // EM22 an enum inside a class has no members
  assert Holder.Side#.count == 2  // EM23 an enum inside a class lost a member
  assert Holder().side == Holder.Side.left  // EM24 an instance does not reach the enum its class writes
}
// `.( … )` reads among the members of what is before it (A8)
assert {
  Grouped := class {
    first => 1
    second => 2
  }
  assert Grouped.(first + second) == 3  // GP1 .( ) does not read the members of what is before it
}
assert {
  TA := class { }
  TB := class: TA { }
  assert TA() is TA  // TY1 an instance is not an instance of its class
  assert TA() is TB  // TY2 an instance is not one of a class that requires nothing
  assert TB() is TB  // TY3 an instance is not an instance of its own class
  assert TB() is TA  // TY4 an instance is not an instance of what its class is built on
  assert 5 is TA  // TY6 five is not one of a class that requires nothing
}
// A class requires the fields it writes with their type
assert {
  Needs := class { amount: Number }
  Gives := class { amount => 1 }
  Lacks := class { other => 1 }
  assert Gives() is Needs  // TY60 what gives every required name is not one
  assert !(Lacks() is Needs)  // TY61 what lacks a required name is one
  assert !(5 is Needs)  // TY62 a number gives a name it does not have
  assert !(Lacks() is Array)  // TY64 what is entered nowhere is an array
}
// A child is made of its parent's fields, defaults and methods
assert {
  Parent := class {
    named: "p"
    flag: false
    greet => named
  }
  Child := class: Parent {
    extra: "e"
  }
  assert Child().extra  // TY10 the child's own field is not there
  assert Child().named  // TY11 the parent's field is not there
  assert Child().greet == "p"  // TY12 the parent's method does not answer
  assert !Child().flag  // TY13 the parent's default is not false
  assert Child(named: "q").named == "q"  // TY14 the parent's field cannot be given
  // `Type?` is the type or nothing
  Either := Parent?
  assert Child() is Either  // TY21 a child is not one of its parent or nothing
  assert Parent() is Either  // TY22 a parent is not one of itself or nothing
  assert None is Either  // TY23 nothing is not one of a thing or nothing
  assert !(None is Parent)  // TY24 nothing is one of a thing
}
// A class built inside a method answers with what that call wrote
assert {
  Wrapping := class {
    wrapped (tag) => class: this {
      says => tag
    }
  }
  once := Wrapping.wrapped(1)
  twice := once.wrapped(2)
  thrice := twice.wrapped(3)
  assert once.says == 1  // TY28 the first wrapping says other than what it was written with
  assert twice.says == 2  // TY29 a wrapping of a wrapping says its parent's
  assert thrice.says == 3  // TY30 a third wrapping says an older one's
  assert once.says == 1  // TY31 building on a class changed what it says
}
// A class written as a structure: each named position a field of that type
assert {
  Pointed := class whole: Number, ".", part: Number {
    summed => whole + part
  }
  pointed := Pointed(whole: 2, part: 3)
  assert pointed.whole == 2  // TY32 a structure's first field is not what it was built with
  assert pointed.part == 3  // TY33 a structure's last field is not what it was built with
  assert pointed.summed == 5  // TY34 a structure's body does not read its fields
  assert Pointed.positions[1] == "."  // TY35 a structure does not keep what is written between its fields
}
assert {
  Ranged := class low: Decimal, "-", high: Decimal {
    width => high - low
  }
  range_of {written: Ranged} => written
  ranged := range_of 2-7
  assert ranged.low == 2  // TY36 a structure read from text does not start at what is written first
  assert ranged.high == 7  // TY37 a structure read from text does not end at what is written last
  assert ranged.width == 5  // TY38 a structure read from text is not built as one
  positioned: Ranged = (4, "-", 9)
  assert positioned.width == 5  // TY39 positions given to a structure are not built as one
  misfit: Ranged = (4, "+", 9)
  assert misfit[1] == "+"  // TY40 positions that do not fit a structure are taken as a structure
  spanned: Ranged = 3-8
  assert spanned.width == 5  // TY41 text given to a structure is not read by it
}
assert {
  Bare := class only: Number
  assert Bare(3).only == 3  // HD6 a header without a body has no field
}
assert {
  Greeter := class {
    greeting => name
    twice => greeting
  }
  Loud := class: Greeter {
    greeting => global
    polite => super.greeting
  }
  loud := Loud(name: global)
  assert loud.polite  // C22 super.greeting did not run the parent's method on the instance
  assert loud.super.twice  // C23 super reaches the parent's other methods
}
// A class extended later reaches every instance built from it
assert {
  Late := class { }
  built_before := Late()
  Late &+= {
    added => 1
  }
  assert built_before.added == 1  // C24 a class extended later does not reach an instance built before
  assert Late().added == 1  // C25 a class extended later does not reach an instance built after
}
assert {
  G1 := class { depth => 1 }
  G2 := class: G1 { depth => 2 }
  G3 := class: G2 { depth => 3 }
  assert G3().depth == 3  // C26 the nearest class does not answer
  assert G2().depth == 2  // C27 the middle class answers its parent's
  assert G1().depth == 1  // C28 the first class answers something else
  assert G3.super  // C29 a class three deep has no super
  assert G3.super.depth == 2  // C30 super does not reach the class it is built on
}
// Class headers: fields written inline, a class read by its pattern, `static` (A7, T3.10, T3.15b)
assert {
  Pair := class left: Number, right: Number = 7 {
    total => left + right
  }
  assert Pair(1, 2).left == 1  // HD1 a header field is not taken by position
  assert Pair(1, 2).right == 2  // HD2 the second header field is not taken by position
  assert Pair(right: 3, left: 4).total == 7  // HD3 header fields are not taken by name
  assert Pair(1).right == 7  // HD4 a header default is not used when not given
  Tagged := class ("#", tag: Decimal) => {
    doubled => tag * 2
  }
  assert Tagged(tag: 4).doubled == 8  // HD7 a class read by its pattern has no named part as a field
  tagged_of {written: Tagged} => written
  assert (tagged_of #21).tag == 21  // HD8 a class written as a pattern does not read its text
  Sub := class: Pair (": ", first: Number) => {
    head => first
  }
  assert Sub(first: 2).head == 2  // HD9 class: Parent (pattern) has no field from its pattern
  assert Sub(first: 2) is Pair  // HD10 class: Parent (pattern) is not built on Parent
  Count := class {
    static made := 0
    static zero => 0
    static Inner := class { }
    tally => made
  }
  first_count := Count()
  second_count := Count()
  Count.made = 2
  assert first_count.tally == 2  // HD11 a static is not shared by the instances
  assert second_count.tally == 2  // HD12 a static is per instance
  assert Count.zero == 0  // HD13 a static method is not on the class
  assert Count.Inner  // HD14 a static class is not on the class
  Both := class: Pair &+ Tagged { }
  assert Both(left: 1, right: 2, tag: 3).total == 3  // HD15 class: A &+ B is not built on A
  assert Both(left: 1, right: 2, tag: 3).doubled == 6  // HD16 class: A &+ B is not built on B
}
// `if x { case => value … } else { … }`: `==` unless an operator is written, `is` for a type (P2.11)
assert {
  described (x) => if x {
    is Number => "number"
    "A" => "letter"
  } else {
    "other"
  }
  assert described(5) == "number"  // MA1 an is case does not match an instance of its type
  assert described("A") == "letter"  // MA2 a case with no operator is not asked with ==
  assert described(true) == "other"  // MA3 the else case does not take what nothing else does
}
assert {
  graded (x) => if x {
    < 10 => "low"
  } else {
    "high"
  }
  assert graded(3) == "low"  // MA4 a case with an operator is not asked with it
}
assert {
  first_case (x) => if x {
    1 => "one"
    is Number => "number"
  } else {
    "other"
  }
  assert first_case(1) == "one"  // IC1 a later case answers before an earlier one that holds
  assert first_case(2) == "number"  // IC2 a case that does not hold answers
}

// The classes the library adds to: what is iterable, an array of it, text (an array of characters), a number, a character
// (a number), a program, a diagnostic.
Iterable := class { }
// A Ray: a chain of vertices, each holding a value (`head` the first, `tail` the last; a vertex's `next`, `previous`); what
// a list is written as (`[a, b]`, `a, b`).
Ray := {
  new => {
    {
      head := None
      tail := None
      listing := true
      of := Array
      spread := false
      // (a list as a type, `{d: "0".."9"}`: what reads as one of its values, that value)
      {written} => (.).one_written(`{written}`)
    }
  }
  one_written (text) => {
    at := .head
    while at && !(at.value == text) {
      at = at.next
    }
    at ? at.value : None
  }
  spreading => {
    .spread := true
    .
  }
  gathered => {
    .spread := false
    .
  }
  linked (value) => {
    {
      value := value
      next := None
      previous := None
    }
  }
  append (value) => {
    link := Ray.linked(value)
    if .tail {
      link.previous := .tail
      .tail.next := link
    } else {
      .head := link
    }
    .tail := link
    .
  }
  prepend (value) => {
    link := Ray.linked(value)
    if .head {
      .head.previous := link
      link.next := .head
    } else {
      .tail := link
    }
    .head := link
    .
  }
  // (`xs[n]`, a number: its nth value, from 0)
  at (index) => {
    at := .head
    left := index
    while at && left > 0 {
      at = at.next
      left = left - 1
    }
    at ? at.value : None
  }
  // (`xs[n] = v`: its nth value made v, from 0; past its end, nothing)
  placed (index, value) => {
    at := .head
    left := index
    while at && left > 0 {
      at = at.next
      left = left - 1
    }
    (at.value = value) if at
    value
  }
  for (body) => {
    at := .head
    while at {
      body(at.value)
      at = at.next
    }
    .
  }
  first => .head ? .head.value : None
  last => .tail ? .tail.value : None
  empty => .head ? false : true
  count => {
    counted := 0
    .for((x) => (counted = counted + 1))
    counted
  }
  rest => {
    made := Ray.new
    at := .head ? .head.next : None
    while at {
      made.append(at.value)
      at = at.next
    }
    made
  }
  take () => {
    first := .head
    .head := first ? first.next : None
    .tail := .head ? .tail : None
    first ? first.value : None
  }
  find (predicate) => {
    at := .head
    while at {
      return at.value if predicate(at.value)
      at = at.next
    }
    None
  }
  // (the vertex holding this very value, `===`)
  holding_itself (value) => {
    at := .head
    while at && !(at.value === value) {
      at = at.next
    }
    at
  }
  some (predicate) => (.find(predicate) === None) ? false : true
  every (predicate) => !(.some((x) => !predicate(x)))
  map (mapping) => {
    made := Ray.new
    .for((x) => made.append(mapping(x)))
    made
  }
  without (value) => {
    made := Ray.new
    .for((x) => (made.append(x) unless x === value))
    made
  }
  listed () => .map((x) => x)
  joined (other) => {
    joining := .
    if other.listing { other.listed().for((x) => joining.append(x)) } else { .append(other) }
    .
  }
  flatten => .flattened(64)
  flattened (levels) => {
    made := Ray.new
    .for((it) => (((it.listing === true) && (levels > 0)) ? it.flattened(levels - 1).for((x) => made.append(x)) : made.append(it)))
    made
  }
  // (`xs{p}`: the values p holds for, `.` each one in it)
  {this}{`{`}{constraint}{`}`} => {
    kept := Ray.new
    .for((it) => (kept.append(it) if (it with {constraint})))
    kept
  }
}
// Lists, read without numbers or `==`: what a method with parameters does to what it is read on, and closures given to them
assert ["a"].first  // LS1 a list of one has no first (`.head :=` in `append (value) =>` declared in its own node)
assert !(["a"].empty)  // LS2 a list of one is empty
assert ["a", "b"].last  // LS3 a list of two has no last
assert ["a", "b"].map((x) => x).last  // LS4 a mapped list has no last
assert [1].joined([2, 3]).count == 3  // LS6 a list joined with two is not three (`.` in the closure `joined` gives `for` is the closure's argument; or a method's locals were its receiver's, each call the same)
assert {
  seen := false
  ["a"].for((x) => {
    seen = true
  })
  assert seen  // LS5 a closure given to for does not see where it was written, or its `=` does not change the name there
}
assert {
  kept := true
  shadowing := () => {
    kept := false
  }
  shadowing()
  assert kept  // CL18 := in a closure changed the name where the closure was written
}
assert {
  ran := 0
  running := (x) => (ran = ran + 1)
  running.named_argument
  assert ran == 0  // CL19 a member read on a closure called it
}
assert {
  Writer := class {
    via (f) => f(1)
    inner () => .via((x) => this)
  }
  writer := Writer()
  assert writer.inner() === writer  // CL20 `this` in a closure written in a method is not what the method was read on
}
assert {
  outer_kept := 1
  Shadowing := class {
    own => {
      outer_kept := 2
      outer_kept
    }
  }
  assert Shadowing().own == 2  // LK2 a method's own name answered the one visible where the method is written (its body read before it ran)
  assert outer_kept == 1  // LK3 a method's own name changed the one visible where it is written
}
assert {
  gone := true
  while gone {
    gone = false
  }
  assert !gone  // CC14 while does not ask its condition again after its body (what its holes took was kept)
}
assert {
  ["Probed"].for((name) => {
    global[name] := true
  })
  assert Probed  // IX4 global[name] := in a closure does not declare the name the text holds
}
assert {
  defaulted := (given = None) => given
  defaulted()
  assert !(None)  // BN4 a parameter's default `= None` made None a name of its own (the value read as a left side)
  assert ["a"].first  // BN5 a parameter's default `= None` changed what None is for lists
}
assert Ray.super.count  // C8 Ray.super does not reach Iterable's count
Array := class: Iterable { }
assert 1 is Array  // TY63 a number is not an array
// (a text is its characters: the first, then the rest (`first`, `rest`, by the kernel's map for what it holds); none, empty)
String := class: Array {
  empty => !first
  textual := true
}
assert "ab" is String  // TX1 a text is not a String (the kernel's map, `wasm.o.ray`, says it is)
assert !("ab".empty)  // TX2 a text of two characters is empty
assert "ab".rest.first  // TX3 a text of two has no second character
assert "a".rest.empty  // TX4 the rest of a text of one is not empty
assert !("".first)  // TX5 an empty text has a first character
assert 1 + 2 as String == "3"  // PR38 as does not bind looser than plus
assert ("A", "A") is ...String  // SD3 ...T is not T[]
Number := class { }
assert 5 is Number  // TY5 five is not a Number
// Narrowings ask the constraint as well as what they narrow
assert {
  Small := Number{. < 5}
  Tiny := Small{. < 2}
  Even := Number{. % 2 == 0}
  assert 3 is Small  // TY16 three is not one of the small
  assert !(7 is Small)  // TY17 seven is one of the small
  assert 1 is Tiny  // TY19 one is not tiny
  assert !(3 is Tiny)  // TY20 three is tiny
  assert !(7 is Tiny)  // TY25 seven is tiny
  assert Tiny.admits(1)  // TY26 the tiny do not admit one
  assert !(Tiny.admits(3))  // TY27 the tiny admit three
  assert 4 is Small & Even  // TY65 four is not both small and even
  assert !(3 is Small & Even)  // TY66 three is both small and even
  assert !(6 is Small & Even)  // TY67 six is both small and even
}
assert 3 is Number  // TY18 three is not a number
// Calling a narrowed type chooses a value of it.
assert (Number{. > 5}()) > 5  // CN1 a value chosen from a narrowing does not satisfy it
// `boolean`: what `false` and `true` are (`false | true`).
boolean := false | true
assert {
  maybe: boolean? = None
  assert maybe ?? true  // BN3 ?? does not fall back on an optional left empty
}
// `#` is what a value may be (A1, T2.3)
assert boolean#.count == 2  // HS1 boolean does not have two possible values
assert boolean{. == true}() == true  // CN2 the only member a narrowing admits is not the one chosen
assert (3 boolean).count == 3  // CN5 three called on boolean is not three of it
false &+= {
  of := boolean
  assert {
    Side := enum near (of: "here") | far (of: "there") {}
    assert Side.near == Side.near  // HO3 a member is not itself
    assert !(Side.near == Side.far)  // HO4 two members of one enum are the same
    assert Side.near.of == "here"  // HO5 what a member holds is not what it was written as
    assert !(Side.near.of == "there")  // HO6 a member holds what the other one does
  }
}
true &+= {
  of := boolean
}
Char := class: Number { }
Program := class { }
Narrowing := class { }
Diagnostic := class { }
assert {
  fired := 0
  unless false { fired += 1 }
  unless 1 == 2 { fired += 1 }
  unless None { fired += 1 }
  assert fired == 3  // HO1 unless does not take the block when the condition does not hold
}
// A map's own key wins over Node's member (T8.7, T2.8)
assert ({ count: 3 }).(
  .count == 3  // FWO1 a map's own count does not win over Node's
  & (. as Object).count == 3  // FWO3 a value without Node does not read its own key
)

// A theme: what each style is shown as (`^style = ^shown`: another style, or a colour, `^ #F2F0FF`), in the order written; the
// one made last, `Theme.current`, the one shown.
Theme := {
  current := None
}
theme {name} {written} ^keyword => {
  // (its own node: what it declares is not declared where it is read)
  {
    made := {
      name := name
      styles := Ray.new
    }
    // (each one written: what it took, the style and what it is shown as)
    made &+= {
      ^{style} = ^{shown} => styles.append(external &)
      ^{style} = ^ {shown} => styles.append(external &)
      {written}
    }
    Theme.current = made
  }
  Theme.current
}

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^U2
  ^type = ^U2
  ^class = ^U2
  ^enum = ^U2
  ^interface = ^U2
  ^struct = ^U2
  ^event = ^U2
  ^enumMember = ^U2
  ^typeParameter = ^U0
  ^parameter = ^U0
  ^variable = ^U1
  ^property = ^U1
  ^function = ^U4
  ^method = ^U4
  ^decorator = ^U4
  ^macro = ^U2
  ^keyword = ^U3
  ^modifier = ^U3
  ^comment = ^U3
  ^string = ^D2
  ^number = ^D2
  ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment

  // A test, `assert`, as what it found (failed, passed, not run); what is written after it in its own colours, muted: taken this
  // much toward this.
  ^failed = ^error
  ^passed = ^debug
  ^untested = ^comment
  ^muted = ^comment
  ^muting = ^ 50%
}

// (a comment after a statement, defined again last: what is declared last binds loosest, so it is read before anything else)
{statement} // {comment} ^comment => {statement}

// Files: `include` one in what this is where it is written (the language's own, in the language), `read` one in a scope of
// its own. A location, `@./*.ray`, is beside the file it is written in; `given` is what the host was given. The language's
// own project first, its `.project.ray` before the rest; then what it was given.
include {location} ^keyword => external include {location}
read {location} ^keyword => external read {location}
include @./.project.ray
read given
include @./Number.ray
