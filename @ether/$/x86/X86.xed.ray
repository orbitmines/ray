}
X86.XedFunction := class (instructions: X86.XedInstruction[]{(!.empty) && .last.ends}) {
  static from (bytes) => X86.XedFunction.bits_read(bytes.map((byte) => byte.binary(8).reversed).join(""))
  written => .binary.pieces(8).map((eight) => eight.reversed.unsigned)
  assembly =>
    made := []
    at := 0
    step := instructions.head
    while step {
      at = at + (step.value.binary.count / 8)
      made.append(step.value.operation.assembly_after(at))
      step = step.next
    }
    made
}
