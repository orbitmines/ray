// ---------------------------------------------------------------- memory: what the reader keeps, laid out as records
// The root record sits at the first address of memory.

Root := { choices, choosing, natives, external, theme_stack, building, themes, theme, definitions, diagnostics, silent, refused, trying, declared, global, stamp, visits, forced, naming, order, rule_stamps, named, written, written_keys, written_version, brackets, bracket_version, openers, closers, closer_chars, homes, homes_version, empty, checking, held_texts, known, missing, filtered, area_saves, sides, sides_room, base, made, given_names, runs, name_index, free_lists, free_sets, running, depth, tries, trie_count }
List := { list_size, list_room, list_items, list_next }

boot () => (
  ROOT.name_index = map_new()
  ROOT.running = 0
  ROOT.sides = alloc(1024)
  ROOT.sides_room = 1024
  k := 0
  while k < 1024 {
    ROOT.sides[k] = NIL
    k = k + 1
  }
  ROOT.base = UNDEF
  ROOT.order = 0
  ROOT.diagnostics = list_new()
  ROOT.silent = 0
  ROOT.refused = 0
  ROOT.trying = 0
  ROOT.declared = 0
  ROOT.stamp = 0
  ROOT.visits = 0
  ROOT.forced = list_new()
  ROOT.naming = None
  ROOT.global = scope_of(NIL)
  ROOT.choices = alloc(4096 * Choice)
  ROOT.choosing = 0
  ROOT.theme_stack = list_new()
  ROOT.building = None
  ROOT.themes = map_new()
  ROOT.theme = UNDEF
  ROOT.definitions = list_new()
  ROOT.rule_stamps = 0
  ROOT.named = map_new()
  ROOT.written = map_new()
  ROOT.written_keys = list_new()
  ROOT.written_version = 0
  ROOT.brackets = list_new()
  ROOT.bracket_version = 0
  ROOT.openers = set_new()
  ROOT.closers = set_new()
  ROOT.closer_chars = set_new()
  ROOT.homes = None
  ROOT.homes_version = 0
  ROOT.empty = list_new()
  ROOT.checking = list_new()
  ROOT.held_texts = map_new()
  ROOT.known = UNDEF
  ROOT.missing = None
  ROOT.filtered = map_new()
  ROOT.area_saves = list_new()
  ROOT.made = UNDEF
  ROOT.given_names = set_new()
  ROOT.runs = alloc(512 * Run)
  ROOT.depth = 0
  ROOT.tries = map_new()
  ROOT.trie_count = 0
  return None
)

list_new () => (
  l := ROOT.free_lists
  if l != None {
    ROOT.free_lists = l.list_next
    l.list_size = 0
    return l
  }
  l = alloc(List)
  l.list_size = 0
  l.list_room = 8
  l.list_items = alloc(8)
  return l
)

list_free (l) => (
  l.list_next = ROOT.free_lists
  ROOT.free_lists = l
  return None
)

list_push (l, v) => (
  n := l.list_size
  if n == l.list_room {
    items := alloc(n * 2)
    k := 0
    while k < n {
      items[k] = l.list_items[k]
      k = k + 1
    }
    l.list_items = items
    l.list_room = n * 2
  }
  l.list_items[n] = v
  l.list_size = n + 1
  return None
)

list_len (l) => (
  return l.list_size
)

list_at (l, k) => (
  return l.list_items[k]
)

list_has (l, v) => (
  n := l.list_size
  k := 0
  while k < n {
    if l.list_items[k] == v { return global }
    k = k + 1
  }
  return None
)

// A set of values: open addressing over a power-of-two table; UNDEF marks a free slot.
Set := { set_size, set_room, set_keys, set_next }

set_new () => (
  s := ROOT.free_sets
  if s != None {
    ROOT.free_sets = s.set_next
  } else {
    s = alloc(Set)
    s.set_room = 16
    s.set_keys = alloc(16)
    s.set_size = -1
  }
  if s.set_size != 0 {
    k := 0
    n := s.set_room
    keys := s.set_keys
    while k < n {
      keys[k] = UNDEF
      k = k + 1
    }
    s.set_size = 0
  }
  return s
)

set_slot (keys, room, v) => (
  k := hash(v) % room
  while keys[k] != UNDEF and keys[k] != v { k = (k + 1) % room }
  return k
)

set_has (s, v) => (
  return s.set_keys[set_slot(s.set_keys, s.set_room, v)] == v
)

set_add (s, v) => (
  keys := s.set_keys
  room := s.set_room
  k := set_slot(keys, room, v)
  if keys[k] == v { return None }
  keys[k] = v
  s.set_size = s.set_size + 1
  if s.set_size * 2 > room {
    bigger := alloc(room * 2)
    j := 0
    while j < room * 2 {
      bigger[j] = UNDEF
      j = j + 1
    }
    j = 0
    while j < room {
      if keys[j] != UNDEF { bigger[set_slot(bigger, room * 2, keys[j])] = keys[j] }
      j = j + 1
    }
    s.set_keys = bigger
    s.set_room = room * 2
  }
  return None
)

// A map from a pair of values to a value: open addressing; UNDEF marks a free slot and what is not there.
Map := { map_size, map_room, map_firsts, map_seconds, map_values }

map_new () => (
  m := alloc(Map)
  m.map_room = 64
  m.map_firsts = alloc(64)
  m.map_seconds = alloc(64)
  m.map_values = alloc(64)
  map_clear(m)
  return m
)

map_clear (m) => (
  k := 0
  n := m.map_room
  firsts := m.map_firsts
  while k < n {
    firsts[k] = UNDEF
    k = k + 1
  }
  m.map_size = 0
  return None
)

map_slot (firsts, seconds, room, a, b) => (
  k := hash(a + hash(b)) % room
  while firsts[k] != UNDEF and (firsts[k] != a or seconds[k] != b) { k = (k + 1) % room }
  return k
)

map_get (m, a, b) => (
  k := map_slot(m.map_firsts, m.map_seconds, m.map_room, a, b)
  if m.map_firsts[k] == UNDEF { return UNDEF }
  return m.map_values[k]
)

map_put (m, a, b, v) => (
  firsts := m.map_firsts
  seconds := m.map_seconds
  room := m.map_room
  k := map_slot(firsts, seconds, room, a, b)
  if firsts[k] == UNDEF { m.map_size = m.map_size + 1 }
  firsts[k] = a
  seconds[k] = b
  m.map_values[k] = v
  if m.map_size * 2 > room {
    values := m.map_values
    m.map_room = room * 2
    m.map_firsts = alloc(room * 2)
    m.map_seconds = alloc(room * 2)
    m.map_values = alloc(room * 2)
    map_clear(m)
    j := 0
    while j < room {
      if firsts[j] != UNDEF { map_put(m, firsts[j], seconds[j], values[j]) }
      j = j + 1
    }
  }
  return None
)

// A path of values as one number, the same number for the same path.
trie (id, x) => (
  next := map_get(ROOT.tries, id, x)
  if next != UNDEF { return next }
  next = ROOT.trie_count + 1
  ROOT.trie_count = next
  map_put(ROOT.tries, id, x, next)
  return next
)

// What a rule captured: laid out once per rule, its first word counting how often the rule is being matched;
// then per piece the span it captured (-1 where it captured nothing). Matching a rule again inside its own match saves and restores it.
cap (rule, p, from, stop) => (
  area := rule.rule_area
  area[p * 2 + 1] = from
  area[p * 2 + 2] = stop
  return None
)

cap_empty (rule, p) => (
  area := rule.rule_area
  from := area[p * 2 + 1]
  return from != -1 and area[p * 2 + 2] <= from
)

cap_begin (rule, p) => (
  return rule.rule_area[p * 2 + 1]
)

cap_stop (rule, p) => (
  return rule.rule_area[p * 2 + 2]
)

// The last piece captured under a name.
cap_named (rule, name) => (
  area := rule.rule_area
  p := piece_count(rule)
  while p > 0 {
    p = p - 1
    if area[p * 2 + 1] != -1 and pkind(rule, p) == 2 and pname(rule, p) == name { return p }
  }
  return -1
)

cap_first (rule) => (
  area := rule.rule_area
  p := 0
  while p < piece_count(rule) {
    if area[p * 2 + 1] != -1 { return p }
    p = p + 1
  }
  return -1
)

// Rules being applied, innermost last: a fixed row of slots laid out once (applying never goes deeper than 400).
Run := { run_rule, run_receiving, run_receiver, run_src, run_begin, run_end, run_local }

run_at (k) => (
  return ROOT.runs + k * Run
)

run_push (rule, receiving, receiver, src, b, e) => (
  r := run_at(ROOT.running)
  ROOT.running = ROOT.running + 1
  r.run_rule = rule
  r.run_receiving = receiving
  r.run_receiver = receiver
  r.run_src = src
  r.run_begin = b
  r.run_end = e
  r.run_local = UNDEF
  return None
)

run_pop () => (
  ROOT.depth = ROOT.depth - 1
  ROOT.running = ROOT.running - 1
  return None
)

run_local (local) => (
  run_at(ROOT.running - 1).run_local = local
  return None
)

deepen (src, b, e) => (
  ROOT.depth = ROOT.depth + 1
  if ROOT.depth > 400 {
    ROOT.depth = 0
    recursion(src, b, e)
  }
  return None
)

// The rule being applied whose body or writing holds a span.
holding (src, b, e) => (
  k := ROOT.running
  while k > 0 {
    k = k - 1
    r := run_at(k)
    if rule_holds(r.run_rule, src, b, e) { return r }
  }
  return None
)

holding_local (src, b, e) => (
  r := holding(src, b, e)
  if r == None { return UNDEF }
  return r.run_local
)

self_of (src, j, frame) => (
  r := holding(src, j, j)
  if r != None and r.run_receiving { return r.run_receiver }
  if frame == global() or bare(frame) { return UNDEF }
  return frame
)

running_len () => (
  return ROOT.running
)

running_top () => (
  if ROOT.running == 0 { return None }
  return run_at(ROOT.running - 1)
)

min (a, b) => (
  if a < b { return a }
  return b
)

// ---------------------------------------------------------------- text: a source's characters and what is laid out once per source
// Character classes: 1 word, 2 space, 4 run (an operator character), 8 run between tokens.
Source := { source_chars, source_length, source_located, source_space, source_blank, source_spaced, source_word, source_run, source_claims, source_version, source_closes }

lay (chars, n, located) => (
  s := alloc(Source)
  s.source_chars = chars
  s.source_length = n
  s.source_located = located
  space := alloc(n + 1)
  blank := alloc(n + 1)
  spaced := alloc(n + 1)
  word := alloc(n + 1)
  run := alloc(n + 1)
  space[n] = None
  blank[n] = n
  spaced[n] = n
  word[n] = n
  run[n] = n
  chars[n] = 0
  j := n - 1
  while j >= 0 {
    c := chars[j]
    kind := CLASSES[c]
    if has(kind, 2) {
      space[j] = global
      blank[j] = blank[j + 1]
    } else {
      space[j] = None
      blank[j] = j
    }
    if c == ' ' or c == '\t' { spaced[j] = spaced[j + 1] } else { spaced[j] = j }
    if has(kind, 1) or (c == '-' and j + 1 < n and has(CLASSES[chars[j + 1]], 1)) { word[j] = word[j + 1] } else { word[j] = j }
    if has(kind, 8) { run[j] = run[j + 1] } else { run[j] = j }
    j = j - 1
  }
  s.source_space = space
  s.source_blank = blank
  s.source_spaced = spaced
  s.source_word = word
  s.source_run = run
  s.source_claims = alloc(n + 1)
  s.source_version = -1
  closes := alloc(n + 1)
  j = 0
  while j <= n {
    closes[j] = -2
    j = j + 1
  }
  s.source_closes = closes
  return s
)

is_word (c) => (
  return has(CLASSES[c], 1)
)

is_run (c) => (
  return has(CLASSES[c], 4)
)

spaces (src, j, limit) => (
  if j >= limit { return j }
  return min(src.source_spaced[j], limit)
)

token_end (src, j, limit) => (
  if j >= limit { return j }
  return min(src.source_word[j], limit)
)

token (src, j, limit) => (
  if j >= limit { return j }
  s := src
  if is_word(s.source_chars[j]) { return min(s.source_word[j], limit) }
  return min(s.source_run[j], limit)
)

unspaced (src, j, limit) => (
  space := src.source_space
  while j < limit and !space[j] { j = j + 1 }
  return j
)

name_end (src, j, limit) => (
  s := src
  while j < limit and !s.source_space[j] and !closes_with(s.source_chars[j]) { j = j + 1 }
  return j
)

blank_at (src, j) => (
  return src.source_blank[j]
)

space (src, j) => (
  s := src
  return j >= 0 and j < s.source_length and s.source_space[j]
)

newline (src, j) => (
  s := src
  return j >= 0 and j < s.source_length and s.source_chars[j] == '\n'
)

run (src, j) => (
  s := src
  return j >= 0 and j < s.source_length and is_run(s.source_chars[j])
)

word (src, j) => (
  s := src
  return j >= 0 and j < s.source_length and is_word(s.source_chars[j])
)

starts (src, j, lit) => (
  s := src
  n := lit.name_length
  if j < 0 or j + n > s.source_length { return None }
  chars := s.source_chars
  k := 0
  while k < n {
    if chars[j + k] != lit_char(lit, k) { return None }
    k = k + 1
  }
  return global
)

// A literal is spelled where the text starts with it and it does not run on into a word or an operator on either side.
spelled (src, at, lit, joined, followed, limit) => (
  n := lit.name_length
  if at + n > limit or !starts(src, at, lit) { return None }
  if n == 0 { return global }
  chars := src.source_chars
  length := src.source_length
  first := lit_char(lit, 0)
  last := lit_char(lit, n - 1)
  if is_word(first) and at > 0 and is_word(chars[at - 1]) { return None }
  if !followed and is_word(last) and at + n < length and is_word(chars[at + n]) { return None }
  if !joined and is_run(first) and at > 0 and is_run(chars[at - 1]) { return None }
  if !followed and is_run(last) and at + n < length and is_run(chars[at + n]) { return None }
  return global
)

opening (c) => (
  return c == '{' or c == '(' or c == '['
)

closing (c) => (
  return c == '}' or c == ')' or c == ']'
)

group_end (src, j, end) => (
  s := src
  chars := s.source_chars
  if j >= s.source_length or !opening(chars[j]) { return j }
  close := s.source_closes[j]
  if close == -2 {
    close = -1
    depth := 0
    k := j
    n := s.source_length
    while k < n {
      c := chars[k]
      if c == '`' {
        q := k + 1
        while q < n and chars[q] != '`' { q = q + 1 }
        if q >= n { goto scanned }
        k = q
      } elsif opening(c) {
        depth = depth + 1
      } elsif closing(c) {
        depth = depth - 1
        if depth == 0 {
          close = k + 1
          goto scanned
        }
      }
      k = k + 1
    }
    scanned\
    s.source_closes[j] = close
  }
  if close >= 0 and close <= end { return close }
  return j
)

// ---------------------------------------------------------------- names: every spelling the reader keeps, once; a name is its number
Name := { name_chars, name_length, name_next }

intern (chars, from, n) => (
  h := name_hash(chars, from, n)
  name := map_get(ROOT.name_index, h, n)
  first := name
  while name != UNDEF {
    other := name.name_chars
    k := 0
    while k < n and other[k] == chars[from + k] { k = k + 1 }
    if k == n { return name }
    name = name.name_next
  }
  name = alloc(Name)
  copy := alloc(n + 1)
  k = 0
  while k < n {
    copy[k] = chars[from + k]
    k = k + 1
  }
  name.name_chars = copy
  name.name_length = n
  name.name_next = first
  map_put(ROOT.name_index, h, n, name)
  return name
)

name_hash (chars, from, n) => (
  h := 7
  k := 0
  while k < n {
    h = (h * 31 + chars[from + k]) % 1000003
    k = k + 1
  }
  return h
)

// A name laid out before the kernel ran, taken into the index.
name_adopt (name) => (
  h := name_hash(name.name_chars, 0, name.name_length)
  name.name_next = map_get(ROOT.name_index, h, name.name_length)
  map_put(ROOT.name_index, h, name.name_length, name)
  return name
)

text_id (src, b, e) => (
  return intern(src.source_chars, b, e - b)
)


lit_char (lit, k) => (
  return lit.name_chars[k]
)

lit_starts_line (lit) => (
  name := lit
  return name.name_length > 0 and name.name_chars[0] == '\n'
)

lit_ends_line (lit) => (
  name := lit
  return name.name_length > 0 and name.name_chars[name.name_length - 1] == '\n'
)

// The k-th argument of n, or UNDEF when there are fewer.
arg (n, k, a) => (
  if k < n { return a }
  return UNDEF
)

// The reader, in the kernel language. Values are edges: ints for rules, sources, positions and handles; None and global for no and yes.

// ---------------------------------------------------------------- matching: a rule's pieces against the text from `pos`
// `receiving` is true when the rule is matched on a value (`receiver`).

// A match fills the rule's captures and answers where it ended (-1 when it did not match) and how much it spelled.
match (rule, src, pos, limit, frame, receiving, receiver) => (
  area_open(rule)
  end, reach := match_fresh(rule, src, pos, limit, frame, receiving, receiver) catch e {
    area_close(rule)
    rethrow(e)
  }
  area_close(rule)
  return end, reach
)


match_fresh (rule, src, pos, limit, frame, receiving, receiver) => (
  n := piece_count(rule)
  enclosed := rule.rule_enclosed
  i := pos
  reach := 0
  opened := 0
  p := 0
  while p < n {
    kind := pkind(rule, p)
    flags := pflags(rule, p)
    if kind == 0 {
      lit := plit(rule, p)
      after_line := p > 0 and pkind(rule, p - 1) == 0 and lit_ends_line(plit(rule, p - 1))
      from := spaces(src, i, limit)
      if has(flags, 1) and !after_line { from = i }
      if p == 0 and receiving and !rule.rule_defines and opener(lit) { from = i }
      joined := has(flags, 1) and p > 0 and from == i
      followed := p + 1 < n and pkind(rule, p + 1) == 2 and has(pflags(rule, p + 1), 1) and has(pflags(rule, p + 1), 4)
      if !spelled(src, from, lit, joined, followed, limit) { return -1, 0 }
      reach = reach + lit.name_length
      if opener(lit) { opened = opened + 1 } elsif opened > 0 and closer(lit) { opened = opened - 1 }
      i = from + lit.name_length
      p = p + 1
      goto next
    }
    if kind == 1 {
      j := spaces(src, i, limit)
      elided := p >= 2 and pkind(rule, p - 1) == 2 and pkind(rule, p - 2) == 1 and cap_empty(rule, p - 1)
      if j == i and i < limit and !space(src, i) and !elided { return -1, 0 }
      i = j
      p = p + 1
      goto next
    }
    if has(flags, 32) {
      e := operator_capture(rule, p, src, i, limit, frame, receiving, receiver)
      if e < 0 { return -1, 0 }
      i = e
      p = p + 1
      goto next
    }
    if p == 0 and receiving and !rule.rule_implicit {
      if 1 < n and has(pflags(rule, 1), 1) and space(src, i) { return -1, 0 }
      p = p + 1
      goto next
    }
    nkind := -1
    if p + 1 < n { nkind = pkind(rule, p + 1) }
    exact := has(flags, 2) and has(flags, 16) and nkind == 0
    from := spaces(src, i, limit)
    if exact { from = i }
    inside := enclosed or opened > 0
    beyond := -1
    if p > 0 and has(flags, 2) and nkind == 1 and p + 2 < n and pkind(rule, p + 2) == 0 { beyond = plit(rule, p + 2) }
    if beyond >= 0 {
      end := first(src, from, beyond, limit, has(flags, 2), inside)
      if end < 0 { return -1, 0 }
    } elsif nkind == 0 {
      if p == 0 { end = last(src, from, plit(rule, p + 1), limit, has(flags, 2), inside) } else { end = first(src, from, plit(rule, p + 1), limit, has(flags, 2), inside) }
      if end < 0 { return -1, 0 }
    } elsif has(flags, 2) {
      if receiving or nkind >= 0 { end = token_end(src, from, limit) } else { end = unspaced(src, from, limit) }
    } elsif nkind >= 0 or (p > 0 and pkind(rule, p - 1) == 1) {
      end = operand_end(src, from, limit)
    } else {
      claimed := from
      if has(flags, 1) and from == i { claimed = claim(src, from, limit) }
      if claimed > from { end = claimed } else { end = trailing_end(src, from, limit, frame, rule) }
    }
    stop := end
    if !exact {
      while stop > from and space(src, stop - 1) { stop = stop - 1 }
    }
    if stop <= from {
      if !has(flags, 8) and !enclosed and opened == 0 { return -1, 0 }
      cap(rule, p, from, stop)
      i = end
      p = p + 1
      goto next
    }
    if has(flags, 64) { flags = settle(rule, p) }
    if has(flags, 64) { return -1, 0 }
    if has(flags, 4) and holds(rule, p, src, from, stop - 1) == UNDEF {
      if nkind >= 0 { return -1, 0 }
      shorter := held_within(rule, p, src, from, stop, limit, frame)
      if shorter < 0 { return -1, 0 }
      cap(rule, p, from, shorter)
      i = shorter
      p = p + 1
      goto next
    }
    cap(rule, p, from, stop)
    i = end
    p = p + 1
    next\
  }
  if i == pos { return -1, 0 }
  if !fits(rule, src, frame) { return -1, 0 }
  return i, reach
)

first (src, from, lit, limit, raw, inside) => (
  j := from
  while j < limit {
    if spelled(src, j, lit, None, None, limit) { return j }
    if newline(src, j) and !inside and !lit_starts_line(lit) { return -1 }
    k := j
    if !raw { k = claim(src, j, limit) }
    if k > j { j = k } else { j = j + 1 }
  }
  return -1
)

last (src, from, lit, limit, raw, inside) => (
  found := -1
  j := from
  while j < limit {
    if spelled(src, j, lit, None, None, limit) { found = j }
    if newline(src, j) and !inside { return found }
    k := j
    if !raw { k = claim(src, j, limit) }
    if k > j { j = k } else { j = j + 1 }
  }
  return found
)

operand_end (src, j, limit) => (
  r := j
  while r < limit and run(src, r) { r = r + 1 }
  if r > j and (r >= limit or space(src, r)) { return j }
  while j < limit and !space(src, j) {
    k := claim(src, j, limit)
    if k > j { j = k } else { j = j + 1 }
  }
  return j
)

trailing_end (src, j, limit, frame, rule) => (
  spellings := looser(frame, rule)
  count := list_len(spellings)
  while j < limit and !newline(src, j) {
    s := 0
    while s < count {
      spelling := list_at(spellings, s)
      if spelled(src, j, spelling, None, None, limit) and ((j > 0 and space(src, j - 1)) or space(src, j + spelling.name_length)) {
        k := j
        while k > 0 and space(src, k - 1) { k = k - 1 }
        list_free(spellings)
        return k
      }
      s = s + 1
    }
    k = claim(src, j, limit)
    if k > j { j = k } else { j = j + 1 }
  }
  list_free(spellings)
  return j
)

claim (src, j, limit) => (
  s := src
  claims := s.source_claims
  if s.source_version != brackets_version() {
    k := 0
    while k <= s.source_length {
      claims[k] = -1
      k = k + 1
    }
    s.source_version = brackets_version()
  }
  known := claims[j]
  if known >= 0 and known <= limit { return known }
  claims[j] = j
  end := j
  count := brackets()
  k := 0
  while k < count {
    rule := bracket(k)
    if starts(src, j, plit(rule, 0)) {
      e, reach := match(rule, src, j, limit, global(), None, None)
      if e > end { end = e }
    }
    k = k + 1
  }
  claims[j] = end
  return end
)

// ---------------------------------------------------------------- candidates: every rule in reach, met through the head index, the longest reading wins
// A segment is a walk (0: the scopes in reach of a frame, 1: the rules on a value and on the base), a root and filter bits:
// 1 heads, 2 afters, 4 leading, 8 mine, 16 owned, 32 home, 64 own, 128 label, 256 split.

// The best reading here: the rule, where it ends and how much it spells (None when nothing reads).
// The search is kept in a slot of a fixed row, one per search under way, filled by walking the rules in reach.
// A segment is a walk (0: the scopes in reach of a frame, 1: the rules on a value and on the base), a root and filter bits:
// 1 heads, 2 afters, 4 leading, 8 mine, 16 owned, 32 home, 64 own, 128 label, 256 split.
Choice := { c_src, c_pos, c_after, c_limit, c_frame, c_receiving, c_receiver, c_filter, c_target, c_best, c_end, c_reach, c_spelled, c_mine, c_mine_end, c_mine_reach, c_mine_spelled }

best_in (src, pos, limit, frame, receiving, receiver, w1, r1, f1, w2, r2, f2, target) => (
  c := ROOT.choices + ROOT.choosing * Choice
  ROOT.choosing = ROOT.choosing + 1
  c.c_src = src
  c.c_pos = pos
  c.c_after = spaces(src, pos, limit)
  c.c_limit = limit
  c.c_frame = frame
  c.c_receiving = receiving
  c.c_receiver = receiver
  c.c_target = target
  c.c_best = None
  c.c_mine = None
  c.c_filter = f1
  choose(c, w1, r1) catch e {
    ROOT.choosing = ROOT.choosing - 1
    rethrow(e)
  }
  c.c_filter = f2
  choose(c, w2, r2) catch e {
    ROOT.choosing = ROOT.choosing - 1
    rethrow(e)
  }
  ROOT.choosing = ROOT.choosing - 1
  if w1 >= 0 and has(f1, 256) and c.c_mine != None { return c.c_mine, c.c_mine_end, c.c_mine_reach }
  return c.c_best, c.c_end, c.c_reach
)

choose (c, walk, root) => (
  if walk < 0 { return None }
  seen := stamp()
  choose_from(c, walk, root, seen)
  if walk == 1 and base() != -1 { choose_from(c, walk, base(), seen) }
  return None
)

// Walk 0 goes from a scope to what it sees, then to its parent; walk 1 from a value to what it was made with.
choose_from (c, walk, at, seen) => (
  if walk == 0 {
    if at == -1 or marked(at, seen) { return None }
  } elsif marked(at, seen) or at == global() { return None }
  mark(at, seen)
  if has_rules(at) { choose_rules(c, at) }
  if walk == 1 {
    k := 0
    while k < with_len(at) {
      choose_from(c, walk, with_at(at, k), seen)
      k = k + 1
    }
    return None
  }
  k = 0
  while k < sees_len(at) {
    choose_from(c, walk, sees_at(at, k), seen)
    k = k + 1
  }
  return choose_from(c, walk, parent(at), seen)
)

// A scope's rules met through its head index: those read with no head, and those whose head starts here or after the spaces here; latest first.
choose_rules (c, at) => (
  open := heads_open(at, c.c_receiving)
  by := heads_by(at, c.c_receiving, c.c_src, c.c_pos)
  later := by
  if c.c_after != c.c_pos { later = heads_by(at, c.c_receiving, c.c_src, c.c_after) }
  a := 0
  b := 0
  d := 0
  na := list_len(open)
  nb := list_len(by)
  nd := list_len(later)
  if c.c_after == c.c_pos { nd = 0 }
  while a < na or b < nb or d < nd {
    x := -1
    y := -1
    z := -1
    if a < na { x = list_at(open, a) }
    if b < nb { y = list_at(by, b) }
    if d < nd { z = list_at(later, d) }
    r := max(x, max(y, z))
    if x == r { a = a + 1 }
    if y == r { b = b + 1 }
    if z == r { d = d + 1 }
    rule := side_rule(at, r)
    if admits(rule, c.c_filter, c.c_target) { consider(c, rule) }
  }
  return None
)

consider (c, rule) => (
  src := c.c_src
  pos := c.c_pos
  if rule_covers(rule, src, pos) { return None }
  head := rule_head(rule, c.c_receiving)
  if head >= 0 and !starts(src, pos, head) and !starts(src, c.c_after, head) { return None }
  end, reach := match(rule, src, pos, c.c_limit, c.c_frame, c.c_receiving, c.c_receiver)
  if end < 0 { return None }
  spelled := 0
  if c.c_receiving {
    first := 0
    if rule.rule_leading { first = 1 }
    if first < piece_count(rule) and pkind(rule, first) == 0 { spelled = 1 }
  }
  if c.c_best == None or better(rule, end, reach, spelled, c.c_best, c.c_end, c.c_reach, c.c_spelled) {
    c.c_best = rule
    c.c_end = end
    c.c_reach = reach
    c.c_spelled = spelled
  }
  if has(c.c_filter, 256) and !rule_based(rule) and rule.rule_home != global() and (c.c_mine == None or better(rule, end, reach, spelled, c.c_mine, c.c_mine_end, c.c_mine_reach, c.c_mine_spelled)) {
    c.c_mine = rule
    c.c_mine_end = end
    c.c_mine_reach = reach
    c.c_mine_spelled = spelled
  }
  return None
)



char_at (src, j) => (
  s := src
  if j < 0 or j >= s.source_length { return -1 }
  return s.source_chars[j]
)


admits (rule, filter, target) => (
  if has(filter, 1) and !(((!rule.rule_leading or rule_reads(rule)) and rule.rule_home == global()) or rule.rule_defines) { return None }
  if has(filter, 2) and !(!rule.rule_leading and rule.rule_home == global()) { return None }
  if has(filter, 4) and !(rule.rule_leading and !rule.rule_implicit) { return None }
  if has(filter, 16) and !((rule_p0(rule) != 1 and !rule.rule_implicit) or (has(filter, 32) and rule.rule_home == target)) { return None }
  if has(filter, 64) and !(!rule.rule_leading and !(rule_p0(rule) == 0 and opener(plit(rule, 0)))) { return None }
  if has(filter, 128) and !rule_label(rule) { return None }
  if has(filter, 8) and !(!rule_based(rule) and rule.rule_home != global()) { return None }
  return global
)

better (rule, end, reach, spelled, best, best_end, best_reach, best_spelled) => (
  if spelled != best_spelled { return spelled > best_spelled }
  if end != best_end { return end > best_end }
  if rule.rule_defines != best.rule_defines { return rule.rule_defines }
  return reach > best_reach
)

// ---------------------------------------------------------------- statements: read one after another; a jump lands on its label
// `read` takes the span [begin, end]. What reads nothing answers UNDEF; a step that ends the statement answers BREAK.

read (src, begin, end, frame) => (
  return read_on(src, begin, end + 1, frame, begin, forced_len(), UNDEF)
)

read_on (src, pos, limit, frame, begin, mark, last) => (
  while global {
    if pos < limit { pos = min(blank_at(src, pos), limit) }
    if pos >= limit {
      if running_len() == 0 { forced_cut(mark) }
      return last
    }
    start := pos
    value, pos := statement(src, pos, limit, frame, UNDEF) catch e {
      if !is_jump(e) { rethrow(e) }
      to := label_at(src, limit, begin, jump_label(e), frame)
      if to < 0 {
        if jump_value(e) == UNDEF { jump_set(e, held(last, UNDEF)) }
        rethrow(e)
      }
      if jump_value(e) != UNDEF { last = jump_value(e) }
      forget(e)
      if to < start { unforce(mark) }
      pos = to
      goto again
    }
    if value != UNDEF { last = value }
    if pos == start { pos = start + 1 }
    again\
  }
)

// A statement answers its value and where reading goes on.
statement (src, pos, limit, frame, from) => (
  value := from
  while pos < limit {
    if value == UNDEF { step, pos := first_step(src, pos, limit, frame) } else { step, pos := next_step(src, pos, limit, frame, value) }
    if step == BREAK { return value, pos }
    value = step
  }
  return value, pos
)

// The first step reads a statement's head: a rule in reach, a name, the whole word up to a bracket, or a rule of the value this code runs on.
first_step (src, pos, limit, frame) => (
  start := spaces(src, pos, limit)
  if start >= limit or newline(src, start) { return BREAK, start }
  found, found_end, found_reach := best_in(src, start, limit, frame, None, None, 0, frame, 1, -1, -1, -1, -1)
  name := token(src, start, limit)
  named := None
  named_end := 0
  named_reach := 0
  place := UNDEF
  if name > start {
    place = place_of(frame, src, start, name)
    trying(1)
    target := target_of(place) catch e {
      trying(-1)
      rethrow(e)
    }
    named, named_end, named_reach := best_target(target, frame, src, name, limit, place, 0, None) catch e {
      trying(-1)
      rethrow(e)
    }
    trying(-1)
  }
  head := start
  while head < limit and !space(src, head) and claim(src, head, limit) == head { head = head + 1 }
  if head > name and name > start {
    whole := place_of(frame, src, start, head)
    trying(1)
    target = target_of(whole) catch e {
      trying(-1)
      rethrow(e)
    }
    defined, defined_end, defined_reach := best_target(target, frame, src, head, limit, whole, 0, None) catch e {
      trying(-1)
      rethrow(e)
    }
    trying(-1)
    if defined != None and defined.rule_defines {
      place = whole
      named = defined
      named_end = defined_end
      named_reach = defined_reach
      name = head
    }
  }
  self := self_of(src, start, frame)
  own := None
  own_end := 0
  if self != UNDEF { own, own_end, own_reach := best_target(target_of(self), frame, src, start, limit, self, 64, global) }
  spelled := name > start and !word(src, start) and !(named != None and named.rule_defines) and !(found != None and found.rule_defines)
  if spelled and own != None and rule_p0(own) == 0 { return fire(own, src, start, own_end, limit, frame, global, self), own_end }
  if spelled and found != None and rule_p0(found) == 0 { return fire(found, src, start, found_end, limit, frame, None, None), found_end }
  asks_own := own != None and place != UNDEF and rule_p0(own) == 0 and names(plit(own, 0), place)
  shadowed := asks_own and lookup_quietly(frame, place, global) != UNDEF
  reached := start
  if found != None { reached = found_end }
  named_to := name
  if named != None { named_to = named_end }
  if own != None and !shadowed and (own_end > max(reached, named_to) or (found != None and found == own and own_end == found_end and own_end > named_to)) { return fire(own, src, start, own_end, limit, frame, global, self), own_end }
  asks := place != UNDEF and found != None and found_end >= name and !(named != None and (named.rule_leading or named.rule_defines))
  unbound := asks and lookup_quietly(frame, place, None) == UNDEF
  if found != None and (unbound or name <= start or found_end > named_to or (named == None and found_end >= name) or (named != None and found_end == named_end and found_reach > named_reach) or (named != None and found.rule_defines and !named.rule_defines and found_end >= named_end)) { return fire(found, src, start, found_end, limit, frame, None, None), found_end }
  if place == UNDEF { return BREAK, start }
  return place, name
)

// A next step reads what follows a value: its arguments when it is a function, a rule on it, or a rule that reads after anything.
next_step (src, pos, limit, frame, value) => (
  reader := deref(value, None)
  if reader != UNDEF and fn_arity(reader) > 0 and !fn_raw(reader) and pos < limit and claim(src, pos, limit) > pos { return call(reader, src, pos, limit, frame) }
  if reader != UNDEF and fn_raw(reader) {
    at := spaces(src, pos, limit)
    if at < limit and !newline(src, at) { return call(reader, src, at, limit, frame) }
  }
  found, end, reach := best_target(target_of(value), frame, src, pos, limit, value, 0, global)
  if found != None { return fire(found, src, pos, end, limit, frame, global, value), end }
  at = spaces(src, pos, limit)
  if at >= limit or newline(src, at) { return BREAK, at }
  called := deref(value, global)
  if called != UNDEF and fn_arity(called) > 0 { return call(called, src, at, limit, frame) }
  after, end, reach := best_in(src, at, limit, frame, None, None, 0, frame, 2, -1, -1, -1, -1)
  if after != None {
    fire(after, src, at, end, limit, frame, None, None)
    return value, end
  }
  end = statement_end(src, at, limit)
  unexpected(src, at, end)
  return BREAK, end
)

best_target (target, frame, src, pos, limit, receiver, extra, split) => (
  flags := extra
  if split { flags = flags + 256 }
  key := target
  if target == UNDEF or target == global() { key = base() }
  if key == -1 { return best_in(src, pos, limit, frame, global, receiver, 0, frame, 4 + flags, -1, -1, -1, target) }
  home := 32
  if target != UNDEF and target != global() and rule_count(target) == 0 { home = 0 }
  return best_in(src, pos, limit, frame, global, receiver, 1, key, 16 + home + flags, 0, frame, 4 + flags, target)
)

label_at (src, limit, begin, label, frame) => (
  j := begin
  while j < limit {
    while j < limit and space(src, j) { j = j + 1 }
    if j >= limit { return -1 }
    silent(1)
    found, end, reach := best_in(src, j, limit, frame, None, None, 0, frame, 128, -1, -1, -1, -1) catch e {
      silent(-1)
      rethrow(e)
    }
    if found != None and rule_label(found) {
      match(found, src, j, limit, frame, None, None) catch e {
        silent(-1)
        rethrow(e)
      }
      silent(-1)
      if label_is(src, cap_begin(found, cap_first(found)), cap_stop(found, cap_first(found)), label) { return j }
    } else { silent(-1) }
    j = statement_end(src, j, limit)
    if newline(src, j) { j = j + 1 }
  }
  return -1
)

statement_end (src, j, limit) => (
  while j < limit and !newline(src, j) {
    k := claim(src, j, limit)
    if k > j { j = k } else { j = j + 1 }
  }
  return j
)

// ---------------------------------------------------------------- applying: a frame where the rule was written, holding what it was handed
// A span travels as three values: its source, its first position and its last.

// A rule fires where it was found: matched again to lay its captures out, then applied.
fire (rule, src, begin, end, limit, frame, receiving, receiver) => (
  area_open(rule)
  match_fresh(rule, src, begin, limit, frame, receiving, receiver) catch e {
    area_close(rule)
    rethrow(e)
  }
  r := apply(rule, receiving, receiver, global, frame, src, begin, end - 1, -1, None) catch e {
    area_close(rule)
    rethrow(e)
  }
  area_close(rule)
  return r
)

// `captured` says whether the rule's captures are laid out (it was matched); a rule applied by name captured nothing.
apply (rule, receiving, receiver, captured, frame, src, begin, end, given, given_value) => (
  deepen(src, begin, end)
  run_push(rule, receiving, receiver, src, begin, end)
  r := applying(rule, receiving, receiver, captured, frame, src, begin, end, given, given_value) catch e {
    run_pop()
    rethrow(e)
  }
  run_pop()
  return r
)

applying (rule, receiving, receiver, captured, frame, src, begin, end, given, given_value) => (
  if rule_native_get(rule) and receiving and is_place(receiver) and given == -1 {
    member := member_of(rule, src, receiver)
    if member != UNDEF { return member }
  }
  passes := rule_passes(rule)
  if passes >= 0 and !receiving and given == -1 {
    local := scope_in(rule.rule_closure, src, begin, end)
    body_from(local, rule)
    run_local(local)
    p := piece_named(rule, passes)
    q := -1
    if captured { q = cap_named(rule, passes) }
    held := None
    if q >= 0 and p >= 0 {
      if has(pflags(rule, p), 2) { held = literal(src, cap_begin(rule, q), cap_stop(rule, q) - 1) } else { held = code(src, cap_begin(rule, q), cap_stop(rule, q) - 1, frame) }
    }
    set_name(local, passes, held)
    passed := place_passes(local, rule)
    deref(held, None)
    return passed
  }
  local = scope_in(rule.rule_closure, src, begin, end)
  run_local(local)
  body_from(local, rule)
  if receiving {
    value := deref(receiver, None)
    if !is_place(receiver) and value != UNDEF and value != None { construct(value) }
    if is_place(receiver) {
      context := scope_at(receiver)
      stands(context, receiver)
      if value != UNDEF and value != None { with_one(context, value) }
      construct(context)
      on(local, context)
    } elsif value != UNDEF and value != None { on(local, value) }
  }
  count := 0
  a0 := UNDEF
  a1 := UNDEF
  a2 := UNDEF
  a3 := UNDEF
  n := piece_count(rule)
  p = 0
  while p < n {
    if pkind(rule, p) != 2 { goto next }
    name := pname(rule, p)
    value = None
    if given == name {
      value = given_value
    } elsif p == 0 and receiving and !rule.rule_implicit {
      value = receiver
    } else {
      q = -1
      if captured { q = cap_named(rule, name) }
      if q >= 0 {
        from := cap_begin(rule, q)
        last := cap_stop(rule, q) - 1
        if has(pflags(rule, p), 2) {
          value = literal(src, from, last)
        } else {
          value = UNDEF
          if has(pflags(rule, p), 4) { value = holds(rule, p, src, from, last) }
          if value == UNDEF { value = code(src, from, last, frame) }
        }
      }
    }
    set_name(local, name, value)
    if count == 0 { a0 = value } elsif count == 1 { a1 = value } elsif count == 2 { a2 = value } elsif count == 3 { a3 = value }
    count = count + 1
    next\
    p = p + 1
  }
  if rule.rule_fn != -1 { return invoke(rule.rule_fn, count, a0, a1, a2, a3, local, src, begin, end) }
  if !rule_has_body(rule) { return UNDEF }
  if rule_direct(rule) {
    n = direct_count(rule)
    a0 = UNDEF
    a1 = UNDEF
    a2 = UNDEF
    a3 = UNDEF
    if n > 0 { a0 = direct_place(rule, 0, local) }
    if n > 1 { a1 = direct_place(rule, 1, local) }
    if n > 2 { a2 = direct_place(rule, 2, local) }
    if n > 3 { a3 = direct_place(rule, 3, local) }
    return invoke(native_fn(rule.rule_native), n, a0, a1, a2, a3, local, rule.rule_body_src, rule.rule_body_end + 1, rule.rule_body_end)
  }
  bs, bb, be := rule_body(rule)
  r = read(bs, bb, be, local) catch e {
    if is_jump(e) and jump_within(e, rule) {
      if !jump_spelled(e) {
        v := jump_value(e)
        forget(e)
        return v
      }
      jump_resite(e, src, begin, end)
    }
    rethrow(e)
  }
  return r
)

// A function's arguments are read up to its arity; it answers its value and where reading goes on.
call (target, src, pos, limit, frame) => (
  arity := fn_arity(target)
  raw := fn_raw(target)
  a0 := UNDEF
  a1 := UNDEF
  a2 := UNDEF
  a3 := UNDEF
  k := 0
  while k < arity {
    from := spaces(src, pos, limit)
    if from >= limit or newline(src, from) { goto called }
    claimed := claim(src, from, limit)
    first_raw := raw and k == 0
    if first_raw { end := name_end(src, from, limit) } elsif claimed > from { end = claimed } else { end = operand_end(src, from, limit) }
    if !first_raw and end > from and identifier(src, from, end) {
      trying(1)
      held := lookup(frame, text_id(src, from, end), -1, 0, 0) catch e {
        trying(-1)
        rethrow(e)
      }
      trying(-1)
      if held != UNDEF and fn_raw(held) {
        after := spaces(src, end, limit)
        word_end := token(src, after, limit)
        if word_end > after { end = word_end }
      }
    }
    if end <= from { goto called }
    if first_raw { value := literal(src, from, end - 1) } else { value = code(src, from, end - 1, frame) }
    if k == 0 { a0 = value } elsif k == 1 { a1 = value } elsif k == 2 { a2 = value } elsif k == 3 { a3 = value }
    pos = end
    k = k + 1
  }
  called\
  r := invoke(fn_id(target), k, a0, a1, a2, a3, frame, src, pos, pos - 1)
  return r, pos
)

// ---------------------------------------------------------------- values: a name is a place, read where it is bound; written code is read once, when asked for
// Names travel as ids. A place to write a name from travels as a span (wsrc, wb, we); wsrc is -1 when there is none.

lookup (frame, name, wsrc, wb, we) => (
  if wsrc >= 0 and given_name(name) and !written_in(frame, name) {
    local := holding_local(wsrc, wb, we)
    if local != UNDEF {
      on := side_on(local)
      if on != UNDEF and given(on, name) and reaches(frame, local) { return own(on, name) }
    }
  }
  found, holder := lookup_walk(frame, name, wsrc, wb, we)
  return found
)

lookup_walk (frame, name, wsrc, wb, we) => (
  seen := visits()
  found, holder := seek(frame, None, global, name, wsrc, wb, we, seen)
  if found != UNDEF { return found, holder }
  found = own(global(), name)
  if found != UNDEF { return found, global() }
  g := global()
  n := with_len(g)
  k := 0
  while k < n {
    found, holder := seek(with_at(g, k), None, None, name, wsrc, wb, we, seen)
    if found != UNDEF { return found, holder }
    k = k + 1
  }
  if naming_takes(frame, name) { return naming_take(frame, name), frame }
  return UNDEF, None
)

seek (scope, lexical, deep, name, wsrc, wb, we, seen) => (
  pass := 0
  if deep { pass = stamp() }
  at := scope
  while at != -1 {
    if visited(at, seen) or at == global() {
      if !deep { return UNDEF, None }
      goto onward
    }
    visit(at, seen)
    found := own(at, name)
    if found != UNDEF and !(lexical and given(at, name)) { return found, at }
    shown := sees_shown(at, wsrc, wb, we)
    count := 0
    if shown { count = sees_len(at) }
    k := 0
    while k < count {
      other := sees_at(at, k)
      found = own(other, name)
      if found != UNDEF and !given(other, name) and !visited(other, seen) { return found, other }
      k = k + 1
    }
    on := side_on(at)
    if on != UNDEF {
      found, holder := seek(on, None, None, name, wsrc, wb, we, seen)
      if found != UNDEF { return found, holder }
    }
    k = 0
    while k < with_len(at) {
      found, holder := seek(with_at(at, k), None, None, name, wsrc, wb, we, seen)
      if found != UNDEF { return found, holder }
      k = k + 1
    }
    if !deep { return UNDEF, None }
    if count > 0 { mark(at, pass) }
    lexical = global
    onward\
    at = parent(at)
  }
  // Then, in the order they were met, what the scopes on the way see (marked above): read as written there.
  at = scope
  while at != -1 {
    if marked(at, pass) {
      k = 0
      while k < sees_len(at) {
        found, holder := seek(sees_at(at, k), global, global, name, wsrc, wb, we, seen)
        if found != UNDEF { return found, holder }
        k = k + 1
      }
    }
    at = parent(at)
  }
  return UNDEF, None
)

written_in (frame, name) => (
  if own(frame, name) != UNDEF and !given(frame, name) { return global }
  n := sees_len(frame)
  k := 0
  while k < n {
    other := sees_at(frame, k)
    if own(other, name) != UNDEF and !given(other, name) { return global }
    k = k + 1
  }
  return None
)

reaches (frame, target) => (
  return reaches_from(frame, target, stamp())
)

reaches_from (at, target, seen) => (
  if at == target { return global }
  if marked(at, seen) or at == global() { return None }
  mark(at, seen)
  k := 0
  while k < sees_len(at) {
    if reaches_from(sees_at(at, k), target, seen) { return global }
    k = k + 1
  }
  return parent(at) != -1 and reaches_from(parent(at), target, seen)
)

bound (node) => (
  if place_member(node) { return member(place_scope(node), place_name(node)) }
  return lookup(place_scope(node), place_name(node), at_src(node), at_begin(node), at_end(node))
)

deref (node, report) => (
  depth := 0
  while node != UNDEF and depth < 256 {
    if is_place(node) {
      found := bound(node)
      if found == UNDEF {
        if place_member(node) { return None }
        method := method_named(place_scope(node), place_name(node), node)
        if method != UNDEF { return method }
        missing_add(place_name(node))
        if report { unresolved(node) }
        return UNDEF
      }
      node = found
    } elsif is_code(node) and !is_program(node) {
      node = force(node)
    } else { return node }
    depth = depth + 1
  }
  return node
)

held (node, stands) => (
  depth := 0
  while node != UNDEF and depth < 256 {
    if node == stands { return node }
    if is_place(node) {
      found := bound(node)
      if found == UNDEF { return node }
      node = found
    } elsif is_code(node) and !is_program(node) {
      node = force(node)
    } else { return node }
    depth = depth + 1
  }
  return node
)

force (node) => (
  cached := code_value(node)
  if cached != UNDEF { return cached }
  value := read(at_src(node), at_begin(node), at_end(node), code_frame(node))
  if value != UNDEF { forced(node, value) }
  return value
)

member (of, name) => (
  return member_in(of, name, stamp())
)

member_in (node, name, seen) => (
  if marked(node, seen) { return UNDEF }
  mark(node, seen)
  found := own(node, name)
  if found != UNDEF { return found }
  k := 0
  while k < with_len(node) {
    found = member_in(with_at(node, k), name, seen)
    if found != UNDEF { return found }
    k = k + 1
  }
  return UNDEF
)

holder (frame, name, wsrc, wb, we) => (
  seen := visits()
  found := holder_in(frame, global, name, wsrc, wb, we, seen)
  if found != UNDEF or visited(global(), seen) { return found }
  visit(global(), seen)
  if own(global(), name) != UNDEF { return global() }
  g := global()
  k := 0
  while k < with_len(g) {
    found = holder_in(with_at(g, k), None, name, wsrc, wb, we, seen)
    if found != UNDEF { return found }
    k = k + 1
  }
  return UNDEF
)

holder_in (scope, deep, name, wsrc, wb, we, seen) => (
  pass := 0
  if deep { pass = stamp() }
  at := scope
  while at != -1 {
    if visited(at, seen) {
      if !deep { return UNDEF }
      goto onward
    }
    if at == global() { goto sought }
    visit(at, seen)
    if own(at, name) != UNDEF { return at }
    shown := sees_shown(at, wsrc, wb, we)
    count := 0
    if shown { count = sees_len(at) }
    k := 0
    while k < count {
      other := sees_at(at, k)
      if !visited(other, seen) and own(other, name) != UNDEF { return other }
      k = k + 1
    }
    on := side_on(at)
    if on != UNDEF {
      found := holder_in(on, None, name, wsrc, wb, we, seen)
      if found != UNDEF { return found }
    }
    k = 0
    while k < with_len(at) {
      found = holder_in(with_at(at, k), None, name, wsrc, wb, we, seen)
      if found != UNDEF { return found }
      k = k + 1
    }
    if !deep { return UNDEF }
    if count > 0 { mark(at, pass) }
    onward\
    at = parent(at)
  }
  sought\
  if !deep { return UNDEF }
  at = scope
  while at != -1 and at != global() {
    if marked(at, pass) {
      k = 0
      while k < sees_len(at) {
        found = holder_in(sees_at(at, k), global, name, wsrc, wb, we, seen)
        if found != UNDEF { return found }
        k = k + 1
      }
    }
    at = parent(at)
  }
  return UNDEF
)

near_holder (frame, name) => (
  if own(frame, name) != UNDEF { return frame }
  on := side_on(frame)
  if on != UNDEF and own(on, name) != UNDEF and given(on, name) { return on }
  n := with_len(frame)
  k := 0
  while k < n {
    made := with_at(frame, k)
    if own(made, name) != UNDEF and given(made, name) { return made }
    k = k + 1
  }
  return UNDEF
)

// Where a name is written: through code that only names something, through places bound to other places, through what a frame stands for.
location (node) => (
  at := node
  stood := None
  depth := 0
  while depth < 64 and at != UNDEF {
    depth = depth + 1
    if is_code(at) and !is_program(at) {
      if code_names(at) {
        at = place_of(code_frame(at), at_src(at), at_begin(at), at_end(at) + 1)
      } else {
        r := force(at)
        if r == UNDEF or (!is_place(r) and !is_code(r)) { return at }
        at = r
        stood = None
      }
      goto next
    }
    if !is_place(at) { return at }
    scope := place_scope(at)
    name := place_name(at)
    if place_member(at) { holder := scope } else { holder = near_holder(scope, name) }
    if holder != UNDEF and holder != scope and given(holder, name) and at_src(at) >= 0 {
      local := holding_local(at_src(at), at_begin(at), at_end(at))
      if local != UNDEF {
        on := side_on(local)
        if on != UNDEF and given(on, name) and reaches(scope, local) { holder = on }
      }
    }
    stands := UNDEF
    if holder != UNDEF { stands = side_stands(holder) }
    if stands != UNDEF and given(holder, name) {
      if stood { return at }
      stood = global
      at = stands
      goto next
    }
    held := UNDEF
    if holder != UNDEF { held = own(holder, name) }
    if held == UNDEF or (!is_place(held) and !is_code(held)) or is_program(held) { return at }
    if is_code(held) and code_value(held) != UNDEF and !is_place(code_value(held)) { return at }
    at = held
    next\
  }
  return at
)

declare (target, value, frame) => (
  at := location(target)
  if at == UNDEF or !is_place(at) {
    cannot_declare(target, at)
    return value
  }
  stands := UNDEF
  if frame != UNDEF { stands = side_stands(frame) }
  held := held(value, stands)
  if held == UNDEF { return UNDEF }
  scope := place_scope(at)
  if scope == None { return held }
  if scope == global() and own(scope, place_name(at)) == UNDEF { declared_more() }
  set_name(scope, place_name(at), held)
  return held
)

assign (target, value) => (
  at := location(target)
  held := deref(value, global)
  if held == UNDEF { return UNDEF }
  placed := at != UNDEF and is_place(at)
  self := UNDEF
  if placed and !place_member(at) { self = holder(place_scope(at), place_name(at), -1, 0, 0) }
  if !placed or (self != UNDEF and given(self, place_name(at)) and side_stands(self) == UNDEF) {
    into := deref(target, None)
    if into != UNDEF and themed(into, held) { return held }
    cannot_assign(target)
    return held
  }
  if place_member(at) {
    scope := deref(place_scope(at), global)
    if scope == UNDEF { scope = place_scope(at) }
  } else {
    scope = holder(place_scope(at), place_name(at), at_src(at), at_begin(at), at_end(at))
    if scope == UNDEF { scope = place_scope(at) }
  }
  if scope == None { return held }
  set_name(scope, place_name(at), held)
  return held
)

// What code stands for when it only names something: followed through names to the code or place they hold.
written (node) => (
  depth := 0
  while depth < 64 and node != UNDEF {
    depth = depth + 1
    if is_code(node) and !is_program(node) {
      word := code_word(node)
      held := UNDEF
      if word >= 0 { held = lookup(code_frame(node), word, -1, 0, 0) }
      if held == UNDEF or held == node or (!is_code(held) and !is_place(held)) { return node }
      node = held
    } elsif is_place(node) {
      held = lookup(place_scope(node), place_name(node), -1, 0, 0)
      if held == UNDEF { return node }
      node = held
    } else { return node }
  }
  return node
)

program_of (node) => (
  target := node
  depth := 0
  while depth < 64 and target != UNDEF {
    depth = depth + 1
    if is_program(target) { return target }
    if is_code(target) {
      word := code_word(target)
      if word >= 0 {
        held := lookup(code_frame(target), word, -1, 0, 0)
        if held != UNDEF and (is_program(held) or is_code(held) or is_place(held)) {
          target = held
          goto next
        }
      }
      return program_from(target)
    }
    if is_place(target) { target = bound(target) } else { return target }
    next\
  }
  return target
)

// Inlining reads code into a frame: the frame sees where the code was written; a value it holds becomes part of the frame.
inline (node, frame, compose) => (
  target := node
  depth := 0
  while depth < 64 and target != UNDEF {
    depth = depth + 1
    if is_code(target) and !is_program(target) {
      word := code_word(target)
      if word >= 0 {
        held := lookup(code_frame(target), word, -1, 0, 0)
        if held != UNDEF {
          target = held
          goto next
        }
        r := force(target)
        if r == UNDEF { return UNDEF }
        target = r
        goto next
      }
      if code_empty(target) { return UNDEF }
      sees_add(frame, code_frame(target))
      bs, bb, be := code_inner(target)
      last := read(bs, bb, be, frame)
      held = UNDEF
      if last != UNDEF { held = deref(last, None) }
      if held != UNDEF and is_program(held) and !compose { return inline(held, frame, None) }
      if compose and held != UNDEF and !is_text(held) and held != None and !is_code(held) and held != frame { with_push(frame, held) }
      return last
    }
    if is_place(target) {
      target = bound(target)
      goto next
    }
    if is_program(target) {
      sees_add(frame, code_frame(target))
      return read(at_src(target), at_begin(target), at_end(target), frame)
    }
    if is_text(target) {
      if compose or at_src(target) < 0 or at_end(target) < at_begin(target) { return target }
      return read(at_src(target), at_begin(target), at_end(target), frame)
    }
    if target != frame and target != None { with_add(frame, target) }
    return target
    next\
  }
  return target
)

method_named (frame, name, node) => (
  seen := stamp()
  rule := method_in(frame, name, seen)
  if rule == -1 { return UNDEF }
  return method_fn(rule, frame, node)
)

method_in (scope, name, seen) => (
  at := scope
  while at != -1 and !marked(at, seen) {
    mark(at, seen)
    rule := method_of(at, name)
    if rule != -1 { return rule }
    n := sees_len(at)
    k := 0
    while k < n {
      found := method_in(sees_at(at, k), name, seen)
      if found != -1 { return found }
      k = k + 1
    }
    at = parent(at)
  }
  return -1
)

// Members are the rules on a value spelled `name` or `name {x}`; 1: plain, 2: taking an argument.
// The rules on a value spelled `name` (plain) or `name {x}` (taking): the first plain one met, and 1 plain, 2 taking, 0 neither.
members (value, name) => (
  seen := stamp()
  plain, taking := members_visit(value, name, seen, -1, None)
  if base() != -1 { plain, taking := members_visit(base(), name, seen, plain, taking) }
  kind := 0
  if plain != -1 { kind = 1 } elsif taking { kind = 2 }
  return plain, kind
)

members_visit (node, name, seen, plain, taking) => (
  if marked(node, seen) or node == global() { return plain, taking }
  mark(node, seen)
  r := rule_count(node)
  while r > 0 {
    r = r - 1
    rule := side_rule(node, r)
    if piece_count(rule) >= 1 and piece_count(rule) <= 2 and pkind(rule, 0) == 0 and plit(rule, 0) == name {
      if piece_count(rule) == 1 {
        if plain == -1 { plain = rule }
      } elsif pkind(rule, 1) == 2 { taking = global }
    }
  }
  k := 0
  while k < with_len(node) {
    plain, taking := members_visit(with_at(node, k), name, seen, plain, taking)
    k = k + 1
  }
  return plain, taking
)

get (node, key) => (
  target := deref(node, global)
  if target == UNDEF { return UNDEF }
  name := text_of_node(key)
  if has_style(target) { return style_member(target, name) }
  plain, kind := members(target, name)
  if plain != -1 {
    receiver := location(node)
    if receiver == UNDEF { receiver = node }
    if at_src(key) >= 0 { return apply(plain, global, receiver, None, target, at_src(key), at_begin(key), at_end(key), -1, None) }
    return apply(plain, global, receiver, None, target, at_src(node), at_begin(node), at_end(node), -1, None)
  }
  if kind == 2 { unported("taking members") }
  return member_place(target, name, key)
)

member_of (rule, src, receiver) => (
  if !direct_this(rule) { return UNDEF }
  name := direct_property(rule)
  p := piece_named(rule, name)
  q := cap_named(rule, name)
  if p < 0 or !has(pflags(rule, p), 2) or q < 0 { return UNDEF }
  target := deref(receiver, global)
  if target == UNDEF or has_style(target) { return UNDEF }
  spelled := text_id(src, cap_begin(rule, q), cap_stop(rule, q))
  plain, kind := members(target, spelled)
  if kind != 0 { return UNDEF }
  return member_at(target, spelled, src, cap_begin(rule, q), cap_stop(rule, q) - 1)
)

// ---------------------------------------------------------------- typed captures: a capture's text is held when its type, read with the text bound, is not None

holds (rule, p, src, b, e) => (
  go, key, saved := holds_open(rule, p, src, b, e)
  if !go { return holds_known() }
  scope := scope_in(piece_within(rule, p), src, b, e)
  set_name(scope, pname(rule, p), literal(src, b, e))
  mark := refusals()
  cs, cb, ce := piece_content(rule, p)
  silent(1)
  value := read(cs, cb, ce, scope) catch err {
    if !is_recursion(err) {
      silent(-1)
      holds_close(rule, p, key, saved, UNDEF, None)
      rethrow(err)
    }
    recursion_error(err)
    value = UNDEF
  }
  silent(-1)
  failed := refusals() > mark or value == UNDEF
  if !failed {
    silent(1)
    held := deref(value, global) catch err {
      silent(-1)
      holds_close(rule, p, key, saved, UNDEF, None)
      rethrow(err)
    }
    silent(-1)
    failed = held == None
  }
  refusals_back(mark)
  if failed { value = UNDEF }
  holds_close(rule, p, key, saved, value, global)
  return value
)

held_within (rule, p, src, from, last, limit, frame) => (
  return held_from(rule, p, src, from, from, last, limit)
)

// The ends after j, all found first, then tried from the last: the longest prefix whose text is held.
held_from (rule, p, src, from, j, last, limit) => (
  if j >= last { return -1 }
  k := max(claim(src, j, limit), token(src, j, limit))
  if k > j { j = k } else { j = j + 1 }
  deeper := held_from(rule, p, src, from, j, last, limit)
  if deeper >= 0 { return deeper }
  if j < last and !space(src, j - 1) and holds(rule, p, src, from, j - 1) != UNDEF { return j }
  return -1
)

settle (rule, p) => (
  if undecided_now(rule, p) { decide(rule, p) }
  return pflags(rule, p)
)

decide (rule, p) => (
  if checking(rule, p) { return None }
  check(rule, p, global)
  cs, cb, ce := piece_content(rule, p)
  again := capture(cs, cb, ce, piece_within(rule, p)) catch err {
    check(rule, p, None)
    rethrow(err)
  }
  check(rule, p, None)
  decided(rule, p, again)
  return None
)

// A capture's content is read with nothing bound; the first name it asks for is the capture's name, what was bound to it its type.
capture (src, b, e, frame) => (
  plain := capture_plain(src, b, e)
  if plain != None { return plain }
  scope := scope_in(frame, src, b, e)
  hole := literal(src, b, e)
  state := naming_open(scope, hole, None, None)
  mark := refusals()
  silent(1)
  value := read(src, b, e, scope) catch err {
    if is_recursion(err) {
      recursion_error(err)
      silent(-1)
    } else {
      silent(-1)
      if !is_jump(err) {
        naming_close(state)
        rethrow(err)
      }
      forget(err)
    }
    value = UNDEF
  }
  silent(-1)
  naming_close(state)
  undecided := refusals() > mark
  refusals_back(mark)
  name := state.naming_name
  if name == -1 {
    held := UNDEF
    if value != UNDEF {
      silent(1)
      held = deref(value, global) catch err {
        silent(-1)
        naming_free(state)
        rethrow(err)
      }
      silent(-1)
    }
    naming_free(state)
    return capture_spelled(held, src, b, e)
  }
  naming_free(state)
  return capture_named(scope, name, hole, src, b, e, frame, undecided)
)

// A pattern's pieces: words are literals, `{x}` captures, `[x]` operator captures, `{{ … }}` a literal brace around inner pieces.
pieces (src, begin, end, frame) => (
  out := list_new()
  stop := end + 1
  j := begin
  run := j
  while j < stop {
    shut := operator_shut(src, j, stop)
    if shut >= 0 {
      words(out, src, run, j, begin)
      piece := capture(src, j + 1, shut - 1, frame)
      if piece_is_capture(piece) {
        piece_operator(piece)
        piece_add(out, piece, src, j, begin)
      } else { piece_drop(piece) }
      j = shut + 1
      run = j
      goto next
    }
    close := j
    if char_is(src, j, "{") { close = group_end(src, j, stop) }
    if close <= j {
      j = j + 1
      goto next
    }
    words(out, src, run, j, begin)
    from := j + 1
    to := close - 2
    while from <= to and space(src, from) { from = from + 1 }
    while to >= from and space(src, to) { to = to - 1 }
    if close - j == 2 {
      piece_add(out, piece_literal("{}"), src, j, begin)
    } elsif char_is(src, from, "{") and group_end(src, from, to + 1) == to + 1 {
      piece_add(out, piece_literal("{"), src, j, begin)
      inner := pieces(src, from, to, frame)
      pieces_append(out, inner)
      pieces_free(inner)
      pieces_push(out, piece_tight("}"))
    } else {
      piece = capture(src, j + 1, close - 2, frame)
      if piece_is_capture(piece) and j > begin and !space(src, j - 1) and pieces_last_literal(out) and close < stop and !space(src, close) { piece_exact(piece) }
      piece_add(out, piece, src, j, begin)
    }
    j = close
    run = close
    next\
  }
  words(out, src, run, stop, begin)
  return out
)

words (out, src, from, to, begin) => (
  j := from
  while j < to {
    while j < to and space(src, j) { j = j + 1 }
    if j >= to { return None }
    k := j
    while k < to and !space(src, k) { k = k + 1 }
    piece_add(out, piece_text(src, j, k), src, j, begin)
    j = k
  }
  return None
)

// ---------------------------------------------------------------- operator captures: `[op]` takes the longest operator spelled here, if its filter reads it as not None

operator_capture (rule, p, src, i, limit, frame, receiving, receiver) => (
  from := spaces(src, i, limit)
  op := operator_at(src, from, limit, frame, receiving, receiver)
  if op == -1 { return -1 }
  if piece_has_content(rule, p) and !operator_fits(rule, p, op) { return -1 }
  end := from + plit(op, 0).name_length
  cap(rule, p, from, end)
  return end
)

operator_at (src, j, limit, frame, receiving, receiver) => (
  if !run(src, j) { return -1 }
  best := -1
  if receiving {
    silent(1)
    held := deref(receiver, None) catch e {
      silent(-1)
      rethrow(e)
    }
    silent(-1)
    if held != UNDEF and held != None {
      seen := stamp()
      best = operators_on(held, src, j, best, seen)
      if base() != -1 { best = operators_on(base(), src, j, best, seen) }
    }
  }
  best = operators_of(frame, src, j, best, stamp())
  if base() != -1 { best = operators_on(base(), src, j, best, stamp()) }
  return best
)

// The longest operator spelled at j among a scope's operators, met from its latest rule on; an earlier one wins a tie.
longest_operator (node, src, j, best) => (
  r := kind_count(node, 1)
  while r > 0 {
    r = r - 1
    rule := kind_rule(node, 1, r)
    if starts(src, j, plit(rule, 0)) and (best == -1 or plit(rule, 0).name_length > plit(best, 0).name_length) { best = rule }
  }
  return best
)

operators_of (at, src, j, best, seen) => (
  if at == -1 or marked(at, seen) { return best }
  mark(at, seen)
  best = longest_operator(at, src, j, best)
  k := 0
  while k < sees_len(at) {
    best = operators_of(sees_at(at, k), src, j, best, seen)
    k = k + 1
  }
  return operators_of(parent(at), src, j, best, seen)
)

operators_on (node, src, j, best, seen) => (
  if marked(node, seen) or node == global() { return best }
  mark(node, seen)
  best = longest_operator(node, src, j, best)
  k := 0
  while k < with_len(node) {
    best = operators_on(with_at(node, k), src, j, best, seen)
    k = k + 1
  }
  return best
)

operator_fits (rule, p, op) => (
  known := filtered_known(rule, p, op)
  if known != -1 { return known }
  if checking(rule, p) { return None }
  check(rule, p, global)
  fits := operator_checked(rule, p, op) catch e {
    check(rule, p, None)
    rethrow(e)
  }
  filtered_set(rule, p, op, fits)
  check(rule, p, None)
  return fits
)

operator_checked (rule, p, op) => (
  src, b, e := piece_content(rule, p)
  scope := scope_in(piece_within(rule, p), src, b, e)
  set_name(scope, pname(rule, p), rule_value(op))
  mark := refusals()
  silent(1)
  value := read(src, b, e, scope) catch err {
    if !is_recursion(err) {
      silent(-1)
      rethrow(err)
    }
    recursion_error(err)
    value = UNDEF
  }
  silent(-1)
  fits := None
  if refusals() == mark and value != UNDEF {
    silent(1)
    held := deref(value, None) catch err {
      silent(-1)
      rethrow(err)
    }
    silent(-1)
    fits = held != None
  }
  refusals_back(mark)
  return fits
)

// ---------------------------------------------------------------- overloads: a guarded rule fits when its guard, read on the argument, holds

fits (rule, src, frame) => (
  if !rule_guarded(rule) or !rule.rule_overloaded { return global }
  p := first_capture(rule)
  if p < 0 { return global }
  q := cap_named(rule, pname(rule, p))
  if q < 0 { return global }
  argument := code(src, cap_begin(rule, q), cap_stop(rule, q) - 1, frame)
  found := guard_reading(rule, UNDEF, UNDEF)
  n := naming_count(found)
  if n == 1 and guard_names(rule, found) {
    naming_free(found)
    return global
  }
  if n > 1 {
    answer := !found.naming_refused
    naming_free(found)
    return answer
  }
  naming_free(found)
  if n == 1 { again := guard_reading(rule, argument, UNDEF) } else { again = guard_reading(rule, UNDEF, argument) }
  answer = !again.naming_refused and again.naming_value != UNDEF and again.naming_value != None
  naming_free(again)
  return answer
)

guard_reading (rule, first, from) => (
  scope := guard_scratch(rule)
  state := naming_open(scope, guard_hole(rule), global, first)
  mark := refusals()
  value := guard_read(rule, scope, from) catch e {
    naming_close(state)
    if !is_jump(e) {
      naming_free(state)
      rethrow(e)
    }
    forget(e)
    naming_result(state, refusals() > mark, UNDEF)
    refusals_back(mark)
    return state
  }
  naming_close(state)
  naming_result(state, refusals() > mark, value)
  refusals_back(mark)
  return state
)

guard_read (rule, scope, from) => (
  silent(1)
  r := guard_value(rule, scope, from) catch e {
    if is_recursion(e) {
      recursion_error(e)
      silent(-1)
      return UNDEF
    }
    silent(-1)
    rethrow(e)
  }
  silent(-1)
  return r
)

guard_value (rule, scope, from) => (
  src := rule.rule_guard_src
  b := rule.rule_guard_begin
  e := rule.rule_guard_end
  if from == UNDEF {
    r := read(src, b, e, scope)
  } else {
    r = statement(src, b, e + 1, scope, from)
  }
  if r == UNDEF { return UNDEF }
  held := deref(r, None)
  if held == UNDEF { return r }
  return held
)

// ---------------------------------------------------------------- definitions: a head read by its brackets
// Spans travel as (src, begin, end); a span that is not there has src -1.

rule_from (given, held, frame) => (
  pattern := written(given)
  if pattern == UNDEF { pattern = given }
  body := written(held)
  if body == UNDEF { body = held }
  if at_src(pattern) < 0 or at_src(body) < 0 { return UNDEF }
  scope := frame
  if is_code(pattern) { scope = code_frame(pattern) } elsif is_place(pattern) { scope = place_scope(pattern) }
  rule := define(at_src(pattern), at_begin(pattern), at_end(pattern), at_src(body), at_begin(body), at_end(body), scope, scope, -1, 0, 0, None, -1, 0, 0)
  if rule == -1 { return UNDEF }
  return rule_value(rule)
)

// A rule already made for this head where it is written: met in the order of the rules on the scope and what it was made with.
made_in (node, hs, hb, he, ss, sb, se, seen) => (
  if marked(node, seen) or node == global() { return -1 }
  mark(node, seen)
  r := rule_count(node)
  while r > 0 {
    r = r - 1
    made := side_rule(node, r)
    if !rule_based(made) and rule_spelled(made, hs, hb, he) and rule_sited(made, ss, sb, se) { return made }
  }
  k := 0
  while k < with_len(node) {
    made = made_in(with_at(node, k), hs, hb, he, ss, sb, se, seen)
    if made != -1 { return made }
    k = k + 1
  }
  return -1
)

define (hs, hb, he, bs, bb, be, scope, closure, gs, gb, ge, gin, ws, wb, we) => (
  ss := hs
  sb := hb
  se := he
  if !located(hs) {
    if ws >= 0 {
      ss = ws
      sb = wb
      se = we
    } else {
      top := running_top()
      ss = -1
      if top != None {
        ss = top.run_src
        sb = top.run_begin
        se = top.run_end
      }
    }
  }
  if ss >= 0 and scope != global() {
    seen := stamp()
    made := made_in(scope, hs, hb, he, ss, sb, se, seen)
    if made == -1 and base() != -1 { made = made_in(base(), hs, hb, he, ss, sb, se, seen) }
    if made != -1 { return made }
  }
  out := pieces(hs, hb, he, closure)
  if list_len(out) == 0 {
    pieces_free(out)
    pattern_expected(hs, hb, he)
    return -1
  }
  rule := rule_make(out, closure, hs, hb, he, bs, bb, be, gs, gb, ge, gin)
  add_rule(scope, rule)
  defined(scope, rule)
  return rule
)

define_in (scope, tail, body, src, b, e, parameters) => (
  gs := -1
  gb := 0
  ge := 0
  gin := None
  if parameters != UNDEF {
    pattern := written(parameters)
    if pattern != UNDEF and is_code(pattern) {
      gs, gb, ge := code_inner(pattern)
      gin = code_frame(pattern)
    }
  }
  place := location(scope)
  spelling := deref(tail, None)
  if spelling == UNDEF { spelling = tail }
  held := written(body)
  if held != UNDEF { body = held }
  if at_src(body) < 0 { return UNDEF }
  bs, bb, be := sp_inner(body)
  writer := holding(src, b, e)
  if writer == None { writer = running_top() }
  ws := -1
  wb := 0
  we := 0
  if writer != None {
    ws = writer.run_src
    wb = writer.run_begin
    we = writer.run_end
  }
  if place != UNDEF and is_place(place) and !place_member(place) {
    into := place_scope(place)
    head := spelled_source(place, spelling)
  } else {
    into = deref(scope, None)
    if into == UNDEF or into == None { return UNDEF }
    head = spelled_source(UNDEF, spelling)
  }
  closure := into
  if is_code(body) { closure = code_frame(body) }
  rule := define(head, 0, head.source_length - 1, bs, bb, be, into, closure, gs, gb, ge, gin, ws, wb, we)
  if rule == -1 { return UNDEF }
  rule_lexical(rule, ws, wb, we)
  return rule_value(rule)
)

// ---------------------------------------------------------------- values: graph nodes (SCOPE, CODE, PLACE, TEXT, FN, RULEV) and what is known beside each
// Beside a node, laid out once per node: the scope its names live in (for a value that is not a scope), where it was written,
// what it sees, what it was made with, what it runs on and stands for, the body it reads, and its marks.
Side := { side_names, side_constructed, side_at_src, side_at_begin, side_at_end, side_sees, side_with, side_on, side_stands, side_body_src, side_body_begin, side_body_end, side_bare, side_raw, side_given, side_fn, side_style, side_rule, side_program, side_rules, side_mark, side_visit }

side_of (node) => (
  if node_index(node) >= ROOT.sides_room { return None }
  s := ROOT.sides[node]
  if s == NIL { return None }
  return s
)

info (node) => (
  k := node_index(node)
  if k >= ROOT.sides_room {
    room := max(k + 1, ROOT.sides_room * 2)
    bigger := alloc(room)
    j := 0
    while j < room {
      if j < ROOT.sides_room { bigger[j] = ROOT.sides[j] } else { bigger[j] = NIL }
      j = j + 1
    }
    ROOT.sides = bigger
    ROOT.sides_room = room
  }
  s := ROOT.sides[node]
  if s != NIL { return s }
  s = alloc(Side)
  s.side_names = None
  s.side_constructed = None
  s.side_at_src = -1
  s.side_at_begin = 0
  s.side_at_end = 0
  s.side_sees = None
  s.side_with = None
  s.side_on = UNDEF
  s.side_stands = UNDEF
  s.side_body_src = -1
  s.side_body_begin = 0
  s.side_body_end = 0
  s.side_bare = None
  s.side_raw = None
  s.side_given = None
  s.side_fn = -1
  s.side_style = -1
  s.side_rule = -1
  s.side_program = None
  s.side_rules = None
  s.side_mark = 0
  s.side_visit = 0
  ROOT.sides[node] = s
  return s
)

at_src (node) => (
  s := side_of(node)
  if s == None { return -1 }
  return s.side_at_src
)

at_begin (node) => (
  s := side_of(node)
  if s == None { return 0 }
  return s.side_at_begin
)

at_end (node) => (
  s := side_of(node)
  if s == None { return 0 }
  return s.side_at_end
)

placed_at (node, src, b, e) => (
  s := info(node)
  s.side_at_src = src
  s.side_at_begin = b
  s.side_at_end = e
  return node
)

// Making values: each written somewhere (a span) or nowhere (src -1).
scope_in (parent, src, b, e) => (
  node := node_make(SCOPE, NIL, parent, NIL)
  if src >= 0 { placed_at(node, src, b, e) }
  return node
)

scope_of (parent) => (
  return node_make(SCOPE, NIL, parent, NIL)
)

scope_at (node) => (
  return scope_in(NIL, at_src(node), at_begin(node), at_end(node))
)

code (src, b, e, frame) => (
  return placed_at(node_make(CODE, NIL, frame, NIL), src, b, e)
)

literal (src, b, e) => (
  return placed_at(node_make(TEXT, NIL, NIL, NIL), src, b, e)
)

place_of (frame, src, b, end) => (
  return placed_at(node_make(PLACE, frame, text_id(src, b, end), 0), src, b, end - 1)
)

member_place (target, name, key) => (
  node := node_make(PLACE, target, name, 1)
  if at_src(key) >= 0 { placed_at(node, at_src(key), at_begin(key), at_end(key)) }
  return node
)

member_at (target, name, src, b, e) => (
  return placed_at(node_make(PLACE, target, name, 1), src, b, e)
)

place_copy (target) => (
  node := node_make(PLACE, node_child(target, 0), node_child(target, 1), node_child(target, 2))
  if at_src(target) >= 0 { placed_at(node, at_src(target), at_begin(target), at_end(target)) }
  return node
)

fn_value (f, src, b, e) => (
  node := node_make(FN, NIL, NIL, NIL)
  info(node).side_fn = f
  if src >= 0 { placed_at(node, src, b, e) }
  return node
)

fn_node (f, name) => (
  return fn_value(f, at_src(name), at_begin(name), at_end(name))
)

style (name) => (
  f := style_fn()
  node := fn_value(f, -1, 0, 0)
  fn_self_is(f, node)
  info(node).side_style = name
  return node
)

forward_fn () => (
  return fn_value(forward_fn_id(), -1, 0, 0)
)

method_fn (rule, frame, node) => (
  return fn_value(method_fn_id(rule, frame, pname(rule, 1)), at_src(node), at_begin(node), at_end(node))
)

rule_value (rule) => (
  node := node_make(RULEV, NIL, NIL, NIL)
  info(node).side_rule = rule
  s, b, e := rule_at_span(rule)
  return placed_at(node, s, b, e)
)

program_from (node) => (
  s, b, e := span_inner(at_src(node), at_begin(node), at_end(node))
  value := code(s, b, e, code_frame(node))
  info(value).side_program = global
  return value
)

// What a node is.
is_code (v) => (
  return node_tag(v) == CODE
)

is_place (v) => (
  return node_tag(v) == PLACE
)

is_text (v) => (
  return node_tag(v) == TEXT
)

is_program (v) => (
  s := side_of(v)
  return s != None and s.side_program
)

holds_rule (v) => (
  s := side_of(v)
  return s != None and s.side_rule != -1
)

has_style (v) => (
  s := side_of(v)
  return s != None and s.side_style != -1
)

fn_id (v) => (
  s := side_of(v)
  if s == None { return -1 }
  return s.side_fn
)

fn_arity (v) => (
  f := fn_id(v)
  if f == -1 { return -1 }
  return f.fn_arity
)

fn_raw (v) => (
  f := fn_id(v)
  return f != -1 and f.fn_raw
)

side_stands (v) => (
  s := side_of(v)
  if s == None { return UNDEF }
  return s.side_stands
)

side_on (v) => (
  s := side_of(v)
  if s == None { return UNDEF }
  return s.side_on
)

bare (v) => (
  s := side_of(v)
  return s != None and s.side_bare
)

raw (frame) => (
  info(frame).side_raw = global
  return None
)

stands (context, receiver) => (
  info(context).side_stands = receiver
  return None
)

on (local, v) => (
  info(local).side_on = v
  return None
)

body_from (local, rule) => (
  src, b, e := rule_body_span(rule)
  s := info(local)
  s.side_body_src = src
  s.side_body_begin = b
  s.side_body_end = e
  return None
)

sees_len (node) => (
  s := side_of(node)
  if s == None or s.side_sees == None { return 0 }
  return list_len(s.side_sees)
)

sees_at (node, k) => (
  return list_at(side_of(node).side_sees, k)
)

with_len (node) => (
  s := side_of(node)
  if s == None or s.side_with == None { return 0 }
  return list_len(s.side_with)
)

with_at (node, k) => (
  return list_at(side_of(node).side_with, k)
)

parent (node) => (
  if node_tag(node) != SCOPE { return -1 }
  p := node_child(node, 1)
  if p == NIL { return -1 }
  return p
)

sees_shown (node, src, b, e) => (
  if src < 0 { return global }
  s := side_of(node)
  if s == None or s.side_body_src < 0 { return global }
  return !(src == s.side_body_src and b >= s.side_body_begin and e <= s.side_body_end)
)

// A frame comes to see a scope: written first; the global scope's brackets follow what it sees.
sees_add (frame, scope) => (
  s := info(frame)
  if s.side_sees == None { s.side_sees = list_new() }
  if list_has(s.side_sees, scope) or frame == scope { return None }
  list_unshift(s.side_sees, scope)
  if frame == global() { global_changed() }
  return None
)

with_push (frame, v) => (
  s := info(frame)
  if s.side_with == None { s.side_with = list_new() }
  list_push(s.side_with, v)
  with_changed(frame)
  return None
)

with_add (frame, v) => (
  s := info(frame)
  if s.side_with == None { s.side_with = list_new() }
  if list_has(s.side_with, v) { return None }
  list_push(s.side_with, v)
  with_changed(frame)
  return None
)

with_one (context, v) => (
  s := info(context)
  s.side_with = list_new()
  list_push(s.side_with, v)
  return None
)

list_unshift (l, v) => (
  list_push(l, v)
  k := l.list_size - 1
  while k > 0 {
    l.list_items[k] = l.list_items[k - 1]
    k = k - 1
  }
  l.list_items[0] = v
  return None
)

// Names: a scope's names are a chain of PROP nodes (name, value, next) in the order they were first written.
holder_of (node, make) => (
  t := node_tag(node)
  if t == SCOPE { return node }
  if t < 0 { return None }
  s := info(node)
  if s.side_names == None and make { s.side_names = node_make(SCOPE, NIL, NIL, NIL) }
  return s.side_names
)

own (node, name) => (
  e := holder_of(node, None)
  if e == None { return UNDEF }
  p := node_child(e, 0)
  while p != NIL {
    if node_child(p, 0) == name { return node_child(p, 1) }
    p = node_child(p, 2)
  }
  return UNDEF
)

set_name (node, name, value) => (
  e := holder_of(node, global)
  if e == None { unported("names on None") }
  p := node_child(e, 0)
  last := NIL
  while p != NIL {
    if node_child(p, 0) == name {
      node_set(p, 1, value)
      return value
    }
    last = p
    p = node_child(p, 2)
  }
  made := node_make(PROP, name, value, NIL)
  if last == NIL { node_set(e, 0, made) } else { node_set(last, 2, made) }
  return value
)

name_count (node) => (
  e := holder_of(node, None)
  if e == None { return 0 }
  n := 0
  p := node_child(e, 0)
  while p != NIL {
    n = n + 1
    p = node_child(p, 2)
  }
  return n
)

// Given names: what a constructor wrote on a value.
given (node, name) => (
  s := side_of(node)
  return s != None and s.side_given != None and set_has(s.side_given, name)
)

given_name (name) => (
  return set_has(ROOT.given_names, name)
)

// A value is constructed once: the base's constructor body is read with the value as its frame (seeing where the body was written);
// the names it wrote are given.
construct (value) => (
  made := ROOT.made
  s := info(value)
  if made == UNDEF or !is_code(made) or s.side_constructed or is_text(value) or (s.side_fn != -1 and s.side_style == -1) or is_code(value) or is_place(value) { return None }
  s.side_constructed = global
  sees := s.side_sees
  seeing := list_new()
  if sees != None {
    k := 0
    while k < list_len(sees) {
      list_push(seeing, list_at(sees, k))
      k = k + 1
    }
  }
  list_push(seeing, code_frame(made))
  s.side_sees = seeing
  before := name_count(value)
  bs, bb, be := span_inner(at_src(made), at_begin(made), at_end(made))
  read(bs, bb, be, value) catch e {
    s.side_sees = sees
    list_free(seeing)
    if !is_recursion(e) { rethrow(e) }
    recursion_error(e)
    goto given
  }
  s.side_sees = sees
  list_free(seeing)
  given\
  if !s.side_constructed { return None }
  e := holder_of(value, None)
  if e == None { return None }
  p := node_child(e, 0)
  k = 0
  while p != NIL {
    if k >= before {
      if s.side_given == None { s.side_given = set_new() }
      set_add(s.side_given, node_child(p, 0))
      set_add(ROOT.given_names, node_child(p, 0))
    }
    k = k + 1
    p = node_child(p, 2)
  }
  return None
)

// Code is a span read in a frame, once: its value is kept beside it.



code_frame (node) => (
  return node_child(node, 1)
)

code_value (node) => (
  v := node_child(node, 2)
  if v == NIL { return UNDEF }
  return v
)

forced (node, value) => (
  node_set(node, 2, value)
  forced_push(node)
  return None
)

place_scope (node) => (
  return node_child(node, 0)
)

place_name (node) => (
  return node_child(node, 1)
)

place_member (node) => (
  return node_child(node, 2) == 1
)

// Where code or a value was written: its span (src -1 when nowhere).



// Inside brackets: the span without its surrounding `( )` or `{ }`, if they enclose all of it.
span_inner (src, b, e) => (
  from := b
  to := e
  while from <= to and space(src, from) { from = from + 1 }
  while to >= from and space(src, to) { to = to - 1 }
  chars := src.source_chars
  if from > to or (chars[from] != '(' and chars[from] != '{') or group_end(src, from, to + 1) != to + 1 { return src, b, e }
  return src, from + 1, to - 1
)

code_inner (node) => (
  return span_inner(at_src(node), at_begin(node), at_end(node))
)

sp_inner (node) => (
  return span_inner(at_src(node), at_begin(node), at_end(node))
)

rule_body (rule) => (
  s, b, e := rule_body_span(rule)
  return span_inner(s, b, e)
)

guard_scratch (rule) => (
  scope := scope_in(rule.rule_guard_in, rule.rule_guard_src, rule.rule_guard_begin, rule.rule_guard_end)
  info(scope).side_bare = global
  return scope
)

guard_hole (rule) => (
  return literal(rule.rule_guard_src, rule.rule_guard_begin, rule.rule_guard_end)
)

place_passes (local, rule) => (
  s, b, e := rule_passes_span(rule)
  return place_of(local, s, b, e + 1)
)

direct_place (rule, k, local) => (
  s, b, e := rule_direct_span(rule, k)
  return place_of(local, s, b, e + 1)
)

set_base (target, made) => (
  ROOT.base = target
  ROOT.made = made
  ROOT.homes = None
  return None
)

base () => (
  if ROOT.base == UNDEF { return -1 }
  return ROOT.base
)


style_member (target, name) => (
  return style(style_dot(info(target).side_style, name))
)

// ---------------------------------------------------------------- rules: a pattern of pieces, where it was written, what it does
// Piece kinds: 0 a literal, 1 a gap, 2 a capture. A span that is not there has src -1.
Piece := { piece_kind, piece_text, piece_tight, piece_name, piece_raw, piece_typed, piece_optional, piece_exact, piece_content_src, piece_content_begin, piece_content_end, piece_within, piece_operator, piece_undecided, piece_decided, piece_type }

Rule := { rule_pieces, rule_area, rule_closure, rule_at_src, rule_at_begin, rule_at_end, rule_key, rule_pattern_name, rule_order, rule_body_src, rule_body_begin, rule_body_end, rule_fn, rule_guard_src, rule_guard_begin, rule_guard_end, rule_guard_in, rule_overloaded, rule_native, rule_direct, rule_passes_src, rule_passes_begin, rule_passes_end, rule_defines, rule_home, rule_implicit, rule_lexical_src, rule_lexical_begin, rule_lexical_end, rule_leading, rule_enclosed, rule_operator, rule_head, rule_head_receiving }

// The rules written on a scope, and indexed by the first character they read (open: none), plain and on a receiver.
Rules := { rules_list, rules_open, rules_by, rules_open_receiving, rules_by_receiving, rules_operators, rules_spelled, rules_methods, rules_stamp }

piece_new (kind) => (
  p := alloc(Piece)
  p.piece_kind = kind
  p.piece_text = -1
  p.piece_tight = None
  p.piece_name = -1
  p.piece_raw = None
  p.piece_typed = None
  p.piece_optional = None
  p.piece_exact = None
  p.piece_content_src = -1
  p.piece_content_begin = 0
  p.piece_content_end = 0
  p.piece_within = UNDEF
  p.piece_operator = None
  p.piece_undecided = None
  p.piece_decided = -1
  p.piece_type = UNDEF
  return p
)

piece_literal (text) => (
  p := piece_new(0)
  p.piece_text = text
  return p
)

piece_tight (text) => (
  p := piece_literal(text)
  p.piece_tight = global
  return p
)

piece_text (src, b, e) => (
  return piece_literal(text_id(src, b, e))
)

piece_capture (name) => (
  p := piece_new(2)
  p.piece_name = name
  return p
)

piece_at (rule, p) => (
  return list_at(rule.rule_pieces, p)
)

piece_count (rule) => (
  return list_len(rule.rule_pieces)
)

pkind (rule, p) => (
  return piece_at(rule, p).piece_kind
)

plit (rule, p) => (
  return piece_at(rule, p).piece_text
)

pname (rule, p) => (
  return piece_at(rule, p).piece_name
)

// Flags: 1 tight, 2 raw, 4 typed, 8 optional, 16 exact, 32 operator, 64 undecided.
pflags (rule, p) => (
  piece := piece_at(rule, p)
  flags := 0
  if piece.piece_tight { flags = flags + 1 }
  if piece.piece_kind != 2 { return flags }
  if piece.piece_raw { flags = flags + 2 }
  if piece.piece_typed { flags = flags + 4 }
  if piece.piece_optional { flags = flags + 8 }
  if piece.piece_exact { flags = flags + 16 }
  if piece.piece_operator { flags = flags + 32 }
  if piece.piece_undecided { flags = flags + 64 }
  return flags
)

piece_within (rule, p) => (
  w := piece_at(rule, p).piece_within
  if w == UNDEF { return global() }
  return w
)

piece_content (rule, p) => (
  piece := piece_at(rule, p)
  return piece.piece_content_src, piece.piece_content_begin, piece.piece_content_end
)

piece_has_content (rule, p) => (
  return piece_at(rule, p).piece_content_src >= 0
)

piece_named (rule, name) => (
  p := 0
  while p < piece_count(rule) {
    if pkind(rule, p) == 2 and pname(rule, p) == name { return p }
    p = p + 1
  }
  return -1
)

first_capture (rule) => (
  p := 0
  while p < piece_count(rule) {
    if pkind(rule, p) == 2 { return p }
    p = p + 1
  }
  return -1
)

rule_p0 (rule) => (
  if piece_count(rule) == 0 { return -1 }
  return pkind(rule, 0)
)

rule_reads (rule) => (
  if piece_count(rule) == 0 { return None }
  first := piece_at(rule, 0)
  return first.piece_kind == 2 and (first.piece_typed or first.piece_undecided)
)

rule_head (rule, receiving) => (
  if receiving { return rule.rule_head_receiving }
  return rule.rule_head
)

rule_settle (rule) => (
  n := piece_count(rule)
  rule.rule_head = -1
  rule.rule_head_receiving = -1
  if n == 0 { return None }
  if pkind(rule, 0) == 0 {
    rule.rule_head = plit(rule, 0)
    rule.rule_head_receiving = plit(rule, 0)
  } elsif pkind(rule, 0) == 2 and !rule.rule_implicit and n > 1 and pkind(rule, 1) == 0 {
    rule.rule_head_receiving = plit(rule, 1)
  }
  return None
)












rule_guarded (rule) => (
  return rule.rule_guard_src >= 0
)





rule_has_body (rule) => (
  return rule.rule_body_src >= 0
)

rule_body_span (rule) => (
  return rule.rule_body_src, rule.rule_body_begin, rule.rule_body_end
)

rule_at_span (rule) => (
  return rule.rule_at_src, rule.rule_at_begin, rule.rule_at_end
)

rule_passes_span (rule) => (
  return rule.rule_passes_src, rule.rule_passes_begin, rule.rule_passes_end
)

rule_passes (rule) => (
  if rule.rule_passes_src < 0 { return -1 }
  return text_id(rule.rule_passes_src, rule.rule_passes_begin, rule.rule_passes_end + 1)
)



rule_direct (rule) => (
  return rule.rule_direct != None
)

direct_count (rule) => (
  return list_len(rule.rule_direct) / 2
)

rule_direct_span (rule, k) => (
  return rule.rule_body_src, list_at(rule.rule_direct, k * 2), list_at(rule.rule_direct, k * 2 + 1)
)

direct_this (rule) => (
  return text_id(rule.rule_body_src, list_at(rule.rule_direct, 0), list_at(rule.rule_direct, 1) + 1) == "this"
)

direct_property (rule) => (
  return text_id(rule.rule_body_src, list_at(rule.rule_direct, 2), list_at(rule.rule_direct, 3) + 1)
)

rule_lexical (rule, src, b, e) => (
  rule.rule_lexical_src = src
  rule.rule_lexical_begin = b
  rule.rule_lexical_end = e
  return None
)

rule_covers (rule, src, j) => (
  return rule.rule_at_src == src and rule.rule_at_begin <= j and j <= rule.rule_at_end
)

// Whether a span lies in the rule's body or where it was written.
rule_holds (rule, src, b, e) => (
  if rule.rule_body_src == src and b >= rule.rule_body_begin and e <= rule.rule_body_end { return global }
  return rule.rule_lexical_src == src and b >= rule.rule_lexical_begin and e <= rule.rule_lexical_end
)

rule_label (rule) => (
  return rule.rule_native == "label"
)

rule_native_get (rule) => (
  return rule.rule_native == "get" and rule.rule_direct != None
)

located (src) => (
  return src.source_located
)

same_text (s1, b1, e1, s2, b2, e2) => (
  if e1 - b1 != e2 - b2 { return None }
  k := 0
  while b1 + k <= e1 {
    if s1.source_chars[b1 + k] != s2.source_chars[b2 + k] { return None }
    k = k + 1
  }
  return global
)

rule_spelled (rule, src, b, e) => (
  return same_text(rule.rule_at_src, rule.rule_at_begin, rule.rule_at_end, src, b, e)
)

rule_sited (rule, src, b, e) => (
  if located(rule.rule_at_src) { return rule.rule_at_src == src and rule.rule_at_begin == b and rule.rule_at_end == e }
  return rule.rule_lexical_src >= 0 and rule.rule_lexical_src == src and rule.rule_lexical_begin == b and rule.rule_lexical_end == e
)

jump_within (e, rule) => (
  src, b, end := jump_site(e)
  if src < 0 { return None }
  if rule.rule_body_src == src and b >= rule.rule_body_begin and end <= rule.rule_body_end { return global }
  return rule.rule_lexical_src == src and b >= rule.rule_lexical_begin and end <= rule.rule_lexical_end
)

// What a rule captured, laid out with the rule: its first word counts how often the rule is being matched,
// then per piece the span it captured (-1 where nothing). Matching a rule inside its own match keeps the outer captures aside.

area_open (rule) => (
  area := rule.rule_area
  n := piece_count(rule) * 2
  if area[0] != 0 {
    k := 0
    while k < n {
      list_push(ROOT.area_saves, area[k + 1])
      k = k + 1
    }
  }
  area[0] = area[0] + 1
  k = 0
  while k < n {
    area[k + 1] = -1
    k = k + 1
  }
  return None
)

area_close (rule) => (
  area := rule.rule_area
  area[0] = area[0] - 1
  if area[0] != 0 {
    k := piece_count(rule) * 2
    while k > 0 {
      area[k] = list_pop(ROOT.area_saves)
      k = k - 1
    }
  }
  return None
)

list_pop (l) => (
  n := l.list_size - 1
  l.list_size = n
  return l.list_items[n]
)

// ---------------------------------------------------------------- making a rule: its pieces, its key, and what its body says about it

first_word_is (lit) => (
  return lit.name_length > 0 and is_word(lit_char(lit, 0))
)

// A string being built, then kept as a name.
text_add (out, name) => (
  n := name.name_length
  k := 0
  while k < n {
    list_push(out, lit_char(name, k))
    k = k + 1
  }
  return None
)

text_add_span (out, src, b, e) => (
  k := b
  while k <= e {
    list_push(out, src.source_chars[k])
    k = k + 1
  }
  return None
)

text_done (out) => (
  id := intern(out.list_items, 0, out.list_size)
  list_free(out)
  return id
)

trimmed_begin (src, b, e) => (
  while b <= e and space(src, b) { b = b + 1 }
  return b
)

trimmed_end (src, b, e) => (
  while e >= b and space(src, e) { e = e - 1 }
  return e
)

// The name of a pattern: its literals as written, `{ }` for a gap, `{name}` for a capture.
pattern_name (pieces) => (
  out := list_new()
  n := list_len(pieces)
  k := 0
  while k < n {
    piece := list_at(pieces, k)
    if piece.piece_kind == 0 { text_add(out, piece.piece_text) } elsif piece.piece_kind == 1 { text_add(out, "{ }") } else {
      list_push(out, '{')
      text_add(out, piece.piece_name)
      list_push(out, '}')
    }
    k = k + 1
  }
  return text_done(out)
)

rule_make (pieces, closure, hs, hb, he, bs, bb, be, gs, gb, ge, gin) => (
  rule := alloc(Rule)
  rule.rule_pieces = pieces
  n := list_len(pieces)
  area := alloc(n * 2 + 1)
  area[0] = 0
  rule.rule_area = area
  rule.rule_closure = closure
  rule.rule_at_src = hs
  rule.rule_at_begin = hb
  rule.rule_at_end = he
  rule.rule_pattern_name = pattern_name(pieces)
  rule.rule_key = rule.rule_pattern_name
  guarded := gs >= 0 and trimmed_begin(gs, gb, ge) <= trimmed_end(gs, gb, ge)
  if guarded {
    out := list_new()
    text_add(out, rule.rule_pattern_name)
    list_push(out, '(')
    text_add_span(out, gs, trimmed_begin(gs, gb, ge), trimmed_end(gs, gb, ge))
    list_push(out, ')')
    rule.rule_key = text_done(out)
  }
  rule.rule_order = ROOT.order
  ROOT.order = ROOT.order + 1
  rule.rule_body_src = bs
  rule.rule_body_begin = bb
  rule.rule_body_end = be
  rule.rule_fn = -1
  rule.rule_guard_src = -1
  if guarded {
    rule.rule_guard_src = gs
    rule.rule_guard_begin = gb
    rule.rule_guard_end = ge
    rule.rule_guard_in = gin
  }
  rule.rule_overloaded = None
  rule.rule_native = -1
  rule.rule_direct = None
  rule.rule_passes_src = -1
  rule.rule_defines = None
  rule.rule_home = UNDEF
  rule.rule_implicit = None
  rule.rule_lexical_src = -1
  rule.rule_leading = n > 0 and pkind(rule, 0) == 2
  rule.rule_enclosed = n >= 3 and pkind(rule, 0) == 0 and pkind(rule, n - 1) == 0 and plit(rule, 0).name_length > 0 and !first_word_is(plit(rule, 0))
  rule.rule_operator = -1
  if n == 2 and pkind(rule, 0) == 0 and pkind(rule, 1) == 2 and plit(rule, 0).name_length > 0 and !first_word_is(plit(rule, 0)) { rule.rule_operator = plit(rule, 0) }
  rule_settle(rule)
  if bs >= 0 { rule_body_says(rule) }
  return rule
)

ascii_word (c) => (
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
)

// A body `external name word…` names a native; when the words are plain and as many as it takes, the rule calls it directly.
// A body that is one of the pattern's names passes it on. A body that says `external rule` or `external define` defines.
rule_body_says (rule) => (
  src := rule.rule_body_src
  b := rule.rule_body_begin
  limit := rule.rule_body_end + 1
  w := token(src, b, limit)
  if w > b and text_id(src, b, w) == "external" and lookup(rule.rule_closure, "external", -1, 0, 0) == external_fn() {
    from := spaces(src, w, limit)
    name := token_end(src, from, limit)
    rule.rule_native = text_id(src, from, name)
    words := list_new()
    at := name
    plain := global
    while plain {
      from = spaces(src, at, limit)
      if from >= limit { goto counted }
      to := token_end(src, from, limit)
      if to == from {
        plain = None
      } else {
        list_push(words, from)
        list_push(words, to - 1)
        at = to
      }
    }
    counted\
    f := native_fn(rule.rule_native)
    if plain and f != -1 and !f.fn_raw and list_len(words) / 2 == f.fn_arity and list_len(words) > 0 { rule.rule_direct = words } else { list_free(words) }
  }
  if rule_p0(rule) != 2 {
    is, ib, ie := span_inner(src, rule.rule_body_begin, rule.rule_body_end)
    ilimit := ie + 1
    from = spaces(src, ib, ilimit)
    to = token_end(src, from, ilimit)
    if to > from and spaces(src, to, ilimit) >= ilimit {
      spelled := text_id(src, from, to)
      n := piece_count(rule)
      k := 0
      while k < n {
        if pkind(rule, k) == 2 and pname(rule, k) == spelled {
          rule.rule_passes_src = src
          rule.rule_passes_begin = from
          rule.rule_passes_end = to - 1
          goto passed
        }
        k = k + 1
      }
      passed\
    }
  }
  j := rule.rule_body_begin
  end := rule.rule_body_end + 1
  chars := src.source_chars
  while j < end {
    if j + 8 < end and starts(src, j, "external") and (j == rule.rule_body_begin or !ascii_word(chars[j - 1])) and space(src, j + 8) {
      k = j + 8
      while k < end and space(src, k) { k = k + 1 }
      e := k
      while e < end and !space(src, e) and chars[e] != '(' and chars[e] != ')' { e = e + 1 }
      if e > k {
        said := text_id(src, k, e)
        if said == "rule" or said == "define" { rule.rule_defines = global }
        j = e
        goto scanned
      }
    }
    j = j + 1
    scanned\
  }
  return None
)

// The rule every other rule is made by: `{pattern} => {body}`.
seed_rule (src) => (
  pieces := list_new()
  list_push(pieces, piece_capture("pattern"))
  list_push(pieces, piece_literal("=>"))
  list_push(pieces, piece_capture("body"))
  rule := rule_make(pieces, global(), src, 0, 18, -1, 0, 0, -1, 0, 0, None)
  rule.rule_key = ""
  rule.rule_fn = native_fn("rule")
  rule.rule_native = "rule"
  rule.rule_defines = global
  add_rule(global(), rule)
  return rule
)

defined (scope, rule) => (
  record_definition(scope == global(), rule.rule_key)
  return None
)

// ---------------------------------------------------------------- a rule takes its place in a scope
rules_of_scope (scope) => (
  s := side_of(scope)
  if s == None { return None }
  return s.side_rules
)

add_rule (scope, rule) => (
  s := info(scope)
  if s.side_rules == None {
    s.side_rules = alloc(Rules)
    s.side_rules.rules_list = list_new()
  }
  r := s.side_rules
  rules := r.rules_list
  rule.rule_home = scope
  rule.rule_implicit = scope != global() and rule.rule_leading and (piece_count(rule) == 1 or pkind(rule, 1) == 1)
  rule_settle(rule)
  if rule.rule_guard_src >= 0 {
    named := map_get(ROOT.named, rule.rule_pattern_name, 0)
    if named == UNDEF {
      named = list_new()
      map_put(ROOT.named, rule.rule_pattern_name, 0, named)
    }
    list_push(named, rule)
    other_key := None
    k := 0
    while k < list_len(named) {
      if list_at(named, k).rule_key != rule.rule_key { other_key = global }
      k = k + 1
    }
    if other_key {
      k = 0
      while k < list_len(named) {
        list_at(named, k).rule_overloaded = global
        k = k + 1
      }
    }
  }
  k = 0
  while k < list_len(rules) {
    if list_at(rules, k).rule_key == rule.rule_key {
      rule.rule_order = list_at(rules, k).rule_order
      list_remove(rules, k)
      goto unique
    }
    k = k + 1
  }
  unique\
  if rule.rule_operator != -1 {
    order := map_get(ROOT.written, rule.rule_key, 0)
    if order == UNDEF or order > rule.rule_order {
      if order == UNDEF { list_push(ROOT.written_keys, rule.rule_key) }
      map_put(ROOT.written, rule.rule_key, 0, rule.rule_order)
      map_put(ROOT.written, rule.rule_key, 1, rule.rule_operator)
      ROOT.written_version = ROOT.written_version + 1
    }
  }
  list_push(rules, rule)
  r.rules_open = list_new()
  r.rules_by = map_new()
  r.rules_open_receiving = list_new()
  r.rules_by_receiving = map_new()
  heads_of(rules, None, r.rules_open, r.rules_by)
  heads_of(rules, global, r.rules_open_receiving, r.rules_by_receiving)
  ROOT.rule_stamps = ROOT.rule_stamps + 1
  r.rules_stamp = ROOT.rule_stamps
  r.rules_operators = list_new()
  r.rules_spelled = list_new()
  r.rules_methods = map_new()
  k = 0
  while k < list_len(rules) {
    other := list_at(rules, k)
    if piece_count(other) == 2 and pkind(other, 0) == 0 and pkind(other, 1) == 2 {
      if plit(other, 0).name_length > 0 and is_run(lit_char(plit(other, 0), 0)) { list_push(r.rules_operators, other) }
      map_put(r.rules_methods, plit(other, 0), 0, other)
    }
    if other.rule_operator != -1 { list_push(r.rules_spelled, other) }
    k = k + 1
  }
  if scope == global() or global_sees(scope) { global_changed() }
  ROOT.homes = None
  return None
)

global_sees (scope) => (
  n := sees_len(global())
  k := 0
  while k < n {
    if sees_at(global(), k) == scope { return global }
    k = k + 1
  }
  return None
)

list_remove (l, k) => (
  n := l.list_size
  items := l.list_items
  while k + 1 < n {
    items[k] = items[k + 1]
    k = k + 1
  }
  l.list_size = n - 1
  return None
)

heads_of (rules, receiving, open, by) => (
  r := list_len(rules)
  while r > 0 {
    r = r - 1
    head := rule_head(list_at(rules, r), receiving)
    if head == -1 or head.name_length == 0 {
      list_push(open, r)
    } else {
      list := map_get(by, lit_char(head, 0), 0)
      if list == UNDEF {
        list = list_new()
        map_put(by, lit_char(head, 0), 0, list)
      }
      list_push(list, r)
    }
  }
  return None
)

// The brackets are the enclosed rules in reach of the global scope, in the order they are met; what opens and closes them is kept as sets.
global_changed () => (
  brackets := list_new()
  brackets_in(global(), brackets, stamp())
  same := list_len(brackets) == list_len(ROOT.brackets)
  k := 0
  while same and k < list_len(brackets) {
    if list_at(brackets, k) != list_at(ROOT.brackets, k) { same = None }
    k = k + 1
  }
  if !same {
    ROOT.brackets = brackets
    ROOT.bracket_version = ROOT.bracket_version + 1
  }
  ROOT.openers = set_new()
  ROOT.closers = set_new()
  ROOT.closer_chars = set_new()
  k = 0
  while k < list_len(brackets) {
    rule := list_at(brackets, k)
    set_add(ROOT.openers, plit(rule, 0))
    last := plit(rule, piece_count(rule) - 1)
    set_add(ROOT.closers, last)
    if last.name_length == 1 { set_add(ROOT.closer_chars, lit_char(last, 0)) }
    k = k + 1
  }
  return None
)

brackets_in (at, out, seen) => (
  if at == -1 or marked(at, seen) { return None }
  mark(at, seen)
  r := rule_count(at)
  while r > 0 {
    r = r - 1
    if side_rule(at, r).rule_enclosed { list_push(out, side_rule(at, r)) }
  }
  k := 0
  while k < sees_len(at) {
    brackets_in(sees_at(at, k), out, seen)
    k = k + 1
  }
  return brackets_in(parent(at), out, seen)
)

opener (lit) => (
  return set_has(ROOT.openers, lit)
)

closer (lit) => (
  return set_has(ROOT.closers, lit)
)

closes_with (c) => (
  return set_has(ROOT.closer_chars, c)
)

brackets () => (
  return list_len(ROOT.brackets)
)

bracket (k) => (
  return list_at(ROOT.brackets, k)
)

brackets_version () => (
  return ROOT.bracket_version
)

written_version () => (
  return ROOT.written_version
)

written_len () => (
  return list_len(ROOT.written_keys)
)

written_order (k) => (
  return map_get(ROOT.written, list_at(ROOT.written_keys, k), 0)
)

written_operator (k) => (
  return map_get(ROOT.written, list_at(ROOT.written_keys, k), 1)
)

written_known (latest, k) => (
  return keymap_has(latest, list_at(ROOT.written_keys, k))
)

// What is based: the base and everything it was made with, known until a rule or something made with changes.
based_home (home) => (
  if ROOT.homes == None {
    ROOT.homes = set_new()
    ROOT.homes_version = ROOT.homes_version + 1
    if base() != -1 { homes_from(base()) }
  }
  return set_has(ROOT.homes, home)
)

homes_from (node) => (
  if set_has(ROOT.homes, node) or node == global() { return None }
  set_add(ROOT.homes, node)
  k := 0
  while k < with_len(node) {
    homes_from(with_at(node, k))
    k = k + 1
  }
  return None
)

rule_based (rule) => (
  return based_home(rule.rule_home)
)

homes_version () => (
  based_home(UNDEF)
  return ROOT.homes_version
)

with_changed (node) => (
  if ROOT.homes == None or set_has(ROOT.homes, node) or node == base() { ROOT.homes = None }
  return None
)

has_rules (node) => (
  return rules_of_scope(node) != None
)

rule_count (node) => (
  r := rules_of_scope(node)
  if r == None { return 0 }
  return list_len(r.rules_list)
)

side_rule (node, k) => (
  return list_at(rules_of_scope(node).rules_list, k)
)

rules_stamp (node) => (
  return rules_of_scope(node).rules_stamp
)

heads_open (node, receiving) => (
  r := rules_of_scope(node)
  if receiving { return r.rules_open_receiving }
  return r.rules_open
)

heads_by (node, receiving, src, j) => (
  r := rules_of_scope(node)
  by := r.rules_by
  if receiving { by = r.rules_by_receiving }
  if j >= src.source_length { return ROOT.empty }
  list := map_get(by, src.source_chars[j], 0)
  if list == UNDEF { return ROOT.empty }
  return list
)



kind_count (node, which) => (
  r := rules_of_scope(node)
  if r == None { return 0 }
  if which == 1 { return list_len(r.rules_operators) }
  return list_len(r.rules_spelled)
)

kind_rule (node, which, k) => (
  r := rules_of_scope(node)
  if which == 1 { return list_at(r.rules_operators, k) }
  return list_at(r.rules_spelled, k)
)

method_of (node, name) => (
  r := rules_of_scope(node)
  if r == None { return -1 }
  rule := map_get(r.rules_methods, name, 0)
  if rule == UNDEF { return -1 }
  return rule
)

// Rules by key, in the order first met.
keymap_new () => (
  m := alloc(List)
  m.list_items = map_new()
  m.list_room = list_new()
  return m
)

keymap_get (m, rule) => (
  r := map_get(m.list_items, rule.rule_key, 0)
  if r == UNDEF { return -1 }
  return r
)

keymap_has (m, key) => (
  return map_get(m.list_items, key, 0) != UNDEF
)

keymap_set (m, rule) => (
  if map_get(m.list_items, rule.rule_key, 0) == UNDEF { list_push(m.list_room, rule.rule_key) }
  map_put(m.list_items, rule.rule_key, 0, rule)
  return None
)

keymap_len (m) => (
  return list_len(m.list_room)
)

keymap_at (m, k) => (
  return map_get(m.list_items, list_at(m.list_room, k), 0)
)

keymap_free (m) => (
  return None
)

// ---------------------------------------------------------------- pieces being made


piece_add (out, piece, src, j, begin) => (
  if list_len(out) > 0 and j > begin and !space(src, j - 1) { piece.piece_tight = global }
  list_push(out, piece)
  return None
)

pieces_push (out, piece) => (
  list_push(out, piece)
  return None
)

piece_drop (piece) => (
  return None
)

pieces_append (out, inner) => (
  k := 0
  while k < list_len(inner) {
    list_push(out, list_at(inner, k))
    k = k + 1
  }
  return None
)

pieces_free (inner) => (
  list_free(inner)
  return None
)

pieces_last_literal (out) => (
  n := list_len(out)
  return n > 0 and list_at(out, n - 1).piece_kind == 0
)

piece_is_capture (piece) => (
  return piece.piece_kind == 2
)

piece_operator (piece) => (
  piece.piece_raw = global
  piece.piece_operator = global
  return None
)

piece_exact (piece) => (
  piece.piece_exact = global
  return None
)

// A capture written as a plain name, or nothing (a gap).
capture_plain (src, b, e) => (
  from := trimmed_begin(src, b, e)
  to := trimmed_end(src, b, e)
  if from > to { return piece_new(1) }
  if identifier(src, from, to + 1) { return piece_capture(text_id(src, from, to + 1)) }
  return None
)

// What a capture's content read as when it named nothing: text spells a literal (or a gap), anything else captures under its written name.
capture_spelled (held, src, b, e) => (
  if held != UNDEF and is_text(held) {
    hs := at_src(held)
    hb := at_begin(held)
    he := at_end(held)
    blank := hs < 0 or trimmed_begin(hs, hb, he) > trimmed_end(hs, hb, he)
    lines := None
    if hs >= 0 {
      k := hb
      while k <= he {
        if hs.source_chars[k] == '\n' { lines = global }
        k = k + 1
      }
    }
    if blank and !lines { return piece_new(1) }
    if blank { return piece_literal("\n") }
    return piece_literal(text_id(hs, hb, he + 1))
  }
  piece := piece_capture(text_id(src, trimmed_begin(src, b, e), trimmed_end(src, b, e) + 1))
  piece.piece_content_src = src
  piece.piece_content_begin = b
  piece.piece_content_end = e
  return piece
)

capture_named (scope, name, hole, src, b, e, frame, undecided) => (
  bound := own(scope, name)
  typed := bound != hole and bound != UNDEF
  piece := piece_capture(name)
  piece.piece_raw = scope_raw(scope)
  piece.piece_typed = typed
  piece.piece_optional = !typed and optional_mark(src, b, e)
  piece.piece_content_src = src
  piece.piece_content_begin = b
  piece.piece_content_end = e
  piece.piece_within = frame
  piece.piece_undecided = undecided and !typed
  piece.piece_decided = declared()
  if typed { piece.piece_type = bound }
  return piece
)

scope_raw (v) => (
  s := side_of(v)
  return s != None and s.side_raw
)

// A `?` outside backtick pairs.
optional_mark (src, b, e) => (
  from := trimmed_begin(src, b, e)
  to := trimmed_end(src, b, e)
  k := from
  while k <= to {
    c := src.source_chars[k]
    if c == '`' {
      q := k + 1
      while q <= to and src.source_chars[q] != '`' { q = q + 1 }
      if q <= to { k = q }
    } elsif c == '?' { return global }
    k = k + 1
  }
  return None
)

undecided_now (rule, p) => (
  piece := piece_at(rule, p)
  return piece.piece_undecided and piece.piece_decided != declared()
)

checking (rule, p) => (
  return list_has(ROOT.checking, piece_at(rule, p))
)

check (rule, p, on) => (
  if on { list_push(ROOT.checking, piece_at(rule, p)) } else { list_drop(ROOT.checking, piece_at(rule, p)) }
  return None
)

decided (rule, p, again) => (
  piece := piece_at(rule, p)
  if again.piece_kind != 2 {
    piece.piece_undecided = None
    return None
  }
  piece.piece_typed = again.piece_typed
  piece.piece_type = again.piece_type
  piece.piece_optional = again.piece_optional
  piece.piece_undecided = again.piece_undecided
  piece.piece_decided = declared()
  return None
)

// What a typed capture's text read as is kept per the capture's content and the text, while no name it missed has been declared since.
Held := { held_declared, held_value, held_missing }

// Answers whether to read the text: and the key it is kept under, and the names missed so far (to restore).
holds_open (rule, p, src, b, e) => (
  piece := piece_at(rule, p)
  ROOT.known = UNDEF
  if list_has(ROOT.checking, piece) { return None, 0, None }
  key := trie(trie(piece.piece_content_src + 2, piece.piece_content_begin), text_id(src, b, e + 1))
  held := map_get(ROOT.held_texts, key, 0)
  if held != UNDEF and (held.held_declared == declared() or !missing_declared(held.held_missing)) {
    ROOT.known = held.held_value
    return None, 0, None
  }
  list_push(ROOT.checking, piece)
  saved := ROOT.missing
  ROOT.missing = set_new()
  return global, key, saved
)

missing_declared (missing) => (
  keys := missing.set_keys
  k := 0
  while k < missing.set_room {
    if keys[k] != UNDEF and own(global(), keys[k]) != UNDEF { return global }
    k = k + 1
  }
  return None
)

holds_known () => (
  return ROOT.known
)

holds_close (rule, p, key, saved, value, done) => (
  if done {
    held := alloc(Held)
    held.held_declared = declared()
    held.held_value = value
    held.held_missing = ROOT.missing
    map_put(ROOT.held_texts, key, 0, held)
  }
  list_drop(ROOT.checking, piece_at(rule, p))
  ROOT.missing = saved
  return None
)

list_drop (l, v) => (
  k := l.list_size
  while k > 0 {
    k = k - 1
    if l.list_items[k] == v {
      list_remove(l, k)
      return None
    }
  }
  return None
)

missing_add (name) => (
  if ROOT.missing != None { set_add(ROOT.missing, name) }
  return None
)

// An operator filter's answer is kept per the capture's content, the operator rule and how much was declared.
filtered_key (rule, p, op) => (
  piece := piece_at(rule, p)
  site := trie(piece.piece_content_src + 2, piece.piece_content_begin)
  return trie(trie(site, op.rule_key), trie(trie(op.rule_at_src + 2, op.rule_at_begin), declared()))
)

filtered_known (rule, p, op) => (
  known := map_get(ROOT.filtered, filtered_key(rule, p, op), 0)
  if known == UNDEF { return -1 }
  return known
)

filtered_set (rule, p, op, fits) => (
  map_put(ROOT.filtered, filtered_key(rule, p, op), 0, fits)
  return None
)

// ---------------------------------------------------------------- what reading says: diagnostics, each a level, a message and where
Diagnostic := { diag_level, diag_message, diag_src, diag_begin, diag_end }

complain (level, message, src, b, e) => (
  if ROOT.silent > 0 and (level == "error" or level == "fatal") { ROOT.refused = ROOT.refused + 1 }
  if ROOT.silent > 0 { return None }
  k := 0
  while k < list_len(ROOT.diagnostics) {
    d := list_at(ROOT.diagnostics, k)
    if d.diag_level == level and d.diag_message == message and d.diag_begin == b and d.diag_src == src { return None }
    k = k + 1
  }
  d = alloc(Diagnostic)
  d.diag_level = level
  d.diag_message = message
  d.diag_src = src
  d.diag_begin = b
  d.diag_end = e
  list_push(ROOT.diagnostics, d)
  return None
)

error_at (message, src, b, e) => (
  return complain("error", message, src, b, e)
)

error_on (message, node) => (
  return complain("error", message, at_src(node), at_begin(node), at_end(node))
)

// A message: a name put together from parts.
said (a, x, b) => (
  out := list_new()
  text_add(out, a)
  text_add(out, x)
  text_add(out, b)
  return text_done(out)
)

unresolved (node) => (
  return error_on(said("Unresolved `", place_name(node), "`."), node)
)

cannot_declare (target, at) => (
  named := at
  if at == UNDEF { named = target }
  return error_on(said("Cannot declare `", text_of_node(named), "` here."), target)
)

cannot_assign (target) => (
  return error_on("Cannot assign here.", target)
)

not_external (name, key) => (
  return error_on(said("Expected method `", key, "` to be externally defined by the runtime, but it wasn't."), name)
)

pattern_expected (src, b, e) => (
  return error_at("Expected a pattern before `=>`.", src, b, e)
)

unexpected (src, at, end) => (
  return error_at(said("Unexpected `", text_id(src, at, end), "`."), src, at, max(at, end - 1))
)

// `report LEVEL variable comment`: the level as written (FATAL, ERROR, WARN, INFO, DEBUG, TRACE), or an error.
complain_with (level, message, src, b, e) => (
  spelled := "error"
  if level != UNDEF {
    written := text_of_node(level)
    if written == "FATAL" { spelled = "fatal" } elsif written == "WARN" { spelled = "warning" } elsif written == "INFO" { spelled = "info" } elsif written == "DEBUG" { spelled = "debug" } elsif written == "TRACE" { spelled = "trace" }
  }
  text := ""
  if message != UNDEF { text = text_of_node(message) }
  return complain(spelled, text, src, b, e)
)

refusals () => (
  return ROOT.refused
)

refusals_back (mark) => (
  ROOT.refused = mark
  return None
)

silent (d) => (
  ROOT.silent = ROOT.silent + d
  return None
)

trying (d) => (
  ROOT.trying = ROOT.trying + d
  return None
)

declared () => (
  return ROOT.declared
)

declared_more () => (
  ROOT.declared = ROOT.declared + 1
  return None
)

global () => (
  return ROOT.global
)

// Walks mark the nodes they met: a stamp per walk, kept beside each node.
stamp () => (
  ROOT.stamp = ROOT.stamp + 1
  return ROOT.stamp
)

marked (node, seen) => (
  s := side_of(node)
  return s != None and s.side_mark == seen
)

mark (node, seen) => (
  info(node).side_mark = seen
  return None
)

visits () => (
  ROOT.visits = ROOT.visits + 1
  return ROOT.visits
)

visited (node, seen) => (
  s := side_of(node)
  return s != None and s.side_visit == seen
)

visit (node, seen) => (
  info(node).side_visit = seen
  return None
)

// Code read once keeps its value; going back over a label forgets what was read since.
forced_push (node) => (
  list_push(ROOT.forced, node)
  return None
)

forced_len () => (
  return list_len(ROOT.forced)
)

forced_cut (mark) => (
  if list_len(ROOT.forced) > mark { ROOT.forced.list_size = mark }
  return None
)

unforce (mark) => (
  k := mark
  while k < list_len(ROOT.forced) {
    node_set(list_at(ROOT.forced, k), 2, NIL)
    k = k + 1
  }
  forced_cut(mark)
  return None
)

// ---------------------------------------------------------------- naming: a capture's content read with nothing bound; the first name it asks for is the capture's
Naming := { naming_scope, naming_hole, naming_name, naming_names, naming_first, naming_was, naming_trying, naming_refused, naming_value }

naming_open (scope, hole, names, first) => (
  n := alloc(Naming)
  n.naming_scope = scope
  n.naming_hole = hole
  n.naming_name = -1
  n.naming_names = None
  if names { n.naming_names = list_new() }
  n.naming_first = first
  if first == None { n.naming_first = UNDEF }
  n.naming_was = ROOT.naming
  n.naming_trying = ROOT.trying
  ROOT.naming = n
  ROOT.trying = 0
  return n
)

naming_close (n) => (
  ROOT.naming = n.naming_was
  ROOT.trying = n.naming_trying
  return None
)

naming_free (n) => (
  return None
)


naming_count (n) => (
  return list_len(n.naming_names)
)

naming_first_is (n, src, b, e) => (
  return list_len(n.naming_names) > 0 and span_is(src, b, e, list_at(n.naming_names, 0))
)

naming_result (n, refused, value) => (
  n.naming_refused = refused
  n.naming_value = value
  return None
)



naming_takes (frame, name) => (
  n := ROOT.naming
  if n == None or !(n.naming_name == -1 or n.naming_names != None) or frame != n.naming_scope { return None }
  if n.naming_names == None { return ROOT.trying == 0 }
  return name.name_length > 0 and is_word(lit_char(name, 0))
)

naming_take (frame, name) => (
  n := ROOT.naming
  first := UNDEF
  if n.naming_names != None and list_len(n.naming_names) == 0 { first = n.naming_first }
  if n.naming_name == -1 { n.naming_name = name }
  if n.naming_names != None { list_push(n.naming_names, name) }
  if first == UNDEF { first = n.naming_hole }
  return set_name(frame, name, first)
)

is_hole (v) => (
  return ROOT.naming != None and v == ROOT.naming.naming_hole
)

// ---------------------------------------------------------------- telling text apart
// Character classes: 1 word, 2 space, 4 run (an operator character), 8 run between tokens, 16 letter.
is_letter (c) => (
  return has(CLASSES[c], 16)
)

// A name: a letter or `_`, then letters, digits, `_` and `-`.
identifier (src, b, e) => (
  if e <= b { return None }
  chars := src.source_chars
  if !is_letter(chars[b]) and chars[b] != '_' { return None }
  k := b + 1
  while k < e {
    if !is_word(chars[k]) and chars[k] != '-' { return None }
    k = k + 1
  }
  return global
)

// Only operator characters: no space, letter, digit or `_`.
operators_only (src, b, e) => (
  if e <= b { return None }
  k := b
  while k < e {
    c := src.source_chars[k]
    if has(CLASSES[c], 2) or is_word(c) { return None }
    k = k + 1
  }
  return global
)

span_is (src, b, e, name) => (
  from := trimmed_begin(src, b, e)
  to := trimmed_end(src, b, e)
  if to - from + 1 != name.name_length { return None }
  k := 0
  while from + k <= to {
    if src.source_chars[from + k] != lit_char(name, k) { return None }
    k = k + 1
  }
  return global
)

label_is (src, b, e, label) => (
  return span_is(src, b, e - 1, label)
)

char_is (src, j, name) => (
  return j < src.source_length and name.name_length == 1 and src.source_chars[j] == lit_char(name, 0)
)

code_word (node) => (
  src := at_src(node)
  from := trimmed_begin(src, at_begin(node), at_end(node))
  to := trimmed_end(src, at_begin(node), at_end(node))
  if identifier(src, from, to + 1) { return text_id(src, from, to + 1) }
  return -1
)

code_empty (node) => (
  return at_end(node) < at_begin(node) or trimmed_begin(at_src(node), at_begin(node), at_end(node)) > trimmed_end(at_src(node), at_begin(node), at_end(node))
)

code_names (node) => (
  src := at_src(node)
  from := trimmed_begin(src, at_begin(node), at_end(node))
  to := trimmed_end(src, at_begin(node), at_end(node))
  return identifier(src, from, to + 1) or operators_only(src, from, to + 1)
)

// `[name]` inside a pattern: the `]` that closes it, when what is inside starts like a word and holds no `{`.
operator_shut (src, j, stop) => (
  chars := src.source_chars
  if chars[j] != '[' { return -1 }
  shut := j + 1
  while shut < src.source_length and chars[shut] != ']' { shut = shut + 1 }
  if shut >= src.source_length or shut >= stop { return -1 }
  from := trimmed_begin(src, j + 1, shut - 1)
  if from > trimmed_end(src, j + 1, shut - 1) or !is_word(chars[from]) { return -1 }
  k := j + 1
  while k < shut {
    if chars[k] == '{' { return -1 }
    k = k + 1
  }
  return shut
)

// What a value says as text: a style's name, a place's name, code as written (trimmed), or where it was written.
text_of_node (node) => (
  if has_style(node) { return info(node).side_style }
  if is_place(node) { return place_name(node) }
  src := at_src(node)
  if src < 0 { return "" }
  if is_code(node) { return text_id(src, trimmed_begin(src, at_begin(node), at_end(node)), trimmed_end(src, at_begin(node), at_end(node)) + 1) }
  return text_id(src, at_begin(node), at_end(node) + 1)
)


style_dot (style, name) => (
  return said(style, ".", name)
)

// A new source spelled from a place's name and a value's text.
spelled_source (place, spelling) => (
  out := list_new()
  if place != UNDEF { text_add(out, place_name(place)) }
  text_add(out, text_of_node(spelling))
  n := list_len(out)
  chars := alloc(n + 1)
  k := 0
  while k < n {
    chars[k] = list_at(out, k)
    k = k + 1
  }
  list_free(out)
  return lay(chars, n, None)
)


names (lit, place) => (
  return lit == place_name(place)
)

// ---------------------------------------------------------------- function values
// Kinds: 1 a native of the runtime (by name), 2 a style, 3 a method found by name (a rule applied to one argument), 4 `external`, 5 forward.
Fn := { fn_kind, fn_name, fn_arity, fn_raw, fn_rule, fn_frame, fn_capture, fn_self }

fn_make (kind, arity, raw) => (
  f := alloc(Fn)
  f.fn_kind = kind
  f.fn_name = -1
  f.fn_arity = arity
  f.fn_raw = raw
  f.fn_rule = -1
  f.fn_frame = UNDEF
  f.fn_capture = -1
  f.fn_self = UNDEF
  return f
)









fn_self_is (f, node) => (
  f.fn_self = node
  return None
)

style_fn () => (
  return fn_make(2, 1, None)
)

forward_fn_id () => (
  return fn_make(5, 1, global)
)

method_fn_id (rule, frame, capture) => (
  f := fn_make(3, 1, None)
  f.fn_rule = rule
  f.fn_frame = frame
  f.fn_capture = capture
  return f
)

// The runtime's natives by name and arity; `external_call` is what they do.
native (name, arity) => (
  f := fn_make(1, arity, None)
  f.fn_name = name
  map_put(ROOT.natives, name, 0, f)
  return None
)

natives_table () => (
  ROOT.natives = map_new()
  native("rule", 2)
  native("define", 4)
  native(".", 0)
  native("global", 0)
  native("none", 0)
  native("declare", 2)
  native("literal", 1)
  native("unordered", 1)
  native("forward", 0)
  native("^", 1)
  native("inline", 1)
  native("extend", 2)
  native("get", 2)
  native("assign", 2)
  native("own", 1)
  native("goto", 2)
  native("label", 1)
  native("base", 2)
  native("theme", 2)
  native("report", 3)
  native("**", 1)
  native("=", 1)
  ROOT.external = fn_value(fn_make(4, 1, global), -1, 0, 0)
  set_name(global(), "external", ROOT.external)
  return None
)

native_fn (name) => (
  f := map_get(ROOT.natives, name, 0)
  if f == UNDEF { return -1 }
  return f
)

external_fn () => (
  return ROOT.external
)

// ---------------------------------------------------------------- jumps: `goto` raises one to its label; applying too deep raises recursion
Raised := { raised_kind, raised_label, raised_value, raised_src, raised_begin, raised_end, raised_spelled }


is_jump (e) => (
  r := caught(e)
  return r != None and r.raised_kind == 1
)

is_recursion (e) => (
  r := caught(e)
  return r != None and r.raised_kind == 2
)

jump (spelled) => (
  r := alloc(Raised)
  r.raised_kind = 1
  r.raised_label = text_of_node(spelled)
  r.raised_value = UNDEF
  r.raised_src = at_src(spelled)
  r.raised_begin = at_begin(spelled)
  r.raised_end = at_end(spelled)
  r.raised_spelled = global
  raise(r)
)

recursion (src, b, e) => (
  r := alloc(Raised)
  r.raised_kind = 2
  r.raised_src = src
  r.raised_begin = b
  r.raised_end = e
  raise(r)
)

recursion_error (e) => (
  r := caught(e)
  forget(e)
  return error_at("This keeps applying itself.", r.raised_src, r.raised_begin, r.raised_end)
)

jump_label (e) => (
  return caught(e).raised_label
)

jump_value (e) => (
  return caught(e).raised_value
)

jump_set (e, v) => (
  caught(e).raised_value = v
  return None
)

jump_spelled (e) => (
  return caught(e).raised_spelled
)

jump_site (e) => (
  r := caught(e)
  return r.raised_src, r.raised_begin, r.raised_end
)

jump_resite (e, src, b, end) => (
  r := caught(e)
  r.raised_spelled = None
  r.raised_src = src
  r.raised_begin = b
  r.raised_end = end
  return None
)

// ---------------------------------------------------------------- themes: what a style is written as, per theme
theme_open () => (
  theme := scope_of(NIL)
  list_push(ROOT.theme_stack, ROOT.building)
  ROOT.building = map_new()
  map_put(ROOT.themes, theme, 0, ROOT.building)
  return theme
)

theme_close (theme) => (
  ROOT.building = list_pop(ROOT.theme_stack)
  ROOT.theme = theme
  return None
)

themed (into, held) => (
  if !has_style(into) { return None }
  if !has_style(held) { return global }
  building := ROOT.building
  if building == None {
    if ROOT.theme == UNDEF { ROOT.theme = scope_of(NIL) }
    building = map_get(ROOT.themes, ROOT.theme, 0)
    if building == UNDEF {
      building = map_new()
      map_put(ROOT.themes, ROOT.theme, 0, building)
    }
  }
  map_put(building, info(into).side_style, 0, info(held).side_style)
  return global
)

record_definition (global_scope, key) => (
  list_push(ROOT.definitions, global_scope)
  list_push(ROOT.definitions, key)
  return None
)

// ---------------------------------------------------------------- what the runtime gives the language
// A function value is a native of the runtime, a style, a method found by name, or `external` itself.

invoke (f, n, a0, a1, a2, a3, frame, src, b, e) => (
  kind := f.fn_kind
  if kind == 1 { return external_call(f.fn_name, n, a0, a1, a2, a3, frame, src, b, e) }
  if kind == 2 { return style_call(f, arg(n, 0, a0)) }
  if kind == 3 {
    given := a0
    if n == 0 { given = None }
    return apply(f.fn_rule, None, None, None, f.fn_frame, src, b, e, f.fn_capture, given)
  }
  if kind == 4 { return external_of(arg(n, 0, a0), frame) }
  if kind == 5 { return UNDEF }
  unported("function")
)

external_of (name, frame) => (
  if name == UNDEF { return UNDEF }
  key := text_of_node(name)
  f := native_fn(key)
  if f == -1 {
    not_external(name, key)
    return UNDEF
  }
  if f.fn_arity == 0 {
    return external_call(key, 0, UNDEF, UNDEF, UNDEF, UNDEF, frame, at_src(name), at_begin(name), at_end(name))
  }
  return fn_node(f, name)
)

external_call (name, n, a0, a1, a2, a3, frame, src, b, e) => (
  x := arg(n, 0, a0)
  y := arg(n, 1, a1)
  if name == "rule" { return rule_from(x, y, frame) }
  if name == "define" { return define_in(x, y, arg(n, 2, a2), src, b, e, arg(n, 3, a3)) }
  if name == "." {
    stands := side_stands(frame)
    if stands == UNDEF { return frame }
    return stands
  }
  if name == "global" { return global() }
  if name == "none" { return None }
  if name == "declare" { return declare(x, y, frame) }
  if name == "literal" {
    raw(frame)
    held := quiet_deref(x)
    if held == UNDEF { return x }
    return held
  }
  if name == "unordered" or name == "=" { return x }
  if name == "forward" { return forward_fn() }
  if name == "^" {
    held = quiet_deref(x)
    if held == UNDEF { held = x }
    return style(text_of_node(held))
  }
  if name == "inline" { return inline(x, frame, None) }
  if name == "extend" {
    into := deref(x, global)
    if into == UNDEF { return UNDEF }
    return inline(y, into, global)
  }
  if name == "get" {
    key := deref(y, None)
    if key == UNDEF { key = y }
    return get(x, key)
  }
  if name == "assign" { return assign(x, y) }
  if name == "own" {
    at := location(x)
    if at == UNDEF or !is_place(at) { return None }
    held = own(place_scope(at), place_name(at))
    return held != UNDEF and !is_hole(held)
  }
  if name == "goto" {
    met := deref(y, None)
    if met == UNDEF or met == None { return UNDEF }
    spelled := deref(x, None)
    if spelled == UNDEF { spelled = x }
    jump(spelled)
  }
  if name == "label" { return UNDEF }
  if name == "base" {
    target := deref(x, global)
    if target != UNDEF { set_base(target, y) }
    return target
  }
  if name == "theme" {
    theme := theme_open()
    inline(y, scope_of(global()), None)
    theme_close(theme)
    return theme
  }
  if name == "report" { return report(x, y, arg(n, 2, a2), src, b, e) }
  if name == "**" { return program_of(x) }
  unported(name)
)

quiet_deref (node) => (
  silent(1)
  held := deref(node, None) catch err {
    silent(-1)
    rethrow(err)
  }
  silent(-1)
  return held
)

style_call (f, target) => (
  if target == UNDEF { return UNDEF }
  at := UNDEF
  if is_code(target) and !is_program(target) { at = location(target) }
  if at != UNDEF and is_place(at) { return decorate(at, f.fn_self) }
  return decorate(target, f.fn_self)
)

decorate (target, style) => (
  held := target
  if is_place(target) or is_code(target) { held = quiet_deref(target) }
  if held != UNDEF and holds_rule(held) { return target }
  if is_place(target) { return place_copy(target) }
  return target
)

report (level, variable, comment, src, b, e) => (
  ws := -1
  wb := 0
  we := 0
  w := written(variable)
  if w != UNDEF and is_code(w) {
    ws = at_src(w)
    wb = at_begin(w)
    we = at_end(w)
  }
  if ws < 0 and variable != UNDEF {
    v := quiet_deref(variable)
    if v == UNDEF { v = variable }
    ws = at_src(v)
    wb = at_begin(v)
    we = at_end(v)
  }
  if ws < 0 and comment != UNDEF {
    ws = at_src(comment)
    wb = at_begin(comment)
    we = at_end(comment)
  }
  if ws < 0 {
    ws = src
    wb = b
    we = e
  }
  said := UNDEF
  if comment != UNDEF {
    said = quiet_deref(comment)
    if said == UNDEF { said = comment }
  }
  spelled := UNDEF
  if level != UNDEF {
    spelled = deref(level, None)
    if spelled == UNDEF { spelled = level }
  }
  complain_with(spelled, said, ws, wb, we)
  return comment
)

// The operators that bind looser than a rule: the latest of each spelling in reach written before it, and those written anywhere before it.
// The spellings of operators that bind looser than a rule, as frames reaching the same rules see them: laid out once per reach and rule.

looser (frame, rule) => (
  latest := keymap_new()
  looser_visit(frame, latest, stamp())
  order := rule.rule_order
  same := keymap_get(latest, rule)
  if same != -1 and same.rule_order > order { order = same.rule_order }
  out := list_new()
  if rule.rule_operator != -1 { list_push(out, rule.rule_operator) }
  n := keymap_len(latest)
  k := 0
  while k < n {
    other := keymap_at(latest, k)
    if other.rule_order < order { list_push(out, other.rule_operator) }
    k = k + 1
  }
  n = written_len()
  k = 0
  while k < n {
    if !written_known(latest, k) and written_order(k) < order and !list_has(out, written_operator(k)) { list_push(out, written_operator(k)) }
    k = k + 1
  }
  keymap_free(latest)
  return out
)

looser_visit (scope, latest, seen) => (
  at := scope
  while at != -1 and !marked(at, seen) {
    mark(at, seen)
    r := kind_count(at, 2)
    while r > 0 {
      r = r - 1
      other := kind_rule(at, 2, r)
      if global {
        same := keymap_get(latest, other)
        if same == -1 or same.rule_order < other.rule_order { keymap_set(latest, other) }
      }
    }
    n := sees_len(at)
    k := 0
    while k < n {
      looser_visit(sees_at(at, k), latest, seen)
      k = k + 1
    }
    at = parent(at)
  }
  return None
)

lookup_quietly (frame, place, also_trying) => (
  silent(1)
  if also_trying { trying(1) }
  r := lookup(frame, place_name(place), -1, 0, 0) catch e {
    silent(-1)
    if also_trying { trying(-1) }
    rethrow(e)
  }
  silent(-1)
  if also_trying { trying(-1) }
  return r
)

target_of (value) => (
  if is_place(value) or is_code(value) { return deref(value, None) }
  return value
)


rule_key_at (scope, k) => (
  return side_rule(scope, k).rule_key
)

guard_names (rule, state) => (
  return naming_first_is(state, rule.rule_guard_src, rule.rule_guard_begin, rule.rule_guard_end)
)

// What was said and defined, for whoever runs the reader to print.
recursion_said (r) => (
  return error_at("This keeps applying itself.", r.raised_src, r.raised_begin, r.raised_end)
)
