// nand is the only primitive; the rest is written from it.

mark ^keyword := external global

unless true !&& false { INFO@mark `BB1 nand(true,false) should be true` }
if true !&& true { INFO@mark `BB2 nand(true,true) should be false` }
unless false !&& false { INFO@mark `BB3 nand(false,false) should be true` }
unless false !&& true { INFO@mark `BO1 nand(false,true) should be true` }
if !true { INFO@mark `BB4 not(true) should be false` }
unless !false { INFO@mark `BB5 not(false) should be true` }
unless true && true { INFO@mark `BB6 and(true,true) should be true` }
if true && false { INFO@mark `BB7 and(true,false) should be false` }
if false && true { INFO@mark `BO2 and(false,true) should be false` }
if false && false { INFO@mark `BO3 and(false,false) should be false` }
unless true || false { INFO@mark `BB8 or(true,false) should be true` }
if false || false { INFO@mark `BB9 or(false,false) should be false` }
unless false || true { INFO@mark `BO4 or(false,true) should be true` }
unless true || true { INFO@mark `BO5 or(true,true) should be true` }
unless true x|| false { INFO@mark `BB10 xor(true,false) should be true` }
if true x|| true { INFO@mark `BB11 xor(true,true) should be false` }
unless false x|| true { INFO@mark `BO6 xor(false,true) should be true` }
if false x|| false { INFO@mark `BO7 xor(false,false) should be false` }
unless true x!|| true { INFO@mark `BB12 xnor(true,true) should be true` }
unless false x!|| false { INFO@mark `BO8 xnor(false,false) should be true` }
if false x!|| true { INFO@mark `BO9 xnor(false,true) should be false` }
if true !|| false { INFO@mark `BB13 nor(true,false) should be false` }
unless false !|| false { INFO@mark `BO10 nor(false,false) should be true` }
if false !|| true { INFO@mark `BO11 nor(false,true) should be false` }
if true !|| true { INFO@mark `BO12 nor(true,true) should be false` }
unless true && !false { INFO@mark `BB16 true && !false should be true` }

unless !!true { INFO@mark `BO21 not not true is not true` }
if !!false { INFO@mark `BO22 not not false is true` }
unless true == true { INFO@mark `BO23 true is not itself` }
if true == false { INFO@mark `BO24 true is false` }
unless true { INFO@mark `BO25 true is not there` }
if false { INFO@mark `BO26 false holds as a condition` }
if None { INFO@mark `BO27 nothing is there` }
unless !None { INFO@mark `BO28 asking whether nothing is there answers nothing` }

// A rule with two operators written in it is a ternary
{a} %% {b} ## {c} => a ? b : c
unless true %% true ## false { INFO@mark `BT1 a ternary does not take its first answer` }
if false %% true ## false { INFO@mark `BT2 a ternary does not take its second answer` }
unless true ? true : false { INFO@mark `BT3 c ? a : b does not take a when c holds` }
if false ? true : false { INFO@mark `BT4 c ? a : b takes a when c does not hold` }
held := false
unless held ? false : true { INFO@mark `BT5 c ? a : b does not take b for a named c` }

unless None ?? true { INFO@mark `BN1 ?? does not fall back on nothing` }
if false ?? true { INFO@mark `BN2 ?? replaces a value that is there` }
maybe: boolean? = None
unless maybe ?? true { INFO@mark `BN3 ?? does not fall back on an optional left empty` }

unless true.next == false { INFO@mark `BOR1 true.next should be false` }
unless false.next == true { INFO@mark `BOR2 false.next should be true` }
unless true.next.next == true { INFO@mark `BOR3 true.next.next should be true` }
unless false.next.next == false { INFO@mark `BOR4 false.next.next should be false` }
unless true.previous == false { INFO@mark `BOR5 true.previous should be false` }
unless false.previous == true { INFO@mark `BOR6 false.previous should be true` }
unless true as Binary == ₂1 { INFO@mark `BOR7 true is not the bit one` }
unless false as Binary == ₂0 { INFO@mark `BOR8 false is not the bit zero` }
