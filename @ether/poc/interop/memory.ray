// Memory: bytes, an address a place among them; a value of more than one byte is its bytes the least significant first
// (little-endian). Read signed, a negative value is made from its bytes' complements, so no number is larger than it is.
loaded (memory, address, count, signed) =>
  load_negative := signed && (memory.memory_byte((address + count) - 1) >= 128)
  load_value := 0
  load_left := count
  while load_left > 0 {
    load_left = load_left - 1
    load_byte := memory.memory_byte(address + load_left)
    load_value = (load_value * 256) + (load_negative ? (255 - load_byte) : load_byte)
  }
  load_negative ? ((((0 - load_value) as Integer) - 1) as Integer) : load_value
store (memory, address, count, value) =>
  store_index := 0
  while store_index < count {
    memory.memory_placed(address + store_index, value.byte_at(store_index))
    store_index = store_index + 1
  }
  value
