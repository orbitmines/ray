Debian := class {
  // Debian Policy 5.6.12, Version (https://www.debian.org/doc/debian-policy/ch-controlfields.html#version)
  static Version := class (text: (!" " && !")" && !"," && !\n)[]) => {
    epoch => text ~= ":" ? text.before(":") as Number : 0
    rest => text ~= ":" ? text.after(":") : text
    upstream => rest ~= "-" ? rest.split("-")[..<-1].join("-") as String : rest
    revision => rest ~= "-" ? rest.split("-").last as String : "0"

    static weight (c) => c == "~" ? -1 : c is Char.Letter ? c as Number : c as Number + 256
    static lexically (a: String, b: String) => a.empty && b.empty ? 0 : ((a.empty ? 0 : weight(a.first)) - (b.empty ? 0 : weight(b.first))) -- (d => d != 0 ? d : lexically(a.rest, b.rest))
    static compared (a: String, b: String) => a.empty && b.empty ? 0 : (a ~= ⊢ (lexical: (!Char.Digit)[], numeral: Char.Digit[], remaining: *)) -- (x => (b ~= ⊢ (lexical: (!Char.Digit)[], numeral: Char.Digit[], remaining: *)) -- (y =>
      lexically(x.lexical, y.lexical) -- (l => l != 0 ? l : ((x.numeral as Number ?? 0) - (y.numeral as Number ?? 0)) -- (n => n != 0 ? n : compared(x.remaining, y.remaining)))))
    ordered (other: Version) => epoch != other.epoch ? epoch - other.epoch : compared(upstream, other.upstream) -- (u => u != 0 ? u : compared(revision, other.revision))

    chainable == (other: Version) => ordered(other) == 0
    chainable < (other: Version) => ordered(other) < 0
  }

  // Debian Policy 7.1, Syntax of relationship fields (https://www.debian.org/doc/debian-policy/ch-relationships.html)
  static Relation := class (name: (Char.Word | "-" | "." | "+")[], (":", qualifier: Char.Word[])?, " "[], ("(", " "[], operator: "<<" | "<=" | "=" | ">=" | ">>" | "<" | ">", " "[], version: Version, " "[], ")")?, " "[], ("[", architectures: (!"]")[], "]")?, " "[], ("<", profiles: (!">")[], ">")?) => {
    admits (v) => (v as Version) -- (v =>
      !operator ? true
      : operator == ">>" ? version < v
      : operator == "<<" ? v < version
      : operator == "=" ? v == version
      : operator is (">=" | ">") ? !(v < version)
      : !(version < v))
    dependency (kind: String) => Project.Dependency(location: "apt/" + name, version: (this if operator), kind)
  }
  static Relations := class ((alternatives: (choices: Relation[].join((" "[], "|", " "[])))[]).join((" "[], ",", (" " | \n)[]))) => {
    dependencies (kind: String) => alternatives.map(alternative => alternative.choices.first.dependency(kind) ~~ (.alternatives = alternative.choices.rest.map(.dependency(kind))))
  }

  // Debian Policy 5.1, Syntax of control files (https://www.debian.org/doc/debian-policy/ch-controlfields.html#syntax-of-control-files)
  static Field := class (name: (!":" && !\n && !" " && !"#")[], ":", " "[], value: (!\n)[], continuation: (\n, " " | \t, line: (!\n)[])[]) => {
    text => (value, continuation.map(\n, .line.trimmed == "." ? "" : .line.trimmed)) as String
  }
  static Paragraph := class ((fields: (Field | ("#", (!\n)[]))[]).join(\n)) => {
    [name: String] => fields{is Field && .name.fold_case == name.fold_case}.last?.text
  }
  static Control := class ((paragraphs: Paragraph[]).join(\n[]{length > 1}), \n[]) => { }

  static kinds = ["Pre-Depends", "Depends", "Recommends", "Suggests", "Build-Depends", "Build-Depends-Indep"]
}
