// The terminal renderer: a scene drawn into a grid of cells, written as ANSI escape sequences
UI.TUI := class {
  Grid := class width: Number, height: Number, cells: ANSI.Cell[][] = (0 ..< height).map(grid_row => (0 ..< width).map(grid_column => ANSI.Cell())), graphics: (at: Geometry.Vector, bytes: *)[] = [], title: String? = UI.page.title {
    space => Geometry.Space.grid(Geometry.Vector(width, height))
    inside (at: Geometry.Vector) => space.holds(at)
    put (at: Geometry.Vector, cell: ANSI.Cell) => cells[at.y][at.x] = cell if inside(at)
    cell (at: Geometry.Vector) => inside(at) ? cells[at.y][at.x] : ANSI.Cell()
    background (at: Geometry.Vector, color: Geometry.Color?) => put(at, cell(at) ~~ .background = color)
    underlined (at: Geometry.Vector) => put(at, cell(at) ~~ .styles |= ANSI.Attribute.underlined)
    linked (at: Geometry.Vector, to: Location) => put(at, cell(at) ~~ .link = to)
    faded (at: Geometry.Vector, amount: Probability) => cell(at) -- (cell => put(at, cell ~~ .foreground = cell.foreground.mix(cell.background, 1 - amount)))
    shaded (at: Geometry.Vector) => cell(at) -- (cell => put(at, cell ~~ .background = (cell.background ?? Geometry.Color(0, 0, 0)).mix(Geometry.Color(0, 0, 0), 0.5)))
    graphic (at: Geometry.Vector, bytes) => graphics.push (at: at, bytes: bytes)
    changes (before: Grid?) => (0..<height).map(y => (0..<width){!before || cells[y][.] != before.cells[y][.]}.map(x => [[Geometry.Vector(x, y)], cells[y][x]])).flatten(1)
    framed (previous: Grid? = None) => [
      ANSI.Title(title) if (title && title != previous.title),
      changes(previous).map((at, cell) => [ANSI.Move(row: at.y + 1, column: at.x + 1), cell as ANSI.Style, ANSI.Hyperlink(target: (cell.link === None ? "" : (cell.link as String))), cell.glyph]),
      graphics{!(previous.graphics.contains(.) ?? false)}.map([ANSI.Move(row: .at.y + 1, column: .at.x + 1), .bytes]),
      ANSI.Style()
    ]
  }
  static px_per_cell = Geometry.Vector(8px, 16px)
  // (in whole cells: where it starts, the cell it starts in; how large, the cells it covers)
  static gridded (length: Geometry.Vector) => Geometry.Vector((length.x as Unit.column).amount.floor, (length.y as Unit.row).amount.floor)
  static covered (length: Geometry.Vector) => Geometry.Vector((length.x as Unit.column).amount.ceil, (length.y as Unit.row).amount.ceil)

  Geometry.Shape &+= {
    cell_at => UI.TUI.gridded(Geometry.Space.screen.seen(at, root.size, size))
    cell_size => UI.TUI.covered(size)
    cell_area => Geometry.Space.grid(cell_size).positions.map(offset => offset + cell_at){cell => contains(Geometry.Space.screen.seen((cell - cell_at) * UI.TUI.px_per_cell, size, UI.TUI.px_per_cell))}
    cell_writes => Compiler.reduced(this, UI.Lowered) -- (shape => [
      Compiler.reduced(shape.painted(shape.fill), UI.TUI.filled(shape)) if shape.fill,
      shape.cell_border if shape.stroke,
      shape.effects.map(effect => Compiler.reduced(effect, UI.TUI.shaded(shape))),
      Compiler.reduced(shape, UI.TUI.shown) if shape.content,
      shape.in_place.sort_by(.layer).map(.cell_writes) if shape.visible,
      shape.cell_scrollbar if ((shape.overflow === scroll) && shape.scrollbar),
      shape.cell_area.map(at => (written_grid => written_grid.underlined(at))) if shape.focused,
      shape.cell_area.map(at => (written_grid => written_grid.linked(at, shape.content))) if (shape.content is Location)
    ])
    cell_border => {
      corners = radius != [0] ? "╭╮╰╯" : "┌┐└┘"
      from = cell_at
      to = from + cell_size - Geometry.Vector(1, 1)
      ink = painted(stroke.paint) as Geometry.Color
      sides = stroke.sides#
      [
        (from.x..to.x).map(x => (written_grid => written_grid.underlined(Geometry.Vector(x, to.y)))) if sides == [Geometry.bottom],
        (from.x + 1..<to.x).map(x => (written_grid => written_grid.put(Geometry.Vector(x, from.y), ANSI.Cell("─", foreground: ink)))) if sides.contains(Geometry.top),
        (from.x + 1..<to.x).map(x => (written_grid => written_grid.put(Geometry.Vector(x, to.y), ANSI.Cell("─", foreground: ink)))) if sides.contains(Geometry.bottom) && sides != [Geometry.bottom],
        (from.y + 1..<to.y).map(y => (written_grid => written_grid.put(Geometry.Vector(from.x, y), ANSI.Cell("│", foreground: ink)))) if sides.contains(Geometry.left),
        (from.y + 1..<to.y).map(y => (written_grid => written_grid.put(Geometry.Vector(to.x, y), ANSI.Cell("│", foreground: ink)))) if sides.contains(Geometry.right),
        [(from, 0), (Geometry.Vector(to.x, from.y), 1), (Geometry.Vector(from.x, to.y), 2), (to, 3)].map((at, i) => (written_grid => written_grid.put(at, ANSI.Cell(corners[i], foreground: ink)))) if sides.count == Geometry.all#.count
      ]
    }
    // (the thumb: the row as far down the cells as what is scrolled is down the content)
    cell_scrollbar =>
      scrolled_down := (scrolled.y is Number) ? scrolled.y : (scrolled.y as pixel).amount
      thumb := (scrolled_down / (content_height as pixel).amount * cell_size.y).floor
      (0 ..< cell_size.y).map(y => (written_grid => written_grid.put(cell_at + Geometry.Vector(cell_size.x - 1, y), ANSI.Cell((y == thumb) ? "┃" : "│"))))
  }

  drawn := {
    // (the root, then what is lifted above it: built by appending, a Shape being a Ray `[root, …]` would read its elements)
    {root: Geometry.Shape{solved && !parent}} =>
      drawn_shapes := [root]
      root.lifted.for(lifted_shape => drawn_shapes.append(lifted_shape))
      Grid((root.size.x as Unit.column).amount, (root.size.y as Unit.row).amount) ~~ (grid => drawn_shapes.map(drawn_shape => drawn_shape.cell_writes).flatten.for(write => grid ~~ write))
  }
  filled (shape: Geometry.Shape) => {
    {color: Geometry.Color} => shape.cell_area.map(at => (written_grid => written_grid.background(at, color)))
    {gradient: Geometry.Gradient} => shape.cell_area.map(at => (written_grid => written_grid.background(at, gradient.at((at.x - shape.cell_at.x) / shape.cell_size.x))))
    {sampled: Geometry.Pointwise} => shape.cell_area.map(at => sampled(Geometry.Space.screen.seen((at - shape.cell_at) * px_per_cell, shape.size, px_per_cell)) -- (color =>
      (written_grid => written_grid.put(at, ANSI.Cell(ramp[color.alpha * color.luminance * (ramp.length - 1) / 255], foreground: color)))))
    {paint} => []
  }
  shaded (shape: Geometry.Shape) => {
    {filter: Geometry.Opacity} => shape.cell_area.map(at => (written_grid => written_grid.faded(at, filter.amount)))
    {shadow: Geometry.Shadow} => shape.cell_area.map(at => (written_grid => written_grid.shaded(at + gridded(Geometry.Space.screen.seen(shadow.offset)))))
    {effect} => []
  }
  shown := {
    {text: Geometry.Shape{content is String}} => text.lines(text.size.x).enumerate.map(row => row.value.enumerate.map(glyph =>
      (UI.Theme.face(text, glyph.value), text.cell_at + Geometry.Vector(row.value.sliced(0, glyph.index - 1).map(.columns).sum, row.index)) -- ((look, at) => ANSI.Cell(text.case ? text.case(glyph.value) : glyph.value,
        foreground: text.painted(look.color) as Geometry.Color, background: text.painted(look.fill) as Geometry.Color,
        styles: (ANSI.Attribute.bold if (look.font.weight is Number) && look.font.weight >= 600) | (ANSI.Attribute.italic if look.font.style === italic) | (ANSI.Attribute.negative if look.styles.contains("selected"))) -- (written => (written_grid => written_grid.put(at, written))))
    )).flatten
    {canvas: Geometry.Shape{content is Program && !(content is Choice)}} => canvas.content.rendered(Language.Direct.level) -- (rows => canvas.cell_area.map(at => (at - canvas.cell_at) -- (dot =>
      ANSI.Cell(braille(rows[dot.y * 4 ..< dot.y * 4 + 4].map(.[dot.x * 2 ..< dot.x * 2 + 2].map(.alpha > 0)))) -- (written => (written_grid => written_grid.put(at, written)))
    )))
    {shape: Geometry.Shape} => []
  }
  Cells := Geometry.Preparing(px_per_cell.x min px_per_cell.y) + drawn
  level := Cells

  static braille (dots: boolean[][]) => (0x2800 + [[0, 3], [1, 4], [2, 5], [6, 7]].zip(dots).map((bits, row) => row.zip(bits).map((on, bit) => on ? 2 ^ bit : 0).sum).sum) as Char
  static ramp = " .:-=+*#%@"

  // DECSET and DECRST (xterm, "CSI ? Pm h" and "CSI ? Pm l"): 1049 the alternate screen, 25 the cursor, 1000/1002/1006 mouse reports, 2004 bracketed paste, 1004 focus events
  Start := class modes: ANSI.Mode[] = [ANSI.Mode(1049, "h"), ANSI.Mode(25, "l"), ANSI.Mode(1000, "h"), ANSI.Mode(1002, "h"), ANSI.Mode(1006, "h"), ANSI.Mode(2004, "h"), ANSI.Mode(1004, "h")]
  Stop := class start: Start = Start()
  written := {
    {text: String} => text
    {glyph: Char} => glyph as String
    {started: Start} => Compiler.reduced(started.modes, written) + Compiler.reduced([ANSI.Erase(2), ANSI.Move()], written)
    {stop: Stop} => Compiler.reduced(stop.start.modes.map(.flipped).reverse, written)
    // (SGR: each parameter after a `;`, as the header `("\e[0", parameters: (";", parameter: …)[], "m")` writes it)
    {style: ANSI.Style} => "\e[0" + (style.parameters ?? []).map(written_parameter => ";" + Compiler.reduced(written_parameter.parameter, written)).join("") + "m"
    {attribute: ANSI.Attribute} => attribute.code
    // (its header's choice of groups is not read into the header yet (A3): written here as the header says)
    {colored: ANSI.Colored} => colored.layer + ((colored.index === None) ? (";2;" + colored.red + ";" + colored.green + ";" + colored.blue) : (";5;" + colored.index))
    {sequences: Iterable} => sequences.map(sequence => sequence === None ? "" : Compiler.reduced(sequence, UI.TUI.written)).join("")
    {sequence} => sequence as String
  }
  // Windows Terminal's win32-input-mode, DECSET 9001 (https://github.com/microsoft/terminal/blob/main/doc/specs/%234999%20-%20Improved%20keyboard%20handling%20in%20Conpty.md)
  WindowsTerminal := {
    {start: Start{!modes.contains(ANSI.Mode(9001, "h"))}} => Start([start.modes, [ANSI.Mode(9001, "h")]].flatten)
  }

  Terminal := class: UI.Interface written: Compiler = UI.TUI.written, grid: Grid? = None {
    emit (bytes) => @me/instance = bytes
    dynamically typed = @me/instance
    size =>
      columns := (OS.host.env.COLUMNS) as Number
      lines := (OS.host.env.LINES) as Number
      Geometry.Vector(columns, lines)
    emitted (value) => emit(Compiler.reduced(value, written))
    // (the scene is as large as the terminal: its columns and rows)
    start =>
      UI.scene.size = Geometry.Vector(Quantity(quantities: [(quantity: size.x, unit: Unit.column)]), Quantity(quantities: [(quantity: size.y, unit: Unit.row)]))
      emitted(Start())
        -- ({ emitted(@me/device/clipboard as ANSI.Copy) } when @me/device/clipboard changes)
        -- ({ (@me/device/opened).held() } when @me/device/opened changes)
    stop => emitted(Stop())
    write (frame: Grid) =>
      emitted(frame.framed(grid))
      grid = frame
    // (input that has ended reads as nothing: the program is done, so a run with nothing to read writes one frame and returns)
    read => typed ? ((typed ~= (events: Event[])) -- .events.for(Compiler.reduced(., applied))) : (UI.program ? UI.program.stop : None)
  }

  Browser := {
    {grid: Grid} => UI.HTML.Package([(path: "index.html", content: $.html.Document(head: [], body: $.html.Element("body", [], [$.html.Element("pre", [], [$.html.Text(grid.cells.map(.map(.glyph) as String).join(\n))])])))])
  }

  Event := ANSI.Input | Resize
  ANSI.Key &+= {
    name => Compiler.reduced(this, UI.TUI.named)
  }
  ANSI.Mouse &+= {
    position => Geometry.Space.screen.seen(Geometry.Vector(cell.x * px_per_cell.x, cell.y * px_per_cell.y), UI.scene.size, px_per_cell)
  }
  Resize := class

  named := {
    {key: ANSI.Key{page == "5"}} => @me/device/keyboard/PageUp
    {key: ANSI.Key{page == "6"}} => @me/device/keyboard/PageDown
    {key: ANSI.Key{alt}} => @me/device/keyboard[key.alt as String]
    {key: ANSI.Key{lettered}} => @me/device/keyboard[((key.code as Number) + 96) as Char as String]
    {key: ANSI.Key{code == "A"}} => @me/device/keyboard/ArrowUp
    {key: ANSI.Key{code == "B"}} => @me/device/keyboard/ArrowDown
    {key: ANSI.Key{code == "C"}} => @me/device/keyboard/ArrowRight
    {key: ANSI.Key{code == "D"}} => @me/device/keyboard/ArrowLeft
    {key: ANSI.Key{code == "Q"}} => @me/device/keyboard/F2
    {key: ANSI.Key{code == "\r"}} => @me/device/keyboard/Enter
    {key: ANSI.Key{code is ("\t" | "Z")}} => @me/device/keyboard/Tab
    {key: ANSI.Key} => @me/device/keyboard.coded(key.code as Number)
  }

  // A terminal reports no key release: a key read is pressed and released
  applied := {
    {key: ANSI.Key} => key.name.press((Keyboard.Modifier.shift if key.shift || key.code == "Z") | (Keyboard.Modifier.control if key.control) | (Keyboard.Modifier.alt if key.alt != None)).release
    {mouse: ANSI.Mouse{button >= 64}} => @me/device/pointer["mouse"].wheel = Geometry.Vector(y: mouse.button == 64 ? 1 : -1)
    {mouse: ANSI.Mouse{state == "m"}} => @me/device/pointer["mouse"].to(mouse.position, pressing: [])
    {mouse: ANSI.Mouse{button >= 32}} => @me/device/pointer["mouse"].to(mouse.position)
    {mouse: ANSI.Mouse} => @me/device/pointer["mouse"].to(mouse.position, pressing: [mouse.button])
    {paste: ANSI.Paste} => (@me/device/clipboard = paste.text) -- UI.focus.content.typed(paste.text)
    {focus: ANSI.FocusChange} => @me/device/preferences.focused = focus.state == "I"
    {resize: Resize} => UI.scene.size = Geometry.Vector(@me/device/terminal.size.x * px_per_cell.x, @me/device/terminal.size.y * px_per_cell.y)
  }
}

Unit(name: "column")
  .convert(((x: Number) => x * (UI.TUI.px_per_cell.x as pixel).amount), pixel)
Unit(name: "row")
  .convert(((x: Number) => x * (UI.TUI.px_per_cell.y as pixel).amount), pixel)

Device &+= {
  terminal: UI.TUI.Terminal = UI.TUI.Terminal(level: UI.TUI.level)
}
