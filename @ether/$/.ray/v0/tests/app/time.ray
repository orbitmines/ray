mark ^keyword := external global

unless second is Unit.Temporal { INFO@mark `TI1 a second is not temporal` }
unless 5 seconds . is Quantity.Temporal { INFO@mark `TI14 five seconds is not temporal` }
unless 1 hour as seconds == 3600 s { INFO@mark `TI3 an hour is not counted in seconds` }
unless 1 day == 24 hours { INFO@mark `TI5 a day is not twenty-four hours` }
unless 1 hour == 60 minutes { INFO@mark `TI6 an hour is not sixty minutes` }
unless 1 minute == 60 seconds { INFO@mark `TI7 a minute is not sixty seconds` }
unless 1 week == 7 days { INFO@mark `TI13 a week has other than seven days` }

unless Julian(year: 4).is_leap_year { INFO@mark `TI8 the fourth year is not a leap year` }
if Julian(year: 5).is_leap_year { INFO@mark `TI9 the fifth year is a leap year` }
unless Gregorian(year: 4).is_leap_year { INFO@mark `TI10 the fourth year is not a leap year in the Gregorian` }
if Gregorian(year: 100).is_leap_year { INFO@mark `TI17 a hundred is a leap year in the Gregorian` }
unless Julian(year: 100).is_leap_year { INFO@mark `TI18 a hundred is not a leap year in the Julian` }
unless Gregorian(year: 400).is_leap_year { INFO@mark `TI38 four hundred is not a leap year in the Gregorian` }

unless Month#.count == 12 { INFO@mark `TI12 a year has other than twelve months` }
unless Weekday#.first == Monday { INFO@mark `TI28 a week does not begin on monday` }
unless Weekday#.last == Sunday { INFO@mark `TI29 a week does not end on sunday` }
if Monday == Tuesday { INFO@mark `TI30 two weekdays are the same day` }
(
  with Time.YEAR = 2024
  unless 1 month as days == 31 days { INFO@mark `TI26 january in a leap year is not thirty-one days` }
  (
    with Time.MONTH = February
    unless 1 month as days == 29 days { INFO@mark `TI23 february in a leap year is other than twenty-nine days` }
  )
)
(
  with { Time.YEAR = 2023, Time.MONTH = February }
  unless 1 month as days == 28 days { INFO@mark `TI24 february in a plain year is other than twenty-eight days` }
)

unless "2024-01-01" as ISO_8601 .day_of_year == 1 { INFO@mark `TI42 the first of january is not the first day of the year` }
unless "2024-02-01" as ISO_8601 .day_of_year == 32 { INFO@mark `TI43 the first of february is not the thirty-second day` }
unless "2024-03-01" as ISO_8601 .day_of_year == 61 { INFO@mark `TI44 the first of march in a leap year is not the sixty-first day` }
unless "2023-03-01" as ISO_8601 .day_of_year == 60 { INFO@mark `TI45 the first of march in a plain year is not the sixtieth day` }
unless "2024-02-07" as ISO_8601 .year == 2024 { INFO@mark `TI66 the year written first is not read` }
unless "2024-02-07" as ISO_8601 .month == February { INFO@mark `TI67 the second month written is not February` }
unless "2024-02-07" as ISO_8601 .day_of_month == 7 { INFO@mark `TI68 the day written last is not read` }
if "2024-02-07" as ISO_8601 == "2024-02-08" as ISO_8601 { INFO@mark `TI70 two dates a day apart are the same` }
unless "2024-W06-3" as ISO_8601 == "2024-02-07" as ISO_8601 { INFO@mark `TI80 a week date is not the calendar date it names` }
unless "12:00" as ISO_8601 as String == "12:00" { INFO@mark `TI81 a time of day does not print without its date` }
unless 12:00 == 12 hours { INFO@mark `TI82 12:00 is not twelve hours` }
unless 12:00:30 == 12 hours 30 seconds { INFO@mark `TI83 12:00:30 is not twelve hours and thirty seconds` }

five := Time(calendar: Julian) = 5 seconds
eight := Time(calendar: Julian) = 8 seconds
unless five == five { INFO@mark `TI46 a time is not itself` }
if five == eight { INFO@mark `TI47 two times are the same` }
unless five < eight { INFO@mark `TI48 five seconds in is not before eight` }
unless eight - five == 3 seconds { INFO@mark `TI50 the three seconds between them are not three` }
unless five + 3 seconds == eight { INFO@mark `TI51 five seconds on plus three is not eight` }
unless (Time(calendar: Julian, epoch: five) = 2 seconds).since_calendar_epoch == 7 seconds { INFO@mark `TI55 two seconds after five is not seven since the start` }
unless (Time(epoch: "2000-01-01") = "2025-01-01").years == 25 { INFO@mark `TI84 twenty-five years after 2000 are not 25 years` }
unless (Time(calendar: Julian) = 120 seconds).round(minute) == 2 minutes { INFO@mark `TI85 two minutes rounded to minutes moved` }
eighty := (Time(calendar: Julian, epoch: five) = 80 seconds).round(minute)
unless eighty == (Time(calendar: Julian, epoch: five) = 60 seconds) { INFO@mark `TRO1 eighty seconds do not round down to a minute` }
unless (Time(calendar: Julian) = 95 seconds).round(minute) == (Time(calendar: Julian) = 120 seconds) { INFO@mark `TRO2 ninety-five seconds do not round up to two minutes` }
unless eighty.calendar == Julian { INFO@mark `TRO3 rounding lost the calendar` }
unless eighty.unit == second { INFO@mark `TRO4 rounding changed the unit it counts in` }
unless (Time(calendar: Julian) = 120 seconds).round(minute) == (Time(calendar: Julian) = 120 seconds) { INFO@mark `TRO5 a whole multiple moved when rounded` }
unless (Time(calendar: Julian) = 90 seconds).round(minute) == (Time(calendar: Julian) = 120 seconds) { INFO@mark `TRO6 half a minute does not round up` }
unless eighty.epoch == five { INFO@mark `TRO7 rounding lost the epoch` }
finer := (Time(calendar: Julian) = 2 minutes).round(second)
unless finer.unit == second { INFO@mark `TRO8 rounding to a finer unit did not convert to it` }
unless finer == (Time(calendar: Julian) = 120 seconds) { INFO@mark `TRO9 two minutes rounded to seconds are not 120 seconds` }

unless "1582-10-04" as Julian + 1 day as Gregorian == "1582-10-15" as Gregorian { INFO@mark `TI52 the day after the last Julian day is not the first Gregorian one` }
unless UTC().offset == 0 { INFO@mark `TI19 UTC is at some offset` }
unless GMT == UTC { INFO@mark `TI40 GMT is not UTC` }
if UTC.leap_seconds { INFO@mark `TI41 UTC counts leap seconds` }
if GMT.leap_seconds { INFO@mark `TI78 the zone without leap seconds has them` }
unless Julian.week.is_recurring { INFO@mark `TI57 the weekdays do not recur` }
if Julian.hour.is_recurring { INFO@mark `TI58 an hour of sixty minutes recurs` }
unless Julian.month.EPOCH == 1 && "2024-01-01" as ISO_8601 .month == January && January.index + 1 == 1 { INFO@mark `TI59 a segment does not start at one: January is not month 1` }
unless (UTC(offset: 3 seconds) = 0) - (UTC() = 0) == 3 seconds { INFO@mark `TI79 three seconds past the agreed point is not three seconds past the other` }

unless Time.now <= Time.now { INFO@mark `TI86 the clock went back` }
unless now <= Time.now { INFO@mark `TI89 now read bare is after the clock read again` }
noon := "2024-02-07T12:00:00Z" as ISO_8601 as Time
unless 9:00 <= noon <= 17:00 { INFO@mark `TI90 noon on any day is not between 9:00 and 17:00` }
if 13:00 <= noon { INFO@mark `TI91 noon is after 13:00` }
unless Gregorian(year: 2023).days_in_year == 365 { INFO@mark `TI73 an ordinary year is not three hundred and sixty-five days` }
unless Gregorian(year: 2024).days_in_year == 366 { INFO@mark `TI74 a leap year is not a day longer` }
unless Gregorian(year: 2023).weeks_in_year == 52 { INFO@mark `TI75 a year is not fifty-two weeks` }
unless February.days_in(Gregorian(year: 2024)) == 29 { INFO@mark `TI92 February 2024 does not have twenty-nine days` }
unless Gregorian(year: 2024).weekday_of(1) == Monday { INFO@mark `TI93 the first of January 2024 is not a Monday` }
unless ("2024-02-07" as ISO_8601) < ("2024-02-08" as ISO_8601) { INFO@mark `TI94 a date is not before the day after it` }
unless (Time.now.corrected(1 second, within: 1 ns)).uncertainty == 1 ns { INFO@mark `TI95 a corrected time does not keep how certain the correction is` }
unless Mars.days == sol { INFO@mark `TI87 a day on Mars is not a sol` }
unless 1 sol == 88775 seconds { INFO@mark `TI88 a sol is not 88775 seconds` }

Host := class: OS (platform: String)
unless Compiler.reduced(Host("linux"), TimeZone.sources) is TimeZone.Zoneinfo { INFO@mark `TZ1 linux does not read the host's zoneinfo` }
unless Compiler.reduced(Host("darwin"), TimeZone.sources) is TimeZone.Zoneinfo { INFO@mark `TZ2 macos does not read the host's zoneinfo` }
if Compiler.reduced(Host("linux"), TimeZone.sources).directory == OS.Ether().zoneinfo { INFO@mark `TZ3 linux downloads the data instead of reading the host's` }
unless Compiler.reduced(Host("win32"), TimeZone.sources) is TimeZone.ICU { INFO@mark `TZ4 windows does not ask the OS's ICU` }
unless Compiler.reduced(Host("browser"), TimeZone.sources) is TimeZone.Intl { INFO@mark `TZ5 the browser does not ask Intl` }
unless Compiler.reduced(OS.Ether(), TimeZone.sources).directory == OS.Ether().zoneinfo { INFO@mark `TZ6 ether does not download the data` }
unless OS.Ether().name == ether { INFO@mark `TZ7 the language as the operating system is not ether` }
unless TimeZone.Zoneinfo(directory: OS.Ether().zoneinfo).version == "2026c" { INFO@mark `TZ8 the downloaded data is not tzdata 2026c` }

summer := "2024-07-01T12:00:00Z" as ISO_8601 as Time
winter := "2024-01-15T12:00:00Z" as ISO_8601 as Time
with @me/device/os = OS.Ether() {
  amsterdam := TimeZone("Europe/Amsterdam")
  unless amsterdam.at(summer).offset == 2 hours { INFO@mark `TZ9 Amsterdam in summer is not at +02:00 on ether` }
  unless amsterdam.at(summer).abbreviation == "CEST" && amsterdam.at(summer).daylight { INFO@mark `TZ10 Amsterdam in summer is not on CEST` }
  unless amsterdam.at(winter).offset == 1 hour { INFO@mark `TZ11 Amsterdam in winter is not at +01:00 on ether` }
  unless amsterdam.at(winter).abbreviation == "CET" && !amsterdam.at(winter).daylight { INFO@mark `TZ12 Amsterdam in winter is not on CET` }
  unless TimeZone("UTC").at(summer).offset == 0 seconds { INFO@mark `TZ13 UTC is off zero on ether` }
}
unless TimeZone("UTC").at(summer).offset == 0 seconds { INFO@mark `TZ14 UTC is off zero on this host` }
unless [Host("linux"), Host("darwin"), OS.Ether()].every(Compiler.reduced(., TimeZone.sources).at("UTC", winter).offset == 0 seconds) { INFO@mark `TZ15 UTC is off zero on a platform that reads TZif` }

Counting := class: TimeZone.Zoneinfo {
  asked: String[] = []
  data (zone: String) => (asked.push zone) -- $.tzif.read((directory / zone).bytes)
}
counting := Counting(directory: OS.Ether().zoneinfo)
counting.at("Europe/Amsterdam", summer)
unless counting.asked == ["Europe/Amsterdam"] { INFO@mark `TZ16 reading one zone read others than the one asked for` }
unless OS.Ether().zoneinfo == @tzif/zoneinfo { INFO@mark `TZ17 the language as the operating system does not take its zone data from @tzif/zoneinfo` }
if Host("linux").zoneinfo ~= ⊢"tzif" { INFO@mark `TZ18 a host refers to @tzif for its zone data` }
unless Compiler.reduced(Host("plan9"), TimeZone.sources) is Quest { INFO@mark `TZ19 an operating system without time-zone data does not leave it to be found` }
unless Compiler.reduced(Host(""), OS.devices) is OS.Ether { INFO@mark `TZ20 a device with no host platform does not run the language as its operating system` }
