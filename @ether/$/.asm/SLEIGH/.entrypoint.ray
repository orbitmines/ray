// SLEIGH, the language Ghidra describes processors in, read as what it is: a
// language. A `.slaspec` (and the `.sinc` files it includes) is a file of it,
// and the rules below are what its statements mean. What a statement defines
// becomes a name here — a register, a field of an instruction token, a table
// of constructors — so a pattern such as `(cc=1 & aaa=3) ... & OP1` is read
// the way any expression is: `cc` is the field, `=` constrains it, `&` joins
// two constraints, and `OP1` is the table whose constructors it takes.
//
// Numbers a description writes are machine values, so they are read as
// `Bits`; the few that count something (a bit position, a width) are read as
// counts, chains as long as the number, which are cheap at the sizes a token
// has.
//
// A constructor's p-code is translated, once for each encoding it is part
// of, into a goto program (`Goto`, with `PCode.ray`): registers and locals
// are places of the state, memory is bytes, `if (condition) goto target` is
// the one control, and `goto`, `call` and `return` leave the program for an
// address (`Sleigh.program_of`). That program is what runs (`Sleigh.run`,
// `Sleigh.executed`).
//
// spec: not read yet — what the preprocessor means (its lines are passed
// over), `context` fields as context, `with` blocks, `build`, constraints
// other than `=` and `!=`, displays of more than one word, macros of more
// than one parameter, and of p-code: reading `x[low,size]` of a local,
// `&`, `|`, `^`, `!`, shifts, `carry`, overlapping registers, and decimal
// constants other than 0, 1 and 2.

mark ^keyword := external global

// What has been read so far: in the order it is written.
Sleigh := class {
  endian: Node
  alignment: Node
  spaces: Node
  address: Node
  registers: Node
  tokens: Node
  fields: Node
  pcodeops: Node
  macros: Node
  tables: Node
  instructions: Node
  locals: Node

  // The characters of a text, each the eight bits it is written with, most
  // significant first.
  characters (written) => (
    out := chain None
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        out &= byte
        byte = chain None
      }
      true
    )
    external bits written take
    out
  )
  // A count: a chain as long as the number written in decimal.
  counted (written) => Sleigh.counted_from(Sleigh.characters(written))
  // The same, from the characters it is written with.
  counted_from (glyphs) => (
    total := chain None
    character := glyphs.head
    while (exists character) {
      digit := Bits.nibble_of(character.value)
      if (exists digit) {
        tenfold := chain None
        walker := total.head
        while (exists walker) {
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          walker = walker.next
        }
        if digit.head.value { tenfold &= true }
        if digit.head.next.value {
          tenfold &= true
          tenfold &= true
        }
        if digit.head.next.next.value {
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
        }
        if digit.head.next.next.next.value {
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
          tenfold &= true
        }
        total = tenfold
      }
      character = character.next
    }
    total
  )
  // A machine value as it is written: `0x90` in hexadecimal, `0b0110` in
  // binary, `12` in decimal, into bits, least significant first. `x` is
  // 01111000 and `b` is 01100010: both 011, and then apart; a digit is 0011.
  numeral (text) => Sleigh.glyph_number(Sleigh.characters(text))
  // The same, from the characters it is written with.
  glyph_number (glyphs) => (
    second := glyphs.head.next
    marked := false
    sixteen := false
    if (exists second) {
      marked = second.value.head.next.value.and(second.value.head.next.next.value)
      sixteen = marked.and(second.value.head.next.next.next.next.value)
    }
    out := chain None
    if sixteen { out &= Sleigh.hexadecimal(second.next) } elsif marked { out &= Sleigh.binary(second.next) } else { out &= Sleigh.decimal(glyphs.head) }
    out.head.value
  )
  // Hexadecimal digits, most significant first.
  hexadecimal (from) => (
    nibbles := chain None
    walker := from
    while (exists walker) {
      nibbles &= Bits.nibble_of(walker.value)
      walker = walker.next
    }
    out := chain None
    back := nibbles.tail
    while (exists back) {
      Bits.joined(out, back.value)
      back = back.previous
    }
    Bits(bits: out)
  )
  // Characters `0` and `1`, most significant first.
  binary (from) => (
    ordered := chain None
    walker := from
    while (exists walker) {
      ordered &= walker.value.tail.value
      walker = walker.next
    }
    out := chain None
    back := ordered.tail
    while (exists back) {
      out &= back.value
      back = back.previous
    }
    Bits(bits: out)
  )
  // Decimal digits, most significant first: each is ten times what came
  // before it, and itself.
  decimal (from) => (
    total := Bits(bits: Bits.nibble_of(from.value))
    walker := from.next
    while (exists walker) {
      digit := Bits(bits: Bits.nibble_of(walker.value))
      room := Sleigh.widened(total, digit).under(digit.xor(digit))
      twofold := Sleigh.raised(room)
      eightfold := Sleigh.raised(Sleigh.raised(twofold))
      total = Sleigh.sum(Sleigh.sum(eightfold, twofold), digit)
      walker = walker.next
    }
    total
  )
  // A word one bit wider, moved up by one: twice what it was.
  raised (word) => (
    out := chain None
    out &= false
    Bits(bits: Bits.joined(out, word.bits))
  )
  // Two words of any widths added, as wide as the wider.
  sum (one, other) => Sleigh.widened(one, other) + Sleigh.widened(other, one)
  // The bits from `low` to `high` of a word `width` wide: where a field sits
  // in its token.
  span (low, high, width) => (
    out := chain None
    below := low.head
    upto := high.head
    past := false
    walker := width.head
    while (exists walker) {
      inside := (exists below).not.and(past.not)
      out &= inside
      if (exists upto) { upto = upto.next } else { past = true }
      if (exists below) { below = below.next }
      walker = walker.next
    }
    Bits(bits: out)
  )
  // A word as wide as another, or wider: what is missing above is not set.
  widened (word, template) => (
    out := chain None
    mine := word.bits.head
    theirs := template.bits.head
    while ((exists mine).or(exists theirs)) {
      if (exists mine) {
        out &= mine.value
        mine = mine.next
      } else { out &= false }
      if (exists theirs) { theirs = theirs.next }
    }
    Bits(bits: out)
  )
  // No bits set, as wide as a word.
  cleared (word) => (
    out := chain None
    walker := word.bits.head
    while (exists walker) {
      out &= false
      walker = walker.next
    }
    Bits(bits: out)
  )

  // Two patterns that hold at once: every pair of their alternatives that
  // does not fix one bit two ways, as one alternative. The second is read
  // where the last token of the first begins: `a; b & c` is `a; (b & c)`.
  both (lefts, rights) => (
    out := chain None
    left := lefts.head
    while (exists left) {
      both_first := left.value
      both_offset := both_first.start
      moved_rights := rights
      if (exists both_offset) { moved_rights = Sleigh.all_shifted(rights, both_offset) }
      right := moved_rights.head
      while (exists right) {
        joined := Sleigh.joined(both_first, right.value)
        if (exists joined) { out &= joined }
        right = right.next
      }
      left = left.next
    }
    out
  )
  // Alternatives moved up past some bits, as many as `offset` is wide.
  all_shifted (ways, offset) => (
    shifted_ways := chain None
    shifting_way := ways.head
    while (exists shifting_way) {
      shifted_ways &= Sleigh.shifted(shifting_way.value, offset)
      shifting_way = shifting_way.next
    }
    shifted_ways
  )
  shifted (way, offset) => (
    shifted_fields := Sleigh.moved_up(way.fields, offset)
    shifted_start := offset
    if (exists way.start) { shifted_start = offset.under(way.start) }
    Alternative(mask: offset.under(way.mask), match: offset.under(way.match), fields: shifted_fields, parts: way.parts, start: shifted_start)
  )
  // Fields moved up past some bits.
  moved_up (fields_before, offset) => (
    moved_fields := chain None
    shifting := fields_before.head
    while (exists shifting) {
      shifting_field := shifting.value
      moved_fields &= Field(name: shifting_field.name, mask: offset.under(shifting_field.mask))
      shifting = shifting.next
    }
    moved_fields
  )
  // One alternative that is both, or None where they fix a bit two ways. The
  // four words are walked together once; what one of them does not reach is
  // not set.
  joined (one, other) => (
    mask := chain None
    match := chain None
    clash := false
    mine := one.mask.bits.head
    theirs := other.mask.bits.head
    fixed := one.match.bits.head
    given := other.match.bits.head
    while ((exists mine).or(exists theirs)) {
      left := false
      right := false
      left_bit := false
      right_bit := false
      if (exists mine) {
        left = mine.value
        left_bit = fixed.value
        mine = mine.next
        fixed = fixed.next
      }
      if (exists theirs) {
        right = theirs.value
        right_bit = given.value
        theirs = theirs.next
        given = given.next
      }
      if (left.and(right).and(left_bit.xor(right_bit))) { clash = true }
      mask &= left.or(right)
      match &= left_bit.or(right_bit)
    }
    if clash { None } else {
      Alternative(mask: Bits(bits: mask), match: Bits(bits: match), fields: Sleigh.appended(one.fields, other.fields), parts: Sleigh.appended(one.parts, other.parts), start: other.start)
    }
  )
  // Either of two patterns: the alternatives of both.
  either (lefts, rights) => Sleigh.appended(lefts, rights)
  // One pattern and then another: the second is read in the bits after the
  // first, so what it fixes and reads moves up past it.
  then (lefts, rights) => (
    out := chain None
    left := lefts.head
    while (exists left) {
      right := rights.head
      while (exists right) {
        first := left.value
        second := right.value
        below := Sleigh.cleared(first.mask)
        moved := Sleigh.moved_up(second.fields, below)
        then_start := below
        if (exists second.start) { then_start = below.under(second.start) }
        out &= Alternative(mask: first.mask.under(second.mask), match: first.match.under(second.match), fields: Sleigh.appended(first.fields, moved), parts: Sleigh.appended(first.parts, second.parts), start: then_start)
        right = right.next
      }
      left = left.next
    }
    out
  )
  appended (first, second) => (
    out := chain None
    walker := first.head
    while (exists walker) {
      out &= walker.value
      walker = walker.next
    }
    walker = second.head
    while (exists walker) {
      out &= walker.value
      walker = walker.next
    }
    out
  )

  // Translating p-code. A constructor's statements are read into steps of the
  // program being made (`translating`), and its expressions into terms: a
  // value of that program, as wide as p-code sizes it.
  //
  // What a varnode is as a term: a number is a constant, and fits whatever
  // it meets; anything else is asked. `0` and `1` are names of the booleans
  // (Bits.ray), so written alone they are read as those.
  term (given) => (
    out := chain None
    if (exists (external alike (given) (false))) { out &= Term(of: Constant(bits: zero_bits), like: zero_bits, extended: false, loose: true) } elsif (exists (external alike (given) (true))) { out &= Term(of: Constant(bits: one_bits), like: one_bits, extended: false, loose: true) } elsif (exists given.bits) { out &= Term(of: Constant(bits: given), like: given, extended: false, loose: true) } else { out &= given.term }
    out.head.value
  )
  // As many bits as some bytes written in decimal.
  bytes_wide (written) => (
    out := chain None
    walker := Sleigh.counted(written).head
    while (exists walker) {
      out &= false
      out &= false
      out &= false
      out &= false
      out &= false
      out &= false
      out &= false
      out &= false
      walker = walker.next
    }
    Bits(bits: out)
  )
  // A word cut or widened to exactly the width of another.
  fitted (word, template) => (
    out := chain None
    mine := word.bits.head
    theirs := template.bits.head
    while (exists theirs) {
      if (exists mine) {
        out &= mine.value
        mine = mine.next
      } else { out &= false }
      theirs = theirs.next
    }
    Bits(bits: out)
  )
  same_width (one, other) => (
    mine := one.bits.head
    theirs := other.bits.head
    while ((exists mine).and(exists theirs)) {
      mine = mine.next
      theirs = theirs.next
    }
    (exists mine).not.and((exists theirs).not)
  )
  // A term's value as wide as a template: itself when it is already, a
  // constant written that wide, or widened with its sign if it has one.
  fit (given, width) => (
    out := chain None
    if (Sleigh.same_width(given.like, width)) { out &= given.of } elsif given.loose { out &= Constant(bits: Sleigh.fitted(given.of.bits, width)) } else { out &= Widened(of: given.of, like: width, signed: given.extended) }
    out.head.value
  )
  // Two operands as p-code sizes them: a constant takes the size of what it
  // meets, and otherwise both are as wide as the wider.
  paired (one, other) => (
    first := Sleigh.term(one)
    second := Sleigh.term(other)
    wide := chain None
    if (first.loose.and(second.loose.not)) { wide &= second.like } elsif (second.loose.and(first.loose.not)) { wide &= first.like } else { wide &= Sleigh.widened(first.like, second.like) }
    width := wide.head.value
    Pair(left: Sleigh.fit(first, width), right: Sleigh.fit(second, width), like: width)
  )
  valued (value, width) => Term(of: value, like: width, extended: false, loose: false)
  plus (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Sum(left: pair.left, right: pair.right), pair.like)
  )
  minus (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Difference(left: pair.left, right: pair.right), pair.like)
  )
  conjoined (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Both(left: pair.left, right: pair.right), pair.like)
  )
  disjoined (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Either(left: pair.left, right: pair.right), pair.like)
  )
  differing (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Differing(left: pair.left, right: pair.right), pair.like)
  )
  // A comparison answers one bit.
  equal (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Equal(left: pair.left, right: pair.right), Bits.flag(false))
  )
  unequal (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Inverted(of: Equal(left: pair.left, right: pair.right)), Bits.flag(false))
  )
  signed_less (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Less(left: pair.left, right: pair.right), Bits.flag(false))
  )
  lower_than (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Below(left: pair.left, right: pair.right), Bits.flag(false))
  )
  // `a >= b`: `a` not below `b`.
  at_least (one, other) => (
    pair := Sleigh.paired(one, other)
    Sleigh.valued(Inverted(of: Below(left: pair.left, right: pair.right)), Bits.flag(false))
  )
  shifted_left (one, count) => (
    held := Sleigh.term(one)
    Sleigh.valued(ShiftedLeft(of: held.of, by: Sleigh.term(count).of), held.like)
  )
  shifted_right (one, count) => (
    held := Sleigh.term(one)
    Sleigh.valued(ShiftedRight(of: held.of, by: Sleigh.term(count).of, arithmetic: false), held.like)
  )
  // `zext(x)`, `sext(x)`: as wide as what it meets, widened without or with
  // its sign.
  extension (given, signed) => (
    held := Sleigh.term(given)
    Term(of: held.of, like: held.like, extended: signed, loose: false)
  )

  // A step of the program being made.
  emit (step) => (
    held := translating.programs.tail.value.steps
    held &= step
    true
  )
  // A local declared: set to what it is given, as wide as its size or else
  // as that.
  // It is kept by the characters its name is written with, for the rules
  // that have only the name: a local is declared as the constructor is
  // translated, after the rules that would see it by its class are chosen.
  declared (spot, width, given, spelling) => (
    held := Sleigh.term(given)
    wide := chain None
    if (exists width) { wide &= width } else { wide &= held.like }
    Sleigh.emit(Set(place: spot, to: Sleigh.fit(held, wide.head.value)))
    made := Local(place: spot, like: wide.head.value)
    known := sleigh.locals
    known &= LocalName(spelled: spelling, held_local: made)
    made
  )
  // The local declared last with a name, by the characters it is written
  // with.
  place_named (spelling) => (
    found := None
    walker := sleigh.locals.tail
    while ((exists walker).and((exists found).not)) {
      if (Sleigh.same_text(walker.value.spelled, spelling)) { found = walker.value.held_local }
      walker = walker.previous
    }
    found
  )
  // The characters of a name a rule begins with: `bits` reads the text of
  // what it is given, and a capture a rule begins with is given as the word
  // it is bound to, unless it is read as a value first. Not `(written)`: an
  // argument in brackets is read as a value, to see whether it is a list,
  // and the name a local is about to be declared by is not one yet.
  leading_characters (written) => (
    out := chain None
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        out &= byte
        byte = chain None
      }
      true
    )
    external bits written take
    out
  )
  same_text (one, other) => (
    same := true
    mine := one.head
    theirs := other.head
    while ((exists mine).and(exists theirs).and(same)) {
      bit := mine.value.head
      given_bit := theirs.value.head
      while (exists bit) {
        if (bit.value.xor(given_bit.value)) { same = false }
        bit = bit.next
        given_bit = given_bit.next
      }
      mine = mine.next
      theirs = theirs.next
    }
    same.and((exists mine).not).and((exists theirs).not)
  )
  // `place = value;`: a register or a local set.
  set (named, width, given) => Sleigh.emit(Set(place: named, to: Sleigh.fit(Sleigh.term(given), width)))
  // Memory is bytes: `*:n address` is n of them, the lowest at the address,
  // as a little-endian description keeps them.
  address_of (pointer) => Sleigh.fit(Sleigh.term(pointer), sleigh.address)
  after (at, offset) => Sum(left: at, right: Constant(bits: Sleigh.fitted(offset, sleigh.address)))
  loaded (at, size) => (
    value := Loaded(address: at)
    offset := Sleigh.fitted(one_bits, Bits.hex(`00`))
    walker := Sleigh.counted(size).head.next
    while (exists walker) {
      value = Joined(high: Loaded(address: Sleigh.after(at, offset)), low: value)
      offset = offset + Sleigh.fitted(one_bits, offset)
      walker = walker.next
    }
    value
  )
  stored (at, size, given) => (
    width := Sleigh.bytes_wide(size)
    value := Sleigh.fit(Sleigh.term(given), width)
    many := Sleigh.counted(size)
    if (exists many.head.next) {
      offset := Sleigh.fitted(zero_bits, Bits.hex(`00`))
      byte := Sleigh.fitted(Bits.hex(`ff`), width)
      walker := many.head
      while (exists walker) {
        Sleigh.emit(Stored(address: Sleigh.after(at, offset), to: Part(of: value, mask: byte)))
        offset = offset + Sleigh.fitted(one_bits, offset)
        byte = byte.doubled.doubled.doubled.doubled.doubled.doubled.doubled.doubled
        walker = walker.next
      }
    } else { Sleigh.emit(Stored(address: at, to: value)) }
    true
  )
  // Where a `goto` goes: a place in memory is its address, anything else
  // what it holds.
  destination (given) => (
    held := given.referent
    out := chain None
    if held.pointing { out &= held.target } else { out &= Sleigh.address_of(held) }
    out.head.value
  )
  // `if (condition) goto target`: the one control p-code has. Leaving the
  // program is a jump to an address.
  branch (condition, aimed) => Sleigh.emit(Jump(when: Sleigh.term(condition).of, target: None, to: Sleigh.destination(aimed)))
  jump (aimed) => Sleigh.emit(Jump(when: None, target: None, to: Sleigh.destination(aimed)))
  jump_to (aimed) => Sleigh.emit(Jump(when: None, target: None, to: Sleigh.address_of(aimed)))

  // The program of an encoding: what the constructors it is made of export,
  // innermost first, as the description builds them before the instruction's
  // own p-code; then that. Translated once, the first time it is asked for.
  program_of (encoding) => (
    held := encoding.semantics
    unless (exists held.done.head) {
      translating.programs &= held
      walker := held.parts.tail
      while (exists walker.previous) {
        part := walker.value
        exporting := part.performed
        exported := part.table.exports
        exported &= exporting
        walker = walker.previous
      }
      held.parts.head.value.performed
      held.done &= true
    }
    held
  )
  // What a table exports in the program being made: what the constructor of
  // it translated last exports, since every part is translated before what
  // is made of it. A table keeps it: tables made by one rule cannot be told
  // apart by where they were made, nor by their names, which read as the
  // tables they name.
  export_of (wanted) => wanted.exports.tail.value
  // One instruction run: its encoding's program, over a state, with the
  // address of the instruction after it. What it answers is where the
  // machine goes next: there, or where a jump in it left for.
  run (decoded, following, state) => (
    program := Sleigh.program_of(decoded.encoding)
    left := program.run(Running(registers: state.registers, memory: state.memory, decoded: decoded, following: following))
    out := chain None
    if (exists left) { out &= left } else { out &= following }
    out.head.value
  )
  // Instructions read from memory and run, one after another, from `start`
  // until the machine goes to `stop`, or `most` of them have run: every
  // instruction run, in order. What was read at an address is read there
  // once.
  // spec: code that writes over itself is run as it was first read.
  executed (isa, state, start, stop, longest, most) => (
    ran := chain None
    seen := chain None
    at := start
    one := Sleigh.fitted(one_bits, sleigh.address)
    left := most.head
    while ((at == stop).not.and(exists left)) {
      left = left.next
      visit := None
      walker := seen.head
      while ((exists walker).and((exists visit).not)) {
        if (walker.value.address == at) { visit = walker.value }
        walker = walker.next
      }
      unless (exists visit) {
        visit = Sleigh.fetched(isa, state, at, longest)
        seen &= visit
      }
      ran &= visit.decoded
      at = Sleigh.run(visit.decoded, visit.following, state)
    }
    ran
  )
  // The instruction at an address: as many bytes as the longest encoding
  // could take, joined the way the description keeps them, read, and where
  // the one after it is.
  fetched (isa, state, at, longest) => (
    one := Sleigh.fitted(one_bits, sleigh.address)
    word := state.load(at)
    ahead := at
    counting := longest.head.next
    while (exists counting) {
      ahead = ahead + one
      byte := state.load(ahead)
      if (exists byte) { word = word.under(byte) }
      counting = counting.next
    }
    reading := isa.read(word)
    after_it := at
    step := Sleigh.length_of(reading.encoding).head
    while (exists step) {
      after_it = after_it + one
      step = step.next
    }
    Visit(address: at, decoded: reading, following: after_it)
  )

  // The encodings of constructors, in the order they are written: one for
  // every alternative a constructor's pattern has once the tables it names
  // are read into it. Every field reaches across the whole word, so that
  // writing it back keeps the rest.
  encodings_of (constructors) => (
    out := chain None
    walker := constructors.head
    while (exists walker) {
      made := walker.value
      alternative := made.alternatives.head
      while (exists alternative) {
        taken := alternative.value
        fields := chain None
        field := taken.fields.head
        while (exists field) {
          fields &= Field(name: field.value.name, mask: Sleigh.widened(field.value.mask, taken.mask))
          field = field.next
        }
        out &= Encoding(mnemonic: made.mnemonic, mask: taken.mask, match: taken.match, fields: fields, semantics: Semantics(steps: chain None, parts: taken.parts, done: chain None))
        alternative = alternative.next
      }
      walker = walker.next
    }
    out
  )
  // The instructions spelled with one of some mnemonics, in the order they
  // are written: `sleigh.spelled(chain of mnemonics)`.
  spelled (mnemonics) => (
    out := chain None
    walker := .instructions.head
    while (exists walker) {
      asked := mnemonics.head
      while (exists asked) {
        if (exists (external alike (walker.value.mnemonic) (asked.value))) { out &= walker.value }
        asked = asked.next
      }
      walker = walker.next
    }
    out
  )
  // How many bytes an encoding takes: its mask, eight bits at a time.
  length_of (encoding) => (
    out := chain None
    walker := encoding.mask.bits.head
    while (exists walker) {
      out &= walker
      walker = walker.next.next.next.next.next.next.next.next
    }
    out
  )
  // Bytes read one instruction after another, from the first: each word
  // is as many bytes as the longest encoding could take, joined the way the
  // description keeps them, and the next instruction starts where this one
  // ends. What no encoding reads ends the reading.
  disassembled (isa, bytes, longest) => (
    out := chain None
    at := bytes.head
    while (exists at) {
      word := at.value
      ahead := at.next
      counting := longest.head.next
      while ((exists ahead).and(exists counting)) {
        word = word.under(ahead.value)
        ahead = ahead.next
        counting = counting.next
      }
      found := isa.read(word)
      if (exists found) {
        out &= found
        step := Sleigh.length_of(found.encoding).head
        while (exists step) {
          at = at.next
          step = step.next
        }
      } else { at = None }
    }
    out
  )
  // Whether a character is a decimal digit: 0011 and then the digit. `A`
  // is a hexadecimal digit, and a register.
  is_decimal (glyph) => glyph.head.value.not.and(glyph.head.next.value.not).and(glyph.head.next.next.value).and(glyph.head.next.next.next.value)
  // `x[low,size]`: the bits of a place from `low`, `size` of them, as a mask
  // as wide as the place.
  bit_range (low, size, width) => (
    upto := chain None
    walker := Sleigh.appended(low, size).head.next
    while (exists walker) {
      upto &= true
      walker = walker.next
    }
    Sleigh.span(low, upto, width.bits)
  )
  range (place, first_bit, bit_count) => (
    low_count := Sleigh.counted(first_bit)
    size_count := Sleigh.counted(bit_count)
    Range(of: place, low: low_count, size: size_count)
  )
  // An alternative with the field it read last fixed to a value.
  with_fixed (way, value) => (
    fixed_field := way.fields.tail.value
    fixed_mask := fixed_field.mask
    fixed_given := Sleigh.widened(value, fixed_mask)
    fixed_cleared := Sleigh.cleared(fixed_mask)
    fixed_match := fixed_cleared.deposit(fixed_mask, fixed_given)
    kept_fields := chain None
    kept_walker := way.fields.head
    while (exists kept_walker.next) {
      kept_fields &= kept_walker.value
      kept_walker = kept_walker.next
    }
    fixed_start := way.start
    kept_mask := way.mask
    kept_match := way.match
    kept_parts := way.parts
    kept_way := Alternative(mask: kept_mask, match: kept_match, fields: kept_fields, parts: kept_parts, start: fixed_start)
    constraint := Alternative(mask: fixed_mask, match: fixed_match, fields: chain None, parts: chain None, start: fixed_start)
    Sleigh.joined(kept_way, constraint)
  )
  // A table, as it is first written.
  table (named) => Table(name: named, exports: chain None, constructors: chain None)
  // The table a name holds already, or a new one: what is declared under it
  // is read later, so it must not read the name itself.
  table_kept (kept_table, spelled_table) => (
    chosen_table := None
    if (exists kept_table) { chosen_table = kept_table } else { chosen_table = Sleigh.table(spelled_table) }
    chosen_table
  )
  // An instruction set of constructors read.
  isa (constructors) => ISA(name: None, endian: sleigh.endian, encodings: Sleigh.encodings_of(constructors))
}
sleigh ^keyword := Sleigh(endian: None, alignment: None, spaces: chain None, address: None, registers: chain None, tokens: chain None, fields: chain None, pcodeops: chain None, macros: chain None, tables: chain None, instructions: chain None, locals: chain None)
// Zero and one as bits, read once.
zero_bits ^keyword := Sleigh.numeral(`0`)
one_bits ^keyword := Sleigh.numeral(`1`)
two_bits ^keyword := Sleigh.numeral(`2`)

// One way a pattern is spelled: which bits are fixed (`mask`) and to what
// (`match`), the operands read out of the rest (`fields`), the
// constructors it was made of (`parts`), and where its last token begins
// (`start`).
Alternative := class {
  mask: Node
  match: Node
  fields: Node
  parts: Node
  // Where the last token it reads begins: no bits, as many as the tokens
  // before it; None at the first.
  start: Node
}

// A pattern: the ways it can be spelled. `&` is both at once, `|` either,
// `;` one after the other, and `...` lets a pattern be shorter than what it is
// joined with.
Pattern := class {
  held: Node
  alternatives => .held
  // The three are read one operand at a time, left to right; `&` reads its
  // right side where the last token of its left side begins, so that
  // `a; b & c` is `a; (b & c)`. A `;` is written against the operand before
  // it, which would read it as its own: `a & b; c` is read whole.
  ; (other) => .followed_by(other)
  { }|{ }{other} ^punctuation => .either_with(other)
  { }&{ }{other} ^punctuation => .both_with(other)
  { }|{ }{other};{ }{rest} ^punctuation => (
    either_first := .either_with(other)
    either_first.followed_by(rest)
  )
  { }&{ }{other};{ }{rest} ^punctuation => (
    both_first := .both_with(other)
    both_first.followed_by(rest)
  )
  followed_by (other) => (
    followed_ways := .alternatives
    following_ways := other.alternatives
    sequence_ways := Sleigh.then(followed_ways, following_ways)
    Pattern(held: sequence_ways)
  )
  either_with (other) => (
    either_ways := .alternatives
    or_ways := other.alternatives
    choice_ways := Sleigh.either(either_ways, or_ways)
    Pattern(held: choice_ways)
  )
  both_with (other) => (
    both_ways := .alternatives
    and_ways := other.alternatives
    joint_ways := Sleigh.both(both_ways, and_ways)
    Pattern(held: joint_ways)
  )
  ... ^punctuation => this
  // `field=value` fixes the field read last. An operand is read up to the
  // first operator the language knew before this one, `=` among them, so in
  // `a; b=1` the `;` takes `b`, and `=1` then fixes it where it was moved.
  ={literal written} ^punctuation => .fixed_to(written)
  fixed_to (written) => (
    fixed_ways := chain None
    ways_before := .alternatives
    last_read := ways_before.tail.value.fields.tail
    fixing_value := Sleigh.numeral(written)
    way_walker := ways_before.head
    while (exists way_walker) {
      fixing_way := way_walker.value
      fixing_read := fixing_way.fields.tail
      fixes := false
      if ((exists fixing_read).and(exists last_read)) {
        fixes = exists (external alike (fixing_read.value.name) (last_read.value.name))
      }
      if fixes {
        fixed_way := Sleigh.with_fixed(fixing_way, fixing_value)
        fixed_ways &= fixed_way
      } else { fixed_ways &= fixing_way }
      way_walker = way_walker.next
    }
    Pattern(held: fixed_ways)
  )
  // `pattern [ name = value; ]`: what is set while the pattern is read, kept
  // with it to be run when the constructor is. The name stands for what was
  // set last, wherever the constructor's p-code uses it.
  // spec: one `name = value;` per action.
  { }[{ }{literal named}{ }={ }{given};{ }] ^punctuation => (
    holder ^keyword := external .
    act => (inline given)
    global[named] = Setting(place: named, likes: chain None)
    acting_ways := .alternatives
    Acting(held: acting_ways, action: holder, named: named)
  )
  setting => None

  // What the operands of a pattern are in p-code: places, which a term
  // reads and an assignment writes. `bits` is None, so that numbers and
  // places are told apart.
  bits => None
  signed => false
  pointing => false
  // What it stands for where p-code names it: itself, but for a table.
  referent => this
  // The operators of p-code, and the ones whose right side is a digit, which
  // is not a name (see the numbers at the end).
  { }+{ }{other} ^punctuation => Sleigh.plus(this, other)
  { }-{ }{other} ^punctuation => Sleigh.minus(this, other)
  { }=={ }{other} ^punctuation => Sleigh.equal(this, other)
  { }+{ }1 ^punctuation => Sleigh.plus(this, one_bits)
  { }-{ }1 ^punctuation => Sleigh.minus(this, one_bits)
  { }-{ }2 ^punctuation => Sleigh.minus(this, two_bits)
  { }=={ }0 ^punctuation => Sleigh.equal(this, zero_bits)
  { }=={ }1 ^punctuation => Sleigh.equal(this, one_bits)
  { }s<{ }0 ^punctuation => Sleigh.signed_less(this, zero_bits)
  { }s<{ }{other} ^punctuation => Sleigh.signed_less(this, other)
  // Written without spaces: `SP-1`, `SP-2`.
  -1 ^punctuation => Sleigh.minus(this, one_bits)
  -2 ^punctuation => Sleigh.minus(this, two_bits)
}
// `&` binds tighter than `|`, and `|` than `;`, so `bbb=5 & X; imm8` is
// `(bbb=5 & X); imm8`. Two operators of a pattern are grouped here by what
// they are. A typed capture is not asked on the first reading, so these are
// read only when a description is read again; `Pattern` reads the same
// grouping on the first. (Without them, reading a description costs more.)
// spec: this is the language's own precedence (String.ray ranks operators by
// where their class declares them) written out for three operators, since
// that one needs Number.ray, and it reads three operands at a time: a run of
// four such as `a & b & c; d` still groups its last two first.
binds ^keyword := class {
  accepts (written) => (
    held ^keyword := None
    if (exists (external alike (written) (`;`))) { held = written }
    if (exists (external alike (written) (`|`))) { held = written }
    if (exists (external alike (written) (`&`))) { held = written }
    held
  )
  // Whether `first` binds at least as tightly as `second`.
  first_binds (first, second) => (
    looser ^keyword := (exists (external alike (first) (`;`))).and((exists (external alike (second) (`;`))).not)
    if ((exists (external alike (first) (`|`))).and(exists (external alike (second) (`&`)))) { looser = true }
    looser.not
  )
}
{former} [first: binds] {middle} [second: binds] {latter} => (
  held ^keyword := None
  if (binds.first_binds(`[first]`, `[second]`)) { held = (former [first] middle) [second] latter } else { held = former [first] (middle [second] latter) }
  held
)
// A `;` written against the operand before it is read as part of that
// operand's word, and the rule above never sees it: `bbb=5 & X; imm8`.
{leading} [joining: binds] {operand};{ }{rest} => Pattern(held: Sleigh.then((leading [joining] operand).alternatives, (rest).alternatives))

// A pattern with what it sets while it is read.
// The name it sets is looked up when it is translated: a pattern may be read
// more than once, and the name stands for the setting read last.
Acting := class: Pattern {
  held: Node
  action: Node
  named: Node
  setting => this
  // Translated where the constructor is: the name set to what it is given.
  run => (
    named_place := global[.named]
    given := Sleigh.term(.action.act)
    widths := named_place.likes
    widths &= given.like
    Sleigh.emit(Set(place: .named, to: given.of))
  )
}
// A name an action sets: a place of the program, as wide as what it was set
// to.
Setting := class: Pattern {
  place: Node
  likes: Node
  term => Term(of: Named(name: .place), like: .likes.tail.value, extended: false, loose: false)
}

// What is written after a `#` is for the reader.
#{literal comment} ^comment => None
// spec: the preprocessor — `@include`, `@define`, `@if` … `@endif`, and
// `$(NAME)` in what follows — is passed over, so both sides of an `@if` are
// read, the later one last. Each is spelled out: `@` alone is how Ray writes
// where a report is about (`INFO@mark`).
@if{literal condition} ^comment => None
@ifdef{literal condition} ^comment => None
@ifndef{literal condition} ^comment => None
@elif{literal condition} ^comment => None
// `@else` and `@endif` stand alone on their lines: the capture after `@e`
// is typed only so that it may follow the `e` with no space between.
Directive ^keyword := class {
  accepts (text) => text
}
@e{literal rest: Directive} ^comment => None
@define{literal definition} ^comment => None
@undef{literal definition} ^comment => None
@include{literal file} ^comment => None

define{ }endian={literal order}; ^keyword => (
  sleigh.endian = order
  true
)
define{ }alignment={literal alignment}; ^keyword => (
  sleigh.alignment = alignment
  true
)

// An address space: where varnodes live.
Space := class {
  name: Node
  written: Node
}
define{ }space{ }{literal named}{ }{literal rest}; ^keyword => (
  space := Space(name: named, written: rest)
  sleigh.spaces &= space
  global[named] = space
  true
)
// The default space is memory, and how many bytes it is addressed with is
// how wide an address is.
define{ }space{ }{literal named}{ }type={literal kind}{ }size={literal bytes}{ }default; ^keyword => (
  space := Space(name: named, written: kind)
  sleigh.spaces &= space
  sleigh.address = Sleigh.bytes_wide(bytes)
  global[named] = space
  true
)

// Registers: names of places in the register space, each `size` bytes, the
// first at `offset`. The names follow the definition one at a time. In a
// pattern a register is spelled with no bits at all; in p-code it is a named
// place of the machine's state.
// spec: registers that overlap (`S` is the low byte of `SP`) are places apart.
SleighRegister := class: Pattern {
  name: Node
  offset: Node
  size: Node
  empty => Sleigh.bytes_wide(.size)
  term => Term(of: Named(name: .name), like: .empty, extended: false, loose: false)
  assigned (given) => Sleigh.set(.name, .empty, given)
  // `register = value;` in p-code: read up to its `;`, since Ray reads a
  // `;` with nothing after it as a separator that loses what came before. A
  // value written as a number is read from how it is written: a digit is not
  // a name (see the numbers at the end), and the text of what is given is
  // read without reading what it names.
  // A rule of a class is asked of every receiver it could apply to, not only
  // of registers: one written `{ }={ }1;` took `bbb=1;` in a pattern for an
  // assignment. So the digits are read here, from the text.
  // `0` and `1` are names of the booleans (Bits.ray): written alone, they are
  // read as those, and their text is not theirs.
  // spec: a number is read only where it is the whole value. Nor is
  // `N = ccr[7,1];`, some bits of a local, read yet: a rule for it runs its
  // capture back over the statements before it, to the first `=`, and a
  // typed capture that stops it costs passes that re-run what came before.
  { }={ }{given}; ^punctuation => (
    glyphs := chain None
    byte := chain None
    take (bit) => (
      byte &= (inline bit)
      if (exists byte.head.next.next.next.next.next.next.next) {
        glyphs &= byte
        byte = chain None
      }
      true
    )
    external bits given take
    if (exists (external alike (given) (false))) { .assigned(zero_bits) } elsif (exists (external alike (given) (true))) { .assigned(one_bits) } elsif (Sleigh.is_decimal(glyphs.head.value)) { .assigned(Sleigh.glyph_number(glyphs)) } else { .assigned(given) }
  )
  // `SP=SP-2;`, written without spaces. `={given};` would take a pattern's
  // `op=0x8` and the p-code after it for an assignment.
  ={literal operand}-2; ^punctuation => .assigned(Sleigh.minus(global[operand], two_bits))
  // `SP = SP+1;`: `+` is a letter of a word, so `SP+1` is one word, and is
  // read here as the register it begins with, and one.
  // spec: only a register named before `+1`.
  { }={ }{literal operand}+1; ^punctuation => .assigned(Sleigh.plus(global[operand], one_bits))

  alternatives => (
    out := chain None
    no_bits := Bits(bits: chain None)
    out &= Alternative(mask: no_bits, match: no_bits, fields: chain None, parts: chain None, start: None)
    out
  )
}
Registers := class {
  offset: Node
  size: Node
  { }{literal named} ^punctuation => (
    at := .offset
    bytes := .size
    register := SleighRegister(name: named, offset: at, size: bytes)
    sleigh.registers &= register
    global[named] = register
    this
  )
  // What ends a definition answers nothing more to read, so the line after it
  // is not taken for more of it.
  { }{`]`}; ^punctuation => true
}
define{ }register{ }offset={literal at}{ }size={literal bytes}{ }{`[`} ^keyword => Registers(offset: at, size: bytes)
// A list of one register written over several lines: `[`, the name, `]`.
// spec: a list of more than one written that way is not read: a rule on a
// class that begins with a new line is asked of the class itself, and takes
// the statement after the class for a register. Nor is a register defined
// alone (`size=4 contextreg;`), which a `context` is cut from: a rule for it
// reads `[ A X Y P ]` as one name too, and a typed capture that could tell
// them apart is not asked on the first reading.
define{ }register{ }offset={literal at}{ }size={literal bytes}{ }{`[`}{\n}{literal named}{\n}{`]`}; ^keyword => (
  register := SleighRegister(name: named, offset: at, size: bytes)
  sleigh.registers &= register
  global[named] = register
  true
)

// A token: a unit of instruction bits `size` wide, and the fields it is cut
// into, one on each line after it, each a range of bit positions.
Token := class {
  name: Node
  size: Node
  width: Node
}
// A field of a token. Written alone in a pattern it is an operand: read, not
// fixed. `field=value` fixes it.
TokenField := class: Pattern {
  name: Node
  token: Node
  mask: Node
  attributes: Node
  attached: Node
  signed => exists (external alike (.attributes) (`signed`))
  // In p-code: what the instruction being run holds in this field, as wide
  // as the field, widened with its sign if it is signed.
  term => Term(of: Operand(name: .name), like: Sleigh.cleared(.mask).extract(.mask), extended: .signed, loose: false)
  alternatives => (
    out := chain None
    reading := chain None
    reading_name := .name
    reading_mask := .mask
    reading &= Field(name: reading_name, mask: reading_mask)
    nothing := Sleigh.cleared(reading_mask)
    out &= Alternative(mask: nothing, match: nothing, fields: reading, parts: chain None, start: None)
    out
  )
  // `field=value` written on the field itself.
  fixed_to (written) => (
    fixing := .mask
    given := Sleigh.widened(Sleigh.numeral(written), fixing)
    out := chain None
    out &= Alternative(mask: fixing, match: Sleigh.cleared(fixing).deposit(fixing, given), fields: chain None, parts: chain None, start: None)
    Pattern(held: out)
  )

  // `field!=value`: every other value the field can hold, one alternative
  // each.
  !={literal written} ^punctuation => (
    fixing := .mask
    unwanted := Sleigh.widened(Sleigh.numeral(written), fixing)
    out := chain None
    width := Sleigh.cleared(fixing).extract(fixing)
    one := Sleigh.fitted(Bits.hex(`1`), width)
    candidate := width
    going := true
    unwanted_fitted := Sleigh.fitted(unwanted, width)
    fixing_cleared := Sleigh.cleared(fixing)
    while going {
      unless (candidate.xor(unwanted_fitted).is_zero) {
        candidate_wide := Sleigh.widened(candidate, fixing)
        candidate_match := fixing_cleared.deposit(fixing, candidate_wide)
        out &= Alternative(mask: fixing, match: candidate_match, fields: chain None, parts: chain None, start: None)
      }
      candidate = candidate + one
      if candidate.is_zero { going = false }
    }
    Pattern(held: out)
  )
}
Tokens := class {
  token: Node
  cut (named, low, high, flags) => (
    held := .token
    made := TokenField(name: named, token: held, mask: Sleigh.span(Sleigh.counted(low), Sleigh.counted(high), held.width), attributes: flags, attached: chain None)
    sleigh.fields &= made
    global[named] = made
    this
  )
  {\n}{literal named}{ }={ }({literal low},{literal high}) ^punctuation => .cut(named, low, high, None)
  {\n}{\n}{literal named}{ }={ }({literal low},{literal high}) ^punctuation => .cut(named, low, high, None)
  {\n}{literal named}{ }={ }({literal low},{literal high}){ }{literal flags} ^punctuation => .cut(named, low, high, flags)
  {\n}{literal named}{ }=({literal low},{literal high}) ^punctuation => .cut(named, low, high, None)
  {\n}; ^punctuation => true
}
// `define context contextreg`: fields of a register that says how the bits
// that follow are to be read (ARM or Thumb, 16- or 32-bit addressing). They
// are read here as a token as wide as the register.
// spec: a pattern that constrains a context field is read as if it were
// instruction bits; what the context holds is not yet part of decoding.
define{ }context{ }{literal named} ^keyword => (
  held := global[named]
  made := Token(name: named, size: held.size, width: Sleigh.bytes_wide(held.size).bits)
  Tokens(token: made)
)
define{ }token{ }{literal named}{ }({literal bits}) ^keyword => (
  made := Token(name: named, size: bits, width: Sleigh.counted(bits))
  sleigh.tokens &= made
  global[named] = made
  Tokens(token: made)
)

// `attach variables [ fields ] [ registers ]`: the value of each field names
// one of the registers, in the order they are written; `_` is a value that
// names none.
Attaching := class {
  fields: Node
  registers: Node
  switched: Node
  { }{literal named} ^punctuation => (
    naming := .registers
    named_by := .fields
    if (exists .switched.head) { naming &= global[named] } else { named_by &= global[named] }
    this
  )
  { }{`]`}{ }{`[`} ^punctuation => (
    .switched &= true
    this
  )
  { }{`]`}; ^punctuation => (
    naming := .registers
    walker := .fields.head
    while (exists walker) {
      walker.value.attached &= naming
      walker = walker.next
    }
    true
  )
}
attach{ }variables{ }{`[`} ^keyword => Attaching(fields: chain None, registers: chain None, switched: chain None)

// A p-code operation the description leaves to the one reading it.
PcodeOp := class {
  name: Node
}
define{ }pcodeop{ }{literal named}; ^keyword => (
  op := PcodeOp(name: named)
  sleigh.pcodeops &= op
  global[named] = op
  true
)

// A macro: p-code, written once and used in the semantics of many.
Macro := class {
  name: Node
  parameters: Node
  written: Node
  // `name(argument)`: its p-code translated with its parameter standing for
  // what is given. spec: one parameter; `a, b` would be read as one.
  ({given}) ^punctuation => .expanded(given)
  ({given}); ^punctuation => .expanded(given)
  () ^punctuation => .expanded(None)
  (); ^punctuation => .expanded(None)
  expanded (given) => (
    frame := .written
    expanding.arguments &= given
    frame.perform
    true
  )
}
// The parameter is named where the macro is written, once, and stands for
// the argument of the call being translated: naming it anew at every call
// costs the engine a reading of everything that saw the name.
macro{ }{literal named}({literal taking}){ }{`{`}{doing}{`}`} ^keyword => (
  place ^keyword := external .
  place[taking] = Argument(held: None)
  perform => (inline doing)
  written := Macro(name: named, parameters: taking, written: place)
  sleigh.macros &= written
  global[named] = written
  true
)
macro{ }{literal named}(){ }{`{`}{doing}{`}`} ^keyword => (
  place ^keyword := external .
  perform => (inline doing)
  written := Macro(name: named, parameters: None, written: place)
  sleigh.macros &= written
  global[named] = written
  true
)

// A constructor: how one alternative of a table is displayed, the pattern of
// bits it is spelled with, what it sets while being read (`action`), and what
// it does (`semantics`, p-code). An instruction is a constructor of the table
// with no name, written with a leading `:`.
// Its pattern is read when it is first asked for, where it is written, so the
// tables it names may be written after it; reading every pattern as it is
// written costs more than the whole description is worth to read.
Constructor := class {
  table: Node
  mnemonic: Node
  display: Node
  // Where it was written: `spell` there reads its pattern, and `perform`
  // runs its p-code.
  written: Node
  cache: Node
  // Its pattern, read the first time it is asked for.
  spelling => (
    held := .cache
    frame := .written
    unless (exists held.head) { held &= frame.spell }
    held.head.value
  )
  action => .spelling.setting
  // Its p-code translated into the program being made, after what its
  // pattern sets: what it answers is what it exports.
  performed => (
    frame := .written
    acting := .action
    if (exists acting) { acting.run }
    frame.perform
  )
  // Its alternatives, each knowing it was made of this constructor.
  alternatives => (
    out := chain None
    walker := .spelling.alternatives.head
    while (exists walker) {
      parts := chain None
      parts &= this
      out &= Alternative(mask: walker.value.mask, match: walker.value.match, fields: walker.value.fields, parts: Sleigh.appended(parts, walker.value.parts), start: walker.value.start)
      walker = walker.next
    }
    out
  )
}
// A table: its constructors, any one of which is how it is spelled. In p-code
// it is what the constructor it was read with exports.
Table := class: Pattern {
  name: Node
  exports: Node
  constructors: Node
  referent => Sleigh.export_of(this).referent
  term => Sleigh.term(.referent)
  assigned (given) => .referent.assigned(given)
  { }={ }{given}; ^punctuation => .assigned(given)
  alternatives => (
    out := chain None
    walker := .constructors.head
    while (exists walker) {
      out = Sleigh.appended(out, walker.value.alternatives)
      walker = walker.next
    }
    out
  )
}
instruction ^keyword := Table(name: `instruction`, exports: chain None, constructors: chain None)
// An instruction constructor ends with a space: a rule that opens with a mark and
// closes with one is taken for a bracket, and tried wherever that mark is
// written — every `:` of every `*:1` in the p-code of every constructor.
:{literal spelled}{ }{literal shown}is{ }{pattern}{`{`}{doing}{`}`}{ } ^keyword => (
  place ^keyword := external .
  spell => pattern
  perform => (inline doing)
  made := Constructor(table: instruction, mnemonic: spelled, display: shown, written: place, cache: chain None)
  instruction.constructors &= made
  sleigh.instructions &= made
  true
)
// A constructor of a named table. The display is read as one word, so that a
// line of Ray such as `bits: Node` is never taken for one: a table
// constructor has `is` after its display. A capture that runs up to a literal
// runs on past the end of the line when the literal is not on it, and
// swallows the lines after it; a word does not. `(imm8),Y` is one word once
// its opening parenthesis is read on its own, since a group is claimed whole.
// The table is made where it is first written, under the name written. It is
// declared outside any `{ }`: a block is a program of its own, and a name it
// declares is its own.
//
// What follows `is` is read on what the line has read so far: a rule that
// begins with a capture does not match once both the pattern and the p-code
// after it are read as expressions rather than as text.
Pending := class {
  into: Node
  display: Node
  { }{pattern}{`{`}{doing}{`}`} ^punctuation => (
    place ^keyword := external .
      spell => pattern
    perform => (inline doing)
    held := .into
    shown := .display
    held.constructors &= Constructor(table: held, mnemonic: None, display: shown, written: place, cache: chain None)
    true
  )
}
{literal named}:{ }is ^keyword => (
  existing_table := None
  if (exists (external own named)) { existing_table = named }
  external declare named (Sleigh.table_kept(existing_table, named))
  held := named
  Pending(into: held, display: None)
)
{literal named}:{ }{literal shown}{ }is ^keyword => (
  existing_table := None
  if (exists (external own named)) { existing_table = named }
  external declare named (Sleigh.table_kept(existing_table, named))
  held := named
  Pending(into: held, display: shown)
)
{literal named}:{ }{`(`}{literal shown}{ }is ^keyword => (
  existing_table := None
  if (exists (external own named)) { existing_table = named }
  external declare named (Sleigh.table_kept(existing_table, named))
  held := named
  Pending(into: held, display: shown)
)

// Translating p-code: what is being made, and the p-code statements that are
// not expressions of the operands above.

// A value of the program being made, as p-code sizes it: `like` is a word as
// wide, `extended` whether it widens with its sign, and `loose` whether it is
// a constant, which takes the width of what it meets.
Term := class: Pattern {
  of: Node
  like: Node
  extended: Node
  loose: Node
  term => this
}
Pair := class {
  left: Node
  right: Node
  like: Node
}
// What an encoding does: the program its p-code is translated into, the
// constructors it was read with, and whether it has been translated yet.
Semantics := class: Goto {
  steps: Node
  parts: Node
  done: Node
}
// An instruction read at an address, and the address after it.
Visit := class {
  address: Node
  decoded: Node
  following: Node
}
// The programs translated so far, the one being made last.
Translating := class {
  programs: Node
}
translating ^keyword := Translating(programs: chain None)
// What each macro was called with, the one being expanded last.
Expanding := class {
  arguments: Node
}
expanding ^keyword := Expanding(arguments: chain None)

// What a macro was called with, while its p-code is translated.
Argument := class: Pattern {
  given => expanding.arguments.tail.value
  term => Sleigh.term(.given)
  referent => .given.referent
  assigned (value) => .given.assigned(value)
}

// The address of the instruction after this one.
InstNext := class: Pattern {
  term => Term(of: Following(name: `inst_next`), like: sleigh.address, extended: false, loose: false)
}
inst_next ^keyword := InstNext(held: None)

// A local: a place of the program's own, named by where it is written, so
// that two constructors' `tmp` are two places.
Local := class: Pattern {
  place: Node
  like: Node
  term => Term(of: Named(name: .place), like: .like, extended: false, loose: false)
  assigned (given) => Sleigh.set(.place, .like, given)
}

// A place in memory, `size` bytes at an address.
// A field is not seen past a method of the same name in the class it is built
// on, so what Pattern answers for every place (`pointing`) and what a place in
// memory holds (`target`) are named apart.
Memory := class: Pattern {
  size: Node
  target: Node
  pointing => true
  term => Term(of: Sleigh.loaded(.target, .size), like: Sleigh.bytes_wide(.size), extended: false, loose: false)
  assigned (given) => Sleigh.stored(.target, .size, given)
  ={ }{given}; ^punctuation => .assigned(given)
}
*:{literal bytes}{ }{pointer} ^punctuation => Memory(size: bytes, target: Sleigh.address_of(pointer))
// `*:n (address) = value;`: the capture after `*:n` would take the
// assignment for part of the address, so an address in parentheses is read
// up to them. The rule ends with a space: one that opens with a mark and
// closes with another is taken for a bracket.
*:{literal bytes}{ }({pointer}){ } ^punctuation => Memory(size: bytes, target: Sleigh.address_of(pointer))

// Some bits of a place, `x[low,size]`: read, they are those bits; written,
// the place keeps the rest.
Range := class: Pattern {
  of: Node
  low: Node
  size: Node
  whole => Sleigh.term(.of)
  mask => Sleigh.bit_range(.low, .size, .whole.like)
  term => (
    selecting := .mask
    Term(of: Part(of: .whole.of, mask: selecting), like: Sleigh.cleared(selecting).extract(selecting), extended: false, loose: false)
  )
  assigned (given) => (
    whole_term := .whole
    selecting := .mask
    given_bits := Sleigh.fit(Sleigh.term(given), Sleigh.cleared(selecting).extract(selecting))
    replaced := Term(of: Deposited(of: whole_term.of, mask: selecting, field: given_bits), like: whole_term.like, extended: false, loose: false)
    whole_place := .of
    whole_place.assigned(replaced)
  )
}

// A local written to, found by its name: `tmp = tmp + zext(Y);`,
// `ccr[7,1] = N;`.
{literal target}{`[`}{literal first_bit},{literal bit_count}{`]`}{ }={ }{given}; ^punctuation => Sleigh.range(Sleigh.place_named(Sleigh.leading_characters(target)), first_bit, bit_count).assigned(given)
// The characters of a local's name, and the local.
LocalName := class {
  spelled: Node
  held_local: Node
}

// `zext(x)` and `sext(x)`.
Extension := class {
  signed: Node
  ({given}) ^punctuation => Sleigh.extension(given, .signed)
}
zext ^keyword := Extension(signed: false)
sext ^keyword := Extension(signed: true)

// A p-code statement ends with `;`, which Ray reads as a separator with
// nothing after it: the value before it would be lost. So the statements are
// read up to their `;`.
//
// `register = value;` is a rule of `SleighRegister`. `local name = value;`
// and `name:size = value;` declare a local, set to the value. A local is
// named by where its size (or its name, after `local`) is written:
// `external where` answers nothing for a capture a rule begins with.
{literal target}:{literal size}{ }={ }{given}; ^punctuation => (
  spot := external where size
  spelling := Sleigh.leading_characters(target)
  external declare target (Sleigh.declared(spot, Sleigh.bytes_wide(size), given, spelling))
  true
)
// `tmp:1 = value; export tmp;`, the way a table constructor most often says
// what it stands for, read whole: a statement written after another on one
// line is not read after a rule that took the first up to its `;`.
{literal target}:{literal size}{ }={ }{given};{ }export{ }{exported}; ^punctuation => (
  spot := external where size
  spelling := Sleigh.leading_characters(target)
  Sleigh.declared(spot, Sleigh.bytes_wide(size), given, spelling)
)
{literal target}:{literal size}{ }={ }{given};{ }export{ }*:{literal width}{ }{exported}; ^punctuation => (
  spot := external where size
  spelling := Sleigh.leading_characters(target)
  held := Sleigh.declared(spot, Sleigh.bytes_wide(size), given, spelling)
  Memory(size: width, target: Sleigh.address_of(held))
)
local{ }{literal target}{ }={ }{given}; ^keyword => (
  spot := external where target
  spelling := Sleigh.characters(target)
  external declare target (Sleigh.declared(spot, None, given, spelling))
  true
)
local{ }{literal target}:{literal size}{ }={ }{given}; ^keyword => (
  spot := external where target
  spelling := Sleigh.characters(target)
  external declare target (Sleigh.declared(spot, Sleigh.bytes_wide(size), given, spelling))
  true
)
// What a table constructor stands for when it is used.
export{ }{exported}; ^keyword => exported
// The conditional goto, and the jumps that leave the program: for an address
// (`goto` of a place in memory, `call`), or for what a place holds
// (`goto [x]`, `return [x]`).
if{ }({condition}){ }goto{ }{aim}; ^keyword => Sleigh.branch(condition, aim)
goto{ }{aim}; ^keyword => Sleigh.jump(aim)
goto{ }[{aim}]; ^keyword => Sleigh.jump_to(aim)
call{ }{aim}; ^keyword => Sleigh.jump(aim)
return{ }[{aim}]; ^keyword => Sleigh.jump_to(aim)

// Numbers as p-code writes them: hexadecimal after `0x`, and the digits 0, 1
// and 2 where p-code writes them most, after `=`, `+`, `-`, `==` and `s<`.
// A digit cannot be a name: the bits of every text are read by reading each
// bit, `0` or `1`, as it is written, and a digit that named anything would
// change what every text is made of.
// spec: any other decimal constant in p-code is not read.
SleighHexadecimal ^keyword := class {
  accepts (text) => Sleigh.hexadecimal(Sleigh.characters(text).head)
}
0x{digits: SleighHexadecimal} ^number => digits
