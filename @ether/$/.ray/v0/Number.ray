// class Number
//   Nat | ℕ <n> = Array{length == n}().last&&
//   ℝ: Any Base ℝ
// { ℕ, ℝ } = Number

// What the language reaches today. A number is a Ray: the chain from it to its
// terminal is its magnitude, zero is the terminal itself, and the successor of
// n is a new entry whose `next` is n. `==` needs no definition of its own — it
// is Ray's structural walk over exactly that chain — and `> <= >= min max`
// come from `Ordered` once `<` is given.
Number := class: Ray {
  succ => Number(next: this)
  pred => .next

  is_zero => .is_terminal
  nonzero => .is_zero.not

  // Walks along the chain rather than nesting one application per unit, so a
  // thousand is as cheap to reach as ten.
  + (other: Number) => (
    total := this
    left := other
    while left.nonzero {
      total = total.succ
      left = left.pred
    }
    total
  )

  // Subtraction floors at zero; the negative half of the line is `Integer`.
  - (other: Number) => (
    rest := this
    left := other
    while (left.nonzero.and(rest.nonzero)) {
      rest = rest.pred
      left = left.pred
    }
    rest
  )

  * (other: Number) => (
    product := zero
    left := other
    while left.nonzero {
      product = product + this
      left = left.pred
    }
    product
  )

  < (other: Number) => (
    mine := this
    theirs := other
    while (mine.nonzero.and(theirs.nonzero)) {
      mine = mine.pred
      theirs = theirs.pred
    }
    mine.is_zero.and(theirs.nonzero)
  )

  % (other: Number) => (
    rest := this
    unless other.is_zero {
      while (other <= rest) { rest = rest - other }
    }
    rest
  )

  / (other: Number) => (
    quotient := zero
    rest := this
    unless other.is_zero {
      while (other <= rest) {
        rest = rest - other
        quotient = quotient.succ
      }
    }
    quotient
  )

  == (other: Number) => (
    mine := this
    theirs := other
    while (mine.nonzero.and(theirs.nonzero)) {
      mine = mine.pred
      theirs = theirs.pred
    }
    mine.is_zero.and(theirs.is_zero)
  )
  != (other: Number) => (this == other).not

  // `def times callback: () => *`, without the index the draft leaves open.
  times (block) => if .is_zero { this } else {
    block

    .next times block
  }

  pow (exponent: Number) => (
    power := one
    left := exponent
    while left.nonzero {
      power = power * this
      left = left.pred
    }
    power
  )
  squared => this * this

  // `//TODO factorial!` above.
  factorial => (
    product := one
    left := this
    while left.nonzero {
      product = product * left
      left = left.pred
    }
    product
  )

  gcd (other: Number) => (
    a := this
    b := other
    while b.nonzero {
      rest := a % b
      a = b
      b = rest
    }
    a
  )
  lcm (other: Number) => (this * other) / (this.gcd(other))

  divides (other: Number) => (other % this).is_zero
  coprime (other: Number) => (this.gcd(other)) == one

  even => (this % two).is_zero
  odd => .even.not

  // `Decimal.% => this / 100`: the fraction of a hundred this number is.
  percent => this / hundred

  min (other: Number) => if (this < other) { this } else { other }
  max (other: Number) => if (this < other) { other } else { this }

  // `Nat | ℕ`: every number here is natural; the draft's `ℝ` and the base
  // towers wait on strings.
  is_natural => true
}

zero  := Number()
one   := zero.succ
two   := one.succ
three := two.succ
four  := three.succ
five  := four.succ
six   := five.succ
seven := six.succ
eight := seven.succ
nine  := eight.succ
ten   := nine.succ
hundred  := ten * ten
// A thousand is built when first asked for.
thousand => hundred * ten

// class Number
//   static Bases = { Binary: Digit = "0" | "1", …, Hexadecimal: Digit = Decimal | ("a" | "A")..("f" | "F") }
// The bases as they are without strings: each carries its radix, and the digit
// alphabets wait on `String`.
Base := enum Binary (radix: two) | Ternary (radix: three) | Quaternary (radix: four) | Quinary (radix: five) | Senary (radix: six) | Septenary (radix: seven) | Octal (radix: eight) | Nonary (radix: nine) | Decimal (radix: ten) | Undecimal (radix: ten.succ) | Duodecimal (radix: ten + two) | Tridecimal (radix: ten + three) | Tetradecimal (radix: ten + four) | Pentadecimal (radix: ten + five) | Hexadecimal (radix: ten + six)


// def Integer<n> = sign: "-"?, integer: Positive
//   static def Positive = Array{length == n}().last&
  //TODO Addition/subtraction of this integer (addition is simple)
// end

// The sign is present exactly when the number is below zero, so `Number` stays
// the magnitude. Addition/subtraction of a signed integer is still open, as
// the draft notes.
Integer := class {
  negative => exists .sign
  positive => .negative.not
  is_zero => .magnitude.is_zero

  // The draft's `def -` with no argument: negate.
  - => .negated
  negated => (
    size := .magnitude
    if .negative { Integer(magnitude: size) } else {
      Integer(
        sign: global
        magnitude: size
      )
    }
  )
  abs => Integer(magnitude: .magnitude)

  // Addition and subtraction of a signed integer: same signs add magnitudes,
  // different signs subtract the smaller from the larger and keep its sign.
  + (other: Integer) => if (.negative.xnor(other.negative)) {
    Integer(sign: .sign, magnitude: .magnitude + other.magnitude)
  } elsif (other.magnitude < .magnitude) {
    Integer(sign: .sign, magnitude: .magnitude - other.magnitude)
  } else {
    Integer(sign: other.sign, magnitude: other.magnitude - .magnitude)
  }
  - (other: Integer) => this + other.negated
  * (other: Integer) => if (.negative.xnor(other.negative)) {
    Integer(magnitude: .magnitude * other.magnitude)
  } else {
    Integer(sign: global, magnitude: .magnitude * other.magnitude)
  }

  == (other: Integer) => (.negative.xnor(other.negative)).and(.magnitude == other.magnitude)
  < (other: Integer) => if .negative {
    if other.negative { other.magnitude < .magnitude } else { true }
  } else {
    if other.negative { false } else { .magnitude < other.magnitude }
  }
}

// Every natural number is also the integer it is.
Number.components.hierarchy &= class {
  as_integer => Integer(magnitude: this)
}


