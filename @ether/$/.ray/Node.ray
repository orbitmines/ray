class Program
  external ({args}) => // Should deny Program(), you want that to actually call the program class abstractly.

  {` `}{expr} => this(expr)

class Node
  // When bootstrapping, functions definitions cannot use '&=', which is the actual default set lower in this file.
  static DEFINE_METHOD = '='

  // Function definition
  {` `}({args}){block} => this [DEFINE_METHOD] (
    def = block**
    def[`args`] = args
    def 
  )

  test () TODO
  
  external [{property}]
  external **: Program // {result: this}
  external = (x): x

// Set the actual method used for function definitions.
Node.DEFINE_METHOD = '&='

