// Pijul's changes, in the text form `pijul change` prints and `pijul apply` reads (https://pijul.org/manual/reference/change.html)
Pijul := class: Language {
  static extensions = ".pijul"
  static fidelity = Language.Fidelity.lossless

  Hash := class: String ((("A".."Z") | ("2".."7"))[]{count == 53})
  hashed (bytes: Byte[]): Hash => BLAKE3.write(bytes) as Byte³² as Base32 as String as Hash

  Quoted := class: String ("'", text: ((!"'") | ("''" as "'"))[], "'")
  Named := class: String ("\"", text: ((!"\"" && !"\\") | ("\\\"" as "\"") | ("\\\\" as "\\"))[], "\"")

  Change := class (
    "message = ", message: Quoted, \n,
    ("description = ", description: Quoted, \n)?,
    "timestamp = ", timestamp: Quoted, \n,
    authors: (\n, "[[authors]]", \n, fields: (key: Char.Word[], " = ", value: Quoted, \n)[])[],
    (\n, "[unhashed]", \n, unhashed: (key: Char.Word[], " = ", value: Quoted, \n)[])?,
    \n, "# Dependencies", \n,
    dependencies: ("[", (Decimal | "*"), "]", "+"?, " ", hash: Hash, \n)[],
    \n, "# Hunks", \n,
    hunks: (\n, Decimal, ". ", hunk: Hunk)[]
  ) {
    when: Time => timestamp as Time
    who => authors.first?.fields.find(.key == "name" || .key == "key")?.value
    recorded => unhashed?.find(.key == "ray")?.value
    id => hashed(this as Byte[])
  }

  Hunk := Addition | Deletion | Move | Edit | Replacement
  Lines := class (lines: (sign: ("+" | "-" | "\\"), " ", text: (!\n)[], \n)[]) {
    added => lines{.sign == "+"}.text.join(\n)
    removed => lines{.sign == "-"}.text.join(\n)
  }
  Addition := class ("File addition: ", path: Named, " in ", within: Named, (" ", permissions: ("+dx" | "+x" | "+d"))?, (" ", encoding: Named)?, \n, (" "[], (!\n)[], \n)[], content: Lines)
  Deletion := class ("File deletion: ", path: Named, " ", (!\n)[], \n, (" "[], (!\n)[], \n)[], content: Lines)
  Move := class ("Moved: ", from: Named, " ", to: Named, (" ", (!\n)[])?, \n, (" "[], (!\n)[], \n)[])
  Edit := class ("Edit in ", path: Named, ":", line: Decimal, " ", (!\n)[], \n, (" "[], (!\n)[], \n)[], content: Lines)
  Replacement := class ("Replacement in ", path: Named, ":", line: Decimal, " ", (!\n)[], \n, (" "[], (!\n)[], \n)[], content: Lines)

  Stored := class (version: Binary⁶⁴, hashed: Zstd, unhashed: Zstd, contents: Zstd) {
    change => (Bincode.read(hashed.bytes) as Change) -- (made => made ~~ (.unhashed = JSON.language.read(unhashed.bytes as String).entries) ~~ (.contents = contents.bytes))
  }

  Store := class = root: Location {
    changes => IO.listing(root / "changes")**{.name ~= ".change" ⊣}.map(at => (at.bytes as Stored).change ?? at.content as Change)
    ordered => changes.sort_by(change => (changes{c => change.dependencies.hash.contains(c.id)}.count, change.when))
    channels => IO.listing(root / "channels")
    history => ordered.reduce(held = (history: History(repository: Repository(location: root)), commits: {}) => commit_of(., held.history, held.commits) -- (commit =>
      (history: held.history ~~ .head = commit, commits: (held.commits, {(.id): commit})))).history
  }

  operations (change: Change, history: History, stamp: Stamp) => change.hunks.hunk.map(hunk => history.named(hunk.path ?? hunk.from) -- (known => hunk.match
    Addition => Operation(Operation.Kind.define, Definition(name: hunk.path, holder: hunk.within, language: Language.for_file(hunk.path)), stamp, change.who, after: Language.for_file(hunk.path).read(hunk.content.added))
    Deletion => Operation(Operation.Kind.remove, known, stamp, change.who, before: history.code_of(known))
    Move => Operation(Operation.Kind.rename, known, stamp, change.who, before: hunk.from, after: hunk.to)
    (Edit | Replacement) => Operation(Operation.Kind.change, known, stamp, change.who, before: history.code_of(known),
      after: Language.for_file(hunk.path).read(edited(known.language.write(history.code_of(known)), hunk)))))

  commit_of (change: Change, history: History, commits) => change.dependencies.hash.map(commits[.])# -- (previous => change.recorded
    ? History.committed(change.recorded as History.Line, previous)
    : History.Commit(who: Character.local(change.who) ?? change.who, value: operations(change, history, history.received(Stamp.at(change.when, node: change.who))),
        when: change.when, message: change.message, previous))

  edited (text: String, hunk: Edit | Replacement) => text.lines -- (lines => (lines[..<hunk.line - 1], hunk.content.added.lines, lines[hunk.line - 1 + hunk.content.removed.lines.count..]).flatten.join(\n))

  hunks (commit: History.Commit, history: History) => commit.operations.map(operation => operation.definition.path_in(history.at(commit)) -- (path => operation.kind.match
    Operation.Kind.define => Addition(path, within: operation.definition.holder ?? "", encoding: "UTF-8", content: Lines(lines: operation.definition.language.write(operation.after).lines.map((sign: "+", text: .))))
    Operation.Kind.remove => Deletion(path, content: Lines(lines: operation.definition.language.write(operation.before).lines.map((sign: "-", text: .))))
    Operation.Kind.rename => Move(from: operation.definition.file(operation.before), to: path)
    Operation.Kind.change => Replacement(path, line: 1, content: Lines(lines: (
      operation.definition.language.write(operation.before).lines.map((sign: "-", text: .)),
      operation.definition.language.write(operation.after).lines.map((sign: "+", text: .))).flatten))))

  change (commit: History.Commit, history: History, ids) => Change(
    message: commit.message ?? commit.operations.map(.summary).join("; "),
    timestamp: commit.when as String,
    authors: [(fields: [(key: "name", value: commit.who?.name ?? commit.who as String)])],
    unhashed: [(key: "ray", value: History.line(commit))],
    dependencies: commit.parents.map((hash: ids[.id])),
    hunks: hunks(commit, history).map((hunk: .)))

  static level := {
    {at: Location} => Store(root: IO.listing(at / ".pijul/changes").nonempty ? at / ".pijul" : at)
    {store: Store} => store.history
  }

  static written := {
    {writing: Language.Writing{value is History}} => writing.value -- (history => history.since(None).reduce(made = (ids: {}, files: []) => change(., history, made.ids) -- (written =>
      (ids: (made.ids, {(.id): written.id}), files: (made.files, [(path: "changes/" + written.id[..1] + "/" + written.id[2..] + ".change", content: written as Byte[])]))))
      -- (made => Language.Entry.of((made.files, [(path: "channels/" + (history.name ?? "main"), content: made.ids.values.join(\n) as Byte[])]).flatten(1))))
  }

  static stored := {
    {change: Change} as Byte[] => Stored(version: 6, hashed: change as Bincode as Zstd.language, unhashed: change.unhashed as JSON.language as Zstd.language, contents: change.hunks.hunk.content.lines.flatten.text.join(\n) as Zstd.language) as Byte[]
  }
}

