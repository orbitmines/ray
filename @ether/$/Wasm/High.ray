  static by_kind (bx, bk, bp) => (bk == `seq_left`) ? High.pattern_of(High.parts(bx)) : ((bk == `leaf`) ? (Compiled.braced(bx) ? High.block(Compiled.inner_of(bx)) : (Compiled.bracketed(bx) ? High.grouped(Compiled.statements_of(Compiled.inner_of(bx))) : (High.indexing(bx) ? High.listed(High.parts(Compiled.inner_of(bx))) : High.leaf(bx)))) : High.shape(bp, bk))
  static leaf (lf) => High.quoted(lf, "`") ? High.text(Compiled.inner_of(lf)) : (High.quoted(lf, "\"") ? High.text(High.unescaped(Compiled.inner_of(lf))) : High.leaf_of(lf))
  static quoted (qt, qc) => (qt.count >= 2) && (qt.first == qc) && (Compiled.last_of(qt) == qc)
  static leaf_of (lf) => ((level cw_numeral_value (lf)) === None) ? High.word(lf) : High.number((level cw_numeral_value (lf)) * 2 + 1)
  static word (wd) => High.word_numbered(wd, level cw_symbol_of (wd))
