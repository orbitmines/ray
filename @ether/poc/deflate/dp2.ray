// DP2: the RFC's own cases, the claims of `$/deflate/tests/deflate.ray` DF1 to DF6.

mark ^keyword := global

unless Deflate.Huffman([3, 3, 3, 3, 3, 2, 4, 4]).codes.sort_by((code) => code.symbol).map((code) => code.bits) == [0b010, 0b011, 0b100, 0b101, 0b110, 0b00, 0b1110, 0b1111] { INFO@mark `DF1 the code lengths of section 3.2.2's example do not give its codes` }
unless (Deflate.fixed_literals.bits(0) == 0b00110000) && (Deflate.fixed_literals.bits(144) == 0b110010000) && (Deflate.fixed_literals.bits(256) == 0b0000000) { INFO@mark `DF2 the fixed literal codes are not those of section 3.2.6` }
unless Deflate.inflated([0x01, 0x05, 0x00, 0xfa, 0xff, "hello".bytes].flatten) == "hello".bytes { INFO@mark `DF3 a stored block does not read its bytes` }
unless Deflate.inflated([0x03, 0x00]).empty { INFO@mark `DF4 an empty fixed block is not empty` }
unless Deflate.inflated([0x4b, 0x04, 0x00]) == "a".bytes { INFO@mark `DF5 a literal with the fixed codes is not read` }
unless Deflate.inflated([0x4b, 0x84, 0x03, 0x00]) == "aaaaaaaaaa".bytes { INFO@mark `DF6 a back-reference overlapping what it writes is not copied` }
