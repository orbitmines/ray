// class Ordered

Iterable := class: Ordered {
  entry => None

  empty => .count.is_zero
  nonempty => .empty.not

  bounded => true
  unbounded => .bounded.not

  count => (
    entries_counted := 0
    if (exists .entry) { entries_counted = .entry.count }
    entries_counted
  )

  first => .entry.first
  last => .entry.last

  // The draft's one traversal: `for` hands each element to the block as `it`.
  for (body) => if (exists .entry) { .entry for body } else { this }

  // `every (predicate) => map(predicate)~{== false}.empty`, `some => ~{predicate}.nonempty`:
  // the block is the predicate, read for each `it`.
  // Each stops at the first element that decides it, so either can be asked
  // of what has no end.
  every (predicate) => (
    for {
      verdict := inline predicate
      unless verdict { return false }
    }
    true
  )
  some (predicate) => (
    for {
      verdict := inline predicate
      if verdict { return true }
    }
    false
  )

  // `all => reduce(|)`: every element superposed: the first, with each next
  // pushed onto its components (`#`).
  all => (
    superposed ^keyword := None
    for {
      if (exists superposed) { superposed = superposed | it.value } else { superposed = it.value }
    }
    superposed
  )

  // `fill (x) all = x`
  fill (x) => for { it.value = x }

  // `compact => this~{!=.instance_of None}`: the elements that hold something.
  compact => this{exists this}

  // `map (map: (x): T)`: what the block answers for each `it`, in order.
  map (mapping) => (
    mapped ^keyword := chain None
    for { mapped &= (inline mapping) }
    mapped
  )

  // `reverse: static`: the same elements, the last first.
  reverse => (
    walked ^keyword := chain None
    for { walked &= it.value }
    turned ^keyword := chain None
    back ^keyword := walked.tail
    while (exists back) {
      turned &= back.value
      back = back.previous
    }
    turned
  )

  // `sort (dimension) … ~every .previous <= . <= .next`, along `<`: the same
  // elements, the smallest of what is left taken each time.
  sort => (
    left ^keyword := chain None
    for { left &= it.value }
    ordered ^keyword := chain None
    smallest ^keyword := None
    walker ^keyword := None
    while left.nonempty {
      smallest = left.head
      walker = left.head.next
      while (exists walker) {
        if (walker.value < smallest.value) { smallest = walker }
        walker = walker.next
      }
      ordered &= smallest.value
      left.unlink(smallest)
    }
    ordered
  )

  // `contains | includes <operator = ==>(x) some(operator(.)(x))`.
  contains (x) => (
    for { if (it.value == x) { return true } }
    false
  )
  includes (x) => .contains(x)

  // `unique`: each element once, where it first appears.
  unique => (
    kept ^keyword := chain None
    for {
      unless (kept.contains(it.value)) { kept &= it.value }
    }
    kept
  )

  // `partition (predicate)`: those the block holds for, then the rest.
  partition (predicate) => (
    held ^keyword := chain None
    rest ^keyword := chain None
    for {
      verdict := inline predicate
      if verdict { held &= it.value } else { rest &= it.value }
    }
    halves ^keyword := chain None
    halves &= held
    halves &= rest
    halves
  )

  // `batch | chunk (size: Nat)`: the elements in runs of `size`, the last
  // run holding what is left.
  chunk (size: Number) => (
    runs ^keyword := chain None
    run ^keyword := chain None
    left ^keyword := size
    for {
      run &= it.value
      left = left.pred
      if left.is_zero {
        runs &= run
        run = chain None
        left = size
      }
    }
    if run.nonempty { runs &= run }
    runs
  )
  batch (size: Number) => .chunk(size)

  // `.flatten = .reduce(push_back)`, one level: what an element holds is
  // spliced in where the element was. Only a bounded array is: an unbounded
  // one, a number say, has no end to splice up to.
  flatten => (
    flat ^keyword := chain None
    for {
      inner := it.value
      spliced ^keyword := false
      if (exists inner.instance_of(Array)) { spliced = inner.bounded }
      if spliced { inner for { flat &= it.value } } else { flat &= inner }
    }
    flat
  )

  intersection (other) => (
    both ^keyword := chain None
    for {
      if (other.contains(it.value)) { unless (both.contains(it.value)) { both &= it.value } }
    }
    both
  )
  disjoint (other) => .intersection(other).empty
  // `xor | symmetric_difference`: what one of the two holds and the other doesn't.
  symmetric_difference (other) => (
    either ^keyword := chain None
    for {
      unless (other.contains(it.value)) { either &= it.value }
    }
    mine ^keyword := this
    other for {
      unless (mine.contains(it.value)) { either &= it.value }
    }
    either
  )

  at (index: Number) => .entry.at(index)

  // A chain is its own path, so its length is its count.
  paths => this
  length => .paths.count

  // Each element reaches every other by going forward and backward along the chain.
  connected => true
  consistent => true
  acyclic => .entry.acyclic
  undirected => false
  unidirectional => false
}

// A program is what it is written as: the statements, in the order they are
// written on the page, each of them a program in turn. What order they *run*
// in is another thing, and a goto is what says it.
// What a chain of numbers adds to, and what it multiplies to. Written here
// rather than in Number.ray, which is read before this file: a class gains
// nothing from a file read earlier than the one that writes it.
Iterable.components.hierarchy &= class {
  sum => (
    total ^keyword := 0
    this for { total = total + it.value }
    total
  )
  product => (
    total ^keyword := 1
    this for { total = total * it.value }
    total
  )
}
// One of a collection, at random. Written here for the same reason: what
// `Random` is, is Feature.ray's to say, and a name settles wherever it is
// written, but a class only gains from a file read after the one writing it.
Iterable.components.hierarchy &= class {
  random => .at(Random.below(.count))
}
Σ{ }{iterable} ^keyword => (iterable).sum
∑{ }{iterable} ^keyword => (iterable).sum
∏{ }{iterable} ^keyword => (iterable).product

Ray := class: Iterable {
  entry => this

  is_initial => (exists .previous).not
  is_terminal => (exists .next).not

  is_first => .is_initial
  is_last => .is_terminal

  initial => (
    walker := this
    while walker.is_initial.not { walker = walker.previous }
    walker
  )
  terminal => (
    walker := this
    while walker.is_terminal.not { walker = walker.next }
    walker
  )

  first => .initial
  last => .terminal

  // The boundaries a ray shows to the edges it sits on, per `Boundary.Initial(∙: this)`.
  initial_boundary => Boundary.Initial(vertex: this)
  terminal_boundary => Boundary.Terminal(vertex: this)

  count => (
    total := 1
    walker := this
    while walker.is_terminal.not {
      total = total.succ
      walker = walker.next
    }
    total
  )

  // Walked rather than called again for each step: reading the rest of a ray
  // by asking it to read itself nests one application per element, and a
  // statement is only allowed so many, so a long ray was walked partway and
  // said nothing about stopping.
  for (body) => (
    it ^keyword := .entry
    going ^keyword := true
    while going {
      inline body
      // Where a ray ends is its own to say — a boundary ends where its edge
      // is, not where its `next` runs out — so the walk asks it, as asking it
      // to walk the rest of itself did.
      going = it.is_terminal.not
      if going { it = it.next }
    }
    this
  )

  at (index: Number) => (
    here := .entry
    left := index
    while left {
      here = here.next
      left = left.pred
    }
    here
  )

  // A chain walked forward never returns to where it started.
  acyclic => .terminal.is_terminal

  chainable == (other) => (
    mine := .entry
    theirs := other.entry
    same := (exists mine).xnor(exists theirs)
    while (same.and(exists mine)) {
      if ((exists mine.value).or(exists theirs.value)) { same = (mine.value == theirs.value) }
      if same {
        same = mine.is_terminal.xnor(theirs.is_terminal)
        if mine.is_terminal { mine = None } else {
          mine = mine.next
          theirs = theirs.next
        }
      }
    }
    same
  )
  chainable != (other) => (this == other).not
}

// A boundary is the ray a vertex shows to the edge it sits on; an edge is the
// ray between two boundaries. Both are rays themselves, which is what makes
// the structure self-similar.
Boundary := class: Ray {
  // `vertex | ∙` and `edge | ⊙`: the unicode aliases wait on a way to spell them.
  is_initial => (exists .edge).not
  is_terminal => (exists .edge).not

  Initial := class: Boundary {
    // `⊙ = Edge(x.terminal: this)`
    edge => Edge(to: this)
    is_initial => true
    is_terminal => false
  }
  Terminal := class: Boundary {
    // `⊙ = Edge(x.initial: this)`
    edge => Edge(from: this)
    is_initial => false
    is_terminal => true
  }
}

Edge := class: Ray {
  // `value | x : { initial | ⊣ : Boundary?, terminal | ⊢ : Boundary? }`
  is_initial => (exists .from).not
  is_terminal => (exists .to).not

  // `initial = Boundary(∙: ⊙⊢∙⊣x)`, `terminal = Boundary(∙: x⊢∙⊣⊙)`
  initial => .from
  terminal => .to
}


// The structures of the draft: an Iterable whose rays are constrained.
// spec: the constraints (`(1 unless HyperContinuations) Vertex.Boundary`) are
// carried as the two flags and asked of a structure through `is_valid`, not
// enforced while it is built.
Structure := class: Iterable {
  hyper_continuations => false
  hyper_edges => false
  is_valid => true
}
Structure.components.hierarchy &= Ray
Hypergraph := class: Structure {
  hyper_edges => true
}
Graph := class: Structure {
  hyper_continuations => true
}
Forest := class: Structure {
  hyper_continuations => true
  is_valid => .acyclic.and(.consistent)
}
Tree := class: Forest {
  is_valid => .acyclic.and(.consistent).and(.connected)
}
Path := class: Structure {
  is_valid => .consistent.and(.connected)
  paths => this
  // `length: 1 N∞`: the count, or unbounded when a walk comes back around.
  length => if .acyclic { .count } else { None }
}
Array := class: Path {
  acyclic => true
}

// `class Set < Structure`, `normalizer = .unordered.unique`: what it holds,
// each once, in no order that matters.
Set := class: Structure {
  elements: (chain None)
  entry => .elements.unique.entry
  add (x) => (
    unless (this.elements.contains(x)) { this.elements &= x }
    this
  )
}

// `parent | previous : static? <- hierarchy -> children | next : static?`: a
// thing held by one and holding many. spec: `previous` and `next` as the
// draft's other names wait on a ray continuing into more than one.
Hierarchy := class: Ray {
  parent?: Node
  children: (chain None)

  // What this holds, holds it: a child says what it is in.
  holds (child) => (
    this.children &= child
    child.parent = this

    child
  )
  // How deep this is: what holds it, and what holds that.
  depth => (
    depth_below := 0
    if (exists .parent) { depth_below = .parent.depth.succ }
    depth_below
  )
}

// `Loop = Array.Unbounded.orbit`: walked past its last, a chain comes back to
// its first and before its first is its last, so a walk around it has no end
// and comes back around. What walks it stops it (`return`).
Loop := class: Ray {
  around: Node
  holding: Node

  value => .holding.value
  next => Loop(around: .around, holding: (.holding.next ?? .around.head))
  previous => Loop(around: .around, holding: (.holding.previous ?? .around.tail))
  is_initial => false
  is_terminal => false
  bounded => false
  acyclic => false
}

// spec: the draft's Traverser: how `for` walks a structure. A chain has one
// way through it, so depth-first and breadth-first meet; both are named so a
// structure with branches can choose.
Traverser := class {
  Order := enum depth_first | breadth_first
  default => Traverser.Order.depth_first
  walk (entry, body) => entry for body
}


// A chain of components is an Array (a path without cycles), and each link in it a Ray: the
// containers `class` builds before this file loads take both on here.
Chain.components.hierarchy &= Array
Link.components.hierarchy &= Ray
// `push_back`, `push_front`, `pop_front => first.remove`, `pop_back =>
// last.remove`: a chain gains or loses an end, and what is taken off is what
// it held.
Chain.components.hierarchy &= class {
  push_back (x) => (this &= x)
  orbit => Loop(around: this, holding: this.head)
  push_front (x) => (
    was_head ^keyword := this.head
    added ^keyword := link x None
    added.next = was_head
    if (exists was_head) { was_head.previous = added } else { this.tail = added }
    this.head = added
    this
  )
  unlink (dropped) => (
    held ^keyword := dropped
    answer ^keyword := held.value
    before ^keyword := held.previous
    after ^keyword := held.next
    if (exists before) { before.next = after } else { this.head = after }
    if (exists after) { after.previous = before } else { this.tail = before }
    answer
  )
  pop_front => (
    taken ^keyword := None
    if (exists this.head) { taken = this.unlink(this.head) }
    taken
  )
  pop_back => (
    taken ^keyword := None
    if (exists this.tail) { taken = this.unlink(this.tail) }
    taken
  )
}

