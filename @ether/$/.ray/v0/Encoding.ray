Encoding := namespace {
  Algorithm := enum sha1 | sha256 | sha512 | sha3 | md5 | blowfish | blake3 | base64 | gzip

  // `Encrypted<T>` is readable only at a location holding its key (X4.2, X4.3).
  Encrypted<T> := class = value: T, key: Key? {
    holds_key (location: Location?) => key && location?.key == key
    as (location: Location) => value if holds_key(location)
    opened (location: Location) => holds_key(location) ? value : Quest(name: "find the key", goal: this)
    read_off (location: Location) => Encrypted(value, key: location.key) if holds_key(location)
  }

  Hash := class = value: *, algorithm: Algorithm
  Compressed := class = value: *, algorithm: Algorithm {
    as (target) => value
  }
}
