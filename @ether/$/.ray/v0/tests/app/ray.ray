mark ^keyword := external global

a := Ray()
b := Ray(previous: a)

unless (a.is_initial) { INFO@mark `a lone ray is not initial` }

unless (a.nonempty) { INFO@mark `a lone ray counts as empty` }

if (b.is_initial) { INFO@mark `a linked ray reports initial` }

unless (b.initial == a) { INFO@mark `the initial walk failed` }

unless (a.count == one) { INFO@mark `a lone ray does not count one` }

unless (a.terminal == a) { INFO@mark `a lone ray is not its own terminal` }

unless ((b.min(b)) == b) { INFO@mark `Ordered.min did not reach Ray` }

c := Ray(previous: b)
// A ray's previous and next are its own: linking one way does not link back.
a.next = b
b.next = c
unless ((a.at(two)) == c) { INFO@mark `R8 at(2) did not reach the third ray` }

seen ^keyword := zero
a for { seen = seen.succ }
unless (seen == three) { INFO@mark `R9 for did not visit three rays` }

unless (a every { it.nonempty }) { INFO@mark `R10 every failed` }

unless (a some { it.is_terminal }) { INFO@mark `R11 some failed` }

unless (a.initial_boundary.is_initial) { INFO@mark `R12 initial boundary is not initial` }

unless (a.terminal_boundary.edge.is_terminal) { INFO@mark `R13 the edge of a terminal boundary is not terminal` }

unless (a.acyclic) { INFO@mark `R14 a chain is not acyclic` }
