Nameable := class: Ray {
  named (name: String) => (
    .name = name
    this
  )
}
Entity := class: Ray { }

Location := class: Hierarchy {
  parent?: Node
  children: (chain None)
  host?: Node
}

World := class: Nameable {
  prefix => `#`
  name: String
  parent?: Node
  children: (chain None)
  host?: Node
  worlds: (chain None)
  characters: (chain None)
  items: (chain None)
  quests: (chain None)
  reservations: (chain None)

  spawn (character) => (
    .characters &= character
    character
  )
  add (item) => (
    .items &= item
    item
  )
  post (quest) => (
    .quests &= quest
    quest
  )

  shadowing => None

  reserve (name: String) => (
    standing ^keyword := .reserved(name)
    unless (standing) { standing = .issue(name) }

    standing
  )

  issue (name: String) => (.reservations &= World.Reservation(name: name, issuer: this)).tail.value

  reserved (name: String) => (
    holder ^keyword := None
    walker ^keyword := .reservations.head
    while (walker) {
      if (walker.value.name == name) { holder = walker.value }
      walker = walker.next
    }
    holder
  )
  Reservation := class: Ray {
    name: String
    issuer: Node
    holder: None
  }
  population => .characters.count

  names: (chain None)
  dynamics: (chain None)

  define (name: String, value) => (
    .names &= World.Name(name: name, value: value, unset: false)
    value
  )
  unset (name: String) => (
    .names &= World.Name(name: name, value: None, unset: true)
    None
  )
  lookup (name: String) => (
    found ^keyword := None
    .names for { if (it.value.name == name) { found = it.value } }
    if (found === None) {
      if .parent { .parent.lookup(name) }
      elsif (this === World.ether) { None }
      else { World.ether.lookup(name) }
    } else { found.value }
  )
  Name := class: Ray {
    name: String
    value: Node
    unset: false
  }

  allocate (name: String, holder) => (
    standing := .reserve(name)
    standing.holder = holder
    standing
  )
  allocated (name: String) => (
    standing := .reserved(name)
    if (standing === None) { None } else { standing.holder }
  )

  within_worlds => (
    found := chain None
    .worlds for {
      found &= it.value
      it.value.within_worlds for { found &= it.value }
    }
    .children for {
      if (it.value.instance_of(World)) {
        found &= it.value
        it.value.within_worlds for { found &= it.value }
      }
    }
    found
  )
  within_characters => (
    found := chain None
    .characters for { found &= it.value }
    .within_worlds for { it.value.characters for { found &= it.value } }
    found
  )

  compounds + (dynamic) => (
    .dynamics &= dynamic
    this
  )
  tick => (
    .dynamics for { it.value.step(this) }
    this
  )
}

World.ether = World(name: "ether")

Dynamics := class: Ray {
  step (world) => world
}
World.components.hierarchy &= Location
Region := World

Quest := class: Nameable {
  name: String
  goal: Node
  steps: (chain None)
  done: false
  from: None
  verifier: None
  best: None
  path: (chain None)
  solved_by: None

  reached (value) => if (.verifier === None) { value.instance_of(.goal) } else { .verifier(value) }
  attempt (value, character) => (
    .path &= value
    if (.reached(value)) {
      .best = value
      .solved_by = character
      .complete
    } else { this }
  )
  refined => .steps.every { it.value.instance_of(Quest) }
  progress => (
    solved ^keyword := 0
    .steps for { if (it.value.instance_of(Quest)) { if it.value.completed { solved = solved.succ } } }
    solved
  )

  step (description) => (
    .steps &= description
    this
  )
  complete => (
    .done = true
    this
  )
  completed => .done
  difficulty => .steps.count
}
Task := class: Quest {
  name: String
  goal: Node
  steps: (chain None)
  done: false
  interrupted: false

  interrupt => (
    .interrupted = true
    this
  )
}

Item := class: Ray {
  name: String
  issuer: Node
  location: None
  obtained_by: None
  certificate: None

  move (location) => (
    .location = location
    this
  )
  certify (certificate) => (
    .certificate = certificate
    this
  )
}
Certificate := class: Ray {
  issuer: Node
  secret: Node
  issued_on: Time.now

}

History := class: Ray {
  Commit := class: Ray {
    who: Node
    what: Node
    id: UUID.v4
    when: Time.now
    visibility: Accessor.Permission.private
    inverse: None

    publish => (
      .visibility = Accessor.Permission.public
      this
    )
    staged => .visibility == Accessor.Permission.private
  }
  repository: Node
  commits: (chain None)
  from: None
  generics: (chain None)

  commit (who, what) => (
    .commits &= History.Commit(who: who, what: what)
    this
  )
  stage (who, what) => .commit(who, what)
  published => (
    shown := chain None
    .commits for { unless it.value.staged { shown &= it.value } }
    shown
  )
  publish => (
    .commits for { it.value.publish }
    this
  )

  squash (who) => (
    joined := chain None
    .commits for { joined &= it.value.what }
    History(repository: .repository, commits: (chain None), from: .from).commit(who, joined)
  )
  cherry_pick (commit) => (
    .commits &= History.Commit(who: commit.who, what: commit.what, inverse: commit.inverse)
    this
  )
  from_here (commit) => (
    kept := History(repository: .repository, commits: (chain None), from: None)
    reached ^keyword := false
    .commits for {
      unless reached { kept.cherry_pick(it.value) }
      if (it.value === commit) { reached = true }
    }
    kept
  )
  revert (commit) => if (commit.inverse === None) { Quest(name: "revert", goal: commit) } else { .commit(commit.who, commit.inverse) }

  merge (other) => (
    conflicts := chain None
    other.commits for {
      theirs := it.value
      .commits for { if ((it.value.what == theirs.what).not.and(it.value.when == theirs.when)) { conflicts &= Quest(name: "merge", goal: theirs) } }
      .cherry_pick(theirs)
    }
    conflicts
  )

  remember_generic (name: String) => (
    .generics &= name
    this
  )
  appears (name: String) => if (.generics.contains(name)) { INFO@name `a variable is named like a generic type used silently before` } else { None }

  Assignment := class: Ray {
    value: Node
    history: None
    previous: None
  }
  assigned (value, history) => History.Assignment(value: value, history: history, previous: .latest)
  count => .commits.count
  latest => .commits.tail.value
  fork => History.Branch(repository: .repository, commits: (chain None), from: this)

  Branch := class: History {
    repository: Node
    commits: (chain None)
    from: None
  }
}
Repository := class: Ray {
  world: Node
  histories: (chain None)

}

Accessor := class: Ray {
  Permission := enum private | confidential | protected | public | local | localhost | managed
  level: Node
  methods: (chain None)

  read => Accessor(level: .level, methods: (chain None)).on(`read`)
  write => Accessor(level: .level, methods: (chain None)).on(`=`)
  execute => Accessor(level: .level, methods: (chain None)).on(`()`)
  on (method) => (
    .methods &= method
    this
  )
  covers (method) => .methods.empty.or(.methods.contains(method))
  allows (who, method) => if (.covers(method).not) { true } elsif (.level == Accessor.Permission.public) { true } else { who.permissions.contains(.level) }
  block (values) => (
    values for { it.value.access = this }
    values
  )
  derived (from) => if (from.access) { from.access } else { this }
  default_policy => Accessor(level: Visibility.default_privacy_policy)
  confidential => Accessor.default_policy

  Consistency := class: Ray {
    replicas: (chain None)

    read (value) => if (.replicas.every { it.value.synced }) { value } else { Quest(name: "wait for the replicas", goal: value) }
  }
}

Reference := class: Ray {
  Note := class: Ray {
    date: Time.now
    text: String
  }
  title: String
  subtitle: None
  date: Time.now
  draft: true
  organizations: (chain None)
  authors: (chain None)
  published: (chain None)
  year: None
  link: None
  pointer: None
  remote: None
  notes: (chain None)

  publish => (
    .draft = false
    this
  )
  note (text: String) => (
    .notes &= Reference.Note(text: text)
    this
  )
}

Instance := class: Ray {
  location: Node
  status: Status.online
  key: None
  registry: (chain None)
  hosted: (chain None)
  deletions: (chain None)
  host: None

  chainable == (other) => if (.key === None) { this === other } else { .key == other.key }

  login (character) => (
    .registry &= character
    character
  )
  logged_in (character) => .registry.contains(character)
  logout (character, delete_all) => (
    kept := chain None
    .registry for { unless (it.value === character) { kept &= it.value } }
    .registry = kept
    if delete_all {
      character.key = None
      .deletions &= Instance.Deletion(character: character, due: Time.now + 30 days)
    }
    character
  )
  swap (from, to) => (
    .logout(from, false)
    .login(to)
  )
  spawn (character) => .login(character)

  host_for (character) => (
    .hosted &= character
    character.presence = this
    character
  )

  mirror (value, depth) => Instance.Mirror(value: value, location: this, depth: depth)

  Deletion := class: Quest {
    character: Node
    due: Node
    name: "delete"
    goal: Node
    cancelled: false

    cancel => (
      .cancelled = true
      this
    )
    pending => .cancelled.not.and(.completed.not)
  }

  Mirror := class: Ray {
    value: Node
    location: Node
    depth: 1

    synced => .location.registry.nonempty
  }

}
Status := enum online | offline | hosted | broadcast | proxy | invisible | idle | do_not_disturb | busy
Character := class: Nameable {
  prefix => `@`
  name: String
  avatars: (chain None)
  presence: None
  status: Status.offline
  key: None

  status_now => if (.presence) { .presence.status } else { .status }
  statuses: (chain None)
  also (status) => (
    .statuses &= status
    this
  )
  is (status) => (.status == status).or(.statuses.contains(status))
  chainable == (other) => if (.key === None) { this === other } else { .key == other.key }
  embody (avatar) => (
    .avatars &= avatar
    avatar
  )
}
Avatar := class: Character {
  character: Node
  platform: Node
  avatars: (chain None)
  presence: None
  status: Status.offline

}
Player := class: Character {
  name: String
  avatars: (chain None)
  presence: None
  status: Status.offline

}
NPC := class: Character {
  name: String
  avatars: (chain None)
  presence: None
  status: Status.hosted
  quests: (chain None)
  mode: NPC.Mode.until_resolved

  Mode := enum until_resolved | waiting | stopping
  take (quest) => (
    .quests &= quest
    this
  )
  open_quests => (
    left := chain None
    .quests for { unless it.value.completed { left &= it.value } }
    left
  )
  running => if (.mode == NPC.Mode.waiting) { true } elsif (.mode == NPC.Mode.until_resolved) { .open_quests.nonempty } else { false }
  failed (error) => .take(Quest(name: "fix", goal: error))

}
Organization := class: Player {
  name: String
  avatars: (chain None)
  presence: None
  status: Status.offline
  members: (chain None)

}
