// What `unless` does cannot be taken on trust: here its firing is counted, not reported.

mark ^keyword := external global

fired := 0
unless false { fired += 1 }
unless 1 == 2 { fired += 1 }
unless None { fired += 1 }
unless fired == 3 { INFO@mark `HO1 unless does not take the block when the condition does not hold` }

held := 0
unless true { held += 1 }
unless 1 == 1 { held += 1 }
unless mark { held += 1 }
unless held == 0 { INFO@mark `HO2 unless takes the block when the condition holds` }

Side := enum near (of: "here") | far (of: "there") {}
unless Side.near == Side.near { INFO@mark `HO3 a member is not itself` }
if Side.near == Side.far { INFO@mark `HO4 two members of one enum are the same` }
unless Side.near.of == "here" { INFO@mark `HO5 what a member holds is not what it was written as` }
if Side.near.of == "there" { INFO@mark `HO6 a member holds what the other one does` }

unless " ".length == 1 { INFO@mark `HO7 a written space is not one character` }
unless "  ".length == 2 { INFO@mark `HO8 two written spaces are not two characters` }
unless " a ".length == 3 { INFO@mark `HO9 a letter between spaces is not three characters` }
