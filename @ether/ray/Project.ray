Project := class: Location {
  static Dependency := class ("@", path: (!" ")[]) => {
    name => .path.split("/").last as String
    // PRJ2 a dependency's name is not the last segment of its path
    assert ("@ether/Time" as Project.Dependency).(
      .name == "Time"  // PRJ3 the name of `@ether/Time` is not "Time"
      & .path == "ether/Time"  // PRJ4 the path of a dependency keeps the "@" or leaves out a segment
      & !(.name == "ether")  // PRJ5 the name of a dependency is its first segment
    )

    // (where it is: bundled with the language, at a URL, a language's own project, or a path; at a version, `@x %v0.1.4-E2027.0A.4`, only
    // with @ether/version-control)
    project: Project? => (Program(code: ("@", .path)){O: {
      @ether/{bundled_path: Written} => Project.known(Language.ray.bundled(bundled_path) ?? (@ether / bundled_path).held as Project)
      @{scheme: Char.Word[]}://{remainder: Written} => Project.known((scheme + "://" + remainder) as Held as Project)
      @{name: (Char.Word | "-" | "+")[]{Language.project(.) != None}} => Language.project(name)
      @{local_path: Written} => Project.known(local_path as Held as Project)
    }}()).load
  }

  static known (found: Project?) => found && (Project#{. == found}.first ?? (found ~~ (static.# ??= []).push .))
  assert Project.known(None) == None  // PRJ1 nothing found is a project
  static declared => Project#{.loaded || .loading}.map(.dependencies).flatten
  static declares (name: String) => Project.declared.find(.name == name)
  static holding (location: Location) => Project#{(location.@ as String) ~= ⊢(.@ as String + "/")}.max((.@ as String).count)
  static data (location: Location) => Project.holding(location) -- (held => held && !(held is Language.ray.location#) && !((location.@ as String) ~= ".ray" ⊣))

  name: String?
  description: String?
  dependencies: Dependency[] = []
  carried: *[] = []
  overrides: *[] = []
  readings: Program = {
    {name: String} => Language.for_file(name)
  }
  loading := false
  loaded := false

  shadowing => (.parent, .dependencies.project)#
  language_of (name: String) => Compiler.reduced(name, .readings)
  sources => .held.children**{!(. is Directory) && .name ~= ".ray" ⊣ && .name != ".project.ray" && (.parent == this || !((.parent / ".project.ray") as boolean))}
  load: static => .loaded || .loading ? this : this ~~ (.loading = true) ~~ .sources.for(Language.ray.read(. as String)) ~~ (.loaded = true) ~~ .loading = false
}

@{name: (Char.Word | "-" | "+")[]{Project.declares(.)}} ^string => Project.declares(name).project
@{name: (Char.Word | "-" | "+")[]{Project.declares(.)}}/{path: Written} ^string => Project.declares(name).project / path
