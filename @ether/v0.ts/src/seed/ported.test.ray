say {x} =>
  external io stdout x
// what the old entrypoint had, written again: each line says true (preceding) when it works
a := external node
b := external node
P := class {
  x: Node
  y: Node
}
p := P(a, b)
say (p.fields.head.next.value.value === b)
q := p.copy
say (q.y === b)
say (q is P)
say (p.classes.head.value === p)
A := class { hello => a }
B := class { }
B.components.hierarchy &= A
say (B().hello === a)
say (B() is A)
C := class { }
C = C + A
say (C().hello === a)
say (a.not === false)
say ((a.and(b)) === b)
say ((None.or(b)) === b)
say (a.canonical === a)
l := link a None
say (l.value === a)
both := ((x, y) => y)
say (both(a, b) === b)
k := a
do { k = b } while None
say (k === b)
