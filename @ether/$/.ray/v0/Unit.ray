Quantity<Base = Number> := class = quantities: (quantity: Base, unit: Unit = Unit.None)[]{length > 0} {
  dynamically assert quantities.every _, unit => unit == quantities.0.unit
  dynamically assert quantities.unit as quantities.0.unit[] -- .sorted(>)

  `quantity: Quantity` => quantities ,= quantity

  as (:== Normalizer) => Unit.Normalizers.modulus(this)
  as (normalizer: Quantity{quantities.every(.quantity == 1)}) => this ~~ .normalizer = normalizer

  as (: (operator: (greater_than: > | >=) | < | <=) unit: Unit): static => {
    quantities = this.quantities{.unit operator unit}
    converted_to = quantities.(greater_than ? last : first).unit
    converted_quantities: Quantity = greater_than ? converted_to -> : <- converted_to

    quantities ~~ .(greater_than ? last : first) += converted_quantities as converted_to
  }

  unit => quantities.last.unit
  amount => quantities.last.quantity
  in (target: Unit) => quantities.map(part => (Quantity(quantities: [part]) as target).amount).sum
  finer (other: Quantity) => Quantity(quantities: [(1, unit)]).in(other.unit) >= 1 ? other.unit : unit

  chainable == (other: Quantity) => in(finer(other)) == other.in(finer(other))
  chainable < (other: Quantity) => in(finer(other)) < other.in(finer(other))
  chainable > (other: Quantity) => other < this
  chainable < (other: Number) => ERROR@this `a quantity does not compare with a plain number`
  chainable > (other: Number) => ERROR@this `a quantity does not compare with a plain number`
  compounds + (other: Quantity) => Quantity(quantities: [(in(finer(other)) + other.in(finer(other)), finer(other))])
  compounds - (other: Quantity) => Quantity(quantities: [(in(finer(other)) - other.in(finer(other)), finer(other))])
  compounds * (times: Number) => Quantity(quantities: quantities.map((quantity, unit) => (quantity * times, unit)))
  compounds * (per: Quantity) => unit ==.instance_of Unit.Rate ? Quantity(quantities: [(amount * per.in(unit.denominator), unit.numerator)])
    : ERROR@this `a quantity is multiplied by another only as a rate by what it is per`
  ± | +- (uncertainty: Quantity) => this - uncertainty | this + uncertainty

  as (:== String) => quantities.map((quantity, unit) => (quantity as String) + " " + (unit as String)).join(" ")

  compounds / (unit: Unit) => Quantity(quantities: quantities.map((quantity, from) => (quantity, from / unit)))

  static Temporal = Quantity{unit == Unit.Temporal}
}

Unit := class = name + symbol: boolean? + plural: boolean? + singular: !symbol && !plural {
  static Normalizers := class {
    modulus (order: Quantity) => Quantity.Normalizer = (x) => {
      result: Quantity?
      order.quantities.unit.for unit => {
        quantity = x as unit (-- .floor if !is_last)
        result ? result quantity : result = quantity
        x -= quantity
      }
      result
    }
  }

  static Rate := class: Unit = numerator: Unit, denominator: Unit {
    name => numerator.name + "/" + denominator.name
    chainable == (other: Rate) => numerator == other.numerator && denominator == other.denominator
  }

  (static.# ??= []).push this

  &caller[name] = this if name

  reexport => {
    &caller[name] = this
    defined_globally = true if &caller == global
  }

  static None = Unit(global.None)
  static Temporal => second

  as (:== Quantity) => 1, this
  as (other: ==.instance_of Unit) => this as Quantity as other

  protected defined_globally = &caller == global
  dynamically assert this as String? != None
  as (:== String?) => name
    -- #.remove(Unit#{!= this}.name) if defined_globally

  protected unit = this
  global.`digits: Decimal.String, " "?, name: unit as String`: Quantity => digits, unit
  Decimal.Real &+= {
    `" "?, name: unit as String`: Quantity => this, unit
  }
  Number &+= {
    .`name: unit as String`: Quantity => this, unit
    `" ", name: unit as String`: Quantity => this, unit
  }
  compounds / (other: Unit) => Rate(numerator: this, denominator: other)
    -- .convert x => x * (this as other.static), other.static

  chainable == (other: Unit) => this === other || name == other.name

  convert (convert: (From < Number) => To < Number, ToUnit: Unit) => {
    FromUnit = static

    global.Quantity<From>{.unit == this} &+= {
      as (:== ToUnit): Quantity<To>{unit == ToUnit} => convert(this)
    }
    global.Quantity<To>{.unit == ToUnit} &+= {
      as (:== FromUnit): Quantity<From>{unit == FromUnit} => convert⁻¹(this)
    } if convert⁻¹
  }

  offset (offset: Number, ToUnit: Unit) => convert (x: Number) => x + offset, ToUnit
  multiple (multiple: Number, ToUnit: Unit) => convert (x: Number) => x * multiple, ToUnit

  magnitude (exponent: Number, ToUnit: Unit, Base: Decimal) => {
    convert (x: Decimal) => Decimal, ToUnit
      dynamically assert exponent >= 0 | x % 10^-exponent == 0
      x << exponent
    convert (x: Decimal.Real) => Decimal.Real, ToUnit
      if exponent == 0 { x }
      elsif exponent > 0 { x.integer, x.fraction.0 ?? 0, ".", x.fraction[1..] }
      else { x.integer[..-1], ".", x.integer[-1] ?? 0, x.fraction }
  }
}

SI_Unit {symbol: *} {name: *} => {
  si_name (symbol_prefix, prefix) => symbol_prefix + symbol + symbol: true | prefix + name ("s" + plural: true)?
  private SI = {
    -30: si_name "q", "quecto"
    -27: si_name "r", "ronto"
    -24: si_name "y", "yocto"
    -21: si_name "z", "zepto"
    -18: si_name "a", "atto"
    -15: si_name "f", "femto"
    -12: si_name "p", "pico"
    -9: si_name "n", "nano"
    -6: si_name "µ", "micro"
    -3: si_name "m", "milli"
    -2: si_name "c", "centi"
    -1: si_name "d", "deci"
    0: si_name "", ""
    1: si_name "da", "deka"
    2: si_name "h", "hecto"
    3: si_name "k", "kilo"
    6: si_name "M", "mega"
    9: si_name "G", "giga"
    12: si_name "T", "tera"
    15: si_name "P", "peta"
    18: si_name "E", "exa"
    21: si_name "Z", "zetta"
    24: si_name "Y", "yotta"
    27: si_name "R", "ronna"
    30: si_name "Q", "quetta"
  }
    .map(magnitude, name => Unit(name: magnitude: magnitude))
    .reduce(|)

  SI#.for FromUnit => FromUnit.magnitude SI.magnitude - FromUnit.magnitude, SI
}

Binary_Unit {symbol: *} {name: *} => {
  si_name (symbol_prefix, prefix) => symbol_prefix + symbol + symbol: true | prefix + name ("s" + plural: true)?
  private IEC = {
    1: si_name "Ki", "kibi"
    2: si_name "Mi", "mebi"
    3: si_name "Gi", "gibi"
    4: si_name "Ti", "tebi"
    5: si_name "Pi", "pebi"
    6: si_name "Ei", "exbi"
    7: si_name "Zi", "zebi"
    8: si_name "Yi", "yobi"
    9: si_name "Ri", "robi"
    10: si_name "Qi", "quebi"
  }
    .map(power, name => Unit(name: power: power))
    .reduce(|)

  IEC#.for FromUnit => FromUnit.multiple 1024^FromUnit.power, global[name]
}

SI_Unit s "second"
SI_Unit m "meter"
SI_Unit g "gram"
SI_Unit A "ampere"
SI_Unit K "kelvin"
SI_Unit mol "mole"
SI_Unit cd "candela"

SI_Unit b "bit"
SI_Unit B "byte"
Binary_Unit B "byte"
byte.multiple 8, bit
Unit(name: "KB" + symbol: true).multiple 1000, byte

Unit(name: "minute" ("s" + plural: true)?, symbol: "min" | "m").multiple 60, second
Unit(name: "hour" ("s" + plural: true)?, symbol: "h").multiple 60, minute
Unit(name: "day" ("s" + plural: true)?, symbol: "d").multiple 24, hour
Unit(name: "week" ("s" + plural: true)?, symbol: "wk").multiple 7, day
Unit(name: "year" ("s" + plural: true)?, symbol: "y").multiple 365, day

Unit(name: "celsius", symbol: "°C").offset 273.15, kelvin

Unit(name: "thousand", symbol: "k").multiple 10^3, Unit.None
Unit(name: "million", symbol: "M").multiple 10^6, Unit.None
Unit(name: "billion", symbol: "B").multiple 10^9, Unit.None

Unit(name: "imaginary", symbol: "i")
Complex := Real + Imaginary
Imaginary := Quantity{unit == i}
Complex &+= {
  real => this as Real
  imaginary => (this as Imaginary).amount
  chainable == (other: Complex) => real == other.real && imaginary == other.imaginary
  compounds * (other: Complex) => (real * other.real - imaginary * other.imaginary) + ((real * other.imaginary + imaginary * other.real) i)
  conjugate => real + (imaginary.negated i)
}
