Store := class: Location = name: String, parent: Store?, children: Store[] = [], host: *?, records: Record[] = [] {
  static Record := class = instance: *, assigned: Field[] = []
  static Field := class = definition: Definition, value: *

  record_of (instance) => records{.instance === instance}.first
  put (instance) => (record_of(instance) ?? records.push Record(instance)) -- instance
  holds (instance) => record_of(instance)
  remove (instance) => (records = records{.instance !== instance}) -- instance

  assign (instance, field: Definition, value) => put(instance) -- record_of(instance).assigned.push Field(field, value) -- value
  assigned (instance, field: Definition) => record_of(instance)?.assigned{.definition == field} ?? []
  read (instance, field: Definition, default) => assigned(instance, field).last?.value ?? default
  follows_default (instance, field: Definition) => assigned(instance, field).empty

  all => records.instance
  matching (filter) => all{filter}

  // Where an instance of a type is kept: the first route that takes it, else the default store.
  static Route := class = type: *, filter: *?, store: Store {
    takes (instance) => instance ==.instance_of type && (!filter || filter(instance))
  }
  static routes: Route[] = []
  static materialised: *[] = []
  static default = Store(name: "local")

  static route (type, filter, store) => routes.push Route(type, filter, store) -- store
  static routed (instance) => routes{.takes(instance)}.first?.store ?? default
  static stores_of (type) => (routes{.type === type}.store, default).unique

  static keep (instance) => routed(instance).put(instance)
  static constructed (instance) => instance -- keep(.) if materialised.some(instance ==.instance_of .)

  static of (type) => materialised.contains(type) || materialised.push(type) -- View(type)

  static View := class = type: *, at: Store? {
    stores => stores_of(type){!at || . === at}
    all => stores.all.flatten{==.instance_of type}
    matching (filter) => all{filter}
    located (store) => View(type, at: store)
    count => all.count
    entry => all.entry
  }
}

persistent (value) => Store.keep(value)
