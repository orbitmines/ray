  static span_marked (o, c: Spanned, v) => {
    define(o, c.name, v)
    Marked(name: c.name, from: c.from, to: c.to, value: v)
  }
}
// Keys (`level keys …`): a key's pattern (its `key`, else it), whether it is led by text (begins with a literal) and by
// what byte, whether a pattern's literals all occur in a text; the rules moved from one node to another (all but the
// first two, and those catching all, `moved_keys`); how many rules there are around a context (`keys_version`).
Keys := {
  static key_pattern (x) => Keys.noted_key(topattern(((x is Node) && (member(x, Symbol.key) != None)) ? member(x, Symbol.key) : x))
  static noted_key (p) => {
    cache_key(p)
    p
  }
  static led_by_text (p: Pattern) => (p is Pattern) && ((p.kind == literally) || ((p.kind == in_sequence) && Keys.sequence_led(p.a)))
  static sequence_led (l: List) => (l.count != 0) && Keys.led_by_text(at(l, 0))
  static lead_byte (p: Pattern) => (p.kind == literally) ? Keys.text_lead(p.a) : ((p.kind == in_sequence) ? Keys.sequence_lead(p.a) : (0 - 1))
  static text_lead (t: Text) => (t.to == t.from) ? (0 - 1) : byte(t.from)
  static sequence_lead (l: List) => (l.count == 0) ? (0 - 1) : Keys.lead_byte(at(l, 0))
  static literals_in (p: Pattern, a, e) => (p is Pattern) ? ((p.kind == literally) ? occurs(p.a, a, e) : ((p.kind == in_sequence) ? Keys.sequence_in(p.a, a, e) : 1)) : 1
  static sequence_in (l: List, a, e) => {
    i := 0
    while i < l.count {
      return 0 if Keys.literal_missing(at(l, i), a, e)
      i = i + 1
    }
    1
  }
  static literal_missing (c: Pattern, a, e) => (c is Pattern) && (c.kind == literally) && (occurs(c.a, a, e) == 0)
  static moved_keys (g, p) => Keys.keys_moved_into(keys(member(g, Symbol.rules)), Keys.emptied(keys(member(p, Symbol.rules))), member(g, Symbol.rules))
  static emptied (l: List) => {
    touched(l)
    l.count = 0
    l
  }
  static keys_moved_into (lg: List, lp, rules) => {
    lv := list()
    i := 0
    while i < lg.count {
      Keys.key_moved(lv, lp, at(lg, i), i)
      i = i + 1
    }
    define(rules, Symbol.keys, lv)
    keys_moved()
    int(Texts.count_of(lp))
  }
  static key_moved (lv, lp, x, i) => (i < 2) ? append(lv, x) : ((catch_all(member(x, Symbol.key)) == 0) ? append(lp, x) : 0)
  static keys_version (ctx) => {
    v := 1
    c := ctx
    while c is Node {
      v = v + Keys.rules_count(member(c, Symbol.rules))
      c = member(c, Symbol.in)
    }
    v
  }
  static rules_count (r: Node) => (r.keys == None) ? 0 : (Texts.count_of(r.keys) + 1)
}
// Caches (`level cached …`, removable: each what it caches, again): a list of keys, each its pattern and lead
// (`keys_reading`, by the list, its length and the rules' epoch); of those, the ones read in a text of the program (by
// where it is too); the ones led by text in a node's rules (`led_keys`). Each a table of slots and a room after them,
// cleared once full.
Caches := {
  static leads_at := 3912
  static reads_at := 3984
  static epoch_at := 3996
  static keys_epoch => word_of(epoch_at)
  static cache_table (w, size, first) => (word_of(w) == 0) ? Caches.cache_made(w, size, first) : word_of(w)
  static cache_made (w, size, first) => {
    c := lasting_alloc(size)
    zeroed(c, first)
    word_put(c, first)
    word_put(w, c)
    c
  }
