Node.components.hierarchy &= class {
  conjoins => None
  conjoined => [this]

  & (other) => (
    both ^keyword := .conjoined, other
    class {
      conjoins => global
      conjoined => both
      holds => both.every { it.value }
      admits (candidate) => both.every { candidate.instance_of(it.value) }
      contains (x) => both.contains(x)
    }
  )

  properties => .fields

  inverse => None
  ⁻¹ ^punctuation => .inverse
  ^-1 ^punctuation => .inverse
  ! => .inverse
  reversible => (.inverse === None).not
  inverted_by (backward) => (
    .inverse = backward
    backward.inverse = this
    this
  )
}

!{ }{forward}{ }{backward} ^keyword => forward.inverted_by(backward)

