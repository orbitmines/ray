  static member_called (c: Closure, x, name, args, named) => (c === None) ? invoke(member2(x, name), args, named) : indirect(c.env, args, named, c.function)
  static invoke (c, args, named) => ((c is Builtin) && Runtime.list_changed(c)) ? Runtime.builtin_list(c, arg(args, 0)) : call(c, args, named)
  static list_changed (b: Builtin) => (b.id == Symbol.joined) || (b.id == Symbol.append)
