UI := class {
  running: boolean = false
  scene: Geometry.Shape = Geometry.Box(size: Geometry.Vector(1240px, 800px), overflow: scroll)
  page: *?
  at: Location = @/
  pointer: Pointer?

  Scene := {
    {superposed: |} => Compiler.reduced(@me.choose(superposed), Scene)
    {text: String} => Geometry.Box(content: text, location: text.location)
    {styled: String | Geometry.Shape | Choice ^{{literal expression}}} => Compiler.reduced(styled, Scene).styled_by(Program(code: external ** expression))
    {styled: String ^{style}} => Compiler.reduced(styled.marked(style), Scene)
    {styled: Geometry.Shape | Choice ^{style}} => Compiler.reduced(styled, Scene).styled(style)
    {{literal narrowing}} {narrowed: String | Geometry.Shape | Choice} => Compiler.reduced(narrowed, Scene).narrowed(Program(code: external ** narrowing))
    {location: Location{.media || .video_site}} => location.placed(Geometry.Box(content: location))
    {location: Location} => location.placed(Geometry.Box(content: location as String, location: location))
    {placed: Placed} => Compiler.reduced(placed.value, Scene) ~~ .location = placed.location
    {drawer: Drawer} => Geometry.Box(children: [Overlay(closes: drawer){visible == drawer.open}, drawer ~~ (.position = Geometry.Fixed())
      ~~ (.inset = Geometry.Edges((0px unless drawer.side == Geometry.bottom), (0px unless drawer.side == Geometry.left), (0px unless drawer.side == Geometry.top), (0px unless drawer.side == Geometry.right)))
      ~~ (.width = drawer.extent if drawer.side is Geometry.horizontal) ~~ (.height = drawer.extent if drawer.side is Geometry.vertical)])
    {shape: Geometry.Shape} => shape
    {chosen: Choice} => Geometry.Box(content: chosen)
    {lines: \n} => Geometry.Box(flow: block, children: lines.components)
    {inline: ,} => Geometry.Box(flow: inline, children: inline.components)
    {value: *} => value.rendering ?? Geometry.Box(flow: grid, columns: 2, children: value.fields.map(.name, .value).flatten)
  }

  Choice &+= {
    placeholder_color: Geometry.Paint?
    disabled: boolean = false
    language: Language | String | None = None
    options => type#
    listed => !(type is (boolean | String | Number | Time | Geometry.Color | Location))
    empty => value == None || (value as String).empty
    typed (text: String) => (value = value, text) -- this
    composed (text: String) => (value as String ?? "") -- (now => value = now[..<(now.marks{.style == "composing"}.first?.from ?? now.length)], text.marked("composing")) -- this
    set (text: String) => (value = text) -- this
    erased => (value = value[..<-1]) -- this
    activate => type is boolean ? (value = !value) : listed ? (value = options[(options.index_of(value) + 1) % options.count]) : None
    shown => Compiler.reduced(this, Showing)
    static Showing := {
      {chosen: Choice{type is boolean}} => chosen.value ? "[x]" : "[ ]"
      {chosen: Choice{type is Number{least, most}}} => (chosen.value - chosen.type.least) / (chosen.type.most - chosen.type.least) -- "─" * (. * 10), "●", "─" * (10 - . * 10)
      {chosen: Choice{type is String{secret}}} => "•" * (chosen.value as String).length
      {chosen: Choice{listed}} => "‹ ", chosen.value as String, " ›"
      {chosen: Choice{empty}} => chosen.placeholder as String
      {chosen: Choice{language}} => (chosen.value as String).highlighted(chosen.language)
      {chosen: Choice} => chosen.value as String
    }
  }

  Pointer := class = kind: mouse | pen | touch = mouse, id: Number = 0, position: Geometry.Vector = Geometry.Vector(), pressure: Probability = 0, tilt: Geometry.Vector = Geometry.Vector(), buttons: Number[] = [], wheel: Geometry.Vector = Geometry.Vector() {
    pressed => buttons.nonempty || pressure > 0
    released => !pressed && (history[-2]?.pressed ?? false)
    velocity => history[-2..] -- (.count == 2 && .last.when > .first.when ? (.last.position - .first.position) * (1 / ((.last.when - .first.when) as ms)) : Geometry.Vector())
    pressed_at => history{from pressed}.last?.first
    swipe => history{from pressed to !pressed}.last -- (from: .first, to: .last, distance: .last.position - .first.position, duration: .last.when - .first.when)
    to (at: Geometry.Vector, pressing: Number[] = buttons, time: Time = Time.now) => {
      with Time.now = time {
        position = at
        (buttons = pressing) if pressing != buttons
      }
      this
    }
  }
  pointed (kind: mouse | pen | touch = mouse, id: Number = 0) => pointer#{.kind == kind && .id == id}.first ?? Pointer(kind, id) -- (made => (pointer |= made) -- made)

  focus: Geometry.Shape{focused}[]{length <= 1} => scene{focused}
  tab (step: next | previous = next) => focus = scene{focusable}.loop{focused}.`step` ?? scene{focusable}.first

  selection: Geometry.Shape{selected}[] => scene{selected}
  current => selection.last ?? scene
  step (from: Geometry.Shape, direction: Geometry.Side) => (if direction {
      Geometry.bottom => from.children.first
      Geometry.top => from.parent
      Geometry.right => from.parent?.children{=== from}.next
      Geometry.left => from.parent?.children{=== from}.previous
    }) ?? from
  move (direction: Geometry.Side) => selection = step(current, direction)
  skip (direction: Geometry.Side) => selection = step(step(current, Geometry.top), direction)
  expand (direction: Geometry.Side) => selection |= step(current, direction)

  locked => scene{. is Drawer && open}.nonempty
  back => at.history.back -- at

  Location &+= {
    window: same | new = same
    alt: String?
    fit: contain | cover | fill | none = contain
    controls: boolean = true
    muted: boolean = false
    looping: boolean = false
    components: *[] = []
    copied => Location(scheme, host, port, path, query, fragment, window, alt, fit, controls, muted, looping, components)
    extension => (path ~= (*, ".", last: Char.Word[]) ⊣)?.last
    language => extension ? Language.named("." + extension) : None
    media => language === Language.Image || language === Language.Video || language === Language.Audio
    pixels => language.read(content)
    static VideoId := (!"&" && !"?" && !"#")[]
    static Rest := (("&" | "?" | "#"), *)?
    static Embedding := {
      @https://youtu.be/{id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
      @https://youtube.com/watch?v={id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
      @https://www.youtube.com/watch?v={id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
      @https://www.youtube.com/embed/{id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
    }
    static Offset := class ((hours: Decimal, "h")?, (minutes: Decimal, "m")?, (seconds: Decimal, "s"?)?) => {
      total => (hours ?? 0) * 3600 + (minutes ?? 0) * 60 + (seconds ?? 0)
    }
    static Embedded := {
      {pair: (name: "t", value: *)} => (name: "start", value: (pair.value ~= (at: Offset)).at.total as String)
      {pair: (name: "v", value: *)} => None
      {pair} => pair
    }
    embedded => Compiler.reduced(this, Embedding) -- (embed => embed === this ? this
      : Location(embed.scheme, embed.host, embed.port, embed.path, query: Location.Query(pairs: query.pairs.map(Compiler.reduced(., Embedded)).compact), fragment: fragment))
    video_site => embedded !== this
    placed (shape: Geometry.Shape) => components.for(.entered(shape, None)) -- ((shape.aspect = 16 / 9) if video_site) -- shape
    narrowed (narrowing: Program) => copied -- (copy => [narrowing{O: Geometry.Settings}()].flatten.for(write => write.writes.every(copy.declaring(.)) ? write.entered(copy, None) : (copy.components ,= write)) -- copy)
    {this}{{literal narrowing}} ^punctuation => narrowed(Program(code: external ** narrowing))
  }
  Site := class = index: *? {
    static (value) as (=== Site) => Site(index: value)
    at (path: String) => index{location ~= path} ?? index
    rendering => at(UI.at.path as String)
  }

  Popover := Geometry.Box{position.kind == anchored, layer == 20, visible == (position.anchor.hovered | position.anchor.focused | hovered)}
  Overlay := Geometry.Box{closes: None, position.kind == fixed, inset == 0px, layer == 19, fill: Geometry.Color(0, 0, 0, 0.5)}
  Drawer := Geometry.Box{open: false, side: Geometry.left, extent: 75vw, layer == 20, overflow == scroll, visible == open, transition == Geometry.Transition(0.3 s)}

  Geometry.Shape &+= {
    focused: boolean = false
    selected: boolean = false
    dragged: boolean = false
    dropped: Location?
    hovered => visible && UI.pointer && contains(UI.pointer.position - at)
    pressed => hovered && UI.pointer.pressed
    activated => focused && @me/device/keyboard/Enter.pulsed || hovered && UI.pointer.released
    focusable => location || content is Choice || activate
    activate => this is UI.Overlay ? (closes?.open = false)
      : content is Choice ? content.activate
      : location ? (location.window == new ? (@me/device/opened = location) : (UI.at = location)) : None
    submitted => dynamically children{.content is Choice}.every(.content.value) && @me/device/keyboard/Enter.pulsed
    text: String => content is Choice ? (content.empty ? "" : content.value as String) : content is String ? content : texts.content.join("")
    select (from: Number = 0, to: Number = text.length) => (selected = true) -- text.marked("selected", from, to) -- (marked => content is Choice ? (content.value = marked) : content is String ? (content = marked) : None) -- this
    scroll (by: Geometry.Length) => (scrolled = Geometry.Vector(scrolled.x, (scrolled.y + by) min (content_height - size.y) max 0px)) unless this === UI.scene && UI.locked
    reveal (shape: Geometry.Shape?, align: start | center | end = start, smooth: boolean = false, offset: Geometry.Length = 0px) => shape && ((at.y + size.y) - (shape.at.y + shape.size.y) + scrolled.y + offset - (if align {
        center => (size.y - shape.size.y) / 2
        end => size.y - shape.size.y
      } else {
        0px
      })) max 0px -- (to => ((transition = Geometry.Transition(300 ms, Geometry.ease_out)) if smooth && !@me/device/preferences.reduced_motion)
        -- (scrolled = Geometry.Vector(scrolled.x, to)))
    face => content -- (chosen => Geometry.Box(content: chosen.shown, origin: at + padding.start, size: size - padding.total, font: font,
      color: chosen.empty ? chosen.placeholder_color ?? Theme["muted"].color : color, white_space: chosen.type is String{multiline} ? Geometry.WhiteSpace.pre_wrap : Geometry.WhiteSpace.nowrap, palette: palette))
    label => content is Location ? content.alt ?? content.name : children{.content is String}.content.join(" ")
    styled (name: String) => (styles ,= name) -- Theme[name] -- (style => font -- (was => (this += style{!(. is Program)}) -- (font = style.font ?? was))
      -- style{. is Program}.for(narrowed(.))) -- this
    styled_by (expression: Program) => styled(expression() as String) -- (styles = Dynamic(expression)) -- this
    themed => styles -- (own => (styles = []) -- Compiler.reduced(this, Theme.kinds) -- (styles.nonempty ? own.for(styled(.)) : (styles = own)))
      -- ((content.whole_marks{!styles.contains(.style)}.style.for(styled(.))) if content is String) -- children.for(.themed) -- this
  }

  Theme := class {
    static spacing: Geometry.Length = 0.125rem
    static scaled (amount: Number | Geometry.Length) => amount is Number ? spacing * amount : amount
    static kinds := { }
    static palettes = DARK{dark: true}
    static palette => palettes{dark == @me/device/preferences.dark} ?? palettes
    static painted (style: String, palette = Theme.palette) => palette.map((name, paint) => (name, paint as Geometry.Color)){style == .0 || style.starts_with(.0 + ".")}.last?.1 ?? Theme[style].color
    static face (shape: Geometry.Shape, index: Number) => (shape.content is String ? shape.content.marks{.from <= index < .to} : []).reduce(acc = (font: shape.font, color: shape.color, fill: shape.fill, styles: []) => (
      font: Theme[.style].font ?? acc.font,
      color: painted(.style, shape.palette ?? palette) ?? acc.color,
      fill: Theme[.style].fill ?? acc.fill,
      styles: [acc.styles, [.style]].flatten(1)
    ))
    static styles: (name: String, *)[] = [
      ("italic", font: Geometry.Font(style: italic)),
      ("bold", font: Geometry.Font(weight: 700)),
      ("muted", color: Geometry.Color(128, 128, 128)),
      ("disabled", color: Geometry.Color(160, 160, 160)),
      ("selected", fill: Geometry.Color(51, 144, 255, 0.4)),
      ("h1", font: Geometry.Font(size: 2em, weight: 700)),
      ("h2", font: Geometry.Font(size: 1.5em, weight: 700)),
      ("h3", font: Geometry.Font(size: 1.17em, weight: 700)),
      ("code", white_space: Geometry.WhiteSpace.pre)
    ]
    static [name: String] => styles{.name == name}.last - name ?? ()
  }
  String &+= {
    marks: (from: Number, to: Number, style: String)[] = []
    location: Location?
    marked (style: String, from: Number = 0, to: Number = length) => this ~~ .marks = [marks, [(from, to, style)]].flatten(1)
    marked_text (style: String) => marks{.style == style}.map(this[.from..<.to]).join("")
    whole_marks => marks{.from <= 0 && .to >= length}
    partial_marks => marks{!(.from <= 0 && .to >= length)}
    pieces => [0, partial_marks.map(.from, .to).flatten, length].flatten.unique.sort -- .zip(.rest).map((from, to) => (text: this[from..<to], from: from))
    highlighted (language: Language | String) => (language is String ? Language.named(language.starts_with(".") ? language : "." + language) : language).painted(this).reduce(acc = marked("code") => acc.marked(.style, .from, .to))
  }

  Watch := class = watched: Program, action: Program, becoming: *? {
    static all: Watch[] = []
    matches => becoming == None ? watched.history : watched.history{.value == becoming}
    seen: Number = watched() -- (now => matches.count - (becoming != None && now == becoming ? 1 : 0))
    ready => watched() -- matches.count > seen
    fired => ready -- (go => (seen = matches.count) -- (action() if go))
    start => Watch.all{.action.code == action.code}.first ?? (Watch.all.push this -- this)
  }
}

[p: Geometry.all, px: Geometry.horizontal, py: Geometry.vertical, pt: Geometry.top, pb: Geometry.bottom, pl: Geometry.left, pr: Geometry.right].for (word, side) => [(word, "padding"), (word.replace("p", "m"), "margin")].for (shorthand, edges) => {
  `shorthand` {amount: Number | Geometry.Length} ^keyword => (`edges`: Geometry.Edges() ~~ .(side) = UI.Theme.scaled(amount))
}

Unit(name: "viewport width", symbol: "vw")
  .convert (x: Number) => x * (UI.scene.size.x as px) / 100, px
Unit(name: "viewport height", symbol: "vh")
  .convert (x: Number) => x * (UI.scene.size.y as px) / 100, px

Program &+= {
  drawn (before: Geometry.Shape = UI.scene) => (UI.page = this()) -- Geometry.Box(size: before.size, scrolled: before.scrolled, overflow: scroll, transition: before.transition, children: [this{O: UI.Scene}().themed])
  rendered (level) => Compiler.reduced(drawn(), level)
  frame (renderer) => (UI.scene = Compiler.reduced(drawn(), Geometry.Solving)) -- Compiler.reduced(UI.scene, renderer.level)
  run (renderer, target) => (UI.running = true) -- target.start
    -- ({ target.copy(@me/device/clipboard) } when @me/device/clipboard changes)
    -- ({ target.open(@me/device/opened) } when @me/device/opened changes)
    -- ((target.write(frame(renderer)) -- target.read -- UI.Watch.all.for(.fired)) while UI.running)
    -- target.stop -- this
  after (delay: Quantity.Temporal) => (Time.now + delay) -- (due => UI.Watch(Program(code: { Time.now >= due }), this, true).start)
  when (watched: Program, becoming: * = None) => UI.Watch(watched, this, becoming).start
}
when {value} changes {{action}} ^keyword => Program(code: external ** action).when(Program(code: external ** value))
{action} when {value} changes ^keyword => Program(code: external ** action).when(Program(code: external ** value))
{action} when {value} becomes {target} ^keyword => Program(code: external ** action).when(Program(code: external ** value), target)
after {delay: Quantity.Temporal} {{action}} ^keyword => Program(code: external ** action).after(delay)
{action} after {delay: Quantity.Temporal} ^keyword => Program(code: external ** action).after(delay)

Language.Image := class: Language {
  static extensions = ".png" | ".jpg" | ".jpeg" | ".gif" | ".svg" | ".webp" | ".avif"
  level := {
    {encoded} => $.png.read(encoded)
  }
}
Language.Video := class: Language { static extensions = ".mp4" | ".webm" | ".ogv" }
Language.Audio := class: Language { static extensions = ".mp3" | ".ogg" | ".wav" | ".flac" }
