  static folded_kind (fl, fo, fr, fk, fp) => (High.additive(fo) && (fk == `add_left`)) ? High.folded(() => High.op_written(fo, fl, () => High.expression(fp.add_left)), "plus", fp.add_right) : ((High.additive(fo) && (fk == `sub_left`)) ? High.folded(() => High.op_written(fo, fl, () => High.expression(fp.sub_left)), "minus", fp.sub_right) : High.folded_times(fl, fo, fr, fk, fp))
  static folded_times (fl, fo, fr, fk, fp) => (High.multiplicative(fo) && (fk == `mul_left`)) ? High.folded(() => High.op_written(fo, fl, () => High.expression(fp.mul_left)), "times", fp.mul_right) : ((High.multiplicative(fo) && (fk == `div_left`)) ? High.folded(() => High.op_written(fo, fl, () => High.expression(fp.div_left)), "quotient", fp.div_right) : ((High.multiplicative(fo) && (fk == `rem_left`)) ? High.folded(() => High.op_written(fo, fl, () => High.expression(fp.rem_left)), "remainder", fp.rem_right) : High.op_written(fo, fl, () => High.expression(fr))))
  static additive (ao) => (ao == "plus") || (ao == "minus")
  static multiplicative (mo) => (mo == "times") || (mo == "quotient") || (mo == "remainder")
  static op_written (ow_name, ow_left, ow_right) => {
