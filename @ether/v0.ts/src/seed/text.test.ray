say {x} =>
  external io stdout x
YES := external node
YES.yes = YES
NO := external node
NO.no = NO
holds {x} =>
  external io stdout (x === true ? YES : (x === false ? NO : x))
s := "ab"
holds s.empty
holds s.rest.empty
holds s.rest.rest.empty
holds "".empty
t := "ab" + "cd"
holds t.empty
holds t.rest.rest.rest.empty
holds t.rest.rest.rest.rest.empty
holds ("" + "").empty
holds ("a" + "").rest.empty
holds (None !== None)
holds (s !== None)
