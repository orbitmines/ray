// From the draft at .ray2/_todo/ray.ray.txt/Ether/instance/utils/Unit.ray.
// What the language reaches today: a unit is named, has a symbol, and is
// either a base unit or a multiple of another unit; a quantity is a number
// carrying a unit, and converting a quantity between two units of one kind
// goes through their common base. The draft's SI prefix table, offset
// conversions, normalizers (`10000000s as days hours minutes seconds`) and
// the `1.0m` / `1 m` literal syntaxes wait on decimals, strings and larger
// numbers.

Unit := class {
  is_base => (exists .base).not
  rank => if .is_base { zero } else { .base.rank.succ }

  // How many of the base unit one of this unit is.
  // A prefixed unit's factor is its prefix's, read when asked.
  ratio => if (exists .prefix) { .prefix.factor } else { .factor }
  scale => if .is_base { one } else { .ratio * .base.scale }
  // Where this unit's zero sits on the base unit's line (`def offset`); `as`
  // does not apply it yet.
  shift => if (exists .offset) { .offset } else { zero }

  // Allow for syntax `year as ns`: one of this unit, expressed in another.
  as (other: Unit) => (one of this) as other

  // `def multiple multiple: Number, ToUnit: Unit` and `def offset`: a unit
  // defined from this one.
  multiple (times: Number) => (
    parent := this
    Unit(
      base: parent
      factor: times
    )
  )
  shifted (by: Number) => (
    parent := this
    Unit(
      base: parent
      factor: one
      offset: by
    )
  )
  // `SI#.for FromUnit = FromUnit.magnitude …`: this unit with an SI prefix.
  prefixed (prefix: Prefix) => (
    parent := this
    Unit(
      base: parent
      prefix: prefix
    )
  )
}

Quantity := class {
  // Arguments are read inside the new quantity, so what they need from this
  // one is read first.
  as (other: Unit) => (
    converted := (.amount * .unit.scale) / other.scale
    Quantity(
      amount: converted
      unit: other
    )
  )

  // Arithmetic happens in the finer of the two units, so nothing is lost.
  // spec: on one base line the finer unit is the one fewer multiples up, so
  // no scale (which can be thousands) is built to decide.
  finer (other: Quantity) => if (other.unit.rank < .unit.rank) { .unit } else { other.unit }
  + (other: Quantity) => (
    kind := .finer(other)
    total := (this as kind).amount + (other as kind).amount
    Quantity(
      amount: total
      unit: kind
    )
  )
  - (other: Quantity) => (
    kind := .finer(other)
    difference := (this as kind).amount - (other as kind).amount
    Quantity(
      amount: difference
      unit: kind
    )
  )

  == (other: Quantity) => (
    kind := .finer(other)
    (this as kind).amount == (other as kind).amount
  )
  < (other: Quantity) => (
    kind := .finer(other)
    (this as kind).amount < (other as kind).amount
  )
}

// Allow for syntax `1 of Byte`, `3 of Bit`: a number followed by a unit. The
// draft's `1 Byte` and `1.0m` wait on the number literal itself. A number
// takes this on as a class component, so every number already built reads it.
Measured := class {
  of (measure) => (
    held := this
    kind := measure
    Quantity(
      amount: held
      unit: kind
    )
  )
}
Number.components.hierarchy &= Measured

// def SI_Unit
//   def `symbol: *` name: *
//     def si_name(symbol_prefix, prefix) = symbol_prefix + symbol + symbol: true | prefix + name ("s" + plural: true)?
//     private SI = { -30: si_name "q", "quecto" … 30: si_name "Q", "quetta" }
//     SI#.for FromUnit = FromUnit.magnitude SI.magnitude - FromUnit.magnitude, SI
// A prefix is its symbol and its power of ten; the number is built when a unit
// asks for it, so loading the table costs nothing. spec: the negative powers
// (deci … quecto) wait on reals, the powers past kilo on numbers past a
// thousand being cheap to walk; they are listed as the draft lists them.
Prefix := enum deka (symbol: `da`, magnitude: one) | hecto (symbol: `h`, magnitude: two) | kilo (symbol: `k`, magnitude: three) | mega (symbol: `M`, magnitude: six) | giga (symbol: `G`, magnitude: nine) | tera (symbol: `T`, magnitude: ten + two) | peta (symbol: `P`, magnitude: ten + five) | exa (symbol: `E`, magnitude: ten + eight) | zetta (symbol: `Z`, magnitude: (two * ten) + one) | yotta (symbol: `Y`, magnitude: (two * ten) + four) | ronna (symbol: `R`, magnitude: (two * ten) + seven) | quetta (symbol: `Q`, magnitude: three * ten) {
  factor => ten.pow(.magnitude)
}
// SI_Unit m "meter": a base unit with every prefix of the table.
// spec: the prefixed units are built on demand, `unit prefixed Prefix.kilo`,
// rather than all at once.
SI_Unit{ }{literal symbol}{ }{literal name} ^keyword => Unit(
  name: name
  symbol: symbol
)

// A unit is named, has a symbol, and is either a base unit or `factor` of a
// `base` unit. The fields are what a unit is built with; a spaced `:` takes
// the rest of its line, so each field goes on a line of its own.
Bit := Unit(
  name: `bit`
  symbol: `b`
)
Byte := Unit(
  name: `byte`
  symbol: `B`
  base: Bit
  factor: eight
)
// Kilobyte | KB = 1000 * Byte, Kibibyte = 1024 * Byte
Kilobyte := Byte prefixed Prefix.kilo
Kibibyte => Byte multiple (two.pow(ten))

