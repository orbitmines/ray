// A path as written after `@` or `/`: no space, comma or brace, its brackets balanced (`@./a(b)/c`)
Path := (Char{!= " " && != "(" && != ")" && != "," && != "{" && != "}" && != \n} | ("(", Path, ")"))[]
assert "a(b)c" is Path  // LOC60 a word with parentheses balanced inside is not a path
assert !("a b" is Path)  // LOC61 a space inside a path does not end it
assert !("a)" is Path)  // LOC62 a lone closing parenthesis is in a path

// What holds a location: the rules a project adds when it reserves a space (@ether/filesystem the file space, @ether/network
// the URLs), each answering a holder; none, nothing holds it
Holders := { }

// A location (RFC 3986 section 3): a scheme, then the authority only when "//" follows, a path, a query (read as its
// parameters, `?a=1&b=x%20y` is `{ a: "1", b: "x y" }`: `.query.a`) and a fragment.
// What is there is what holds it answers: read, `.held`; written, `@x = value` (`@x = None` removes it, `@new = @x` copies
// what is held); executed, `@x(…)`; as a boolean, whether anything is there. A location made in memory holds its `content`
// and its `children` itself (a tree of files).
Location := class: Hierarchy (
  (scheme: Char.Word[], ":", ("//", host: Char{!= ":" && != "/" && != "?" && != "#"}[], (":", port: Decimal)?)?)?,
  path: Char{!= "?" && != "#"}[],
  ("?", {query: Location.parameters(.)}: Char{!= "#"}[])?,
  ("#", fragment: Char[])?
) => {
  // LOC1 a url read as a location does not split into its scheme, host, port, path, query and fragment (RFC 3986 section 3)
  assert ("https://orbitmines.com:8080/a/b?x=1&y=2#frag" as Location).(
    .scheme == "https"  // LOC2 the scheme is not what comes before ":"
    & .host == "orbitmines.com"  // LOC3 the host is not what follows "//"
    & .port == 8080  // LOC4 the port is not the decimal after the host's ":"
    & .path == "/a/b"  // LOC5 the path is not what lies before "?"
    & .fragment == "frag"  // LOC6 the fragment is not what follows "#"
  )
  // LOC7 the authority is read without "//" following the scheme
  assert ("mailto:fadi@orbitmines.com" as Location).(
    .scheme == "mailto"  // LOC8 a scheme without "//" is not read
    & .path == "fadi@orbitmines.com"  // LOC9 without "//" the rest is not the path
    & .host == None  // LOC10 a url without "//" has a host
  )
  // LOC11 a relative path takes a scheme or host from nowhere
  assert ("a/b" as Location).(
    .scheme == None  // LOC12 a relative path has a scheme
    & .host == None  // LOC13 a relative path has a host
    & .path == "a/b"  // LOC14 a relative path is not its own path
  )
  content: *?
  location => this
  holder => Compiler.reduced(this, Holders) -- (. === this || . is Location ? None : .)
  held => .holder ? .holder[this] : .content
  = (value) ^punctuation => .holder ? (.holder[this] = (value is Location ? value.held : value)) : ERROR@Location `nothing loaded holds the location to write it`
  ({args}) => .holder ? .holder(this, args) : None
  as (=== boolean) => .held !== None
  assert ("/no/such/place/anywhere" as Location).held == None  // LOC51 a location nothing holds holds something
  assert ("/no/such/place/anywhere" as Location)(1, 2) == None  // LOC53 executing what nothing holds gives something
  assert Location(path: "t", content: "hi").held == "hi"  // LOC48 a location made in memory does not hold its content

  // (a query as its parameters, each decoded: a name given twice, the last; RFC 3986 section 2.1, "+" a space)
  static parameters (text: String) => {
    given := { }
    text.split("&"){.nonempty}.for(given[Location.decoded(.before("=") ?? .)] = Location.decoded(.after("=") ?? ""))
    given
  }
  assert ("?a=1&b=2" as Location).query.b == "2"  // LOC21 a query's value is not found by its name
  assert ("?a=1&a=2" as Location).query.a == "2"  // LOC22 with a repeated name, the last value is not the one found
  assert ("?a=1" as Location).query.b == None  // LOC23 a name that is not there has a value
  static decoded (text: String) => (text.split("+").join(" ") as Byte[]) -- (bytes => Location.unescaped(bytes) as String)
  static unescaped (bytes: Byte[]) => bytes.empty ? [] : bytes.first == "%" as Byte
    ? [(bytes[1..<3] as String as Hexadecimal₂) as Byte, Location.unescaped(bytes[3..])].flatten
    : [bytes.first, Location.unescaped(bytes.rest)].flatten
  assert Location.decoded("a%20b") == "a b"  // LOC15 a percent-encoded value is not decoded (RFC 3986 section 2.1)
  assert Location.decoded("a+b") == "a b"  // LOC16 "+" in a query is not a space
  assert Location.decoded("%C3%A9") == "é"  // LOC17 a multi-byte percent sequence is not decoded as UTF-8 ("%C3%A9" is U+00E9)
  // the same location, its query's parameters changed (None removes one)
  with (changes) => ((this.origin as String) + .path + "?" + [.query.fields{!changes.fields.name.contains(.name)}, changes.fields{.value != None}]
    .flatten.map(.name + "=" + (.value as String)).join("&") + (.fragment ? "#" + .fragment : "")) as Location
  assert ("https://orbitmines.com/p?a=1" as Location).with(a: 2) as String == "https://orbitmines.com/p?a=2"  // LOC25 a location changed in its query is not the same location with that query
  assert ("?a=1&b=2" as Location).with(a: None).query.(.a == None & .b == "2")  // LOC20 a parameter changed to None is not removed
  assert ("?a=1&b=2" as Location).with(b: 3, c: 4).query.(.a == "1" & .b == "3" & .c == "4")  // LOC19 changing parameters drops, keeps or misses one

  segments => .path.split("/"){.nonempty}
  assert ("/a//b/c/" as Location).segments == ["a", "b", "c"]  // LOC24 a path's segments are not its non-empty parts between "/"
  normalised => .segments{!= "."}.reduce(kept = [] => . == ".." ? kept[..<-1] : (kept, .)).join("/")
  assert ("a/./b/../c" as Location).normalised == "a/c"  // LOC75 a path is not normalised without "." and what ".." leaves
  origin => Location(.scheme, .host, .port, path: "")
  assert ("https://orbitmines.com:8080/a/b" as Location).origin as String == "https://orbitmines.com:8080"  // LOC76 the origin of a location is not its scheme, host and port
  name => .segments.last ?? ""
  assert ("https://orbitmines.com/a/b.txt" as Location).name == "b.txt"  // LOC40 a location's name is not its last segment
  assert ("https://orbitmines.com" as Location).name == ""  // LOC41 a location without segments is not named ""

  // text after it (`+ "/b"`), or a segment under it (`/ "b"`)
  + (suffix: String | Location) => ((this as String) + (suffix as String)) as Location
  assert (("https://orbitmines.com/a" as Location) + "/b") as String == "https://orbitmines.com/a/b"  // LOC26 adding a string to a location does not append it to the location's text
  assert (("https://orbitmines.com" as Location) + ("/a" as Location)) as String == "https://orbitmines.com/a"  // LOC27 adding a location does not append that location's text
  / (segment: String) => this + "/" + segment ~~ (WARN@Location `text joined into a path may leave it` if segment ~= (*, ".." | "/", *))
  assert (("https://orbitmines.com" as Location) / "a") as String == "https://orbitmines.com/a"  // LOC28 joining a segment does not add "/" and the segment
  assert (("https://orbitmines.com" as Location) / "..") as String == "https://orbitmines.com/.."  // LOC29 joining a segment with ".." does not still join it
  == (other) => (this as String) == (other as String)
  assert ("https://orbitmines.com/a" as Location) == "https://orbitmines.com/a"  // LOC33 a location is not equal to the text it is written as
  assert ("https://orbitmines.com/a" as Location) == ("https://orbitmines.com/a" as Location)  // LOC34 a location is not equal to an identical location
  assert !(("https://orbitmines.com/a" as Location) == "https://orbitmines.com/b")  // LOC35 two different locations are equal

  // a name it does not have read where it is (`shadowing`) or above it
  shadowing: Location?
  [name: String] => .fields{.name == name}.last.value ?? (.shadowing ?? .parent)?[name]
  assert ("https://orbitmines.com/a" as Location)["host"] == "orbitmines.com"  // LOC38 a location's field is not found by its name
  assert ("https://orbitmines.com/a" as Location)["nothing_has_this_name"] == None  // LOC39 a name nothing has answers with something
  assert {
    kept := Location(path: "kept")
    kept["ray:a/b"] = "x"
    assert kept["ray:a/b"] == "x" & kept.fields.name == ["ray:a/b"]  // IO8 a field written by name is not read back, or not listed
    kept["ray:a/b"] = None
    assert !(kept.fields{.value !== None}.nonempty)  // IO10 a field removed by name is still listed
  }

  // a span of it, from a line and column to another (`@/t.ray{.from == (4, 1)}`); `file`, the whole of it
  from: (line: Decimal, column: Decimal)?
  to: (line: Decimal, column: Decimal)? = .from
  file => this ~~ (.from = None) ~~ (.to = None)

  // a tree of files in memory: placed at relative paths, found again, each leaf a file
  files => .children.nonempty ? .children.map(.files).flatten : [this]
  assert ("/no/such/place" as Location).files.count == 1  // LOC42 a location holding nothing is not its own only file
  at (relative: String) => relative.split("/"){.nonempty}.reduce(held = this => held.children.find(.name == .))
  placed (relative: String, bytes) => relative.split("/"){.nonempty} -- (segments =>
    (this.children.find(.name == segments.first) ?? this.add(Location(path: (this.path, segments.first){.nonempty}.join("/"), content: segments.count == 1 ? bytes : None)))
      -- (next => segments.count == 1 ? next : next.placed(segments.rest.join("/"), bytes)))
    -- this
  assert {
    tree := ("/t" as Location).placed("a/b.txt", "hi")
    assert tree.at("a/b.txt").name == "b.txt" & tree.at("a/b.txt").held == "hi"  // LOC44 a location placed at a relative path cannot be found there, or does not hold what was placed
    assert tree.at("a/missing.txt") == None  // LOC45 a path that is not there finds something
    assert tree.files.count == 1 & tree.files.first.name == "b.txt"  // LOC46 placing bytes at a relative path does not leave a file named by its last segment
    assert tree.at("a").name == "a"  // LOC47 the placed file is not under the directory of the first segment
  }
}
// A location one may execute: one granted the execute method
Executable := Location{.access#.some(.executes)}
assert !("/no/such/place/anywhere" as Location is Executable)  // LOC59 a location without execute access is an executable
// A directory: a location holding locations
Directory := Location{.held is Location[]}
assert !("/no/such/place/anywhere" as Location is Directory)  // LOC58 a location nothing holds is a directory

// Written in code (`@"…"` is a character's name, Character.ray): `@scheme://…`, `@/…`, `@./…`, `@../…`, `@C:/…` (a Windows drive,
// https://url.spec.whatwg.org/#windows-drive-letter), `@name/…`
@{scheme: Char.Word[]}://{rest: Path} ^string => (scheme + "://" + rest) as Location
assert @https://orbitmines.com/a as String == "https://orbitmines.com/a"  // LOC63 `@scheme://rest` is not the location written out
@{start: ("." | "..")?}/{path: Path} ^string => (start + "/" + path) as Location
assert @/etc/hosts as String == "/etc/hosts"  // LOC65 `@/path` is not the absolute location
assert @./a/b as String == "./a/b"  // LOC66 `@./path` is not the location relative to here
assert @../a as String == "../a"  // LOC67 `@../path` is not the location relative to the parent
@{drive: Char.Letter}:/{path: Path} ^string => (drive + ":/" + path) as Location
assert @C:/Windows/System32 as String == "C:/Windows/System32"  // LOC68 `@C:/path` is not a Windows drive location
@{name: Char.Word[]}/{path: Path} ^string => (name + "/" + path) as Location
assert @a/b as String == "a/b"  // LOC69 `@name/path` is not the location under that name

// Reading a location answers what is there and leaves it as it was: the file the library is declared in is read twice.
// (Writing a location is not claimed here: a test that writes a file leaves one behind.)
assert {
  read_once := (@ether/.project.ray).held as String
  read_twice := (@ether/.project.ray).held as String
  assert read_once.nonempty  // IO5 a read answers nothing
  assert read_once == read_twice  // IO6 reading a file changed it
  // A location computed as a string reaches the machine as the bits it is written with.
  assert ("@ether/.project.ray".bits as Location).held as String == read_once  // IO7 a location given as a string's bits is read as another place
}
