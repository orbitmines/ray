// SQLite's command-line shell (https://sqlite.org/cli.html) and database file format (https://www.sqlite.org/fileformat2.html)
SQLite := Language(".sqlite" | ".sqlite3" | ".db", written: SQL.written, of: SQL){
  level => SQL.syntax + {
    {at: Location} => SQL.Database(at: at, dialect: this)
  }
  // JSON output mode (https://sqlite.org/cli.html#changing_output_formats)
  answered (at: Location, text: String) => Quest(name: "talk to a database without a process: its wire protocol, or the planned binary pipeline", goal: text)
  sent (at: Location, text: String) => Quest(name: "talk to a database without a process: its wire protocol, or the planned binary pipeline", goal: text)
  // The schema table (https://www.sqlite.org/schematab.html)
  listing = @sql SELECT name FROM sqlite_master WHERE type = 'table'
}

SQL.Database &+= {
  as (=== Byte[]) => @"instance/sqlite/written.db" -- (at => at.remove -- SQLite.read(at).executed(statements) -- at.bytes)
}
