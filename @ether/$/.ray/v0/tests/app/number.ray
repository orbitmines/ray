mark ^keyword := external global

unless 0.is_zero { INFO@mark `N1 zero is not zero` }
if 1.is_zero { INFO@mark `N2 one reports zero` }
unless 1 + 2 == 3 { INFO@mark `N3 1 + 2 is not 3` }
unless 3 - 1 == 2 { INFO@mark `N4 3 - 1 is not 2` }
unless 1 - 3 == 0 { INFO@mark `N5 1 - 3 does not floor at zero` }
unless 2 * 3 == 6 { INFO@mark `N6 2 * 3 is not 6` }
unless 1 < 2 { INFO@mark `N7 1 < 2 is false` }
if 2 < 1 { INFO@mark `N8 2 < 1 is true` }
unless 6 / 2 == 3 { INFO@mark `N9 6 / 2 is not 3` }
unless 7 % 3 == 1 { INFO@mark `N10 7 % 3 is not 1` }
unless 4.even { INFO@mark `N11 4 is not even` }
unless 5.odd { INFO@mark `N12 5 is not odd` }
if 3.even { INFO@mark `NN1 3 is even` }
unless 2.max(5) == 5 { INFO@mark `N13 max failed` }
unless 42 == 4 * 10 + 2 { INFO@mark `N40 42 is not forty-two` }
unless 3 + 4 == 7 { INFO@mark `N41 3 + 4 is not seven` }
unless 7.succ == 8 { INFO@mark `N42 7.succ is not eight` }
unless 3 != 4 { INFO@mark `N141 3 != 4 is not read as not-equal` }
if 3 != 3 { INFO@mark `N142 3 != 3 is read as not-equal and holds` }

rounds := 0
3.times { rounds += 1 }
unless rounds == 3 { INFO@mark `NN2 times did not run three times` }
summed_rounds := 0
3.times (n) => { summed_rounds += n }
unless summed_rounds == 3 { INFO@mark `N30 times does not hand its round` }

unless Hexadecimal.radix == 16 { INFO@mark `N20 hexadecimal radix is not sixteen` }
unless 0x1F == 31 { INFO@mark `N43 0x1F is not thirty-one` }
unless 0b101 == 5 { INFO@mark `N44 0b101 is not five` }
if "4a".instance_of(Decimal.String) { INFO@mark `N45 4a is read as a decimal number` }
unless "4a".instance_of(Hexadecimal.String) { INFO@mark `N46 4a is not read as a hexadecimal number` }
unless 007 == 7 { INFO@mark `N136 007 is not seven` }
unless 00 == 0 { INFO@mark `N137 00 is not zero` }
unless 0x00ff == 0xff { INFO@mark `N138 0x00ff is not 0xff` }

// Signed numbers
unless (-2).negative { INFO@mark `N21 negation is not negative` }
unless (-5).negative { INFO@mark `N47 minus five is not negative` }
unless !(5 as Decimal.Signed).negative { INFO@mark `N116 five as an integer is negative` }
if 5.negative { INFO@mark `N88 five is negative` }
if 5.sign { INFO@mark `N32 a natural number has a sign` }
unless -2 + 5 == 3 { INFO@mark `N22 -2 + 5 is not 3` }
unless -2 * -2 == 4 { INFO@mark `N23 -2 * -2 is not 4` }
unless -2 < 1 { INFO@mark `N24 -2 < 1 is false` }
unless -5 + 5 == 0 { INFO@mark `N49 minus five and five do not make nothing` }
unless (-2 * 3).negative { INFO@mark `N50 minus two times three is not negative` }
unless -3 < -2 { INFO@mark `N51 minus three is not less than minus two` }
unless -3 < 2 { INFO@mark `N52 minus three is not less than two` }
if 2 < -3 { INFO@mark `N53 two is less than minus three` }
unless -3 - 5 == -8 { INFO@mark `N54 minus three less five is not minus eight` }
unless -3 + -2 == -5 { INFO@mark `N118 minus three and minus two is not minus five` }
if -3 + -2 < -5 { INFO@mark `N119 minus three and minus two is below minus five` }
unless -2 * -3 == 6 { INFO@mark `N121 minus two times minus three is not six` }
unless -2 * 3 == -6 { INFO@mark `N122 minus two times three is not minus six` }
unless -(-2) == 2 { INFO@mark `N123 minus minus two is not two` }
unless 3 + -5 == -2 { INFO@mark `N124 three and minus five is not minus two` }

// What two numbers have in common
unless 6.gcd(4) == 2 { INFO@mark `N55 the greatest common divisor of six and four is not two` }
unless 4.gcd(6) == 2 { INFO@mark `N56 asking the other way round answers otherwise` }
unless 5.gcd(3) == 1 { INFO@mark `N57 five and three share more than one` }
unless 2.lcm(3) == 6 { INFO@mark `N58 the least common multiple of two and three is not six` }
unless 2.coprime(3) { INFO@mark `N59 two and three are not coprime` }
if 2.coprime(4) { INFO@mark `N60 two and four are coprime` }
unless 2.divides(6) { INFO@mark `N61 two does not divide six` }
if 4.divides(6) { INFO@mark `N62 four divides six` }
unless 1.divides(5) { INFO@mark `N63 one does not divide five` }

unless 6.half == 3 { INFO@mark `N64 half of six is not three` }
unless 7.half == 3 { INFO@mark `N65 half of seven is not three` }
unless 0.half.is_zero { INFO@mark `N66 half of nothing is not nothing` }
unless 2.min(5) == 2 { INFO@mark `N67 the smaller of two and five is not two` }
unless 5.min(2) == 2 { INFO@mark `N68 asking the smaller the other way round answers otherwise` }
unless 3.squared == 9 { INFO@mark `N69 three by itself is not nine` }
unless 1.squared == 1 { INFO@mark `N70 one by itself is not one` }
unless 2.min(3) * 2 + 1 == 5 { INFO@mark `N125 the smaller of two and three, doubled and one, is not five` }

unless 2 ^ 3 == 8 { INFO@mark `N71 two raised to three is not eight` }
unless 5 ^ 1 == 5 { INFO@mark `N72 five raised to one is not five` }
unless 5 ^ 0 == 1 { INFO@mark `N73 five raised to nothing is not one` }
unless 2 ^ 3 ^ 2 == 512 { INFO@mark `N143 raising does not group to the right` }
unless 3! == 6 { INFO@mark `N74 three factorial is not six` }
unless 1! == 1 { INFO@mark `N75 one factorial is not one` }
unless 0! == 1 { INFO@mark `N76 nothing factorial is not one` }
unless 10.root(2) == 3 { INFO@mark `N144 the whole square root of ten is not three` }
unless √9 == 3 { INFO@mark `N145 the square root of nine is not three` }

// Digits in a base
unless 6.digits(10).count == 1 { INFO@mark `N77 six is spelled with other than one digit in ten` }
unless 6.digits(2).count == 3 { INFO@mark `N78 six is spelled with other than three digits in two` }
unless 1.digits(2).count == 1 { INFO@mark `N79 one is spelled with other than one digit in two` }
unless 6.digits(2) == [1, 1, 0] { INFO@mark `N146 six in two is not 1, 1, 0` }
unless [1, 2, 3] as 10 == 123 { INFO@mark `N84 one, two and three in ten do not spell a hundred and twenty-three` }
unless [1, 2, 3] as 2 == 11 { INFO@mark `N85 one, two and three in two do not spell eleven` }

unless [1, 2, 3].sum == 6 { INFO@mark `N80 one, two and three do not add to six` }
unless [1, 2, 3].product == 6 { INFO@mark `N81 one, two and three do not multiply to six` }
unless [5].sum == 5 { INFO@mark `N82 one thing does not add to itself` }
unless [5].product == 5 { INFO@mark `N83 one thing does not multiply to itself` }

unless 0b0110 ~&& 0b1010 == 0b0010 { INFO@mark `N147 bitwise and of 0110 and 1010 is not 0010` }
unless 0b0110 ~|| 0b1010 == 0b1110 { INFO@mark `N148 bitwise or of 0110 and 1010 is not 1110` }
unless 0b0110 ~x|| 0b1010 == 0b1100 { INFO@mark `N149 bitwise xor of 0110 and 1010 is not 1100` }

unless 5.instance_of(Number) { INFO@mark `N86 five is not a natural number` }
if 2.instance_of(Probability) { INFO@mark `N150 two is a probability` }

// A number stands for a bit
if 0 { INFO@mark `N92 zero is set` }
unless 1 { INFO@mark `N93 one is not set` }
unless 5 { INFO@mark `N94 five is not set` }
unless 1 && true { INFO@mark `N95 one and true is not true` }
if 0 && true { INFO@mark `N96 zero and true is true` }
unless 0 || true { INFO@mark `N97 zero or true is not true` }
if 0 || false { INFO@mark `N98 zero or false is true` }
unless 0 !&& true { INFO@mark `N99 zero nand true is not true` }
if 1 !&& true { INFO@mark `N100 one nand true is true` }
unless 0 !|| false { INFO@mark `N101 zero nor false is not true` }
if 1 !|| false { INFO@mark `N102 one nor false is true` }
unless 1 x|| false { INFO@mark `N103 one xor false is not true` }
if 1 x|| true { INFO@mark `N104 one xor true is true` }
unless 1 x!|| true { INFO@mark `N105 one xnor true is not true` }
if 1 x!|| false { INFO@mark `N106 one xnor false is true` }

if 0.nonzero { INFO@mark `N107 zero is other than zero` }
unless 3.nonzero { INFO@mark `N108 three is zero` }
unless 3.pred == 2 { INFO@mark `N109 what comes before three is not two` }
unless 3.pred.succ == 3 { INFO@mark `N110 stepping back and forward does not come back` }
unless 5.holds { INFO@mark `N111 five holds nothing` }

unless 100% == 1 { INFO@mark `N112 a hundred hundredths is not one` }
unless 200% == 2 { INFO@mark `N113 two hundred hundredths is not two` }

// Reals keep the digits after the point as written
unless 5.0.rational { INFO@mark `N114 a real is not rational` }
if 5.0.irrational { INFO@mark `N115 a real is irrational` }
unless 1.5.integer == 1 { INFO@mark `N126 1.5 does not start at one` }
unless 1.5.fraction == 5 { INFO@mark `N127 1.5 does not keep five after its point` }
unless 1.05.places == 2 { INFO@mark `N128 1.05 does not keep its leading zero` }
unless 1.5 == 1.5 { INFO@mark `N129 1.5 is not 1.5` }
if 1.5 == 1.50 { INFO@mark `N130 1.5 is written as 1.50` }
unless 1.5 * 4 == 6.0 { INFO@mark `N131 1.5 times four is not 6.0` }
unless 2.5 / 2 == 1.2 { INFO@mark `N132 2.5 halved is not 1.2 to one place` }

compounded := 1
compounded += 2
unless compounded == 3 { INFO@mark `N133 += does not add` }
compounded -= 1
unless compounded == 2 { INFO@mark `N134 -= does not subtract` }
compounded *= 3
unless compounded == 6 { INFO@mark `N135 *= does not multiply` }

// The number line a number is on
unless (3 -> +1){. squared > 10}.first == 4 { INFO@mark `NL1 the first square past ten is not four squared` }
unless (3 -> +1){. squared > 30}.first == 6 { INFO@mark `NL2 the first square past thirty is not six squared` }
unless (2 -> +1)[3] == 5 { INFO@mark `NL3 three along from two is not five` }
if 1.bounded { INFO@mark `NL4 a number is bounded` }
unless 1.unbounded { INFO@mark `NL5 a number is not unbounded` }
unless 4.entry == 4 { INFO@mark `NL6 a number is not entered at its own place` }
unless 0.entry.is_initial { INFO@mark `NL7 the line does not start at zero` }
if 3.entry.is_initial { INFO@mark `NL8 the line starts at three` }
if 3.entry.is_terminal { INFO@mark `NL9 the line ends` }
unless 3.entry.previous == 2 { INFO@mark `NL10 before three is not two` }
unless (5 -> +1)[..3].count == 3 { INFO@mark `NL11 three steps along the line are not three` }
unless (5 -> +1)[..3].last == 7 { INFO@mark `NL12 the third step from five is not seven` }
unless (5 -> +1).some(== 8) { INFO@mark `NL13 some did not reach eight` }

// Number literals keep their value (N1.4, N1.12, A5)
third := 1/3
unless third.integer == 0 { INFO@mark `FR1 1/3 does not start at zero` }
unless third.fraction[5] == 3 { INFO@mark `FR2 1/3 does not repeat its threes` }
unless third * 3 != 0 { INFO@mark `FR3 1/3 is integer zero` }
unless 50% == 1/2 { INFO@mark `FR4 50% is not a half` }
unless 7 % 3 == 1 { INFO@mark `FR5 % before a number is no longer modulo` }
unless 10₂ == 2 { INFO@mark `SS1 a subscript is not the base the digits are read in` }
unless 2³ == 8 { INFO@mark `SS2 a superscript on a number is not its power` }
unless Binary³².admits(Binary(integer: [1] * 32)) { INFO@mark `SS3 a superscript on a base type is not its length` }
if Binary³².admits(Binary(integer: [1] * 8)) { INFO@mark `SS4 a base type with a length admits another length` }
