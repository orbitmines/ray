// Intel 64 and IA-32 Architectures Software Developer's Manual, Volume 2 (https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html): integer arithmetic on registers, as gcc -O2 emits it
X86 := class: Language {
  static extensions := ".bin"
  // (true when the instructions are XED's (`X86.xed.ray`): text is assembled into its forms)
  static xed := false

  static Registers := ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]
  static Halves := ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"]
  static Words := ["ax", "cx", "dx", "bx", "sp", "bp", "si", "di", "r8w", "r9w", "r10w", "r11w", "r12w", "r13w", "r14w", "r15w"]
  static named (number, width) => (width == 64) ? X86.Registers[number] : ((width == 16) ? X86.Words[number] : ((width == 8) ? X86.Bytes[number] : X86.Halves[number]))

  // REX: 0100, then W (64-bit operands) and the fourth bit of ModRM.reg (R), SIB.index (X), ModRM.rm or SIB.base (B); each byte's bits are read least significant first, the order x86 stores its integers in (Vol. 2, 2.2.1)
  static Rex := class (b: <-Binary₁, x: <-Binary₁, r: <-Binary₁, w: <-Binary₁, <-Binary₄{== 4})
  static base_extension (rex) => rex.empty ? 0 : (rex.first.b * 8)
  static index_extension (rex) => rex.empty ? 0 : (rex.first.x * 8)
  static reg_extension (rex) => rex.empty ? 0 : (rex.first.r * 8)
  static wide (rex) => (rex.empty || (rex.first.w == 0)) ? 32 : 64
  // (the width of an operation: 64 with REX.W, else 16 after 66, else 32 (Vol. 1, 3.6.1))
  static size (prefixes, rex) => (X86.wide(rex) == 64) ? 64 : ((X86.counted(prefixes, 102) > 0) ? 16 : 32)

  // ModRM: rm, reg, mod. With mod 3, rm is a register; else memory: a SIB byte (base, index, scale) when rm is 4, a displacement of 8 bits when mod is 1, of 32 when mod is 2 or the SIB names no base (Vol. 2, 2.1.5)
  static Operand := class (
    rm: <-Binary₃, reg: <-Binary₃, mod: <-Binary₂,
    (sib_base: <-Binary₃, sib_index: <-Binary₃, scale: <-Binary₂) if (mod != 3) && (rm == 4),
    (small: <-Binary₈) if mod == 1,
    (large: <-Binary₃₂) if (mod == 2) || (((mod == 0) && (rm == 4)) && (sib_base == 5))
  ) {
    rm_register (rex) => rm + X86.base_extension(rex)
    reg_register (rex) => reg + X86.reg_extension(rex)
    base_register (rex) =>
      (return (rm + X86.base_extension(rex))) if rm != 4
      ((mod == 0) && (sib_base == 5)) ? None : (sib_base + X86.base_extension(rex))
    index_register (rex) => ((rm == 4) && ((sib_index + X86.index_extension(rex)) != 4)) ? (sib_index + X86.index_extension(rex)) : None
    scaled => (rm == 4) ? ([1, 2, 4, 8][scale]) : 1
    displacement => (small !== None) ? X86.signed(small, 8) : ((large !== None) ? X86.signed(large, 32) : None)
    // (memory, written the way objdump writes it: `[rdi+rsi*2-0x3]`)
    memory (rex) =>
      shown := ""
      (shown = X86.Registers[base_register(rex)]) if base_register(rex) !== None
      (shown = (shown + ((shown == "") ? "" : "+")) + ((X86.Registers[index_register(rex)] + "*") + scaled)) if index_register(rex) !== None
      (shown = shown + X86.offset(displacement)) if displacement !== None
      ("[" + shown) + "]"
  }
  static signed (value, width) => (width == 8) ? ((value >= 128) ? ((value - 256) as Integer) : value) : ((value >= 2147483648) ? ((value - 4294967296) as Integer) : value)
  static power (exponent) =>
    made := 1
    left := exponent
    while left > 0 {
      made = made * 2
      left = left - 1
    }
    made
  static offset (value) => (value < 0) ? ("-0x" + (0 - value).hexadecimal) : ("+0x" + value.hexadecimal)
  // (an immediate, written the way objdump writes it: the bits of the operation's width, `0xfffffff7`)
  static immediate (value, width) => "0x" + ((value < 0) ? ((width == 64) ? ("ffffffff" + ((4294967296 + value).hexadecimal)) : (4294967296 + value).hexadecimal) : value.hexadecimal)

  // What each instruction is: its encoding (the header), its text, and what it does to the registers (`lifted`)
  static Ret := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 195}) {
    assembly => "ret"
    assembly_after (end) => assembly
    lifted (registers) => registers
    statements (end, width) => [("return " + X86.held(X86.fresh(), 0, width))]
  }
  static Imul := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 15}, <-Byte{== 175}, operand: X86.Operand{.mod == 3}) {
    assembly => ((("imul " + X86.named(operand.reg_register(rex), X86.wide(rex))) + ",") + X86.named(operand.rm_register(rex), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.reg_register(rex), X86.wide(rex), X86.held(registers, operand.reg_register(rex), X86.wide(rex)), "*", X86.held(registers, operand.rm_register(rex), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.reg_register(rex), X86.wide(rex)))
  }
  static ImulImmediate := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 107}, operand: X86.Operand{.mod == 3}, immediate: <-Binary₈) {
    assembly => ((((("imul " + X86.named(operand.reg_register(rex), X86.wide(rex))) + ",") + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.reg_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "*", X86.constant(X86.signed(immediate, 8), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.reg_register(rex), X86.wide(rex)))
  }
  static Lea := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 141}, operand: X86.Operand{.mod != 3}) {
    assembly => (("lea " + X86.named(operand.reg_register(rex), X86.wide(rex))) + ",") + operand.memory(rex)
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, operand.reg_register(rex), X86.Value(X86.addressed(registers, operand, rex), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), None)
  }
  static Add := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 1}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("add", operand.rm_register(rex), operand.reg_register(rex), rex)
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "+", X86.held(registers, operand.reg_register(rex), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  static Sub := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 41}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("sub", operand.rm_register(rex), operand.reg_register(rex), rex)
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "-", X86.held(registers, operand.reg_register(rex), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), [X86.held(X86.fresh(), operand.rm_register(rex), X86.wide(rex)), X86.held(X86.fresh(), operand.reg_register(rex), X86.wide(rex))])
  }
  static Mov := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 137}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("mov", operand.rm_register(rex), operand.reg_register(rex), rex)
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, operand.rm_register(rex), X86.Value(X86.held(registers, operand.reg_register(rex), X86.wide(rex)), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), None)
  }
  // (xor of a register with itself, how gcc writes 0; any other xor is not arithmetic)
  static Xor := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 49}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("xor", operand.rm_register(rex), operand.reg_register(rex), rex)
    assembly_after (end) => assembly
    lifted (registers) => (operand.rm_register(rex) == operand.reg_register(rex)) ? X86.placed(registers, operand.rm_register(rex), X86.Value(X86.constant(0, X86.wide(rex)), X86.wide(rex))) : None
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  static Neg := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 247}, operand: X86.Operand{(.mod == 3) && (.reg == 3)}) {
    assembly => "neg " + X86.named(operand.rm_register(rex), X86.wide(rex))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.constant(0, X86.wide(rex)), "-", X86.held(registers, operand.rm_register(rex), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  // (not x is -x - 1)
  static Not := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 247}, operand: X86.Operand{(.mod == 3) && (.reg == 2)}) {
    assembly => "not " + X86.named(operand.rm_register(rex), X86.wide(rex))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.constant(((0 - 1) as Integer), X86.wide(rex)), "-", X86.held(registers, operand.rm_register(rex), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), None)
  }
  // (shl x, k is x times 2^k)
  static Shl := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 193}, operand: X86.Operand{(.mod == 3) && (.reg == 4)}, immediate: <-Binary₈) {
    assembly => ((("shl " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(immediate, 8))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "*", X86.constant(X86.power(immediate), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  static AddSmall := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 131}, operand: X86.Operand{(.mod == 3) && (.reg == 0)}, immediate: <-Binary₈) {
    assembly => ((("add " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "+", X86.constant(X86.signed(immediate, 8), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  static SubSmall := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 131}, operand: X86.Operand{(.mod == 3) && (.reg == 5)}, immediate: <-Binary₈) {
    assembly => ((("sub " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "-", X86.constant(X86.signed(immediate, 8), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), [X86.held(X86.fresh(), operand.rm_register(rex), X86.wide(rex)), X86.constant(X86.signed(immediate, 8), X86.wide(rex))])
  }
  static AddAccumulator := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 5}, immediate: <-Binary₃₂) {
    assembly => ((("add " + X86.named(0, X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 32), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.applied(registers, 0, X86.wide(rex), X86.held(registers, 0, X86.wide(rex)), "+", X86.constant(X86.signed(immediate, 32), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), 0, X86.wide(rex)))
  }
  // (a register's number in the opcode's low three bits)
  static MovImmediate := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (register: <-Binary₃, <-Binary₅{== 23}, immediate: <-Binary₃₂{X86.wide(rex) == 32}) {
    assembly => ((("mov " + X86.named(register + X86.base_extension(rex), 32)) + ",") + X86.immediate(immediate, 32))
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, register + X86.base_extension(rex), X86.Value(X86.constant(X86.signed(immediate, 32), 32), 32))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), None)
  }
  static MovSigned := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 199}, operand: X86.Operand{(.mod == 3) && (.reg == 0)}, immediate: <-Binary₃₂) {
    assembly => ((("mov " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 32), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, operand.rm_register(rex), X86.Value(X86.constant(X86.signed(immediate, 32), X86.wide(rex)), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), None)
  }
  // Control: compare and test (they set the flags a condition reads), and, shift right, move if, jump if, jump; and the nops gcc
  // pads a loop's head with: 66 (an operand of 16 bits; again, `data16`) and 2e (`cs`) before them (Vol. 2, 2.1.1, 3.1, 4.3)
  static Prefix := class (value: <-Byte{(. == 102) || (. == 46)})
  static Conditions := ["o", "no", "b", "ae", "e", "ne", "be", "a", "s", "ns", "p", "np", "l", "ge", "le", "g"]
  static Bytes := ["al", "cl", "dl", "bl", "spl", "bpl", "sil", "dil", "r8b", "r9b", "r10b", "r11b", "r12b", "r13b", "r14b", "r15b"]
  static counted (prefixes, byte) =>
    found := 0
    at := prefixes.head
    while at {
      (found = found + 1) if at.value.value == byte
      at = at.next
    }
    found
  static sixteens (prefixes) => X86.counted(prefixes, 102)
  static segment (prefixes) => X86.counted(prefixes, 46) > 0
  static Cmp := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 57}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("cmp", operand.rm_register(rex), operand.reg_register(rex), rex)
    assembly_after (end) => assembly
    statements (end, width) => X86.flag_lines([X86.held(X86.fresh(), operand.rm_register(rex), X86.wide(rex)), X86.held(X86.fresh(), operand.reg_register(rex), X86.wide(rex))])
  }
  static CmpSmall := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 131}, operand: X86.Operand{(.mod == 3) && (.reg == 7)}, immediate: <-Binary₈) {
    assembly => ((("cmp " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    assembly_after (end) => assembly
    statements (end, width) => X86.flag_lines([X86.held(X86.fresh(), operand.rm_register(rex), X86.wide(rex)), X86.constant(X86.signed(immediate, 8), X86.wide(rex))])
  }
  static AndSmall := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 131}, operand: X86.Operand{(.mod == 3) && (.reg == 4)}, immediate: <-Binary₈) {
    assembly => ((("and " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, operand.rm_register(rex), X86.Value(X86.anded_text(X86.held(registers, operand.rm_register(rex), X86.wide(rex)), X86.constant(X86.signed(immediate, 8), X86.wide(rex))), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  static Shr := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 193}, operand: X86.Operand{(.mod == 3) && (.reg == 5)}, immediate: <-Binary₈) {
    assembly => ((("shr " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(immediate, 8))
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, operand.rm_register(rex), X86.Value(X86.shifted_text(X86.held(registers, operand.rm_register(rex), X86.wide(rex)), X86.wide(rex), X86.power(immediate)), X86.wide(rex)))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), X86.result_flags(lifted(X86.fresh()), operand.rm_register(rex), X86.wide(rex)))
  }
  static Test := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 133}, operand: X86.Operand{.mod == 3}) {
    assembly => ((("test " + X86.named(operand.rm_register(rex), X86.size(prefixes, rex))) + ",") + X86.named(operand.reg_register(rex), X86.size(prefixes, rex)))
    assembly_after (end) => assembly
    statements (end, width) => X86.flag_lines([X86.tested(X86.held(X86.fresh(), operand.rm_register(rex), X86.size(prefixes, rex)), X86.held(X86.fresh(), operand.reg_register(rex), X86.size(prefixes, rex)), operand.rm_register(rex) == operand.reg_register(rex)), "0"])
  }
  static TestByte := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 246}, operand: X86.Operand{(.mod == 3) && (.reg == 0)}, immediate: <-Binary₈) {
    assembly => ((("test " + X86.Bytes[operand.rm_register(rex)]) + ",") + X86.immediate(immediate, 8))
    assembly_after (end) => assembly
    statements (end, width) => X86.flag_lines([((("(r" + operand.rm_register(rex)) + ").anded(") + immediate) + ")", "0"])
  }
  static MoveIf := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 15}, code: <-Binary₄, <-Binary₄{== 4}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("cmov" + X86.Conditions[code], operand.reg_register(rex), operand.rm_register(rex), rex)
    assembly_after (end) => assembly
    statements (end, width) => [((((((("r" + operand.reg_register(rex)) + " = ") + X86.condition(code)) + " ? ") + X86.stored(X86.held(X86.fresh(), operand.rm_register(rex), X86.wide(rex)), X86.wide(rex))) + " : ") + X86.stored(X86.held(X86.fresh(), operand.reg_register(rex), X86.wide(rex)), X86.wide(rex)))]
  }
  // (a jump's target: where the next instruction begins, and the signed offset from there)
  static JumpIf := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (code: <-Binary₄, <-Binary₄{== 7}, offset: <-Byte) {
    assembly_after (end) => (("j" + X86.Conditions[code]) + " ") + (end + X86.signed(offset, 8)).hexadecimal
    statements (end, width) => [((("(goto at_" + (end + X86.signed(offset, 8)).hexadecimal) + ") if ") + X86.condition(code))]
  }
  static Jump := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 235}, offset: <-Byte) {
    assembly_after (end) => "jmp " + (end + X86.signed(offset, 8)).hexadecimal
    statements (end, width) => ["goto at_" + (end + X86.signed(offset, 8)).hexadecimal]
  }
  static MoveSigned := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 99}, operand: X86.Operand) {
    assembly => (("movsxd " + X86.named(operand.reg_register(rex), 64)) + ",") + X86.place(operand, rex, 32)
    assembly_after (end) => assembly
    lifted (registers) => X86.placed(registers, operand.reg_register(rex), X86.Value(((operand.mod == 3) ? X86.held(registers, operand.rm_register(rex), 32) : X86.load_text(operand, rex, 32, true)), 64))
    statements (end, width) => X86.assignments(lifted(X86.fresh()), None)
  }
  static JumpIfNear := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 15}, code: <-Binary₄, <-Binary₄{== 8}, offset: <-Binary₃₂) {
    assembly_after (end) => (("j" + X86.Conditions[code]) + " ") + (end + X86.signed(offset, 32)).hexadecimal
    statements (end, width) => [((("(goto at_" + (end + X86.signed(offset, 32)).hexadecimal) + ") if ") + X86.condition(code))]
  }
  static JumpNear := class<prefixes: X86.Prefix[], rex: X86.Rex[]> (<-Byte{== 233}, offset: <-Binary₃₂) {
    assembly_after (end) => "jmp " + (end + X86.signed(offset, 32)).hexadecimal
    statements (end, width) => ["goto at_" + (end + X86.signed(offset, 32)).hexadecimal]
  }
  // Memory: what a load reads and a store writes, at the width of its operation, `QWORD PTR [rdi+rax*8]`; a byte register
  // without REX is one of the old eight, `ah` for 4 to `bh` for 7 (Vol. 2, 3.1.1.3, 2.1.5)
  static Sizes := ["BYTE", "WORD", "DWORD", "QWORD"]
