Encoding := class {
  Digest := class: Language {
    read (encoded) => ERROR `a digest is written and never read back`
    write (value) => Hash(value, algorithm: this)
  }
  Packing := class: Language {
    read (encoded) => encoded.value
    write (value) => Packed(value, algorithm: this)
  }

  Packed := class = value: *, algorithm: Packing {
    as (target) => algorithm.read(this)
  }

  Hash := class = value: *, algorithm: Digest {
    chainable == (other: Hash) => algorithm == other.algorithm && value == other.value
  }

  Encrypted<T> := class = value: T, key: Key? {
    opened (holder) => key && holder?.key == key ? value : Quest(name: "find the key", goal: this)
  }

  static common (a: Byte[], b: Byte[]) => a.empty || b.empty || a.first != b.first ? 0 : 1 + common(a.rest, b.rest)
  static runs (source: Byte[], target: Byte[]) => target.empty ? [] : (0..<source.count).map(at => (from: at, count: common(source[at..], target))).max_by(.count) -- (best =>
    best && best.count >= 4 ? [(from: best.from, count: best.count)], runs(source, target[best.count..]) : runs(source, target[1..]) -- (rest =>
      rest.first?.bytes ? [(bytes: (target[..0], rest.first.bytes).flatten)], rest.rest : [(bytes: target[..0])], rest))
}
