// A program is what it is written as, and what holds a program holds programs all the way down.

mark ^keyword := external global

taken := Program(code: {
  1
  2
  3
})
unless taken { INFO@mark `PG1 a block handed to a rule is not read as a program` }
unless taken.written { INFO@mark `PG3 a program is not written as anything` }
unless taken.written.count == 3 { INFO@mark `PG8 a program of three statements does not count three` }
unless taken.written.count == 3 { INFO@mark `PG9 a program of three is not written as three` }
unless taken.written.first.written { INFO@mark `PG5 a statement is not a program in turn` }
unless taken.written.first.written.count == 1 { INFO@mark `PG10 a statement is written as other than one thing` }
unless Program(code: { 5 }).written.count == 1 { INFO@mark `PG11 a program of one statement counts other than one` }
unless taken.O { INFO@mark `PG12 a program does not say which rules it is read with` }

// A statement read back as what it is written as
jumping := Program(code: {
  goto past if 5
  5
 past\
  6
})
always := Program(code: {
  goto away
 away\
})
looping := Program(code: {
 again\
  goto again
})
landed := jumping.written[2]
unless jumping.written.first.is_jump { INFO@mark `PG16 a goto is not read as a jump` }
if jumping.written.last.is_jump { INFO@mark `PG17 a value is read as a jump` }
if taken.written.first.is_jump { INFO@mark `PG18 a name is read as a jump` }
unless landed.is_label { INFO@mark `PG19 a label is not read as one` }
if jumping.written.first.is_label { INFO@mark `PG20 a jump is read as a label` }
unless jumping.written.first.is_conditional { INFO@mark `PG21 a jump with a condition is not conditional` }
unless jumping.target_of(jumping.written.first) == landed { INFO@mark `PG22 a jump does not land on its label` }
if always.written.first.is_conditional { INFO@mark `PG23 a jump without a condition is conditional` }
if jumping.target_of(always.written.first) { INFO@mark `PG24 a jump lands on a label it does not name` }
if jumping.jumps_backward { INFO@mark `PG30 a jump forward is read as a jump back` }
unless looping.jumps_backward { INFO@mark `PG31 a jump back to a label above is not read as one` }
unless jumping is Terminating { INFO@mark `PG32 a program that only jumps forward does not terminate` }
if looping is Terminating { INFO@mark `PG33 a program that jumps back terminates` }
unless Program(code: { x := 1 }).declares("x") { INFO@mark `PG34 a program declaring x does not say so` }

// A goto into another branch is a call at that place (P2.10)
branched := Program(code: {
  goto there
  5
  if true {
   there\
    6
  }
})
unless branched.crosses(branched.written.first) { INFO@mark `XB1 a goto into another branch is not read as crossing` }
if jumping.crosses(jumping.written.first) { INFO@mark `XB2 a goto within its own branch is read as crossing` }
unless branched.flow.first.falls_through { INFO@mark `XB3 a goto into another branch does not come back like a call` }
unless branched.called_at(branched.written.first) == 6 { INFO@mark `XB4 a goto into another branch does not run at that place` }

// As what it does: a jump is an edge to where it lands
unless jumping.flow.first.jumps_to == landed { INFO@mark `PG25 a jump's edge does not reach its label` }
unless jumping.flow.first.falls_through { INFO@mark `PG27 a conditional jump does not go on below it` }
unless jumping.flow[1].falls_through { INFO@mark `PG28 a value does not go on below it` }
if always.flow.first.falls_through { INFO@mark `PG29 a jump without a condition goes on below it` }

// Operator sections are values (A1, A2)
unless [1, 2].map(+1) == [2, 3] { INFO@mark `OP1 +1 is not a function adding one` }
unless [1, 2].map(*10) == [10, 20] { INFO@mark `OP2 *10 is not a function multiplying by ten` }
unless [true, false].map(!) == [false, true] { INFO@mark `OP3 ! alone is not the negation` }
unless [1, 2, 3].reduce((*)) == 6 { INFO@mark `OP4 (*) is not multiplication as a value` }
unless [1, 5, 20]{< 10}.count == 2 { INFO@mark `OP5 a section in a narrowing is not applied to each` }

// `if x { case => value … } else { … }`: `==` unless an operator is written, `is` for a type (P2.11)
described (x) => if x {
  is Number => "number"
  "A" => "letter"
} else {
  "other"
}
unless described(5) == "number" { INFO@mark `MA1 an is case does not match an instance of its type` }
unless described("A") == "letter" { INFO@mark `MA2 a case with no operator is not asked with ==` }
unless described(true) == "other" { INFO@mark `MA3 the else case does not take what nothing else does` }
graded (x) => if x {
  < 10 => "low"
} else {
  "high"
}
unless graded(3) == "low" { INFO@mark `MA4 a case with an operator is not asked with it` }
first_case (x) => if x {
  1 => "one"
  is Number => "number"
} else {
  "other"
}
unless first_case(1) == "one" { INFO@mark `IC1 a later case answers before an earlier one that holds` }
unless first_case(2) == "number" { INFO@mark `IC2 a case that does not hold answers` }
unless (if 3 { != 0 => "nonzero" } else { "zero" }) == "nonzero" { INFO@mark `IC3 if with cases is not a value where it is written` }
if (if 0 { "taken" }) { INFO@mark `IC4 an if whose block holds no cases is read as cases` }

// `.( … )` reads among the members of what is before it (A8)
Grouped := class {
  first => 1
  second => 2
}
unless Grouped.(first + second) == 3 { INFO@mark `GP1 .( ) does not read the members of what is before it` }

// Labels in a class body are entries (L§4.2)
Entered := class {
  steps := 0
 later\
  steps = 7
}
unless Entered~later().steps == 7 { INFO@mark `EP1 ~label does not enter the class at that label` }
unless Entered~default == Entered { INFO@mark `EP2 ~default is not the class itself` }

// A class body runs like any function: labels are never skipped; a Component's labels are entered, not executed (F-D13, L§4.2.1)
unless Entered().steps == 7 { INFO@mark `CMP1 a label in a class body stops its construction` }
Panel := class: Component {
  shown := 0
 opened\
  shown = 1
 closed\
  shown = 2
}
unless Panel().shown == 0 { INFO@mark `CMP2 constructing a component runs past its first label` }
unless Panel~opened().shown == 1 { INFO@mark `CMP3 entering a component at a label runs past the next label` }
unless Panel~closed().shown == 2 { INFO@mark `CMP4 entering a component at its last label does not run what follows it` }

// `recur` re-enters the method; `break` and `continue` in a loop (P2.4, P2.1)
countdown (n) => (
  return n if n == 0
  recur(n - 1)
)
unless countdown(5) == 0 { INFO@mark `RC1 recur(args) does not re-enter the method` }
stopped := 0
while true {
  stopped = stopped + 1
  break if stopped == 3
}
unless stopped == 3 { INFO@mark `RC2 break does not leave the loop` }
skipped := 0
counted := 0
while counted < 5 {
  counted = counted + 1
  continue if counted == 2
  skipped = skipped + 1
}
unless skipped == 4 { INFO@mark `RC3 continue does not go on with the next round` }

// `?` is unknown; `?=` sets only what has no value (T1.6)
unknown := ?
unless unknown#.count != 1 { INFO@mark `QM1 ? is one value` }
given := None
given ?= 4
given ?= 5
unless given == 4 { INFO@mark `QM2 ?= does not set only what has no value` }

// `is`, quantifiers and membership (A5, R1.1)
unless ("A", "A", "A") is "A"[] { INFO@mark `IS1 is does not ask instance_of` }
unless forall x is [2, 4]: x % 2 == 0 { INFO@mark `IS2 forall does not hold of every element` }
unless exists x is [1, 4]: x == 4 { INFO@mark `IS3 exists does not find the element` }
unless 3 is [1, 2, 3]# { INFO@mark `IS4 is does not find a member` }
if 5 is [1, 2, 3]# { INFO@mark `IS5 is finds what is not there` }
unless 2 is [1, 2]# { INFO@mark `IS6 is does not find a member` }

// `dynamically x` reads x again each time (P5.1)
moving := 1
followed := dynamically moving + 1
moving = 5
unless followed == 6 { INFO@mark `DY2 dynamically does not read again what it depends on` }

// `print(x)` answers x (Almanac §0.3)
unless print(3) == 3 { INFO@mark `PT1 print does not answer what it printed` }

// A project and a language it bundles may depend on each other; each is loaded once
ui_project := Project.known(Language.ray.bundled("ui")).load
unless ui_project.loaded && !ui_project.loading { INFO@mark `PJ1 a project bundling a language that depends back on it does not finish loading` }
unless Language.project("web").loaded { INFO@mark `PJ2 a language in a mutual dependency is not loaded` }
unless Language.project("web").installed.some(=== ui_project) { INFO@mark `PJ3 a mutual dependency loads a second copy of the project it comes back to` }

// A variable's slice is the part of its program it was written from (P1.14); effects are inferred (P1.24)
sliced := Program(code: {
  a := 1
  b := 2
  c := a + 1
})
unless sliced.slice("c").count == 2 { INFO@mark `FWP1 a variable's slice is not what it was written from` }
if sliced.slice("c").some(.code ~= ⊢"b") { INFO@mark `FWP2 a slice holds what the variable does not depend on` }
unless Program(code: { 1 + 1 }).effects.empty { INFO@mark `FWP3 a program with no effects is said to have some` }

// A language is recognised by the readings that accept the text (L§9.1.2)
unless Language.detected("x := 1").contains(Language.ray) { INFO@mark `FWP4 Ray text is not recognised as Ray` }
