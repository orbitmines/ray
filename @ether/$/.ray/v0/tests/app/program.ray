// A program is what it is written as, and what holds a program holds programs all the way down.

mark ^keyword := external global

taken := Program(code: {
  1
  2
  3
})
unless taken { INFO@mark `PG1 a block handed to a rule is not read as a program` }
unless taken.written { INFO@mark `PG3 a program is not written as anything` }
unless taken.written.count == 3 { INFO@mark `PG8 a program of three statements does not count three` }
unless taken.expand.count == 3 { INFO@mark `PG9 a program of three does not expand to three` }
unless taken.written.first.written { INFO@mark `PG5 a statement is not a program in turn` }
unless taken.written.first.written.count == 1 { INFO@mark `PG10 a statement is written as other than one thing` }
unless Program(code: { 5 }).written.count == 1 { INFO@mark `PG11 a program of one statement counts other than one` }
unless taken.O { INFO@mark `PG12 a program does not say which rules it is read with` }

// A statement read back as what it is written as
jumping := Program(code: {
  goto past if 5
  5
 past\
  6
})
always := Program(code: {
  goto away
 away\
})
looping := Program(code: {
 again\
  goto again
})
landed := jumping.written[2]
unless jumping.written.first.is_jump { INFO@mark `PG16 a goto is not read as a jump` }
if jumping.written.last.is_jump { INFO@mark `PG17 a value is read as a jump` }
if taken.written.first.is_jump { INFO@mark `PG18 a name is read as a jump` }
unless landed.is_label { INFO@mark `PG19 a label is not read as one` }
if jumping.written.first.is_label { INFO@mark `PG20 a jump is read as a label` }
unless jumping.written.first.is_conditional { INFO@mark `PG21 a jump with a condition is not conditional` }
unless jumping.target_of(jumping.written.first) == landed { INFO@mark `PG22 a jump does not land on its label` }
if always.written.first.is_conditional { INFO@mark `PG23 a jump without a condition is conditional` }
if jumping.target_of(always.written.first) { INFO@mark `PG24 a jump lands on a label it does not name` }
if jumping.jumps_backward { INFO@mark `PG30 a jump forward is read as a jump back` }
unless looping.jumps_backward { INFO@mark `PG31 a jump back to a label above is not read as one` }
unless jumping.instance_of(Terminating) { INFO@mark `PG32 a program that only jumps forward does not terminate` }
if looping.instance_of(Terminating) { INFO@mark `PG33 a program that jumps back terminates` }
unless Program(code: { x := 1 }).declares("x") { INFO@mark `PG34 a program declaring x does not say so` }

// As what it does: a jump is an edge to where it lands
unless jumping.flow.first.jumps_to == landed { INFO@mark `PG25 a jump's edge does not reach its label` }
unless jumping.flow.first.falls_through { INFO@mark `PG27 a conditional jump does not go on below it` }
unless jumping.flow[1].falls_through { INFO@mark `PG28 a value does not go on below it` }
if always.flow.first.falls_through { INFO@mark `PG29 a jump without a condition goes on below it` }
