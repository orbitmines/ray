@ether/ui
@ether/geometry
@zlib
@crc32

// Portable Network Graphics (PNG) Specification, Third Edition (https://www.w3.org/TR/png-3/)
PNG := class: Language (
  // PNG signature (5.2)
  137, 80, 78, 71, 13, 10, 26, 10,
  header: Chunk{type == "IHDR"},
  chunks: Chunk{type != "IEND"}[],
  Chunk{type == "IEND"} = Chunk(type: "IEND", data: [])
) {
  static extensions := ".png"
  static of := Language.Image

  // Chunk layout (5.3), its CRC over the type and data (5.5)
  static Chunk := class (size: Binary₃₂ = data.count, type: Char₄, data: Byte[]{.length == size}, crc: Binary₃₂ = [type.bytes, data].flatten as CRC32 as Binary₃₂) {
    dynamically assert .crc == [.type.bytes, .data].flatten as CRC32 as Binary₃₂
  }

  // IHDR (11.2.1)
  static Header := class (width: Binary₃₂, height: Binary₃₂, depth: Byte, color: Byte, compression: Byte{. == 0}, filter: Byte{. == 0}, interlace: Byte{. <= 1}) {
    scaled (samples: Number[]) => samples.map(. * 255 / (2 ^ this.depth - 1))
  }
  // Colour types and their samples (6.1)
  static Greyscale := PNG.Header{.color == 0} { colored (samples: Number[], png: PNG) => scaled(samples) -- Geometry.Color(.0, .0, .0) }
  static Truecolour := PNG.Header{.color == 2} { colored (samples: Number[], png: PNG) => scaled(samples) -- Geometry.Color(.0, .1, .2) }
  static Indexed := PNG.Header{.color == 3} { colored (samples: Number[], png: PNG) => png.palette[samples.0] ~~ .alpha = (png.transparency[samples.0] ?? 255) / 255 }
  static GreyscaleAlpha := PNG.Header{.color == 4} { colored (samples: Number[], png: PNG) => scaled(samples) -- Geometry.Color(.0, .0, .0, .1 / 255) }
  static TruecolourAlpha := PNG.Header{.color == 6} { colored (samples: Number[], png: PNG) => scaled(samples) -- Geometry.Color(.0, .1, .2, .3 / 255) }

  // Filter types (9.2): the filter byte before each scanline, and what each predicts a byte from: the one to its left, above, and above-left
  static Scanline := class (filter: Byte, bytes: Byte[]) {
    predicted (left: Byte, up: Byte, corner: Byte) => 0
    // Filter types 1–4 predict from the left, above, their average, and Paeth (9.2, 9.4)
    assert ([2, 10] as PNG.Scanline).predicted(3, 7, 5) == 7 && ([4, 10] as PNG.Scanline).predicted(3, 7, 5) == 5 && ([0, 10] as PNG.Scanline).predicted(3, 7, 5) == 0  // PNG5 a filter type does not predict as 9.2 and 9.4 say
  }
  static Sub := PNG.Scanline{.filter == 1} { predicted (left: Byte, up: Byte, corner: Byte) => left }
  static Up := PNG.Scanline{.filter == 2} { predicted (left: Byte, up: Byte, corner: Byte) => up }
  static Average := PNG.Scanline{.filter == 3} { predicted (left: Byte, up: Byte, corner: Byte) => (left + up) / 2 -- .floor }
  // The Paeth predictor (9.4)
  static Paeth := PNG.Scanline{.filter == 4} { predicted (left: Byte, up: Byte, corner: Byte) => (left + up - corner) -- (estimate => [left, up, corner].min_by(guess => (estimate - guess) max (guess - estimate))#.first) }

  // Adam7 interlacing: each pass's first column and row and its steps (8.2)
  static Adam7 = [(0, 0, 8, 8), (4, 0, 8, 8), (0, 4, 4, 8), (2, 0, 4, 4), (0, 2, 2, 4), (1, 0, 2, 2), (0, 1, 1, 2)]

  ihdr => .header.data as PNG.Header
  channels => [1, 0, 3, 1, 2, 0, 4][.ihdr.color]
  stride => (.ihdr.depth * .channels + 7) / 8 -- .floor
  // PLTE (11.2.3), tRNS (11.3.1.1)
  palette => .chunks{.type == "PLTE"}.first.data.chunk(3).map(Geometry.Color(.0, .1, .2)) ?? []
  transparency => .chunks{.type == "tRNS"}.first.data ?? []
  // IDAT (11.2.4): one zlib stream over all of them
  inflated => Zlib.read(this.chunks{.type == "IDAT"}.data.flatten)
  passes => (.ihdr.interlace == 0 ? [(0, 0, 1, 1)] : PNG.Adam7).map((x, y, dx, dy) => (x: x, y: y, dx: dx, dy: dy,
    width: ((this.ihdr.width - x + dx - 1) / dx).floor max 0, height: ((this.ihdr.height - y + dy - 1) / dy).floor max 0))
  span (width: Number) => (width * .ihdr.depth * .channels + 7) / 8 -- .floor
  sizes => .passes.map(.width > 0 && .height > 0 ? .height * (this.span(.width) + 1) : 0)
  unfiltered (line: Scanline, above: Byte[]) => line.bytes.enumerate.reduce(acc = [] => [acc, (.value + line.predicted(
    .index >= this.stride ? acc[.index - this.stride] : 0, above[.index] ?? 0, .index >= this.stride ? above[.index - this.stride] ?? 0 : 0)) % 256].flatten)
  rows (bytes: Byte[], width: Number) => bytes.chunk(this.span(width) + 1).map(. as PNG.Scanline).reduce(acc = [] => [acc, [this.unfiltered(., acc.last ?? [])]].flatten(1))
  pixels (row: Byte[], width: Number) => (row as Binary{.length == .ihdr.depth}[])[..<width * .channels].chunk(this.channels).map(this.ihdr.colored(., this))
  placed => .passes.enumerate.map(pass => this.inflated[this.sizes[..<pass.index].sum ..< this.sizes[..pass.index].sum] -- (bytes => pass.value -- (at =>
    this.rows(bytes, at.width).enumerate.map(row => this.pixels(row.value, at.width).enumerate.map((x: at.x + .index * at.dx, y: at.y + row.index * at.dy, color: .value)))))).flatten
  raster => .placed -- (all => (0..<ihdr.height).map(y => all{.y == y}.sort_by(.x).color)) as Geometry.Raster

  // Writing: 8-bit truecolour with alpha, filter type 0, not interlaced
  static (raster: Geometry.Raster) as (=== PNG) => PNG(
    header: PNG.Chunk(type: "IHDR", data: PNG.Header(width: raster.width, height: raster.height, depth: 8, color: 6, compression: 0, filter: 0, interlace: 0) as Byte[]),
    chunks: [PNG.Chunk(type: "IDAT", data: Zlib.write(raster.map(row => [0, row.map([.red, .green, .blue, (.alpha * 255).floor])].flatten)) as Byte[])])

  static level := {
    {png: PNG} => png.raster
  }
  static written := {
    {writing: Language.Writing{.value is Geometry.Raster}} => writing.value as PNG
  }
}
// One red pixel, 8-bit truecolour with alpha, filter type 0, as Pillow 12.3 writes it, a reference encoder's output and no value of the specification (5.2, 11.2.1, 11.2.4, 11.2.5)
assert {
  red_png := [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x08, 0x06, 0x00, 0x00, 0x00, 0x1f, 0x15, 0xc4, 0x89,
    0x00, 0x00, 0x00, 0x0d, 0x49, 0x44, 0x41, 0x54, 0x78, 0x9c, 0x63, 0xf8, 0xcf, 0xc0, 0xf0, 0x1f, 0x00, 0x05, 0x00, 0x01, 0xff, 0x89, 0x99, 0x3d, 0x1d, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82]
  red := PNG.read(red_png)
  assert red.width == 1 && red.height == 1 && red[0][0] == Geometry.Color(255, 0, 0, 1)  // PNG1 one red pixel is not read as a red raster
  assert PNG.read(PNG.write(red) as Byte[])[0][0] == Geometry.Color(255, 0, 0, 1)  // PNG2 a written raster does not read back
  assert (PNG.write(red) as Byte[])[-12..] == [0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4e, 0x44, 0xae, 0x42, 0x60, 0x82]  // PNG3 a written image does not end with IEND and its CRC
  assert PNG.read([red_png[..<29], [0x00, 0x15, 0xc4, 0x89], red_png[33..]].flatten) is Diagnostic  // PNG4 a chunk whose CRC does not match reads
}
