// Intel 64 and IA-32 Architectures Software Developer's Manual, Volume 2 (https://www.intel.com/content/www/us/en/developer/articles/technical/intel-sdm.html): integer arithmetic on registers, as gcc -O2 emits it
X86 := class: Language {
  static extensions := ".bin"

  static Registers := ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"]
  static Halves := ["eax", "ecx", "edx", "ebx", "esp", "ebp", "esi", "edi", "r8d", "r9d", "r10d", "r11d", "r12d", "r13d", "r14d", "r15d"]
  static named (number, width) => (width == 64) ? X86.Registers[number] : X86.Halves[number]

  // REX: 0100, then W (64-bit operands) and the fourth bit of ModRM.reg (R), SIB.index (X), ModRM.rm or SIB.base (B); each byte's bits are read least significant first, the order x86 stores its integers in (Vol. 2, 2.2.1)
  static Rex := class (b: <-Binary₁, x: <-Binary₁, r: <-Binary₁, w: <-Binary₁, <-Binary₄{== 4})
  static base_extension (rex) => rex.empty ? 0 : (rex.first.b * 8)
  static index_extension (rex) => rex.empty ? 0 : (rex.first.x * 8)
  static reg_extension (rex) => rex.empty ? 0 : (rex.first.r * 8)
  static wide (rex) => (rex.empty || (rex.first.w == 0)) ? 32 : 64

  // ModRM: rm, reg, mod. With mod 3, rm is a register; else memory: a SIB byte (base, index, scale) when rm is 4, a displacement of 8 bits when mod is 1, of 32 when mod is 2 or the SIB names no base (Vol. 2, 2.1.5)
  static Operand := class (
    rm: <-Binary₃, reg: <-Binary₃, mod: <-Binary₂,
    (sib_base: <-Binary₃, sib_index: <-Binary₃, scale: <-Binary₂) if (mod != 3) && (rm == 4),
    (small: <-Binary₈) if mod == 1,
    (large: <-Binary₃₂) if (mod == 2) || (((mod == 0) && (rm == 4)) && (sib_base == 5))
  ) {
    rm_register (rex) => rm + X86.base_extension(rex)
    reg_register (rex) => reg + X86.reg_extension(rex)
    base_register (rex) =>
      (return (rm + X86.base_extension(rex))) if rm != 4
      ((mod == 0) && (sib_base == 5)) ? None : (sib_base + X86.base_extension(rex))
    index_register (rex) => ((rm == 4) && ((sib_index + X86.index_extension(rex)) != 4)) ? (sib_index + X86.index_extension(rex)) : None
    scaled => (rm == 4) ? ([1, 2, 4, 8][scale]) : 1
    displacement => (small !== None) ? X86.signed(small, 8) : ((large !== None) ? X86.signed(large, 32) : None)
    // (memory, written the way objdump writes it: `[rdi+rsi*2-0x3]`)
    memory (rex) =>
      shown := ""
      (shown = X86.Registers[base_register(rex)]) if base_register(rex) !== None
      (shown = (shown + ((shown == "") ? "" : "+")) + ((X86.Registers[index_register(rex)] + "*") + scaled)) if index_register(rex) !== None
      (shown = shown + X86.offset(displacement)) if displacement !== None
      ("[" + shown) + "]"
  }
  static signed (value, width) => (width == 8) ? ((value >= 128) ? ((value - 256) as Integer) : value) : ((value >= 2147483648) ? ((value - 4294967296) as Integer) : value)
  static power (exponent) =>
    made := 1
    left := exponent
    while left > 0 {
      made = made * 2
      left = left - 1
    }
    made
  static offset (value) => (value < 0) ? ("-0x" + (0 - value).hexadecimal) : ("+0x" + value.hexadecimal)
  // (an immediate, written the way objdump writes it: the bits of the operation's width, `0xfffffff7`)
  static immediate (value, width) => "0x" + ((value < 0) ? ((width == 64) ? ("ffffffff" + ((4294967296 + value).hexadecimal)) : (4294967296 + value).hexadecimal) : value.hexadecimal)

  // What each instruction is: its encoding (the header), its text, and what it does to the registers (`lifted`)
  static Ret := class<rex: X86.Rex[]> (<-Byte{== 195}) {
    assembly => "ret"
    lifted (registers) => registers
  }
  static Imul := class<rex: X86.Rex[]> (<-Byte{== 15}, <-Byte{== 175}, operand: X86.Operand{.mod == 3}) {
    assembly => ((("imul " + X86.named(operand.reg_register(rex), X86.wide(rex))) + ",") + X86.named(operand.rm_register(rex), X86.wide(rex)))
    lifted (registers) => X86.applied(registers, operand.reg_register(rex), X86.wide(rex), X86.held(registers, operand.reg_register(rex), X86.wide(rex)), "*", X86.held(registers, operand.rm_register(rex), X86.wide(rex)))
  }
  static ImulImmediate := class<rex: X86.Rex[]> (<-Byte{== 107}, operand: X86.Operand{.mod == 3}, immediate: <-Binary₈) {
    assembly => ((((("imul " + X86.named(operand.reg_register(rex), X86.wide(rex))) + ",") + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    lifted (registers) => X86.applied(registers, operand.reg_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "*", X86.constant(X86.signed(immediate, 8), X86.wide(rex)))
  }
  static Lea := class<rex: X86.Rex[]> (<-Byte{== 141}, operand: X86.Operand{.mod != 3}) {
    assembly => (("lea " + X86.named(operand.reg_register(rex), X86.wide(rex))) + ",") + operand.memory(rex)
    lifted (registers) => X86.placed(registers, operand.reg_register(rex), X86.Value(X86.addressed(registers, operand, rex), X86.wide(rex)))
  }
  static Add := class<rex: X86.Rex[]> (<-Byte{== 1}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("add", operand.rm_register(rex), operand.reg_register(rex), rex)
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "+", X86.held(registers, operand.reg_register(rex), X86.wide(rex)))
  }
  static Sub := class<rex: X86.Rex[]> (<-Byte{== 41}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("sub", operand.rm_register(rex), operand.reg_register(rex), rex)
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "-", X86.held(registers, operand.reg_register(rex), X86.wide(rex)))
  }
  static Mov := class<rex: X86.Rex[]> (<-Byte{== 137}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("mov", operand.rm_register(rex), operand.reg_register(rex), rex)
    lifted (registers) => X86.placed(registers, operand.rm_register(rex), X86.Value(X86.held(registers, operand.reg_register(rex), X86.wide(rex)), X86.wide(rex)))
  }
  // (xor of a register with itself, how gcc writes 0; any other xor is not arithmetic)
  static Xor := class<rex: X86.Rex[]> (<-Byte{== 49}, operand: X86.Operand{.mod == 3}) {
    assembly => X86.pair("xor", operand.rm_register(rex), operand.reg_register(rex), rex)
    lifted (registers) => (operand.rm_register(rex) == operand.reg_register(rex)) ? X86.placed(registers, operand.rm_register(rex), X86.Value(X86.constant(0, X86.wide(rex)), X86.wide(rex))) : None
  }
  static Neg := class<rex: X86.Rex[]> (<-Byte{== 247}, operand: X86.Operand{(.mod == 3) && (.reg == 3)}) {
    assembly => "neg " + X86.named(operand.rm_register(rex), X86.wide(rex))
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.constant(0, X86.wide(rex)), "-", X86.held(registers, operand.rm_register(rex), X86.wide(rex)))
  }
  // (not x is -x - 1)
  static Not := class<rex: X86.Rex[]> (<-Byte{== 247}, operand: X86.Operand{(.mod == 3) && (.reg == 2)}) {
    assembly => "not " + X86.named(operand.rm_register(rex), X86.wide(rex))
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.constant(((0 - 1) as Integer), X86.wide(rex)), "-", X86.held(registers, operand.rm_register(rex), X86.wide(rex)))
  }
  // (shl x, k is x times 2^k)
  static Shl := class<rex: X86.Rex[]> (<-Byte{== 193}, operand: X86.Operand{(.mod == 3) && (.reg == 4)}, immediate: <-Binary₈) {
    assembly => ((("shl " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(immediate, 8))
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "*", X86.constant(X86.power(immediate), X86.wide(rex)))
  }
  static AddSmall := class<rex: X86.Rex[]> (<-Byte{== 131}, operand: X86.Operand{(.mod == 3) && (.reg == 0)}, immediate: <-Binary₈) {
    assembly => ((("add " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "+", X86.constant(X86.signed(immediate, 8), X86.wide(rex)))
  }
  static SubSmall := class<rex: X86.Rex[]> (<-Byte{== 131}, operand: X86.Operand{(.mod == 3) && (.reg == 5)}, immediate: <-Binary₈) {
    assembly => ((("sub " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 8), X86.wide(rex)))
    lifted (registers) => X86.applied(registers, operand.rm_register(rex), X86.wide(rex), X86.held(registers, operand.rm_register(rex), X86.wide(rex)), "-", X86.constant(X86.signed(immediate, 8), X86.wide(rex)))
  }
  static AddAccumulator := class<rex: X86.Rex[]> (<-Byte{== 5}, immediate: <-Binary₃₂) {
    assembly => ((("add " + X86.named(0, X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 32), X86.wide(rex)))
    lifted (registers) => X86.applied(registers, 0, X86.wide(rex), X86.held(registers, 0, X86.wide(rex)), "+", X86.constant(X86.signed(immediate, 32), X86.wide(rex)))
  }
  // (a register's number in the opcode's low three bits)
  static MovImmediate := class<rex: X86.Rex[]> (register: <-Binary₃, <-Binary₅{== 23}, immediate: <-Binary₃₂) {
    assembly => ((("mov " + X86.named(register + X86.base_extension(rex), 32)) + ",") + X86.immediate(immediate, 32))
    lifted (registers) => X86.placed(registers, register + X86.base_extension(rex), X86.Value(X86.constant(X86.signed(immediate, 32), 32), 32))
  }
  static MovSigned := class<rex: X86.Rex[]> (<-Byte{== 199}, operand: X86.Operand{(.mod == 3) && (.reg == 0)}, immediate: <-Binary₃₂) {
    assembly => ((("mov " + X86.named(operand.rm_register(rex), X86.wide(rex))) + ",") + X86.immediate(X86.signed(immediate, 32), X86.wide(rex)))
    lifted (registers) => X86.placed(registers, operand.rm_register(rex), X86.Value(X86.constant(X86.signed(immediate, 32), X86.wide(rex)), X86.wide(rex)))
  }
  static pair (name, first, second, rex) => (((name + " ") + X86.named(first, X86.wide(rex))) + ",") + X86.named(second, X86.wide(rex))

  // What a register holds while a function is lifted: Ray code over the parameters, and the width it was written at; read at the other width, a 64-bit value is its low half, a 32-bit one zero-extended (Vol. 1, 3.4.1.1)
  static Value := class (code, width)
  static typed (width) => (width == 64) ? "Int64" : "Int32"
  static constant (value, width) => (value > 0) ? ("" + value) : (((("((1 - " + (1 - value)) + ") wrapped ") + X86.typed(width)) + ")")
  static held (registers, number, width) =>
    value := registers[number]
    (return None) if value === None
    (return value.code) if value.width == width
    (width == 32) ? (("(" + value.code) + " wrapped Int32)") : (("(" + value.code) + " wrapped Natural32)")
  static combined (left, sign, right, width) =>
    (return None) unless left && right
    ((((((("((" + left) + " ") + sign) + " ") + right) + ") wrapped ") + X86.typed(width)) + ")"
  static applied (registers, number, width, left, operator, right) =>
    code := X86.combined(left, operator, right, width)
    (return None) unless code
    X86.placed(registers, number, X86.Value(code, width))
  static placed (registers, number, value) =>
    (return None) unless registers && value.code
    at := registers.head
    left := number
    while left > 0 {
      at = at.next
      left = left - 1
    }
    at.value = value
    registers
  // (an address is computed at the width it is written to)
  static addressed (registers, operand, rex) =>
    width := X86.wide(rex)
    code := None
    (code = X86.held(registers, operand.base_register(rex), width)) if operand.base_register(rex) !== None
    if operand.index_register(rex) !== None {
      scaled := (operand.scaled == 1) ? X86.held(registers, operand.index_register(rex), width) : X86.combined(X86.held(registers, operand.index_register(rex), width), "*", "" + operand.scaled, width)
      code = (code === None) ? scaled : X86.combined(code, "+", scaled, width)
    }
    displacement := operand.displacement
    (return code) if (displacement === None) || (displacement == 0)
    (displacement > 0) ? X86.combined(code, "+", "" + displacement, width) : X86.combined(code, "-", "" + (0 - displacement), width)

  // The function a function's machine code computes, in Ray code of the normal form: its arguments in rdi, rsi, rdx, rcx, its result in eax or rax (System V AMD64 ABI, 3.2.3)
  static lift (function, name, parameters, width) =>
    registers := [None] * 16
    places := [7, 6, 2, 1]
    index := 0
    at := parameters.head
    while at {
      X86.placed(registers, places[index], X86.Value(at.value, width))
      index = index + 1
      at = at.next
    }
    step := function.instructions.head
    while step && registers {
      registers = step.value.operation.lifted(registers)
      step = step.next
    }
    (return None) unless registers
    result := X86.held(registers, 0, width)
    (return None) unless result
    (((name + " (") + parameters.map((parameter) => (parameter + ": ") + X86.typed(width)).join(", ")) + ") => ") + result
}

// An instruction: a REX prefix or none, then one of the encodings above, given the prefix (made once X86 is, so that its header sees the encodings are of bits)
X86.Instruction := class (
  rex: X86.Rex[]{length <= 1},
  operation: X86.Imul<rex> | X86.Sub<rex> | X86.Mov<rex> | X86.Lea<rex> | X86.Add<rex> | X86.MovImmediate<rex> | X86.Neg<rex> | X86.Not<rex>
    | X86.Xor<rex> | X86.AddSmall<rex> | X86.SubSmall<rex> | X86.MovSigned<rex> | X86.Shl<rex> | X86.ImulImmediate<rex> | X86.AddAccumulator<rex> | X86.Ret<rex>
) {
  ends => operation is X86.Ret
}
// A function: its instructions, up to the `ret` that ends it
X86.Function := class (instructions: X86.Instruction[]{(!.empty) && .last.ends}) {
  static from (bytes) => X86.Function.bits_read(bytes.map((byte) => byte.binary(8).reversed).join(""))
  written => .binary.pieces(8).map((eight) => eight.reversed.unsigned)
  assembly => instructions.map((instruction) => instruction.operation.assembly)
}

// The same instructions as their text: a line objdump writes is Ray code here (`X86.Assembly reading { lea eax,[rdi+rsi*1] }`), the instruction it is, encoded as gcc encodes it
X86.Named := class (number, width)
X86.Address := class (base, index, scale, displacement)
X86.Register := {
  rax => X86.Named(0, 64)
  rcx => X86.Named(1, 64)
  rdx => X86.Named(2, 64)
  rbx => X86.Named(3, 64)
  rsp => X86.Named(4, 64)
  rbp => X86.Named(5, 64)
  rsi => X86.Named(6, 64)
  rdi => X86.Named(7, 64)
  r8 => X86.Named(8, 64)
  r9 => X86.Named(9, 64)
  r10 => X86.Named(10, 64)
  r11 => X86.Named(11, 64)
  r12 => X86.Named(12, 64)
  r13 => X86.Named(13, 64)
  r14 => X86.Named(14, 64)
  r15 => X86.Named(15, 64)
  eax => X86.Named(0, 32)
  ecx => X86.Named(1, 32)
  edx => X86.Named(2, 32)
  ebx => X86.Named(3, 32)
  esp => X86.Named(4, 32)
  ebp => X86.Named(5, 32)
  esi => X86.Named(6, 32)
  edi => X86.Named(7, 32)
  r8d => X86.Named(8, 32)
  r9d => X86.Named(9, 32)
  r10d => X86.Named(10, 32)
  r11d => X86.Named(11, 32)
  r12d => X86.Named(12, 32)
  r13d => X86.Named(13, 32)
  r14d => X86.Named(14, 32)
  r15d => X86.Named(15, 32)
}
// (memory, `[base+index*scale±displacement]`: an address of register numbers)
X86.Memory := {
  {base: X86.Register} => X86.Address(base.number, None, 1, None)
  {base: X86.Register}+{offset} => X86.Address(base.number, None, 1, "{offset}".signed_hexadecimal(32))
  {base: X86.Register}-{offset} => X86.Address(base.number, None, 1, ("-" + "{offset}").signed_hexadecimal(32))
  {index: X86.Register}*{scale} => X86.Address(None, index.number, X86.scale_of("{scale}"), None)
  {index: X86.Register}*{scale}+{offset} => X86.Address(None, index.number, X86.scale_of("{scale}"), "{offset}".signed_hexadecimal(32))
  {index: X86.Register}*{scale}-{offset} => X86.Address(None, index.number, X86.scale_of("{scale}"), ("-" + "{offset}").signed_hexadecimal(32))
  {base: X86.Register}+{index: X86.Register}*{scale} => X86.Address(base.number, index.number, X86.scale_of("{scale}"), None)
  {base: X86.Register}+{index: X86.Register}*{scale}+{offset} => X86.Address(base.number, index.number, X86.scale_of("{scale}"), "{offset}".signed_hexadecimal(32))
  {base: X86.Register}+{index: X86.Register}*{scale}-{offset} => X86.Address(base.number, index.number, X86.scale_of("{scale}"), ("-" + "{offset}").signed_hexadecimal(32))
}
X86.Assembly := {
  ret => X86.Instruction([], X86.Ret([]))
  imul {a: X86.Register},{b: X86.Register},{value} =>
    x := a
    y := b
    n := X86.small("{value}", a.width)
    X86.encoded(x, y, ((rex) => X86.ImulImmediate(rex, X86.direct(y, x), n)))
  imul {a: X86.Register},{b: X86.Register} =>
    x := a
    y := b
    X86.encoded(x, y, ((rex) => X86.Imul(rex, X86.direct(y, x))))
  lea {a: X86.Register},[{m: X86.Memory}] => X86.addressing(a, m, ((rex, operand) => X86.Lea(rex, operand)))
  add {a: X86.Register},{value} => X86.immediate_form(a, "{value}", 0)
  add {a: X86.Register},{b: X86.Register} =>
    x := a
    y := b
    X86.encoded(y, x, ((rex) => X86.Add(rex, X86.direct(x, y))))
  sub {a: X86.Register},{value} => X86.immediate_form(a, "{value}", 5)
  sub {a: X86.Register},{b: X86.Register} =>
    x := a
    y := b
    X86.encoded(y, x, ((rex) => X86.Sub(rex, X86.direct(x, y))))
  mov {a: X86.Register},{value} => X86.moved(a, "{value}")
  mov {a: X86.Register},{b: X86.Register} =>
    x := a
    y := b
    X86.encoded(y, x, ((rex) => X86.Mov(rex, X86.direct(x, y))))
  xor {a: X86.Register},{b: X86.Register} =>
    x := a
    y := b
    X86.encoded(y, x, ((rex) => X86.Xor(rex, X86.direct(x, y))))
  neg {a: X86.Register} =>
    x := a
    X86.encoded(X86.Named(3, x.width), x, ((rex) => X86.Neg(rex, X86.Operand(x.number % 8, 3, 3))))
  not {a: X86.Register} =>
    x := a
    X86.encoded(X86.Named(2, x.width), x, ((rex) => X86.Not(rex, X86.Operand(x.number % 8, 2, 3))))
  shl {a: X86.Register},{value} =>
    x := a
    n := "{value}".signed_hexadecimal(16)
    X86.encoded(X86.Named(4, x.width), x, ((rex) => X86.Shl(rex, X86.Operand(x.number % 8, 4, 3), n)))
}
// (a REX prefix when the width is 64 bits or a register is past the eighth (Vol. 2, 2.2.1))
X86.prefix (width, reg, index, base) =>
  extended := ((reg >= 8) || (index >= 8)) || (base >= 8)
  ((width == 64) || extended) ? [X86.Rex((base >= 8) ? 1 : 0, (index >= 8) ? 1 : 0, (reg >= 8) ? 1 : 0, (width == 64) ? 1 : 0)] : []
X86.direct (rm, reg) => X86.Operand(rm.number % 8, reg.number % 8, 3)
X86.encoded (reg, rm, form) =>
  rex := X86.prefix(rm.width, reg.number, 0, rm.number)
  X86.Instruction(rex, form(rex))
X86.small (text, width) => X86.unsigned(text.signed_hexadecimal(width), 8)
X86.unsigned (value, width) => (value < 0) ? (value + ((width == 8) ? 256 : 4294967296)) : value
// (add or sub of an immediate: eight bits sign-extended when it fits, else to the accumulator in 32 (05))
X86.immediate_form (a, text, extension) =>
  value := text.signed_hexadecimal(a.width)
  rex := X86.prefix(a.width, 0, 0, a.number)
  fits := (value >= ((0 - 128) as Integer)) && (value <= 127)
  (return X86.Instruction(rex, X86.AddSmall(rex, X86.Operand(a.number % 8, 0, 3), X86.unsigned(value, 8)))) if fits && (extension == 0)
  (return X86.Instruction(rex, X86.SubSmall(rex, X86.Operand(a.number % 8, 5, 3), X86.unsigned(value, 8)))) if fits && (extension == 5)
  (return X86.Instruction(rex, X86.AddAccumulator(rex, X86.unsigned(value, 32)))) if (extension == 0) && (a.number == 0)
  None
// (a move of an immediate: into 32 bits, B8 plus the register; into 64, C7 sign-extending 32)
X86.moved (a, text) =>
  value := text.signed_hexadecimal(a.width)
  rex := X86.prefix(a.width, 0, 0, a.number)
  (return X86.Instruction(rex, X86.MovImmediate(rex, a.number % 8, X86.unsigned(value, 32)))) if a.width == 32
  X86.Instruction(rex, X86.MovSigned(rex, X86.Operand(a.number % 8, 0, 3), X86.unsigned(value, 32)))
// (memory as ModRM, SIB and displacement: a SIB when there is an index, no base, or the base is rsp or r12; the shortest displacement)
X86.addressing (a, address, form) =>
  base := address.base
  index := address.index
  offset := address.displacement
  rex := X86.prefix(a.width, a.number, (index === None) ? 0 : index, (base === None) ? 0 : base)
  (return X86.Instruction(rex, form(rex, X86.Operand(4, a.number % 8, 0, 5, (index === None) ? 4 : (index % 8), X86.scale_bits(address.scale), None, X86.unsigned((offset === None) ? 0 : offset, 32))))) if base === None
  short := (offset === None) ? (((base % 8) == 5) ? 0 : None) : offset
  mode := (short === None) ? 0 : (((short >= ((0 - 128) as Integer)) && (short <= 127)) ? 1 : 2)
  small := (mode == 1) ? X86.unsigned(short, 8) : None
  large := (mode == 2) ? X86.unsigned(short, 32) : None
  (return X86.Instruction(rex, form(rex, X86.Operand(base % 8, a.number % 8, mode, None, None, None, small, large)))) if (index === None) && ((base % 8) != 4)
  X86.Instruction(rex, form(rex, X86.Operand(4, a.number % 8, mode, base % 8, (index === None) ? 4 : (index % 8), X86.scale_bits(address.scale), small, large)))
X86.scale_of (text) => (text == "1") ? 1 : ((text == "2") ? 2 : ((text == "4") ? 4 : 8))
X86.scale_bits (scale) => (scale == 1) ? 0 : ((scale == 2) ? 1 : ((scale == 4) ? 2 : 3))

// Ray written as machine code: a function of the interop normal form, its operations evaluated into registers as a stack (the
// result in eax or rax, what is still needed in r8 to r11), its arguments where System V gives them, then `ret`; as the lines
// `X86.Assembly` reads (the reverse of `lift`)
X86.Operation := class (name, left, right)
X86.Shape := {
  ( ( {left} + {right} ) wrapped {type} ) => X86.Operation("add", "{left}", "{right}")
  ( ( {left} - {right} ) wrapped {type} ) => X86.Operation("sub", "{left}", "{right}")
  ( ( {left} * {right} ) wrapped {type} ) => X86.Operation("imul", "{left}", "{right}")
  ( ( {left} + {right} ) as {type} ) => X86.Operation("add", "{left}", "{right}")
  ( ( {left} - {right} ) as {type} ) => X86.Operation("sub", "{left}", "{right}")
  ( ( {left} * {right} ) as {type} ) => X86.Operation("imul", "{left}", "{right}")
}
X86.Temporaries := [0, 8, 9, 10, 11]
X86.Arguments := [7, 6, 2, 1]
X86.lowered (text, depth, width, parameters) =>
  (return None) if depth >= X86.Temporaries.count
  target := X86.named(X86.Temporaries[depth], width)
  shape := X86.Shape reads_text text
  if shape {
    left := X86.lowered(shape.left, depth, width, parameters)
    right := X86.lowered(shape.right, depth + 1, width, parameters)
    (return None) unless left && right && (depth + 1 < X86.Temporaries.count)
    return [left, right, [(((shape.name + " ") + target) + ",") + X86.named(X86.Temporaries[depth + 1], width)]].flatten
  }
  index := parameters.index_of(text)
  (return [(("mov " + target) + ",") + X86.named(X86.Arguments[index], width)]) if index !== None
  (return [(("mov " + target) + ",0x") + text]) if text fits_pattern "^[1-9]$"
  None
X86.compiled (body, width, parameters) =>
  lines := X86.lowered(body spaced_tokens "( )", 0, width, parameters)
  (return None) unless lines
  [lines, ["ret"]].flatten
