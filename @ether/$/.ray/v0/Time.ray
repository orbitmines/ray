Calendar := class {
  Segment := class {
    name: Node
    length: Node
    epoch: 1
    is_recurring => .period
  }

  parts: (chain None)
  segments => .parts

  all => (
    known ^keyword := chain None
    known &= Julian
    known &= Gregorian
    known &= UTC
    known
  )

  equivalent (here: Time, there: Time) => (
    from := here
    to := there
    Calendar.Equivalence(from: from, to: to)
  )
  Equivalence := class {
    convert (time: Time) => (

      elapsed := time - .from
      Time(calendar: .to.calendar, since_epoch: (.to.since_epoch + elapsed), epoch: .to.epoch)
    )
  }
}

Weekday := enum monday | tuesday | wednesday | thursday | friday | saturday | sunday
Month := enum january (length: 31, place: 1) | february (length: 28, place: 2) | march (length: 31, place: 3) | april (length: 30, place: 4) | may (length: 31, place: 5) | june (length: 30, place: 6) | july (length: 31, place: 7) | august (length: 31, place: 8) | september (length: 30, place: 9) | october (length: 31, place: 10) | november (length: 30, place: 11) | december (length: 31, place: 12) {

  days_in (year: Number, calendar) => (
    month_days := .length
    if ((.place == 2).and(calendar.is_leap_year(year))) { month_days = .length.succ }
    month_days
  )
}

Julian := class {
  is_leap_year (year: Number) => (year % 4).is_zero
  days_in_year (year: Number) => if (.is_leap_year(year)) { 366 } else { 365 }
  days_in_month (month, year: Number) => month.days_in(year, this)
  weeks_in_year (year: Number) => .days_in_year(year) / 7
  hours_in_day => 24
  minutes_in_hour => 60
  seconds_in_minute => 60
  months => Month.components
  weekdays => Weekday.components

  days_before_year (year: Number) => (
    total ^keyword := 0
    counted_year ^keyword := 1
    while (counted_year < year) {
      total = total + .days_in_year(counted_year)
      counted_year = counted_year.succ
    }
    total
  )
  days_before (year: Number, month, day: Number) => .days_before_year(year) + .day_of_year(month, day, year).pred

  day_of_year (month, day: Number, year: Number) => (
    calendar := this
    total ^keyword := day
    Month.components for {
      if (it.value.place < month.place) { total = total + it.value.days_in(year, calendar) }
    }
    total
  )
  chainable == (other) => this === other
}
Gregorian := class: Julian {

  is_leap_year (year: Number) => if ((year % 100).is_zero) { (year % 400).is_zero } else { (year % 4).is_zero }

  reform => (
    last_julian ^keyword := Time(calendar: Julian, since_epoch: (Julian.days_before(1582, Month.october, 4) of Day))
    first_gregorian ^keyword := Time(calendar: Gregorian, since_epoch: (Gregorian.days_before(1582, Month.october, 15) of Day))
    Calendar.equivalent(last_julian, first_gregorian)
  )
}

UTC := class: Gregorian {

  offset: 0
  with_offset (offset: Quantity) => UTC(offset: offset)
  leap_seconds => false
}
GMT := UTC

Month.components.hierarchy &= class {
  index => .place.pred
  chainable == (other) => .place == other.place
  chainable != (other) => (this == other).not
}

Time := class {
  calendar: Node
  since_epoch: Quantity
  epoch?: Time

  since_calendar_epoch => (
    held ^keyword := .since_epoch
    if (.epoch) { held = .since_epoch + .epoch.since_calendar_epoch }

    held
  )
  chainable == (other: Time) => .since_calendar_epoch == other.since_calendar_epoch
  chainable < (other: Time) => .since_calendar_epoch < other.since_calendar_epoch
  compounds + (duration: Quantity) => Time(calendar: .calendar, since_epoch: .since_epoch + duration, epoch: .epoch)
  compounds - (other: Time) => .since_calendar_epoch - other.since_calendar_epoch
  as (counted_by) => (
    kept_epoch ^keyword := None
    if (.epoch) { kept_epoch = .epoch.as(counted_by) }
    Time(calendar: counted_by, since_epoch: .since_epoch, epoch: kept_epoch)
  )
  as (=== boolean) => true
  round (measure: Unit) => (
    held ^keyword := .since_epoch
    step ^keyword := ((1 of measure) as held.unit).amount
    if step.is_zero {
      held = held as measure
      step = 1
    }
    rest ^keyword := held.amount % step
    kept ^keyword := held.amount - rest
    unless ((rest + rest) < step) { kept = kept + step }
    Time(calendar: .calendar, since_epoch: Quantity(amount: kept, unit: held.unit), epoch: .epoch)
  )

  YEAR := None
  MONTH := None

  uncertainty: Quantity?
  corrected (by: Quantity, within: Quantity) => (
    moved ^keyword := .since_epoch + by
    Time(calendar: .calendar, since_epoch: moved, epoch: .epoch, uncertainty: within)
  )

  since (other: Time) => this - other
  years_since (other: Time) => ((this - other) as Year).amount

  now => (
    clock ^keyword := Time.Clock(digits: (external time).as_string)
    Time(calendar: UTC, since_epoch: clock.elapsed, uncertainty: clock.resolution)
  )
  Clock := class {

    elapsed => .digits.as_number of Nanosecond
    resolution => 1 of Nanosecond
    nanoseconds => .digits.slice(.digits.count - 9, .digits.count)
    nanoseconds_tail => .digits.slice(.digits.count - 3, .digits.count).as_number of Nanosecond
    seconds_tail => .digits.slice(.digits.count - 12, .digits.count - 9).as_number of Second
  }
}

ISO_8601 := class {
  date (text: String) => (
    parts := text.split(U+002D)
    year := parts.head.value.as_number
    month := Month.at_index(parts.head.next.value.as_number.pred)
    day := parts.head.next.next.value.as_number
    ISO_8601.Date(year: year, month: month, day: day)
  )
  time (text: String) => (
    parts := text.split(U+003A)
    hour := parts.head.value.as_number
    minute := parts.head.next.value.as_number
    second := if (parts.head.next.next) { parts.head.next.next.value.as_number } else { 0 }

    ((((hour * 60) + minute) * 60) + second) of Second
  )
  Date := class {
    as_time (calendar) => Time(calendar: calendar, since_epoch: (calendar.days_before(.year, .month, .day) of Day))
    years_since (other) => (
      whole ^keyword := .year - other.year
      if ((.month.place < other.month.place).or((.month == other.month).and(.day < other.day))) { whole = whole.pred }
      whole
    )
    is_valid (calendar) => (0 < .day).and((.month.days_in(.year, calendar) < .day).not)
    day_of_year (calendar) => calendar.day_of_year(.month, .day, .year)
    chainable == (other) => (.year == other.year).and(.month == other.month).and(.day == other.day)
  }
}
Month.components.hierarchy &= class {
  at_index (index: Number) => (
    wanted := index.succ
    found ^keyword := None
    Month.components for {
      if (it.value.place == wanted) { found = it.value }
    }
    found
  )
}

Time.OfDay = class {
  hour: Number
  minute: Number
  second: Number

  date => None
  as_seconds => (((.hour * 60) + .minute) * 60) + .second
  :{seconds: Decimal.String ^number} ^punctuation => (
    held_hour ^keyword := .hour
    held_minute ^keyword := .minute
    Time.OfDay(hour: held_hour, minute: held_minute, second: Decimal(integer: seconds))
  )
  two_digits (value: Number) => if (value < 10) { "0" + value.as_string } else { value.as_string }
  as_string => if (.second.is_zero) { .two_digits(.hour) + ":" + .two_digits(.minute) } else { .two_digits(.hour) + ":" + .two_digits(.minute) + ":" + .two_digits(.second) }
  chainable == (other: Time.OfDay) => .as_seconds == other.as_seconds
}
Number.components.hierarchy &= class {
  :{minutes: Decimal.String ^number} ^punctuation => (
    held_hour ^keyword := this
    Time.OfDay(hour: held_hour, minute: Decimal(integer: minutes), second: 0)
  )
}

MonthUnit := class: Unit {
  base => Day
  ratio => if (Time.MONTH) { Time.MONTH.days_in(Time.YEAR, Gregorian) } else { 30 }
  factor => .ratio
}
Month.span = MonthUnit().called(`month`, `months`, `mo`)

LeapSeconds := class {
  path => `/usr/share/zoneinfo/leap-seconds.list`
  entries => (
    read ^keyword := chain None
    IO.read(.path).lines for {
      unless ((it.value.empty).or(it.value.starts_with("#"))) { read &= it.value.split(Char.tab).head.value.as_number }
    }
    read
  )
  minute_length (time: Time) => (
    length ^keyword := 60
    ending ^keyword := (time.round(Minute).since_calendar_epoch as Second).amount + 60
    LeapSeconds.entries for {
      if (it.value == ending) { length = 61 }
    }
    length
  )
}

TimeZone := class {
  name: String
  offset: Quantity

  zones => `/usr/share/zoneinfo`
  read (zone_name: String) => (
    data ^keyword := IO.read(TimeZone.zones + "/" + zone_name)
    TimeZone(name: zone_name, offset: (0 of Second), data: data)
  )
}

Planet := class { }
Earth := class: Planet {
  years => Year
  days => Day
  calendar => Gregorian
}
Sol => Second multiple 88775
MartianYear => Sol multiple 668
Mars := class: Planet {
  years => MartianYear
  days => Sol
}
