// The web renderer: a scene written as HTML, a document with its CSS stylesheet and JS script
UI.HTML := class {
  static space := Geometry.Space.screen
  Geometry.Shape &+= {
    dom => id.segments.join("-")
    dom_named => [("id", dom), ("class", styles.join(" ")) if styles.nonempty]
    // WAI-ARIA aria-label (https://www.w3.org/TR/wai-aria-1.2/#aria-label), the popover attribute (https://html.spec.whatwg.org/multipage/popover.html)
    dom_described => [("aria-label", label) if label, ("popover", "manual") if position is Geometry.Anchored]
    dom_entry => content -- (chosen => [("placeholder", chosen.placeholder as String) if chosen.placeholder, ("disabled", "") if chosen.disabled,
      ("min", chosen.goal.least as String) if chosen.goal is Number{least, most}, ("max", chosen.goal.most as String) if chosen.goal is Number{least, most}])
    dom_spans => content.shared_styles -- (shared => content.pieces.map(piece => piece.first.styles{!shared.contains(.)} -- (own => own.empty ? $.html.Text(piece)
      : @html <span class={own.join(" ")} style={dom_inline(UI.Theme.face(this, piece.first))}>{piece}</span>)))
    dom_inline (face: Geometry.Shape) => [
      ("color:", face.color, ";") if face.color && face.color != color,
      ("background:", face.fill, ";") if face.fill && face.fill != fill,
      ("font-weight:", face.font.weight, ";") if face.font.weight != font.weight,
      ("font-style:", face.font.style as String, ";") if face.font.style != font.style
    ]
    selected_range => text.enumerate{.value.styles.contains("selected")}.index -- (from: .first, to: .last + 1)
  }

  Markup := class {
    tags (page) => [[(name: "og:title", content: page.title), (name: "og:description", content: page.description), (name: "og:image", content: page.image as String) if page.image]{!(page.meta ?? []).name.contains(.name)}, page.meta ?? []].flatten(1){.content != None}

    head (page) => @html {
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>{page.title ?? ""}</title>
      <meta name="description" content={page.description ?? ""} />
      {tags(page).map(Compiler.reduced(., meta))}
      {Compiler.reduced((name: "theme-color", content: Compiler.reduced(page.theme, Style.values)), meta) if page.theme}
      {[("canonical", page.canonical), ("icon", page.icon), ("apple-touch-icon", page.apple_icon), ("manifest", page.manifest)]{.1 != None}.map((rel, at) => @html <link rel={rel} href={at as String} />)}
      {(page.structured ?? []).map(entry => $.html.Element("script", [("type", "application/ld+json")], [$.html.Raw($.json.write(UI.Linked(entry, context: "https://schema.org").document))]))}
      <link rel="stylesheet" href="style.css" />
      <script src="app.js" defer />
    }
    meta := {
      // The Open Graph protocol (https://ogp.me/#metadata)
      {entry: *{name ~= ("og:" | "article:" | "fb:", *)}} => @html <meta property={entry.name} content={entry.content} />
      {entry} => @html <meta name={entry.name} content={entry.content} />
    }
    // SVG path data (https://www.w3.org/TR/SVG2/paths.html#PathData)
    path := {
      {segment: Geometry.Quadratic} => " Q", segment.control.x, " ", segment.control.y, " ", segment.to.x, " ", segment.to.y
      {segment: Geometry.Cubic} => " C", segment.first.x, " ", segment.first.y, " ", segment.second.x, " ", segment.second.y, " ", segment.to.x, " ", segment.to.y
      {segment: Geometry.Arc} => " A", segment.radius.x, " ", segment.radius.y, " ", segment.rotation.in(degree), " ", segment.large ? 1 : 0, " ", segment.sweep ? 1 : 0, " ", segment.to.x, " ", segment.to.y
      {segment: Geometry.Vector{index == 0}} => "M", segment.x, " ", segment.y
      {segment: Geometry.Vector} => " L", segment.x, " ", segment.y
    }

    rules := {
      {page: Geometry.Shape{solved && !parent}} => $.html.Document(head: [head(UI.page)], body: @html <body {page.dom_named}>{page.children}</body>)
      {image: Geometry.Shape{content is Location && content.language === Language.Image && fill}} => @html <span {image.dom_named} role="img" aria-label={image.label} />
      {image: Geometry.Shape{content is Location && content.language === Language.Image}} => @html <img {image.dom_named} src={image.content.@ as String} alt={image.label} loading="lazy" />
      {video: Geometry.Shape{content is Location && content.language === Language.Video}} => @html <video {video.dom_named} src={video.content.@ as String} controls={video.content.controls} muted={video.content.muted} loop={video.content.looping} />
      {audio: Geometry.Shape{content is Location && content.language === Language.Audio}} => @html <audio {audio.dom_named} src={audio.content.@ as String} controls />
      {frame: Geometry.Shape{content is Location && content.video_site}} => @html <iframe {frame.dom_named} src={frame.content.embedded.@ as String} title={frame.content.alt ?? ""} allow="fullscreen; picture-in-picture; encrypted-media" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" />
      {link: Geometry.Shape{content is Location}} => @html <a {link.dom_named} href={link.content.@ as String} target={"_blank" if link.content.window == new} rel={"noopener noreferrer" if link.content.window == new}>{link.children}</a>
      {text: Geometry.Shape{content is String && font.weight >= 600 && font.size >= 2em}} => @html <h1 {text.dom_named}>{text.dom_spans}</h1>
      {text: Geometry.Shape{content is String && font.weight >= 600 && font.size >= 1.5em}} => @html <h2 {text.dom_named}>{text.dom_spans}</h2>
      {text: Geometry.Shape{content is String && font.weight >= 600}} => @html <h3 {text.dom_named}>{text.dom_spans}</h3>
      {text: Geometry.Shape{content is String && !white_space.wraps}} => @html <span {text.dom_named} dir={text.direction == right-to-left ? "rtl" : "ltr"}>{text.dom_spans}</span>
      {text: Geometry.Shape{content is String}} => @html <p {text.dom_named} dir={text.direction == right-to-left ? "rtl" : "ltr"}>{text.dom_spans}</p>

      {form: Geometry.Shape{children.some(.content is Choice)}} => @html <form {form.dom_named}>{form.children}</form>
      {field: Geometry.Shape{content is Choice{goal is Language}}} => @html <div id={field.dom} class={["painted", field.styles].flatten.join(" ")}>
        <pre id="{field.dom}-paint" aria-hidden="true">{field.face.dom_spans}</pre>
        <textarea id="{field.dom}-text" placeholder={field.content.placeholder as String} spellcheck="false">{field.content.empty ? "" : field.content.tried as String}</textarea>
      </div>
      {field: Geometry.Shape{content is Choice{goal is String{multiline}}}} => @html <textarea {field.dom_named} {field.dom_entry}>{field.content.empty ? "" : field.content.tried as String}</textarea>
      {field: Geometry.Shape{content is Choice{listed}}} => @html <select {field.dom_named}>{field.content.options.map(@html <option value={. as String}>{. as String}</option>)}</select>
      {field: Geometry.Shape{content is Choice}} => @html <input {field.dom_named} type={Compiler.reduced(field.content, kinds)} {field.dom_entry} />
      {canvas: Geometry.Shape{content is Program}} => @html <canvas {canvas.dom_named} width={canvas.size.x as px} height={canvas.size.y as px} />

      {ball: Geometry.Ball} => @html <span {ball.dom_named} {ball.dom_described} role="presentation" />
      {polygon: Geometry.Polygon{!rectangular}} => @html <svg {polygon.dom_named} viewBox="0 0 {polygon.size.x as px} {polygon.size.y as px}">
        <polygon points={polygon.boundary.points.map(UI.HTML.space.seen(., polygon.size)).map(.x as px, ",", .y as px).join(" ")} />
      </svg>
      {outlined: Geometry.Shape{!rectangular && boundary is Geometry.Curve}} => @html <svg {outlined.dom_named} viewBox="0 0 {outlined.size.x as px} {outlined.size.y as px}">
        <path transform="matrix(1,0,0,-1,0,{outlined.size.y as px})" d="{outlined.boundary.segments.map(Compiler.reduced(., path))}{" Z" if outlined.boundary.segments is Loop}" />
      </svg>

      {box: Geometry.Shape{focusable}} => @html <button {box.dom_named} {box.dom_described}>{box.children}</button>
      {box: Geometry.Shape{flow == grid}} => @html <table {box.dom_named} {box.dom_described}>{box.children}</table>
      {box: Geometry.Shape} => @html <section {box.dom_named} {box.dom_described}>{box.children}</section>
    }

    // The input element's type attribute (https://html.spec.whatwg.org/multipage/input.html#attr-input-type)
    kinds := {
      {chosen: Choice{goal is String{secret}}} => "password"
      {chosen: Choice{goal is String{search}}} => "search"
      {chosen: Choice{goal is boolean}} => "checkbox"
      {chosen: Choice{goal is Number{least, most}}} => "range"
      {chosen: Choice{goal is Number}} => "number"
      {chosen: Choice{goal is Time}} => "datetime-local"
      {chosen: Choice{goal is Geometry.Color}} => "color"
      {chosen: Choice{goal is Location}} => "file"
      {chosen: Choice} => "text"
    }

    level := Geometry.Preparing(1px) + rules
  }

  Style := class {
    // white-space (https://www.w3.org/TR/css-text-3/#white-space-property), text-transform (https://www.w3.org/TR/css-text-3/#text-transform-property)
    WhiteSpace = [(Geometry.WhiteSpace.normal, "normal"), (Geometry.WhiteSpace.nowrap, "nowrap"), (Geometry.WhiteSpace.pre, "pre"), (Geometry.WhiteSpace.pre_wrap, "pre-wrap"), (Geometry.WhiteSpace.pre_line, "pre-line")]
    Cases = [(.upper_case, "uppercase"), (.lower_case, "lowercase"), (.title_case, "capitalize")]

    percent (share: Number) => share * 100, "%"
    stops (gradient: Geometry.Gradient) => gradient.sorted.map(("," if .index > 0), .value, " ", .at * 100, "%")
    values := {
      // <color> (https://www.w3.org/TR/css-color-4/#color-syntax), <gradient> (https://www.w3.org/TR/css-images-3/#gradients)
      {paint: Section{=== currentColor}} => "currentColor"
      {color: Geometry.Color} => "rgba(", color.red, ",", color.green, ",", color.blue, ",", color.alpha, ")"
      {gradient: Geometry.Radial} => "radial-gradient(", stops(gradient), ")"
      {gradient: Geometry.Conic} => "conic-gradient(", stops(gradient), ")"
      {gradient: Geometry.Gradient} => "linear-gradient(", gradient.angle.in(turn), "turn,", stops(gradient), ")"
      {pattern: Geometry.Pattern} => "url(#", pattern.shape.dom, ")"
      // <length> and calc() (https://www.w3.org/TR/css-values-4/#lengths, https://www.w3.org/TR/css-values-4/#calc-func)
      {length: Geometry.Length{quantities.count > 1}} => "calc(", length.quantities.map(.quantity, .unit.symbol).join(" + "), ")"
      {length: Geometry.Length} => length.amount, length.unit.symbol
      // <easing-function> (https://www.w3.org/TR/css-easing-1/)
      {easing: Geometry.Easing{=== Geometry.linear}} => "linear"
      {easing: Geometry.Easing{=== Geometry.ease_in}} => "ease-in"
      {easing: Geometry.Easing{=== Geometry.ease_out}} => "ease-out"
      {easing: Geometry.Easing{=== Geometry.step}} => "step-end"
      {easing: Geometry.Easing} => "ease"
      // Transform functions (https://www.w3.org/TR/css-transforms-1/#transform-functions, https://www.w3.org/TR/css-transforms-2/#funcdef-matrix3d)
      {matrix: Geometry.Transform{count == 3}} => "matrix(", [matrix[0][0], matrix[1][0], matrix[0][1], matrix[1][1], matrix[0][2], matrix[1][2]].join(","), ")"
      {matrix: Geometry.Transform} => "matrix3d(", matrix.transposed.flatten.join(","), ")"
      // box-shadow (https://www.w3.org/TR/css-backgrounds-3/#box-shadow), filter functions (https://www.w3.org/TR/filter-effects-1/#filter-functions)
      {shadow: Geometry.Shadow} => ("inset " if shadow.inset), UI.HTML.space.seen(shadow.offset) -- (offset => (offset.x, " ", offset.y)), " ", shadow.blur, " ", shadow.spread, " ", shadow.color
      {blur: Geometry.Blur} => "blur(", blur.radius, ")"
      {filter: Geometry.Hue} => "hue-rotate(", filter.amount, "turn)"
      {filter: Geometry.Brightness} => "brightness(", filter.amount, ")"
      {filter: Geometry.Contrast} => "contrast(", filter.amount, ")"
      {filter: Geometry.Grayscale} => "grayscale(", filter.amount, ")"
      {filter: Geometry.Invert} => "invert(", filter.amount, ")"
      {filter: Geometry.Opacity} => "opacity(", filter.amount, ")"
      {filter: Geometry.Saturate} => "saturate(", filter.amount, ")"
      {filter: Geometry.Sepia} => "sepia(", filter.amount, ")"
    }

    // Flexible box layout (https://www.w3.org/TR/css-flexbox-1/), grid layout (https://www.w3.org/TR/css-grid-2/)
    layout := {
      {shape: Geometry.Shape{flow == inline}} => @css { display: flex; flex-wrap: {shape.wrap ? "wrap" : "nowrap"}; }
      {shape: Geometry.Shape{flow == grid}} => @css { display: grid; grid-template-columns: repeat({shape.columns},1fr); }
      {shape: Geometry.Shape{flow == layered}} => @css { display: grid; grid-template-areas: "layer"; }
      {shape: Geometry.Shape} => @css { display: flex; flex-direction: column; }
    }
    // Box alignment (https://www.w3.org/TR/css-align-3/)
    aligned := {
      {shape: Geometry.Shape{align == center}} => @css { align-items: center; text-align: center; }
      {shape: Geometry.Shape{align == end}} => @css { align-items: flex-end; text-align: end; }
      {shape: Geometry.Shape{align == between}} => @css { justify-content: space-between; }
      {shape: Geometry.Shape{align == around}} => @css { justify-content: space-around; }
      {shape: Geometry.Shape{align == stretch}} => @css { align-items: stretch; }
      {shape: Geometry.Shape{align == justify}} => @css { text-align: justify; }
      {shape: Geometry.Shape{align == middle && flow == inline}} => @css { align-items: center; }
      {shape: Geometry.Shape{align == middle}} => @css { justify-content: center; }
      {shape: Geometry.Shape} => []
    }
    // Positioned layout (https://www.w3.org/TR/css-position-3/)
    placement := {
      {position: Geometry.Sticky} => "sticky"
      {position: Geometry.Fixed} => "fixed"
      {position: Geometry.Absolute} => "absolute"
      {position: Geometry.Position} => None
    }
    specific := {
      {shape: Geometry.Ball} => @css { display: inline-block; border-radius: 50%; }
      // CSS Masking (https://www.w3.org/TR/css-masking-1/)
      {image: Geometry.Shape{content is Location && content.language === Language.Image && fill}} => @css {
        object-fit: {image.content.fit as String}; display: inline-block; mask: {mask(image)}; -webkit-mask: {mask(image)};
      }
      {image: Geometry.Shape{content is Location && content.language === Language.Image}} => @css { object-fit: {image.content.fit as String}; }
      {frame: Geometry.Shape{content is Location && content.video_site}} => @css { border: 0; aspect-ratio: 16/9; width: 100%; }
      {shape: Geometry.Shape} => []
    }
    mask (image: Geometry.Shape) => "url(\"", image.content.@ as String, "\") center/", image.content.fit == fill ? "100% 100%" : image.content.fit as String, " no-repeat"

    sized (shape: Geometry.Shape, along: "width" | "height") => (shape.`along`, shape.fields[along].type) -- ((given, bounds) => @css {
      {along}: {percent(given) if given is Number};
      {along}: {percent(given.sorted.first.value) if given is Geometry.Stops};
      {along}: {given if given is Geometry.Length};
      max-{along}: {(bounds.most is Number ? percent(bounds.most) : bounds.most) if bounds.most != None};
      min-{along}: {(bounds.least is Number ? percent(bounds.least) : bounds.least) if bounds.least != None};
    })
    spaced (prefix: String, edges: Geometry.Edges) => [("top", edges.top), ("right", edges.right), ("bottom", edges.bottom), ("left", edges.left)]{.1 != None}.map((prefix + .0, .1))
    bordered (stroke: Geometry.Stroke?) => stroke ? (stroke.sides == Geometry.all ? [""] : stroke.sides#.map("-" + (. as String))).map(side =>
      ("border" + side, stroke.width, " ", stroke.dash.empty ? "solid" : "dashed", " ", stroke.paint)) : []
    // Fonts (https://www.w3.org/TR/css-fonts-4/)
    typeface (shape: Geometry.Shape) => (shape.font, shape.parent.font ?? Geometry.Font.base) -- ((font, inherited) => @css {
      font-family: {font.family.join(",") if font.family != inherited.family};
      font-size: {font.size if font.size != inherited.size};
      font-weight: {font.weight if font.weight != inherited.weight};
      font-style: {(font.style as String) if font.style != inherited.style};
      line-height: {font.line_height if font.line_height != inherited.line_height};
      letter-spacing: {font.tracking if font.tracking != inherited.tracking};
    })
    styling (name: String) => Compiler.reduced(declared(Geometry.Box()), values).first.declarations -- (plain => Compiler.reduced(declared(Geometry.Box().styled(name)), values).first.declarations{!plain.contains(.)})
    // Container queries (https://www.w3.org/TR/css-contain-3/#container-queries)
    responsive (shape: Geometry.Shape) => shape.width.sorted -- (sorted => sorted.zip([sorted.rest, None]).map((at, next) => @css @container (min-width:{Compiler.reduced(at.at, values) as String}) {
      #{shape.dom} { width: {!(shape.width is Geometry.Steps) && next
        ? ("calc(", at.value * (at.at as px), "px + (100cqw - ", at.at as px, "px) * ", (next.value * (next.at as px) - at.value * (at.at as px)) / ((next.at - at.at) as px), ")")
        : percent(at.value)}; }
    }))
    // CSS Anchor Positioning (https://www.w3.org/TR/css-anchor-position-1/)
    anchoring (shape: Geometry.Shape) => (shape.position.anchor ?? shape.parent) -- (anchor => @css {
      #{anchor.dom} { anchor-name: --{anchor.dom}; }
      #{shape.dom} { position: fixed; inset: auto; margin: 0; position-anchor: --{anchor.dom}; position-area: {shape.position.side as String}; }
    })

    declared (shape: Geometry.Shape) => [
      @css #{shape.dom} {
        {Compiler.reduced(shape, layout)}
        gap: {shape.gap.y} {shape.gap.x};
        {sized(shape, "width")}
        {sized(shape, "height")}
        aspect-ratio: {shape.aspect if shape.aspect};
        container-type: {"inline-size" if shape.children.some(.width is Geometry.Stops)};
        {Compiler.reduced(shape, aligned)}
        {spaced("padding-", shape.spaced(border))}
        {spaced("margin-", shape.spaced(itself)) if shape.position is Geometry.Flow}
        position: {Compiler.reduced(shape.position, placement)};
        position: {"relative" if shape.position is Geometry.Flow && shape.children.some(.position is Geometry.Absolute)};
        {spaced("", shape.spaced(itself)) unless shape.position is (Geometry.Flow | Geometry.Anchored)}
        background: {shape.fill if shape.fill};
        {bordered(shape.stroke)}
        border-radius: {shape.radius.map(. is Number ? percent(.) : .).join(" ") if shape.radius != [0px]};
        transform: {(Geometry.Transform.scale(Geometry.Vector(1, -1, 1)) -- (. * shape.transform * .)) if shape.transform != Geometry.Transform.identity};
        overflow: {shape.overflow == scroll ? "auto" : shape.overflow as String};
        z-index: {shape.layer if shape.layer != 0};
        mix-blend-mode: {(shape.blend as String) if shape.blend != normal};
        filter: {shape.effects{. is (Geometry.Blur | Geometry.Filter)} -- (.join(" ") if .nonempty)};
        box-shadow: {shape.effects{. is Geometry.Shadow} -- (.join(",") if .nonempty)};
        color: {shape.color if shape.color && shape.color != shape.parent.color};
        {typeface(shape)}
        text-transform: {Cases{.0 == shape.case}.first.1 if shape.case != shape.parent.case};
        text-overflow: {(shape.truncate as String) if shape.truncate};
        white-space: {WhiteSpace{shape.white_space is .0}.first.1 if shape.content is String || shape.white_space != shape.parent.white_space};
        overflow-wrap: {"anywhere" if shape.white_space.wraps == anywhere};
        {Compiler.reduced(shape, specific)}
        transition: {("all ", shape.transition.duration.in(ms), "ms ", shape.transition.easing) if shape.transition};
        cursor: {(shape.cursor ?? "pointer") as String if shape.cursor || shape.focusable};
        touch-action: {(shape.touch as String).replace("_", "-") if shape.touch};
        scrollbar-width: {"none" unless shape.scrollbar};
      },
      @css #{shape.dom}::placeholder { color: {Geometry.Box().styled("placeholder").color}; } if shape.content is Choice && shape.content.placeholder,
      UI.Theme.styles.map(name => @css #{shape.dom}.{name} { {styling(name)} }) if shape.styles is Dynamic,
      @css #{shape.dom}:focus-visible { outline: 2px solid currentColor; } if shape.focusable,
      responsive(shape) if shape.width is Geometry.Stops
    ]

    rules := values + {
      {page: Geometry.Shape{solved && !parent}} => $.css.Sheet(@css {
        * { box-sizing: border-box; margin: 0; }
        body { font-family: sans-serif; line-height: 1.2; }
        .painted { display: grid; }
        .painted>pre,.painted>textarea { grid-area: 1/1; margin: 0; padding: 0; border: none; font: inherit; white-space: pre-wrap; overflow-wrap: anywhere; overflow: hidden; }
        .painted>textarea { color: transparent; caret-color: currentColor; background: transparent; resize: none; outline: none; }
        @media (prefers-reduced-motion:reduce) { * { animation: none; transition: none; } }
        html.locked { overflow: hidden; }
        {page.reachable.map(declared(.))}
        {page.reachable{.position is Geometry.Anchored}.map(anchoring(.))}
      })
    }

    level := Geometry.Preparing(1px) + rules
  }

  Script := class {
    state := {
      {name} = {value} => @js ray.{name} = {value}
    }

    prelude := @js function effect(reads, body) { ray.subscribe(reads, body); body() }
    // The device's files (`@me/device/storage`) kept in the origin's Web Storage as `ray:<path>`: localStorage, and the storage
    // event other documents of the origin fire (https://html.spec.whatwg.org/multipage/webstorage.html#the-localstorage-attribute, https://html.spec.whatwg.org/multipage/webstorage.html#the-storageevent-interface)
    storage := @js {
      Object.keys(localStorage).filter((key) => key.startsWith("ray:")).forEach((key) => ray.set("@me/device/storage/" + key.slice(4), localStorage.getItem(key)))
      window.addEventListener("storage", (event) => event.key === null
        ? ray.get("@me/device/storage.fields.name").forEach((key) => ray.set("@me/device/storage/" + key, null))
        : event.key.startsWith("ray:") && ray.set("@me/device/storage/" + event.key.slice(4), event.newValue))
      effect(["@me/device/storage"], () => {
        const kept = ray.get("@me/device/storage.fields")
        Object.keys(localStorage).filter((key) => key.startsWith("ray:") && !kept.some((field) => "ray:" + field.name === key)).forEach((key) => localStorage.removeItem(key))
        kept.forEach((field) => localStorage.getItem("ray:" + field.name) === String(field.value) || localStorage.setItem("ray:" + field.name, field.value))
      })
    }
    // UI Events (https://www.w3.org/TR/uievents/), Pointer Events (https://www.w3.org/TR/pointerevents3/), the History API (https://html.spec.whatwg.org/multipage/nav-history-apis.html)
    devices := @js {
      ray.set("@me/device/handheld", /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || matchMedia("(pointer:coarse)").matches && !matchMedia("(pointer:fine)").matches || navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent))
      {["pointerdown", "pointermove", "pointerup", "pointercancel", "wheel"].map(name => @js window.addEventListener({name}, (event) => ray.point(event)))}
      {["keydown", "keyup"].map(name => @js window.addEventListener({name}, (event) => ray.key(event)))}
      window.addEventListener("focusin", (event) => ray.set("UI.focus", event.target.id))
      window.addEventListener("resize", (event) => ray.set("UI.scene.size", ray.size()))
      window.addEventListener("popstate", (event) => ray.set("@me/device/location", location.href))
      ray.set("@me/device/location", location.href)
      window.addEventListener("paste", (event) => ray.set("@me/device/clipboard", event.clipboardData.getData("text")))
      window.addEventListener("dragstart", (event) => ray.set(event.target.id + ".dragged", true))
      window.addEventListener("dragend", (event) => ray.set(event.target.id + ".dragged", false))
      window.addEventListener("drop", (event) => ray.set(event.target.id + ".dropped", event.dataTransfer.files))
      window.addEventListener("compositionupdate", (event) => ray.call("UI.focus.content.composed", event.data))
      window.addEventListener("deviceorientation", (event) => ray.set("@me/device/orientation", ray.orientation(event)))
      window.addEventListener("devicemotion", (event) => ray.set("@me/device/motion", ray.motion(event)))
      window.addEventListener("gamepadconnected", (event) => ray.poll_gamepads())
      window.matchMedia("(prefers-reduced-motion:reduce)").addEventListener("change", (event) => ray.set("@me/device/preferences.reduced_motion", event.matches))
      window.matchMedia("(prefers-color-scheme:dark)").addEventListener("change", (event) => ray.set("@me/device/preferences.dark", event.matches))
      effect(["@me/device/location"], () => location.href === ray.get("@me/device/location") || history.pushState(null, "", ray.get("@me/device/location")))
      effect(["UI.page.title"], () => document.title = ray.get("UI.page.title"))
      window.addEventListener("scroll", (event) => ray.set("UI.scene.scrolled.y", window.scrollY))
      effect(["UI.scene.scrolled"], () => {
        const y = ray.get("UI.scene.scrolled.y")
        if (Math.abs(scrollY - y) > 1) scrollTo(\{top: y, behavior: ray.get("UI.scene.transition") ? "smooth" : "auto"})
      })
      effect(["UI.selection"], () => ray.get("UI.selection").forEach((s) => {
        const r = s.selected_range
        const e = r && (document.getElementById(s.id + "-text") || document.getElementById(s.id))
        if (e) {
          if (e.setSelectionRange) {
            e.focus()
            e.setSelectionRange(r.from, r.to)
          } else {
            const g = document.createRange()
            g.selectNodeContents(e)
            getSelection().removeAllRanges()
            getSelection().addRange(g)
          }
        }
      }))
      effect(["UI.locked"], () => document.documentElement.classList.toggle("locked", ray.get("UI.locked")))
      effect(["@me/device/notification"], () => new Notification(ray.get("@me/device/notification.title"), \{body: ray.get("@me/device/notification.body")}))
      effect(["@me/device/fullscreen"], () => document.documentElement.requestFullscreen())
      effect(["@me/device/printing"], () => window.print())
      effect(["@me/device/clipboard"], () => navigator.clipboard.writeText(ray.get("@me/device/clipboard")))
      effect(["@me/device/opened"], () => open(ray.get("@me/device/opened"), "_blank", "noopener"))
    }

    Geometry.Shape &+= {
      scripted => [
        fields{.value is Dynamic}.map(field => field.name == "styles"
          ? @js effect({field.value.program.reads}, () => document.getElementById({dom}).className = {field.value.program{O: UI.HTML.Script.state}})
          : @js effect({field.value.program.reads}, () => ray.set({dom + "." + field.name}, {field.value.program{O: UI.HTML.Script.state}}))),
        @js document.getElementById({dom}).addEventListener("click", (event) => ray.activate({dom})) if focusable,
        @js document.getElementById("{dom}-text").addEventListener("input", (event) => document.getElementById("{dom}-paint").textContent = event.target.value) if content is Choice && content.goal is Language,
        @js document.getElementById({dom}).addEventListener("input", (event) => ray.set({dom}, event.target.value)) if content is Choice,
        @js effect({content.reads}, () => ray.draw({dom}, {content.rendered(Language.Direct.level)})) if content is Program && !(content is Choice),
        (position.anchor ?? parent).dom -- (anchor => [
          ["pointerenter", "focusin"].map(name => @js document.getElementById({anchor}).addEventListener({name}, (event) => document.getElementById({dom}).showPopover())),
          ["pointerleave", "focusout"].map(name => @js document.getElementById({anchor}).addEventListener({name}, (event) => document.getElementById({dom}).hidePopover()))
        ]) if this is UI.Popover,
        @js document.getElementById({dom}).showPopover() if position is Geometry.Anchored && visible && !(this is UI.Popover),
        @js effect([{dom + ".scrolled"}], () => document.getElementById({dom}).scrollTo(\{top: ray.get({dom + ".scrolled.y"}), behavior: ray.get({dom + ".transition"}) ? "smooth" : "auto"})) if overflow == scroll
      ]
    }

    rules := {
      {page: Geometry.Shape{solved && !parent}} => [
        prelude,
        devices,
        storage,
        TimeZone.Intl.script,
        Dynamic#{!page.reachable.map(.fields.value).flatten.contains(.)}.map(dynamic => @js effect({dynamic.program.reads}, () => { {dynamic.program{O: state}} })),
        page.reachable.map(.scripted)
      ].flatten
    }

    level := Geometry.Preparing(1px) + rules
  }

  Package := class (files: (path: String, content: *)[]) => {
    write (to: Location) => files.for((to / .path).held = .content)
    document => files{.path == "index.html"}.first.content
    sheet => files{.path == "style.css"}.first.content
  }
  packaged := {
    {root: Geometry.Shape{solved && !parent}} => Package([
      (path: "index.html", content: Compiler.reduced(root, Markup.rules)),
      (path: "style.css", content: Compiler.reduced(root, Style.rules)),
      (path: "app.js", content: Compiler.reduced(root, Script.rules)),
      root.reachable{.content is Location && .content.media}.map((path: .content.name, content: .content)),
      [UI.page.icon, UI.page.apple_icon, UI.page.manifest]{!= None}.map((path: .name, content: .))
    ].flatten)
  }
  level := Geometry.Preparing(1px) + packaged

  DOM := class: UI.Interface {
    send (message) => @me/instance = message
    dynamically event: @me/instance
    line (parts: String[]) => parts.join(" "), \n

    static made := 0
    Mount := class (node: $.html.Element | $.html.Text | $.html.Raw | $.html.Comment, parent: String?, id: String = (node is $.html.Element ? node.id : None) ?? ("e" + ((DOM.made += 1) as String))) => { }
    Listening := class (mount: Mount) => { }
    protocol := {
      {mount: Mount{node is $.html.Element}} => mount.node -- (element => [
        line(["create", mount.id, element.tag]),
        element.attributes.map(line(["attribute", mount.id, .name, (.value as String).escaped_line])),
        Listening(mount),
        element.children.map(Mount(., mount.id)),
        line(["append", mount.parent, mount.id]) if mount.parent
      ])
      {mount: Mount{node is $.html.Comment}} => []
      {mount: Mount} => line(["text", mount.parent, mount.node.text.escaped_line])
      {listening: Listening{mount.node.tag is ("a" | "button")}} => [line(["listen", listening.mount.id, "click"])]
      {listening: Listening{mount.node.tag is ("input" | "select" | "textarea")}} => [line(["listen", listening.mount.id, "input"]), line(["listen", listening.mount.id, "focus"])]
      {listening: Listening} => []
    }
    mounted (element: $.html.Element) => Compiler.reduced(Mount(element), protocol) as String

    Event := class (id: String) => {
      shape => UI.scene.reachable{.dom == id}.first
    }
    Click := class: Event (id: UI.Input.Id, " click")
    Input := class: Event (id: UI.Input.Id, " input ", value: *)
    Focus := class: Event (id: UI.Input.Id, " focus")
    Scroll := class: Event (id: UI.Input.Id, " scroll ", y: Decimal)
    Size := class: Event (id: UI.Input.Id, " size ", width: Decimal, " ", height: Decimal)
    Inbound := Click | Input | Focus | Scroll | Size | UI.Input.Inbound
    applied := UI.Input.applied + {
      {click: Click} => click.shape.activate
      {input: Input} => input.shape.content.attempt(input.value)
      {focus: Focus} => UI.focus = focus.shape
      {scroll: Scroll} => UI.scene.scrolled = Geometry.Vector(0, scroll.y * 1px)
      {size: Size{shape}} => size.shape.size = Geometry.Vector(size.width * 1px, size.height * 1px)
      {size: Size} => None
    }
    static dispatched (line: String?) => line.trimmed ~= (event: Inbound) -- Compiler.reduced(.event, applied) if .

    start => send(line(["clear"])) -- ["pointerdown", "pointermove", "pointerup", "pointercancel", "keydown", "keyup", "scroll"].for(send(line(["listen", "window", .])))
      -- ({ send(line(["clipboard", (@me/device/clipboard as String).escaped_line])) } when @me/device/clipboard changes)
      -- ({ send(line(["open", (@me/device/opened as String).escaped_line])) } when @me/device/opened changes)
    stop => None
    write (package: Package) => send(line(["clear"])) -- send(mounted(package.document.body)) -- (send(line(["style", package.sheet as $.css])) if package.sheet)
      -- send(line(["lock", UI.locked as String]))
      -- send(line(["scroll", "window", (UI.scene.scrolled.y as px) as String, (UI.scene.transition != None) as String]))
    read => dispatched(event)
  }

  Chromium := { }
  Firefox := { }
  Extension := { }
  Safari := {
    // backdrop-filter, which Safari reads only prefixed (https://www.w3.org/TR/filter-effects-2/#BackdropFilterProperty)
    {rule: $.css.Rule{declarations.some(.0 == "backdrop-filter") && !declarations.some(.0 == "-webkit-backdrop-filter")}} => $.css.Rule(rule.selector, [rule.declarations, [("-webkit-backdrop-filter", rule.declarations{.0 == "backdrop-filter"}.first.[1..])]].flatten(1), rule.within)
  }
}

Device &+= {
  document: UI.HTML.DOM = UI.HTML.DOM(level: UI.HTML.level)
}
