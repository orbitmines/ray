IP := class: Location &+ (-1 <- . -> +1) {
  static NUMBER_OF_SEGMENTS: Decimal
  static SEGMENT_LENGTH: Decimal
  static NUMBER_OF_BITS = NUMBER_OF_SEGMENTS * SEGMENT_LENGTH

  static Segment := class {
    static Binary := Binary{length == SEGMENT_LENGTH}
  }
  segments: Segment[]{length == NUMBER_OF_SEGMENTS}

  static canonical = static
  // Lowercase hexadecimal (https://datatracker.ietf.org/doc/html/rfc5952#section-4.3)
  // CIDR notation where the low bits are superposed (https://datatracker.ietf.org/doc/html/rfc4632#section-3.1)
  as (=== String) => NUMBER_OF_BITS - (as Binary ~= Superposed[]⊣ -- .length) -- (prefix_length => prefix_length == NUMBER_OF_BITS
    ? (this as canonical).written_out.lowercase
    : ((as Binary ~~ .[prefix_length..] = 0) as static as String, "/", prefix_length))
  full: String => written_out
  chainable == (other: IP) => as Binary == other as Binary

  compounds + (offset: Number{-(as Binary) <= . <= ~!(as Binary)}): static => as Binary + offset
  compounds - (offset: Number{- ~!(as Binary) <= . <= as Binary}): static => as Binary - offset

  compounds / (prefix_length: Number{0 <= . <= NUMBER_OF_BITS}): static => as Binary ~~ .[prefix_length..] = 0 | 1

  static v4 := class: IP ({segments.join(".")}) => {
    static NUMBER_OF_SEGMENTS = 4
    static SEGMENT_LENGTH = 8

    static Segment: Decimal{< 2^8}
  }

  static v6 := class: IP (
    (left: Segment[]).join(":")?,
    zero_compression: "::" (? if !defined_segments.empty),
    (right: Segment[]).join(":")?,
    (":", embedded_ipv4: IPv4)?
  ) => {
    static NUMBER_OF_SEGMENTS = 8
    static SEGMENT_LENGTH = 16

    static Segment: Hexadecimal{length <= 4}

    segments => left, 0[]{length == number_of_compressed_segments}(), right, embedded_ipv4 as Binary
    defined_segments: Segment[] => left, right, embedded_ipv4 as Binary
    number_of_compressed_segments => NUMBER_OF_SEGMENTS - defined_segments.length

    // The symbol "::" MUST NOT be used to shorten just one 16-bit 0 field. (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.2)
    dynamically assert defined_segments.length (zero_compression ? < NUMBER_OF_SEGMENTS - 1 : == NUMBER_OF_SEGMENTS)
    // The longest run of consecutive 16-bit 0 fields MUST be shortened (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.3)
    dynamically assert left & right ~= 0[] -- .length <= number_of_compressed_segments if zero_compression
    // When the length of the consecutive 16-bit 0 fields are equal, the first sequence of zero bits MUST be shortened. (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.3)
    dynamically assert left ~= 0[] -- .length != number_of_compressed_segments if zero_compression

    static canonical := v6{
      // The longest run of two or more zero fields, the leftmost of equal ones (https://datatracker.ietf.org/doc/html/rfc5952#section-4.2.3)
      // Prefer compressed zeros representation when possible (https://datatracker.ietf.org/doc/html/rfc5952#section-5)
      zero_compression if segments ~= 0[]{length >= 2}
      // Mixed notation for a well-known IPv4-mapped prefix (https://datatracker.ietf.org/doc/html/rfc5952#section-5)
      // Mixed notation for NAT64 (https://datatracker.ietf.org/doc/html/rfc6052#section-2.1)
      embedded_ipv4 if . is "::ffff:0.0.0.0/96" | "64:ff9b::/96"
    }
    full: String => (this as v6{!zero_compression && !embedded_ipv4}).written_out
  }

}

IPv4 := IP.v4
IPv6 := IP.v6

{ip: IP}/{prefix_length: Decimal}: IP => ip / prefix_length
