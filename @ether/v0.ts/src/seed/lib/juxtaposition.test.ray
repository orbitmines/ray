say {x} =>
  external io stdout x
// a method called without brackets (G2.1), a closure argument up to the next `,` (G2.21): false, then true
B := class name: Node? {
  convert (f, other) => say (f(other))
  multiple (a, other) => say other
}
b := B()
b.multiple true, false
b
  .convert (x: Node) => x, true
// on a line continuing a call: false, true
B(name: true)
  .multiple true, false
// a closure of one name after a space, and a running program read on as any value: true, then a Program
B(name: true).convert (x: Node) => x, true
f => &caller as Program
say f
