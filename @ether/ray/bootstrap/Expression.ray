// Expression: a language read from its own text. Its first line says how a rule is written: `!language`, the brackets a
// hole is written in (`{ }`), then the rule that makes rules, written with them (`{LHS} => {RHS}`). Every statement after it
// is read in a node by the longest of that node's rules that reads it; the rule that makes rules adds one there, its head
// read the same way, its body read when it is applied, in a node of its own whose caller is what applied it. Only four
// things are given: `external .` (a node), `external &` (what applies), `external goto` and `external label` (where control
// goes); and what the host gives and is given: the input, the files, what is painted and said.
Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    // (a hole's brackets, a space where its name goes)
    CAPTURE: (String+, \s, String+),
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}(`LHS`) | RHS: CAPTURE.map{== \s}(`RHS`) | String)[],
    \n\n
  ),
  (
    // (the rule that makes rules: any space in it any amount of space, each hole anything, its left side a head of the same
    // shape again; the first statement)
    Code := (BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Code) | String)[]
    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES.map{is \s}((space) => \s[])
    GRAMMAR_RULE_DEF.RHS = Code
    GRAMMAR_RULE_DEF.LHS = Code
    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF
    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,
    statements: (
      // A node: its rules by their heads; what it does not read, what it is in reads.
      Node := class (in?: Node, of?: Node) => {
        node := this
        rules := {
          [rule: GRAMMAR_RULE.LHS] := (caller) => {
            // (its head and body as written, a hole a rule running took standing for what it took; made where that was written)
            // (a name written in a pair, `(x) := v`: x read as a value, made again where something visible defines it)
            // (one naming a hole of what wrote it, `(place) := v`: the text that hole took, where that was written)
            written_whole := written_of(rule.LHS, caller)
            writer := writer_of(rule.LHS, caller)
            inner := between(written_whole)
            naming := binder(writer, inner)
            named := (naming === None) ? written_of(inner, writer) : written_of(level cw_trimmed (taken_in(naming, inner).value), naming.caller)
            valued := (!(written_whole.first == hole_opening) && ((level cw_enclosed (written_whole)) === true)) && ((named.length > 0) && !has_hole(named))
            written := valued ? named : written_whole
            head := head_of(valued ? ((naming === None) ? inner : named) : rule.LHS, (naming === None) ? caller : naming.caller)
            rule_rhs := body_of(rule.RHS, caller)
            namer := naming ?? splicer(inner, writer)
            here := (valued && !(namer === None)) ? (place_of(namer.caller) ?? node) : home_of(rule.LHS, caller, place_of(caller) ?? node)
            home := (valued ? defined_in(here, named) : None) ?? here
            defines := level holds_text (written) (separator)
            head.for((piece) => piece)
            level paired (written) (BOOTSTRAPPER.CAPTURE) (home)
            home.rules[[head]] := (caller) => {
              me := applied
              me.bound = holes
              me.caller = caller
              me.in = Node(in: node)
              me.this = caller.this
              me.receiver = caller.receiver
              // (each hole a rule of its node, `x` and `{x}`, answering what it took read where the rule was applied, once)
              me.bound.for((hole) => me.in.rules[[hole.key | BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => held(hole, () => read_outside(me.outside, () => ((splicer(hole.value, caller) === None) ? named_for(c, reader(c, caller), hole.value) : named_for(c, writer_of(hole.value, caller), written_of(hole.value, caller))))))
              me.in.rules.keys.for((hk) => hk.named = true)
              // (read while the rule is set aside: a rule never reads itself)
              (rule_own.styled_as ?? Array.new).for((style) => painted.append([style, [rule_own.written_head, me.input], [me.bound]]))
              me.outside = aside
              aside = [rule_own].joined(aside)
              (rs: Statements(me.in)(me) = rule_rhs)
              aside = me.outside
              leaving(finished(me), me.answer)
            }
            rule_own := home.rules.keys.last
            rule_own.written_head = written
            // (one whose head holds `=>`, a rule that defines: read before the others)
            rule_own.defines = defines
            rule_own.named = !has_hole(written)
            rule_own.lone = (written.first == hole_opening) && ((level cw_enclosed (written)) === true)
            rule_own
          }
          // (a value read first, then what is read on it, `x.f`: what follows read by its members, or by its rules)
          [{value: concurrently node.prefix(.)}: node.keys, rest: (String | \n)[]] := (caller) => {
            v := value(caller)
            on := Node(in: caller.in, of: v)
            o := ((level kind_of (v)) === None) ? v : named_in(Program(in: kinds_of(caller)), level kind_of (v))
            (o.rules === None) ? members(o).for((m) => on.rules[[m.key]] := (c) => m.value) : (on.parts = [o])
            // (only space after it: nothing read on it)
            r := ((level cw_trimmed (rest)).length == 0) ? None : (rs: Statements(on) = rest)
            (r === None) ? unsplit(caller, text(rest.from - value.length, rest.to), split_key) : run_by(r, Program(caller: caller, in: on, this: v, receiver: v, outside: caller.outside))
          }
        }
        // (what it is made of, read after its own rules)
        parts := Array.new
        maker_key := rules.keys.first
        split_key := rules.keys.last
        // (a head: each hole a place in the node, read as what applies it reads it; one a rule running took, what it took)
        head_of (text, by) => (text as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => hole_head(hole.inside, by))
        // (a hole quoting a text, `{`=>`}`: that text, literally)
        hole_head (inside, by) => (((inside.length > 1) && (inside.first == inside.last)) && !is_word(inside.first)) ? quoted(level cw_inner (inside)) : taken_head(inside, by)
        taken_head (inside, by) => (binder(by, inside) === None) ? named_in(Program(in: node), inside) : head_of(taken_in(binder(by, inside), inside).value, binder(by, inside).caller)
        // (a body: the code inside its brackets; one hole a rule running took, what it took)
        body_of (text, by) => (splicer(text, by) === None) ? braced(text) : body_of(spliced(text, splicer(text, by)).value, splicer(text, by).caller)
        braced (text) => ((text as BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (code: Code))) === None) ? text : (text as BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (code: Code))).code
        written_of (text, by) => (splicer(text, by) === None) ? text : written_of(spliced(text, splicer(text, by)).value, splicer(text, by).caller)
        writer_of (text, by) => (splicer(text, by) === None) ? by : writer_of(spliced(text, splicer(text, by)).value, splicer(text, by).caller)
        home_of (text, by, here) => (splicer(text, by) === None) ? here : home_of(spliced(text, splicer(text, by)).value, splicer(text, by).caller, splicer(text, by).caller.in)
        // (the longest of its rules that reads the text, else what it is in reads it)
        // (a definition: the latest rule that defines that reads it; else the longest of its rules that reads it, else what it is in reads it)
        reading (text) => split_or(text, ((makes && defines(text)) && (text ~= maker_key)) ? (defining(text) ?? maker_key) : longest(text))
        // (the split, when it reads more of the text than what was found)
        split_or (text, found) => ((found === maker_key) || (text == found?.key) || set_aside(split_key) || !(text ~= split_key) || (!(found === None) && !(split_key.length > ((text ~= found) ? found.length : 0)))) ? found : split_key
        // (a rule that is one hole, `{written}`, would read anything: kept under its text, not read)
        // (a name read at its start, `x` of `x = v`, when what it is in reads it all: that)
        prefix (text) => nearer(text, own_longest(text) ?? parts_prefix(parts, text))
        nearer (text, near) => (near === None) ? in?.prefix(text) : (((near.named === true) && !(text == near.key)) ? fuller(text, near, in?.prefix(text)) : near)
        fuller (text, near, far) => (text == far?.key) ? far : near
        parts_prefix (ps, text) => ps.empty ? None : (ps.first.own_longest(text) ?? parts_prefix(ps.rest, text))
        own_longest (text) => longest_kept(text, makes, split_key, maker_key)
        longest_kept (text, m, sk, mk) => rules.keys{!((. === sk) || (. === mk) || (m && .defines) || .lone) && (text ~= .) && !set_aside(.)}#.sort(.length).last
        // (a node whose rules begin with the one that makes rules: a language's, where a definition is read first)
        makes => rules.keys.first === maker_key
        defining (text) => rules.keys{!set_aside(.) && .defines && (text ~= .)}#.sort(.length).last ?? in?.defining(text)
        longest (text) => prefix(text)
        own_keys => parts.empty ? rules.keys : rules.keys.joined(parts.first.own_keys)
        keys => (in === None) ? own_keys : own_keys.joined(in.keys)
        // (a text read here: its statements in turn, what they answered; nothing read, the place it names)
        // (one of more lines, its statements run in turn as they are read)
        named_as (text, by) => (level holds_text (text) (line_end)) ? apart(by, () => turned(node, text, by)) : named_once(text, by)
        named_once (text, by) => {
          v := (vs: Statements(node) = text)
          (v === None) ? Place(text, node) : apart(by, () => v(by))
        }
      }
      // A program running: what applied it, where it is.
      Program := class (caller?: Program, at?: Statement, in?: Node, this?: Node, for_value?: Node, receiver?: Node, outside?: Array) => { }
      Argument := class (\s+, word: String) => { }
      global := Node({
        rules[`external`, \s+, rule: String, args: Argument[]] := (caller) => {
          `.` (made_of) => (made_of.first === None) ? (caller.this = (caller.in = composed(caller.in, made_on(Node(in: caller.in), caller)))) : composed(value_read_in(caller.in), made_of.first)
          `&` => caller
          `goto` (to) => (caller.at = to.first) if (to.rest.empty || to.rest.first)
          `label` (to) => to.first
          `style` (how) => shown_by(how, caller)
          `rule` (head) => rule_written(caller.in, head.first)
          `include` (file) => ((level file_named (file.first.first)) === None) ? None : named_in(file.first.last, level file_named (file.first.first))
          `member` (asked) => asked.rest.rest.empty ? member_read(caller, asked.first, asked.last) : member_put(asked.first, asked.rest.first, asked.last)
          `shown` (how) => (how.first === None) ? how.last : ((((level kind_of (how.first)) === None) ? (how.first).shown_as : None) ?? how.last)
        }[rule](args.map((argument) => given(caller, rule, argument, args.first)))
      })
      // (a style: a rule keeps it, painted each time it is applied; anything else painted where it is read, and shown as it)
      shown_by (how, program) => {
        (how.last.written_head === None) ? painted.append([how.first, how.last, bound_along(program)]) : styled(how.last, how.first)
        ((how.last).shown_as = how.first) if (level kind_of (how.last)) === None
        how.last
      }
      // (a node made where a method was read on a value: made of that value, its receiver)
      made_on (made, program) => {
        (made.parts = [program.receiver]) if !((program.receiver === None) || (program.receiver.rules === None))
        program.receiver = None
        made
      }
      // (a node made of another too, never of what is made of it)
      composed (into, part) => {
        (into.parts = [part].joined(into.parts)) if !((part.rules === None) || ((into.rules === None) || made_of_deep(part, into)))
        part
      }
      made_of_deep (part, whole) => (part === whole) || parts_reach(part.parts, whole)
      parts_reach (ps, whole) => ps.empty ? false : (made_of_deep(ps.first, whole) || parts_reach(ps.rest, whole))
      member_read (program, holder, name) => ((holder === None) || (holder.rules === None) || (name === None)) ? None : member_found(program, holder, holder.longest(name))
      member_found (program, holder, found) => (found === None) ? None : found.value(Program(caller: program, in: holder, this: holder, receiver: holder, outside: program.outside))
      member_put (holder, name, value) => {
        holder.rules[[name]] := (c) => value
        value
      }
      // Statements: each, after any space, read by the longest rule that reads it; run in order as it is read, each given
      // what applies them.
      Statement := class (
        leading_whitespace?: (\s | \n)[]+,
        {statement: concurrently context.reading(.)}: context.keys,
        trailing_whitespace?: (\s | \n)[]+
      ) => {}
      Statements (context: Node) => dynamically Statement[] & (caller: Program) => (
        context.statements = .
        arrived(caller, listed(.))
      )
      listed (read) => read.map((s) => s.statement)
      // (a text read by a program, run apart from its own statements)
      apart (program, inner) => {
        was := [program.done, program.waiting, program.answer]
        program.done = None
        program.waiting = None
        r := inner()
        program.done = was.first
        program.waiting = was.rest.first
        program.answer = was.last
        r
      }
      turned (place, text, program) => {
        (rs: Statements(place)(program) = text)
        program.answer
      }
      // (each in turn, as it is read: run, but while a jump waits for a label not read yet; a jump back goes on after its
      // label among those read)
      arrived (program, read) => {
        read.for((s) => arrive(program, s))
        program.answer
      }
      arrive (program, statement) => {
        program.done = (program.done ?? Array.new).append(statement)
        (program.at === None) ? go(program, [statement]) : waits(program, statement)
      }
      waits (program, statement) => (!(program.at == afterwards) && label_is(program, statement)) ? go(gone_on(program), [statement]) : kept(program, statement)
      kept (program, statement) => program.waiting = (program.waiting ?? Array.new).append(statement)
      go (program, read) => {
        rounds := [read]
        rounds.for((r) => rounds.append(settled(ran(program, r))) if !(rounds.last === None))
        program
      }
      ran (program, round) => {
        program.waiting = None
        round.for((s) => (program.at === None) ? runs(program, s) : kept(program, s))
        program
      }
      // (a label or a jump answers nothing: the body answers what was answered before it)
      runs (program, statement) => {
        before := program.answer
        inside := aside
        aside = program.outside ?? aside
        a := statement(program)
        aside = inside
        program.answer = ((statement.rule == `label`) || (statement.rule == `goto`)) ? before : a
        program
      }
      // (a jump: to its label among those read; to `afterwards`, kept for when everything is read; to `report`, said)
      settled (program) => {
        (level kept_later (program)) if (program.at == afterwards)
        said(program) if (program.at == report)
        to := (program.at === None) ? program.waiting : labelled(program, program.done)
        gone_on(program) if !((program.at === None) || (to === None))
        to
      }
      gone_on (program) => {
        forget(program)
        program.at = None
        program
      }
      labelled (program, read) => read.empty ? None : (label_is(program, read.first) ? read.rest : labelled(program, read.rest))
      label_is (program, statement) => (statement.rule == `label`) && (label_of(Program(in: program.in), statement.args.first.word) == program.at)
      // (what waits goes on when the rule ends; kept for afterwards, it waits for then)
      finished (program) => ((program.waiting === None) || (program.at == afterwards)) ? program : go(gone_on(program), program.waiting)
      leaving (program, answer) => {
        (program.caller.at = program.at) if !((program.at === None) || (program.at == afterwards))
        answer
      }
      // (what the host is given, `external <rule> <arguments…>`: each argument read where it is written, but a label, its word)
      given (program, name, argument, first) => (((name == `goto`) || (name == `label`)) && (argument === first)) ? label_of(program, argument.word) : ((name == `include`) ? written_where(argument.word, program) : named_in(program, argument.word))
      // (a text as it was first written, followed out through the holes that took it: it, and the program it is written in)
      written_where (text, by) => (splicer(level cw_trimmed (text), by) === None) ? [level cw_trimmed (text), by] : written_where(spliced(level cw_trimmed (text), splicer(level cw_trimmed (text), by)).value, splicer(level cw_trimmed (text), by).caller)
      label_of (program, word) => Place(word, global)
      afterwards := Place(`afterwards`, global)
      report := Place(`report`, global)
      // (what jumped to afterwards, run once everything is read, and what that kept, in turn)
      // (each run by the host in memory and a budget of its own, Design §21.4)
      run_later (unused) => level run_kept (ran_later) (tested_later)
      tested_later (program) => level tested_here ((program.bound.first).value)
      ran_later (program) => {
        testing = program
        finished(go(gone_on(program), program.waiting ?? Array.new))
        testing = None
      }
      testing := None
      // (what the host reads: what is painted, `external style`, and said, `external goto report`)
      painted => level paints
      reported => level reports
      said (program) => {
        reported.append([program.bound.first, Array.new])
        program.at = None
        (testing.at = Place(`erred`, global)) if !(testing === None)
      }
      // (a hole's value, read once in what applied it; a jump back forgets it)
      // (who reads a hole: the program reading it once it entered a block, else what applied the rule; one that took a hole
      // of what applied it, `{x}`, is read there)
      reader (program, otherwise) => ((program.in === None) || !(program.in === program.this)) ? otherwise : program
      // (a hole's text read with what was set aside where it was written)
      read_outside (outside, read) => {
        was := aside
        aside = outside ?? aside
        r := read()
        aside = was
        r
      }
      held (hole, answer) => ((hole.answered === None) ? (hole.answered = [answer()]) : hole.answered).first
      forget (program) => (program.bound ?? Array.new).for((fh) => fh.answered = None)
      bound_along (program) => (program === None) ? Array.new : [program.bound].joined(bound_along(program.caller))
      rule_written (place, text) => ((place === None) || (text === None)) ? None : (place.rules.keys{.written_head == text}#.last ?? rule_written(place.in, text))
      // (a node a value is read on in, `x.( … )`: what it defines is that value's)
      value_read_in (place) => ((place === None) || (place.of === None) || (place.of.rules === None)) ? place : place.of
      // (where a program defines: in the value it reads code for, `x.( … )`, else where it is)
      place_of (program) => ((program.for_value === None) || (program.for_value.rules === None)) ? value_read_in(program.in) : program.for_value
      // (a hole read for code read in a value, `x.( … )`: read where it is written, what it defines the value's)
      named_for (program, by, text) => in_value(by, text, (((program.in === None) || (program.in.of === None)) || (by.in === program.in)) ? ((by.in === None) ? None : by.in.of) : program.in.of)
      in_value (program, text, held_value) => (held_value === None) ? named_in(program, text) : for_value(program, held_value, text)
      for_value (program, held_value, text) => {
        was := program.for_value
        program.for_value = held_value
        r := named_in(program, text)
        program.for_value = was
        r
      }
      between (text) => level cw_trimmed (level cw_inner (text))
      has_hole (text) => level holds_text (text) (hole_opening)
      defined_in (place, text) => (place === None) ? None : ((place.rules.keys{.written_head == text}#.count > 0) ? place : defined_in(place.in, text))
      trimmed_or (text, otherwise) => (text.length == 0) ? otherwise : text
      // (one line trimmed; lines kept as written, each statement as deep as its line)
      named_in (program, text) => program.in.named_as((level holds_text (text) (line_end)) ? text : trimmed_or(level cw_trimmed (text), text), program)
      run_by (code, program) => {
        code(program)
        leaving(finished(program), program.answer)
      }
      // (a text read with the split set aside)
      unsplit (program, whole_text, split) => {
        was := aside
        aside = [split].joined(aside)
        r := named_in(program, whole_text)
        aside = was
        r
      }
      kinds := Array.new
      kinds_of (program) => kinds.first ?? known(named_in(program, `level kinds`))
      known (kind) => (kind.rules === None) ? kind : kinds.append(kind).first
      // (a text that is one hole, of those a program took: that hole)
      spliced (text, by) => ((text as BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (code: Code))) === None) ? None : taken_in(by, (text as BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (code: Code))).code)
      splicer (text, by) => ((text as BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (code: Code))) === None) ? None : binder(by, (text as BOOTSTRAPPER.CAPTURE.map{== \s}((space) => (code: Code))).code)
      // (the rule running that took the hole: this program, or what applies it while it is no rule's own, a statement's)
      binder (program, name) => (taken_in(program, name) === None) ? (((program === None) || !(program.bound === None)) ? None : binder(program.caller, name)) : program
      taken_in (program, name) => ((program === None) || (program.bound === None)) ? None : program.bound{.key == name}#.first
      aside := Array.new
      hole_opening := BOOTSTRAPPER.CAPTURE.first
      line_end := `
`
      separator := level separator_of (BOOTSTRAPPER.CAPTURES.text) (BOOTSTRAPPER.CAPTURE)
      defines (text) => level holds_outside (text) (separator)
      // (a byte of a name)
      is_word (c) => holds(`abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_`, c)
      holds (t, c) => t.empty ? false : ((t.first == c) || holds(t.rest, c))
      // (a head quoting `=>`, a rule that defines: noted as its head is read)
      quoted (t) => t
      // (a rule shown in a style: each time it is applied, where its head reads)
      styled (rule, style) => {
        rule.styled_as = (rule.styled_as ?? Array.new).append(style)
        rule
      }
      set_aside (key) => aside_in(aside, key)
      aside_in (list, key) => list.empty ? false : ((list.first === key) || aside_in(list.rest, key))
      level closing (BOOTSTRAPPER.CAPTURE)
      top := Program(in: global, this: global, outside: Array.new)
      // (the compiler's parser: a grammar's rules read in a node of their own, a word what nothing else there reads)
      parse_node_of (grammar_text) => {
        g := Node(in: global)
        (gs: Statements(g) = grammar_text)(Program(in: g, outside: Array.new))
        p := Node()
        level moved_keys (g) (p)
        leaf := Node(in: global)
        (ls: Statements(leaf) = `{name_word} => external &`)(Program(in: leaf, outside: Array.new))
        p.split_key = leaf.rules.keys.last
        p
      }
      parser (grammar, program_text) => {
        grammar.parse_node = grammar.parse_node ?? parse_node_of(grammar.text)
        level curried_value (ps: Statements(grammar.parse_node) = program_text)
      }
      level set_parser (parser)
      (Statements(global)(top), (\s | \n)[], (⊣ & ((end) => run_later(0)))(0))
    )
  )
) => { }
ex := (level input_part 0) as Expression
assert "!language   { }   {LHS} => {RHS}\n\n" as Expression -- .(
  .BOOTSTRAPPER.CAPTURE == `{ }`
  & .BOOTSTRAPPER.CAPTURES.LHS == `{LHS}`
  & .BOOTSTRAPPER.CAPTURES.RHS == `{RHS}`
)
// (its parts, each in turn)
assert {
  Ranged2 := class low: Decimal, "-", high: Decimal { }
  ranged2: Ranged2 = 3-8
  assert ranged2.high == 8  // ZZ1
  assert (`2-7` as Ranged2).high == 7  // ZZ2
  Ranged3 := class (low: Decimal, "-", high: Decimal) => { }
  ranged3: Ranged3 = 3-8
  assert ranged3.high == 8  // ZZ3
  Ranged4 := class (low: String+, "-", high: String+) => { }
  ranged4: Ranged4 = 3-8
  assert ranged4.high == "8"  // ZZ4
  Ranged5 := class (low: String+, `-`, high: String+) => { }
  ranged5: Ranged5 = 3-8
  assert ranged5.high == `8`  // ZZ5
  assert (`3-8` as Ranged5).high == `8`  // ZZ6
  Ranged6 := class (low: String+, \s, high: String+) => { }
  assert (`3 8` as Ranged6).high == `8`  // ZZ7
}
assert `{ }` is (String+, \s, String+)  // EX1 a hole's brackets around a space are not a capture
assert {
  Headed := class (head: `!language`, \s[]+, rest: String) => { }
  assert (`!language  x` as Headed).rest == `x`  // EX2 a text read as a structure does not give its last field what follows the space
}
assert {
  Captured := class (left: String+, \s, right: String+) => { }
  assert (`{ }` as Captured).left == `{`  // EX3 a text read as a structure does not give its first field the text before the space
}
assert {
  Inner := class (left: String+, \s, right: String+) => { }
  Outer := class (inner: Inner, `;`) => { }
  assert (`{ };` as Outer).inner.left == `{`  // EX4 a field of a structure is not read as its own structure
}
assert {
  Nested := class (inner: (left: String+, \s, right: String+), `;`) => { }
  assert (`{ };` as Nested).inner.right == `}`  // EX5 a field written as a structure is not read as one
}
assert {
  Spanned := class (spanned: (String+, \s, String+), `;`) => { }
  assert (`{ };` as Spanned).spanned == `{ }`  // EX6 a field written as positions does not take their span
}
assert `{LHS}` is `{ }`.map{== \s}(`LHS`)  // EX7 a text's space mapped to LHS does not read {LHS}
assert !(`{ }` is `{ }`.map{== \s}(`LHS`))  // EX9 a text's space mapped to LHS still reads the space
assert {
  Dependent := class (open: String, \s, close: open) => { }
  assert (`a a` as Dependent).close == `a`  // EX8 a field's type does not see a field before it
}
assert {
  Scoped := class (
    (
      statements: (
        Seen := 46
        Node := class (marked?: Node) => { mark := 1 }
        Inner := class (in?: Inner) => {
          rules := { got := (x) => Seen }
          made => Node()
        }
        got_seen := Inner().rules.got(0)
        made_mark := Inner().made.mark
        String
      )
    )
  ) => { }
  scoped := "x" as Scoped
  assert (external member (scoped) (`got_seen`)) == 46  // EX10 a closure in a class written in a header's statements does not see the header's names
  assert (external member (scoped) (`made_mark`)) == 1  // EX11 a class's `Node` written in a header's statements is the language's
}
// Runtime: what a program runs on, whatever runs it: the kinds of value a run holds, how a name is found, how a call runs,
// how a text is read by a pattern and where a statement in it ends. Each kind is written as what it is made of, in order
// (its header): the back end lays it out so (one word each, the first its tag when it has one), and a function here reads
// and writes them by name. What is an optimization (fields indexed once a node holds many, what a call made let go when it
// returns, rules found by the text they lead with) is a level, after it, each removable; the back end is given it, and
// the levels, written for it (`$/Wasm.project.ray`'s `Lowering`).
Runtime := class {
  // The language's own values, as the back end holds them: nothing, false and true; a number, twice itself and one.
  static None := 0
  static false := 8
  static true := 12
  // (a yes or no of the back end's, as the language's; and whether a value is not nothing nor false)
  static boolean (c) => c ? true : false
  static truthy (v) => (v != None) && (v != false)
  static same (a, b) => Runtime.boolean(a === b)

  // A number, held as twice itself and one: apart from where any value of a kind is (an even word).
  static int (n) => (n + n) + 1
  static untag (v) => v >> 1
  static plus (a, b) => (a + b) - 1
  static minus (a, b) => (a - b) + 1
  static times (a, b) => Runtime.int(Runtime.untag(a) * Runtime.untag(b))
  static quotient (a, b) => Runtime.int(Runtime.untag(a) / Runtime.untag(b))
  static remainder (a, b) => Runtime.int(Runtime.untag(a) % Runtime.untag(b))
  static less (a, b) => Runtime.boolean(a < b)
  static greater (a, b) => Runtime.boolean(a > b)
  static less_equal (a, b) => Runtime.boolean(a <= b)
  static greater_equal (a, b) => Runtime.boolean(a >= b)

  // A node: what it is in, which is asked what it does not hold; its fields, the latest first; its keys, in the order
  // given; and its fields indexed by name, once it holds many.
  static Node := (1, in: Node, fields: Field, keys: List, index)
  static Field := (next: Field, name, value)
  // (the field of a name: its own, or what it is in has; none anywhere, nothing. What it holds by a name is its own field
  // of it, `own`)
  static found (node: Node, name) => (node === None) ? None : Runtime.found_in(own(node, name), node, name)
  static found_in (field: Field, node: Node, name) => (field === None) ? Runtime.found(node.in, name) : field
  static lookup (node: Node, name) => Runtime.value_of(Runtime.found(node, name))
  static value_of (field: Field) => (field === None) ? None : field.value
  // (a name given a value in the node itself: a field of it added, the latest, unless it has one; or where it is found,
  // else in the node)
  static define (node: Node, name, value) => Runtime.defined(own(node, name), node, name, value)
  static defined (field: Field, node: Node, name, value) => (field === None) ? Runtime.added(Field(next: node.fields, name: name, value: value), node) : Runtime.given(field, value)
  static added (field: Field, node: Node) => {
    node.fields = field
    field.value
  }
  static given (field: Field, value) => (field.value === value) ? value : Runtime.given_again(field, value)
  static given_again (field: Field, value) => {
    field.value = value
    value
  }
  static assign (node: Node, name, value) => Runtime.assigned(Runtime.found(node, name), node, name, value)
  static assigned (field: Field, node: Node, name, value) => (field === None) ? Runtime.define(node, name, value) : Runtime.given(field, value)

  // A list: how many it holds, how many it has room for, and what it holds, one word each.
  static List := (3, count, room, items: Words)
  static list => List()
  static at (list: List, index) => list.items[index]
  static append (list: List, value) => {
    Runtime.room_made(list, Words(Runtime.more_room(list.room)), Runtime.more_room(list.room)) if list.count == list.room
    list.items[list.count] = value
    list.count = list.count + 1
    list
  }
  // (room for twice as many, at least four, what it holds moved there)
  static more_room (room) => (room == 0) ? 4 : (room * 2)
  static room_made (list: List, items: Words, room) => {
    Runtime.moved(items, list.items, list.count)
    list.items = items
    list.room = room
  }
  // (lists of lists: all but the first, one after another, each given to a function, what it answers of each, a member
  // of each, sorted by what it answers (equal ones kept in order))
  static joined (a, b) => Runtime.appended_from(Runtime.appended_from(list(), a, 0), b, 0)
  static appended_from (o: List, l: List, from) => {
    i := from
    while i < l.count {
      append(o, l.items[i])
      i = i + 1
    }
    o
  }
  static each (l: List, f) => {
    i := 0
    while i < l.count {
      call1(f, l.items[i])
      i = i + 1
    }
    l
  }
  static each_value (l: List, f) => {
    o := list()
    i := 0
    while i < l.count {
      append(o, call1(f, l.items[i]))
      i = i + 1
    }
    o
  }
  static mapped (l: List, name) => {
    o := list()
    i := 0
    while i < l.count {
      append(o, member(l.items[i], name))
      i = i + 1
    }
    o
  }
  static sorted (l, f) => Runtime.sorted_in(Runtime.appended_from(list(), l, 0), f)
  static sorted_in (o: List, f) => {
    i := 1
    while i < o.count {
      Runtime.inserted(o, f, o.items[i], call1(f, o.items[i]), i - 1)
      i = i + 1
    }
    o
  }
  static inserted (o: List, f, x, kx, from) => {
    j := from
    while (j >= 0) && (call1(f, o.items[j]) > kx) {
      o.items[j + 1] = o.items[j]
      j = j - 1
    }
    o.items[j + 1] = x
  }
  static moved (to: Words, from: Words, count) => {
    i := 0
    while i < count {
      to[i] = from[i]
      i = i + 1
    }
  }

  // A function as a value: what it runs, the node it was written in, and how it is called (0 as it is, 1 read as a value:
  // a getter); a class, the same, its header in place of how it is called.
  static Closure := (2, function, env, called)
  static closure (f, env) => Closure(function: f, env: env)
  static getter (f, env) => Closure(function: f, env: env, called: 1)
  static Class := (5, function, env, header)
  static classh (f, env, h) => Class(function: f, env: env, header: h)

  // A text: where it starts in what a run holds, and where it ends.
  static Text := (4, from, to)
  static text (a, e) => Text(from: a, to: e)

  // A pattern: what a text is read as. How, its kind says, what with, its parts: a literal (its text), characters (the
  // text of those it takes), a sequence or an either (the list of what is read in turn, or of what is tried in turn),
  // a repeat (what is repeated, and the least number of times), a field (its name, and what it takes), the end of the
  // text, anything.
  static literally := 1
  static characters := 2
  static in_sequence := 3
  static either_of := 4
  static repeating := 5
  static named_field := 6
  static at_end := 7
  static anything_at_all := 8
  // (and, of what reading notes as it goes: the rest of a sequence, from where; a repeat, chosen again; a field read up to
  // here; the rules of a node, read; a class header; what a class constructs, and what an application makes, of what
  // was read; a statement, read; a value read again as a pattern; a pattern read by a function, and its value given it;
  // a repeat's next; the holes read, as a list; the end of a statement; read by a function, with or without a value
  // given; any text, up to a byte)
  static rest_from := 9
  static repeat_from := 10
  static field_end := 11
  static rules_of := 12
  static class_header := 13
  static constructed := 14
  static applied := 15
  static with_function := 16
  static typed_by := 17
  static reread := 18
  static functioned := 19
  static function_given := 20
  static repeat_next := 21
  static holes_listed := 22
  static statement_ending := 23
  static typed_with := 27
  static hole := 28
  static Pattern := (6, kind, a, b, c, d)
  static pattern (kind, a, b) => Pattern(kind: kind, a: a, b: b)
  static literal (t) => Pattern(kind: literally, a: t)
  static chars (c) => Pattern(kind: characters, a: c)
  static sequence (l) => Pattern(kind: in_sequence, a: l)
  static either (l) => Pattern(kind: either_of, a: l)
  // (repeated any number of times: of a repeat, the same; of what a repeat is of, at least as many times as it says)
  static repeated (inner: Pattern, least) => ((least == 0) && (inner is Pattern) && (inner.kind == repeating)) ? Pattern(kind: repeating, a: inner.a) : Pattern(kind: repeating, a: inner, b: least)
  static field (name, inner) => Pattern(kind: named_field, a: name, b: inner)
  static ending => Pattern(kind: at_end)
  static anything => Pattern(kind: anything_at_all)
  static greedy (inner: Pattern, least) => ((least == 0) && (inner is Pattern) && (inner.kind == repeating)) ? Pattern(kind: repeating, a: inner.a, c: 1) : Pattern(kind: repeating, a: inner, b: least, c: 1)
  static dynamic (f) => Pattern(kind: rules_of, a: f)
  static conj (p, f) => Pattern(kind: with_function, a: p, b: f)

  // Where a statement ends. The text read is the run's (up to its `textend`), a byte of it at a time (the back end's
  // `byte`); a byte is of a class (the back end's `char_class`): 2 a quote, 3 a closing bracket. A statement read from
  // pos ends, read on from at, at the end of the first line after which the next one, not blank, is indented no deeper
  // than the statement's first line, starts with no closing bracket, does not follow a line ending with a comma, and
  // leaves no quote open; else at the end of the text.
  static statement_end (pos, at) => Runtime.ended_from(at, Runtime.line_end(at), Runtime.indent_at(Runtime.line_start(pos, at)))
  static ended_from (at, from, depth) => {
    q := from
    while q < textend {
      return q if Runtime.ends_there(at, q, depth, Runtime.indent_at(q + 1))
      q = Runtime.line_end(q + 1)
    }
    textend
  }
  static ends_there (at, q, depth, indent) => Runtime.ends_before(at, q, Runtime.byte_or_line(q + 1 + indent), (indent <= depth))
  static ends_before (at, q, c, shallow) => (c != 10) && shallow && (char_class(c) != 3) && (comma_ended(at, q) == 0) && (Runtime.quote_open(at, q) == 0)
  static byte_or_line (q) => (q < textend) ? byte(q) : 10
  static line_start (pos, from) => {
    q := from
    while (q > pos) && (byte(q - 1) != 10) {
      q = q - 1
    }
    q
  }
  static line_end (from) => {
    q := from
    while (q < textend) && (byte(q) != 10) {
      q = q + 1
    }
    q
  }
  static indent_at (from) => {
    d := 0
    while ((from + d) < textend) && ((byte(from + d) == 32) || (byte(from + d) == 9)) {
      d = d + 1
    }
    d
  }
  static white_after (from) => {
    q := from
    while (q < textend) && white(byte(q)) {
      q = q + 1
    }
    q
  }
  // (whether a quote opened from a is not closed before n)
  static quote_open (a, n) => {
    q := a
    while q < n {
      return 1 if Runtime.opens_quote(q) && ((pair_end(q) == 0) || (pair_end(q) > n))
      q = Runtime.opens_quote(q) ? pair_end(q) : (q + 1)
    }
    0
  }
  static opens_quote (q) => (char_class(byte(q)) == 2) && (pair_class(q) == 2)
  // (whether the line through n goes on past its end: it ends with a comma, or the next line, not blank, is indented
  // deeper or starts with a closing bracket)
  static continued_at (n) => Runtime.continued_after(Runtime.text_line_start(n), n, Runtime.indent_at(n + 1))
  static continued_after (q, n, j) => (comma_ended(q, n) != 0) || (((n + (1 + j)) < textend) && (byte(n + (1 + j)) != 10) && ((j > Runtime.indent_at(q)) || (char_class(byte(n + (1 + j))) == 3)))
  static text_line_start (from) => {
    q := from
    while (q > 0) && (byte(q - 1) != 10) && (byte(q - 1) != 0) {
      q = q - 1
    }
    q
  }
  static comma_ended (a, from) => {
    n := from
    while (n > a) && white(byte(n - 1)) {
      n = n - 1
    }
    (n > a) && (byte(n - 1) == 44)
  }

  // Pairs: what a bracket or a quote opens, and where it is closed. A byte's class (1 an opening bracket, 2 a quote, 3 a
  // closing one) holds unless an odd number of backslashes before it escapes it. Where a pair ends is kept by the back
  // end once found (`pair_end`); found, a quote ends at the next of its byte not escaped, a bracket where as many have
  // closed as opened in it, what is quoted in it passed over; never, at 0.
  static pair_class (q) => ((char_class(byte(q)) == 0) || ((Runtime.backslashes(q) % 2) == 1)) ? 0 : char_class(byte(q))
  static backslashes (q) => {
    n := 0
    while (q > (n + 1)) && (byte((q - n) - 1) == 92) {
      n = n + 1
    }
    n
  }
  static quote_ending (q, c) => {
    x := q + 1
    while x < textend {
      return x + 1 if byte(x) == c
      x = (byte(x) == 92) ? (x + 2) : (x + 1)
    }
    0
  }
  static bracket_ending (q) => {
    depth := 0
    x := q
    while x < textend {
      return 0 if (Runtime.class_at(x) == 2) && (pair_end(x) == 0)
      depth = depth + Runtime.opened(Runtime.class_at(x))
      return x + 1 if (Runtime.class_at(x) == 3) && (depth == 0)
      x = (Runtime.class_at(x) == 2) ? pair_end(x) : (x + 1)
    }
    0
  }
  static class_at (x) => (char_class(byte(x)) == 0) ? 0 : pair_class(x)
  static opened (t) => (t == 1) ? 1 : ((t == 3) ? (0 - 1) : 0)
  // (where a string read up to n ends: in a pair opened just before n, where it closes; just after one closed, never)

  // Reading: a pattern read from a place in the text, then what is still to read after it (a cell of a pattern to read,
  // or the rest of a sequence, from where), answering where the whole reading ended, or −1. Where there is a choice (of
  // an either, how many times a repeat goes, how far a hole or anything reads), each way is read on in turn, nearest
  // first, and the first to answer is the answer: going back is returning. Before each way, what was bound, which rules
  // were being read, and the memory taken are as they were (what was taken let go, unless something was written
  // meanwhile); what a binding wrote over is put back when what follows it does not read.
  static Cell := (what, next)
  static Rest := (list, next, index)
  static Bound := (aside, hole, start, end, held)
  static matched (pattern, from, then) => {
    fueled()
    return 0 - 1 if stopped()
    was_start := rstart
    om := markf
    fr := free
    ef := effects
    an := activen
    bn := boundn
    rstart = from
    markf = free
    result := Runtime.pattern_read(pattern, from, then)
    rstart = was_start
    activen = an
    markf = om
    Runtime.unbound(bn, fr, ef) if result < 0
    result
  }
  // (failed: what it bound left out, and, when nothing was written meanwhile, the memory it took)
  static unbound (bn, fr, ef) => {
    boundn = bn
    Runtime.left_alone(fr) if (effects == ef)
  }
  static left_alone (fr) => {
    starts_cleared(fr, free)
    freed_back(fr)
  }
  // (a way tried again: as it was when the choice began)
  static ways_retried (bn, an, fr, ef) => {
    boundn = bn
    activen = an
    freed_back(fr) if (free > fr) && (effects == ef)
    markf = fr
    0
  }
  // (read on: done when nothing follows; else what follows, and after it what follows that)
  static onward (k: Cell, at) => (k === None) ? at : ((k.what is List) ? Runtime.rest_read(k, at) : Runtime.pattern_read(k.what, at, k.next))
  static rest_read (k: Rest, at) => Runtime.items_read(k.list, k.index, at, k.next)
  static items_read (l: List, i, at, k) => (i >= l.count) ? Runtime.onward(k, at) : Runtime.pattern_read(l.items[i], at, ((i + 1) < l.count) ? Rest(list: l, next: k, index: i + 1) : k)

  // (a pattern read: what its kind reads; read as a pattern if it is not one)
  static pattern_read (p, at, k) => Runtime.kind_read((p is Pattern) ? p : topattern(p), at, k)
  static kind_read (p: Pattern, at, k) => (p.kind == rest_from) ? Runtime.items_read(p.a, p.b, at, k) : ((p.kind == literally) ? Runtime.literal_read(p.a, at, k) : ((p.kind == characters) ? (((at < textend) && chared(byte(at), p.a) && ((p.a != 4) || continued_at(at))) ? Runtime.onward(k, at + 1) : (0 - 1)) : ((p.kind == in_sequence) ? Runtime.items_read(p.a, 0, at, k) : ((p.kind == either_of) ? Runtime.either_from(p.a, at, k) : ((p.kind == hole) ? Runtime.hole_ways(p, at, k) : ((p.kind == anything_at_all) ? Runtime.anything_from(at + 1, k) : ((p.kind == repeat_from) ? Runtime.repeat_read(p.a, p.b, p.c, at, k) : ((p.kind == repeat_next) ? ((at == p.c) ? ((p.b <= 0) ? Runtime.onward(k, at) : (0 - 1)) : Runtime.repeat_read(p.a, p.b, p.d, at, k)) : ((p.kind == repeating) ? Runtime.repeat_read(p.a, p.b, p.c, at, Cell(what: Pattern(kind: holes_listed, a: boundn), next: k)) : ((p.kind == named_field) ? Runtime.pattern_read(p.b, at, Cell(what: Pattern(kind: field_end, a: p.a, b: at, c: boundn, d: p.b), next: k)) : ((p.kind == field_end) ? Runtime.field_closed(p, at, k, boundn, saved(p.c)) : ((p.kind == holes_listed) ? Runtime.holes_closed(p.a, at, k, saved(p.a), boundn) : ((p.kind == constructed) ? Runtime.value_bound(p.b, saved(p.b), boundn, construct(p.a, list(), named_from(p.b)), at, k) : ((p.kind == applied) ? Runtime.value_bound(p.b, saved(p.b), boundn, Runtime.defined_as(Runtime.application_of(p.a, p.b, member(p.a, Symbol.value)), 47, text(p.c, at)), at, k) : ((p.kind == rules_of) ? ((reading_at(p, at) == 0) ? Runtime.rules_read(p, at, k) : (0 - 1)) : ((p.kind == class_header) ? ((reading_at(p.a, at) == 0) ? Runtime.header_read(p, at, k) : (0 - 1)) : ((p.kind == with_function) ? Runtime.pattern_read(Runtime.with_pattern(p.a), at, k) : ((p.kind == reread) ? Runtime.pattern_read(rebuilt(p.a), at, k) : ((p.kind == functioned) ? Runtime.functioned_read(p, p.a, at, k) : ((p.kind == function_given) ? Runtime.function_read(p, saved(p.c), boundn, valued_from(p.c), at, k) : ((p.kind == statement_ending) ? ((p.b == 2) ? Runtime.statement_marked(k, at) : (((at == textend) || ((byte(at) == 10) && (open_before(rstart, at) == 0) && ((continued_from((p.b == 1) ? p.a : rstart, at) == 0) || (continued_from(at, at) == 0)))) ? Runtime.onward(k, at) : (0 - 1))) : ((p.kind == typed_by) ? Runtime.pattern_read(topattern(call(p.a, append(list(), named_from(0)), 0)), at, k) : ((p.kind == at_end) ? ((at == textend) ? Runtime.onward(k, at) : (0 - 1)) : ((p.kind == typed_with) ? Runtime.pattern_read(topattern(call(p.a, append(list(), p.b), 0)), at, k) : (0 - 1)))))))))))))))))))))))))
  // (a literal, there: a bracket only where it pairs)
  static literal_read (t: Text, at, k) => Runtime.literal_of(t, t.to - t.from, at, k)
  static literal_of (t: Text, n, at, k) => (((at + n) <= textend) && texteq(at, t.from, n) && ((n == 0) || (char_class(byte(at)) == 0) || (pair_class(at) != 0))) ? Runtime.onward(k, at + n) : (0 - 1)
  // (an either: each of its ways in order; anything among them a byte, where no other way reads further)
  static either_from (l: List, at, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
    r := 0 - 1
    j := 0
    while (j < l.count) && (r < 0) {
      Runtime.ways_retried(bn, an, fr, ef)
      r = Runtime.either_one(l, j, at, k, l.items[j])
      j = j + 1
    }
    r
  }
  static either_one (l: List, j, at, k, c: Pattern) => (c.kind == anything_at_all) ? (((at < textend) && (read_by_another(l, j, at) == 0) && ((at + 1) > 0)) ? Runtime.onward(k, at + 1) : (0 - 1)) : Runtime.pattern_read(c, at, k)
  // (anything: a byte more at a time, not past a line's end)
  static anything_from (n0, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
    n := n0
    r := 0 - 1
    while (r < 0) && (n <= textend) && (byte(n - 1) != 10) {
      Runtime.ways_retried(bn, an, fr, ef)
      r = Runtime.onward(k, n)
      n = n + 1
    }
    r
  }
  // (a repeat: once more, or not; at least as many as it says; greedy, more first)
  static repeat_read (inner, least, greedy, at, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
    r := ((least <= 0) && (greedy == 0)) ? Runtime.onward(k, at) : (0 - 1)
    Runtime.ways_retried(bn, an, fr, ef) if r < 0
    r = (r < 0) ? Runtime.pattern_read(inner, at, Cell(what: Pattern(kind: repeat_next, a: inner, b: least - 1, c: at, d: greedy), next: k)) : r
    Runtime.ways_retried(bn, an, fr, ef) if r < 0
    r = ((r < 0) && (least <= 0) && (greedy != 0)) ? Runtime.onward(k, at) : r
    r
