// HMAC over SHA-1 and SHA-256 against RFC 2202 and RFC 4231 (https://www.rfc-editor.org/rfc/rfc2202, https://www.rfc-editor.org/rfc/rfc4231).

mark ^keyword := global

// Test case 2: key "Jefe", data "what do ya want for nothing?" (RFC 2202 §3, RFC 4231 §4.3)
unless HMAC(SHA1, key: "Jefe".bytes).write("what do ya want for nothing?".bytes).bytes as Hexadecimal₄₀ == "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79" { INFO@mark `HMAC1 HMAC-SHA-1 of RFC 2202's test case 2 is not effcdf6a…` }
unless HMAC(SHA256, key: "Jefe".bytes).write("what do ya want for nothing?".bytes).bytes as Hexadecimal₆₄ == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" { INFO@mark `HMAC2 HMAC-SHA-256 of RFC 4231's test case 2 is not 5bdcc146…` }
// A key longer than the block is hashed first (RFC 2104 §3)
unless HMAC(SHA256, key: [0xaa] * 131).padded == [SHA256.write([0xaa] * 131).bytes, [0] * 32].flatten { INFO@mark `HMAC3 a key longer than the block is not hashed and padded` }
unless SHA1.block == 64 && SHA256.block == 64 && SHA1.size == 20 && SHA256.size == 32 { INFO@mark `HMAC4 a digest does not give its block and output sizes in bytes` }
