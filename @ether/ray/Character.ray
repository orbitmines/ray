Entity := class {
  // A private key is a secret: readable by no one (W2.1 Storage), so no store, history or cache level writes it, and logging out drops it.
  none.read key: Encoding.Key?

  // The same principal as `other`: here, the same value; @ether/security compares verified roots instead.
  same (other) => this === other
  // an entity compared with itself and with another
  assert {
    e := Entity()
    assert e.same(e)  // CHR2 an entity is not the same as itself
    assert !e.same(Entity())  // CHR3 two different entities are the same
  }
  // Whether this principal answers for `who`, a principal named by a grant, a delegation or a registry, or any narrowing of principals.
  answers_for (who) => same(who) || this is who
  // an entity asked whether it answers for itself and for another
  assert {
    e := Entity()
    assert e.answers_for(e)  // CHR5 an entity does not answer for itself
    assert !e.answers_for(Entity())  // CHR6 an entity answers for another entity
  }
}

Nameable := class {
  static PREFIX: String?
  name: *?

  named (name): static => this ~~ .name |= name
  assert Nameable.named("Bob").name == "Bob"  // CHR7 naming does not give the name
  assert !(Nameable.named("Bob").name == "Alice")  // CHR8 naming gives another name
}

@me = {who} ^punctuation => &@.may(`@me =`, who) ? &.caller = (who is Character ? who.acting : who) : ERROR@Access `running as another character needs their grant`
// (a path under the character running: each name a member of what is before it, `@me/device/keyboard`)
@me/{path} ^string => Character.walked(@me, "{path}".split("/"))
@{who: (Char.Word | "-")[]} {{block}} ^keyword => with (@me = Character.local(who) ?? ERROR `a block runs as a character only when that character is here`) Program(code: block**)
@{who: (Char.Word | "-")[]}~{literal label ^label}{ }{{block}} ^keyword => (Character.local(who) ?? ERROR `a block runs as a character only when that character is here`)~label
  -- (entry => with (@me = entry.of) Program(code: block**) ~~ Program(code: entry.following).entered(entry.of, None))

Character := class: Hierarchy + Entity + Nameable {
  static PREFIX := "@"
  static local (who) => who == "me" ? @me : None
  static walked (at, names) => names.empty ? at : Character.walked(at[names.first], names.rest)
  assert Character.local("me").same(@me)  // CHR44 `@me` is not the local character "me"
  assert Character.local("nobody-here") == None  // CHR45 a character that is not here is local
  assert Character.walked(Document(entries: [(name: "a", value: 1)]), []).a == 1  // CHR46 walking no names does not stay at the start
  assert Character.walked(Document(entries: [(name: "a", value: Document(entries: [(name: "b", value: 7)]))]), ["a", "b"]) == 7  // CHR47 walking names does not enter each member in turn
  assert Character.walked(Document(entries: [(name: "a", value: 1)]), ["b"]) == None  // CHR48 walking into a name that is not there finds something

  quests => Program#{who: this}{running}
  assert @me.acting.same(@me)  // CHR49 a character is not the character it acts as
  assert @me/quests == @me.quests  // JB7 @me/quests is not the character's selection of its programs
  // Without @ether/security a character is only itself; security replaces this with the verified comparison.
  as (=== boolean) => this === @me
  acting => this
  chainable == (other) => ERROR@Security `comparing characters needs @ether/security (or @ether/network)`
}
