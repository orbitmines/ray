// Blowfish's published ECB test vectors, encrypted and opened (https://www.schneier.com/wp-content/uploads/2015/12/vectors-2.txt).

mark ^keyword := external global

octets (text: String) => text.chunk(2).map(. as Hexadecimal as Number)
vectors := [
  // ecb test data, key 0000000000000000 (vectors.txt)
  (key: "0000000000000000", clear: "0000000000000000", cipher: "4EF997456198DD78"),
  // key FFFFFFFFFFFFFFFF (vectors.txt)
  (key: "FFFFFFFFFFFFFFFF", clear: "FFFFFFFFFFFFFFFF", cipher: "51866FD5B85ECB8A"),
  // key 3000000000000000 (vectors.txt)
  (key: "3000000000000000", clear: "1000000000000001", cipher: "7D856F9A613063F2"),
  // key 1111111111111111 (vectors.txt)
  (key: "1111111111111111", clear: "1111111111111111", cipher: "2466DD878B963C9D"),
  // key 0123456789ABCDEF (vectors.txt)
  (key: "0123456789ABCDEF", clear: "1111111111111111", cipher: "61F9C3802281B096"),
  // key 1111111111111111, clear 0123456789ABCDEF (vectors.txt)
  (key: "1111111111111111", clear: "0123456789ABCDEF", cipher: "7D0CC630AFDA1EC7"),
  // key FEDCBA9876543210 (vectors.txt)
  (key: "FEDCBA9876543210", clear: "0123456789ABCDEF", cipher: "0ACEAB0FC6A0A28D")
]

unless vectors.every(Blowfish(key: octets(.key)).write(octets(.clear)) as Byte[] == octets(.cipher)) { INFO@mark `BF1 a block does not encrypt to the published ecb ciphertext` }
unless vectors.every(Blowfish(key: octets(.key)).opened(octets(.cipher)) == octets(.clear)) { INFO@mark `BF2 a published ecb ciphertext does not open to its clear text` }
// The first vector on its own: the all-zero key and block (vectors.txt, ecb line 1)
unless Blowfish(key: [0] * 8).write([0] * 8) as Byte[] == [0x4E, 0xF9, 0x97, 0x45, 0x61, 0x98, 0xDD, 0x78] { INFO@mark `BF3 the zero block under the zero key is not 4ef99745 6198dd78` }
// set_key test data: a 24-byte key, longer than a block (vectors.txt, set_key line 24)
unless Blowfish(key: octets("F0E1D2C3B4A5968778695A4B3C2D1E0F0011223344556677")).write(octets("FEDCBA9876543210")) as Byte[] == octets("05044B62FA52D080") { INFO@mark `BF4 a 24-byte key does not encrypt as in the set_key test data` }
// Two blocks are enciphered independently (ECB) (Schneier 1994, "Description of the Algorithm")
unless Blowfish(key: [0] * 8).write([0] * 16) as Byte[] == [octets("4EF997456198DD78"), octets("4EF997456198DD78")].flatten { INFO@mark `BF5 two equal blocks do not encrypt to the same ciphertext twice` }
// The P-array and S-boxes start as the digits of π: P1 = 243F6A88, S1[0] = D1310BA6 (Schneier 1994, "Generating the Subkeys")
unless Blowfish.digits.first == 0x243F6A88 && Blowfish.digits[18] == 0xD1310BA6 { INFO@mark `BF6 the subkeys do not start as the hexadecimal digits of π` }
