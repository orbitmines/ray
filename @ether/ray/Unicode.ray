Unicode := class {
  static version: Version = %17
  // UN40 the Unicode version is not seventeen
  assert Unicode.version == 17
  static spelled => "{version.number}.{version.revision ?? 0}"
  static Public := @https://www.unicode.org/Public
  // one directory per version: `<version>/ucd/` from 4.1.0, `<version>-Update/` with versioned file names before it (https://www.unicode.org/Public/, https://www.unicode.org/reports/tr44/)
  static UCD => version >= %4'1 ? Public / "{spelled}.0" / "ucd" : Public / "{spelled}-Update"
  // UN36 the tables are not read from unicode.org
  assert (Unicode.UCD as String).starts_with("https://www.unicode.org/Public/")
  // The Unicode version is selectable; its tables follow it (X3.2)
  // UV1 the tables are not those of version seventeen
  assert (Unicode.UCD as String) ~= "17.0.0"
  assert {
    Unicode.version = %3'2
    // UV5 an old version is not read from its update directory
    assert (Unicode.UCD as String) ~= "3.2-Update"
    // UV6 an old table is not named with its version
    assert (Unicode.file("Blocks") as String).ends_with("Blocks-3.2.0.txt")
    // UV7 an emoji from 6.1 is assigned in 3.2
    assert !(U+1F600.assigned)
    Unicode.version = %17
  }
  static file (name: String) => version >= %4'1 ? UCD / "{name}.txt" : UCD / "{name}-{spelled}.0.txt"
  // UV2 a table of a current version is not in its ucd directory
  assert (Unicode.file("Blocks") as String).ends_with("/ucd/Blocks.txt")

  static Table := class (Row, (("#", *) | (row: Row, (" "[], "#", *)?) | "")[].join("\n")) => {
    rows => this.row{!= None}
    [codepoint: Scalar] => rows{.range.in(codepoint)}.first
  }
  static Range := class (from: Scalar, ("..", to: Scalar)?) => {
    in (codepoint: Scalar) => from <= codepoint <= to ?? from
  }

  static CodePoint := class: Hexadecimal{length == 1..6}
  // UN2 0061 is not a code point
  assert "0061" is Unicode.CodePoint
  // UN4 seven hexadecimal digits are a code point
  assert !("1234567" is Unicode.CodePoint)
  static Scalar := class: CodePoint {
    dynamically assert this < 0x110000 && !(0xD800 <= this <= 0xDFFF)

    category => GeneralCategory.rows{Data[this].general_category ~= ⊢.short_name}.first
  }
  // W17 ten is not a scalar
  assert 10 is Unicode.Scalar
  // S146 a is not a scalar
  assert "a"[0] is Unicode.Scalar
  // UN3 ten is not a scalar
  assert 10 is Unicode.Scalar
  // UN1 a is not a scalar
  assert "a"[0] is Unicode.Scalar

  static Blocks => file("Blocks") as Table<(range: Range, "; ", value: *)>
  static Scripts => file("Scripts") as Table<(range: Range, " "[], "; ", value: *)>
  // UTS #39 §4: each confusable character and the prototype it maps to, from the security data of the same version (https://www.unicode.org/reports/tr39/#Confusable_Detection, https://www.unicode.org/Public/security/)
  static confusables => (Public / "security" / "{spelled}.0" / "confusables.txt") as Table<(range: Range, " "[], ";", "\t"[], prototype: Scalar[].join(" "), " "[], ";", "\t"[], type: Char.Word[], *)>
  static EastAsianWidth => file("EastAsianWidth") as Table<(range: Range, " "[], "; ", value: *)>
  static CaseFolding => file("CaseFolding") as Table<(range: Range, "; ", status: "C" | "F" | "S" | "T", "; ", value: Scalar[].join(" "), ";")>
  // UN60 A does not fold to a
  assert Unicode.CaseFolding[U+0041] == U+0061
  static SpecialCasing => file("SpecialCasing") as Table<(
    range: Range, "; ", lower: Scalar[].join(" "), "; ", title: Scalar[].join(" "), "; ", upper: Scalar[].join(" "), ";", (" ", condition: Char.Word[].join(" "), ";")?
  )>
  static BidiMirroring => file("BidiMirroring") as Table<(range: Range, "; ", value: Scalar)>
  // UN63 the mirror of ( is not )
  assert Unicode.BidiMirroring[U+0028] == U+0029
  static Age => file("DerivedAge") as Table<(range: Range, " "[], "; ", number: Decimal, ".", revision: Decimal)>

  static Data => file("UnicodeData") as Table<(
    range: Range, ";", name: *, ";", general_category: *, ";", canonical_combining_class: *, ";",
    bidi_class: *, ";", decomposition_mapping: *, ";", decimal_digit_value: Decimal?, ";", digit_value: Decimal?, ";",
    numeric_value: (minus: "-"?, numerator: Decimal, ("/", denominator: Decimal)?)?, ";", bidi_mirrored: "Y" | "N", ";", unicode1_name: *, ";", ISO_10646_comment: *, ";",
    upper_case: Scalar?, ";", lower_case: Scalar?, ";", title_case: Scalar?
  )>
  static UpperCase => Data.rows{.upper_case}.map(.range.from: .upper_case)
  // UN61 the upper case of a is not A
  assert Unicode.UpperCase[U+0061] == U+0041
  static LowerCase => Data.rows{.lower_case}.map(.range.from: .lower_case)
  // UN62 the lower case of A is not a
  assert Unicode.LowerCase[U+0041] == U+0061
  static TitleCase => Data.rows{.title_case}.map(.range.from: .title_case)
  static DecimalDigitValue => Data.rows{.decimal_digit_value != None}.map(.range.from: .decimal_digit_value)
  static DigitValue => Data.rows{.digit_value != None}.map(.range.from: .digit_value)
  static NumericValue => Data.rows{.numeric_value}.map(.range.from: .numeric_value -- (.minus ? -1 : 1) * .numerator / (.denominator ?? 1))
  static Superscript => decomposed("<super>")
  // UD18 ² is not a superscript 2
  assert Unicode.Superscript[U+00B2] == U+0032
  // UD20 2 is a superscript
  assert !(Unicode.Superscript[U+0032])
  static Subscript => decomposed("<sub>")
  // UD19 ₂ is not a subscript 2
  assert Unicode.Subscript[U+2082] == U+0032
  static decomposed (tag: String) => Data.rows{.decomposition_mapping ~= ⊢(tag, " ")}.map(.range.from: .decomposition_mapping.after(tag + " ") as Scalar)

  Scripts.rows.value.unique.for script => static Char.`script` = Char{.script == script}

  static GeneralCategory := class (file("PropertyValueAliases") as Table<("gc", " "[], "; ", short_name: Char.Word[], " "[], "; ", name: Char.Word[], (" "[], ";", *)?)>) => {
    rows.for category => static `category.name` = Scalar{Data[.].general_category ~= ⊢(category.short_name == "LC" ? "Lu" | "Ll" | "Lt" : category.short_name)}
  }
  // UN6 a digit is not a number
  assert "1"[0] is Unicode.GeneralCategory.Number
  // UN5 a digit is not a decimal number
  assert "1"[0] is Unicode.GeneralCategory.Decimal_Number
  // UN7 a space does not separate
  assert " "[0] is Unicode.GeneralCategory.Separator
  // UN8 a space is not a space separator
  assert " "[0] is Unicode.GeneralCategory.Space_Separator
  // UN9 a letter is not a letter
  assert "a"[0] is Unicode.GeneralCategory.Letter
  // UN10 a letter is a number
  assert !("a"[0] is Unicode.GeneralCategory.Number)
  // UN26 a digit is a letter
  assert !("1"[0] is Unicode.GeneralCategory.Letter)
  // UN27 a space is a letter
  assert !(" "[0] is Unicode.GeneralCategory.Letter)
  // UN11 a is not lowercase
  assert "a"[0] is Unicode.GeneralCategory.Lowercase_Letter
  // UN12 A is lowercase
  assert !("A"[0] is Unicode.GeneralCategory.Lowercase_Letter)

  static TF | TransformationFormat := class: CodeUnit[]{length == 1..(32 / CodeUnit.length)} {
    static CodeUnit: Binary
    static Decoding := {
      {unit: UTF-16.Unit{prefix}} => unit.U0 + 1, unit.U1, unit.U2
      {unit} => unit.U0, unit.U1, unit.U2, unit.U3
    }
    as (=== CodePoint[]) => sequence.map(Compiler.reduced(., Decoding))
    bytes => this as Byte[]
    // UN18 a is other than one byte in UTF-8
    assert ("a" as Unicode.UTF-8).bytes.length == 1
    // UN19 é is other than two bytes in UTF-8
    assert ("é" as Unicode.UTF-8).bytes.length == 2
    // UN20 一 is other than three bytes in UTF-8
    assert ("一" as Unicode.UTF-8).bytes.length == 3
    // UN21 😀 is other than four bytes in UTF-8
    assert ("😀" as Unicode.UTF-8).bytes.length == 4
    // UN22 a is other than two bytes in UTF-16
    assert ("a" as Unicode.UTF-16).bytes.length == 2
    // UN23 😀 is other than a surrogate pair in UTF-16
    assert ("😀" as Unicode.UTF-16).bytes.length == 4
    // UN24 a is other than four bytes in UTF-32
    assert ("a" as Unicode.UTF-32).bytes.length == 4
    assert (("a" as Unicode.UTF-16).bytes).(
      . == (0x00, 0x61)  // UN50 a in big-endian UTF-16 is not 00 61
      & ("a" as Unicode.UTF-16 as Unicode.LittleEndian).bytes == <-.  // UN48 little-endian does not read the bytes right to left
    )
    // UN49 a single byte is not the same either way
    assert ("a" as Unicode.UTF-8 as Unicode.LittleEndian).bytes == (("a" as Unicode.UTF-8).bytes)
  }
  static LittleEndian := TF{} {
    bytes => <-(this as Byte[])
  }

  static UTF-8 := class: TF (sequence: Unit[]) => {
    static CodeUnit := Binary₈
    static Unit := class (
      prefix: 1[]{length == 0..4},
      U0: Binary{length == 8 - prefix.length}{⊢0},
      (₂10, U1: Binary₆) if prefix ⊢₂11,
      (₂10, U2: Binary₆) if prefix ⊢₂111,
      (₂10, U3: Binary₆) if prefix ⊢₂1111
    )
  }
  // T4 01100001 is not a in UTF-8
  assert ₂01100001 as Unicode.UTF-8 as String == "a"
  // UN13 é does not come back from UTF-8
  assert "é" as Unicode.UTF-8 as String == "é"

  static UTF-16 := class: TF (sequence: Unit[]) => {
    static CodeUnit := Binary₁₆
    static Unit := class (
      prefix: ₂110110?,
      U0: Binary₄,
      U1: Binary{length == 12 - prefix.length},
      (₂110111, U2: Binary₁₀) if prefix
    )
  }
  // UN16 a newline does not come back from UTF-16
  assert "\n" as Unicode.UTF-16 as String == "\n"
  // UN25 😀 does not come back from UTF-16
  assert "😀" as Unicode.UTF-16 as String == "😀"

  static UTF-32 := class: TF (sequence: Unit[]) => {
    static CodeUnit := Binary₃₂
    static Unit := class (0[]₁₁, U0: Binary₂₁) => { }
  }
  // W13 UTF32 round trip failed
  assert "\n" as Unicode.UTF-32 as String == "\n"
  // UN14 a newline does not come back from UTF-32
  assert "\n" as Unicode.UTF-32 as String == "\n"
  // UN15 the null character does not come back from UTF-32
  assert "\0" as Unicode.UTF-32 as String == "\0"
}

U+{codepoint: Hexadecimal.String}: Char => Hexadecimal(integer: codepoint) as Char

// UN64 U+0061 is not a
assert U+0061 == "a"[0]


