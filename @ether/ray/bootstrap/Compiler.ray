    boundn = bn
    (r < 0) ? 0 : r
  }
  static read_partly (p, t: Text, bn) => {
    boundn = bn
    wholly = false
    matched(p, t.from, 0)
  }
  static bind (sym, a, e) => {
    Matching.bound_put(bound_at(boundn), sym, a, e)
    boundn = boundn + 1
    0
  }
  static bound_put (b: Bound, sym, a, e) => {
    b.hole = sym
    b.start = a
    b.end = e
    b.held = 0
  }
  static bindv (sym, v) => {
    bind(sym, 0, 0)
    Matching.held_put(bound_at(boundn - 1), v)
  }
  static held_put (b: Bound, v) => {
    b.held = v
    0
  }
  static span (sym, a, e, v) => Spanned(name: sym, from: a, to: e, value: v)
  static typed (t, v) => ((v is Text) && ((t is Pattern) || (t is Class))) ? readtext(astype(t, 0), v) : v
  static extended (x, c: Closure) => {
    indirect(x, list(), 0, c.function)
    x
  }
  static index (n, k: Text) => (k is Text) ? Matching.key_read_whole(keys(n), k) : None
  static key_read_whole (l: List, k: Text) => {
    i := 0
    while i < l.count {
      return member(at(l, i), Symbol.value) if reads(topattern(member(at(l, i), Symbol.key)), k) == k.to
      i = i + 1
    }
    None
  }
  static last (l: List) => (l.count == 0) ? None : at(l, l.count - 1)
  static reread_of (s: Pattern) => ((s is Pattern) && (s.kind == reread)) ? s.a : s
  static with_in (s, sym, v) => (s is Node) ? Matching.with_found(member(s, sym), v) : v
  static with_found (t, v) => ((t is Pattern) || ((t is Node) && (member(t, Symbol.text) != None))) ? t : v
  static reading_at (c, pos) => {
    i := 1
    while i <= activen {
      return 1 if (word_of(actives + (i * 8)) == c) && (word_of(actives + ((i * 8) + 4)) == pos)
      i = i + 1
    }
    0
  }
  static text_led_read (ctx, n) => Matching.led_read_from(ctx, n, boundn, (n < textend) ? byte(n) : (0 - 2))
  static led_read_from (ctx, n, m, c) => {
    x := ctx
    r := 0
    while x is Node {
      r = Matching.led_in_rules(member(x, Symbol.rules), n, m, c)
      return r if r > n
      x = member(x, Symbol.in)
    }
    0
  }
  static led_in_rules (rules: Node, n, m, c) => (rules.keys == None) ? 0 : Matching.led_tried(rules.keys, n, m, c)
  static led_tried (l: List, n, m, c) => {
    x := Caches.led_index(l)
    a := (c >= 0) ? word_of(x + (8 + (c * 4))) : (0 - 1)
    b := word_of(x + 1032)
    i := 0
    r := 0
    while (a >= 0) || (b >= 0) {
