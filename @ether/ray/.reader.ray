registry.latest.shared = true

// A method of `receiver`, as a value: called (`f(x)`, `f x`), it is applied to it.
{method: Tight}.bound_to({receiver}) =>
  made := external node
  made.bound_method = method
  made.bound_receiver = receiver
  made.outer_frame = registry.program_class
  made.instance = true
  made.this = made
  made
registry.latest.shared = true

// The method of a value named as `key` (raw code: its text): a method rule read by the value whose head is that name, and
// its arguments if any. (Only the rules kept under the name's first character, scope by scope in the order they are met.)
{value}.method_named({key}) =>
  k := key
  where := external span k
  value.method_spelled(where.from, where.to)

