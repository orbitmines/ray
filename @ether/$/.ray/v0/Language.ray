Language := class: Ray = extensions: String, location: Location[] = [], level: Compiler?, written: Compiler?, of: Language?, version: Version?, implementations: Implementation[] = [], targets: Language[] = [] {
  static named (extension: String) => Language#{.names(extension)}.first
  static over (outer: Language, base: Language) => Language(outer.extensions, location: outer.location, level: base.level + outer.level, written: base.written + outer.written, of: base, version: outer.version)

  static for_file (file_name: String) => file_name ~= (*, ".", inner: Char.Word[], ".ray") ⊣
    ? (named("." + inner) ? over(named("." + inner), ray) : ray)
    : named("." + (file_name ~= (*, ".", last: Char.Word[]) ⊣)?.last) ?? ray

  static Writing := class = value: *
  static unwrapped := {
    {writing: Writing} => writing.value
  }
  static ray_written := {
    {writing: Writing{value === None}} => "None"
    {writing: Writing{value is String}} => "\"", writing.value.escaped_line, "\""
    {writing: Writing{value is Number}} => writing.value as 10 as String
    {writing: Writing{value is Iterable}} => "[", writing.value.map((", " if .index > 0), Writing(.)), "]"
    {writing: Writing} => "(", writing.value.fields.map((", " if .index > 0), .name, ": ", Writing(.value)), ")"
  }

  names (extension: String) => extensions# ∋ extension
  bundled (path: String) => location.map(. / path){IO.read(. / ".project.ray")}.first as Project

  admits (program) => true
  read (text) => level
    ? Compiler.reduced(text, level) -- (admits(.) ? . : ERROR `this file is written in a sublanguage that does not permit what it does`)
    : Quest(name: "a reader for the language", goal: this)
  write (value) => written ? Compiler.reduced(Writing(value), unwrapped + written) as String : Quest(name: "a writer for the language", goal: this)

  targeting (language: Language) => targets ∋ language
  backwards_compatible => previous**.every(.targeting(this))
  forwards_compatible => next**.every(.targeting(this))

  static Implementation := class = language: Language, written_in: Language, location: Location {
    source => IO.read(location)
    level => written_in.read(source)
    setup => language ~~ .implementations.push this ~~ .level ??= level
  }

  static ray := Language(".ray", level: Compiler.default, written: ray_written)
  static cfg := Language(".cfg", level: ray.level, written: ray.written, of: ray){admits Program{Pure & Terminating}}
  static regex := Language(".regex")
}

Node &+= {
  as (language: Language) => language.write(this)
}
