
// Expression: a language read from its own text. Its first line says how a rule is written: `!language`, the brackets a
// hole is written in (`{ }`), then the rule that makes rules, written with them (`{LHS} => {RHS}`). Every statement after it
// is read in a node by the longest of that node's rules that reads it; the rule that makes rules adds one there, its head
// read the same way, its body read when it is applied, in a node of its own whose caller is what applied it. Only four
// things are given: `external .` (a node), `external &` (what applies), `external goto` and `external label` (where control
// goes). Read under a level, `Program{O: …}`, what it reads is a Program (statements as vertices, gotos as edges), and a
// back end is one more level: `Wasm` writes that Program as WebAssembly.
// (a line's end, as a text)
line_end := "\n"
Expression := class (
  BOOTSTRAPPER: (
    HEADER: `!language`,
    \s[]+,
    // (a hole's brackets, a space where its name goes)
    CAPTURE: (String+, \s, String+),
    \s[]+,
    CAPTURES: (LHS: CAPTURE.map{== \s}(`LHS`) | RHS: CAPTURE.map{== \s}(`RHS`) | String)[],
    \n\n
  ),
  (
    // (the rule that makes rules: any space in it any amount of space, each hole anything, its left side a head of the same
    // shape again, `[LHS: [LHS, RHS], RHS]`; the first statement)
    Code := (BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Code) | String)[]
    GRAMMAR_RULE_DEF := BOOTSTRAPPER.CAPTURES.map{is \s}((space) => \s[])
    GRAMMAR_RULE_DEF.RHS = Code
    GRAMMAR_RULE_DEF.LHS = Code
    GRAMMAR_RULE_DEF.LHS = GRAMMAR_RULE_DEF
    
    GRAMMAR_RULE: GRAMMAR_RULE_DEF, \n | ⊣,
    statements: (
      // A node: its rules by their heads; what it does not read, what it is in reads.
      Node := class (in?: Node, of?: Node) => {
        // (itself, as its rules' bodies name it: `this` there is what a statement calls them on)
        node := this
        // (what it is made of, its components: the last added first, read after its own rules and before what it is in)
        parts := Array.new
        // (its rules led by what they are read on, `{this}(…)`, each kept with the rest of its head, `led_rest`)
        led := None
        led_from := None
        rules := {
          [rule: GRAMMAR_RULE.LHS] := (caller) => {
            // (as the holes that wrote it took it, defined where they are used; each hole shown as its head says, `{x ^style}`)
            taken := takes(caller)
            written := level spliced (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)
            // (a name written in a pair, `(x) := v`: x read as a value, declared again where something visible defines it)
            named := pair_named(between(written), taken)
            valued := (!(written.first == hole_opening) && (level cw_enclosed (written))) && !has_hole(named)
            rule_lhs := valued ? named : written
            rule_rhs := inside_of(level spliced (rule.RHS) (BOOTSTRAPPER.CAPTURE) (taken))
            // (a name in a pair a hole took, `{name}` given `(x)`: defined where that was written; given `({p})`, where p's was)
            rule_where := home_of(caller, ((valued && ((rule.LHS.first == hole_opening) && (named.length > 0))) ? paired_hole(caller, level spliced_entry (rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken)) : level spliced_entry (valued ? between(rule.LHS) : rule.LHS) (BOOTSTRAPPER.CAPTURE) (taken))) ?? (place_of(caller) ?? node)
            rule_home := (valued ? defined_in(rule_where, rule_lhs) : None) ?? rule_where
            sink = Array.new
            head := (rule_lhs as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => named_in(Program(in: node), hole.inside))
            led_written := rule_lhs as (led: BOOTSTRAPPER.CAPTURE.map{== \s}(`this`), led_after: String+)
            rule_styled := sink.map((sp) => [level place_name (sp.rest.first), sp.first])
            // (its body read once, in a node of its own, run in a node in that one each time it is applied)
            rule_body := Node(in: ((caller.bound === None) ? node : caller.in))
            rule_home.rules[[head]] := (caller) => {
              me := applied
              me.bound = holes
              me.caller = caller
              me.in = Node(in: rule_body)
              me.bound.for((hole) => me.in.rules[[hole.key | BOOTSTRAPPER.CAPTURE.map{== \s}(hole.key)]] := (c) => parameter_read(hole, applied, hole_value(hole, c, caller)))
              me.in.written_keys.for((hk) => hk.named = true)
              me.this = caller.this
              me.receiver = caller.receiver
              me.bound.for((hole) => rule_styled{.first == hole.key}#.for((sh) => painted.append([sh.last, hole.value, [[hole]]])))
              (rule_own.styled_as ?? Array.new).for((rs) => painted.append([rs.first, [rule_lhs, me.input], [me.bound]]))
              // (its body read and run in turn where it runs, the rule set aside while it is read: a rule never reads itself)
              me.outside = aside
              aside = [rule_own].joined(aside)
              (rs: Statements(me.in)(me) = rule_rhs)
              aside = me.outside
              left := leaving(finished(me), me.answer)
              // (the pairs its body's rules wrote, known only while it is read)
              level unpaired (me.in)
              left
            }
            rule_own := rule_home.rules.keys.last
            rule_own.written_head = rule_lhs
            // (a method led by what it is read on, `{this}(…)`: read on a value, its rest reads what follows the value; a rest led by a
            // hole too, `{this}{rest}`, would read anything)
            (rule_own.led_rest = (led_written.led_after as (hole: BOOTSTRAPPER.CAPTURE.map{== \s}((space) => Place(`inside`, node)) | String)[]).map{.inside}((hole) => named_in(Program(in: node), hole.inside))) if !((led_written.led_after === None) || (led_written.led_after.first == hole_opening))
            // (kept apart, in a node of its own rules: only what is read on a value made of it reads by them)
            (led_home(rule_home).rules[[rule_own.led_rest]] := rule_own.value) if !((rule_own.led_rest === None) || (rule_home === global))
            // (one that is only a hole, `{written}`: it reads anything, so only what it is defined in reads with it)
            (rule_own.lone = true) if (rule_lhs.first == hole_opening) && ((level cw_enclosed (rule_lhs)) === true)
            (rule_own.named = true) if !has_hole(rule_lhs)
            // (the pairs its head writes, `({x})`, known to what is read after it; one holding `=>`, a rule that defines)
            level paired (rule_lhs) (BOOTSTRAPPER.CAPTURE) (rule_home)
            (rule_own.defines = true) if (level holds_text (rule_lhs) (separator))
            rule_own
          }
          [{value: concurrently node.prefix(.)}: node.keys, rest: (String | \n)[]] := (caller) => {
            v := value(caller)
            on := Node(in: caller.in, of: v)
            // (what it is read on gives what is read on it: a node its rules, anything else its fields; one of the level's own
            // kinds of value, what the level says it is, `level kinds`)
            o := ((level kind_of (v)) === None) ? v : named_in(Program(in: kinds_of(caller)), level kind_of (v))
            // (its own methods led by it first: what follows it read by their rest, `this` it)
            (o.rules === None) ? members(o).for((m) => on.rules[[m.key]] := (c) => m.value) : (on.parts = [o])
            (on.led_from = o) if !(o.rules === None)
            r := (rs: Statements(on) = rest)
            // (nothing read on it: the whole read again, neither split nor led by that value, `(x && y)`)
            (r === None) ? unsplit(caller, text(rest.from - value.length, rest.to), value) : run_by(r, Program(caller: caller, in: on, this: v, receiver: v))
          }
        }
        // (a name read inside its own reading is its place)
        named_as (text, by) => ((node.naming_here ?? Array.new){. == text}#.count > 0) ? Place(text, node) : named_now(text, by)
        named_now (text, by) => {
          was_naming := node.naming_here
          node.naming_here = [text].joined(was_naming ?? Array.new)
          r := (level holds_text (text) (line_end)) ? apart(by, () => turned(node, text, by)) : named_once(text, by)
          node.naming_here = was_naming
          r
        }
        // (a text of one line is one statement, read whole, or the place it names; one of more, its statements read in turn)
        named_once (text, by) => {
          v := (vs: Statements(node) = text)
          (v === None) ? Place(text, node) : apart(by, () => v(by))
        }
        split_key := rules.keys.last
        maker_key := rules.keys.first
        // (its rules but the two every node has, the one that makes rules and the split)
        written_keys => parts_written(parts).joined(rules.keys{!((. === maker_key) || (. === split_key))}#)
        parts_written (ps) => ps.empty ? Array.new : parts_written(ps.rest).joined(ps.first.written_keys)
        // (a definition, `=>` outside pairs: the latest rule that defines, else the rule that makes rules; none set aside)
        // (what reads it here, but a name, `x`, read at its start, when what it is in reads it all, `x = v`)
        whole (text) => nearer(text, made(text, defines(text)))
        nearer (text, near) => (near === None) ? (led_whole(led_from, text) ?? (parts_whole(parts, text) ?? in?.whole(text))) : ((near.named && !(text == near.key)) ? fuller(text, near, in?.whole(text)) : near)
        // (in its components: each one's own rules, then what it is made of in turn, not what it is in)
        own_whole (text) => part_longest(text) ?? parts_whole(parts, text)
        part_longest (text) => (level keys_reading (rules) (text)){!(((. === split_key) || (. === maker_key)) || (.defines || (.lone === true))) && (!among(aside, .) && (text ~= .))}#.sort(.length).last
        parts_whole (ps, text) => ps.empty ? None : (ps.first.own_whole(text) ?? parts_whole(ps.rest, text))
        fuller (text, near, far) => (text == far?.key) ? far : near
        made (text, defining_text) => (((rules.keys.first === maker_key) && defining_text) && (text ~= maker_key)) ? (defining(text) ?? maker_key) : longest(text, defining_text)
        prefix (text) => longest(text, defines(text)) ?? (led_prefix(led_from, text) ?? (parts_prefix(parts, text) ?? in?.prefix(text)))
        // (a value's methods led by it, `{this}(…)`: by their rest, in it and what it is made of)
        led_whole (place, text) => (place === None) ? None : (((place.led === None) ? None : place.led.own_whole(text)) ?? led_parts_whole(place.parts, text))
        led_parts_whole (ps, text) => ps.empty ? None : (led_whole(ps.first, text) ?? led_parts_whole(ps.rest, text))
        led_prefix (place, text) => (place === None) ? None : (((place.led === None) ? None : place.led.own_prefix(text)) ?? led_parts_prefix(place.parts, text))
        led_parts_prefix (ps, text) => ps.empty ? None : (led_prefix(ps.first, text) ?? led_parts_prefix(ps.rest, text))
        own_prefix (text) => part_longest(text) ?? parts_prefix(parts, text)
        parts_prefix (ps, text) => ps.empty ? None : (ps.first.own_prefix(text) ?? parts_prefix(ps.rest, text))
        defining (text) => (level keys_reading (rules) (text)){.defines && (!among(aside, .) && (text ~= .))}#.sort(.length).last ?? in?.defining(text)
        longest (text, defining_text) => (level keys_reading (rules) (text)){!(. === split_key) && ((defining_text || !((. === maker_key) || .defines)) && (!among(aside, .) && (text ~= .)))}#.sort(.length).last
        // (and the split, `x.f`, when it reads more)
        reading (text) => longer(text, whole(text))
        longer (text, found) => ((found === maker_key) || (text == found?.key) || !prefer_split(text, found)) ? found : split_key
        // (the split, when it reads more of the text than the key does, read again: what was read since may have been another
        // text)
        prefer_split (text, found) => !among(aside, split_key) && (text ~= split_key) && ((found === None) || (split_key.length > ((text ~= found) ? found.length : 0)))
        // (a text read with the split, and a rule led by what it read, set aside)
        unsplit (program, whole_text, led_by) => {
          was := aside
          aside = [split_key, led_by].joined(aside)
          r := named_in(program, whole_text)
          aside = was
          r
        }
        keys => (in === None) ? own_keys : (own_keys | in.keys)
        own_keys => parts.empty ? rules.keys : rules.keys.joined(parts_written(parts))
      }
      // A program running: what applied it, where it is.
      // (`receiver`: what a method was read on, until a node of its own is made of it)
      Program := class (caller?: Program, at?: Statement, in?: Node, this?: Node, for_value?: Node, receiver?: Node) => { }
      Argument := class (\s+, word: String) => { }
      global := Node({
        rules[`external`, \s+, rule: String, args: Argument[]] := (caller) => {
          // (`external . v`: v one of the components of what it is read in, the last added first, answered; bare, a node of its
          // own in what it is read in, made of what a method was read on, its receiver)
          `.` (made_of) => (made_of.first === None) ? (caller.this = (caller.in = composed(caller.in, made_on(Node(in: caller.in), caller)))) : composed(place_of(caller), made_of.first)
          `&` => caller
          `goto` (to) => (caller.at = to.first) if (to.rest.empty || to.rest.first)
          `label` (to) => to.first
          `style` (how) => painted_with(how, caller)
          `include` (file) => included(caller, file.first)
          `rule` (head) => rule_written(caller.in, head.first)
          // (`external member x name`: the rule x sees by that name, its own or what it is made of, applied on x; given a
          // value too, x given a rule by that name answering it)
          `member` (asked) => asked.rest.rest.empty ? member_read(caller, asked.first, asked.last) : member_put(asked.first, asked.rest.first, asked.last)
          `shown` (how) => (how.first === None) ? how.last : ((((level kind_of (how.first)) === None) ? (how.first).shown_as : None) ?? how.last)
        }[rule](args.map((argument) => given(caller, rule, argument, args.first)))
      })
      member_read (program, holder, name) => ((holder === None) || (holder.rules === None) || (name === None)) ? None : member_found(program, holder, holder.own_whole(name))
      member_found (program, holder, found) => (found === None) ? None : found.value(Program(caller: program, in: holder, this: holder, receiver: holder))
      member_put (holder, name, value) => {
        holder.rules[[name]] := (c) => value
        holder.rules.keys.last.named = true
        value
      }
      // Statements: each, after any space, read by the longest rule that reads it (all at once, where they can be); run in
      // order, each given what applies them.
      Statement := class (
        leading_whitespace?: (\s | \n)[]+,
        {statement: concurrently context.reading(.)}: context.keys,
        trailing_whitespace?: (\s | \n)[]+
      ) => {}
      // (the statements as read kept on the node they are read in, `statements`: what each read, its rule and what that took)
      Statements (context: Node) => dynamically Statement[] & (caller: Program) => (
        context.statements = .
        arrived(caller, listed(.))
      )
      listed (read) => read.map((s) => s.statement)
      // (a text read by a program, run apart from its own statements: what it read so far, what waits, what it answered)
      apart (program, inner) => {
        was := [program.done, program.waiting, program.answer]
        program.done = None
        program.waiting = None
        r := inner()
        program.done = was.first
        program.waiting = was.rest.first
        program.answer = was.last
        r
      }
      turned (place, text, program) => {
        (rs: Statements(place)(program) = text)
        program.answer
      }
      // (a text's statements run by a program of its own, its jumps going on in what applied it)
      run_by (code, program) => {
        code(program)
        leaving(finished(program), program.answer)
      }
      // (each in turn, as it is read: run, but while a jump waits for a label not read yet; a jump back goes on after its label
      // among those read, another round)
      arrived (program, read) => {
        read.for((s) => arrive(program, s))
        program.answer
      }
      arrive (program, statement) => {
        program.done = (program.done ?? Array.new).append(statement)
        (program.at === None) ? go(program, [statement]) : waits(program, statement)
      }
      waits (program, statement) => (!(program.at == afterwards) && label_is(program, statement)) ? go(gone_on(program), [statement]) : kept(program, statement)
      kept (program, statement) => program.waiting = (program.waiting ?? Array.new).append(statement)
      go (program, read) => {
        rounds := [read]
        rounds.for((r) => rounds.append(settled(ran(program, r))) if !(rounds.last === None))
        program
      }
      ran (program, round) => {
        program.waiting = None
        round.for((s) => (program.at === None) ? runs(program, s) : kept(program, s))
        program
      }
      // (a label or a jump answers nothing: the body answers what was answered before it; while it runs, the rule is no longer
      // set aside)
      runs (program, statement) => {
        before := program.answer
        inside := aside
        aside = program.outside ?? aside
        a := statement(program)
        aside = inside
        program.answer = ((statement.rule == `label`) || (statement.rule == `goto`)) ? before : a
        program
      }
      // (a jump: to its label among those read, what runs next; to the host's `afterwards`, the rest kept for when everything
      // is read; to its `report`, said, then on (in a test, to its `erred`); else waiting for its label)
      settled (program) => {
        (level kept_later (program)) if (program.at == afterwards)
        said(program) if (program.at == report)
        to := (program.at === None) ? program.waiting : labelled(program, program.done)
        gone_on(program) if !((program.at === None) || (to === None))
        to
      }
      gone_on (program) => {
        forget(program)
        program.at = None
        program
      }
      labelled (program, read) => read.empty ? None : (label_is(program, read.first) ? read.rest : labelled(program, read.rest))
      label_is (program, statement) => (statement.rule == `label`) && same_label(label_of(Program(in: program.in), statement.args.first.word), program.at)
      // (a body read to its end: a value gone to that no label in it is, `external goto {a}`, goes on after the jump)
      finished (program) => !((level kind_of (program.at)) == `list`) ? program : go(gone_on(program), program.waiting ?? Array.new)
      leaving (program, answer) => {
        (program.caller.at = program.at) if !((program.at === None) || (program.at == afterwards))
        answer
      }
      // (what the host is given, `external <rule> <arguments…>`: each argument read where it is written, but a label (a jump's
      // first, a label's), its word, or, written in the brackets holes are written in, the value that reads as)
      given (program, name, argument, first) => (((name == `goto`) || (name == `label`)) && (argument === first)) ? label_of(program, argument.word) : ((name == `include`) ? takes(program){.key == ((argument.word.first == hole_opening) ? between(argument.word) : argument.word)}#.first : named_in(program, argument.word))
      label_of (program, word) => (word ~= BOOTSTRAPPER.CAPTURE.map{== \s}(String+)) ? [named_in(program, word)] : Place(word, global)
      same_label (one, other) => ((level kind_of (one)) == `list`) ? (((level kind_of (other)) == `list`) && (one.first == other.first)) : (one == other)
      afterwards := Place(`afterwards`, global)
      // (everything read, the tests kept for afterwards run, each in memory of its own (Design §21.4), what it kept for
      // afterwards run inside it; where the host runs them a step at a time, held for it)
      run_later (unused) => level run_kept (ran_later) (tested_later)
      tested_later (program) => level tested_here ((program.bound.first).value)
      ran_later (program) => {
        testing = program
        finished(go(gone_on(program), program.waiting ?? Array.new))
        testing = None
      }
      // (what is said, `external goto report`: what the hole took and where, each in turn; the host reads them)
      report := Place(`report`, global)
      reported := level reports
      testing := None
      said (program) => {
        reported.append([takes(program).first, bound_along(program)])
        program.at = None
        (testing.at = Place(`erred`, global)) if !(testing === None)
      }
      kinds := Array.new
      kinds_of (program) => kinds.first ?? known(named_in(program, `level kinds`))
      known (kind) => (kind.rules === None) ? kind : kinds.append(kind).first
      // (what a name is read as: without the space around it, unless it is only space)
      trimmed_or (text, otherwise) => (text.length == 0) ? otherwise : text
      // (a hole's value, read once in what applied it; a jump back in a body forgets what its holes answered, a loop asks again)
      held (hole, answer) => ((hole.answered === None) ? (hole.answered = [answer()]) : hole.answered).first
      forget (program) => (program.bound ?? Array.new).for((fh) => fh.answered = None)
      // (who reads a hole: the program reading it once it entered a block, else what applied the rule)
      reader (program, otherwise) => ((program.in === None) || !(program.in === program.this)) ? otherwise : program
      // (a hole's value in its body, `{x}` read there: read once, by who reads it)
      hole_value (hole, program, applier) => held(hole, () => named_for(program, reader(program, applier), hole.value))
      // (a hole read for code read in a value, `x.( … )`: read where it is written, what it defines the value's)
      named_for (program, by, text) => in_value(by, text, (((program.in === None) || (program.in.of === None)) || (by.in === program.in)) ? ((by.in === None) ? None : by.in.of) : program.in.of)
      in_value (program, text, held_value) => (held_value === None) ? named_in(program, text) : for_value(program, held_value, text)
      for_value (program, held_value, text) => {
        was := program.for_value
        program.for_value = held_value
        r := named_in(program, text)
        program.for_value = was
        r
      }
      led_of (place) => ((place.led === None) ? Array.new : [place.led]).joined(parts_led(place.parts))
      parts_led (ps) => ps.empty ? Array.new : led_of(ps.first).joined(parts_led(ps.rest))
      led_home (place) => (place.led === None) ? (place.led = Node()) : place.led
      made_on (made, program) => {
        (made.parts = [program.receiver]) if !((program.receiver === None) || (program.receiver.rules === None))
        program.receiver = None
        made
      }
      // (never made of what is made of it: what it sees would go round without end)
      composed (into, part) => {
        (into.parts = [part].joined(into.parts)) if !((part.rules === None) || ((into.rules === None) || made_of_deep(part, into)))
        part
      }
      made_of_deep (part, whole) => (part === whole) || parts_reach(part.parts, whole)
      parts_reach (ps, whole) => ps.empty ? false : (made_of_deep(ps.first, whole) || parts_reach(ps.rest, whole))
      named_in (program, text) => program.in.named_as(trimmed_or(level cw_trimmed (text), text), program)
      aside := Array.new
      among (list_of, one) => list_of{. === one}#.count > 0
      // (the bracket a hole opens with, and whether a text holds one)
      hole_opening := BOOTSTRAPPER.CAPTURE.first
      has_hole (text) => level holds_text (text) (hole_opening)
      // (what a definition is written with, the header's `=>`, outside every pair; the header's brackets a pair)
      separator := level separator_of (BOOTSTRAPPER.CAPTURES.text) (BOOTSTRAPPER.CAPTURE)
      defines (text) => level holds_outside (text) (separator)
      level closing (BOOTSTRAPPER.CAPTURE)
      // (what is painted, `external style`: each style, what it is shown on and what the holes took; the host reads them)
      painted := level paints
      // (the program the text is run by, and a text read after it as more of it, by the same program (the editor's file read
      // on what the entrypoint already read)
      top := Program(in: global, this: global)
      read_text (text) => {
        named_in(top, text)
        run_later(0)
      }
      level entry_read (read_text)
      sink := Array.new
      painted_with (how, program) => {
        sink.append(painted.append([how.first, how.last, bound_along(program)]).last)
        // (a rule keeps the styles it is shown as, read each time it is applied)
        ((how.last).styled_as = ((how.last).styled_as ?? Array.new).append(sink.last)) if !((how.last).written_head === None)
        // (and a node the style it is shown as, the last given it: what `shown` answers)
        ((how.last).shown_as = how.first) if (level kind_of (how.last)) === None
        how.last
      }
      // (a hole read in its body: its name shown as a parameter, where it is read)
      parameter_read (hole, program, answer) => {
        painted.append([`parameter`, [hole.key, program.input], [Array.new]])
        answer
      }
      // (a rule by its head as written, `level rule`: the latest written so, here or around)
      rule_written (place, text) => ((place === None) || (text === None)) ? None : (place.rules.keys{.written_head == text}#.last ?? rule_written(place.in, text))
      bound_along (program) => (program === None) ? Array.new : [program.bound].joined(bound_along(program.caller))
      // (what the holes took where a program runs, the nearest first; where the rule is used whose holes took a head)
      takes (program) => (program === None) ? Array.new : (program.bound ?? Array.new).joined(takes(program.caller))
      // (a file, `external include <location>`: the text the host gave for the location as written where the include is, read
      // in turn there, as the code written in its place)
      included (program, hole) => file_read(holder(program, written_by(program, hole)), written_by(program, hole))
      file_read (program, hole) => ((program === None) || ((level file_named (level cw_trimmed (hole.value))) === None)) ? None : named_in(program.caller, level file_named (level cw_trimmed (hole.value)))
      // (the hole a hole's text names, `{x}`, further out, as far as one does)
      written_by (program, hole) => (((hole === None) || !((level cw_trimmed (hole.value)).first == hole_opening)) || (holder(program, hole) === None)) ? hole : (outer_hole(holder(program, hole), between(level cw_trimmed (hole.value))) ?? hole)
      outer_hole (program, name) => written_by(program.caller, takes(program.caller){.key == name}#.first)
      // (what is in a pair, `({p})`: a hole's that was taken, the text it took)
      pair_named (inner, taken) => (((inner.first == hole_opening) && ((level cw_enclosed (inner)) === true)) && (taken{.key == between(inner)}#.count > 0)) ? level spliced (inner) (BOOTSTRAPPER.CAPTURE) (taken) : inner
      paired_hole (program, hole) => ((hole === None) || (holder(program, hole) === None) || !((level cw_enclosed (level cw_trimmed (hole.value))) === true) || !(between(level cw_trimmed (hole.value)).first == hole_opening)) ? hole : (outer_hole(holder(program, hole), between(between(level cw_trimmed (hole.value)))) ?? hole)
      holder (program, hole) => ((hole === None) || (program === None)) ? None : (among(program.bound ?? Array.new, hole) ? program : holder(program.caller, hole))
      home_of (program, hole) => (holder(program, hole) === None) ? None : place_of(holder(program, hole).caller)
      // (where a program defines: in the value it reads code for, `x.( … )`, else where it is)
      place_of (program) => ((program.for_value === None) || (program.for_value.rules === None)) ? value_read_in(program.in) : program.for_value
      // (a node a value is read on in, `x.( … )`: what it defines is that value's)
      value_read_in (place) => ((place === None) || ((place.of === None) || (place.of.rules === None))) ? place : place.of
      // (the nearest node that defines a name itself)
      defined_in (place, text) => (place === None) ? None : ((place.written_keys{text ~= .}#.count > 0) ? place : defined_in(place.in, text))
      // (what is between a text's first character and its last)
      between (text) => level cw_trimmed (level cw_inner (text))
      // (a body written in the brackets holes are written in is the code inside them, its lines as written: from right after
      // the bracket)
      inside_of (text) => {
        code := level cw_trimmed (text)
        ((code.first == hole_opening) && (level cw_enclosed (code))) ? level cw_span_of (level cw_inner (code)) (between(code)) : code
      }
      // (the compiler's parser: a grammar's rules read in a node of their own, a word what nothing else there reads)
      parse_node_of (grammar_text) => {
        g := Node(in: global)
        (gs: Statements(g) = grammar_text)(Program(in: g))
        p := Node()
        level moved_keys (g) (p)
        leaf := Node(in: global)
        (ls: Statements(leaf) = `{name_word} => external &`)(Program(in: leaf))
        p.split_key = leaf.rules.keys.last
        p
      }
      parser (grammar, program_text) => {
        grammar.parse_node = grammar.parse_node ?? parse_node_of(grammar.text)
        level curried_value (ps: Statements(grammar.parse_node) = program_text)
      }
      level set_parser (parser)
      // (read in turn; everything read, what was kept for afterwards)
      (Statements(global)(top), (\s | \n)[], (⊣ & ((end) => run_later(0)))(0))
    )
  )
) => { }
ex := (level input_part 0) as Expression
assert "!language   { }   {LHS} => {RHS}\n\n" as Expression -- .(
  .BOOTSTRAPPER.CAPTURE == `{ }`
  & .BOOTSTRAPPER.CAPTURES.LHS == `{LHS}`
  & .BOOTSTRAPPER.CAPTURES.RHS == `{RHS}`
)
// (its parts, each in turn)
assert {
  Ranged2 := class low: Decimal, "-", high: Decimal { }
  ranged2: Ranged2 = 3-8
  assert ranged2.high == 8  // ZZ1
  assert (`2-7` as Ranged2).high == 7  // ZZ2
  Ranged3 := class (low: Decimal, "-", high: Decimal) => { }
  ranged3: Ranged3 = 3-8
  assert ranged3.high == 8  // ZZ3
  Ranged4 := class (low: String+, "-", high: String+) => { }
  ranged4: Ranged4 = 3-8
  assert ranged4.high == "8"  // ZZ4
  Ranged5 := class (low: String+, `-`, high: String+) => { }
  ranged5: Ranged5 = 3-8
  assert ranged5.high == `8`  // ZZ5
  assert (`3-8` as Ranged5).high == `8`  // ZZ6
  Ranged6 := class (low: String+, \s, high: String+) => { }
  assert (`3 8` as Ranged6).high == `8`  // ZZ7
}
assert `{ }` is (String+, \s, String+)  // EX1 a hole's brackets around a space are not a capture
assert {
  Headed := class (head: `!language`, \s[]+, rest: String) => { }
  assert (`!language  x` as Headed).rest == `x`  // EX2 a text read as a structure does not give its last field what follows the space
}
assert {
  Captured := class (left: String+, \s, right: String+) => { }
  assert (`{ }` as Captured).left == `{`  // EX3 a text read as a structure does not give its first field the text before the space
}
assert {
  Inner := class (left: String+, \s, right: String+) => { }
  Outer := class (inner: Inner, `;`) => { }
  assert (`{ };` as Outer).inner.left == `{`  // EX4 a field of a structure is not read as its own structure
}
assert {
  Nested := class (inner: (left: String+, \s, right: String+), `;`) => { }
  assert (`{ };` as Nested).inner.right == `}`  // EX5 a field written as a structure is not read as one
}
assert {
  Spanned := class (spanned: (String+, \s, String+), `;`) => { }
  assert (`{ };` as Spanned).spanned == `{ }`  // EX6 a field written as positions does not take their span
}
assert `{LHS}` is `{ }`.map{== \s}(`LHS`)  // EX7 a text's space mapped to LHS does not read {LHS}
assert !(`{ }` is `{ }`.map{== \s}(`LHS`))  // EX9 a text's space mapped to LHS still reads the space
assert {
  Dependent := class (open: String, \s, close: open) => { }
  assert (`a a` as Dependent).close == `a`  // EX8 a field's type does not see a field before it
}
assert {
  Scoped := class (
    (
      statements: (
        Seen := 46
        Node := class (marked?: Node) => { mark := 1 }
        Inner := class (in?: Inner) => {
          rules := { got := (x) => Seen }
          made => Node()
        }
        got_seen := Inner().rules.got(0)
        made_mark := Inner().made.mark
        String
      )
    )
  ) => { }
  scoped := "x" as Scoped
  assert (external member (scoped) (`got_seen`)) == 46  // EX10 a closure in a class written in a header's statements does not see the header's names
  assert (external member (scoped) (`made_mark`)) == 1  // EX11 a class's `Node` written in a header's statements is the language's
}
// Optimizations of any program, before any back end: levels of rules from a Program to a Program, each answering what the
// program answers, each removable by name (Design §20.1: a level is a scope of rules). A back end's level comes after them
// (`$/Wasm.project.ray`: `Compiler.default + Wasm.none`).
Compiler := class {
  // What a level's rules ask of the code they read: each a Program, the code as it is written (its structure, what reads it),
  // matched by its shape. `~=` on a Program reads through what its code applies, each rule of it as written, so a call
  // reaches its body; an external a level replaces is what that level makes of it.
  // (what it does outside what it makes: says, reads or writes outside it, styles, changes the level it is read with)
  Effect := `external output` | `external include` | `external read` | `external style` | `external level_in` | `external level_out` | `external dynamic_in` | `external dynamic_out` | (`external member (`, *, `) (`, *, `) (`, *, `)`)
  // (a jump of it, and where to)
  Jump := (`external goto `, target: *, \n | ⊣)
  // (what does nothing outside what it makes: no effect, and every jump to a label written in it)
  Effectless := Program{!~= Effect && Compiler.jumps_within(.)}
  static jumps_within (code) => (code ~= Jump)#.every((jump) => code ~= (`external label `, jump.target))
  // (what reads what changes: a name given again, what is read from outside)
  Changing := (*, ` = `, *) | `external read`
  // (what answers the same for the same arguments, and nothing else happens: pure, as in mathematics)
  Pure := Effectless{!~= Changing}
  // (a value written as it is, and what is made of those alone)
  Literal := Decimal.String | ("\"", Unquoted[], "\"") | `true` | `false` | `None`
  Known := Literal | Pure{!~= Name}
  assert Program(code: { 1 + 2 }) is Pure  // CO50 two numbers added are not pure
  assert !(Program(code: { external output `x` }) is Effectless)  // CO51 what says something does nothing outside it
  assert !(Program(code: { x = 2 }) is Pure)  // CO52 a name given again is pure

  none := {
    {value} => value
  }
  // A level is which rules are in scope while a program is read back
  assert Compiler.none  // CO19 there is no level that reads a program as it is written

  // A number given what leaves it as it is: the number (a value of another class, with its own `+`, as written)
  folding := {
    {a: Number} + 0 => a
    0 + {a: Number} => a
    {a: Number} - 0 => a
    {a: Number} * 1 => a
    1 * {a: Number} => a
    {a: Number} / 1 => a
  }
  assert 5 + 0 == 5  // CO1 five and nothing is not five
  assert 0 + 5 == 5  // CO2 nothing and five is not five
  assert (0 + 0).is_zero  // CO13 nothing and nothing is not nothing
  // What is not written as one of those is untouched
  assert 5 + 2 == 7  // CO14 five and two is not seven
  assert 5 + 0 == 5  // CO18 five and a name holding nothing is not five
  assert {
    folded := 5
    assert (Program(code: { (folded + 0) === folded }){O: Compiler.folding})()  // CO42 a number and nothing is not the number itself under folding (the rule did not apply)
    Own_plus := class {
      compounds + (other) => "plus"
    }
    assert (Program(code: { Own_plus() + 0 }){O: Compiler.folding})() == "plus"  // CO43 a value with its own + was taken for a number
  }

  // A boolean negated twice: the boolean
  logic := {
    !!{a: boolean} => a
  }
  assert (Program(code: { !!true }){O: Compiler.logic})() === true  // CO44 true negated twice is not true under logic

  // Lists made only to be read again: none made (a list's own, an Array's; a value of another class, with its own `map`,
  // as written)
  fused := {
    {a: Array}.reverse.reverse => a
    {a: Array}.unique.unique => a.unique
    {a: Array}.compact.compact => a.compact
    {a: Array}.sort.sort => a.sort
    {a: Array}.map({f: Effectless}).map({g: Effectless}) => a.map((x) => g(f(x)))
    {a: Array}.map({f: Effectless}).count => a.count
    {a: Array}.sort({k: Pure}).last => a.max_by(k)
    {a: Array}.sort({k: Pure}).first => a.min_by(k)
    {a: Array}.reverse.first => a.last
    {a: Array}.reverse.last => a.first
    {a: Array}{`{`}{p: Effectless}{`}`}.first => a.find((x) => x.({p}))
    {s: Superposed}{`{`}{p: Effectless}{`}`}#.first => s.components.find((x) => x.({p}))
  }
  assert {
    twice_reversed := [1, 2]
    assert twice_reversed.reverse.reverse === twice_reversed  // CO38 a list reversed twice under the default level is a copy (the rule did not apply)
  }
  assert [3, 1, 2].sort.sort == [1, 2, 3]  // CO39 sorted twice under the default level is not sorted
  assert [1, 1, 2].unique.unique == [1, 2]  // CO40 unique twice under the default level is not unique
  assert [[1], [2]].flatten.flatten == [1, 2]  // CO29 flattened twice is not flattened once
  assert {
    Own_reverse := class {
      reverse => "reversed"
    }
    assert Own_reverse().reverse.reverse == "desrever"  // CO41 a class's own reverse, reversed twice, was taken for a list's
  }
  assert [1, 2, 3].map((x) => x + 1).map((x) => x * 2) == [4, 6, 8]  // CO53 two maps fused do not answer what they did one after the other

  // What nothing reads, made only when something does: a statement that does nothing outside what it makes and is not the
  // last, a name given what does nothing outside and read nowhere after; a style where nothing paints; where a value was
  // written, where nothing asks
  demanded := {
    {statement: Effectless}\n{rest} => rest
    {name} := {value: Effectless}\n{rest: Program{!~= `{name}`}} => rest
  }
  unpainted := {
    {shown} {`^`}{style} => shown
  }
  unlocated := {
    {located} @ {location} => located
  }

  memoised := {
    remembered := {}
    assert Compiler.memoised.remembered.fields.count == 1  // CO36 a pure application with the same arguments is not remembered once
    {f: Pure}({arguments: Known}) => remembered[(f, arguments)] ??= f(arguments)
  }
  // A pure application is remembered by its arguments; the level is removable
  assert Compiler.memoised  // CO33 there is no memoising level

  // Staging: what is known at build is worked out there: an operator on two known values, what it answers; a branch on a known
  // condition, the branch taken
  staged := {
    {a: Known} {operator} {b: Known} => ({a}) {operator} ({b})
    if true {then} else {otherwise} => then
    if false {then} else {otherwise} => otherwise
    if false {then} => None
  }
  assert (@ray 2 + 3) as Program{O: Compiler.staged} == (@ray 5)  // CS1 two known values added are not worked out at build
  assert (@ray if true { f() } else { g() }) as Program{O: Compiler.staged} == (@ray f())  // CS3 a known branch is not the branch taken
  // Control flow written by other control flow, so a back end has fewer to write
  lowered := {
    unless {condition} {then} => if !condition {then}
  }
  assert (@ray unless c { f() }) as Program{O: Compiler.lowered} == (@ray if !c { f() })  // CS2 unless is not written as if
  // A function written where it is applied: its parameters given what it is applied to, its body there; a block that declares
  // nothing, its statements where it is
  inlined := {
    (({parameters}) => {body})({arguments}) => {
      ({parameters}) := ({arguments})
      {body}
    }
    {`{`}{block: Program{!~= ` := `}}{`}`} => block
  }
  // What is never reached: after a return
  pruned := {
    return {value}\n{unreached} => return value
  }

  // A program as functions, what a back end writes: Expression's reading of it, its global node's statements the first, then
  // each of its rules' bodies, in order (a rule's body none until it is applied)
  called := {
    {read: Expression} => Array.new.append(read.global.statements).joined(read.global.rules.keyed.map((entry) => ((entry).kept.body.statements) ?? Array.new))
  }

  // The level the language is read with: each of these
  default := folding + logic + fused + lowered + pruned
  assert Compiler.default !== None  // CO20 there is no default level

  levels => [none, default, folding, logic, fused, demanded, unpainted, unlocated, memoised, staged, lowered, inlined, pruned]
  assert Compiler.levels.count == 13  // CO32 there are other than thirteen levels
  assert Compiler.levels.contains(Compiler.memoised)  // CO34 the memoising level is not one of the levels

  // (a level made of two, `A + B`: reduced by the first, then what that gives by the second)
  // (the value read where it is given, then reduced: not the code that gives it read at the level)
  // (a value, read by the level's own rules: one of one hole whose type it is (`{text: String} => …`) takes it)
  // (and by a level, the value its own argument: a list given beside another would be composed into it, one given by name
  // to a function is a declaration where it is written)
  static reducing (reducing_level) => (reducing_value) => (reducing_level is Compiler.Composition) ? Compiler.reducing(reducing_level.components.hierarchy.last)(Compiler.reducing(reducing_level.components.hierarchy.first)(reducing_value)) : ((external level_reads reducing_level reducing_value) ?? (reducing_level reducing reducing_value))
  static reduced (reduced_value, level) => Compiler.reducing(level)(reduced_value)
  // (a level as a scope, what the language is read with: one made of each of its parts, the first's rules seen first)
  static scope_of (scope_level) => (scope_level is Compiler.Composition) ? level_scope_of(scope_level) : scope_level
  // (a closure run with a level in scope: its code read with the level's rules first, in this thread, until it answers)
  static run_under (run_closure, run_level) => {
    external level_in Compiler.scope_of(run_level)
    run_answer := run_closure()
    external level_out
    run_answer
  }
  Composition := class (first, second) => {
    components => (hierarchy: [first, second])
    // (and another after it, `A + B + C`: the three, in that order)
    compounds + (other) => Compiler.Composition(this, other)
    // (called: what was added, called)
    {this}({arguments}) =>
      (this).second({arguments})
    {this}() =>
      (this).second()
  }
}
Node &+= {
  composed (other) => Compiler.Composition(this, other)
  // (§3.2 `A + B`, what has no `+` of its own: the two composed, a level of them (reduced by A, then B); led by the value,
  // read only on one: `+ 1` alone is a section)
  {this} + {other} => (this).composed(other)
}
// (of a composition, `A + B`: a scope of its own given each part's rules, the second's, then the first's, so the first's are
// seen first; a node made of nothing else, what a function called bare (not in a method, which would make it of what that
// method is read on) makes to run in, each time: not made of Node, whose rules would be read first everywhere)
level_scope (level_none) => (.)
level_scope_of (scope_level) => level_scope_given(level_scope(None), scope_level)
level_scope_given (scope_made, scope_level) => (scope_level is Compiler.Composition) ? level_scope_given(level_scope_given(scope_made, (scope_level).second), (scope_level).first) : ((scope_made) &+= (scope_level))
// A program written as code, `Program(code: { … })`: the code kept as written, read when it runs (a block given to it is
// read where it is written, into a node: nothing to run again)
// (its code read when it runs: given a level, read on it, its rules seen in that code and not in what it calls)
Program(code: {`{`}{program_code}{`}`}) ^keyword => Program(running: ((program_scope = None) => (program_scope === None) ? ({program_code}) : (Compiler.scope_of(program_scope)).({program_code})), read_on_level: true)
// (a setting, `p{O: level}`: the same program (of the class, a new one), read with that level)
{setting_of}{`{`}O: {level}{`}`} ^punctuation => Program(code: (setting_of).code, running: (setting_of).running, read_on_level: (setting_of).read_on_level) ~~ (.O = ({level}))
// (and written with its level, `Program(code: { … }){O: L}`: read on L as written there)
Program(code: {`{`}{program_code}{`}`}){`{`}O: {program_level}{`}`} ^keyword => Program(running: ((program_scope = None) => (Compiler.scope_of({program_level})).({program_code})), read_on_level: true) ~~ (.O = ({program_level}))
// (what a program answers when called (outside Program, whose `{this}()` would read its `running()`): its code run (read on its level when it was written with one, else under it), what
// that answers read by the level; given by name, a list it answers is not composed into the level after it)
program_answered (answered_program) => {
  answered_level := (answered_program).O
  answered_value := ((answered_program).running === None) ? (answered_program).code : ((answered_level === Compiler.none) ? (answered_program).running() : (((answered_program).read_on_level === true) ? (answered_program).running(answered_level) : Compiler.run_under((answered_program).running, answered_level)))
  (((answered_program).running === None) || (answered_level === Compiler.none)) ? answered_value : Compiler.reducing(answered_level)(answered_value)
}
Program &+= {
  O | optimizations := Compiler.none
  read_on_level := false
  assert (Program{O: Compiler.default}).(
    .  // CO21 a program read with a level is nothing
    & .O == Compiler.default  // CO22 it does not say which rules it is read with
    & .optimizations  // CO23 O is not what the optimizations are called
  )
  assert {
    twice := (x) => x * 2
    assert Program(code: { twice(4) + twice(4) }){O: Compiler.memoised}() == 16  // CO35 a remembered application does not answer what it answered
  }
  assert {
    shouted := { {a} !!! => a * 100 }
    assert (Program(code: { 3 !!! }){O: shouted})() == 300  // CO36 a program is not read with its level's rules
    assert (Program(code: { 2 + 3 }){O: shouted})() == 5  // CO37 a program read with a level does not read the language too
  }
  assert {
    boxed := { {text: String} => 7 }
    assert Compiler.reduced("Ray", boxed) == 7  // CO46 a value is not read by a level's rule of one hole of its type
    assert Compiler.reduced(3, boxed) == 3  // CO47 a value of another type is read by a level's rule of one hole
  }
  // (its code run with its level's rules in scope (in its program, above what is where it is written), what it gives read by them)
  // (the code as it is written, kept to be read again when it runs (`running`, none until given: a block is read where it is
  // written, into a node))

  {this}() => program_answered(.)
  compounds + (other: Program) => Program(code: (code, other.code))
  assert 5 /* nothing */ + 1 == 6  // GR8 a block comment between operands is read as something
  assert {
    {start} - {once} - {twice} => (start - once) - twice
    assert 10 - 2 - 3 == 5  // PR1 ten less two less three is not five
    assert (10 + 10) - 4 - 6 == 10  // PR2 twenty less four less six is not ten
  }
  assert 1 + 2 == 3  // PR7 one and two is not three
  assert 1 + 2 + 3 == 6  // PR12 three added is not six
  assert 2 * 3 + 1 == 7  // PR23 two times three and one is not seven
  assert 1 + 2 * 3 == 7  // PR24 one and two times three is not seven
  assert 1 + 2 < 4  // PR28 one and two is not below four
  assert !(4 < 1 + 2)  // PR29 four is below one and two
  assert 1 + 2 == 3  // PR30 one and two is not three
  assert 3 == 1 + 2  // PR31 three is not one and two
  assert 1 + 2 >= 3  // PR33 one and two is not at least three
  assert !(1 + 2 > 4)  // PR34 one and two is above four
  assert 4 >= 1 + 2  // PR35 four is not at least one and two
  assert "a" + "b" == "ab"  // S6 a + b != ab
  assert "ab" + "c" == "abc"  // S61 ab and c do not make abc
}
assert Program(code: { 5 }).(
  .O == Compiler.none  // CO24 a program does not read as written unless told otherwise
  & .() == 5  // CO25 a program read as it is written does not answer it
)

assert !!5 == true  // CO31 not not five is not true

// (what the bootstrap leaves to this file: it needs what is here)
Cases := Program{written.nonempty && written.every(.code ~= (*, " => ", *))}
assert {
  matched := if 2 {
    1 => "one"
    2 => "two"
  }
  assert matched == "two"  // NOD54 a case on a value does not take the arm that matches
  assert !(matched == "one")  // NOD55 a case took the first arm that does not match
  other := if 9 {
    1 => "one"
  } else {
    "other"
  }
  assert other == "other"  // NOD56 a case with no matching arm does not take the else
}
if &+= {
  { }{subject} {{cases: Cases}} else {{otherwise}} ^keyword => Compiler.reduced(subject, (Program(code: cases**) as Compiler) + Program(code: otherwise**).otherwise)
  { }{subject} {{cases: Cases}} ^keyword => Compiler.reduced(subject, Program(code: cases**) as Compiler)
}
Program &+= {
  as (=== Compiler) => Program(code: written.map**(.code ~= (case: *, " => ", value: *) -- (arm => "{subject_of_case: ", (arm.case ~= ("is ", type: *)).type
    ?? ((arm.case as Program)() is Section ? ("*{", arm.case, "}") : ("*{== ", arm.case, "}")), "} => ", arm.value)).join(\n))
  otherwise => ("{subject_of_case: *} => (", code, ")") as String as Program as Compiler
}
String &+= {
  escaped_line => #.map(Compiler.reduced(., Escape⁻¹)) as String
}
// The level the language is read with, unless a project said otherwise: the default.
external member (global) (`O`) ((O === None) ? Compiler.scope_of(Compiler.default) : O)
// (`|` written alone, a type (`{superposed: |}`): the edge it decorates (the rule a component on it), what such edges join
// of it; last, after everything that writes `a | b`, which it would read otherwise)
| => superposed_edge
// (and `,` alone (`{inline: ,}`): the edge that links values)
, => composed_edge
// Runtime: what a program runs on, whatever runs it: the kinds of value a run holds, how a name is found, how a call runs,
// how a text is read by a pattern and where a statement in it ends. Each kind is written as what it is made of, in order
// (its header): the back end lays it out so (one word each, the first its tag when it has one), and a function here reads
// and writes them by name. What is an optimization (fields indexed once a node holds many, what a call made let go when it
// returns, rules found by the text they lead with) is a level, after it, each removable; the back end is given it, and
// the levels, written for it (`$/Wasm.project.ray`'s `Lowering`).
Runtime := class {
  // The language's own values, as the back end holds them: nothing, false and true; a number, twice itself and one.
  static None := 0
  static false := 8
  static true := 12
  // (a yes or no of the back end's, as the language's; and whether a value is not nothing nor false)
  static boolean (c) => c ? true : false
  static truthy (v) => (v != None) && (v != false)
  static same (a, b) => Runtime.boolean(a === b)

  // A number, held as twice itself and one: apart from where any value of a kind is (an even word).
  static int (n) => (n + n) + 1
  static untag (v) => v >> 1
  static plus (a, b) => (a + b) - 1
  static minus (a, b) => (a - b) + 1
  static times (a, b) => Runtime.int(Runtime.untag(a) * Runtime.untag(b))
  static quotient (a, b) => Runtime.int(Runtime.untag(a) / Runtime.untag(b))
  static remainder (a, b) => Runtime.int(Runtime.untag(a) % Runtime.untag(b))
  static less (a, b) => Runtime.boolean(a < b)
  static greater (a, b) => Runtime.boolean(a > b)
  static less_equal (a, b) => Runtime.boolean(a <= b)
  static greater_equal (a, b) => Runtime.boolean(a >= b)

  // A node: what it is in, which is asked what it does not hold; its fields, the latest first; its keys, in the order
  // given; and its fields indexed by name, once it holds many.
  static Node := (1, in: Node, fields: Field, keys: List, index)
  static Field := (next: Field, name, value)
  // (the field of a name: its own, or what it is in has; none anywhere, nothing. What it holds by a name is its own field
  // of it, `own`)
  static found (node: Node, name) => (node === None) ? None : Runtime.found_in(own(node, name), node, name)
  static found_in (field: Field, node: Node, name) => (field === None) ? Runtime.found(node.in, name) : field
  static lookup (node: Node, name) => Runtime.value_of(Runtime.found(node, name))
  static value_of (field: Field) => (field === None) ? None : field.value
  // (a name given a value in the node itself: a field of it added, the latest, unless it has one; or where it is found,
  // else in the node)
  static define (node: Node, name, value) => Runtime.defined(own(node, name), node, name, value)
  static defined (field: Field, node: Node, name, value) => (field === None) ? Runtime.added(Field(next: node.fields, name: name, value: value), node) : Runtime.given(field, value)
  static added (field: Field, node: Node) => {
    node.fields = field
    field.value
  }
  static given (field: Field, value) => (field.value === value) ? value : Runtime.given_again(field, value)
  static given_again (field: Field, value) => {
    field.value = value
    value
  }
  static assign (node: Node, name, value) => Runtime.assigned(Runtime.found(node, name), node, name, value)
  static assigned (field: Field, node: Node, name, value) => (field === None) ? Runtime.define(node, name, value) : Runtime.given(field, value)

  // A list: how many it holds, how many it has room for, and what it holds, one word each.
  static List := (3, count, room, items: Words)
  static list => List()
  static at (list: List, index) => list.items[index]
  static append (list: List, value) => {
    Runtime.room_made(list, Words(Runtime.more_room(list.room)), Runtime.more_room(list.room)) if list.count == list.room
    list.items[list.count] = value
    list.count = list.count + 1
    list
  }
  // (room for twice as many, at least four, what it holds moved there)
  static more_room (room) => (room == 0) ? 4 : (room * 2)
  static room_made (list: List, items: Words, room) => {
    Runtime.moved(items, list.items, list.count)
    list.items = items
    list.room = room
  }
  // (lists of lists: all but the first, one after another, each given to a function, what it answers of each, a member
  // of each, sorted by what it answers (equal ones kept in order))
  static joined (a, b) => Runtime.appended_from(Runtime.appended_from(list(), a, 0), b, 0)
  static appended_from (o: List, l: List, from) => {
    i := from
    while i < l.count {
      append(o, l.items[i])
      i = i + 1
    }
    o
  }
  static each (l: List, f) => {
    i := 0
    while i < l.count {
      call1(f, l.items[i])
      i = i + 1
    }
    l
  }
  static each_value (l: List, f) => {
    o := list()
    i := 0
    while i < l.count {
      append(o, call1(f, l.items[i]))
      i = i + 1
    }
    o
  }
  static mapped (l: List, name) => {
    o := list()
    i := 0
    while i < l.count {
      append(o, member(l.items[i], name))
      i = i + 1
    }
    o
  }
  static sorted (l, f) => Runtime.sorted_in(Runtime.appended_from(list(), l, 0), f)
  static sorted_in (o: List, f) => {
    i := 1
    while i < o.count {
      Runtime.inserted(o, f, o.items[i], call1(f, o.items[i]), i - 1)
      i = i + 1
    }
    o
  }
  static inserted (o: List, f, x, kx, from) => {
    j := from
    while (j >= 0) && (call1(f, o.items[j]) > kx) {
      o.items[j + 1] = o.items[j]
      j = j - 1
    }
    o.items[j + 1] = x
  }
  static moved (to: Words, from: Words, count) => {
    i := 0
    while i < count {
      to[i] = from[i]
      i = i + 1
    }
  }

  // A function as a value: what it runs, the node it was written in, and how it is called (0 as it is, 1 read as a value:
  // a getter); a class, the same, its header in place of how it is called.
  static Closure := (2, function, env, called)
  static closure (f, env) => Closure(function: f, env: env)
  static getter (f, env) => Closure(function: f, env: env, called: 1)
  static Class := (5, function, env, header)
  static classh (f, env, h) => Class(function: f, env: env, header: h)

  // A text: where it starts in what a run holds, and where it ends.
  static Text := (4, from, to)
  static text (a, e) => Text(from: a, to: e)

  // A pattern: what a text is read as. How, its kind says, what with, its parts: a literal (its text), characters (the
  // text of those it takes), a sequence or an either (the list of what is read in turn, or of what is tried in turn),
  // a repeat (what is repeated, and the least number of times), a field (its name, and what it takes), the end of the
  // text, anything.
  static literally := 1
  static characters := 2
  static in_sequence := 3
  static either_of := 4
  static repeating := 5
  static named_field := 6
  static at_end := 7
  static anything_at_all := 8
  // (and, of what reading notes as it goes: the rest of a sequence, from where; a repeat, chosen again; a field read up to
  // here; the rules of a node, read; a class header; what a class constructs, and what an application makes, of what
  // was read; a statement, read; a value read again as a pattern; a pattern read by a function, and its value given it;
  // a repeat's next; the holes read, as a list; the end of a statement; read by a function, with or without a value
  // given; any text, up to a byte)
  static rest_from := 9
  static repeat_from := 10
  static field_end := 11
  static rules_of := 12
  static class_header := 13
  static constructed := 14
  static applied := 15
  static with_function := 16
  static typed_by := 17
  static reread := 18
  static functioned := 19
  static function_given := 20
  static repeat_next := 21
  static holes_listed := 22
  static statement_ending := 23
  static typed_with := 27
  static hole := 28
  static Pattern := (6, kind, a, b, c, d)
  static pattern (kind, a, b) => Pattern(kind: kind, a: a, b: b)
  static literal (t) => Pattern(kind: literally, a: t)
  static chars (c) => Pattern(kind: characters, a: c)
  static sequence (l) => Pattern(kind: in_sequence, a: l)
  static either (l) => Pattern(kind: either_of, a: l)
  // (repeated any number of times: of a repeat, the same; of what a repeat is of, at least as many times as it says)
  static repeated (inner: Pattern, least) => ((least == 0) && (inner is Pattern) && (inner.kind == repeating)) ? Pattern(kind: repeating, a: inner.a) : Pattern(kind: repeating, a: inner, b: least)
  static field (name, inner) => Pattern(kind: named_field, a: name, b: inner)
  static ending => Pattern(kind: at_end)
  static anything => Pattern(kind: anything_at_all)
  static greedy (inner: Pattern, least) => ((least == 0) && (inner is Pattern) && (inner.kind == repeating)) ? Pattern(kind: repeating, a: inner.a, c: 1) : Pattern(kind: repeating, a: inner, b: least, c: 1)
  static dynamic (f) => Pattern(kind: rules_of, a: f)
  static conj (p, f) => Pattern(kind: with_function, a: p, b: f)

  // Where a statement ends. The text read is the run's (up to its `textend`), a byte of it at a time (the back end's
  // `byte`); a byte is of a class (the back end's `char_class`): 2 a quote, 3 a closing bracket. A statement read from
  // pos ends, read on from at, at the end of the first line after which the next one, not blank, is indented no deeper
  // than the statement's first line, starts with no closing bracket, does not follow a line ending with a comma, and
  // leaves no quote open; else at the end of the text.
  static statement_end (pos, at) => Runtime.ended_from(at, Runtime.line_end(at), Runtime.indent_at(Runtime.line_start(pos, at)))
  static ended_from (at, from, depth) => {
    q := from
    while q < textend {
      return q if Runtime.ends_there(at, q, depth, Runtime.indent_at(q + 1))
      q = Runtime.line_end(q + 1)
    }
    textend
  }
  static ends_there (at, q, depth, indent) => Runtime.ends_before(at, q, Runtime.byte_or_line(q + 1 + indent), (indent <= depth))
  static ends_before (at, q, c, shallow) => (c != 10) && shallow && (char_class(c) != 3) && (comma_ended(at, q) == 0) && (Runtime.quote_open(at, q) == 0)
  static byte_or_line (q) => (q < textend) ? byte(q) : 10
  static line_start (pos, from) => {
    q := from
    while (q > pos) && (byte(q - 1) != 10) {
      q = q - 1
    }
    q
  }
  static line_end (from) => {
    q := from
    while (q < textend) && (byte(q) != 10) {
      q = q + 1
    }
    q
  }
  static indent_at (from) => {
    d := 0
    while ((from + d) < textend) && ((byte(from + d) == 32) || (byte(from + d) == 9)) {
      d = d + 1
    }
    d
  }
  static white_after (from) => {
    q := from
    while (q < textend) && white(byte(q)) {
      q = q + 1
    }
    q
  }
  // (whether a quote opened from a is not closed before n)
  static quote_open (a, n) => {
    q := a
    while q < n {
      return 1 if Runtime.opens_quote(q) && ((pair_end(q) == 0) || (pair_end(q) > n))
      q = Runtime.opens_quote(q) ? pair_end(q) : (q + 1)
    }
    0
  }
  static opens_quote (q) => (char_class(byte(q)) == 2) && (pair_class(q) == 2)
  // (whether the line through n goes on past its end: it ends with a comma, or the next line, not blank, is indented
  // deeper or starts with a closing bracket)
  static continued_at (n) => Runtime.continued_after(Runtime.text_line_start(n), n, Runtime.indent_at(n + 1))
  static continued_after (q, n, j) => (comma_ended(q, n) != 0) || (((n + (1 + j)) < textend) && (byte(n + (1 + j)) != 10) && ((j > Runtime.indent_at(q)) || (char_class(byte(n + (1 + j))) == 3)))
  static text_line_start (from) => {
    q := from
    while (q > 0) && (byte(q - 1) != 10) && (byte(q - 1) != 0) {
      q = q - 1
    }
    q
  }
  static comma_ended (a, from) => {
    n := from
    while (n > a) && white(byte(n - 1)) {
      n = n - 1
    }
    (n > a) && (byte(n - 1) == 44)
  }

  // Pairs: what a bracket or a quote opens, and where it is closed. A byte's class (1 an opening bracket, 2 a quote, 3 a
  // closing one) holds unless an odd number of backslashes before it escapes it. Where a pair ends is kept by the back
  // end once found (`pair_end`); found, a quote ends at the next of its byte not escaped, a bracket where as many have
  // closed as opened in it, what is quoted in it passed over; never, at 0.
  static pair_class (q) => ((char_class(byte(q)) == 0) || ((Runtime.backslashes(q) % 2) == 1)) ? 0 : char_class(byte(q))
  static backslashes (q) => {
    n := 0
    while (q > (n + 1)) && (byte((q - n) - 1) == 92) {
      n = n + 1
    }
    n
  }
  static quote_ending (q, c) => {
    x := q + 1
    while x < textend {
      return x + 1 if byte(x) == c
      x = (byte(x) == 92) ? (x + 2) : (x + 1)
    }
    0
  }
  static bracket_ending (q) => {
    depth := 0
    x := q
    while x < textend {
      return 0 if (Runtime.class_at(x) == 2) && (pair_end(x) == 0)
      depth = depth + Runtime.opened(Runtime.class_at(x))
      return x + 1 if (Runtime.class_at(x) == 3) && (depth == 0)
      x = (Runtime.class_at(x) == 2) ? pair_end(x) : (x + 1)
    }
    0
  }
  static class_at (x) => (char_class(byte(x)) == 0) ? 0 : pair_class(x)
  static opened (t) => (t == 1) ? 1 : ((t == 3) ? (0 - 1) : 0)
  // (where a string read up to n ends: in a pair opened just before n, where it closes; just after one closed, never)

  // Reading: a pattern read from a place in the text, then what is still to read after it (a cell of a pattern to read,
  // or the rest of a sequence, from where), answering where the whole reading ended, or −1. Where there is a choice (of
  // an either, how many times a repeat goes, how far a hole or anything reads), each way is read on in turn, nearest
  // first, and the first to answer is the answer: going back is returning. Before each way, what was bound, which rules
  // were being read, and the memory taken are as they were (what was taken let go, unless something was written
  // meanwhile); what a binding wrote over is put back when what follows it does not read.
  static Cell := (what, next)
  static Rest := (list, next, index)
  static Bound := (aside, hole, start, end, held)
  static matched (pattern, from, then) => {
    fueled()
    return 0 - 1 if stopped()
    was_start := rstart
    om := markf
    fr := free
    ef := effects
    an := activen
    bn := boundn
    rstart = from
    markf = free
    result := Runtime.pattern_read(pattern, from, then)
    rstart = was_start
    activen = an
    markf = om
    Runtime.unbound(bn, fr, ef) if result < 0
    result
  }
  // (failed: what it bound left out, and, when nothing was written meanwhile, the memory it took)
  static unbound (bn, fr, ef) => {
    boundn = bn
    Runtime.left_alone(fr) if (effects == ef) && (noreclaim == 0)
  }
  static left_alone (fr) => {
    starts_cleared(fr, free)
    freed_back(fr)
  }
  // (a way tried again: as it was when the choice began)
  static ways_retried (bn, an, fr, ef) => {
    boundn = bn
    activen = an
    freed_back(fr) if (free > fr) && (effects == ef) && (noreclaim == 0)
    markf = fr
    0
  }
  // (read on: done when nothing follows; else what follows, and after it what follows that)
  static onward (k: Cell, at) => (k === None) ? at : ((k.what is List) ? Runtime.rest_read(k, at) : Runtime.pattern_read(k.what, at, k.next))
  static rest_read (k: Rest, at) => Runtime.items_read(k.list, k.index, at, k.next)
  static items_read (l: List, i, at, k) => (i >= l.count) ? Runtime.onward(k, at) : Runtime.pattern_read(l.items[i], at, ((i + 1) < l.count) ? Rest(list: l, next: k, index: i + 1) : k)

  // (a pattern read: what its kind reads; read as a pattern if it is not one)
  static pattern_read (p, at, k) => Runtime.kind_read((p is Pattern) ? p : topattern(p), at, k)
  static kind_read (p: Pattern, at, k) => (p.kind == rest_from) ? Runtime.items_read(p.a, p.b, at, k) : ((p.kind == literally) ? Runtime.literal_read(p.a, at, k) : ((p.kind == characters) ? (((at < textend) && chared(byte(at), p.a) && ((p.a != 4) || continued_at(at))) ? Runtime.onward(k, at + 1) : (0 - 1)) : ((p.kind == in_sequence) ? Runtime.items_read(p.a, 0, at, k) : ((p.kind == either_of) ? Runtime.either_from(p.a, at, k) : ((p.kind == hole) ? Runtime.hole_ways(p, at, k) : ((p.kind == anything_at_all) ? Runtime.anything_from(at + 1, k) : ((p.kind == repeat_from) ? Runtime.repeat_read(p.a, p.b, p.c, at, k) : ((p.kind == repeat_next) ? ((at == p.c) ? ((p.b <= 0) ? Runtime.onward(k, at) : (0 - 1)) : Runtime.repeat_read(p.a, p.b, p.d, at, k)) : ((p.kind == repeating) ? Runtime.repeat_read(p.a, p.b, p.c, at, Cell(what: Pattern(kind: holes_listed, a: boundn), next: k)) : ((p.kind == named_field) ? Runtime.pattern_read(p.b, at, Cell(what: Pattern(kind: field_end, a: p.a, b: at, c: boundn, d: p.b), next: k)) : ((p.kind == field_end) ? Runtime.field_closed(p, at, k, boundn, saved(p.c)) : ((p.kind == holes_listed) ? Runtime.holes_closed(p.a, at, k, saved(p.a), boundn) : ((p.kind == constructed) ? Runtime.value_bound(p.b, saved(p.b), boundn, construct(p.a, list(), named_from(p.b)), at, k) : ((p.kind == applied) ? Runtime.value_bound(p.b, saved(p.b), boundn, Runtime.defined_as(Runtime.application_of(p.a, p.b, member(p.a, Symbol.value)), 47, text(p.c, at)), at, k) : ((p.kind == rules_of) ? ((reading_at(p, at) == 0) ? Runtime.rules_read(p, at, k) : (0 - 1)) : ((p.kind == class_header) ? ((reading_at(p.a, at) == 0) ? Runtime.header_read(p, at, k) : (0 - 1)) : ((p.kind == with_function) ? Runtime.pattern_read(Runtime.with_pattern(p.a), at, k) : ((p.kind == reread) ? Runtime.pattern_read(rebuilt(p.a), at, k) : ((p.kind == functioned) ? Runtime.functioned_read(p, p.a, at, k) : ((p.kind == function_given) ? Runtime.function_read(p, saved(p.c), boundn, valued_from(p.c), at, k) : ((p.kind == statement_ending) ? ((p.b == 2) ? Runtime.statement_marked(k, at) : (((at == textend) || ((byte(at) == 10) && (open_before(rstart, at) == 0) && ((continued_from((p.b == 1) ? p.a : rstart, at) == 0) || (continued_from(at, at) == 0)))) ? Runtime.onward(k, at) : (0 - 1))) : ((p.kind == typed_by) ? Runtime.pattern_read(topattern(call(p.a, append(list(), named_from(0)), 0)), at, k) : ((p.kind == at_end) ? ((at == textend) ? Runtime.onward(k, at) : (0 - 1)) : ((p.kind == typed_with) ? Runtime.pattern_read(topattern(call(p.a, append(list(), p.b), 0)), at, k) : (0 - 1)))))))))))))))))))))))))
  // (a literal, there: a bracket only where it pairs)
  static literal_read (t: Text, at, k) => Runtime.literal_of(t, t.to - t.from, at, k)
  static literal_of (t: Text, n, at, k) => (((at + n) <= textend) && texteq(at, t.from, n) && ((n == 0) || (char_class(byte(at)) == 0) || (pair_class(at) != 0))) ? Runtime.onward(k, at + n) : (0 - 1)
  // (an either: each of its ways in order; anything among them a byte, where no other way reads further)
  static either_from (l: List, at, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
    r := 0 - 1
    j := 0
    while (j < l.count) && (r < 0) {
      Runtime.ways_retried(bn, an, fr, ef)
      r = Runtime.either_one(l, j, at, k, l.items[j])
      j = j + 1
    }
    r
  }
  static either_one (l: List, j, at, k, c: Pattern) => (c.kind == anything_at_all) ? (((at < textend) && (read_by_another(l, j, at) == 0) && ((at + 1) > 0)) ? Runtime.onward(k, at + 1) : (0 - 1)) : Runtime.pattern_read(c, at, k)
  // (anything: a byte more at a time, not past a line's end)
  static anything_from (n0, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
    n := n0
    r := 0 - 1
    while (r < 0) && (n <= textend) && (byte(n - 1) != 10) {
      Runtime.ways_retried(bn, an, fr, ef)
      r = Runtime.onward(k, n)
      n = n + 1
    }
    r
  }
  // (a repeat: once more, or not; at least as many as it says; greedy, more first)
  static repeat_read (inner, least, greedy, at, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
    r := ((least <= 0) && (greedy == 0)) ? Runtime.onward(k, at) : (0 - 1)
    Runtime.ways_retried(bn, an, fr, ef) if r < 0
    r = (r < 0) ? Runtime.pattern_read(inner, at, Cell(what: Pattern(kind: repeat_next, a: inner, b: least - 1, c: at, d: greedy), next: k)) : r
    Runtime.ways_retried(bn, an, fr, ef) if r < 0
    r = ((r < 0) && (least <= 0) && (greedy != 0)) ? Runtime.onward(k, at) : r
    r
  }
  // (a hole: what it takes, a byte, a pair, a text a rule leads with, at a time, up to where it may not go on: a line
  // end the statement does not go on past, and as it says (its mode): 0 anywhere, 1 on one line up to its byte, a quote
  // not crossed, 2 up to its byte, 3 not past a space; its next end, −1 none, or below that one it closes at)
  static hole_ways (p: Pattern, at, k) => {
    bn := boundn
    an := activen
    fr := free
    ef := effects
