Ordered := class {
  chainable < (other: Ordered) => TODO

  chainable > (other: Ordered) => other < this
  chainable <= (other: Ordered) => (other < this).not
  chainable >= (other: Ordered) => (this < other).not

  min (other: Ordered) => (
    smaller := other
    if (this < other) { smaller = this }
    smaller
  )
  max (other: Ordered) => (
    larger := this
    if (this < other) { larger = other }
    larger
  )
}

Iterable := class: Ordered {
  entry => TODO

  empty => .count.is_zero
  nonempty => .empty.not

  bounded => true
  unbounded => .bounded.not
  orderless => false

  count => (
    entries_counted := 0
    if (.entry) { entries_counted = .entry.count }
    entries_counted
  )

  first => .entry.first
  last => .entry.last

  for (body) => if (.entry) { .entry for body } else { this }

  every (predicate) => (
    for {
      unless (inline predicate) { return false }
    }
    true
  )
  some (predicate) => (
    for {
      if (inline predicate) { return true }
    }
    false
  )

  .reduce(({accumulator ^parameter}){ }{`=>`}{ }{step}) ^punctuation => (
    names ^keyword := external ** accumulator
    step_written ^keyword := external ** step
    accumulated ^keyword := None
    started ^keyword := false
    for {
      if started {
        entering ^keyword := chain None
        entering.target = it.value
        external define entering.target `reduce_step{arguments}` {
          (inline names) := arguments
          inline step_written
        } accumulator
        accumulated = entering.target.reduce_step(accumulated)
      } else {
        accumulated = it.value
        started = true
      }
    }
    accumulated
  )
  .reduce({literal operator ^operator}) ^punctuation => (
    accumulated ^keyword := None
    started ^keyword := false
    for {
      if started { accumulated = accumulated[operator] it.value } else {
        accumulated = it.value
        started = true
      }
    }
    accumulated
  )
  .reduce({accumulator ^parameter}{ }{`=`}{ }{initial}{ }{`=>`}{ }{step}) ^punctuation => (
    names ^keyword := external ** accumulator
    step_written ^keyword := external ** step
    accumulated ^keyword := initial
    for {
      entering ^keyword := chain None
      entering.target = it.value
      external define entering.target `reduce_step{arguments}` {
        (inline names) := arguments
        inline step_written
      } accumulator
      accumulated = entering.target.reduce_step(accumulated)
    }
    accumulated
  )

  all => (
    superposed ^keyword := None
    for {
      if (superposed) { superposed = superposed | it.value } else { superposed = it.value }
    }
    superposed
  )

  min => (
    smallest ^keyword := None
    at_start ^keyword := true
    for {
      if at_start { smallest = it.value } elsif (it.value < smallest) { smallest = it.value }
      at_start = false
    }
    smallest
  )
  max => (
    largest ^keyword := None
    at_start ^keyword := true
    for {
      if at_start { largest = it.value } elsif (largest < it.value) { largest = it.value }
      at_start = false
    }
    largest
  )

  compounds * (times: Number) => (
    out ^keyword := chain None
    left ^keyword := times
    while left.nonzero {
      for { out &= it.value }
      left = left.pred
    }
    out
  )

  fill (x) => for { it.value = x }

  compact => this{this}

  map (mapping) => (
    mapped ^keyword := chain None
    for { mapped &= (inline mapping) }
    mapped
  )

  reverse => (
    walked ^keyword := chain None
    for { walked &= it.value }
    turned ^keyword := chain None
    back ^keyword := walked.tail
    while (back) {
      turned &= back.value
      back = back.previous
    }
    turned
  )

  sort => (
    left ^keyword := chain None
    for { left &= it.value }
    ordered ^keyword := chain None
    smallest ^keyword := None
    walker ^keyword := None
    while left.nonempty {
      smallest = left.head
      walker = left.head.next
      while (walker) {
        if (walker.value < smallest.value) { smallest = walker }
        walker = walker.next
      }
      ordered &= smallest.value
      left.unlink(smallest)
    }
    ordered
  )

  contains (x) => (
    for { if (it.value == x) { return true } }
    false
  )
  includes (x) => .contains(x)

  unique => (
    kept ^keyword := chain None
    for {
      unless (kept.contains(it.value)) { kept &= it.value }
    }
    kept
  )

  partition (predicate) => (
    held ^keyword := chain None
    rest ^keyword := chain None
    for {
      verdict := inline predicate
      if verdict { held &= it.value } else { rest &= it.value }
    }
    halves ^keyword := chain None
    halves &= held
    halves &= rest
    halves
  )

  chunk (size: Number) => (
    runs ^keyword := chain None
    run ^keyword := chain None
    left ^keyword := size
    for {
      run &= it.value
      left = left.pred
      if left.is_zero {
        runs &= run
        run = chain None
        left = size
      }
    }
    if run.nonempty { runs &= run }
    runs
  )
  batch (size: Number) => .chunk(size)

  flatten => (
    flat ^keyword := chain None
    for {
      inner := it.value
      spliced ^keyword := false
      if (inner.instance_of(Array)) { spliced = inner.bounded }
      if spliced { inner.flatten for { flat &= it.value } } else { flat &= inner }
    }
    flat
  )
  flatten (levels: Number) => (
    flat ^keyword := chain None
    for {
      inner := it.value
      spliced ^keyword := false
      if (inner.instance_of(Array)) { spliced = inner.bounded }
      if levels.is_zero { spliced = false }
      if spliced { inner.flatten(levels.pred) for { flat &= it.value } } else { flat &= inner }
    }
    flat
  )

  intersection (other) => (
    both ^keyword := chain None
    for {
      if (other.contains(it.value)) { unless (both.contains(it.value)) { both &= it.value } }
    }
    both
  )
  disjoint (other) => .intersection(other).empty

  symmetric_difference (other) => (
    either ^keyword := chain None
    for {
      unless (other.contains(it.value)) { either &= it.value }
    }
    mine ^keyword := this
    other for {
      unless (mine.contains(it.value)) { either &= it.value }
    }
    either
  )

  at (index: Number) => .entry.at(index)

  paths => this
  length => .paths.count

  connected => true
  consistent => true
  acyclic => .entry.acyclic
  undirected => false
  unidirectional => false
}

Iterable.components.hierarchy &= class {
  sum => (
    total ^keyword := 0
    this for { total = total + it.value }
    total
  )
  product => (
    total ^keyword := 1
    this for { total = total * it.value }
    total
  )
}

Iterable.components.hierarchy &= class {
  random => .at(Random.below(.count))
}
Σ{ }{iterable} ^keyword => (iterable).sum
∑{ }{iterable} ^keyword => (iterable).sum
∏{ }{iterable} ^keyword => (iterable).product

Ray := class: Iterable {
  entry => this

  is_initial => (.previous).not
  is_terminal => (.next).not

  is_first => .is_initial
  is_last => .is_terminal

  initial => (
    walker := this
    while walker.is_initial.not { walker = walker.previous }
    walker
  )
  terminal => (
    walker := this
    while walker.is_terminal.not { walker = walker.next }
    walker
  )

  first => .initial
  last => .terminal

  ..{last} ^punctuation => (
    stepped ^keyword := chain None
    at ^keyword := this
    while (at) {
      stepped &= at
      if (at === last) { at = None } else {
        at = at.next
        unless at { stepped = None }
      }
    }
    stepped
  )

  ⊢ => .initial
  ⊣ => .terminal

  is_boundary => .is_initial.or(.is_terminal)

  expand => (
    unfolded ^keyword := chain None
    .initial for { unfolded &= it }
    unfolded
  )


  complement => (
    selected ^keyword := this
    outside ^keyword := chain None
    .initial for {
      unless (it === selected) { outside &= it }
    }
    outside
  )

  initial_boundary => Boundary.Initial(vertex: this)
  terminal_boundary => Boundary.Terminal(vertex: this)

  count => (
    total := 1
    walker := this
    while walker.is_terminal.not {
      total = total.succ
      walker = walker.next
    }
    total
  )

  for (body) => (
    it ^keyword := .entry
    going ^keyword := true
    while going {
      inline body

      going = it.is_terminal.not
      if going { it = it.next }
    }
    this
  )

  at (index: Number) => (
    here := .entry
    left := index
    while left.nonzero {
      here = here.next
      left = left.pred
    }
    here
  )

  acyclic => .terminal.is_terminal

  every (predicate) => (
    .initial for {
      unless (inline predicate) { return false }
    }
    true
  )

  chainable == (other) => (
    if .orderless { return (.count == other.count).and(.every { other.contains(it.value) }) }
    if other.orderless { return other == this }
    mine := .entry
    theirs := other.entry
    same := (mine).xnor(theirs)
    while (same.and(mine)) {
      if ((mine.value).or(theirs.value)) { same = (mine.value == theirs.value) } else { same = same_text((external where mine), (external where theirs)) }
      if same {
        same = mine.is_terminal.xnor(theirs.is_terminal)
        if mine.is_terminal { mine = None } else {
          mine = mine.next
          theirs = theirs.next
        }
      }
    }
    same
  )
  chainable != (other) => (this == other).not
}

Boundary := class: Ray {

  ∙ => .vertex
  ⊙ => .edge

  is_initial => (.edge).not
  is_terminal => (.edge).not

  Initial := class: Boundary {

    edge => Edge(to: this)
    is_initial => true
    is_terminal => false
  }
  Terminal := class: Boundary {

    edge => Edge(from: this)
    is_initial => false
    is_terminal => true
  }
}

Edge := class: Ray {

  is_initial => (.from).not
  is_terminal => (.to).not

  initial => .from
  terminal => .to
}

Structure := class: Iterable {
  hyper_continuations => false
  hyper_edges => false
  is_valid => true
}
Structure.components.hierarchy &= Ray
Hypergraph := class: Structure {
  hyper_edges => true
}
Graph := class: Structure {
  hyper_continuations => true
}
Forest := class: Structure {
  hyper_continuations => true
  is_valid => .acyclic.and(.consistent)
}
Tree := class: Forest {
  is_valid => .acyclic.and(.consistent).and(.connected)
}
Path := class: Structure {
  is_valid => .consistent.and(.connected)
  paths => this

  length => if .acyclic { .count } else { None }
}
Array := class: Path {
  acyclic => true
}

Set := class: Structure {
  elements: (chain None)
  entry => .elements.unique.entry
  orderless => true
  add (x) => (
    unless (this.elements.contains(x)) { this.elements &= x }
    this
  )
}

Hierarchy := class: Ray {
  parent?: Node
  children: (chain None)

  holds (child) => (
    this.children &= child
    child.parent = this

    child
  )

  depth => (
    depth_below := 0
    if (.parent) { depth_below = .parent.depth.succ }
    depth_below
  )
}

Loop := class: Ray {
  around: Node
  holding: Node

  value => .holding.value
  next => Loop(around: .around, holding: (.holding.next ?? .around.head))
  previous => Loop(around: .around, holding: (.holding.previous ?? .around.tail))
  is_initial => false
  is_terminal => false
  bounded => false
  acyclic => false

  unrolled => .around
  instances (times: Number) => .around * times
  unrolled_mod => (
    opened ^keyword := chain None
    .around for { opened &= it.value }
    opened &= Loop(around: .around, holding: .around.head)
    opened
  )
  disallow_loops => .around
}

Traverser := class {
  Order := enum depth_first | breadth_first
  default => Traverser.Order.depth_first
  walk (entry, body) => entry for body

  DepthFirst := class {
    walk (entry, body) => (
      pending ^keyword := chain None
      pending &= entry
      seen ^keyword := chain None
      while pending.nonempty {
        it ^keyword := pending.pop_back
        unless (seen.contains(it)) {
          seen &= it
          inline body
          if it.is_terminal.not { pending &= it.next }
        }
      }
      entry
    )
  }
  BreadthFirst := class {
    walk (entry, body) => (
      pending ^keyword := chain None
      pending &= entry
      seen ^keyword := chain None
      while pending.nonempty {
        it ^keyword := pending.pop_front
        unless (seen.contains(it)) {
          seen &= it
          inline body
          if it.is_terminal.not { pending &= it.next }
        }
      }
      entry
    )
  }
}

Chain.components.hierarchy &= Array
Link.components.hierarchy &= Ray

Chain.components.hierarchy &= class {
  push_back (x) => (this &= x)
  orbit => Loop(around: this, holding: this.head)
  push_front (x) => (
    was_head ^keyword := this.head
    added ^keyword := link x None
    added.next = was_head
    if (was_head) { was_head.previous = added } else { this.tail = added }
    this.head = added
    this
  )
  unlink (dropped) => (
    held ^keyword := dropped
    answer ^keyword := held.value
    before ^keyword := held.previous
    after ^keyword := held.next
    if (before) { before.next = after } else { this.head = after }
    if (after) { after.previous = before } else { this.tail = before }
    answer
  )
  pop_front => (
    taken ^keyword := None
    if (this.head) { taken = this.unlink(this.head) }
    taken
  )
  pop_back => (
    taken ^keyword := None
    if (this.tail) { taken = this.unlink(this.tail) }
    taken
  )
  link_of (x) => (
    found ^keyword := None
    walker ^keyword := this.head
    while ((walker).and((found).not)) {
      if (walker.value == x) { found = walker }
      walker = walker.next
    }
    found
  )
  remove (x) => (
    held ^keyword := this.link_of(x)
    if (held) { this.unlink(held) }
    this
  )
  push_after (at, x) => (
    added ^keyword := link x at
    following ^keyword := at.next
    added.next = following
    at.next = added
    if (following) { following.previous = added } else { this.tail = added }
    this
  )
  push_before (at, x) => (
    preceding ^keyword := at.previous
    if (preceding) { this.push_after(preceding, x) } else { this.push_front(x) }
    this
  )
  move_after (x, target) => (
    this.remove(x)
    this.push_after(this.link_of(target), x)
  )
  move_before (x, target) => (
    this.remove(x)
    this.push_before(this.link_of(target), x)
  )
}

Iterable.components.hierarchy &= class {
  split (delimiter) => (
    pieces ^keyword := chain None
    current ^keyword := chain None
    for {
      if (it.value == delimiter) {
        pieces &= current
        current = chain None
      } else { current &= it.value }
    }
    pieces &= current
    pieces
  )

  .reduce_right({literal operator ^operator}) ^punctuation => (
    reversed ^keyword := .reverse
    accumulated ^keyword := None
    started ^keyword := false
    reversed for {
      if started { accumulated = accumulated[operator] it.value } else {
        accumulated = it.value
        started = true
      }
    }
    accumulated
  )
  .reduce_right(({accumulator ^parameter}){ }{`=>`}{ }{step}) ^punctuation => (
    names ^keyword := external ** accumulator
    step_written ^keyword := external ** step
    reversed ^keyword := .reverse
    accumulated ^keyword := None
    started ^keyword := false
    reversed for {
      if started {
        entering ^keyword := chain None
        entering.target = it.value
        external define entering.target `reduce_step{arguments}` {
          (inline names) := arguments
          inline step_written
        } accumulator
        accumulated = entering.target.reduce_step(accumulated)
      } else {
        accumulated = it.value
        started = true
      }
    }
    accumulated
  )
  .reduce_right({accumulator ^parameter}{ }{`=`}{ }{initial}{ }{`=>`}{ }{step}) ^punctuation => (
    names ^keyword := external ** accumulator
    step_written ^keyword := external ** step
    reversed ^keyword := .reverse
    accumulated ^keyword := initial
    reversed for {
      entering ^keyword := chain None
      entering.target = it.value
      external define entering.target `reduce_step{arguments}` {
        (inline names) := arguments
        inline step_written
      } accumulator
      accumulated = entering.target.reduce_step(accumulated)
    }
    accumulated
  )

  enumerate => (
    numbered ^keyword := chain None
    index ^keyword := 0
    for {
      pair ^keyword := chain None
      pair &= index
      pair &= it.value
      numbered &= pair
      index = index.succ
    }
    numbered
  )

  zip (other) => (
    zipped ^keyword := chain None
    theirs ^keyword := other.entry
    for {
      if (theirs) {
        pair ^keyword := chain None
        pair &= it.value
        pair &= theirs.value
        zipped &= pair
        if theirs.is_terminal { theirs = None } else { theirs = theirs.next }
      }
    }
    zipped
  )

  join (separator) => (
    joined ^keyword := chain None
    started ^keyword := false
    for {
      if started { joined &= separator }
      joined &= it.value
      started = true
    }
    joined
  )

  filter (predicate) => (
    kept ^keyword := chain None
    for {
      if (inline predicate) { kept &= it.value }
    }
    kept
  )

  remove (x) => (
    kept ^keyword := chain None
    for {
      unless (it.value == x) { kept &= it.value }
    }
    kept
  )

  canonical => .unique
}

Set.components.hierarchy &= class {
  canonical => .elements.unique
}
