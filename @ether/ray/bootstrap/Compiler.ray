    isolated_value(0, 0)
  }
  static copied_out (s) => {
    word_put(s + 8, 0) if Collector.statement_copied(word_of(s))
    Collector.notes_kept(word_of(3880), word_of(s), word_of(3984)) if word_of(s + 8) == 0
    0
  }
  static closed_or (pos, se, at) => Turns.closed_at_or(pos, se, block_closed(at, se))
  static closed_at_or (pos, se, v) => (v > 0) ? statement_end(pos, v) : se
  static over_turn (at, se, mark) => {
    Turns.left()
    boundn = mark
    over_budget(at, se)
    went_on()
    se
  }
  static unread_turn (at, se, mark) => {
    Turns.left()
    boundn = mark
