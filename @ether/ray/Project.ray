Project := class: Location {
  static Dependency := class ("@", location: (!" ")[], (" ", version: Version | (!\n)[])?) => {
    name => location.split("/").last as String

    project: Project? => (Program(code: ("@", location)){O: {
      @ether/{bundled_path: Written} => Project.known(Language.ray.bundled(bundled_path) ?? IO.fetch(@ether, bundled_path, version) as Project)
      @{scheme: Char.Word[]}://{remainder: Written} => Project.known(IO.fetch((scheme + "://" + remainder) as Location, "", version) as Project)
      @{name: (Char.Word | "-" | "+")[]{Language.project(.) != None}} => Language.project(name)
      @{local_path: Written} => Project.known((local_path as Location).content as Project)
    }}())?.load
  }

  static known (found: Project?) => found && (Project#{. == found}.first ?? (found ~~ (static.# ??= []).push .))
  static declared => Project#{.loaded || .loading}.map(.dependencies).flatten
  static declares (name: String) => declared.find(.name == name)
  static holding (location: Location) => Project#{(location as String) ~= ⊢(. as String + "/")}.max((. as String).count)
  static data (location: Location) => holding(location) -- (held => held && !Language.ray.location.contains(held) && !((location as String) ~= ".ray" ⊣))

  name: String?
  version: *?
  description: String?
  dependencies: Dependency[] = []
  written_against: Version?
  carried: *[] = []
  overrides: *[] = []
  readings: Program = {
    {name: String} => Language.for_file(name)
  }
  loading = false
  loaded = false

  shadowing => (parent, dependencies.project)#
  carries (host_versions: Version[]) => written_against && !host_versions.contains(written_against)
  language_of (name: String) => Compiler.reduced(name, readings)
  sources => listing**{!(. is Directory) && .name ~= ".ray" ⊣ && .name != ".project.ray" && (.parent == this || !(.parent / ".project.ray").exists)}
  load: static => loaded || loading ? this : this ~~ (.loading = true) ~~ sources.for(Language.ray.read(.content)) ~~ (.loaded = true) ~~ .loading = false
}

@{name: (Char.Word | "-" | "+")[]{Project.declares(.)}} ^string => Project.declares(name).project
@{name: (Char.Word | "-" | "+")[]{Project.declares(.)}}/{path: Written} ^string => Project.declares(name).project / path

%{number: Decimal.String} ^number => Version(number: number as Decimal)
%{number: Decimal.String}'{revision: Decimal.String} ^number => Version(number: number as Decimal, revision: revision as Decimal)
Version := class: Ray ("%", number: Decimal, ("'", revision: Decimal)?) => {
  latest => !revision
  breaks_freely => number == 0

  chainable == (other: Version) => number == other.number && revision == other.revision
  chainable < (other: Version) => number < other.number || number == other.number && revision? < other.revision ?? ∞

  next => %(number + 1)
  previous => %(number - 1)
  continuations => Migration.leaving(this).to

  resolved (revisions: Version[]) => latest ? revisions{number == this.number}.max(.revision) ?? this : this

  static Pin := class ("%[", label: UUID | Char.Word[], "]")
}

%[{first: Decimal.String}..{last: Decimal.String}] ^number => Version{first as Decimal <= number <= last as Decimal}

Migration := class (from: Version, " -> ", to: Version, " ", body: Function) => {
  (static.# ??= []).push this

  backward: Migration => Migration(from: to, to: from, body: body⁻¹ ?? Program(name: "derive the inverse of a migration", goal: this))

  static leaving (version: Version) => Migration#{.from == version}, Migration#{.to == version}.backward
  static migrate (old, from: Version, to: Version) => from.shortest_path_to(to) -- (path => path is Abstract
    ? Program(name: "migrate", goal: (value: old, from: from, to: to))
    : path.zip(path.rest).map((a, b) => leaving(a){.to == b}.first).reduce(held = old => .body(held)))
}
