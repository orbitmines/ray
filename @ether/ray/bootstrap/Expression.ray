// reach, the statements set aside, a turn's depth and budget (a statement let go when it runs past it, or near the
// heap's end), the log, what is painted and said
Hooks := class {
  static input => text(8388608, 8388608 + word_of(4088))
  static arena_base => 950000000 * 2
  static program_from => 8388608
  static program_length => word_of(4088)
  static in_program (a, e) => (a >= 8388608) && (e <= (8388608 + word_of(4088)))
  static keys_moved => {
    Hooks.keys_reset()
  }
  static keys_reset => {
    epoch = epoch + 1
    word_held(4004, 0)
  }
  static caches_reach => {
    word_held(4004, free) if free > word_of(4004)
    0
  }
  static keys_touched (n) => {
    Hooks.keys_reset() if (n < word_of(4004)) || (n >= arena_base())
    0
  }
  static class_put (c, k) => byte_put(3584 + c, k)
  static char_class (c) => byte(3584 + c)
  static white (c) => (c == 32) || (c == 10) || (c == 9) || (c == 13)
  static logging => word_of(3944) != 0
  // (a word given a value raw: noted as `written` notes one, when the value is of a statement still read)
  static word_held (w, v) => {
    effects = Heap.escaping(v) ? (effects + 1) : effects
    Heap.logged(w)
    word_put(w, v)
    0
  }
  static statements_aside => {
    word_held(3860, list()) if word_of(3860) == 0
    word_of(3860)
  }
  static aside_or_none => word_of(3860)
  // (a statement's budget, within what the turn it is in has left: one inside another never outlasts it)
  static turn_begun_within (outer) => {
    word_held(4060, Hooks.higher(outer, word_of(3896) - 200000000))
    stopped_statement() if (word_of(3896) > 0) && Hooks.near_end()
    0
  }
  static near_end => (free > (arena_base() - 33554432)) && (free < arena_base())
  static statement_over => word_of(4064) != 0
  static fueled => {
    word_held(3916, 1) if logging() && Hooks.log_over()
    Hooks.fuel_spent() if word_of(3896) > 0
    0
  }
  static log_over => ((free - word_of(3944)) > 134217728) || (free > (arena_base() - 67108864)) || ((word_of(word_of(3932) + 48) - word_of(3896)) > 20000000)
  static fuel_spent => {
    unreachable_now() if word_of(3896) == 1
    stopped_statement() if (word_of(3896) < word_of(4060)) || Hooks.near_end()
    word_held(3896, word_of(3896) - 1)
  }
  static stopped_statement => {
    word_held(4064, 1) if word_of(3916) == 0
    word_held(3916, 1)
  }
  // (an inner turn let go, the one it is in goes on; unless that one too ran past its budget)
  static higher (a, b) => (a > b) ? a : b
  static went_on => {
    c := (word_of(4064) != 0) && (word_of(3896) >= word_of(4060))
    word_held(3916, 0) if c
    word_held(4064, 0) if c
    0
  }
  // (a statement past its budget, noted where what is noted lasts)
  static over_listed (a, e) => {
    word_held(4068, list()) if word_of(4068) == 0
    append(word_of(4068), text(a, e))
  }
  // (whether the reading runs abstractly, as the editor runs a file (the host's word 3900); whether a test written at t
  // runs: every one, but when the editor runs a file only those written in it, from where the host says it begins)
  static tested_here (t) => ((word_of(3948) == 0) || (tag(t) != 4)) ? 12 : ((origin_at(word_of(t + 4)) < word_of(3948)) ? 8 : 12)
  static paints => word_of(3968)
  static reports => word_of(3972)
  static out_base => outb
  static out_length => outn
  static pointer (v) => ((v & 1) == 0) && (v >= 65536)
  // (what may be a place in memory, an object or a byte in one (a text's ends), for what holds what: any value past the
  // low words, odd or not; a number held so is only kept a little longer)
  static held (v) => v >= 65536
  static tag (v) => pointer(v) ? word_of(v) : 0
  static copy (to, from, n) => ((((to | from) | n) & 3) == 0) ? Hooks.words_copied(to, from, n) : Hooks.bytes_copied(to, from, n)
  static words_copied (to, from, n) => {
    i := 0
    while i < n {
      word_held(to + i, word_of(from + i))
      i = i + 4
    }
    to
  }
  static bytes_copied (to, from, n) => {
    i := 0
    while i < n {
      byte_put(to + i, byte(from + i))
      i = i + 1
    }
    to
  }
  static unreachable_now => word_of(0 - 8)
}
// Afterwards: the programs kept for afterwards (`external goto afterwards`, words 4044, 4036 how far run), run once
// everything is read, each by `run` (word 4048) with a test of its own; the code compiled once kept by what it writes
// (word 3788: a table, by its words' hash); the names that last; the name of a value's kind
Afterwards := class {
  static kept_later (p) => {
    append(word_of(4044), p)
    p
  }
  // (first only those `tested` keeps; where the host runs them a step at a time (word 4080), held for it)
  static run_kept (run, tested) => {
    word_held(4048, run)
    word_held(word_of(4044) + 4, Afterwards.tested_kept(word_of(4044), tested, word_of(4036)))
    while word_of(4036) < word_of(word_of(4044) + 4) {
      word_held(4036, word_of(4036) + 1)
      Afterwards.kept_run(at(word_of(4044), word_of(4036) - 1))
    }
    0
  }
  static tested_kept (l, tested, from) => {
    i := from
    j := from
    k := 0
    while i < word_of(l + 4) {
      k = truthy(call1(tested, at(l, i)))
      word_held(word_of(l + 12) + (j * 4), at(l, i)) if k
      j = k ? (j + 1) : j
      i = i + 1
    }
    j
  }
  static kept_run (x) => {
    o := 0
    i := word_of(4036)
    n := 0
    test_begin(word_of(3968), word_of(3972))
    o = word_of(4044)
    word_held(4044, list())
    word_held(4036, 0)
    // (a test a turn of its own: past its budget it stops, and the next goes on)
    f := word_of(4060)
    turn_begun_within(f)
    call1(word_of(4048), x)
    word_held(4060, f)
    went_on()
    word_held(4036, i)
    n = word_of(4044)
    word_held(4044, o)
    Afterwards.each_run(n)
    ((word_of(3936) == 0) ? 0 : Images.test_left(word_of(3968), word_of(3972), word_of(3936) - 1))
    0
  }
  static each_run (n) => {
    i := 0
    while i < word_of(n + 4) {
      Afterwards.kept_run(at(n, i))
      i = i + 1
    }
    0
  }
  static seeded (t) => {
    Afterwards.seeds() if csyms == 0
    append(csyms, t)
    0
  }
  static seeds => {
    csyms = list()
    kept()
    memo = lasting_alloc(65536 * 20)
    kept()
    epoch = 1
    actives = lasting_alloc(1048576)
    bounds = lasting_alloc(16777216)
    word_held(4044, list())
    word_held(3968, list())
    word_held(3972, list())
    word_held(4084, 2)
  }
  static lasting_name (t: Text) => ((((word_of(word_of(3932) + 1080) + (t.to - t.from)) + 24) > 1048576) || (word_of(names + 4) >= word_of(names + 8))) ? 0 : Afterwards.name_lasting(word_of(3932), t, t.to - t.from)
  static name_lasting (r, t: Text, n) => {
    x := word_of(r + 1076) + word_of(r + 1080)
    f := word_of(3944)
    word_held(x, 4)
    copy(x + 12, t.from, n)
    word_held(x + 4, x + 12)
    word_held(x + 8, (x + 12) + n)
    word_held(r + 1080, word_of(r + 1080) + ((((n + 12) + 7) / 8) * 8))
    word_held(3944, 0)
    append(names, x)
    word_held(3944, f)
    1
  }
  static kind_of (v) => Afterwards.kind_named(alloc_bytes(8), v)
  static kind_named (t, v) => {
    return text(t, put4(put4(t, 110, 111, 116, 104), 105, 110, 103, 0)) if v == 0
    return text(t, put4(put4(t, 102, 97, 108, 115), 101, 0, 0, 0)) if v == 8
    return text(t, put4(t, 116, 114, 117, 101)) if v == 12
    return text(t, put4(put4(t, 110, 117, 109, 98), 101, 114, 0, 0)) if (v & 1) == 1
    return text(t, put4(t, 116, 101, 120, 116)) if tag(v) == 4
    return text(t, put4(t, 108, 105, 115, 116)) if tag(v) == 3
    0
  }
  static put4 (o, c0, c1, c2, c3) => {
    byte_put(o, c0)
    return o + 1 if c1 == 0
    byte_put(o + 1, c1)
    return o + 2 if c2 == 0
    byte_put(o + 2, c2)
    return o + 3 if c3 == 0
    byte_put(o + 3, c3)
    o + 4
  }
}
// Images (what the reading is at, kept so the host can go on from it, is the back end's: `image_out`, `image_in`); a test's
// state (word 3932) noted when it begins and put back when it ends, what it painted, said and set aside copied to what
// lasts and its memory let go; the arguments a call shares (word 3928), made once, to last
Images := class {
  static shared_args (w, n) => {
    word_held(w, Images.two_none()) if word_of(w) == 0
    word_held(word_of(w) + 4, n)
    word_of(w)
  }
  static two_none => append(append(list(), 0), 0)
  // (a test begun: its state noted, once, however deep tests are begun in it (word 3936))
  static test_begin (painted, reported) => {
    Images.tests_made() if word_of(3932) == 0
    word_held(3936, word_of(3936) + 1)
    return 0 if word_of(3936) > 1
    t := word_of(3932)
    roomy(names, 256)
    word_held(t, free)
    word_held(t + 12, word_of(3860))
    word_held(t + 16, Images.past(word_of(3860), 0))
    word_held(t + 20, Images.past(painted, 0))
    word_held(t + 24, Images.past(reported, 0))
    word_held(t + 28, boundn)
    word_held(t + 36, activen)
    word_held(t + 44, 0)
    word_held(t + 48, word_of(3896))
    word_put(t + 52, Images.past(word_of(4068), 0))
    word_put(t + 56, word_of(4068))
    word_held(t + 1048, 0)
    word_held(3944, free)
    0
  }
  static tests_made => {
    t := lasting_alloc(1088)
    zeroed(t, 1088)
    word_held(t + 1044, lasting_alloc(16000000))
    word_held(t + 1076, lasting_alloc(1048576))
    word_held(t + 1080, 0)
    word_held(3932, t)
  }
  static past (l, from) => ((tag(l) == 3) && (word_of(l + 4) > from)) ? (word_of(l + 4) - from) : 0
  // (a test ended: what it took let go, but for what it painted, said and set aside, written out first)
  static test_left (painted, reported, d) => {
    word_held(3936, d)
    return 0 if d > 0
    t := word_of(3932)
    word_held(3944, 0)
    word_held(word_of(3860) + 4, word_of(t + 16)) if (word_of(3916) != 0) && (word_of(3860) != 0) && (word_of(3860) == word_of(t + 12))
    word_held(3916, 0)
    Images.test_reclaimed(t, painted, reported, word_of(t)) if (word_of(t + 44) == 0) && (word_of(t + 1056) == 0)
    word_held(t + 1048, 0)
    word_held(t + 1056, 0)
    0
  }
  static test_reclaimed (t, painted, reported, f0) => {
    np := Images.past(painted, word_of(t + 20))
    nr := Images.past(reported, word_of(t + 24))
    nu := ((word_of(3860) != 0) && (word_of(3860) == word_of(t + 12))) ? Images.past(word_of(3860), word_of(t + 16)) : 0
    no := Images.past(word_of(4068), word_of(t + 52))
    k := Images.lasting_list(appended_from(appended_from(appended_from(appended_from(list(), painted, word_of(t + 20)), reported, word_of(t + 24)), (nu > 0) ? word_of(3860) : list(), word_of(t + 16)), (no > 0) ? word_of(4068) : list(), word_of(t + 52)), f0)
    Images.logged_undone(t)
    boundn = word_of(t + 28)
    activen = word_of(t + 36)
    word_put(3860, word_of(t + 12))
    word_put(4068, word_of(t + 56))
    Heap.given_back(f0)
    Images.taken_onto(painted, k, 0, np)
    Images.taken_onto(reported, k, np, nr)
    Images.taken_onto(word_of(3860), k, np + nr, nu)
    word_put(4068, list()) if (no > 0) && (word_of(4068) == 0)
    Images.taken_onto(word_of(4068), k, (np + nr) + nu, no)
  }
  static taken_onto (l, k, from, n) => {
    i := 0
    while i < n {
      append(l, at(k, from + i))
      i = i + 1
    }
    0
  }
  static logged_undone (t) => {
    n := word_of(t + 1048)
    while n > 0 {
      n = n - 1
      word_put(word_of(word_of(t + 1044) + (n * 8)), word_of(word_of(t + 1044) + ((n * 8) + 4)))
    }
    0
  }
  // (what the host reads of a value made in the test, made again where what lasts is: a list, a text, a node's fields,
  // a place; anything else, nothing. Each once: the first word of one made again says where it is now)
  static lasting_of (v, f0) => ((pointer(v) == 0) || (v < f0) || (v >= free)) ? v : ((word_of(v) == 99) ? word_of(v + 4) : ((word_of(v) == 3) ? Images.lasting_list(v, f0) : ((word_of(v) == 4) ? Images.lasting_text(v) : (((word_of(v) == 1) || (word_of(v) == 10)) ? Images.lasting_node(v, word_of(v), f0) : ((word_of(v) == 12) ? Images.lasting_place(v, f0) : 0)))))
  static moved_to (v, c) => {
    word_put(v, 99)
    word_put(v + 4, c)
    c
  }
  static lasting_list (l, f0) => {
    n := word_of(l + 4)
    items := word_of(l + 12)
    c := Images.moved_to(l, lasting_alloc(16))
    d := lasting_alloc((n * 4) + 4)
    word_put(c, 3)
    word_put(c + 4, n)
    word_put(c + 8, n)
    word_put(c + 12, d)
    i := 0
    while i < n {
      word_put(d + (i * 4), Images.lasting_of(word_of(items + (i * 4)), f0))
      i = i + 1
    }
    c
  }
  static lasting_text (t) => {
    a := word_of(t + 4)
    e := word_of(t + 8)
    c := Images.moved_to(t, lasting_alloc(12))
    b := ((a >= word_of(word_of(3932))) && (a < free)) ? copy(lasting_alloc((e - a) + 1), a, e - a) : a
    word_put(c, 4)
    word_put(c + 4, b)
    word_put(c + 8, b + (e - a))
    c
  }
  static lasting_node (v, k, f0) => {
    fs := word_of(v + 8)
    c := Images.moved_to(v, lasting_alloc(20))
    word_put(c, k)
    word_put(c + 4, 0)
    word_put(c + 12, 0)
    word_put(c + 16, 0)
    word_put(c + 8, Images.lasting_fields(fs, f0))
    c
  }
  static lasting_fields (f, f0) => (f == 0) ? 0 : Images.lasting_field(f, word_of(f), word_of(f + 4), word_of(f + 8), f0)
  static lasting_field (f, next, name, value, f0) => {
    c := lasting_alloc(12)
    word_put(c + 4, name)
    word_put(c + 8, Images.lasting_of(value, f0))
    word_put(c, Images.lasting_fields(next, f0))
    c
  }
  static lasting_place (v, f0) => {
    n := word_of(v + 4)
    kd := word_of(v + 8)
    g := word_of(v + 12)
    c := Images.moved_to(v, lasting_alloc(16))
    word_put(c, 12)
    word_put(c + 4, n)
    word_put(c + 8, Images.lasting_of(kd, f0))
    word_put(c + 12, Images.lasting_of(g, f0))
    c
  }
}
