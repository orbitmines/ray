if 
  condition
  block

if
  a
    ==
    b
  block


if
  a
  ==
  b
  block
// WHat is the block? if(a, == b block)

if(condition, block) or (if condition).block
// Prefer the (): * call. if it has one as the last argument.

//example for precedence of : and ()
func: Terminating ()
a + b: Terminating () c + d
// = 
