say {x} =>
  @me/instance = x
// `x @ -> = v` (Almanac A3): seen by what the context calls (false three times), not after it (true three times)
Box := class {
  size: Node?
}
box := Box()
box.size = true
a := true
show => say box.size
showa => say a
inner =>
  box.size @ -> = false
  a @ -> = false
  show
  showa
  say box.size
inner
show
showa
say a
