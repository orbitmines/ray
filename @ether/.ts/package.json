{
  "name": "@orbitmines/ray",
  "version": "0.4.0-E2026.0D.0",
  "private": false,
  "repository": "https://github.com/orbitmines/ray",
  "type": "module",
  "main": "./index.ts",
  "bin": {
    "ray-language-server": "./src/lsp/index.ts"
  },
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "@ether/$/.ray"
  ],
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "npx jest",
    "v0": "tsx src/runtime/v0.run.ts",
    "v0.3": "tsx src/runtime/v0.3.run.ts",
    "v0.4": "tsx src/runtime/v0.4.run.ts",
    "spec": "tsx src/spec.ts",
    "language-server": "tsx src/lsp/index.ts",
    "prepack": "node -e \"const f=require('fs');process.chdir(require('path').dirname(process.env.npm_package_json));f.cpSync('../$/.ray','@ether/$/.ray',{recursive:true,force:true});const r=[];(function w(d,n){for(const e of f.readdirSync(d,{withFileTypes:true})){const x=n?n+'/'+e.name:e.name;if(e.isDirectory())w(d+'/'+e.name,x);else r.push('@ether/$/.ray/'+x);}})('@ether/$/.ray','');f.writeFileSync('src/bundled.ts','export const manifest: string[] = '+JSON.stringify(r)+';\\n');\"",
    "postpack": "node -e \"const f=require('fs');process.chdir(require('path').dirname(process.env.npm_package_json));f.rmSync('@ether',{recursive:true,force:true});f.writeFileSync('src/bundled.ts','export const manifest: string[] = [];\\n');\""
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": [
      "**/*.spec.ts"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
