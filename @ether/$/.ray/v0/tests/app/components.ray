// Components. A value is made of components: `.components` holds the
// superposed ones, `.components.hierarchy` the class components. Both are
// chains, `&=` appends to a chain, `|` superposes two values (a copy of the left
// one whose components gain the right one), and
// `:` on a value with components adds a class component (so `class: Parent`
// is `:` applied to the class). Instances refer to their class through the
// hierarchy rather than copying it, so a class extended later reaches every
// instance built from it.

mark ^keyword := external global

A := class {
  mk => A(from: this)
}
a := A()
b := a.mk
c := b.mk

unless (exists a.components.hierarchy.tail.value) { INFO@mark `C1 an instance has no class component` }
unless (exists c.components.hierarchy.head.value.mk) { INFO@mark `C2 the class component of an instance is not its class` }
unless (exists a.components.hierarchy.owner) { INFO@mark `C3 a hierarchy does not know what it belongs to` }
unless (a.components.hierarchy.count == one) { INFO@mark `C4 a plain instance has other than one class component` }

R := class { }
S := class: R { s => S(next: this) }
z := S()
o := z.s
t := o.s
unless (exists t.s) { INFO@mark `C5 a successor chain through class: Parent broke` }
unless (exists S.components.hierarchy.head.value) { INFO@mark `C6 class: Parent did not add a class component` }
unless (exists S.super) { INFO@mark `C7 super is missing` }
unless (exists Ray.super.count) { INFO@mark `C8 Ray.super does not reach Iterable's count` }

Greeter := class {
  greeting => .name
  twice => .greeting
}
Loud := class: Greeter {
  greeting => global
  polite => .super.greeting
}
loud := Loud(name: global)
unless (exists loud.polite) { INFO@mark `C22 super.greeting did not run the parent's method on the instance` }
unless (exists loud.super.twice) { INFO@mark `C23 super reaches the parent's other methods` }

E := enum p | q | r
unless (exists E.components.head.value.name) { INFO@mark `C9 the first enum member is not the first component` }
unless (exists E.components.head.next.next.value.name) { INFO@mark `C10 enum components are not chained forward` }
unless (exists E.components.tail.previous.previous.value.name) { INFO@mark `C11 enum components are not chained backward` }
unless (E.components.count == three) { INFO@mark `C12 an enum of three has other than three components` }
unless (E.components.first.is_initial) { INFO@mark `C13 a chain is not an Iterable of Rays` }
unless (exists E.components.last.value.name) { INFO@mark `C14 Iterable.last did not reach the last component` }

M := a | b
unless (exists M.components.head.value.mk) { INFO@mark `C15 | did not superpose its left side` }
unless (exists M.components.tail.value.mk) { INFO@mark `C16 | did not superpose its right side` }
N := M | c
unless (N.components.count == three) { INFO@mark `C17 | on a Many did not append` }

k := chain None
k &= a
k &= b
unless (exists k.head.next) { INFO@mark `C18 a hand-built chain is not linked forward` }
unless (exists k.tail.previous) { INFO@mark `C19 a hand-built chain is not linked backward` }
if (exists k.head.previous) { INFO@mark `C20 the head of a chain has a previous` }
unless (k.count == two) { INFO@mark `C21 a chain of two does not count two` }
