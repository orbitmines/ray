@ether/os
@ether/random
@unicode
@ether/device
@c

// A MAC address (EUI-48): six octets. Its canonical text is IEEE 802's: the octets in uppercase hexadecimal, separated by
// hyphens (AC-DE-48-00-00-80; https://standards.ieee.org/wp-content/uploads/import/documents/tutorials/eui.pdf,
// https://www.rfc-editor.org/rfc/rfc7042#section-2.1). It is read as written elsewhere too: with colons, as most systems
// print it (ac:de:48:00:00:80), or as three dot-separated groups (acde.4800.0080).
MAC := class: Binary₄₈ (
  (octets: Hexadecimal₂[]{length == 6}).join("-")
  | (octets: Hexadecimal₂[]{length == 6}).join(":")
  | (groups: Hexadecimal₄[]{length == 3}).join(".")
) => {
  // The first octet's lowest bit: one station (0) or a group (1); the next bit: assigned by the manufacturer (0) or locally (1).
  multicast => (this as Byte[]).first & 1 == 1
  assert ("03-00-00-00-00-00" as MAC).multicast && ("02-00-00-00-00-00" as MAC).locally_administered  // MAC4 the group and local bits are not read from the first octet
  locally_administered => (this as Byte[]).first & 2 == 2
  as (=== String) => (this as Byte[]).map((. as Hexadecimal₂ as String).upper_case).join("-")
}
// A MAC address reads as systems write it and writes as IEEE 802 does.
assert ("04:7c:16:4e:3a:42" as MAC) as String == "04-7C-16-4E-3A-42"  // MAC1 a colon-separated address is not written canonically
assert "04-7C-16-4E-3A-42" as MAC == "047c.164e.3a42" as MAC  // MAC2 one address in two notations is not one address
assert !("04:7c:16:4e:3a" is MAC || "04:7c:16:4e:3a:4g" is MAC)  // MAC3 five octets or a non-hexadecimal digit was taken for an address

Device &+= {
  // the host's MAC address: the first interface's that is not the loopback, as the operating system lists them (each
  // `/sys/class/net/*/address` on Linux, https://www.kernel.org/doc/html/latest/admin-guide/abi-testing.html#abi-sys-class-net;
  // GetAdaptersAddresses on Windows, https://learn.microsoft.com/windows/win32/api/iphlpapi/nf-iphlpapi-getadaptersaddresses;
  // getifaddrs' link-layer addresses on macOS, https://man.freebsd.org/getifaddrs); on ether its network controller's
  // (memory-mapped, through Machine);
  // a browser says none (a random locally administered one)
  mac: MAC = (if OS.Linux {
      (@/sys/class/net).held{!(. as String ~= "/lo" ⊣)}.map(((. / "address").held as String).lines.first){!= "00:00:00:00:00:00"}.first as MAC
    }
    elsif OS.Windows {
      (@c {
        unsigned size = 15000
        IP_ADAPTER_ADDRESSES* all = malloc(size)
        GetAdaptersAddresses(AF_UNSPEC, 0, nullptr, all, &size)
        IP_ADAPTER_ADDRESSES* at = all
        while (at && (at->IfType == IF_TYPE_SOFTWARE_LOOPBACK || at->PhysicalAddressLength != 6)) { at = at->Next }
        unsigned char octets[6] = \{0}
        if (at) { memcpy(octets, at->PhysicalAddress, 6) }
        free(all)
      })().octets as MAC
    }
    elsif OS.Macos {
      (@c {
        struct ifaddrs* all = nullptr
        getifaddrs(&all)
        struct ifaddrs* at = all
        while (at && (at->ifa_addr->sa_family != AF_LINK || (at->ifa_flags & IFF_LOOPBACK) || ((struct sockaddr_dl*)at->ifa_addr)->sdl_alen != 6)) { at = at->ifa_next }
        unsigned char octets[6] = \{0}
        if (at) { memcpy(octets, LLADDR((struct sockaddr_dl*)at->ifa_addr), 6) }
        freeifaddrs(all)
      })().octets as MAC
    }
    elsif OS.Ether { Machine.driver(0x02)?.mac as MAC }
    else { None }) -- (. && . != ("00-00-00-00-00-00" as MAC) ? . : MAC.random ~~ .[7] = 1)
}
