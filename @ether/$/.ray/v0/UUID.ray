// A Universally Unique IDentifier (UUID) (https://datatracker.ietf.org/doc/html/rfc4122)
UUID := class: Hexadecimal³² ~~ [~ 7 | +4 | +4 | +4].push_after("-") {
  version: Hexadecimal¹ => this[12]

  dynamically
    < v1 if version == 1
    < v3 if version == 3
    < v4 if version == 4
    < v5 if version == 5

  static Variant := enum RESERVED_NCS | RFC_4122 | RESERVED_MICROSOFT | RESERVED_FUTURE
  variant: ⊢11₂ ? Binary³ : Binary₂ => this[16] as Binary
  variant as (=== Variant) => .match
    ⊢0 => Variant.RESERVED_NCS
    10₂ => Variant.RFC_4122
    110₂ => Variant.RESERVED_MICROSOFT
    111₂ => Variant.RESERVED_FUTURE

  static v1 := class: UUID ~ (
    (
      time_low: Hexadecimal⁸,
      time_mid: Hexadecimal⁴,
      (version: Hexadecimal¹, time_high: Hexadecimal³) = time_high_and_version: Hexadecimal⁴
    ),
    (
      (
        variant,
        clock_seq_high: Binary{length == 8 - variant.length}
      ) = clock_seq_high_and_reserved: Hexadecimal²,
      clock_seq_low: Hexadecimal²,
    ),
    node: Hexadecimal¹²
  ) {
    // The timestamp is a 60-bit count of 100-nanosecond intervals since the Gregorian reform (https://datatracker.ietf.org/doc/html/rfc4122#section-4.1.4)
    (time_high, time_mid, time_low) = time: Binary⁶⁰

    // Choosing a v1 generates one; choosing among unique ones is the runtime's to guarantee (X5.2).
    chosen_within (width) => ~generate()

    static last_time = 0
    generate\
      time = (Time.now(epoch: "1582-10-15 00:00:00") as ns / 100 -- .floor) max (last_time + 1)
      last_time = time
      version = 1
      variant = 10₂
      (clock_seq_high, clock_seq_low) = Binary{length == 16 - variant.length}.random
      // No MAC address: a random one with the multicast bit set (https://datatracker.ietf.org/doc/html/rfc4122#section-4.5)
      node = @me?.instance?.mac_address ?? (Hexadecimal¹².random ~~ .[1] |= 1)
  }

  static v3 := class: UUID {
    namespace: UUID
    name: String
    dynamically assert version == 3
  }
  static v4 := class: UUID = secure Hexadecimal{length == 32}.random ~~ (
    .version = 4
    .variant = 10₂
  )
  static v5 := class: UUID {
    namespace: UUID
    name: String
    dynamically assert version == 5
  }

  static Namespace := class {
    DNS: UUID = 6ba7b810-9dad-11d1-80b4-00c04fd430c8
    URL: UUID = 6ba7b811-9dad-11d1-80b4-00c04fd430c8
    OID: UUID = 6ba7b812-9dad-11d1-80b4-00c04fd430c8
    X500: UUID = 6ba7b814-9dad-11d1-80b4-00c04fd430c8
  }
}

{uuid: UUID.String}: UUID => uuid
