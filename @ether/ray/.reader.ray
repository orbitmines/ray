  registry.given = saved_given
  frame
registry.latest.shared = true

// Whether code starts with a block's bracket.
{code}.starts_block =>
  where := external span code
  found := None
  if where
    found = where.from.past_spaces.character === opening_block
  found

// A program (a block as a value) run in `frame`: what it answers.
{program}.run_in({frame}) =>
  code := program.written.code
  external apply code None frame
this_written := external span this
arguments_written := external span arguments
arguments_from := arguments_written.from
arguments_to := arguments_written.to

// ---------------------------------------------------------------- types with a check: characters, repetition (R2.2)
// One character, any.
{kind}.one_character({from}, {to}) =>
  from.next === to
Char := registry.latest.checked

// One character, not `excluded`.
{kind}.one_character_except({from}, {to}) =>
  found := None
  if from.next === to
    unless from.character === kind.excluded
      found = true
  found
except_rule := registry.latest
{c}.anything_but =>
  made := except_rule.checked
  made.excluded = c
  made

// One or more of `item`, one after another.
{kind}.one_or_more({from}, {to}) =>
  item := kind.item
  e := from.next
  found := None
  going := true
  while going
    if item.holds(from, e)
      found = e === to ? true : kind.one_or_more(e, to)
    if found ? true : e === to
      going = None
    if going
      e = e.next
  found
many_rule := registry.latest


// One operand: from where it starts (after spaces), a group, quoted text or a word, and nothing after it.
{kind}.one_operand({from}, {to}) =>
  start := from.past_spaces
  start.operand_end(to) === to
Operand := registry.latest.checked

// What is given to a value written after it with a space (`f x`, `f a, b`): balanced, and starting as an operand does (a word, a
// bracket, quoted text): an operator after a value is not given to it (G2.1, G2.23).
{kind}.given_text({from}, {to}) =>
  start := from.past_spaces
  c := start.character
  found := c.word
  unless found
    found = c.closer
  unless found
    found = c === quote
  if found
    found = start.balanced_to(to)
  found
Given := registry.latest.checked


// A method's argument: what brackets hold (the group, nothing after it), or one operand with what accesses it (`a.b`, `f(x)`):
// nothing outside brackets is a space.
{kind}.one_argument({from}, {to}) =>
  start := from.past_spaces
  start.character === opening ? start.balanced_end(to) === to : kind.tight(start, to)
Argument := registry.latest.checked

// A word: one operand that is not in brackets or quotes.
{kind}.word_text({from}, {to}) =>
  c := from.character
  found := None
  // (none with a space in it: found before the operators are looked for)
  unless c.closer ? true : (c === quote ? true : from.first_place_of(space, to))
    found = from.operand_end(to) === to
  found
Word := registry.latest.checked
{item: Operand}[] =>
  made := many_rule.checked
  made.item = item
  made
repeated_rule := registry.latest

// ---------------------------------------------------------------- text written in quotes
Unquoted := quote.anything_but
Quoted := Unquoted[]
"{text: Quoted}" ^string =>
  made := external span text
  // (a String, once the language has one)
  string_class := registry.string_class
  if string_class
    made.outer_frame = string_class
    made.instance = true
    made.this = made
  made
quoted_rule := registry.latest
// Text in backticks, taken as written.
Unticked := backtick.anything_but
Ticked := Unticked[]
`{text: Ticked}` ^string =>
  external span text
ticked_rule := registry.latest
// what is said when there is nothing to add to
nothing_extended := `nothing to add to (it is not defined yet)`

// ---------------------------------------------------------------- brackets: what they hold is balanced
// Balanced text: every bracket it opens it closes, in order, and it closes none it did not open; quoted text is skipped.
{kind}.balanced({from}, {to}) =>
  open_ones := None
  here := from === to ? None : from
  ok := true
  while here
    c := here.character
    shut := c.closer
    if shut
      open_ones = shut.pushed_on(open_ones)
    unless shut
      if c.closes
        closed := open_ones && c === open_ones.shut
        open_ones = closed && open_ones.next
        unless closed
          ok = None
          here = None
      if c === quote
        here = here.next
        skipping := here
        while skipping
          if skipping === to
            ok = None
            skipping = None
            here = None
          if skipping && skipping.character === quote
            here = skipping
            skipping = None
          skipping = skipping.next
    here = here.next
    if here === to
      here = None
  open_ones ? None : ok
Balanced := registry.latest.checked

// A group: what is in brackets is read as itself.
({inside: Balanced}) =>
  inside
group_rule := registry.latest
// Nothing in brackets.
{`()`} =>
  None
empty_group_rule := registry.latest

// Text in round brackets, whole: it opens with one and the bracket closing that one ends it.
{kind}.bracketed({from}, {to}) =>
  found := from.character === opening && from.balanced_end(to) === to
  found
Bracketed := registry.latest.checked

// The rest of a line: no line end in it.
{kind}.on_one_line({from}, {to}) =>
  from.first_place_of(end, to) ? None : true
Line := registry.latest.checked

// One item of a list: balanced, with no `,` outside the brackets in it (G2.21: `,` composes before `=>` reads a definition).
{kind}.item_text({from}, {to}) =>
  found := from.balanced_to(to)
