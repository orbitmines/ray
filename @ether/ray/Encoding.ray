Encoding := class {
  Digest := class: Language {
    read (encoded) => ERROR `a digest is written and never read back`
    write (value) => Hash(value, algorithm: this)
    // EN21 writing a value with a digest does not give a hash made with that digest
    assert $.sha256.write(5).(
      . is Encoding.Hash  // EN22 a digest does not write a hash
      & .algorithm === $.sha256  // EN23 the hash does not remember its digest
      & .value == 5  // EN24 the hash does not remember its value
    )
  }
  Packing := class: Language {
    read (encoded) => encoded.value
    write (value) => Packed(value, algorithm: this)
    // EN25 writing a value with a packing does not give a packed value made with that packing
    assert $.gzip.write(5).(
      . is Encoding.Packed  // EN26 a packing does not write a packed value
      & .algorithm === $.gzip  // EN27 the packed value does not remember its packing
    )
    assert $.gzip.read($.gzip.write(5)) == 5  // EN28 reading what a packing wrote does not give the value back
    assert !($.gzip.read($.gzip.write(5)) == 6)  // EN29 reading what a packing wrote gives another value
  }

  Asymmetric := class: Language {
    pair (secret: Byte[] = secure Byte₃₂.random) => Key(algorithm: this, public: public(secret), secret)
    // EN30 a pair of keys is not made with the algorithm, a 32-byte public key and its secret (RFC 8032 section 5.1.5)
    assert $.ed25519.pair().(
      .algorithm === $.ed25519  // EN31 the key does not remember its algorithm
      & .public.count == 32  // EN32 an Ed25519 public key is not 32 bytes
      & .secret.count == 32  // EN33 an Ed25519 secret is not 32 bytes
    )
    assert !($.ed25519.pair() == $.ed25519.pair())  // EN34 two pairs made without a secret are the same
    assert $.ed25519.pair(secret: 0x9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60 as Byte[]).public == (0xd75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a as Byte[])  // EN35 a public key is not the one derived from a given secret (RFC 8032 section 7.1, test 1)
  }
  Signing := class: Asymmetric {
    read (signed: Signed) => signed.valid ? signed.value : ERROR `the signature does not hold for what it signs`
    // EN36 reading a signed value does not give the value that was signed
    assert {
      key := $.ed25519.pair()
      assert $.ed25519.read(key.signed("hi")) == "hi"  // EN37 reading what a key signed does not give the value
      assert !($.ed25519.read(key.signed("hi")) == "ho")  // EN38 reading a signed value gives another value
    }
  }
  Agreement := class: Asymmetric
  Symmetric := class: Language {
    generated (secret: Byte[] = secure Byte₃₂.random) => Key(algorithm: this, public: [], secret)
    // EN39 a symmetric key made without a secret has a public part, or a secret that is not 32 bytes
    assert $.chacha20poly1305.generated().(
      .public.count == 0  // EN40 a symmetric key has a public part
      & .secret.count == 32  // EN41 a symmetric secret is not 32 bytes
    )
  }

  Key := class (algorithm: Asymmetric | Symmetric, public: Byte[], none.read secret: Byte[]?) => {
    published => Key(algorithm, public)
    // EN42 the published form of a key keeps its secret
    assert $.ed25519.pair().published.(
      .secret == None  // EN43 the published key still holds the secret
      & .public.count == 32  // EN44 the published key lost its public part
    )
    signed (value) => Signed(value, by: published, signature: algorithm.sign(secret, value as Byte[]))
    // EN45 a signed value does not hold the value, the signer's published key and a signature that holds
    assert {
      key := $.ed25519.pair()
      signed := key.signed("hi")
      assert signed.value == "hi"  // EN46 a signed value forgot its value
      assert signed.by == key.published  // EN47 a signed value is not by the key's published form
      assert signed.valid  // EN48 a signature made by a key does not hold
      assert signed.signature.count == 64  // EN49 a signature is 64 bytes for Ed25519 (RFC 8032 section 5.1.6)
    }
    agreed (other: Byte[]) => algorithm.agreed(secret, other)
    // EN50 two parties do not reach the same shared secret (RFC 7748 section 6.1)
    assert {
      alice := $.x25519.pair()
      bob := $.x25519.pair()
      assert alice.agreed(bob.public) == bob.agreed(alice.public)  // EN51 the secrets agreed from each side differ
      assert !(alice.agreed(bob.public) == alice.agreed($.x25519.pair().public))  // EN52 the secret agreed with a third party is the same
    }
    zeroised: static => this ~~ .secret = None
    assert $.ed25519.pair().zeroised.secret == None  // EN53 a zeroised key keeps its secret
    assert $.ed25519.pair().zeroised.public.count == 32  // EN54 a zeroised key lost its public part
    chainable == (other: Key) => algorithm === other.algorithm && public == other.public
    // EN55 a key is not equal to itself
    assert {
      key := $.ed25519.pair()
      assert key == key.published  // EN56 a key is not equal to its published form (same algorithm and public part)
      assert !(key == $.ed25519.pair())  // EN57 keys with different public parts are equal
      assert !($.ed25519.pair() == $.x25519.pair())  // EN58 keys of different algorithms are equal
    }
  }
  Signed := class (value: *, by: Key, signature: Byte[]) => {
    valid => by.algorithm.verify(by.public, value as Byte[], signature)
    // EN59 a signature does not fail for a changed value
    assert {
      key := $.ed25519.pair()
      assert !Encoding.Signed("ho", by: key.published, signature: key.signed("hi").signature).valid  // EN60 a signature holds for a value other than the one it signs
      assert !Encoding.Signed("hi", by: $.ed25519.pair().published, signature: key.signed("hi").signature).valid  // EN61 a signature holds under another key
    }
  }

  static little (number: Number, count: Number) => <-(number as Binary{length == 8 * count} as Byte[])
  assert Encoding.little(1, 4) == [0x01, 0x00, 0x00, 0x00] as Byte[]  // EN62 a number is not written least significant byte first in the count of bytes asked
  assert Encoding.little(0x0102, 2) == [0x02, 0x01] as Byte[]  // EN63 the second byte is not the next 8 bits
  assert !(Encoding.little(0x0102, 2) == [0x01, 0x02] as Byte[])  // EN64 a number written big endian is little endian
  static little_number (bytes: Byte[]) => (<-bytes) as Binary
  assert Encoding.little_number([0x01, 0x00, 0x00, 0x00] as Byte[]) == 1  // EN65 bytes least significant first are not read as the number
  assert Encoding.little_number([0x00, 0x01] as Byte[]) == 256  // EN66 the second byte does not count 256 times
  assert Encoding.little_number(Encoding.little(48879, 4)) == 48879  // EN67 reading a number written little endian does not give it back

  Packed := class (value: *, algorithm: Packing) => {
    as (target) => algorithm.read(this)
    assert (Encoding.Packed(7, algorithm: $.gzip) as Number) == 7  // EN68 a packed value read as its value is not the value
  }

  Hash := class (value: *, algorithm: Digest) => {
    bytes: Byte[] => Compiler.reduced(Language.Writing(value, language: algorithm), algorithm.written)
    // the bytes of a hash are as long as the algorithm's output (FIPS 180-4, RFC 3174, RFC 1321)
    assert {
      assert Encoding.Hash(value: 5, algorithm: $.sha256).bytes.count == 32  // EN69 the bytes of a SHA-256 hash are not 32
      assert Encoding.Hash(value: 5, algorithm: $.sha512).bytes.count == 64  // EN76 the bytes of a SHA-512 hash are not 64
      assert Encoding.Hash(value: 5, algorithm: $.sha1).bytes.count == 20  // EN77 the bytes of a SHA-1 hash are not 20
      assert Encoding.Hash(value: 5, algorithm: $.md5).bytes.count == 16  // EN78 the bytes of an MD5 hash are not 16
    }
    assert !(Encoding.Hash(value: 5, algorithm: $.sha256).bytes == Encoding.Hash(value: 4, algorithm: $.sha256).bytes)  // EN70 the bytes of a hash of one value are the bytes of a hash of another
    chainable == (other: Hash) => algorithm == other.algorithm && value == other.value
  }
  assert Encoding.Hash(value: 5, algorithm: $.sha256).(
    . == Encoding.Hash(value: 5, algorithm: $.sha256)  // EN5 two like digests are not the same
    & !(. == Encoding.Hash(value: 5, algorithm: $.md5))  // EN6 digests of different algorithms are the same
    & !(. == Encoding.Hash(value: 4, algorithm: $.sha256))  // EN7 digests of different values are the same
    & .value == 5  // EN17 a digest forgot what it was made of
    & .algorithm === $.sha256  // EN18 a digest forgot how
  )

  Encrypted := class (T, value: T, key: Key?) => {
    opened (holder) => key && holder.key == key ? value : ERROR@Key `find the key`
    // something encrypted for a key opened by a holder of that key
    assert {
      key := $.chacha20poly1305.generated()
      assert Encoding.Encrypted(Number, 5, key).opened((key: key)) == 5  // EN71 something encrypted for a key is not opened by a holder of that key
    }
  }

  static common (a: Byte[], b: Byte[]) => a.empty || b.empty || a.first != b.first ? 0 : 1 + common(a.rest, b.rest)
  assert Encoding.common([1, 2, 3] as Byte[], [1, 2, 4] as Byte[]) == 2  // EN72 the common start of two byte lists is not counted
  assert Encoding.common([5] as Byte[], [6] as Byte[]) == 0  // EN73 lists that differ at once have a common start
  assert Encoding.common([] as Byte[], [1] as Byte[]) == 0  // EN74 an empty list has a common start with another
  assert Encoding.common([1, 2, 3] as Byte[], [1, 2, 3] as Byte[]) == 3  // EN75 a list does not share its whole length with itself
  static runs (source: Byte[], target: Byte[]) => target.empty ? [] : (0..<source.count).map(at => (from: at, count: common(source[at..], target))).max_by(.count)#.first -- (best =>
    best && best.count >= 4 ? [(from: best.from, count: best.count)], runs(source, target[best.count..]) : runs(source, target[1..]) -- (rest =>
      rest.first.bytes ? [(bytes: (target[..0], rest.first.bytes).flatten)], rest.rest : [(bytes: target[..0])], rest))
}

assert (5 as $.gzip).(
  . as Number == 5  // EN3 what is compressed does not come back
  & .algorithm === $.gzip  // EN4 it forgot how it was compressed
  & !(.algorithm === $.sha1)  // EN13 it is packed every way at once
)

assert !($.sha256 === $.sha1)  // EN19 two algorithms are the same

assert $.md5 === $.md5  // EN20 an algorithm is not itself
