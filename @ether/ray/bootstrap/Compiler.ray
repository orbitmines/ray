  static body (bb, be) => Compiled.braced(Compiled.trimmed(bb)) ? Lowered.statements(Compiled.statements_of(Compiled.inner_of(Compiled.trimmed(bb))), be) : Lowered.expression(bb, be)
  static statements (ss, se) => ss.empty ? Lowered.w("0") : Lowered.statement(ss.first, ss.rest, se)
  static statement (sf, sr, se) => (Lowered.kind(sf) == `def_name`) ? Lowered.local(Compiled.trimmed(Lowered.parsed(sf).def_name), None, Lowered.parsed(sf).def_value, sr, se) : ((Lowered.kind(sf) == `typed_name`) ? Lowered.local(Compiled.trimmed(Lowered.parsed(sf).typed_name), Compiled.trimmed(Lowered.parsed(sf).typed_type), Lowered.parsed(sf).typed_value, sr, se) : Lowered.statement_then(sf, sr, se))
  static statement_then (sf, sr, se) => {
