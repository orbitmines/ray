// `with` code, one line or a block: what it sets is set for where it is read (`&.caller`: the rewrite it is read in) and
// everything run from there, and gone when that ends: written into that program, not where the name is held. (The code is
// read in a node whose `=` does that; `assume` is the same.)
with {{code}} ^keyword =>
  writing (&.caller) {
    {code}
  }
writing {program} {{code}} =>
  {program}
  {
    {name} = {value} =>
      {value}
      {program} &+= {
        {name} =>
          {value}
      }
  } reading {
    {code}
  }
goto styled
keyword
assume {{code}} ^keyword =>
  writing (&.caller) {
    {code}
  }
// (settings, then a block: `with Font.inherited = em { … }`, the block read as it is written, what it answers)
{`with`} {settings} {{block}} ^keyword =>
  writing (&.caller) {
    {settings}
  }
  {block}

// A superposition: one of these values (`a | b`), and `x?`: `x` or None (methods on Node).
| {other} =>
  {
    superposes := true
    components := Listing.new.append(.).joined({other})
  }
assert (1 | +2 | +3) == (1 | 3 | 6)  // CL2 a section after | is not applied to the value before it
assert (1 | 2 | 3)#.count == 3  // HS2 a superposition of three does not have three possible values
assert #(1 | 2) == (1 | 2)#  // HS6 #x is not x#
assert "A" is 1 ("A" | "B")  // HS7 one of two possibilities is not a counted type of one
assert !(("A" | "B") is 1 ("A" | "B"))  // HS8 both possibilities are a counted type of one
assert ("A" | "B") is 50% ("A" | "B" | "C" | "D")  // HS9 two of four possibilities are not half of them
assert "B" is 0.5 ("A" | "B")  // HS10 half of two possibilities is not one
assert (1 | 2) + 1 == 2 | 3  // SP4 an operator does not carry through |
assert 10 - (1 | 2) == 9 | 8  // SP5 a superposition on the right does not carry
// A superposed element makes branches: one path through each value (U1)
assert ([1, "2a" | "2b", 3]).(
  .#.count == 2  // SP8 a superposed element in a list does not make two paths
  & .#.some(== [1, "2b", 3])  // SP9 a path through the second value is missing
)
assert {
  chosen := 1 | 2
  result := chosen + 10
  assert result{chosen == 2} == 12  // SP12 fixing a source does not refine what depends on it
}
goto styled
operator
? =>
  None | .
goto styled
operator

// Diagnostics: handed to the host (its label `report`, `.` this reading), and a value.
ERROR {message} ^error =>
  goto report
  {
    message := {message}
    fatal := false
  }
assert {
  missing_file := () => {
    ERROR `not 0`
    7
  }
  assert missing_file() == 7  // ER14 a non-fatal error replaced the value the function answers
  assert missing_file().diagnostics.last.origin == missing_file  // ER15 an error does not know the function it came from
  stopping := () => {
    FATAL `cannot go on`
    7
  }
  assert stopping() is Diagnostic  // ER16 a fatal error is not what the function answers
  // ER17 a handler for errors from one function did not take them
  assert (missing_file()
    $missing_file 8) == 8
  // ER18 a handler for another function's errors took them
  assert (missing_file()
    $stopping 8) == 7
  NotFound := class
  looking := () => {
    ERROR@NotFound `no such page`
    3
  }
  // ER19 an error of a type is not caught by that type
  assert (looking()
    $NotFound 4) == 4
  // ER20 an error of a type was caught by another function's handler
  assert (looking()
    $missing_file 4) == 3
  assert looking().diagnostics.last.type === NotFound  // ER21 an error does not keep the type written after @
}
FATAL {message} ^fatal =>
  goto report
  {
    message := {message}
    fatal := true
  }
WARN {message} ^warn =>
  goto report
INFO {message} ^info =>
  goto report
TODO {message} ^debug =>
  None
ensure {condition} =>
  unless {condition} {
    ERROR assertion failed
  }
  {condition}

// A node made in a value (`x.interior`): it sees what the value sees, the value's rules first. `x.extended()`: one to make a
// class in (a class's own makes it where its instances are). (Named so no class's field of the same name hides it.)
interior =>
  { }
extended () =>
  .interior

// (A head with `x: {…}` in it is written `x:{ }{…}`, which means the same space, so the rule for a name with a type does not
// read it as one.)
// A class: a node made of its parent (`class: P`, else Node), its block read in it (`.` it); it sees its parent's rules, so an instance
// of it does too. (Made in a node holding `superclass` and `extended`: they are read through it, not its own rules, which are what a
// typed hole `{x: T}` reads.) With fields, written as a closure is, `class (x, y) => { … }`: the class's `instance`, that closure (a call
// of it, the instance: in the class, its fields given the arguments; `of` its class), is what `X(…)` calls.
// (where it is read: the node its text is read in (in a call, the call's), not what `.` is there)
written_here =>
  goto here
made class:{ }{parent} {{block}} =>
  written_here -- (written_in => ({parent}.extended() &+= {
    superclass := {parent}
    extended := () =>
      interior reading {
        { }
      }
    interior := { }
    // (it sees what is where it is written, after its own and its parent's: a class in a class sees the names beside it)
    (. including written_in) unless written_in === global
    interior reading {
      {block}
    }
  }).interior)
goto styled
keyword
// (one without fields makes instances too: given nothing, or named arguments, code inlined into the making)
class:{ }{parent} {{block}} =>
  class: {parent} (arguments = None) => {
    {block}
  }
goto styled
keyword
// (the block read once for the class; again for each instance, only what is not a definition (`instanced`)) (a header of bits,
// one with pieces that are not parameters, has its maker made by the host, `instance_defined`)
nearest class:{ }{parent}{ }({fields}) => {{block}} =>
  (made class: {parent} {
    {block}
    (goto of-bits) unless plain {
      {fields}
    }
    instance := ({fields}) =>
      of := instance
      (here of) instanced {
        {block}
      }
      of := instance
    goto made-plainly
    of-bits\
    instance_defined {
      {fields}
    } {
      {block}
    }
    made-plainly\
    // (what is added to the maker, `X &+= { … }`, is added to the class)
    instance &+= {
      {`&+=`} {{added}} =>
        interior &+= {
          {added}
        }
        .
    }
    text_reader := { }
    text_read (x) =>
      text_reader reading {
        headed {
          {fields}
        }
      }
      read := text_reader reads_text x
      read ? instance(read.spreading) : None
  }).instance
goto styled
keyword
class {{block}} ^keyword =>
  class: Node {
    {block}
  }
// (a header written without `=>` before its block, the form the library writes, `class (h) { … }`; or without brackets, or
// without a block, `class byte: Byte`: the same class) (after the one above, so they read a header it would take as code)
class{ }{name}:{ }{type} =>
  class: Node ({name}: {type}) => { }
class{ }{name}:{ }{type} {{block}} =>
  class: Node ({name}: {type}) => {
    {block}
  }
class{ }({fields}) =>
  class: Node ({fields}) => { }
class{ }({fields}) {{block}} =>
  class: Node ({fields}) => {
    {block}
  }
class<{{given}}>{ }({fields}) =>
  class: Node ({given}, {fields}) => { }
class<{{given}}>{ }({fields}) {{block}} =>
  class: Node ({given}, {fields}) => {
    {block}
  }
// (written over lines: `(` and `)` each with the fields on the lines between)
class{ }({ }{fields}{ }) =>
  class: Node ({fields}) => { }
class{ }({ }{fields}{ }) {{block}} =>
  class: Node ({fields}) => {
    {block}
  }
class<{{given}}>{ }({ }{fields}{ }) =>
  class: Node ({given}, {fields}) => { }
class<{{given}}>{ }({ }{fields}{ }) {{block}} =>
  class: Node ({given}, {fields}) => {
    {block}
  }
// (a class of a parent and nothing of its own, `Digit := class: String`)
class:{ }{parent} =>
  (goto .) if (.parent) spaced
  class: {parent} { }
class{ }({fields}) => {{block}} =>
  class: Node ({fields}) => {
    {block}
  }
goto styled
keyword
// (one given values before its fields, `class<code: Huffman> (…)`, `C<code>(…)`: those are its first fields)
class<{{given}}>{ }({fields}) => {{block}} =>
  class: Node ({given}, {fields}) => {
    {block}
  }
{{name}}{ }:={ }class<{{given}}>{ }({fields}) => {{block}} =>
  {name} := (class: Node ({given}, {fields}) => {
    {block}
  })

// What a value is: a Node (anything is; the outermost node); the value itself; an instance of the class (or of one after it,
// `class:`) it was made by; one of a superposition's components; a narrowing that holds of it; a member of an enumeration; a
// superposition, when each of its components is.
of := None
superclass := None
superposes := false
// (the program read at the top was read by none)
caller := None
descends (type, depth = 0) =>
  (. === type) || ((depth < 64) && .superclass ? .superclass.descends(type, depth + 1) : false)
is {type} ^keyword =>
  ({type} === Node) || (. === {type}) || (.of ? .of.descends({type}) : false) || ({type}.superposes ? {type}.components.some((component) => . is component) : false) || ({type}.narrows ? ((. is {type}.narrows) && {type}.holds(.)) : false) || ({type}.members ? {type}.members.some((member) => member === .) : false) || (.superposes ? .components.every((component) => component is {type}) : false)
// `is`, quantifiers and membership (A5, R1.1)
assert ("A", "A", "A") is "A"[]  // IS1 is does not ask instance_of

// A value written into text (not text) taken by a typed hole `{x: T}`: one that is a T. (Written as a typed hole is above: this
// right side answers something only then.)
{value: type} =>
  (goto not_one) unless {value} is {type}
  {value}
  not_one\
goto styled
punctuation

// A level: a node of rules a value is given to (`{x: T} => …`): the value, written into text, read in it (by the first of
// them that takes it; none, the value).
{level} reducing {value} =>
  {level} reading {
    {value}
  }
goto styled
keyword

// A level given to a running program (`& including level`): its rules seen in the program (above what is where code is written).
{on} including {level} =>
  {on} &+= {
    {level}
  }
goto styled
keyword

// `this`: what `.` is.
this ^keyword =>
  .
// `x ^style`: x, shown in that style (highlighting only).
^{style} =>
  .
// One written `{this}…`: a method, `…` read on a value (`{this}{{narrowing}} =>`: `x{ … }`).
{`{`}this{`}`}{head} => {body} =>
  {head} =>
    goto .
    {body}
goto styled
punctuation
{`{`}this{`}`}{head} {`^`}{style} => {body} =>
  {head} =>
    goto .
    {body}
  goto styled
  {style}
goto styled
punctuation

// A value checked against a type: reported when it is not one (None, not given yet, and anything against no type, pass).
type := None
checked {type} =>
  unless ({type} === None) || (. === None) || (. is {type}) {
    ERROR a value is not of the type it is given to
  }
  .
goto styled
keyword

// `static`: what follows is read where it is (a class's block is read once, for the class). A value given a name, when it is
// first read (the class is there by then: `static plane := Space(…)` in `Space`), then that value; a class or a list written
// out, where it is (a class made later, from where it is first read, does not find its own names; a list is made once).
static {{statement}} =>
  {statement}
goto styled
keyword
{`static`} {name} {`:=`} {value} =>
  (goto .) unless (.name) named
  (goto made_now) if ((.value) begins "class") || ((.value) begins "[")
  goto lazily
  made_now\
  {name} := {value}
  goto made
  lazily\
  {name}_kept := None
  {name} =>
    ({name}_kept = ({value})) if {name}_kept === None
    {name}_kept
  made\
goto styled
keyword
{`static`} {name}:{ }{type} = {value} =>
  (goto .) unless (.name) named
  {name} =>
    {name} = global.{name}
    kept := ({value}) checked ({type})
    {name} = kept
    kept
goto styled
keyword

// A class's block read for an instance: what declares is the class's (read once, for it); the rest (`&.caller[name] =
// this`) is read in the instance. What declares: a definition (its line has the definer), and what these read.
instanced {{code}} =>
  goto instanced
  {code}
goto styled
keyword
goto declaring
{name} := {value}
goto declaring
{name}:{ }{type}
goto declaring
{name}:{ }{type}, {{rest}}
goto declaring
{name}:{ }{type} = {value}
goto declaring
{pattern: Pattern}:{ }{type}
goto declaring
{on}.{name} := {value}
goto declaring
({name}) := {value}
goto declaring
({name}, {names}) := {list}
goto declaring
static {{statement}}

from (x) =>
  None
text_read (x) =>
  None
// `if x { case => value … } else { … }`: `==` unless an operator is written, `is` for a type (P2.11)
assert {
  described (x) => if x {
    is Number => "number"
    "A" => "letter"
  } else {
    "other"
  }
  assert described(5) == "number"  // MA1 an is case does not match an instance of its type
  assert described("A") == "letter"  // MA2 a case with no operator is not asked with ==
  assert described(true) == "other"  // MA3 the else case does not take what nothing else does
}
assert {
  graded (x) => if x {
    < 10 => "low"
  } else {
    "high"
  }
  assert graded(3) == "low"  // MA4 a case with an operator is not asked with it
}
assert {
  first_case (x) => if x {
    1 => "one"
    is Number => "number"
  } else {
    "other"
  }
  assert first_case(1) == "one"  // IC1 a later case answers before an earlier one that holds
  assert first_case(2) == "number"  // IC2 a case that does not hold answers
}
goto styled
keyword
// (a conversion written in the class converted to, `(x: S) as (=== T) => …`: what T makes of an S)
({parameter}) as (=== {type}) => {body} =>
  ({type}).from := (({parameter}) => {body})
// (a conversion written in the class converted from, `as (=== T) => …`: what a value of it is read as a T, `x as T` written so)
{`as`} (=== {type}) => {body} =>
  as {type} =>
    {body}

// What a value holds under a key: its entries (`keyed`: `key`, `value`), a Ray; none until one is given.
keyed := None
Holding := class (key, value) => { }
held (key) =>
  found := (.keyed) ? .keyed.find((entry) => entry.key === key) : None
  found ? found.value : None
assert {
  held := 0
  unless true { held += 1 }
  unless 1 == 1 { held += 1 }
  unless mark { held += 1 }
  assert held == 0  // HO2 unless takes the block when the condition holds
}
assert {
  {left} - {right} => (
    held := 2
    held + 1
  )
  assert 10 - 3 == 3  // RW1 a body that declares a name is not run
  assert 1 - 1 == 3  // RW2 it answers the same wherever it stands
}
holding (key, value) =>
  (.keyed := []) unless (. reading { here keyed }) && .keyed
  found := .keyed.find((entry) => entry.key === key)
  if found {
    found.value = value
  } else {
    .keyed.append(Holding(key, value))
  }
  value

// (what a narrowing narrows: see `T{constraint}`)
narrows := None
// An enumeration: `enum A | B | C`, a node with a member for each name (a node in it), and `members` them all (the names
// are code: handed on as written; a rule's right side is not read by that rule, but what is in a group is).
members := None
nearest enum {{names}} =>
  Node.interior &+= {
    members := []
    enumerated {names}
  }
assert {
  Shape := enum circle (radius: Number) | square (side: Number) | point
  assert Shape.circle.radius  // EM8 a member does not carry its field
  assert Shape.square.side  // EM9 the second member does not carry its field
  assert !(Shape.point.radius)  // EM10 a member carries another's field
  assert Shape.point  // EM11 a member without fields is not there
  assert Shape.circle is Shape  // EM16 a member is not one of its own enum
}
assert {
  Modifier := enum static | readonly | this
  assert Modifier.this  // EM12 a member named this is not there
}
assert {
  Level := enum low (rank: Number) | high (rank: Number) {
    ranked => rank
  }
  assert Level.low.ranked  // EM17 a block over lines lost what it declares
  assert Level.high.ranked  // EM18 the last member gained nothing from the block
  assert Level#.count == 2  // EM20 an enum of two written with a block has other than two members
  assert !(Level.low == Level.high)  // EM21 two members written with a block are the same
}
goto styled
keyword
enumerated {name} =>
  {name} := { }
  members.append({name})
goto styled
keyword
nearest enumerated {name} | {{rest}} =>
  {name} := { }
  members.append({name})
  (enumerated {rest})
goto styled
keyword
// (a member written with fields, `Linux (platform: "linux")`: a record of them)
nearest enumerated {name} {`(`}{{fields}}{`)`} =>
  {name} := ({fields})
  members.append({name})
goto styled
keyword
nearest enumerated {name} {`(`}{{fields}}{`)`} | {{rest}} =>
  {name} := ({fields})
  members.append({name})
  (enumerated {rest})
goto styled
keyword
// (one with a block after its names, `enum A | B { … }`: the names (what the block says of the members is not read yet))
nearest enum {{names}} {{block}} =>
  enum {names}
goto styled
keyword

// `dynamically`: given again (run again) whenever what it reads is written from outside in the rewrite it is read in
// (`&.caller`), or anything run from there: `dynamically x := v` (x is v again), `dynamically code` (the code runs again).
// What it reads: the names its code has in it (a write of one it does not have goes on past it). (That program's `=`: the
// write, then each one whose code has the name in it again, once: what they write, while they do, does not; nor does any
// write while they are given again. A member written, `x.y = v`, is
// `x.y := v`: written as `y = v` in `x`. The `:=` form is written `{ }` after `dynamically`, so the code form, a modifier,
// does not read its definition.)
dynamics := None
dynamically {{code}} =>
  dynamic_in (&.caller) {
    {code}
  }
  {code}
assert {
  asserted := dynamically assert {
    true
    1 == 1
  }
  assert asserted  // DY1 a dynamic assert of holding conditions fails
}
assert {
  contributed := 1
  contribution := 2
  dynamically contributed &= contribution
  contribution = 3
  assert !(contributed == (1 & 2 & 3))  // FWQ6 a dynamic contribution kept its earlier value
}
// `dynamically x` reads x again each time (P5.1)
assert {
  moving := 1
  followed := dynamically moving + 1
  moving = 5
  assert followed == 6  // DY2 dynamically does not read again what it depends on
}
goto styled
keyword
dynamically{ }{name} := {{value}} =>
  {name} := {value}
  dynamic_in (&.caller) {
    {name} = ({value})
  }
goto styled
keyword
// `dynamically assert c`: no test; what holds of the data, checked where there is some (an instance, its class `of`), not
// when the class is made.
{`dynamically`} assert {condition} ^keyword =>
  (goto unchecked) unless here of
  ensure {condition}
  unchecked\
dynamic_in {program} {{code}} =>
  {program}
  {program} &+= {
    dynamics := dynamics ?? {
      updating := false
      refreshing := []
      refresh (written) =>
        // (its own flag given directly (`:=`): not a write the overrides below see)
        unless .updating {
          .updating := true
          .refreshing.for((one) => (one.again() if one.reads contains written))
          .updating := false
        }
    }
    {written} = {given} =>
      (goto quiet) if dynamics.updating
      {written} = {given}
      dynamics.refresh(.written)
      goto done
      quiet\
      {written} = {given}
      done\
    {on}.{written} = {given} =>
      (goto quiet) if dynamics.updating
      {on}.{written} := {given}
      dynamics.refresh(.written)
      goto done
      quiet\
      {on}.{written} := {given}
      done\
  }
  {program}.dynamics.refreshing.append({
    reads := .code
    again := () => {
      {code}
    }
  })
goto styled
keyword
// The classes the library adds to: what is iterable, an array of it, text (an array of characters), a number, a character
// (a number), a program, a diagnostic.
Iterable := class { }
// A list: its own methods first, then what Iterable has (the library adds the rest there).
Iterable &+= {
  Listing := {
    // (a class made of it, of it: not of Iterable's class)
    interior =>
      { }
    extended () =>
      .interior
    new =>
      {
        head := None
        tail := None
        listing := true
        of := Array
        spread := false
      }
    // (made by `,`: arguments, each its own; in brackets, `[a, b]`, one list)
    spreading =>
      .spread := true
      .
    gathered =>
      .spread := false
      .
    append (value) =>
      link := {
        value := value
        next := None
        previous := None
      }
      if .tail {
        link.previous := .tail
        .tail.next := link
      } else {
        .head := link
      }
      .tail := link
      .
    // (`xs[n]`, a number: its nth value, from 0; else what other readings make of it)
    [{index}] =>
      (goto .) unless {index} is Number
      at := .head
      left := {index}
      while at && left > 0 {
        at = at.next
        left = left - 1
      }
      at ? at.value : None
    // (the values of the lists in it in it, in their place: all the way down; `flatten(n)`, n lists down)
    flatten =>
      .flattened(64)
    flatten({levels}) =>
      .flattened({levels})
    flattened (levels) =>
      made := Listing.new
      .for((it) => (((it.listing === true) && (levels > 0)) ? it.flattened(levels - 1).for((x) => made.append(x)) : made.append(it)))
      made
    // (`xs{p}`: the values p holds for, `.` each one in it; `xs{x => p}`: each one given to it)
    {{constraint}} =>
      kept := Listing.new
      .for((it) => (kept.append(it) if (it with { {constraint} })))
      kept
    {`{`}{parameter} => {body}{`}`} =>
      kept := Listing.new
      .for((it) => (kept.append(it) if ((({parameter}) => {body}))(it)))
      kept
    // (a list led by a value: this one, the value first (a side that only declared is no value in it))
    led (value) =>
      (value === declared) ? . : .prepend(value)
    for (body) =>
      at := .head
      while at {
        body(at.value)
        at = at.next
      }
      .
    first =>
      .head ? .head.value : None
    last =>
      .tail ? .tail.value : None
    empty =>
      .head ? false : true
    count =>
      counted := 0
      at := .head
      while at {
        counted = counted + 1
        at = at.next
      }
      counted
    rest =>
      made := Listing.new
      at := .head ? .head.next : None
      while at {
        made.append(at.value)
        at = at.next
      }
      made
    prepend (value) =>
      link := {
        value := value
        next := None
        previous := None
      }
      if .head {
        .head.previous := link
        link.next := .head
      } else {
        .tail := link
      }
      .head := link
      .
    take () =>
      first := .head
      .head := first ? first.next : None
      .tail := .head ? .tail : None
      first ? first.value : None
    find (predicate) =>
      at := .head
      while at {
        return at.value if predicate(at.value)
        at = at.next
      }
      None
    some (predicate) =>
      found := false
      at := .head
      while at {
        if predicate(at.value) {
          found = true
          break
        }
        at = at.next
      }
      found
    every (predicate) =>
      !(.some((x) => !predicate(x)))
    map (mapping) =>
      made := Listing.new
      .for((x) => made.append(mapping(x)))
      made
    without (value) =>
      made := Listing.new
      .for((x) => (made.append(x) unless x === value))
      made
    listed () =>
      made := Listing.new
      .for((x) => made.append(x))
      made
    joined (other) =>
      if other.listing {
        other.listed().for((x) => .append(x))
      } else {
        .append(other)
      }
      .
    // (the same values in the same order: each the other's, or a list alike; anything not a list, not the same) (an operator
    // is read where a member was read on, so a list's `==` is the host's, which asks this)
    alike (other) =>
      (goto different) unless (other !== None) && other.listing
      at := .head
      there := other.head
      while at && there {
        (goto different) unless (at.value === there.value) || (at.value.listing && at.value.alike(there.value))
        at = at.next
        there = there.next
      }
      (goto different) if at || there
      return true
      different\
      false
    // (each value in the order of what `key` gives it, those it gives alike in the order they were)
    sort_by (key) =>
      made := Listing.new
      .for((x) => made.inserted(x, key))
      made
    inserted (value, key) =>
      at := .tail
      while at && (key(value) < key(at.value)) {
        at = at.previous
      }
      link := {
        value := value
        next := None
        previous := None
      }
      if at {
        link.previous := at
        link.next := at.next
        (at.next.previous := link) if at.next
        at.next := link
      } else {
        link.next := .head
        (.head.previous := link) if .head
        .head := link
      }
      (.tail := link) unless link.next
      .
    // (its values again, `count` times: `xs * n`)
    repeated (count) =>
      made := Listing.new
      left := count
      while left > 0 {
        made.joined(.)
        left = left - 1
      }
      made
    // (its values from `from` up to `to` (not it), counted from 0)
    slice (from, to) =>
      made := Listing.new
      at := .head
      index := 0
      while at && (index < to) {
        (made.append(at.value)) if index >= from
        at = at.next
        index = index + 1
      }
      made
    // (its values written one after another, `separator` between each two)
    join (separator) =>
      at := .head
      made := at ? at.value : ""
      at = at ? at.next : None
      while at {
        made = made + separator + at.value
        at = at.next
      }
      made
    // (where a value first is, counted from 0; none, None)
    index_of (value) =>
      at := .head
      index := 0
      while at {
        return index if at.value === value
        at = at.next
        index = index + 1
      }
      None
    // (the values of the lists in it, in order; a value that is not a list, itself)
    flatten =>
      made := Listing.new
      .for((x) => made.joined(x))
      made
  }
}
Listing := Iterable.interior.Listing
Ray := Listing
assert Ray.super.count  // C8 Ray.super does not reach Iterable's count
Array := class: Iterable { }
assert 1 is Array  // TY63 a number is not an array
String := class: Array { }
assert 1 + 2 as String == "3"  // PR38 as does not bind looser than plus
assert ("A", "A") is ...String  // SD3 ...T is not T[]
Number := class { }
assert 5 is Number  // TY5 five is not a Number
// Narrowings ask the constraint as well as what they narrow
assert {
  Small := Number{. < 5}
  Tiny := Small{. < 2}
  Even := Number{. % 2 == 0}
  assert 3 is Small  // TY16 three is not one of the small
  assert !(7 is Small)  // TY17 seven is one of the small
  assert 1 is Tiny  // TY19 one is not tiny
  assert !(3 is Tiny)  // TY20 three is tiny
  assert !(7 is Tiny)  // TY25 seven is tiny
  assert Tiny.admits(1)  // TY26 the tiny do not admit one
  assert !(Tiny.admits(3))  // TY27 the tiny admit three
  assert 4 is Small & Even  // TY65 four is not both small and even
  assert !(3 is Small & Even)  // TY66 three is both small and even
  assert !(6 is Small & Even)  // TY67 six is both small and even
}
assert 3 is Number  // TY18 three is not a number
// Calling a narrowed type chooses a value of it.
assert (Number{. > 5}()) > 5  // CN1 a value chosen from a narrowing does not satisfy it
// `boolean`: what `false` and `true` are (`false | true`); what the library adds to it (`boolean &+= { … }`), theirs.
boolean := class { }
assert {
  maybe: boolean? = None
  assert maybe ?? true  // BN3 ?? does not fall back on an optional left empty
}
// `#` is what a value may be (A1, T2.3)
assert boolean#.count == 2  // HS1 boolean does not have two possible values
assert boolean#.random is boolean  // FE3 a coin comes up with nothing
assert boolean#.random is boolean  // RN12 a coin lands on neither side
assert boolean{. == true}() == true  // CN2 the only member a narrowing admits is not the one chosen
assert (3 boolean).count == 3  // CN5 three called on boolean is not three of it
false &+= {
  of := boolean
  assert {
    Side := enum near (of: "here") | far (of: "there") {}
    assert Side.near == Side.near  // HO3 a member is not itself
    assert !(Side.near == Side.far)  // HO4 two members of one enum are the same
    assert Side.near.of == "here"  // HO5 what a member holds is not what it was written as
    assert !(Side.near.of == "there")  // HO6 a member holds what the other one does
  }
}
true &+= {
  of := boolean
}
false including boolean.interior
true including boolean.interior
Char := class: Number { }
assert U+0061 is Char.Latin  // UN45 a is not a Latin character
assert !(U+0627 is Char.Latin)  // UN46 alef is a Latin character
assert U+0627 is Char.Arabic  // UN53 alef is not an Arabic character
assert U+03B1 is Char.Greek  // UN54 alpha is not a Greek character
assert U+0430 is Char.Cyrillic  // UN55 a Cyrillic a is not Cyrillic
assert U+4E00 is Char.Han  // UN56 a Han character is not Han
Program := class { }
// A program run as a selection
assert Program(code: {
  1
  2
}).(
  .waiting  // RU1 a program nobody stepped is not waiting
  & .next.intermediate  // RU2 one step in is not intermediate
  & .waiting  // RU3 stepping a copy moved the original
  & .finished.final  // RU4 a program run to its end is not final
  & .finished.results.last == 2  // RU5 a program run to its end did not keep what its last step answered
)
assert {
  doubling := Program(code: { 2 })
  halving := Program(code: { 1 })
  ! doubling halving
  assert doubling⁻¹ === halving  // IV1 the declared inverse is not the inverse
  assert halving⁻¹ === doubling  // IV2 the inverse of the inverse is not the function
  assert doubling.reversible  // IV3 a function with an inverse is not reversible
}
// A program is a quest (P4.8): its cursor says how far it is; sleeping waits on the time (P4.11); a dynamic `&=` keeps one contribution (P5.7)
assert Program(code: { 1 }).(
  !(.done)  // FWQ2 a program not yet stepped is done
  & .finished.done  // FWQ3 a finished program is not a done quest
)
assert Program(code: { 1 }).stop.done  // FWQ4 a stopped program is not done
assert {
  started := Program(code: "1")
  @me/quests |= started
  assert started is @me/quests  // JB1 a program given to @me/quests is not among them
  assert started.who === @me  // JB11 a started program is not run by whoever started it
  assert started.stop.done  // JB5 stopping a program does not end it
}
assert Program(code: "1", from: @public).(
  .serves(@public)  // JB8 a quest serving a location does not serve it
  & !(.serves(@private))  // JB9 a quest serves a location it was not given
)
Narrowing := class { }
Diagnostic := class { }
// Errors: a value carries its diagnostics, and its type does not see them
assert {
  failing := (0).diagnosed(Diagnostic(message: "no"))
  assert failing $ 5 == 5  // ER1 a default does not stand in for an error
  assert failing $? === None  // ER3 an optional error is not None
  assert failing $? 6 == 6  // ER4 an optional error does not fall back
  assert failing $ { .message } == "no"  // ER5 the handler does not see the error as its receiver
  fatal_one := (0).diagnosed(Diagnostic(message: "true", fatal: true))
  assert (fatal_one $ 5).erred  // ER6 a default caught a fatal error
  assert fatal_one $?! === None  // ER7 the catch-all did not catch a fatal error
  assert (failing $ Diagnostic(message: "wrapped")).diagnostics.last.cause === failing.diagnostics.last  // ER8 a wrapped error forgot its cause
  assert failing.diagnosed(fatal_one.diagnostics.last).diagnostics.count == 2  // ER9 a value given a second diagnostic does not keep both
  assert failing is Number  // ER10 a value that erred is no longer of its type
  assert failing == 0  // ER11 a value that erred is not equal to itself without the error
  returning := () => {
    failing $ return 9
    1
  }
  assert returning() == 9  // ER13 $ return did not return from the function
}
// Checking a permission runs no one's code: a grant whose expression or filter has effects is refused when granted, and never run.
assert {
  purg_reader := Character(name: "purg-reader")
  purg_lamp := (lamp: 1)
  assert (purg_reader.read IO().output("leak")) is Diagnostic  // PURG1 a grant naming an expression with effects is granted
  assert (purg_reader{IO().output("leak")}.read purg_lamp) is Diagnostic  // PURG2 a grant whose filter has effects is granted
  assert !(purg_lamp.access)  // PURG3 a refused grant is kept
  assert !((purg_reader.read Time.now) is Diagnostic)  // PURG5 a grant reading the time is refused
}
assert (33% ("A" | "B" | "C")) is Diagnostic  // HS12 a share that is not a whole number of a discrete structure's possibilities is not a type error

// (`assert` once more, defined last: it binds loosest, `assert a === b` is `assert (a === b)`)
assert {condition} ^keyword =>
  goto afterwards
  ensure {condition}

// A theme: what each style is shown as (`^style = ^shown`: another style, or a colour, `^ #F2F0FF`), in the order written; the one
// made last, `Theme.current`, the one shown.
Theme := {
  current := None
}
{`theme`} {name} {{styles}} ^keyword =>
  made := {
    name := {name}
    styles := Listing.new
  }
  {
    {`^`}{style} = {`^`}{shown} =>
      named := .style
      colour := .shown
      made.styles.append([named, colour])
    {`^`}{style} = {`^`}{ }{shown} =>
      named := .style
      colour := .shown
      made.styles.append([named, colour])
  } reading {
    {styles}
  }
  Theme.current = made
  made

DARK := theme `Ether.ray - Dark` {

  ^U0 = ^ #F2F0FF
  ^U1 = ^ #C4B9FE
  ^U2 = ^ #9A86FD
  ^U3 = ^ #6C6783
  ^U4 = ^ #97A4BF

  ^D0 = ^ #F59E47
  ^D1 = ^ #EBAE6B
  ^D2 = ^ #FFCC99
  ^D3 = ^ #A18565
  ^D4 = ^ #8F8881

  ^external = ^D0
  ^label = ^D3

  ^namespace = ^U2
  ^type = ^U2
  ^class = ^U2
  ^enum = ^U2
  ^interface = ^U2
  ^struct = ^U2
  ^event = ^U2
  ^enumMember = ^U2
  ^typeParameter = ^U0
  ^parameter = ^U0
  ^variable = ^U1
  ^property = ^U1
  ^function = ^U4
  ^method = ^U4
  ^decorator = ^U4
  ^macro = ^U2
  ^keyword = ^U3
  ^modifier = ^U3
  ^comment = ^U3
  ^string = ^D2
  ^number = ^D2
  ^regexp = ^D2
  ^operator = ^U4

  ^character = ^D3
  ^punctuation = ^comment
  ^string.punctuation = ^D3

  ^fatal = ^error
  ^error = ^ #CD5C5C
  ^warn = ^ #CDCD5C
  ^info = ^ #5C5CCD
  ^debug = ^ #5CCD5C
  ^trace = ^comment

  // A test, `assert`, as what it found (failed, passed, not run); what is written after it in its own colours, muted: taken this
  // much toward this.
  ^failed = ^error
  ^passed = ^debug
  ^untested = ^comment
  ^muted = ^comment
  ^muting = ^ 50%
}






















assert {
  fired := 0
  unless false { fired += 1 }
  unless 1 == 2 { fired += 1 }
  unless None { fired += 1 }
  assert fired == 3  // HO1 unless does not take the block when the condition does not hold
}








