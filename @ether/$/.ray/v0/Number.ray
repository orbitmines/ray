// Binary{length == 1} == boolean

// class Number
//   Nat | ℕ <n> = Array{length == n}().last&&
//   ℝ: Any Base ℝ
// { ℕ, ℝ } = Number

// What the language reaches today. A number is a Ray: the chain from it to its
// terminal is its magnitude, zero is the terminal itself, and the successor of
// n is a new entry whose `next` is n. `==` needs no definition of its own — it
// is Ray's structural walk over exactly that chain — and `> <= >= min max`
// come from `Ordered` once `<` is given.
Number := class: Ray {
  succ => Number(next: this)

  // The digits of this number in a base, most significant first: a counter in
  // that base, least significant digit first, stepped once per unit and then
  // read backwards.
  digits_in (radix: Number) => (
    counter := chain None
    counter &= zero
    rest ^keyword := this
    while rest.nonzero {
      digit ^keyword := counter.head
      carrying ^keyword := true
      while carrying {
        digit.value = digit.value.succ
        if (digit.value == radix) { digit.value = zero } else { carrying = false }
        if carrying {
          unless (exists digit.next) { counter &= zero }
          digit = digit.next
        }
      }
      rest = rest.pred
    }
    out ^keyword := chain None
    walker ^keyword := counter.tail
    while (exists walker) {
      out &= walker.value
      walker = walker.previous
    }
    out
  )
  // The number some digits spell in a base.
  from_digits (radix: Number, spelled) => (
    total ^keyword := zero
    spelled for { total = (total * radix) + it.value }
    total
  )
  pred => .next

  is_zero => .is_terminal
  nonzero => .is_zero.not

  // Walks along the chain rather than nesting one application per unit, so a
  // thousand is as cheap to reach as ten.
  + (other: Number) => (
    total := this
    left := other
    while left.nonzero {
      total = total.succ
      left = left.pred
    }
    total
  )

  // Subtraction floors at zero; the negative half of the line is `Integer`.
  - (other: Number) => (
    rest := this
    left := other
    while (left.nonzero.and(rest.nonzero)) {
      rest = rest.pred
      left = left.pred
    }
    rest
  )

  * (other: Number) => (
    multiplied := zero
    left := other
    while left.nonzero {
      multiplied = multiplied + this
      left = left.pred
    }
    multiplied
  )

  < (other: Number) => (
    mine := this
    theirs := other
    while (mine.nonzero.and(theirs.nonzero)) {
      mine = mine.pred
      theirs = theirs.pred
    }
    mine.is_zero.and(theirs.nonzero)
  )

  // Division walks the dividend once, with the divisor walked alongside it:
  // each time the divisor runs out one more is counted and it starts over.
  / (other: Number) => (
    quotient := zero
    rest := this
    step := other
    while (rest.nonzero.and(other.nonzero)) {
      rest = rest.pred
      step = step.pred
      if step.is_zero {
        quotient = quotient.succ
        step = other
      }
    }
    quotient
  )
  % (other: Number) => (
    rest := this
    step := other
    while (rest.nonzero.and(other.nonzero)) {
      rest = rest.pred
      step = step.pred
      if step.is_zero { step = other }
    }
    if other.is_zero { this } else { other - step }
  )
  // Half of this, walking two links at a time.
  half => (
    count := zero
    rest := this
    while rest.nonzero {
      rest = rest.pred
      if rest.nonzero {
        rest = rest.pred
        count = count.succ
      }
    }
    count
  )

  == (other: Number) => (
    mine := this
    theirs := other
    while (mine.nonzero.and(theirs.nonzero)) {
      mine = mine.pred
      theirs = theirs.pred
    }
    mine.is_zero.and(theirs.is_zero)
  )
  != (other: Number) => (this == other).not

  // `def times callback: () => *`, without the index the draft leaves open.
  // `def times callback: () => *`, with the index the draft leaves open as `it`:
  // the block runs this many times and sees which round it is.
  times (block) => .rounds(block, zero)
  rounds (block, it: Number) => if .is_zero { this } else {
    inline block

    this.next.rounds(block, it.succ)
  }

  pow (exponent: Number) => (
    power := one
    left := exponent
    while left.nonzero {
      power = power * this
      left = left.pred
    }
    power
  )
  squared => this * this

  // `//TODO factorial!` above.
  factorial => (
    raised := one
    left := this
    while left.nonzero {
      raised = raised * left
      left = left.pred
    }
    raised
  )

  gcd (other: Number) => (
    a := this
    b := other
    while b.nonzero {
      rest := a % b
      a = b
      b = rest
    }
    a
  )
  lcm (other: Number) => (this * other) / (this.gcd(other))

  divides (other: Number) => (other % this).is_zero
  coprime (other: Number) => (this.gcd(other)) == one

  even => (
    parity := true
    rest := this
    while rest.nonzero {
      parity = parity.not
      rest = rest.pred
    }
    parity
  )
  odd => .even.not

  // `Decimal.% => this / 100`: the fraction of a hundred this number is.
  percent => this / hundred

  min (other: Number) => if (this < other) { this } else { other }
  max (other: Number) => if (this < other) { other } else { this }

  // `Nat | ℕ`: every number here is natural; the draft's `ℝ` and the base
  // towers wait on strings.
  is_natural => true
}

zero  := Number()
one   := zero.succ
two   := one.succ
three := two.succ
four  := three.succ
five  := four.succ
six   := five.succ
seven := six.succ
eight := seven.succ
nine  := eight.succ
ten   := nine.succ
hundred  := ten * ten
// A thousand is built when first asked for.
thousand => hundred * ten

// class Number
//   static Bases = { Binary: Digit = "0" | "1", …, Hexadecimal: Digit = Decimal | ("a" | "A")..("f" | "F") }
// class Digit < String
// dynamically (on Number.Bases).for name
//   class[name] < Number, integer: Digit.value+
//     static Digit = Number.Bases[name]
//     static class Signed < sign: "-"?, integer: Base
//     static class Real < integer: Base, ".", fraction: Base{unbounded}
//       static class Signed < sign: "-"?, real: Real
//       rational => fraction ==.instance_of (Base | Base[]{length == ∞})
//       irrational => !rational
//     Base{: 0+, number: Base} as (=== Base) number
//
// A base is allocated by `base Name radix`, which is what the draft's loop over
// `Number.Bases` does for each entry: the table gains it, and the name becomes
// the class of numbers read in that base. Any base can be allocated later the
// same way. A number of a base holds the one number (its unary chain) and
// reads it as digits; the digits' spellings wait on String.ray.
// spec: `Digit` is the number below the radix, its spelling comes with String.
// static class Signed < sign: "-"?, integer: Base
// The sign is present exactly when the number is below zero.
Number.Signed = class {
  sign?: Node
  integer: Number

  negative => exists .sign
  positive => .negative.not
  is_zero => .integer.is_zero

  - => .negated
  negated => if .negative { Number.Signed(integer: .integer) } else { Number.Signed(sign: global, integer: .integer) }
  abs => Number.Signed(integer: .integer)

  // Same signs add magnitudes; different signs subtract the smaller from the
  // larger and keep its sign.
  + (other: Number.Signed) => if (.negative.xnor(other.negative)) {
    Number.Signed(sign: .sign, integer: .integer + other.integer)
  } elsif (other.integer < .integer) {
    Number.Signed(sign: .sign, integer: .integer - other.integer)
  } else {
    Number.Signed(sign: other.sign, integer: other.integer - .integer)
  }
  - (other: Number.Signed) => this + other.negated
  * (other: Number.Signed) => if (.negative.xnor(other.negative)) {
    Number.Signed(integer: .integer * other.integer)
  } else {
    Number.Signed(sign: global, integer: .integer * other.integer)
  }

  == (other: Number.Signed) => (.negative.xnor(other.negative)).and(.integer == other.integer)
  < (other: Number.Signed) => if .negative {
    if other.negative { other.integer < .integer } else { true }
  } else {
    if other.negative { false } else { .integer < other.integer }
  }
}

// static class Real < integer: Base, ".", fraction: Base{unbounded}
//   static class Signed < sign: "-"?, real: Real
//   rational => fraction ==.instance_of (Base | Base[]{length == ∞})
//   irrational => !rational
// spec: the fraction is the number its digits spell after the point; an
// unbounded (repeating) fraction awaits infinite chains, so every real spelled
// here is rational.
Number.Real = class {
  integer: Number
  fraction: Number

  Signed := class {
    sign?: Node
    real: Number.Real

    negative => exists .sign
  }

  rational => true
  irrational => .rational.not
}

Number.Bases = chain None
base{ }{literal name ^class}{ }{size} ^keyword => (
  Number[name] = class: Number {
    radix := (size)
    Digit := Number{. < radix}

    // integer: Digit.value+ — the digits of a number in this base, most
    // significant first.
    integer => .digits_in(radix)
    digits (n: Number) => n.digits_in(radix)
    // The number some digits of this base spell.
    of_digits (spelled) => Number.from_digits(radix, spelled)
    // spec: the draft's `Base.String`, the strings that spell a number of this
    // base, is `global.String{.spells_in(radix)}`; it is not named here, since
    // a `String` of a base shadows the class for everything built on one.

    // A number of this base is read from its text a byte at a time, and the
    // reading stops at the first byte that is no digit of this base.
    accepts (text) => (
      total ^keyword := zero
      read ^keyword := false
      readable ^keyword := true
      byte ^keyword := chain None
      left ^keyword := eight
      take (b) => (
        byte &= (inline b)
        left = left.pred
        if left.is_zero {
          digit := digit_of(byte)
          if (exists digit) {
            if (digit < radix) {
              total = (total * radix) + digit
              read = true
            } else { readable = false }
          } else { readable = false }
          byte = chain None
          left = eight
        }
        readable.holds
      )
      external bits text take
      if (readable.and(read)) { total } else { None }
    )

    // static class Signed < sign: "-"?, integer: Base
    // static class Real < integer: Base, ".", fraction: Base{unbounded}
    // spec: the signed and real numbers of a base are Number's, read in it.
    Signed := class: Number.Signed { }
    Real := class: Number.Real { }
  }
  global[name] = Number[name]
  Number.Bases &= Number[name]

  Number[name]
)

base Binary two
base Ternary three
base Quaternary four
base Quinary five
base Senary six
base Septenary seven
base Octal eight
base Nonary nine
base Decimal ten
base Undecimal ten.succ
base Duodecimal (ten + two)
base Tridecimal (ten + three)
base Tetradecimal (ten + four)
base Pentadecimal (ten + five)
base Hexadecimal (ten + six)

// Decimal
//   % => this / 100
Decimal.components.hierarchy &= class {
  percent => this / hundred
}

// Every natural number is also the signed integer it is, in any base; the
// decimal one is the draft's `Integer`.
Number.components.hierarchy &= class {
  signed => Decimal.Signed(integer: this)
  as_integer => .signed
  // `.sign` on all numbers, so that `x.sign` reads on any of them: a natural
  // number has none (its sign is the empty string), is positive, is its own
  // absolute value, and negates into the signed integer below zero.
  sign => None
  negative => false
  positive => true
  abs => this
  negated => .signed.negated
}

// Probability = Number{0 <= . <= 1}
// spec: a probability is a real between zero and one; until reals are read
// from text it is the number itself, bounded above by one.
Probability := Number{. < two}

// {
//   (Σ | ∑): sum -> +,
//   ∏: product -> *
// }.for symbol, method -> operation
//   Applicable = Iterable<T: {`operation`(:T) => T}>
//   +def Applicable
//     def `method` = reduce(operation)
//   end
//   namespace `symbol`
//     def `iterable: Applicable` = iterable.`method`
//   end
// end
Iterable.components.hierarchy &= class {
  sum => (
    total ^keyword := zero
    this for { total = total + it.value }
    total
  )
  product => (
    total ^keyword := one
    this for { total = total * it.value }
    total
  )
}
Σ{ }{iterable} ^keyword => (iterable).sum
∑{ }{iterable} ^keyword => (iterable).sum
∏{ }{iterable} ^keyword => (iterable).product

// def u`length: Decimal.Positive.String` = Binary.Positive{.length == length}
// def i`length: Decimal.Positive.String` = Binary.Positive{.length == length}
// spec: `u8`/`i8` await digits read from text; a width is a constraint on the
// count of binary digits.
u{ }{width} ^keyword => Binary{.integer.count < (width).succ}
i{ }{width} ^keyword => Binary.Signed{.integer.integer.count < (width).succ}

// The digit an ASCII byte spells, its bits most significant first: `0`..`9`
// are 0011 dddd, `a`..`z` and `A`..`Z` are 01c lllll and count from ten.
digit_of (byte) => (
  walker ^keyword := byte.head
  if walker.value { return None }
  walker = walker.next
  letter ^keyword := walker.value
  walker = walker.next
  if letter { walker = walker.next } else {
    unless walker.value { return None }
    walker = walker.next
    unless walker.value { return None }
    walker = walker.next
  }
  amount ^keyword := zero
  while (exists walker) {
    amount = amount + amount
    if walker.value { amount = amount.succ }
    walker = walker.next
  }
  if letter {
    if amount.is_zero { return None }
    return (amount + nine)
  }
  unless (amount < ten) { return None }
  amount
)

// def `digits: Decimal.Positive.String` => Decimal.Positive = digits
// A word nothing is named by, spelled in decimal digits, is the number it spells.
{number: Decimal ^number} => number
// def 0`"x" | "X"``digits: Hexadecimal.Positive.String` => Hexadecimal.Positive = digits
// def 0`"b" | "B"``digits: Hexadecimal.Positive.String` => Hexadecimal.Positive = digits
0x{number: Hexadecimal ^number} ^number => number
0X{number: Hexadecimal ^number} ^number => number
0b{number: Binary ^number} ^number => number
0B{number: Binary ^number} ^number => number

