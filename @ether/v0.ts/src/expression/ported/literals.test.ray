// Text and its characters on the seed alone (the claims that need the library are lib/literals.test.ray): a claim that does not
// hold says so (`INFO@mark`).
mark ^keyword := global
// the link after `n` more of them, nothing past the end
{l: Tight}.after_seven => l.next.next.next.next.next.next.next
bits := text_bits("a")
// `a` is 97, 1100001: seven bits, the first two ones, then four zeros
unless bits.head.value { INFO@mark `T1 the first bit of "a" is a one` }
unless bits.head.next.value { INFO@mark `T2 the second bit of "a" is a one` }
if bits.head.next.next.value { INFO@mark `T3 the third bit of "a" is a zero` }
unless bits.tail.value { INFO@mark `T4 the last bit of "a" is a one` }
last_of_seven := bits.head.next.next.next.next.next.next
unless (last_of_seven && (last_of_seven === bits.tail)) { INFO@mark `T5 "a" has seven bits` }
both := text_bits("ab")
eighth := both.head.after_seven
unless (eighth && (eighth.after_seven === None) && (eighth.next.next.next.next.next.next === both.tail)) { INFO@mark `T6 "ab" has fourteen bits` }
// `b` is 98, 1100010
if both.tail.value { INFO@mark `T7 the last bit of "ab" is a zero` }
unless eighth.next.next.next.next.next.value { INFO@mark `T8 the bit before it is a one` }
more := text_bits("a").bits_onto("b")
also := more.head.after_seven
unless (also && (also.next.next.next.next.next.next === more.tail)) { INFO@mark `T9 the bits of "b" onto those of "a"` }
c := character_of(Number())
unless c is Char { INFO@mark `T11 a point as a character is a Char` }
unless c is Number { INFO@mark `T12 a Char is a Number` }
points := code_points("ab")
unless (points.head.next && (points.head.next === points.tail)) { INFO@mark `T13 "ab" is two points` }
s := text_of(points)
unless s is String { INFO@mark `T15 points as text are a String` }
unless s.head.value is Char { INFO@mark `T16 its characters are Chars` }
unless (s.head.next && (s.head.next === s.tail)) { INFO@mark `T17 "ab" is two characters` }
