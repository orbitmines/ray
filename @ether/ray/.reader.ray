{pattern} => {body} =>
  external rule pattern body
{name} := {value} =>
  external declare name value
//{comment} =>
  external label comment

// Control flow: a block given after a word is a capture like any other, continued on deeper lines.
if {condition} then {block} =>
  external goto taken condition
  external goto done
  external label taken
  block
  external label done
unless {condition} then {block} =>
  external goto done condition
  block
  external label done
while {condition} do {block} =>
  external label again
  external goto body condition
  external goto done
  external label body
  block
  external goto again
  external label done

// Nodes, members, identity. What is declared first binds loosest, so `.` comes after the rules written with it.
nothing =>
  external get node nothing
node =>
  external node
same {a} {b} =>
  external same a b
set {x} . {member} to {value} =>
  external set x member value
{x} . {member} =>
  external get x member
yes =>
  external node

// ---------------------------------------------------------------- the reader (spec/Reader.md R1, R2), handed reading at the end
learned := external learned
end := learned . end
space := learned . space
indent := learned . indent
access := learned . access
defining := learned . definer

// Whether `a` is the same character as `b`.
character {a} is {b} =>
  external same a b

// The place after `chain` spelled from `at`, or nothing. A space in it also reads a line end and the indentation that
// continues a statement (R0.1, as the first statement wrote its definer's space).
spelled {chain} from {at} =>
  spells out chain up to nothing from at

// The same, for a chain that ends at `chain_end` (a literal written in a head).
spells out {chain} up to {chain_end} from {at} =>
  here := at
  wanted := chain
  result := yes
  if same wanted chain_end then
    wanted := nothing
  while wanted do
    unless here then
      result := nothing
      wanted := nothing
    if here then
      c := here . character
      w := wanted . character
      matches := character c is w
      continued := nothing
      unless matches then
        if character w is space then
          if character c is end then
            continued := continuation after here
      if continued then
        here := continued
        wanted := wanted . next
        matches := nothing
      if matches then
        here := here . next
        wanted := wanted . next
      if same wanted chain_end then
        wanted := nothing
      unless matches then
        unless continued then
          result := nothing
          wanted := nothing
  if result then
    set result . end to here
  result

// The place after a line end and one or more indentations, or nothing.
continuation after {at} =>
  here := at . next
  more := spelled indent from here
  found := nothing
  while more do
    found := more . end
    more := spelled indent from found
  found

// Characters the reader names are taken from where they are written here.
characters of {written} =>
  where := external span written
  where . from
quote := characters of "
slash := characters of /
slash := slash . character
quote := quote . character
pairs := characters of ()[]{}
opening := pairs . character
pairs := pairs . next
closing := pairs . character
pairs := pairs . next
opening_list := pairs . character
pairs := pairs . next
closing_list := pairs . character
pairs := pairs . next
opening_block := pairs . character
pairs := pairs . next
closing_block := pairs . character

// The bracket that closes `c`, or nothing when `c` opens none.
closer of {c} =>
  found := nothing
  if character c is opening then
    found := closing
  if character c is opening_list then
    found := closing_list
  if character c is opening_block then
    found := closing_block
  found

// Whether `c` closes a bracket.
closes {c} =>
  found := nothing
  if character c is closing then
    found := yes
  if character c is closing_list then
    found := yes
  if character c is closing_block then
    found := yes
  found

// Where the statement starting at `at` ends: the first line end not followed by a line deeper than `base` (R0.1), or `to`.
statement end from {at} to {to} below {base} =>
  here := at
  found := to
  open_ones := nothing
  while here do
    if same here to then
      here := nothing
    if here then
      c := here . character
      // a statement goes on while a bracket it opened is open (quoted text holds none)
      shut := closer of c
      if shut then
        pushed := node
        set pushed . shut to shut
        set pushed . next to open_ones
        open_ones := pushed
      unless shut then
        if open_ones then
          expected := open_ones . shut
          if character c is expected then
            open_ones := open_ones . next
        if character c is quote then
          skipping := here . next
          while skipping do
            if same skipping to then
              skipping := nothing
            if skipping then
              d := skipping . character
              if character d is end then
                skipping := nothing
            if skipping then
              if character d is quote then
                here := skipping
                skipping := nothing
              if skipping then
                skipping := skipping . next
      ending := nothing
      unless open_ones then
        if character c is end then
          ending := yes
      if ending then
        deeper := nothing
        next := here . next
        inside := next
        if base then
          inside := nothing
          based := spelled base from next
          if based then
            inside := based . end
        if inside then
          deeper := spelled indent from inside
        unless deeper then
          found := here
          here := nothing
      if here then
        here := here . next
  found

// Whether `b` comes after `a` before `limit` (walking: there are no integers).
{b} comes after {a} =>
  here := a
  found := nothing
  while here do
    here := here . next
    if same here b then
      found := yes
      here := nothing
  found

// A reading of `pieces` from `at` that ends at `limit`: its `captures` (a chain of `name`, `from`, `to`), or nothing. A capture
// reads one or more characters, the longest first; one that crosses a line end runs to `limit`.
// The same, in a `mode`: nothing reads up to `limit`; a prefix reading (on a receiver, R2.1) may end anywhere before it,
// its last capture reading one operand.
readings of {pieces} from {at} to {limit} in {mode} =>
  found := nothing
  unless pieces then
    ends_here := same at limit
    if mode then
      ends_here := yes
    if ends_here then
      found := yes
      set found . end to at
  if pieces then
    literal := pieces . literal
    gap := pieces . gap
    line_end := pieces . line_end
    fixed := literal
    far := nothing
    if literal then
      lit_from := pieces . from
      lit_to := pieces . to
      spelt := spells out lit_from up to lit_to from at
      if spelt then
        far := spelt . end
    if gap then
      fixed := yes
      far := spaces after at
    if line_end then
      fixed := yes
      if at then
        c := at . character
        if character c is end then
          far := at . next
    if far then
      within := same far limit
      unless within then
        within := limit comes after far
      if within then
        found := readings of pieces . next from far to limit in mode
    unless fixed then
      found := captured pieces from at to limit in mode
  found

readings of {pieces} from {at} to {limit} =>
  readings of pieces from at to limit in nothing

// The place after one or more spaces from `at`, or nothing when no space is there.
spaces after {at} =>
  here := at
  found := nothing
  while here do
    c := here . character
    if character c is space then
      here := here . next
      found := here
      unless here then
        here := nothing
    unless character c is space then
      here := nothing
  found

// The ends a capture from `at` can have, the shortest first (a capture that is not the first piece ends at the first place
// the rest reads from).
ends shortest from {at} to {limit} =>
  first := nothing
  last := nothing
  here := at . next
  crossed := nothing
  going := yes
  while going do
    at_limit := same here limit
    keep := yes
    if crossed then
      unless at_limit then
        keep := nothing
    if keep then
      link := node
      set link . place to here
      if last then
        set last . next to link
      unless last then
        first := link
      last := link
    if at_limit then
      going := nothing
    unless here then
      going := nothing
    if going then
      c := here . character
      if character c is end then
        crossed := yes
      here := here . next
  first

// The ends a capture from `at` can have, the longest first: every place after `at` up to `limit`, but past a line end only
// `limit` itself.
ends from {at} to {limit} =>
  stack := nothing
  here := at . next
  crossed := nothing
  going := yes
  while going do
    at_limit := same here limit
    keep := yes
    if crossed then
      unless at_limit then
        keep := nothing
    if keep then
      link := node
      set link . place to here
      set link . next to stack
      stack := link
    if at_limit then
      going := nothing
    unless here then
      going := nothing
    if going then
      c := here . character
      if character c is end then
        crossed := yes
      here := here . next
  stack

// Whether `type` holds the places from `from` to `to`: its check, when it has one, else its own rules reading them whole.
// Three values in order, as captures for a rule applied to values.
values {a} {b} {c} =>
  third := node
  set third . value to c
  second := node
  set second . value to b
  set second . next to third
  first := node
  set first . value to a
  set first . next to second
  first

{kind} holds from {from} to {to} =>
  check := kind . check
  found := nothing
  if check then
    given := values kind from to
    here := external .
    found := external apply check given here
  unless check then
    own := kind . rules
    found := reading from from to to among own
  found

captured {pieces} from {at} to {limit} in {mode} =>
  name := pieces . capture
  rest_pieces := pieces . next
  leading := pieces . leading
  ends := nothing
  if leading then
    ends := ends from at to limit
  unless leading then
    ends := ends shortest from at to limit
  // read on a receiver, a capture that ends the head reads one operand
  if mode then
    unless rest_pieces then
      ends := nothing
      operand_at := spaces after at
      unless operand_at then
        operand_at := at
      operand := operand end from operand_at to limit
      if operand then
        ends := node
        set ends . place to operand
  // an optional capture may hold nothing: tried after every other end
  optional := pieces . optional
  if optional then
    empty := node
    set empty . place to at
    tail := ends
    unless tail then
      ends := empty
    while tail do
      following := tail . next
      unless following then
        set tail . next to empty
      tail := following
  // a capture followed by a literal ends only where that literal starts (its first character, or a line end for a space)
  wanted := nothing
  if rest_pieces then
    following := rest_pieces . literal
    if following then
      following_from := rest_pieces . from
      wanted := following_from . character
  piece_type := pieces . type
  found := nothing
  while ends do
    e := ends . place
    worth := yes
    if wanted then
      worth := nothing
      if e then
        c := e . character
        if character c is wanted then
          worth := yes
        if character wanted is space then
          if character c is end then
            worth := yes
    if worth then
      if piece_type then
        unless same at e then
          worth := piece_type holds from at to e
    // a capture taken as written that ends the head takes one word
    if worth then
      if pieces . raw then
        unless rest_pieces then
          if spaced from at to e then
            worth := nothing
    rest := nothing
    if worth then
      rest := readings of rest_pieces from e to limit in mode
    if rest then
      cap := node
      set cap . name to name
      set cap . piece to pieces
      if piece_type then
        set cap . type to piece_type
      raw := pieces . raw
      if raw then
        set cap . raw to yes
      set cap . from to at
      set cap . to to e
      earlier := rest . captures
      set cap . next to earlier
      set rest . captures to cap
      found := rest
      ends := nothing
    if ends then
      ends := ends . next
  found

// Whether two chains spell the same.
chain {a} equals {b} =>
  x := a
  y := b
  result := yes
  while x do
    unless y then
      result := nothing
      x := nothing
    if y then
      c := x . character
      d := y . character
      unless character c is d then
        result := nothing
        x := nothing
      if x then
        x := x . next
        y := y . next
  if y then
    result := nothing
  result

// Where the reader keeps what it knows of its rules: the `latest` defined, and the `definer` (the first statement's rule).
registry := node

// Reading handed to the rule defined last (R0.6); bodies planned by the rule defined last, too.
hand reading over =>
  latest := registry . latest
  external reader latest
hand planning over =>
  external planner plan_rule

// The rule the seed defined last.
the seed's latest rule =>
  here := external .
  top := here . parent
  links := external rules top
  links . rule

// The same, stopping before the scope `outside` (a value's own rules and its classes', not the top scope's).
rules in reach of {scope} below {outside} =>
  first := nothing
  last := nothing
  here := scope
  if same here outside then
    here := nothing
  while here do
    links := here . rules
    while links do
      link := node
      r := links . rule
      set link . rule to r
      if last then
        set last . next to link
      unless last then
        first := link
      last := link
      links := links . next
    here := here . parent
    if same here outside then
      here := nothing
  first

// The rules in reach of `scope`: each scope's `rules`, nearest scope first (its parents through `parent`), latest first.
rules in reach of {scope} =>
  rules in reach of scope below nothing

// Whether one of `pieces` is a literal spelling the definer (learned from the first statement).
spells the definer {pieces} =>
  piece := pieces
  found := nothing
  while piece do
    if piece . literal then
      lit_from := piece . from
      lit_to := piece . to
      if chain spans lit_from lit_to as defining then
        found := yes
        piece := nothing
    if piece then
      piece := piece . next
  found

// Whether the places from `from` to `to` spell the chain `chain` (which ends by itself).
chain spans {from} {to} as {chain} =>
  here := from
  wanted := chain
  result := yes
  going := yes
  while going do
    here_done := same here to
    unless wanted then
      going := nothing
      unless here_done then
        result := nothing
    if going then
      if here_done then
        going := nothing
        result := nothing
    if going then
      c := here . character
      w := wanted . character
      unless character c is w then
        result := nothing
        going := nothing
      if going then
        here := here . next
        wanted := wanted . next
  result

// Whether the chain `a` has more pieces than the chain `b` (walked side by side: there are no integers).
more pieces in {a} than {b} =>
  x := a
  y := b
  going := yes
  while going do
    unless x then
      going := nothing
    unless y then
      going := nothing
    if going then
      x := x . next
      y := y . next
  result := nothing
  if x then
    unless y then
      result := yes
  result

// Whether two rules are written with the same head (their heads spell the same).
written alike {a} {b} =>
  x := a . head_from
  x_end := a . head_to
  y := b . head_from
  y_end := b . head_to
  result := yes
  going := yes
  while going do
    x_done := same x x_end
    y_done := same y y_end
    if x_done then
      going := nothing
      unless y_done then
        result := nothing
    if going then
      if y_done then
        going := nothing
        result := nothing
    if going then
      c := x . character
      d := y . character
      unless character c is d then
        result := nothing
        going := nothing
      if going then
        x := x . next
        y := y . next
  result

// What reads the statement from `at` to `limit` with the rules in reach of `scope` (R2.5): every rule that reads it whole;
// between them, one led by a literal over one led by a capture; then one written with the same head as a later one gives way
// to it (`=>`), otherwise the one declared first reads it (G3.1). The rules come nearest scope first, latest first. Answers
// a node with the `rule` and its `captures`, or nothing.
reading from {at} to {limit} in {scope} =>
  rules := rules in reach of scope
  reading from at to limit among rules

reading from {at} to {limit} among {rules} =>
  best := nothing
  best_rule := nothing
  definer := registry . definer
  while rules do
    rule := rules . rule
    pieces := rule . pieces
    r := readings of pieces from at to limit
    if r then
      take := yes
      if best then
        led := pieces . literal
        best_pieces := best_rule . pieces
        best_led := best_pieces . literal
        if written alike rule best_rule then
          take := nothing
        if led then
          // between two led by a literal, the one with more pieces is the more particular: it reads the statement
          if best_led then
            if more pieces in pieces than best_pieces then
              take := yes
            if more pieces in best_pieces than pieces then
              take := nothing
          unless best_led then
            take := yes
        unless led then
          if best_led then
            take := nothing
        // the rule that defines rules reads a definition whole, unless the other spells the definer itself (2026-10-06: a
        // method head with parameters is read by the rule written with the definer in it, not as a rule of that name)
        if written alike rule definer then
          take := yes
          if spells the definer best_pieces then
            take := nothing
        if written alike best_rule definer then
          take := nothing
          if spells the definer pieces then
            take := yes
      if take then
        best := r
        best_rule := rule
    rules := rules . next
  if best then
    set best . rule to best_rule
  best

// What reads the most of the text from `at` before `limit` among `rules`, read on a receiver (R2.1): its `rule`, `captures` and
// `end`. Between readings that end at the same place, as `reading from … among` chooses.
prefix reading from {at} to {limit} among {rules} =>
  best := nothing
  best_rule := nothing
  while rules do
    rule := rules . rule
    pieces := rule . pieces
    r := readings of pieces from at to limit in yes
    if r then
      take := yes
      if best then
        far := r . end
        best_far := best . end
        take := nothing
        if far comes after best_far then
          take := yes
        if same far best_far then
          take := yes
          best_pieces := best_rule . pieces
          if written alike rule best_rule then
            take := nothing
          if more pieces in best_pieces than pieces then
            take := nothing
      if take then
        best := r
        best_rule := rule
    rules := rules . next
  if best then
    set best . rule to best_rule
  best

// Whether the places from `at` to `limit` hold a space.
spaced from {at} to {limit} =>
  here := at
  found := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is space then
        found := yes
        here := nothing
      if here then
        here := here . next
  found

// One statement of a body, as a step (R0.4): a call of an external (`access name arguments…`), a rule with its captures, one
// word, or what nothing reads.
step from {at} to {limit} in {scope} =>
  made := node
  set made . from to at
  set made . to to limit
  led := spelled access from at
  called := nothing
  if led then
    after := led . end
    c := after . character
    if character c is space then
      called := after . next
  if called then
    set made . external to yes
    words := words from called to limit
    first := words . from
    set made . name_from to first
    last := words . to
    set made . name_to to last
    rest := words . next
    set made . arguments to rest
  unless called then
    r := reading from at to limit in scope
    if r then
      rule := r . rule
      set made . rule to rule
      caps := r . captures
      set made . captures to caps
    unless r then
      // what no rule in reach reads whole: its first operand, read when it runs, and the rest read by that value's rules
      split := operand end from at to limit
      sending := nothing
      if split then
        unless same split limit then
          sending := registry . sender
      if sending then
        sender := registry . sender
        set made . rule to sender
        pieces := sender . pieces
        receiver_piece := pieces . next
        rest_piece := receiver_piece . next
        rest_piece := rest_piece . next
        rest_cap := node
        set rest_cap . piece to rest_piece
        set rest_cap . from to split
        set rest_cap . to to limit
        set rest_cap . raw to yes
        receiver_cap := node
        set receiver_cap . piece to receiver_piece
        set receiver_cap . from to at
        set receiver_cap . to to split
        set receiver_cap . next to rest_cap
        set made . captures to receiver_cap
      unless sending then
        unless spaced from at to limit then
          set made . word to yes
  made

// Where the first operand from `at` ends: after a bracketed group, quoted text, or a word (up to a space, a bracket or a
// dot). Nothing when there is none.
operand end from {at} to {limit} =>
  c := at . character
  found := nothing
  shut := closer of c
  if shut then
    found := balanced end from at to limit
  unless shut then
    if character c is quote then
      here := at . next
      while here do
        if same here limit then
          here := nothing
        if here then
          d := here . character
          if character d is quote then
            found := here . next
            here := nothing
          if here then
            here := here . next
  unless found then
    unless shut then
      unless character c is quote then
        here := at
        while here do
          stop := same here limit
          unless stop then
            d := here . character
            if character d is space then
              stop := yes
            if closer of d then
              stop := yes
            if character d is dot then
              stop := yes
          unless stop then
            unless same here at then
              stop := a base rule starts at here
          if stop then
            unless same here at then
              found := here
            here := nothing
          if here then
            here := here . next
  found

// Whether one of the base's rules (what every value has: `Node`'s operators) starts with a literal spelled at `at`: an
// operand ends there (the operators the language defines decide where a word ends).
a base rule starts at {at} =>
  base := registry . base
  found := nothing
  if base then
    links := base . rules
    while links do
      rule := links . rule
      pieces := rule . pieces
      first_from := pieces . from
      first_to := pieces . to
      if pieces . literal then
        if spells out first_from up to first_to from at then
          found := yes
          links := nothing
      if links then
        links := links . next
  found

// The place after the bracket that closes the one at `at`.
balanced end from {at} to {limit} =>
  open_ones := nothing
  here := at
  found := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      shut := closer of c
      if shut then
        pushed := node
        set pushed . shut to shut
        set pushed . next to open_ones
        open_ones := pushed
      unless shut then
        if open_ones then
          expected := open_ones . shut
          if character c is expected then
            open_ones := open_ones . next
            unless open_ones then
              found := here . next
              here := nothing
      if here then
        here := here . next
  found

// The words from `at` to `limit`, separated by spaces: a chain of `from`, `to`.
words from {at} to {limit} =>
  first := nothing
  last := nothing
  here := at
  start := at
  while here do
    stop := same here limit
    unless stop then
      c := here . character
      if character c is space then
        stop := yes
    if stop then
      unless same start here then
        word := node
        set word . from to start
        set word . to to here
        if last then
          set last . next to word
        unless last then
          first := word
        last := word
      if same here limit then
        here := nothing
      if here then
        here := here . next
        start := here
    unless stop then
      here := here . next
  first

// The first place from `at` that is not a space, a line end or a comment (`//` to the line's end, skipped before any rule
// reads it: comments say anything, definitions included), or nothing before `to`.
blank from {at} to {to} =>
  here := at
  found := nothing
  while here do
    if same here to then
      here := nothing
    if here then
      c := here . character
      skip := nothing
      if character c is space then
        skip := yes
      if character c is end then
        skip := yes
      if character c is slash then
        following := here . next
        if following then
          f := following . character
          if character f is slash then
            skip := yes
            going := yes
            while going do
              following := here . next
              unless following then
                going := nothing
              if same following to then
                going := nothing
              if going then
                d := following . character
                if character d is end then
                  going := nothing
              if going then
                here := following
      unless skip then
        found := here
        here := nothing
      if here then
        here := here . next
  found

// The statements of a body from `from` to `to`, each at the body's indentation `base`: a chain of steps.
plan {from} to {to} below {base} in {scope} =>
  first := nothing
  last := nothing
  at := from
  while at do
    if same at to then
      at := nothing
    if at then
      at := blank from at to to
    if at then
      limit := statement end from at to to below base
      made := step from at to limit in scope
      if last then
        set last . next to made
      unless last then
        first := made
      last := made
      at := nothing
      if limit then
        unless same limit to then
          at := limit . next
          if base then
            based := spelled base from at
            if based then
              at := based . end
  first

plan_rule := the seed's latest rule

// ---------------------------------------------------------------- heads read in Ray (R2.2)
open := learned . open
close := learned . close

// The place of the bracket that closes one opened just before `at`, or nothing when another opens first or none closes.
closing from {at} to {limit} =>
  here := at
  found := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is open then
        here := nothing
      if here then
        if character c is close then
          found := here
          here := nothing
      if here then
        here := here . next
  found

// A piece of a head, added to the chain `into` (a node with `first` and `last`).
add {kind} piece from {piece_from} to {piece_to} into {into} =>
  made := node
  set made . from to piece_from
  set made . to to piece_to
  external set made kind yes
  last := into . last
  if last then
    set last . next to made
  unless last then
    set into . first to made
  set into . last to made

// The pieces of a head: a capture is the brackets around a name (its first word), brackets around brackets are literal,
// the rest is literal. A chain of `literal`/`capture`, each with `from` and `to`.
pieces of {head_from} to {head_to} like {like} =>
  into := node
  at := head_from
  start := head_from
  while at do
    if same at head_to then
      at := nothing
    if at then
      c := at . character
      captured := nothing
      if character c is open then
        inner := at . next
        shut := closing from inner to head_to
        if shut then
          unless same inner shut then
            captured := yes
      if captured then
        unless same start at then
          add literal piece from start to at into into
        what brackets hold from inner to shut into into like like
        at := shut . next
        start := at
      unless captured then
        at := at . next
  unless same start head_to then
    add literal piece from start to head_to into into
  into . first

// What a capture's brackets hold (R2.2): spaces only, a gap; `\n`, a line end; text in backticks, a literal; `literal`
// and a name, a capture taken as written; a name ending in `?`, a capture that may hold nothing; a name ending in `:` and a
// type, a typed capture (the type read once, here). Anything after the name (`^style`) is the highlighting's.
what brackets hold from {inner} to {shut} into {into} like {like} =>
  c := inner . character
  done := nothing
  if character c is space then
    rest := spaces after inner
    if same rest shut then
      add gap piece from inner to shut into into
      done := yes
  unless done then
    if character c is backtick then
      lit_from := inner . next
      lit_to := closing backtick from lit_from to shut
      if lit_to then
        add literal piece from lit_from to lit_to into into
        done := yes
  unless done then
    if character c is backslash then
      n := inner . next
      d := n . character
      if character d is letter_n then
        after_n := n . next
        if same after_n shut then
          add line_end piece from inner to shut into into
          done := yes
  unless done then
    name_from := inner
    name_end := word end from inner to shut
    raw := nothing
    if spells raw_word from name_from to name_end then
      unless same name_end shut then
        raw := yes
        name_from := name_end . next
        name_end := word end from name_from to shut
    last_char := last place from name_from to name_end
    l := last_char . character
    optional := nothing
    if character l is question then
      optional := yes
    typed := typed name from name_from to name_end
    bare := name_end
    if optional then
      bare := last_char
    if typed then
      bare := typed . name_end
    leading := nothing
    unless into . first then
      leading := yes
    add capture piece from name_from to bare into into
    made := into . last
    if raw then
      set made . raw to yes
    if optional then
      set made . optional to yes
    if leading then
      set made . leading to yes
    if typed then
      type_from := name_end . next
      capture_type := external read type_from shut like
      set made . type to capture_type

// The place of the backtick that closes one, from `at`, before `limit`.
closing backtick from {at} to {limit} =>
  here := at
  found := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is backtick then
        found := here
        here := nothing
      if here then
        here := here . next
  found

// The last place from `at` before `limit`.
last place from {at} to {limit} =>
  here := at
  found := at
  while here do
    if same here limit then
      here := nothing
    if here then
      found := here
      here := here . next
  found

// Whether the places from `at` to `limit` spell the word written from `word . from` to `word . to`.
spells {word} from {at} to {limit} =>
  x := word . from
  x_end := word . to
  y := at
  result := yes
  going := yes
  while going do
    x_done := same x x_end
    y_done := same y limit
    if x_done then
      going := nothing
      unless y_done then
        result := nothing
    if going then
      if y_done then
        going := nothing
        result := nothing
    if going then
      c := x . character
      d := y . character
      unless character c is d then
        result := nothing
        going := nothing
      if going then
        x := x . next
        y := y . next
  result

// Where the word from `at` ends: at a space, or at `limit`.
word end from {at} to {limit} =>
  here := at
  found := limit
  while here do
    if same here limit then
      here := nothing
    if here then
      c := here . character
      if character c is space then
        found := here
        here := nothing
      if here then
        here := here . next
  found

// A capture's name written with its type (`{d: Digit}`): the name ends before the colon. Answers a node with `name_end`, or nothing.
colon := characters of :
colon := colon . character
dot := characters of .
dot := dot . character
comma := characters of ,
comma := comma . character
marks := characters of `\n?
backtick := marks . character
marks := marks . next
backslash := marks . character
marks := marks . next
letter_n := marks . character
marks := marks . next
question := marks . character
raw_word := external span literal
typed name from {at} to {limit} =>
  here := at
  before := nothing
  while here do
    if same here limit then
      here := nothing
    if here then
      before := here
      here := here . next
  found := nothing
  if before then
    c := before . character
    if character c is colon then
      found := node
      set found . name_end to before
  found

// A rule kept where it reads rules: on its scope's `rules`, latest first; the registry's `latest`.
keep rule {made} =>
  scope := made . scope
  link := node
  set link . rule to made
  earlier := scope . rules
  set link . next to earlier
  set scope . rules to link
  set registry . latest to made
  made

// The seed's rules, taken over once: the top scope's, latest first; the earliest is the first statement's.
take the seed's rules =>
  here := external .
  top := here . parent
  imported := external rules top
  set top . rules to imported
  set registry . top to top
  last := imported
  while last do
    first_statement := last . rule
    last := last . next
  set registry . definer to first_statement
  set registry . latest to imported . rule

// A type: a scope of the rules its block defines (R2.3).
type {block} =>
  made := node
  external apply block nothing made
  made

// Rules defined from here on are read by their heads in Ray.
{pattern} => {body} =>
  where := external span pattern
  head_from := where . from
  head_to := where . to
  pieces := pieces of head_from to head_to like pattern
  made := external define pattern pieces body
  keep rule made

take the seed's rules
hand planning over

// One statement read at the top: applied in place, or reported. Answers the place after it.
read statement at {given} =>
  here := external .
  scope := here . parent
  at := blank from given to nothing
  limit := nothing
  if at then
    limit := statement end from at to nothing below nothing
  if at then
    made := step from at to limit in scope
    rule := made . rule
    if rule then
      caps := made . captures
      external apply rule caps scope
    unless rule then
      external report at limit
  after := nothing
  if limit then
    after := limit . next
  after

hand reading over
// The rules a value is read by (R2.1): its own and its classes' (not the top scope's), then what every value has.
rules of {value} =>
  top := registry . top
  rules := rules in reach of value below top
  base := registry . base
  base_rules := base . rules
  if rules then
    last := rules
    while last do
      following := last . next
      unless following then
        set last . next to base_rules
      last := following
  unless rules then
    rules := base_rules
  rules

// ---------------------------------------------------------------- values with rules of their own (R2.1: a rule is a method)
// What a statement's first operand is read as, when no rule in reach reads it whole: the rest is read by that value's rules,
// applied with `this` bound to it.
sent {this} {rest} =>
  where := external span rest
  at := where . from
  rest_to := where . to
  within := where . frame
  sender := registry . sender
  sender_pieces := sender . pieces
  this_piece := sender_pieces . next
  // the first receiver is a place (its code, unread): what it holds is read for its rules only when it holds something
  current := this
  value := nothing
  receiver_at := external span this
  frame := receiver_at . frame
  held := nothing
  while frame do
    held := external get frame this
    if held then
      frame := nothing
    if frame then
      frame := frame . parent
  if held then
    value := held
  unless held then
    // not a name a frame holds: a group, quoted text, or a name nothing holds yet (a place)
    first_place := receiver_at . from
    c := first_place . character
    if closer of c then
      value := this
    if character c is quote then
      value := this
  result := current
  going := yes
  while going do
    rules := rules of value
    r := prefix reading from at to rest_to among rules
    unless r then
      spaced := spaces after at
      if spaced then
        at := spaced
        r := prefix reading from at to rest_to among rules
    unless r then
      external report at rest_to
      going := nothing
    if r then
      rule := r . rule
      caps := r . captures
      bound := node
      set bound . piece to this_piece
      set bound . value to current
      set bound . next to caps
      result := external apply rule bound within
      at := r . end
      if same at rest_to then
        going := nothing
      current := result
      value := result
  result

sent_rule := registry . latest
set registry . sender to sent_rule

// ---------------------------------------------------------------- types with a check: characters, repetition (R2.2)
latest rule =>
  registry . latest
checked by {check} =>
  made := node
  set made . check to check
  made

// One character, any.
one character {kind} {from} {to} =>
  following := from . next
  same following to
Char := checked by latest rule

// One character, not `excluded`.
one character except {kind} {from} {to} =>
  following := from . next
  found := nothing
  if same following to then
    c := from . character
    excluded := kind . excluded
    unless character c is excluded then
      found := yes
  found
except_rule := latest rule
everything but {c} =>
  made := checked by except_rule
  set made . excluded to c
  made

// One or more of `item`, one after another.
one or more {kind} {from} {to} =>
  item := kind . item
  e := from . next
  found := nothing
  going := yes
  while going do
    if item holds from from to e then
      if same e to then
        found := yes
      unless found then
        unless same e to then
          found := one or more kind e to
    if found then
      going := nothing
    if same e to then
      going := nothing
    if going then
      e := e . next
  found
many_rule := latest rule
{item} repeated =>
  made := checked by many_rule
  set made . item to item
  made

// ---------------------------------------------------------------- text written in quotes
Unquoted := everything but quote
Quoted := Unquoted repeated
"{text: Quoted}" =>
  external span text

// ---------------------------------------------------------------- brackets: what they hold is balanced
// Balanced text: every bracket it opens it closes, in order, and it closes none it did not open; quoted text is skipped.
balanced {kind} {from} {to} =>
  open_ones := nothing
  here := from
  ok := yes
  while here do
    if same here to then
      here := nothing
    if here then
      c := here . character
      shut := closer of c
      if shut then
        pushed := node
        set pushed . shut to shut
        set pushed . next to open_ones
        open_ones := pushed
      unless shut then
        if closes c then
          unless open_ones then
            ok := nothing
            here := nothing
          if open_ones then
            expected := open_ones . shut
            unless character c is expected then
              ok := nothing
              here := nothing
            if here then
              open_ones := open_ones . next
        if character c is quote then
          here := here . next
          skipping := here
          while skipping do
            if same skipping to then
              ok := nothing
              skipping := nothing
              here := nothing
            if skipping then
              d := skipping . character
              if character d is quote then
                here := skipping
                skipping := nothing
              if skipping then
                skipping := skipping . next
      if here then
        here := here . next
  if open_ones then
    ok := nothing
  ok
Balanced := checked by latest rule

// A group: what is in brackets is read as itself.
({inside: Balanced}) =>
  inside

// ---------------------------------------------------------------- what every value has (the base)
Node := type
  .{literal property} =>
    external get this property
  .{literal property} = {value} =>
    external set this property value
  // `,` composes one value, a list (no split, 2026-09-27): `a, b, c` is the list of `a`, `b` and `c`, each as written (a
  // place or a value, read when it is used).
  ,{other} =>
    list := nothing
    known := external span this
    unless known then
      list := this
      unless list . listing then
        list := nothing
    unless list then
      list := node
      set list . listing to yes
      first := node
      first_item := external ** this
      set first . item to first_item
      set list . first to first
      set list . last to first
    added := node
    other_item := external ** other
    set added . item to other_item
    last := list . last
    set last . next to added
    set list . last to added
    list
set registry . base to Node

// ---------------------------------------------------------------- classes
// A class is the frame its block is read in (its statics and its methods are that frame's); calling it makes an instance: a
// frame of its own, made by a rule written in the class (so the class is around it), with the block read again in it.
class {block} =>
  static := external .
  external apply block nothing static
  instance frame =>
    external .
  ({args?}) =>
    instance := instance frame
    external apply block nothing instance
    if args then
      external apply args nothing instance
    instance
  static

// ---------------------------------------------------------------- methods: `name (a, b) => body`
// A method is a rule whose head is its name and its parameters, each a capture: `foo (a, b) => …` is `foo({a}, {b})`, so a call
// binds each argument to its parameter by reading, as any rule's captures are.
parentheses := external span ()
comma_written := external span ,
{name} ({parameters?}) {`=>`} {body} =>
  name_at := external span name
  pieces := node
  name_from := name_at . from
  name_to := name_at . to
  add literal piece from name_from to name_to into pieces
  // the brackets as written here
  open_at := parentheses . from
  close_at := open_at . next
  close_end := close_at . next
  add literal piece from open_at to close_at into pieces
  parameters_at := external span parameters
  if parameters_at then
    at := parameters_at . from
    stop := parameters_at . to
    start := at
    while at do
      ending := same at stop
      unless ending then
        c := at . character
        if character c is comma then
          ending := yes
      if ending then
        add capture piece from start to at into pieces
        if same at stop then
          at := nothing
        if at then
          comma_from := comma_written . from
          comma_to := comma_written . to
          add literal piece from comma_from to comma_to into pieces
          at := at . next
          spaced := spaces after at
          if spaced then
            add gap piece from at to spaced into pieces
            at := spaced
          start := at
      unless ending then
        at := at . next
  add literal piece from close_at to close_end into pieces
  chain := pieces . first
  made := external define name chain body
  keep rule made
