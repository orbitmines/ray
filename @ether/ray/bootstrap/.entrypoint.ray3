// An enumeration: `enum A | B | C`, a node its names are read in: each a member, a place there (a name a node being made is
// given, it has), and `members` what they compose.
enum {names} ^keyword => {
  external .
  // (a member written with fields, `circle (radius: Number)`: one holding them)
  // (given nothing, each field its type, `Shape.circle.radius === Number`)
  // (and once it is there, a member and brackets: one made of it, `Shape.circle(radius: 5)`)
  {member: Name} ({fields}) => ((.{member}) === None) ? (
    {member} := ({
