Language.TUI := class: Language {
  static extensions = ".tui"
  Cell := class = glyph: Char = " ", foreground: Geometry.Color?, background: Geometry.Color?, bold: boolean = false, italic: boolean = false, underline: boolean = false, strike: boolean = false, dim: boolean = false, reverse: boolean = false, link: Location?
  Grid := class = width: Number, height: Number, cells: Cell[][] = (0..<height).map((0..<width).map(Cell())), graphics: Graphic[] = [] {
    inside (at: Geometry.Vector) => 0 <= at.x < width && 0 <= at.y < height
    put (at: Geometry.Vector, cell: Cell) => cells[at.y][at.x] = cell if inside(at)
    cell (at: Geometry.Vector) => inside(at) ? cells[at.y][at.x] : Cell()
    background (at: Geometry.Vector, color: Geometry.Color?) => put(at, cell(at) ~~ .background = color)
    underlined (at: Geometry.Vector) => put(at, cell(at) ~~ .underline = true)
    linked (at: Geometry.Vector, to: Location) => put(at, cell(at) ~~ .link = to)
    faded (at: Geometry.Vector, amount: Probability) => cell(at) -- (cell => put(at, cell ~~ .foreground = cell.foreground?.mix(cell.background, 1 - amount)))
    shaded (at: Geometry.Vector) => cell(at) -- (cell => put(at, cell ~~ .background = (cell.background ?? Geometry.Color(0, 0, 0)).mix(Geometry.Color(0, 0, 0), 0.5)))
    graphic (at: Geometry.Vector, bytes) => graphics.push Graphic(at, bytes)
    changes (previous: Grid?) => (0..<height).map(y => (0..<width){!previous || cells[y][.] != previous.cells[y][.]}.map(x => (Geometry.Vector(x, y), cells[y][x]))).flatten
  }
  static px_per_cell = Geometry.Vector(8px, 16px)
  static cells (length: Geometry.Vector) => Geometry.Vector(length.x / px_per_cell.x, length.y / px_per_cell.y)

  Graphic := class = at: Geometry.Vector, bytes: *

  Painting := class = grid: Grid, writes: *[]
  Paint := class = shape: Geometry.Shape, scrolled: Geometry.Length = 0px {
    at => cells(shape.origin - Geometry.Vector(0, scrolled))
    size => cells(shape.size)
    area => (at.y..<at.y + size.y).map(y => (at.x..<at.x + size.x).map(x => Geometry.Vector(x, y))).flatten{
      shape.contains(shape.transform.inverse.applied(Geometry.Vector((.x - at.x) * px_per_cell.x, (.y - at.y) * px_per_cell.y)))
    }
    inside (child: Geometry.Shape) => Paint(child, scrolled)
  }
  Boxed := class = paint: Paint
  Filled := class = paint: Paint
  Border := class = paint: Paint
  Shade := class = paint: Paint, effect: Geometry.Effect
  Scrollbar := class = paint: Paint
  Shown := class = paint: Paint

  rules := {
    {solved: Geometry.Solved} => Painting(Grid(UI.scene.size.x / px_per_cell.x, UI.scene.size.y / px_per_cell.y), [solved.shape, solved.shape.lifted].flatten.map(Paint(., solved.scrolled)))
    {painting: Painting{writes.flatten.every(. is Program)}} => painting.grid ~~ painting.writes.flatten

    {paint: Paint{shape.content is Choice}} => [Boxed(paint), paint.inside(paint.shape.face)]
    {paint: Paint} => Boxed(paint)

    {boxed: Boxed} => boxed.paint -- (paint => [
      Filled(paint),
      Border(paint) if paint.shape.stroke,
      paint.shape.effects.map(Shade(paint, .)),
      Shown(paint) if paint.shape.content,
      paint.shape.in_place.sort_by(.layer).map(paint.inside(.)) if paint.shape.visible,
      Scrollbar(paint) if paint.shape.overflow == scroll,
      paint.area.map(at => { .underlined(at) }) if paint.shape.focused,
      paint.area.map(at => { .linked(at, paint.shape.location) }) if paint.shape.location
    ])
    {shown: Shown{paint.shape.content is String}} => {
      paint = shown.paint
      text = paint.shape
      lines = text.lines(text.size.x)
      starts = text.starts(text.size.x)
      (0..<lines.count).map(row => (0..<lines[row].length).reduce(placed = (column: 0, writes: []) => {
        look = UI.Theme.face(text, starts[row] + .)
        at = paint.at + Geometry.Vector(placed.column, row)
        written = Cell(lines[row][.],
          foreground: look.color as Geometry.Color, background: look.fill as Geometry.Color,
          bold: look.font.weight >= 600, italic: look.font.style == italic, reverse: look.styles.contains("selected"))
        (column: placed.column + lines[row][.].columns, writes: [placed.writes, { .put(at, written) }].flatten)
      }).writes).flatten
    }
    {shown: Shown{paint.shape.content is Location && paint.shape.content.language === Language.Image && paint.shape.fill}} => shown.paint -- (paint => paint.area.map(at => { .put(at, tinted(paint.shape.content, at - paint.at, paint.size, paint.shape.fill as Geometry.Color)) }))
    {shown: Shown{paint.shape.content is Location && paint.shape.content.language === Language.Image}} => shown.paint -- (paint => paint.area.map(at => { .put(at, sampled(paint.shape.content, at - paint.at, paint.size)) }))
    {shown: Shown{paint.shape.content is Location && paint.shape.content.video_site}} => shown.paint -- (paint => paint.inside(Geometry.Box(location: Location(written: paint.shape.content.written, window: new), origin: paint.shape.origin, size: paint.shape.size, stroke: Geometry.Stroke(Geometry.Color(128, 128, 128)), children: [
      Geometry.Box(content: "▶ " + (paint.shape.content.alt ?? paint.shape.content as String), origin: paint.shape.origin + px_per_cell, size: paint.shape.size - px_per_cell * 2)
    ])))
    {shown: Shown{paint.shape.content is Program}} => shown.paint -- (paint => paint.shape.content.rendered(Language.Direct.level).rows -- (rows => paint.area.map(at => (at - paint.at) -- (dot =>
      Cell(braille(rows[dot.y * 4..<dot.y * 4 + 4].map(.[dot.x * 2..<dot.x * 2 + 2].map(.alpha > 0)))) -- (written => { .put(at, written) })
    ))))
    {shown: Shown} => []
    {filled: Filled{paint.shape.content is Location}} => []
    {filled: Filled{paint.shape.fill is Geometry.Color}} => filled.paint.area.map(at => { .background(at, filled.paint.shape.fill) })
    {filled: Filled{paint.shape.fill is Geometry.Gradient}} => filled.paint.area.map(at => { .background(at, filled.paint.shape.fill.at(at.x / UI.scene.size.x * px_per_cell.x)) })
    {filled: Filled} => []
    {shade: Shade{effect is Geometry.Opacity}} => shade.paint.area.map(at => { .faded(at, shade.effect.amount) })
    {shade: Shade{effect is Geometry.Shadow}} => shade.paint.area.map(at => { .shaded(at + cells(shade.effect.offset)) })
    {shade: Shade} => []
    {border: Border} => {
      paint = border.paint
      corners = paint.shape.radius != [0] ? "╭╮╰╯" : "┌┐└┘"
      from = paint.at
      to = from + paint.size - Geometry.Vector(1, 1)
      ink = paint.shape.stroke.paint as Geometry.Color
      sides = paint.shape.stroke.sides
      [
        (from.x..to.x).map(x => { .underlined(Geometry.Vector(x, to.y)) }) if sides == bottom,
        (from.x + 1..<to.x).map(x => { .put(Geometry.Vector(x, from.y), Cell("─", foreground: ink)) }) if sides is (all | top | horizontal),
        (from.x + 1..<to.x).map(x => { .put(Geometry.Vector(x, to.y), Cell("─", foreground: ink)) }) if sides is (all | horizontal),
        (from.y + 1..<to.y).map(y => { .put(Geometry.Vector(from.x, y), Cell("│", foreground: ink)) }) if sides is (all | left | vertical),
        (from.y + 1..<to.y).map(y => { .put(Geometry.Vector(to.x, y), Cell("│", foreground: ink)) }) if sides is (all | right | vertical),
        [(from, 0), (Geometry.Vector(to.x, from.y), 1), (Geometry.Vector(from.x, to.y), 2), (to, 3)].map((at, i) => { .put(at, Cell(corners[i], foreground: ink)) }) if sides == all
      ]
    }
    {scrollbar: Scrollbar} => scrollbar.paint -- (paint => (0..<paint.size.y).map(y =>
      { .put(paint.at + Geometry.Vector(paint.size.x - 1, y), Cell(y == paint.shape.scrolled.y * paint.size.y / paint.shape.content_height ? "┃" : "│")) }
    ))
  }
  Cells := Geometry.Solving + rules
  level := Cells

  static braille (dots: boolean[][]) => (0x2800 + [[0, 3], [1, 4], [2, 5], [6, 7]].zip(dots).map((bits, row) => row.zip(bits).map((on, bit) => on ? 2 ^ bit : 0).sum).sum) as Char
  static ramp = " .:-=+*#%@"
  static pixel (image: Location, at: Geometry.Vector, of: Geometry.Vector) => image.pixels -- (pixels => pixels.at(at.x * pixels.width / of.x, at.y * pixels.height / of.y))
  static sampled (image: Location, at: Geometry.Vector, of: Geometry.Vector) => pixel(image, at, of) -- Cell(ramp[.luminance * (ramp.length - 1) / 255], foreground: .)
  static tinted (image: Location, at: Geometry.Vector, of: Geometry.Vector, ink: Geometry.Color?) => pixel(image, at, of) -- Cell(ramp[.alpha * (ramp.length - 1)], foreground: ink)

  ANSI := class {
    Frame := class = changes: (at: Geometry.Vector, cell: Cell)[], title: String?, graphics: Graphic[] = []
    Title := class = text: String
    Move := class = at: Geometry.Vector
    Style := class = cell: Cell
    Color := class = color: Geometry.Color, layer: Number
    Hyperlink := class = cell: Cell
    Start := class
    Stop := class
    Copy := class = text: String
    written := {
      {start: ANSI.Start} => Terminal.entering, Terminal.clearing
      {stop: ANSI.Stop} => Terminal.restoring
      {copy: ANSI.Copy} => "\e]52;c;", Base64.encoded(copy.text.bytes), "\a"
      {frame: ANSI.Frame} => [
        Title(frame.title) if frame.title,
        frame.changes.map((at, cell) => [Move(at), Style(cell), Hyperlink(cell), cell.glyph]),
        frame.graphics.map([Move(.at), .bytes]),
        "\e[0m"
      ]
      {title: ANSI.Title} => "\e]0;", title.text, "\a"
      {move: ANSI.Move} => "\e[", move.at.y + 1, ";", move.at.x + 1, "H"
      {style: ANSI.Style} => style.cell -- (cell => "\e[0", (";1" if cell.bold), (";2" if cell.dim), (";3" if cell.italic), (";4" if cell.underline), (";9" if cell.strike), (";7" if cell.reverse),
        (";", Color(cell.foreground, 38)) if cell.foreground, (";", Color(cell.background, 48)) if cell.background, "m")
      {color: ANSI.Color} => color.layer, ";2;", color.color.red, ";", color.color.green, ";", color.color.blue
      {link: ANSI.Hyperlink{cell.link}} => "\e]8;;", link.cell.link as String, "\e\\"
      {link: ANSI.Hyperlink} => "\e]8;;\e\\"
    }
  }

  Target := class = written: Compiler = ANSI.written, previous: Grid?, title: String? {
    start => Terminal.emit(Compiler.reduced(ANSI.Start(), written) as String)
    stop => Terminal.emit(Compiler.reduced(ANSI.Stop(), written) as String)
    framed (grid: Grid) => ANSI.Frame(grid.changes(previous), UI.page?.title if UI.page?.title != title, grid.graphics{!(previous?.graphics.contains(.) ?? false)})
    write (grid: Grid) => Terminal.emit(Compiler.reduced(framed(grid), written) as String) -- (previous = grid) -- (title = UI.page?.title)
    read => Language.TUI.read
    copy (text: String) => Terminal.emit(Compiler.reduced(ANSI.Copy(text), written) as String)
    open (to: Location) => OS.launch(to)
  }

  XTerm256 := {
    {color: ANSI.Color} => color.layer, ";5;", 16 + 36 * (color.color.red * 5 / 255) + 6 * (color.color.green * 5 / 255) + color.color.blue * 5 / 255
  }
  TrueColor := { }
  WindowsTerminal := {
    {start: ANSI.Start} => Terminal.entering, "\e[?9001h", Terminal.clearing
  }
  Kitty := {
    {shown: Shown{paint.shape.content is Location && paint.shape.content.language === Language.Image}} => { .graphic(shown.paint.at, ("\e_Ga=T,f=100;", Base64.encoded(IO.File(shown.paint.shape.content as String).bytes), "\e\\")) }
  }
  Sixel := {
    {shown: Shown{paint.shape.content is Location && paint.shape.content.language === Language.Image}} => { .graphic(shown.paint.at, ("\eP0;0;0q", sixel(shown.paint.shape.content.pixels), "\e\\")) }
  }
  static sixel (raster: Geometry.Raster) => raster.pixels.unique.enumerate -- (palette => (
    palette.map("#", .index, ";2;", .value.red * 100 / 255, ";", .value.green * 100 / 255, ";", .value.blue * 100 / 255),
    (0..<(raster.height + 5) / 6).map(band => palette.map(
      "#", .index, (0..<raster.width).map(x => ((0..<6).map(row => raster.at(x, band * 6 + row) == .value ? 2 ^ row : 0).sum + 63) as Char), "$"
    ), "-")
  ))
  Browser := {
    {grid: Grid} => Language.Web.Package([(path: "index.html", content: Language.Web.HTML.Document(head: [], body: @html <body><pre>{grid.cells.map(.map(.glyph) as String).join(\n)}</pre></body>))])
  }

  static read => (Terminal.read ?? "") ~= (events: Event[]) -- .events.for(Compiler.reduced(., applied))
  Event := Key | Mouse | Paste | FocusChange | Resize
  Key := class ("\e[", (modifiers: "1;", modifier: Decimal)?, code: "A" | "B" | "C" | "D" | "H" | "F" | "Z") | ("\eO", code: "P" | "Q" | "R" | "S") | ("\e[", page: "5" | "6", "~") | ("\e", alt: Char) | (code: Char) => {
    lettered => code && (code as Number) < 27 && !(code is ("\r" | "\t"))
    name => Compiler.reduced(this, named)
    shift => modifier && (modifier - 1) % 2 == 1
    control => modifier && (modifier - 1) / 4 % 2 == 1 || lettered
  }
  Mouse := class ("\e[<", button: Decimal, ";", x: Decimal, ";", y: Decimal, state: "M" | "m") => {
    position => Geometry.Vector((x - 1) * px_per_cell.x, (y - 1) * px_per_cell.y)
  }
  Paste := class ("\e[200~", text: *, "\e[201~")
  FocusChange := class ("\e[", state: "I" | "O")
  Resize := class
  Pressed := class = key: Key

  named := {
    {key: Key{page == "5"}} => Keyboard.named("PageUp")
    {key: Key{page == "6"}} => Keyboard.named("PageDown")
    {key: Key{alt}} => Keyboard.named(key.alt as String)
    {key: Key{lettered}} => Keyboard.named(((key.code as Number) + 96) as Char as String)
    {key: Key{code is ("A" | "w")}} => Keyboard.Direction.up
    {key: Key{code is ("B" | "s")}} => Keyboard.Direction.down
    {key: Key{code is ("C" | "d")}} => Keyboard.Direction.right
    {key: Key{code is ("D" | "a")}} => Keyboard.Direction.left
    {key: Key{code == "Q"}} => Keyboard.f2
    {key: Key{code == "\r"}} => Keyboard.enter
    {key: Key{code is ("\t" | "Z")}} => Keyboard.tab
    {key: Key} => Keyboard.key(key.code)
  }

  applied := {
    {key: Key} => Keyboard.press(key.name, key.shift, key.control, key.alt != None) -- Pressed(key)
    {pressed: Pressed{key.page}} => UI.scene.scroll((pressed.key.page == "5" ? -1 : 1) * UI.scene.size.y)
    {pressed: Pressed{key.name is Keyboard.Direction && key.control}} => UI.skip(pressed.key.name)
    {pressed: Pressed{key.name is Keyboard.Direction && key.shift}} => UI.expand(pressed.key.name)
    {pressed: Pressed{key.name is Keyboard.Direction}} => UI.move(pressed.key.name)
    {pressed: Pressed{key.name == Keyboard.tab && key.shift}} => UI.tab(previous)
    {pressed: Pressed{key.name == Keyboard.tab}} => UI.tab(next)
    {pressed: Pressed{key.name == Keyboard.enter}} => (UI.focus.first ?? UI.current)?.activate
    {pressed: Pressed{key.code == "q"}} => UI.running = false
    {pressed: Pressed} => None
    {mouse: Mouse{button >= 64}} => (UI.pointed().wheel = Geometry.Vector(y: mouse.button == 64 ? -1 : 1)) -- UI.scene.scroll(UI.pointed().wheel.y * 3 * px_per_cell.y)
    {mouse: Mouse{state == "m"}} => UI.pointed().to(mouse.position, pressing: [])
    {mouse: Mouse{button >= 32}} => UI.pointed().to(mouse.position)
    {mouse: Mouse} => UI.pointed().to(mouse.position, pressing: [mouse.button])
    {paste: Paste} => (@me/device/clipboard = paste.text) -- UI.focus.content.typed(paste.text)
    {focus: FocusChange} => @me/device/preferences.focused = focus.state == "I"
    {resize: Resize} => UI.scene.size = Geometry.Vector(Terminal.size.x * px_per_cell.x, Terminal.size.y * px_per_cell.y)
  }
}

Terminal := class {
  static entering = "\e[?1049h\e[?25l\e[?1000h\e[?1002h\e[?1006h\e[?2004h\e[?1004h"
  static clearing = "\e[2J\e[H"
  static restoring = "\e[?1004l\e[?2004l\e[?1006l\e[?1002l\e[?1000l\e[?25h\e[?1049l"
  emit (bytes) => external io `stdout` (bytes)
  read => external io `stdin` None
  size => Geometry.Vector((external os `COLUMNS`) as Decimal, (external os `LINES`) as Decimal)
  raw_mode => emit(entering)
  clear => emit(clearing)
  restore => emit(restoring)
}

Language.register(Language.TUI)
