UI := class {
  scene: Geometry.Shape = Geometry.Box(size: Geometry.Vector(1240px, 800px), overflow: scroll)
  page: *?
  program: Program?

  Interface := class: Location level: Program

  // Pointer Events (https://www.w3.org/TR/pointerevents3/), UI Events (https://www.w3.org/TR/uievents/), as a window reports them
  Input := class {
    Id = Char{!= " "}[]
    Pointer := class (id: Id, " ", kind: "pointerdown" | "pointermove" | "pointerup" | "pointercancel", " ", x: Decimal, " ", y: Decimal, (" ", stamp: Decimal)?, (" ", device: "mouse" | "pen" | "touch", " ", number: Decimal)?) => {
      contact => @me/device/pointer[device ?? "mouse", number ?? 0]
      position => Geometry.Space.screen.seen(Geometry.Vector(x * 1px, y * 1px), UI.scene.size)
      time => stamp ? stamp * 1 ms : Time.now
    }
    Keystroke := class (id: Id, " ", kind: "keydown" | "keyup", " ", key: Id, modifiers: (" ", held: "shift" | "control" | "alt" | "meta")[])
    Inbound := Pointer | Keystroke
    applied := {
      {pointer: Pointer{kind == "pointerdown"}} => pointer.contact.to(pointer.position, pressing: [0], time: pointer.time)
      {pointer: Pointer{kind == "pointermove"}} => pointer.contact.to(pointer.position, time: pointer.time)
      {pointer: Pointer} => pointer.contact.to(pointer.position, pressing: [], time: pointer.time)
      {keystroke: Keystroke{kind == "keydown"}} => keystroke.modifiers.held -- @me/device/keyboard[keystroke.key].press((Keyboard.Modifier.shift if .contains("shift")) | (Keyboard.Modifier.control if .contains("control")) | (Keyboard.Modifier.alt if .contains("alt")) | (Keyboard.Modifier.meta if .contains("meta")))
      {keystroke: Keystroke} => @me/device/keyboard[keystroke.key].release
    }
    static dispatched (line: String?) => line.trimmed ~= (event: Inbound) -- Compiler.reduced(.event, applied) if .
  }

  Scene := {
    // `f <- x` (F-B2): `x` given to what is written before, `middle center .map(g) <- { … }` is `middle center ({ … }.map(g))`
    {flow_into} <- {flowing} => flow_into(flowing)
    {superposed: |} => Compiler.reduced(@me.choose(superposed), Scene)
    {text: String} => Geometry.Box(content: text)
    {styled: String | Geometry.Shape | Choice}{ }{`^`}{{literal expression}} => Compiler.reduced(styled, Scene).styled_by(Program(code: expression**))
    // (the whole text marked: its shape styled; a character holds no styles yet (`.value ~~ .styles ,= style` is not read))
    {styled: String}{ }{`^`}{literal style} => Compiler.reduced(styled, Scene).styled(style)
    {styled: Geometry.Shape | Choice}{ }{`^`}{literal style} => Compiler.reduced(styled, Scene).styled(style)
    {{literal narrowing}} {narrowed: String | Geometry.Shape | Choice} => Compiler.reduced(narrowed, Scene).narrowed(Program(code: narrowing**))
    {location: Location} => Geometry.Box(content: location, aspect: location.video_site ? 16 / 9 : None, children: location.media || location.video_site ? [] : [Geometry.Box(content: location.@ as String)])
      -- (shown => location.narrowing ? shown.narrowed(location.narrowing) : shown)
    {placed: *{location#.some(.scheme)}} => Geometry.Box(content: placed.location#{.scheme}.first, children: [Compiler.reduced(placed.copy ~~ (.location = None), Scene)])
    {shape: Geometry.Shape} => shape
    {chosen: Choice} => Geometry.Box(content: chosen)
    {lines: \n} => Geometry.Box(flow: block, children: lines.components)
    {inline: ,} => Geometry.Box(flow: inline, children: inline.components)
    // (what a path shows, an entry point (`{*}: Index`) run: its answer)
    {site: *{fields.some(.name == "{*}")}} => Compiler.reduced(Program(code: UI.Site(index: site).rendering){O: Scene}(), Scene)
    {value: *} => value.rendering ?? Geometry.Box(flow: grid, columns: 2, children: value.fields.map(.name, .value).flatten)
  }

  Lowered := {
    {field: Geometry.Shape{content is Choice}} => field.face -- (face => field ~~ (.content = None) ~~ (.children = [face]))
    {frame: Geometry.Shape{content is Location && content.video_site && children.empty}} => frame ~~ (.content = frame.content ~~ .window = new) ~~ (.fill = Geometry.Color(17, 20, 24)) ~~ (.stroke = Geometry.Stroke(Geometry.Color(128, 128, 128))) ~~ (.children = [
      Geometry.Box(content: "▶ " + (frame.content.alt ?? frame.content.@ as String), origin: frame.size * (1 / 4), size: frame.size * (1 / 2), align: center, color: Geometry.Color(246, 247, 249))
    ])
    {image: Geometry.Shape{content is Location && content.language === Language.Image}} => image.content.pixels -- (pixels => image ~~ (.content = None) ~~ (.fill = image.fill
      ? (point => (image.painted(image.fill) as Geometry.Color) ~~ .alpha *= pixels.sampled(Geometry.Vector(point.x / image.size.x, point.y / image.size.y)).alpha)
      : (point => pixels.sampled(Geometry.Vector(point.x / image.size.x, point.y / image.size.y)))))
  }

  Choice &+= {
    disabled => !&@.may(`=`, this)
    placeholder => [tried, tried.previous**].flatten.last
    options => goal#
    listed => !(goal is (boolean | String | Number | Time | Geometry.Color | Location | Language))
    empty => tried === None || tried === placeholder && !done || (tried as String).empty
    typed (text: String) => attempt((tried, text)) -- this
    composed (text: String) => (tried as String ?? "") -- (now => attempt((now{!.styles.contains("composing")}, text.marked("composing")))) -- this
    erased => attempt(tried[..<-1]) -- this
    activate => goal is boolean ? attempt(!tried) : listed ? attempt(options[(options.index_of(tried) + 1) % options.count]) : None
    shown => Compiler.reduced(this, Showing)
    static Showing := {
      {chosen: Choice{goal is boolean}} => chosen.tried ? "[x]" : "[ ]"
      {chosen: Choice{goal is Number{least, most}}} => (chosen.tried - chosen.goal.least) / (chosen.goal.most - chosen.goal.least) -- "─" * (. * 10), "●", "─" * (10 - . * 10)
      {chosen: Choice{goal is String{secret}}} => "•" * (chosen.tried as String).length
      {chosen: Choice{listed}} => "‹ ", chosen.tried as String, " ›"
      {chosen: Choice{empty}} => (chosen.placeholder as String) ?? ""
      {chosen: Choice{goal is Language}} => (chosen.tried as String).highlighted(chosen.goal)
      {chosen: Choice} => chosen.tried as String
    }
  }

  focus: Geometry.Shape{focused}[]{length <= 1} => scene{focused}
  tab (step: next | previous = next) => focus = scene{focusable}.loop{focused}.`step` ?? scene{focusable}.first
  typing => focus.some(.content is Choice)

  selection: Geometry.Shape{selected}[] => scene{selected}
  current => selection.last ?? scene
  step (from: Geometry.Shape, direction: Geometry.Side) => (if direction {
      Geometry.bottom => from.children.first
      Geometry.top => from.parent
      Geometry.right => from.parent.children{=== from}.next
      Geometry.left => from.parent.children{=== from}.previous
    }) ?? from
  move (direction: Geometry.Side) => selection = step(current, direction)
  skip (direction: Geometry.Side) => selection = step(step(current, Geometry.top), direction)
  expand (direction: Geometry.Side) => selection |= step(current, direction)

  pulsed (names: String[]) => names.some(@me/device/keyboard[.].pulsed)
  held (names: String[], modifier: Keyboard.Modifier) => names.some(@me/device/keyboard.pressed(., modifier))

  locked => scene{. is Drawer && open}.nonempty
  back => @me/device/location = @me/device/location.previous

  Location &+= {
    window: same | new = same
    alt: String?
    fit: contain | cover | fill | none = contain
    controls: boolean = true
    muted: boolean = false
    looping: boolean = false
    narrowing: Program?
    extension => (path ~= (*, ".", last: Char.Word[]) ⊣).last
    language => extension ? Language.named("." + extension) : None
    media => language === Language.Image || language === Language.Video || language === Language.Audio
    pixels => language.read(content)
    static VideoId := (!"&" && !"?" && !"#")[]
    static Rest := (("&" | "?" | "#"), *)?
    static Embedding := {
      @https://youtu.be/{id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
      @https://youtube.com/watch?v={id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
      @https://www.youtube.com/watch?v={id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
      @https://www.youtube.com/embed/{id: VideoId}{rest: Rest} => @https://www.youtube.com/embed/{id}
    }
    static Offset := class ((hours: Decimal, "h")?, (minutes: Decimal, "m")?, (seconds: Decimal, "s"?)?) => {
      total => (hours ?? 0) * 3600 + (minutes ?? 0) * 60 + (seconds ?? 0)
    }
    static Embedded := {
      {pair: (name: "t", value: *)} => (name: "start", value: (pair.value ~= (at: Offset)).at.total as String)
      {pair: (name: "v", value: *)} => None
      {pair} => pair
    }
    embedded => Compiler.reduced(this, Embedding) -- (embed => embed === this ? this
      : Location(embed.scheme, embed.host, embed.port, embed.path, query: Location.Query(pairs: query.pairs.map(Compiler.reduced(., Embedded)).compact), fragment: fragment))
    video_site => embedded !== this
    {this}{{literal narrowing}} ^punctuation => Program(code: narrowing**) -- (narrowing => (this ~~ .narrowing = narrowing)
      -- (copy => [narrowing{O: Geometry.Settings}()].flatten.for(write => write.entered(copy, None) if write.writes.every(copy.declaring(.))) -- copy))
  }
  Site := class index: *? {
    static (value) as (=== Site) => Site(index: value)
    // (F-A4) what a path shows: the fields located at it (several: a choice), else the field named `{*}` (every path no field
    // claims), else the index itself
    at (path: String) => index.fields{.value.location ~= path}.map(.value) -- (claimed => claimed.nonempty ? claimed.all
      : index.fields{.name == "{*}"}.first.value ?? index)
    rendering => at((@me/device/location ?? @/).path as String)
  }

  Popover := Geometry.Box{position is Geometry.Anchored, layer == 20, visible == (position.anchor.hovered | position.anchor.focused | hovered)}
  Overlay := Geometry.Box{closes: None, position == Geometry.Fixed(), spacing == [Geometry.Spacing(Geometry.Edges(), itself)], layer == 19, fill: Geometry.Color(0, 0, 0, 0.5)} + {
    activate => closes.open = false
  }
  Drawer := Geometry.Box{open: false, side: Geometry.left, extent: 75vw, layer == 20, overflow == scroll, visible == open, transition == Geometry.Transition(0.3 s),
    position == Geometry.Fixed(), spacing == [Geometry.Spacing(Geometry.Edges() ~~ .(side.opposite) = None, itself)],
    width == (extent if side is Geometry.horizontal), height == (extent if side is Geometry.vertical), children: [Overlay(closes: this){visible == closes.open}, children].flatten}

  Geometry.Shape &+= {
    focused: boolean = false
    selected: boolean = false
    dragged: boolean = false
    dropped: Location?
    cursor: (pointer | text | grab | grabbing | move | wait | none)?
    touch: (none | pan_x | pan_y)?
    scrollbar: boolean = true
    styles: String[] | Dynamic = []
    palette: *? = parent.palette
    case: Section? = parent.case
    truncate: (clip | ellipsis)? = parent.truncate
    direction: (left-to-right | right-to-left)? = parent.direction
    hovered => visible && @me/device/pointer.contacts.some(contains(.position - at))
    pressed => visible && @me/device/pointer.contacts.some(.pressed && contains(.position - at))
    activated => focused && @me/device/keyboard/Enter.pulsed || hovered && @me/device/pointer.contacts.some(.released)
    focusable => this is (UI.Linked | UI.Chosen | UI.Overlay)
    activate => None
    submitted => dynamically children{.content is Choice}.every(.content.solution) && @me/device/keyboard/Enter.pulsed
    text: String => content is String ? content : texts.content.join("")
    select (from: Number = 0, to: Number = text.length) => (selected = true) -- ((content = content.marked("selected", from, to)) if content is String) -- this
    scroll (by: Geometry.Length) => (scrolled = Geometry.Vector(scrolled.x, (scrolled.y + by) min (content_height - size.y) max 0px)) unless this === UI.scene && UI.locked
    reveal (shape: Geometry.Shape?, align: start | center | end = start, smooth: boolean = false, offset: Geometry.Length = 0px) => shape && ((at.y + size.y) - (shape.at.y + shape.size.y) + scrolled.y + offset - (if align {
        center => (size.y - shape.size.y) / 2
        end => size.y - shape.size.y
      } else {
        0px
      })) max 0px -- (to => ((transition = Geometry.Transition(300 ms, Geometry.ease_out)) if smooth && !@me/device/preferences.reduced_motion)
        -- (scrolled = Geometry.Vector(scrolled.x, to)))
    label => children{.content is String}.content.join(" ")
    styled (name: String) => (styles &= name) -- (narrowed(UI.Theme.member(name).narrowing) if UI.Theme.member(name)) -- (color = UI.Theme.painted(name, palette ?? UI.Theme.palette) ?? color) -- this
    styled_by (expression: Program) => styled(expression() as String) -- (styles = Dynamic(expression)) -- this
    themed => styles -- (own => (styles = []) -- Compiler.reduced(this, Theme.kinds) -- (styles.nonempty ? own.for(styled(.)) : (styles = own)))
      -- ((content.shared_styles{!styles.contains(.)}.for(styled(.))) if content is String) -- children.for(.themed) -- this
  }
  Located := Geometry.Shape{content is Location} + {
    label => content.alt ?? content.name
  }
  Linked := Located{!content.media && !content.video_site} + {
    activate => content.window == new ? (@me/device/opened = content) : (@me/device/location = content)
  }
  Chosen := Geometry.Shape{content is Choice} + {
    activate => content.activate
    text => content.empty ? "" : content.tried as String
    select (from: Number = 0, to: Number = text.length) => (selected = true) -- content.attempt(text.marked("selected", from, to)) -- this
    face => Geometry.Box(content: content.shown, origin: inside.start, size: size - inside.total, font: font, color: color, palette: palette,
      white_space: content.goal is (String{multiline} | Language) ? Geometry.WhiteSpace.pre_wrap : Geometry.WhiteSpace.nowrap) -- (shown => content.empty ? shown.styled("placeholder") : shown)
  }

  Theme := class {
    static spacing: Geometry.Length = 0.125rem
    static scaled (amount: Number | Geometry.Length) => amount is Number ? spacing * amount : amount
    static kinds := { }
    static palettes = DARK{dark: true}
    static palette => palettes{dark == @me/device/preferences.dark} ?? palettes
    static styles => fields{.value.narrowing}.name
    static painted (style: String, palette = Theme.palette) => palette.map((name, paint) => (name, paint as Geometry.Color)){style == .0 || style.starts_with(.0 + ".")}.last.1
    static face (shape: Geometry.Shape, character: Char?) => (character.styles ?? []).reduce((acc = Geometry.Box(font: shape.font, color: shape.color, fill: shape.fill, palette: shape.palette)) => acc.styled(.))
  }
}

UI.Theme.italic := Geometry.Shape{font.style == italic}
UI.Theme.bold := Geometry.Shape{font.weight == 700}
UI.Theme.muted := Geometry.Shape{color == Geometry.Color(128, 128, 128)}
UI.Theme.placeholder := Geometry.Shape{color == Geometry.Color(128, 128, 128)}
UI.Theme.disabled := Geometry.Shape{color == Geometry.Color(160, 160, 160)}
UI.Theme.selected := Geometry.Shape{fill == Geometry.Color(51, 144, 255, 0.4)}
UI.Theme.h1 := Geometry.Shape{font.size == 2em, font.weight == 700}
UI.Theme.h2 := Geometry.Shape{font.size == 1.5em, font.weight == 700}
UI.Theme.h3 := Geometry.Shape{font.size == 1.17em, font.weight == 700}
UI.Theme.code := Geometry.Shape{white_space == Geometry.WhiteSpace.pre}

currentColor := .color

Char &+= {
  styles: String[] = []
}
String &+= {
  marked (style: String, from: Number = 0, to: Number = length) => enumerate.map(((from <= .index) && (.index < to)) ? (.value ~~ .styles ,= style) : .value) as String
  shared_styles => first.styles{style => every(.styles.contains(style))} ?? []
  pieces => [this{.index == 0 || .styles != .previous.styles}.map(.index), [length]].flatten -- .zip(.rest).map((from, to) => this[from..<to])
  highlighted (language: Language | String) => (language is String ? Language.named(language.starts_with(".") ? language : "." + language) : language).painted(this).reduce(acc = marked("code") => acc.marked(.style, .from, .to))
}

// (each side's padding word, `p…`, from the border, and margin word, `m…`, from the shape itself: written out, as a loop over
// `[p: Geometry.all, …]` with a `` `word` `` head defined every word as the first one (open))
Node &+= {
  right-to-left p ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.all) = UI.Theme.scaled(this), border)
  right-to-left px ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.horizontal) = UI.Theme.scaled(this), border)
  right-to-left py ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.vertical) = UI.Theme.scaled(this), border)
  right-to-left pt ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.top) = UI.Theme.scaled(this), border)
  right-to-left pb ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.bottom) = UI.Theme.scaled(this), border)
  right-to-left pl ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.left) = UI.Theme.scaled(this), border)
  right-to-left pr ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.right) = UI.Theme.scaled(this), border)
  right-to-left m ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.all) = UI.Theme.scaled(this), itself)
  right-to-left mx ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.horizontal) = UI.Theme.scaled(this), itself)
  right-to-left my ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.vertical) = UI.Theme.scaled(this), itself)
  right-to-left mt ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.top) = UI.Theme.scaled(this), itself)
  right-to-left mb ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.bottom) = UI.Theme.scaled(this), itself)
  right-to-left ml ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.left) = UI.Theme.scaled(this), itself)
  right-to-left mr ^keyword => Geometry.Spacing(Geometry.Edges(None, None, None, None, None, None) ~~ .(Geometry.right) = UI.Theme.scaled(this), itself)
}

// (`pt 5 x`: `x` with that spacing (F-B8b), as `center x` is `x` aligned)
p {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [p spacing_amount], children: [spaced])
px {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [px spacing_amount], children: [spaced])
py {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [py spacing_amount], children: [spaced])
pt {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [pt spacing_amount], children: [spaced])
pb {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [pb spacing_amount], children: [spaced])
pl {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [pl spacing_amount], children: [spaced])
pr {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [pr spacing_amount], children: [spaced])
m {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [m spacing_amount], children: [spaced])
mx {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [mx spacing_amount], children: [spaced])
my {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [my spacing_amount], children: [spaced])
mt {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [mt spacing_amount], children: [spaced])
mb {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [mb spacing_amount], children: [spaced])
ml {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [ml spacing_amount], children: [spaced])
mr {spacing_amount: Number | Geometry.Length} {spaced} ^keyword => Geometry.Box(spacing: [mr spacing_amount], children: [spaced])

Unit(name: "viewport width", symbol: "vw")
  .convert(((x: Number) => x * (UI.scene.size.x as pixel).amount / 100), pixel)
Unit(name: "viewport height", symbol: "vh")
  .convert(((x: Number) => x * (UI.scene.size.y as pixel).amount / 100), pixel)

Program &+= {
  drawn (before: Geometry.Shape = UI.scene) =>
    UI.page = this()
    Geometry.Box(size: before.size, scrolled: before.scrolled, overflow: scroll, transition: before.transition, children: [this{O: UI.Scene}().themed])
  rendered (level) => Compiler.reduced(drawn(), level)
  run (on: UI.Interface) => (UI.program = this) ~~ on.start ~~ ((on.write(Compiler.reduced((UI.scene = drawn()), on.level)) -- on.read) while !done) ~~ on.stop
}

Node &+= {
  right-to-left changes ^keyword => this !== previous
  right-to-left becomes {target} ^keyword => this == target && previous != target
}
{action} when {condition} ^keyword => dynamically if (condition) { action }
{action} after {delay: Quantity.Temporal} ^keyword => (Time.now + delay) -- (due => { action } when Time.now >= due)

[(Geometry.top, ["ArrowUp", "w"]), (Geometry.bottom, ["ArrowDown", "s"]), (Geometry.right, ["ArrowRight", "d"]), (Geometry.left, ["ArrowLeft", "a"])].for (side, names) => {
  { UI.held(names, Keyboard.Modifier.control) ? UI.skip(side) : UI.held(names, Keyboard.Modifier.shift) ? UI.expand(side) : UI.move(side) } when UI.pulsed(names) && !UI.typing
}
{ UI.tab(UI.held(["Tab"], Keyboard.Modifier.shift) ? previous : next) } when UI.pulsed(["Tab"])
{ (UI.focus.first ?? UI.current).activate } when UI.pulsed(["Enter"])
{ UI.scene.scroll(-UI.scene.size.y) } when UI.pulsed(["PageUp"])
{ UI.scene.scroll(UI.scene.size.y) } when UI.pulsed(["PageDown"])
{ UI.scene.scroll(-@me/device/pointer["mouse"].wheel.y * 3em) } when @me/device/pointer["mouse"].wheel changes
{ UI.program.stop } when UI.pulsed(["q"]) && !UI.typing

Pointer := class: Location {
  static Contact := class: Nameable number: Number = 0, position: Geometry.Vector = Geometry.Vector(), pressure: Probability = 0, tilt: Geometry.Vector = Geometry.Vector(), buttons: Number[] = [], wheel: Geometry.Vector = Geometry.Vector() {
    pressed => buttons.nonempty || pressure > 0
    released => !pressed && (previous.pressed ?? false)
    velocity => history.last -- (now => now.previous && now.when > now.previous.when ? (now.value.position - now.previous.value.position) * (1 / ((now.when - now.previous.when) as ms)) : Geometry.Vector())
    pressed_at => history.commits{.value.pressed && !(.previous.value.pressed ?? false)}.last
    swipe => (pressed_at, history.commits{.value.released}.last) -- ((from, to) => (from: from.value, to: to.value, distance: to.value.position - from.value.position, duration: to.when - from.when))
    to (at: Geometry.Vector, pressing: Number[] = buttons, time: Time = Time.now) => {
      with Time.now = time {
        position = at
        (buttons = pressing) if pressing != buttons
      }
      this
    }
  }
  static Mouse := Contact{name == "mouse"}
  static Pen := Contact{name == "pen"}
  static Touch := Contact{name == "touch"}

  contacts => children{is Contact}
  [kind: "mouse" | "pen" | "touch" = "mouse", number: Number = 0] => contacts{.name == kind && .number == number}.first ?? add(Contact(name: kind, number))
}

Controllers := class: Location {
  static Controller := class: Nameable held: *, character: Character? {
    guest => character === None
  }
  [id: Number.Nat] => children{.name == id}.first
  connected (held) => children{.held == held}.first ?? add(Controller(name: reclaimed(held) ?? (0..).find(!this[.]), held))
  disconnected (held) => children = children{.held != held}
  reclaimed (held) => [children, children.previous**].flatten{.held == held && !this[.name]}.first.name
}

Device &+= {
  controllers: Controllers = Controllers()
  pointer: Pointer = Pointer()
}

Language.Image := class: Language {
  static extensions = ".png" | ".jpg" | ".jpeg" | ".gif" | ".svg" | ".webp" | ".avif"
  level := {
    {encoded} => $.png.read(encoded)
  }
}
Language.Video := class: Language { static extensions = ".mp4" | ".webm" | ".ogv" }
Language.Audio := class: Language { static extensions = ".mp3" | ".ogg" | ".wav" | ".flac" }
